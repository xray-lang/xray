const BLOCK_TABLE: [int; 3] = comptime {
    var base = comptime 5
    const values: [int; 3] = comptime [base, base + 1, base + 2]
    return values
}

var a = comptime BLOCK_TABLE[0]
var b = comptime BLOCK_TABLE[1]
var c = comptime BLOCK_TABLE[2]
var picked = comptime (BLOCK_TABLE[0] + BLOCK_TABLE[2])
print(a)
print(b)
print(c)
print(picked)
