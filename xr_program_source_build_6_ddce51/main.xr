import { ReadCounter, LeftCounter, readCounter } from "./facade"
struct LocalCounter implements ReadCounter {
  value: i64
  current() -> i64 { return this.value }
}
fn genericRead<T>(_counter: T) -> i64 { return 999 }
fn answer() -> i64 {
  var left = LeftCounter{value: 20}
  var local = LocalCounter{value: 11}
  return readCounter<LeftCounter>(left) + readCounter<LocalCounter>(local) +
         readCounter(local)
}
