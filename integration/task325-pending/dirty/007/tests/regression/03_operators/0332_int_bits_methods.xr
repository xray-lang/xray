// Test: integer bit-manipulation methods + signed-overflow predicates.
// Bit methods lower to exact-width xi.bit.* operations; overflow predicates
// retain the shared arithmetic semantics.

@test
fn test_int_bits() {
    assertEqual((0).popcount(), 0)
    assertEqual((255).popcount(), 8)
    assertEqual((-1).popcount(), 64)

    assertEqual((0).leadingZeros(), 64)
    assertEqual((1).leadingZeros(), 63)
    assertEqual((-1).leadingZeros(), 0)

    assertEqual((0).trailingZeros(), 64)
    assertEqual((1024).trailingZeros(), 10)
    assertEqual((-1).trailingZeros(), 0)

    assertEqual((1).byteswap(), 72057594037927936)
    assertEqual((-1).byteswap(), -1)
    assertEqual((12345).byteswap().byteswap(), 12345)

    assertEqual((1).rotateLeft(4), 16)
    assertEqual((1).rotateLeft(64), 1)
    assertEqual((1).rotateLeft(68), 16)
    assertEqual((16).rotateRight(4), 1)
    assertEqual((1).rotateRight(64), 1)
}

@test
fn test_int_overflow_predicates() {
    // Signed addition overflow.
    assertEqual((1).addOverflows(2), false)
    assertEqual((9223372036854775807).addOverflows(1), true)
    assertEqual((9223372036854775807).addOverflows(9223372036854775807), true)

    // Signed subtraction overflow.
    assertEqual((5).subOverflows(3), false)
    assertEqual((9223372036854775807).subOverflows(-1), true)
    assertEqual((0).subOverflows(9223372036854775807), false)

    // Signed multiplication overflow.
    assertEqual((3).mulOverflows(4), false)
    assertEqual((9223372036854775807).mulOverflows(2), true)
    assertEqual((4611686018427387904).mulOverflows(4), true)
    assertEqual((0).mulOverflows(9223372036854775807), false)

    // Predicates agree with the checked* family.
    var max: i64 = 9223372036854775807
    assertEqual(max.addOverflows(1), max.checkedAdd(1) == null)
    assertEqual(max.mulOverflows(2), max.checkedMul(2) == null)
}

@test
fn test_int_wrapping_matches_operators() {
    // Wrapping methods agree with the default two's-complement operators.
    var max: i64 = 9223372036854775807
    assertEqual(max.wrappingAdd(1), max + 1)
    assertEqual(max.wrappingMul(2), max * 2)
    assertEqual((4611686018427387904).wrappingMul(4), 0)
}
