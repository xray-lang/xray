foreach(case IN ITEMS fields joined forwarding generic array unit callable comptime class class_field copy method method_owner capture method_owner_control method_owner_result_control projection_control nested_class nested_class_method)
    set(expected 42)
    add_test(NAME test_xir_p10_structural_source_${case}
        COMMAND test_xir_p10_reference --accept structural_${case} ${expected})
    set_tests_properties(test_xir_p10_structural_source_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;structural;source;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/structural_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit structural_${case} ${expected} "${generated}"
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/structural_${case}.xr"
        VERBATIM)
    foreach(backend IN ITEMS native mixed)
        set(target test_xir_p10_structural_${backend}_${case})
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(backend STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${target} COMMAND ${target} ${expected})
        set_tests_properties(${target} PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;structural;ownership;${backend}")
        list(APPEND p10_structural_targets ${target})
    endforeach()
endforeach()
add_custom_target(p10_structural_consumers DEPENDS ${p10_structural_targets})

