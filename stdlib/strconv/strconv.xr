// strconv - explicit string/number conversion boundary.

import text

fn parseInt(value: string) -> int? {
    var s = text.trim(value)
    if (len(s) == 0) { return null }
    var start = 0
    var sign = 1
    var first = s.runes().nth(0)
    var firstCp = int(first.toUInt32())
    if (firstCp == 43 || firstCp == 45) {
        if (firstCp == 45) { sign = -1 }
        start = 1
    }
    if (start == len(s)) { return null }
    var result = 0
    for (var i = start; i < len(s); i++) {
        var cp = int(s.runes().nth(i).toUInt32())
        if (cp < 48 || cp > 57) { return null }
        result = result * 10 + (cp - 48)
    }
    return sign * result
}

fn parseFloat(value: string) -> float? {
    var s = text.trim(value)
    if (len(s) == 0) { return null }
    var digits = 0
    var dot = false
    var exponent = false
    var exponentSign = 1
    var exponentValue = 0
    var sign = 1
    var whole = 0.0
    var fractionScale = 1.0
    for (var i = 0; i < len(s); i++) {
        var r = s.runes().nth(i)
        var cp = int(r.toUInt32())
        if (cp >= 48 && cp <= 57) {
            digits = digits + 1
            if (exponent) {
                exponentValue = exponentValue * 10 + (cp - 48)
            } else if (dot) {
                fractionScale = fractionScale * 10.0
                whole = whole + float(cp - 48) / fractionScale
            } else {
                whole = whole * 10.0 + float(cp - 48)
            }
        } else if (cp == 46 && !dot && !exponent) {
            dot = true
        } else if ((cp == 101 || cp == 69) && !exponent && digits > 0) {
            exponent = true
            digits = 0
        } else if ((cp == 43 || cp == 45) &&
                   (i == 0 || int(s.runes().nth(i - 1).toUInt32()) == 101 ||
                    int(s.runes().nth(i - 1).toUInt32()) == 69)) {
            if (i == 0) {
                if (cp == 45) { sign = -1 }
            } else if (cp == 45) {
                exponentSign = -1
            }
        } else {
            return null
        }
    }
    if (digits == 0) { return null }
    var scale = 1.0
    for (var i = 0; i < exponentValue; i++) { scale = scale * 10.0 }
    if (exponentSign < 0) { scale = 1.0 / scale }
    return float(sign) * whole * scale
}

export { parseInt, parseFloat }
