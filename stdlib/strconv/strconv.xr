// strconv - explicit string/number conversion boundary.

import text

export fn parseInt(value: string) -> int? {
    var s = text.trim(value)
    var bytes: Slice<byte> = s.bytes()
    var n = len(bytes)
    if (n == 0) { return null }

    var negative = false
    var pos = 0
    if (bytes[0] == 43 || bytes[0] == 45) {
        negative = bytes[0] == 45
        pos = 1
    }
    if (pos == n) { return null }

    // Accumulate negatively so INT64_MIN remains representable. This also
    // rejects overflow before performing the overflowing operation.
    var limit = -9223372036854775807
    if (negative) { limit = limit - 1 }
    var multiplyLimit = limit / 10
    var result = 0
    while (pos < n) {
        var cp = int(bytes[pos])
        if (cp < 48 || cp > 57) { return null }
        var digit = cp - 48
        if (result < multiplyLimit) { return null }
        result = result * 10
        if (result < limit + digit) { return null }
        result = result - digit
        pos = pos + 1
    }
    if (negative) { return result }
    return -result
}

export fn parseFloat(value: string) -> float? {
    var s = text.trim(value)
    var bytes: Slice<byte> = s.bytes()
    var n = len(bytes)
    if (n == 0) { return null }

    var pos = 0
    if (bytes[pos] == 43 || bytes[pos] == 45) { pos = pos + 1 }
    if (pos == n) { return null }

    var integerDigits = 0
    while (pos < n && bytes[pos] >= 48 && bytes[pos] <= 57) {
        integerDigits = integerDigits + 1
        pos = pos + 1
    }

    var fractionDigits = 0
    if (pos < n && bytes[pos] == 46) {
        pos = pos + 1
        while (pos < n && bytes[pos] >= 48 && bytes[pos] <= 57) {
            fractionDigits = fractionDigits + 1
            pos = pos + 1
        }
    }
    if (integerDigits + fractionDigits == 0) { return null }

    if (pos < n && (bytes[pos] == 101 || bytes[pos] == 69)) {
        pos = pos + 1
        if (pos < n && (bytes[pos] == 43 || bytes[pos] == 45)) { pos = pos + 1 }
        var exponentDigits = 0
        while (pos < n && bytes[pos] >= 48 && bytes[pos] <= 57) {
            exponentDigits = exponentDigits + 1
            pos = pos + 1
        }
        if (exponentDigits == 0) { return null }
    }
    if (pos != n) { return null }

    // The runtime conversion primitive owns the correctly-rounded binary64
    // algorithm; the Xray code above owns the strict decimal grammar.
    return float(s)
}
