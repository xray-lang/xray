// url - pure-Xray URL parsing, formatting, query, and percent encoding.
//
// The algorithms mirror the former shared C core, but the user-facing stdlib
// surface is now ordinary Xray code. ASCII URL delimiters are scanned by
// character index; percent encode/decode works on UTF-8 bytes.

const HEX = "0123456789ABCDEF"

enum UrlError {
    InvalidPercentEncoding(int)
}

// QueryParams preserves insertion order, duplicate names, empty names, and
// empty values. Names are case-sensitive; form encoding is applied only at
// parse/encode boundaries.
class QueryParams {
    private names: Array<string>
    private values: Array<string>

    constructor() {
        this.names = []
        this.values = []
    }

    add(name: string, value: string) {
        this.names.push(name)
        this.values.push(value)
    }

    set(name: string, value: string) {
        var nextNames: Array<string> = []
        var nextValues: Array<string> = []
        var replaced = false
        for (var i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) {
                if (!replaced) {
                    nextNames.push(name)
                    nextValues.push(value)
                    replaced = true
                }
            } else {
                nextNames.push(this.names[i])
                nextValues.push(this.values[i])
            }
        }
        if (!replaced) {
            nextNames.push(name)
            nextValues.push(value)
        }
        this.names = nextNames
        this.values = nextValues
    }

    get(name: string) -> string? {
        for (var i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) { return this.values[i] }
        }
        return null
    }

    getAll(name: string) -> Array<string> {
        var out: Array<string> = []
        for (var i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) { out.push(this.values[i]) }
        }
        return out
    }

    entries() -> Array<(string, string)> {
        var out: Array<(string, string)> = []
        for (var i = 0; i < this.names.length; i++) {
            out.push((this.names[i], this.values[i]))
        }
        return out
    }

    encode() -> string {
        var out = ""
        for (var i = 0; i < this.names.length; i++) {
            if (i > 0) { out = out + "&" }
            out = out + encodeForm(this.names[i]) + "=" + encodeForm(this.values[i])
        }
        return out
    }
}

// URL - Parsed URL handle with normalized host, origin, and href components.
class URL {
    protocol: string
    hostname: string
    port: string
    pathname: string
    search: string
    hash: string
    username: string
    password: string
    host: string
    origin: string
    href: string

    constructor(
        protocol: string,
        hostname: string,
        port: string,
        pathname: string,
        search: string,
        hash: string,
        username: string,
        password: string,
        host: string,
        origin: string,
        href: string
    ) {
        this.protocol = protocol
        this.hostname = hostname
        this.port = port
        this.pathname = pathname
        this.search = search
        this.hash = hash
        this.username = username
        this.password = password
        this.host = host
        this.origin = origin
        this.href = href
    }
}

fn hexVal(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return 10 + c - 97 }
    if (c >= 65 && c <= 70) { return 10 + c - 65 }
    return -1
}

fn isUnreserved(c: int) -> bool {
    return (c >= 65 && c <= 90) ||
           (c >= 97 && c <= 122) ||
           (c >= 48 && c <= 57) ||
           c == 45 || c == 95 || c == 46 || c == 126
}

fn byteString(b: int) -> string {
    var one = Bytes(1)
    one[0] = b
    return one.toString()
}

fn encodeImpl(s: string, form: bool) -> string {
    var src = s.toBytes()
    var out = ""
    for (var i = 0; i < src.length; i++) {
        var b = src[i]
        if (form && b == 32) {
            out = out + "+"
        } else if (isUnreserved(b)) {
            out = out + byteString(b)
        } else {
            out = out + "%"
            out = out + HEX.charAt((b >> 4) & 15)
            out = out + HEX.charAt(b & 15)
        }
    }
    return out
}

fn decodedLen(src: Bytes) -> int {
    var n = 0
    var i = 0
    while (i < src.length) {
        if (src[i] == 37 && i + 2 < src.length) {
            var hi = hexVal(src[i + 1])
            var lo = hexVal(src[i + 2])
            if (hi >= 0 && lo >= 0) { i = i + 2 }
        }
        n = n + 1
        i = i + 1
    }
    return n
}

fn decodeImpl(s: string, form: bool) -> string {
    var src = s.toBytes()
    var out = Bytes(decodedLen(src))
    var oi = 0
    var i = 0
    while (i < src.length) {
        if (src[i] == 37 && i + 2 < src.length) {
            var hi = hexVal(src[i + 1])
            var lo = hexVal(src[i + 2])
            if (hi >= 0 && lo >= 0) {
                out[oi] = (hi << 4) | lo
                oi = oi + 1
                i = i + 3
                continue
            }
        }
        if (form && src[i] == 43) {
            out[oi] = 32
        } else {
            out[oi] = src[i]
        }
        oi = oi + 1
        i = i + 1
    }
    return out.toString()
}

fn decodeQueryComponent(s: string, baseOffset: int) -> string {
    var src = s.toBytes()
    var out = Bytes(decodedLen(src))
    var oi = 0
    var i = 0
    while (i < src.length) {
        if (src[i] == 37) {
            if (i + 2 >= src.length) {
                throw UrlError.InvalidPercentEncoding(baseOffset + i)
            }
            var hi = hexVal(src[i + 1])
            var lo = hexVal(src[i + 2])
            if (hi < 0 || lo < 0) {
                throw UrlError.InvalidPercentEncoding(baseOffset + i)
            }
            out[oi] = (hi << 4) | lo
            oi = oi + 1
            i = i + 3
            continue
        }
        if (src[i] == 43) {
            out[oi] = 32
        } else {
            out[oi] = src[i]
        }
        oi = oi + 1
        i = i + 1
    }
    return out.toString()
}

fn findChar(s: string, needle: string, start: int, end: int) -> int {
    var i = start
    while (i < end) {
        if (s.charAt(i) == needle) { return i }
        i = i + 1
    }
    return -1
}

fn findAny3(s: string, a: string, b: string, c: string, start: int, end: int) -> int {
    var i = start
    while (i < end) {
        var ch = s.charAt(i)
        if (ch == a || ch == b || ch == c) { return i }
        i = i + 1
    }
    return -1
}

fn lastChar(s: string, needle: string, start: int, end: int) -> int {
    var i = end - 1
    while (i >= start) {
        if (s.charAt(i) == needle) { return i }
        i = i - 1
    }
    return -1
}

fn startsWithAt(s: string, pos: int, prefix: string) -> bool {
    if (pos + prefix.length > s.length) { return false }
    return s.slice(pos, pos + prefix.length) == prefix
}

fn portIsValid(port: string) -> bool {
    if (port.length == 0 || port.length > 5) { return false }
    var v = 0
    for (var i = 0; i < port.length; i++) {
        var c = port.charAt(i).ord()!
        if (c < 48 || c > 57) { return false }
        v = v * 10 + (c - 48)
    }
    return v <= 65535
}

// parse - Parse URL text into a URL handle.
fn parse(url: string) -> URL {
    var n = url.length
    var protocol = ""
    var username = ""
    var password = ""
    var hostname = ""
    var rawPort = ""
    var pathname = "/"
    var search = ""
    var hash = ""

    var p = 0
    var colon = findChar(url, ":", 0, n)
    if (colon >= 0 && startsWithAt(url, colon, "://")) {
        protocol = url.slice(0, colon + 1)
        p = colon + 3
    }

    var authorityEnd = findAny3(url, "/", "?", "#", p, n)
    if (authorityEnd < 0) { authorityEnd = n }

    var at = findChar(url, "@", p, authorityEnd)
    var hostStart = p
    if (at >= 0) {
        var userColon = findChar(url, ":", p, at)
        if (userColon >= 0) {
            username = url.slice(p, userColon)
            password = url.slice(userColon + 1, at)
        } else {
            username = url.slice(p, at)
        }
        hostStart = at + 1
    }

    if (hostStart < authorityEnd && url.charAt(hostStart) == "[") {
        var bracket = findChar(url, "]", hostStart, authorityEnd)
        if (bracket >= 0) {
            hostname = url.slice(hostStart, bracket + 1)
            if (bracket + 1 < authorityEnd && url.charAt(bracket + 1) == ":") {
                rawPort = url.slice(bracket + 2, authorityEnd)
            }
        } else {
            hostname = url.slice(hostStart, authorityEnd)
        }
    } else {
        var portColon = lastChar(url, ":", hostStart, authorityEnd)
        if (portColon >= 0) {
            hostname = url.slice(hostStart, portColon)
            rawPort = url.slice(portColon + 1, authorityEnd)
        } else {
            hostname = url.slice(hostStart, authorityEnd)
        }
    }

    p = authorityEnd
    if (p < n && url.charAt(p) == "/") {
        var pathEnd = findAny3(url, "?", "#", "\u{0}", p, n)
        if (pathEnd < 0) { pathEnd = n }
        pathname = url.slice(p, pathEnd)
        p = pathEnd
    }

    if (p < n && url.charAt(p) == "?") {
        var searchEnd = findChar(url, "#", p, n)
        if (searchEnd < 0) { searchEnd = n }
        search = url.slice(p, searchEnd)
        p = searchEnd
    }

    if (p < n && url.charAt(p) == "#") {
        hash = url.slice(p, n)
    }

    var port = ""
    if (portIsValid(rawPort)) { port = rawPort }

    var host = hostname
    if (port.length > 0) { host = host + ":" + port }

    var origin = host
    if (protocol.length > 0) { origin = protocol + "//" + host }

    return URL(protocol, hostname, port, pathname, search, hash, username, password, host, origin, url)
}

// format - Build URL text from a URL handle.
fn format(obj: URL) -> string {
    var out = ""
    if (obj.protocol.length > 0) {
        out = out + obj.protocol + "//"
    }
    if (obj.username.length > 0) {
        out = out + obj.username
        if (obj.password.length > 0) { out = out + ":" + obj.password }
        out = out + "@"
    }
    out = out + obj.hostname
    if (obj.port.length > 0) { out = out + ":" + obj.port }
    return out + obj.pathname + obj.search + obj.hash
}

// encode - RFC 3986 percent-encode a string.
fn encode(s: string) -> string {
    return encodeImpl(s, false)
}

// decode - RFC 3986 percent-decode a string.
fn decode(s: string) -> string {
    return decodeImpl(s, false)
}

// encodeForm - Form URL encode a string, using plus for spaces.
fn encodeForm(s: string) -> string {
    return encodeImpl(s, true)
}

// decodeForm - Form URL decode a string, treating plus as space.
fn decodeForm(s: string) -> string {
    return decodeImpl(s, true)
}

// parseQuery - Parse a form-encoded query while preserving order and duplicates.
fn parseQuery(qs: string) -> QueryParams {
    var out = QueryParams()
    var start = 0
    if (qs.length > 0 && qs.charAt(0) == "?") { start = 1 }

    while (start < qs.length) {
        var amp = findChar(qs, "&", start, qs.length)
        var pairEnd = amp
        if (pairEnd < 0) { pairEnd = qs.length }

        var eq = findChar(qs, "=", start, pairEnd)
        var keyEnd = pairEnd
        if (eq >= 0) { keyEnd = eq }
        if (pairEnd > start) {
            var key = decodeQueryComponent(qs.slice(start, keyEnd), start)
            var value = ""
            if (eq >= 0) {
                value = decodeQueryComponent(qs.slice(eq + 1, pairEnd), eq + 1)
            }
            out.add(key, value)
        }

        if (amp < 0) { break }
        start = amp + 1
    }

    return out
}

fn emitBaseAuthority(parts: URL) -> string {
    var out = ""
    if (parts.protocol.length > 0) {
        out = out + parts.protocol + "//"
    }
    out = out + parts.hostname
    if (parts.port.length > 0) { out = out + ":" + parts.port }
    return out
}

fn removeDotSegments(path: string) -> string {
    if (path.length == 0) { return "" }
    var isAbs = path.charAt(0) == "/"
    var trailing = path.length > 1 && path.charAt(path.length - 1) == "/"
    var segs: Array<string> = []
    var parts = path.split("/")

    for (var i = 0; i < parts.length; i++) {
        var seg = parts[i]
        if (seg.length == 0 || seg == ".") { continue }
        if (seg == "..") {
            if (segs.length > 0 && segs[segs.length - 1] != "..") {
                segs.pop()
            } else if (!isAbs) {
                segs.push("..")
            }
        } else {
            segs.push(seg)
        }
    }

    var body = segs.join("/")
    if (isAbs) {
        if (body.length == 0) { return "/" }
        body = "/" + body
    }
    if (trailing && body.length > 0 && body.charAt(body.length - 1) != "/") {
        body = body + "/"
    }
    return body
}

fn splitReference(ref: string) -> (string, string, string) {
    var hashAt = findChar(ref, "#", 0, ref.length)
    var noHashEnd = ref.length
    var hash = ""
    if (hashAt >= 0) {
        noHashEnd = hashAt
        hash = ref.slice(hashAt, ref.length)
    }

    var queryAt = findChar(ref, "?", 0, noHashEnd)
    var path = ref.slice(0, noHashEnd)
    var query = ""
    if (queryAt >= 0) {
        path = ref.slice(0, queryAt)
        query = ref.slice(queryAt, noHashEnd)
    }
    return (path, query, hash)
}

fn dirnamePrefix(path: string) -> string {
    if (path.length == 0) { return "/" }
    var slash = lastChar(path, "/", 0, path.length)
    if (slash >= 0) {
        return path.slice(0, slash + 1)
    }
    return "/"
}

// resolve - Resolve a relative URL reference against a base URL.
fn resolve(base: string, relative: string) -> string {
    var colon = findChar(relative, ":", 0, relative.length)
    if (colon >= 0 && startsWithAt(relative, colon, "://")) {
        return relative
    }

    var bp = parse(base)
    var parts = splitReference(relative)
    var relPath = parts.0
    var relQuery = parts.1
    var relHash = parts.2

    if (relative.length > 1 && relative.charAt(0) == "/" && relative.charAt(1) == "/") {
        var authorityEnd = findChar(relative, "/", 2, relPath.length)
        if (authorityEnd < 0) { authorityEnd = relPath.length }
        var out = bp.protocol + relative.slice(0, authorityEnd)
        if (authorityEnd < relPath.length) {
            out = out + removeDotSegments(relative.slice(authorityEnd, relPath.length))
        }
        return out + relQuery + relHash
    }

    if (relPath.length > 0 && relPath.charAt(0) == "/") {
        return emitBaseAuthority(bp) + removeDotSegments(relPath) + relQuery + relHash
    }

    if (relPath.length == 0) {
        var out = emitBaseAuthority(bp) + bp.pathname
        if (relQuery.length > 0) {
            out = out + relQuery
        } else {
            out = out + bp.search
        }
        return out + relHash
    }

    var merged = dirnamePrefix(bp.pathname) + relPath
    return emitBaseAuthority(bp) + removeDotSegments(merged) + relQuery + relHash
}

// join - Join URL path segments.
fn join(...parts: string) -> string {
    var out = ""
    for (var i = 0; i < parts.length; i++) {
        var seg = parts[i]
        if (seg.length == 0) { continue }

        if (out.length > 0 && out.charAt(out.length - 1) == "/") {
            out = out.slice(0, out.length - 1)
        }
        if (out.length > 0 && seg.charAt(0) != "/") {
            out = out + "/"
        }
        out = out + seg
    }
    return out
}

export {
    URL, UrlError, QueryParams,
    encode, decode, encodeForm, decodeForm,
    parse, format, parseQuery, resolve, join
}
