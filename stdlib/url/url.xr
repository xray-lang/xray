// url - pure-Xray URL parsing, formatting, query, and percent encoding.
//
// The algorithms mirror the former shared C core, but the user-facing stdlib
// surface is now ordinary Xray code. ASCII URL delimiters are scanned by
// character index; percent encode/decode works on UTF-8 bytes.

const HEX = "0123456789ABCDEF"

export enum UrlError {
    InvalidPercentEncoding { byteOffset: i64 }
}

// QueryParams preserves insertion order, duplicate names, empty names, and
// empty values. Names are case-sensitive; form encoding is applied only at
// parse/encode boundaries.
export class QueryParams {
    private names: Array<string>
    private values: Array<string>

    constructor() {
        this.names = []
        this.values = []
    }

    ref add(name: string, value: string) {
        this.names.push(name)
        this.values.push(value)
    }

    ref set(name: string, value: string) {
        var nextNames: Array<string> = []
        var nextValues: Array<string> = []
        var replaced = false
        for (var i = 0; i < len(this.names); i++) {
            if (this.names[i] == name) {
                if (!replaced) {
                    nextNames.push(name)
                    nextValues.push(value)
                    replaced = true
                }
            } else {
                nextNames.push(this.names[i])
                nextValues.push(this.values[i])
            }
        }
        if (!replaced) {
            nextNames.push(name)
            nextValues.push(value)
        }
        this.names = nextNames
        this.values = nextValues
    }

    get(name: string) -> string? {
        for (var i = 0; i < len(this.names); i++) {
            if (this.names[i] == name) { return this.values[i] }
        }
        return null
    }

    getAll(name: string) -> Array<string> {
        var out: Array<string> = []
        for (var i = 0; i < len(this.names); i++) {
            if (this.names[i] == name) { out.push(this.values[i]) }
        }
        return out
    }

    entries() -> Array<(string, string)> {
        var out: Array<(string, string)> = []
        for (var i = 0; i < len(this.names); i++) {
            out.push((this.names[i], this.values[i]))
        }
        return out
    }

    encode() -> string {
        var out = ""
        for (var i = 0; i < len(this.names); i++) {
            if (i > 0) { out = out + "&" }
            out = out + encodeForm(this.names[i]) + "=" + encodeForm(this.values[i])
        }
        return out
    }
}

// URL - Parsed URL handle with normalized host, origin, and href components.
export class URL {
    protocol: string
    hostname: string
    port: string
    pathname: string
    search: string
    hash: string
    username: string
    password: string
    host: string
    origin: string
    href: string

    constructor(
        protocol: string,
        hostname: string,
        port: string,
        pathname: string,
        search: string,
        hash: string,
        username: string,
        password: string,
        host: string,
        origin: string,
        href: string
    ) {
        this.protocol = protocol
        this.hostname = hostname
        this.port = port
        this.pathname = pathname
        this.search = search
        this.hash = hash
        this.username = username
        this.password = password
        this.host = host
        this.origin = origin
        this.href = href
    }
}

fn hexVal(c: i64) -> i64 {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return 10 + c - 97 }
    if (c >= 65 && c <= 70) { return 10 + c - 65 }
    return -1
}

fn isUnreserved(c: i64) -> bool {
    return (c >= 65 && c <= 90) ||
           (c >= 97 && c <= 122) ||
           (c >= 48 && c <= 57) ||
           c == 45 || c == 95 || c == 46 || c == 126
}

fn byteString(b: i64) -> string {
    var one = Array<u8>(1)
    one[0] = b as u8
    return string.fromUtf8(one[:])!
}

fn encodeImpl(s: string, form: bool) -> string {
    var src = s.copyBytes()
    var alphabet: Slice<u8> = HEX.bytes()
    var out = ""
    for (var i = 0; i < len(src); i++) {
        var b = src[i] as i64
        if (form && b == 32) {
            out = out + "+"
        } else if (isUnreserved(b)) {
            out = out + byteString(b)
        } else {
            out = out + "%"
            out = out + rune((alphabet[(b >> 4) & 15] as i64))!.toString()
            out = out + rune((alphabet[b & 15] as i64))!.toString()
        }
    }
    return out
}

fn decodedLen(src: Array<u8>) -> i64 {
    var n = 0
    var i = 0
    while (i < len(src)) {
        if (src[i] == 37 && i + 2 < len(src)) {
            var hi = hexVal(src[i + 1] as i64)
            var lo = hexVal(src[i + 2] as i64)
            if (hi >= 0 && lo >= 0) { i = i + 2 }
        }
        n = n + 1
        i = i + 1
    }
    return n
}

fn decodeImpl(s: string, form: bool) -> string {
    var src = s.copyBytes()
    var out = Array<u8>(decodedLen(src))
    var oi = 0
    var i = 0
    while (i < len(src)) {
        if (src[i] == 37 && i + 2 < len(src)) {
            var hi = hexVal(src[i + 1] as i64)
            var lo = hexVal(src[i + 2] as i64)
            if (hi >= 0 && lo >= 0) {
                out[oi] = ((hi << 4) | lo) as u8
                oi = oi + 1
                i = i + 3
                continue
            }
        }
        if (form && src[i] == 43) {
            out[oi] = 32
        } else {
            out[oi] = src[i]
        }
        oi = oi + 1
        i = i + 1
    }
    return string.fromUtf8(out[:])!
}

fn decodeQueryComponent(s: string, baseOffset: i64) -> string {
    var src = s.copyBytes()
    var out = Array<u8>(decodedLen(src))
    var oi = 0
    var i = 0
    while (i < len(src)) {
        if (src[i] == 37) {
            if (i + 2 >= len(src)) {
                throw UrlError.InvalidPercentEncoding { byteOffset: baseOffset + i }
            }
            var hi = hexVal(src[i + 1] as i64)
            var lo = hexVal(src[i + 2] as i64)
            if (hi < 0 || lo < 0) {
                throw UrlError.InvalidPercentEncoding { byteOffset: baseOffset + i }
            }
            out[oi] = ((hi << 4) | lo) as u8
            oi = oi + 1
            i = i + 3
            continue
        }
        if (src[i] == 43) {
            out[oi] = 32
        } else {
            out[oi] = src[i]
        }
        oi = oi + 1
        i = i + 1
    }
    return string.fromUtf8(out[:])!
}

fn findChar(s: string, needle: rune, start: i64, end: i64) -> i64 {
    var i = start
    while (i < end) {
        if (s.runes().nth(i) == needle) { return i }
        i = i + 1
    }
    return -1
}

fn findAny3(s: string, a: rune, b: rune, c: rune, start: i64, end: i64) -> i64 {
    var i = start
    while (i < end) {
        var ch = s.runes().nth(i)
        if (ch == a || ch == b || ch == c) { return i }
        i = i + 1
    }
    return -1
}

fn lastChar(s: string, needle: rune, start: i64, end: i64) -> i64 {
    var i = end - 1
    while (i >= start) {
        if (s.runes().nth(i) == needle) { return i }
        i = i - 1
    }
    return -1
}

fn startsWithAt(s: string, pos: i64, prefix: string) -> bool {
    if (pos + len(prefix) > len(s)) { return false }
    return s.slice(pos, pos + len(prefix)) == prefix
}

fn portIsValid(port: string) -> bool {
    var bytes: Slice<u8> = port.bytes()
    if (len(bytes) == 0 || len(bytes) > 5) { return false }
    var v = 0
    for (var i = 0; i < len(bytes); i++) {
        var c = (bytes[i] as i64)
        if (c < 48 || c > 57) { return false }
        v = v * 10 + (c - 48)
    }
    return v <= 65535
}

// parse - Parse URL text into a URL handle.
export fn parse(url: string) -> URL {
    var n = len(url)
    var protocol = ""
    var username = ""
    var password = ""
    var hostname = ""
    var rawPort = ""
    var pathname = "/"
    var search = ""
    var hash = ""

    var p = 0
    var colon = findChar(url, ':', 0, n)
    if (colon >= 0 && startsWithAt(url, colon, "://")) {
        protocol = url.slice(0, colon + 1)
        p = colon + 3
    }

    var authorityEnd = findAny3(url, '/', '?', '#', p, n)
    if (authorityEnd < 0) { authorityEnd = n }

    var at = findChar(url, '@', p, authorityEnd)
    var hostStart = p
    if (at >= 0) {
        var userColon = findChar(url, ':', p, at)
        if (userColon >= 0) {
            username = url.slice(p, userColon)
            password = url.slice(userColon + 1, at)
        } else {
            username = url.slice(p, at)
        }
        hostStart = at + 1
    }

    if (hostStart < authorityEnd && url.runes().nth(hostStart) == '[') {
        var bracket = findChar(url, ']', hostStart, authorityEnd)
        if (bracket >= 0) {
            hostname = url.slice(hostStart, bracket + 1)
            if (bracket + 1 < authorityEnd && url.runes().nth(bracket + 1) == ':') {
                rawPort = url.slice(bracket + 2, authorityEnd)
            }
        } else {
            hostname = url.slice(hostStart, authorityEnd)
        }
    } else {
        var portColon = lastChar(url, ':', hostStart, authorityEnd)
        if (portColon >= 0) {
            hostname = url.slice(hostStart, portColon)
            rawPort = url.slice(portColon + 1, authorityEnd)
        } else {
            hostname = url.slice(hostStart, authorityEnd)
        }
    }

    p = authorityEnd
    if (p < n && url.runes().nth(p) == '/') {
        var pathEnd = findAny3(url, '?', '#', '\u{0}', p, n)
        if (pathEnd < 0) { pathEnd = n }
        pathname = url.slice(p, pathEnd)
        p = pathEnd
    }

    if (p < n && url.runes().nth(p) == '?') {
        var searchEnd = findChar(url, '#', p, n)
        if (searchEnd < 0) { searchEnd = n }
        search = url.slice(p, searchEnd)
        p = searchEnd
    }

    if (p < n && url.runes().nth(p) == '#') {
        hash = url.slice(p, n)
    }

    var port = ""
    if (portIsValid(rawPort)) { port = rawPort }

    var host = hostname
    if (len(port) > 0) { host = host + ":" + port }

    var origin = host
    if (len(protocol) > 0) { origin = protocol + "//" + host }

    return URL(protocol, hostname, port, pathname, search, hash, username, password, host, origin, url)
}

// format - Build URL text from a URL handle.
export fn format(obj: URL) -> string {
    var out = ""
    if (len(obj.protocol) > 0) {
        out = out + obj.protocol + "//"
    }
    if (len(obj.username) > 0) {
        out = out + obj.username
        if (len(obj.password) > 0) { out = out + ":" + obj.password }
        out = out + "@"
    }
    out = out + obj.hostname
    if (len(obj.port) > 0) { out = out + ":" + obj.port }
    return out + obj.pathname + obj.search + obj.hash
}

// encode - RFC 3986 percent-encode a string.
export fn encode(s: string) -> string {
    return encodeImpl(s, false)
}

// decode - RFC 3986 percent-decode a string.
export fn decode(s: string) -> string {
    return decodeImpl(s, false)
}

// encodeForm - Form URL encode a string, using plus for spaces.
export fn encodeForm(s: string) -> string {
    return encodeImpl(s, true)
}

// decodeForm - Form URL decode a string, treating plus as space.
export fn decodeForm(s: string) -> string {
    return decodeImpl(s, true)
}

// parseQuery - Parse a form-encoded query while preserving order and duplicates.
export fn parseQuery(qs: string) -> QueryParams {
    var out = QueryParams()
    var start = 0
    if (qs.startsWith("?")) { start = 1 }

    while (start < len(qs)) {
        var amp = findChar(qs, '&', start, len(qs))
        var pairEnd = amp
        if (pairEnd < 0) { pairEnd = len(qs) }

        var eq = findChar(qs, '=', start, pairEnd)
        var keyEnd = pairEnd
        if (eq >= 0) { keyEnd = eq }
        if (pairEnd > start) {
            var key = decodeQueryComponent(qs.slice(start, keyEnd), start)
            var value = ""
            if (eq >= 0) {
                value = decodeQueryComponent(qs.slice(eq + 1, pairEnd), eq + 1)
            }
            out.add(key, value)
        }

        if (amp < 0) { break }
        start = amp + 1
    }

    return out
}

fn emitBaseAuthority(parts: URL) -> string {
    var out = ""
    if (len(parts.protocol) > 0) {
        out = out + parts.protocol + "//"
    }
    out = out + parts.hostname
    if (len(parts.port) > 0) { out = out + ":" + parts.port }
    return out
}

fn removeDotSegments(path: string) -> string {
    if (len(path) == 0) { return "" }
    var isAbs = path.startsWith("/")
    var trailing = len(path) > 1 && path.endsWith("/")
    var segs: Array<string> = []
    var parts = path.split("/")

    for (var i = 0; i < len(parts); i++) {
        var seg = parts[i]
        if (len(seg) == 0 || seg == ".") { continue }
        if (seg == "..") {
            if (len(segs) > 0 && segs[len(segs) - 1] != "..") {
                segs.pop()
            } else if (!isAbs) {
                segs.push("..")
            }
        } else {
            segs.push(seg)
        }
    }

    var body = segs.join("/")
    if (isAbs) {
        if (len(body) == 0) { return "/" }
        body = "/" + body
    }
    if (trailing && len(body) > 0 && !body.endsWith("/")) {
        body = body + "/"
    }
    return body
}

fn splitReference(ref: string) -> (string, string, string) {
    var hashAt = findChar(ref, '#', 0, len(ref))
    var noHashEnd = len(ref)
    var hash = ""
    if (hashAt >= 0) {
        noHashEnd = hashAt
        hash = ref.slice(hashAt, len(ref))
    }

    var queryAt = findChar(ref, '?', 0, noHashEnd)
    var path = ref.slice(0, noHashEnd)
    var query = ""
    if (queryAt >= 0) {
        path = ref.slice(0, queryAt)
        query = ref.slice(queryAt, noHashEnd)
    }
    return (path, query, hash)
}

fn dirnamePrefix(path: string) -> string {
    if (len(path) == 0) { return "/" }
    var slash = lastChar(path, '/', 0, len(path))
    if (slash >= 0) {
        return path.slice(0, slash + 1)
    }
    return "/"
}

// resolve - Resolve a relative URL reference against a base URL.
export fn resolve(base: string, relative: string) -> string {
    var colon = findChar(relative, ':', 0, len(relative))
    if (colon >= 0 && startsWithAt(relative, colon, "://")) {
        return relative
    }

    var bp = parse(base)
    var parts = splitReference(relative)
    var relPath = parts.0
    var relQuery = parts.1
    var relHash = parts.2

    if (relative.startsWith("//")) {
        var authorityEnd = findChar(relative, '/', 2, len(relPath))
        if (authorityEnd < 0) { authorityEnd = len(relPath) }
        var out = bp.protocol + relative.slice(0, authorityEnd)
        if (authorityEnd < len(relPath)) {
            out = out + removeDotSegments(relative.slice(authorityEnd, len(relPath)))
        }
        return out + relQuery + relHash
    }

    if (relPath.startsWith("/")) {
        return emitBaseAuthority(bp) + removeDotSegments(relPath) + relQuery + relHash
    }

    if (len(relPath) == 0) {
        var out = emitBaseAuthority(bp) + bp.pathname
        if (len(relQuery) > 0) {
            out = out + relQuery
        } else {
            out = out + bp.search
        }
        return out + relHash
    }

    var merged = dirnamePrefix(bp.pathname) + relPath
    return emitBaseAuthority(bp) + removeDotSegments(merged) + relQuery + relHash
}

// join - Join URL path segments.
export fn join(...parts: string) -> string {
    var out = ""
    for (var i = 0; i < len(parts); i++) {
        var seg = parts[i]
        if (len(seg) == 0) { continue }

        if (out.endsWith("/")) {
            out = out.slice(0, len(out) - 1)
        }
        if (len(out) > 0 && !seg.startsWith("/")) {
            out = out + "/"
        }
        out = out + seg
    }
    return out
}
