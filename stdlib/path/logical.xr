// Portable logical components are validated text, not filesystem authority.
import path
import { Path } from path
import "std/path/_lexical" as lexical

export final class LogicalPath {
    private const _raw: string
    private init(raw: string) { this._raw=raw }
    toString() -> string { return this._raw }

    static from(raw: string) -> LogicalPath? {
        if (!_valid(raw)) { return null }
        return LogicalPath(raw)
    }
}

fn _valid(raw: string) -> bool {
    if (len(raw)==0) { return true }
    if (raw.slice(0,1)=="/" || raw.slice(len(raw)-1,len(raw))=="/") { return false }
    const bytes=raw.bytes()
    for (var i=0; i<len(bytes); i++) {
        if (bytes[i]==0 || bytes[i]==92) { return false }
    }
    const parts=try! raw.split("/")
    for (var i=0; i<len(parts); i++) {
        if (len(parts[i])==0 || parts[i]=="." || parts[i]=="..") { return false }
    }
    return true
}

export fn from(raw: string) -> LogicalPath? { return LogicalPath.from(raw) }

export fn join(a: LogicalPath, b: LogicalPath) -> LogicalPath {
    const left=a.toString()
    const right=b.toString()
    if (len(left)==0) { return b }
    if (len(right)==0) { return a }
    return LogicalPath.from(left+"/"+right)!
}

fn _windowsComponent(part: string) -> bool {
    if (len(part)==0 || part.slice(len(part)-1,len(part))=="." ||
        part.slice(len(part)-1,len(part))==" ") { return false }
    const bytes=part.bytes()
    for (var i=0; i<len(bytes); i++) {
        const c=bytes[i]
        if (c<32 || c==127 || c==34 || c==42 || c==47 || c==58 || c==60 ||
            c==62 || c==63 || c==92 || c==124) { return false }
    }
    var stem=lexical.asciiLower(part)
    const dot=stem.indexOf(".")
    if (dot>=0) { stem=stem.slice(0,dot) }
    if (stem=="con" || stem=="prn" || stem=="aux" || stem=="nul" ||
        stem=="conin$" || stem=="conout$") { return false }
    if (len(stem)==4 && (stem.slice(0,3)=="com" || stem.slice(0,3)=="lpt")) {
        const last=stem.slice(3,4)
        if ("123456789¹²³".indexOf(last)>=0) { return false }
    }
    return true
}

export fn toNative(root: Path, value: LogicalPath) -> Path? {
    if (!path.isAbsolute(root)) { return null }
    const raw=value.toString()
    if (!_valid(raw)) { return null }
    if (len(raw)==0) { return root }
    const parts=try! raw.split("/")
    const windows=path.sep=="\\"
    var result=root
    for (var i=0; i<len(parts); i++) {
        if (windows && !_windowsComponent(parts[i])) { return null }
        result=path.join(result,Path(parts[i]))
    }
    return result
}
