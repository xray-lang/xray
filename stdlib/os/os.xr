// os — typed public process/environment surface over private platform syscalls.

import sys
import { Pipe, ProcessOptions } from sys

const EXEC_READ_CHUNK_BYTES: i64 = 65536
const DEFAULT_EXEC_CAPTURE_BYTES: i64 = 16777216
const MAX_EXEC_CAPTURE_BYTES: i64 = 2147483647

export final class ExecResult {
    stdout: Array<u8>
    stderr: Array<u8>
    exitCode: i64
    stdoutTruncated: bool
    stderrTruncated: bool

    constructor(stdout: Array<u8>, stderr: Array<u8>, exitCode: i64,
                stdoutTruncated: bool, stderrTruncated: bool) {
        this.stdout = stdout
        this.stderr = stderr
        this.exitCode = exitCode
        this.stdoutTruncated = stdoutTruncated
        this.stderrTruncated = stderrTruncated
    }
}

final class _CapturedOutput {
    bytes: Array<u8>
    truncated: bool

    constructor(bytes: Array<u8>, truncated: bool) {
        this.bytes = bytes
        this.truncated = truncated
    }
}

// A capture limit bounds retained memory, not pipe progress. Once the limit is
// reached the reader keeps draining so a child cannot deadlock on a full pipe.
fn _capturePipe(pipe: move Pipe, maxBytes: i64) -> _CapturedOutput? {
    defer { pipe.close() }
    var out = Array<u8>()
    var truncated = false
    while (true) {
        var chunk = pipe.read(EXEC_READ_CHUNK_BYTES)
        if (chunk == null) { return null }
        if (len(chunk!) == 0) { return _CapturedOutput(out, truncated) }

        var available = maxBytes - len(out)
        if (available <= 0) {
            truncated = true
            continue
        }
        var take = len(chunk!)
        if (take > available) {
            take = available
            truncated = true
        }
        for (var i = 0; i < take; i++) { out.push(chunk![i]) }
    }
    return null
}

// Path separator and line ending are derived from the platform name rather
// than queried, so the host reports one fact and the two spellings of it
// cannot disagree.
export fn platform() -> string { return __platform() }
export fn arch() -> string { return __arch() }
export fn sep() -> string {
    if (__platform() == "windows") { return "\\" }
    return "/"
}
export fn eol() -> string {
    if (__platform() == "windows") { return "\r\n" }
    return "\n"
}

export fn getenv(name: string) -> string? {
    if (len(name) == 0) { return null }
    return __getenv(name)
}
export fn setenv(name: string, value: string) -> bool {
    if (len(name) == 0) { return false }
    return __setenv(name, value)
}
export fn unsetenv(name: string) -> bool {
    if (len(name) == 0) { return false }
    return __unsetenv(name)
}
// Entries without a separator, or with an empty name, are not bindings.
// Keeping that rule here gives the VM and AOT leaves one shared policy owner.
export fn environ() -> Map<string, string> {
    var out = Map<string, string>()
    for (entry in __environBlock()) {
        var eq = entry.indexOf("=")
        if (eq <= 0) { continue }
        out.set(entry.slice(0, eq), entry.slice(eq + 1))
    }
    return out
}
export fn exit(code: i64 = 0) { __exit(code) }
export fn getpid() -> i64 { return __getpid() }
export fn getcwd() -> string { return __getcwd() }
export fn hostname() -> string { return __hostname() }
// The environment names the temporary root; the platform default applies only
// when nothing does. An empty value is not an answer and does not stop the
// chain. No host call is involved, so this belongs here rather than in C.
export fn tmpdir() -> string {
    var named = __getenv("TMPDIR")
    if (named != null && len(named!) > 0) { return named! }
    named = __getenv("TMP")
    if (named != null && len(named!) > 0) { return named! }
    named = __getenv("TEMP")
    if (named != null && len(named!) > 0) { return named! }
    if (platform() == "windows") { return "C:\\Windows\\Temp" }
    return "/tmp"
}
// The host answer wins; environment fallback policy is shared by both
// backends in this source body instead of being duplicated in native code.
export fn username() -> string? {
    var system = __systemUsername()
    if (system != null && len(system!) > 0) { return system }
    if (platform() == "windows") {
        var named = __getenv("USERNAME")
        if (named != null && len(named!) > 0) { return named }
    }
    var user = __getenv("USER")
    if (user != null && len(user!) > 0) { return user }
    var login = __getenv("LOGNAME")
    if (login != null && len(login!) > 0) { return login }
    return null
}
// The environment wins over the host's record, which is what lets a caller
// redirect the home directory for a process. USERPROFILE is consulted only on
// Windows, where it is the platform's own spelling of the same thing.
export fn homedir() -> string? {
    var home = __getenv("HOME")
    if (home != null && len(home!) > 0) { return home }
    if (platform() == "windows") {
        var profile = __getenv("USERPROFILE")
        if (profile != null && len(profile!) > 0) { return profile }
    }
    var system = __systemHomedir()
    if (system != null && len(system!) > 0) { return system }
    return null
}
export fn uid() -> i64 { return __uid() }
export fn gid() -> i64 { return __gid() }
export fn cpuCount() -> i64 {
    var count = __cpuCount()
    if (count > 0) { return count }
    return 1
}
export fn ppid() -> i64 { return __ppid() }
export fn kill(pid: i64, signal: i64 = 15) -> bool { return __kill(pid, signal) }
export fn totalMemory() -> i64 { return __totalMemory() }
export fn freeMemory() -> i64 { return __freeMemory() }
export fn uptime() -> f64 { return __uptime() }
export fn loadavg() -> Array<f64> { return __loadavg() }
export fn clock() -> f64 { return __clock() }
export fn sleep(ms: i64) {
    if (ms <= 0) { return }
    __sleep(ms)
}

// Shell execution is source-owned composition over the typed process and pipe
// resources. Both output streams are byte arrays: a child may emit embedded
// NUL or invalid UTF-8, so decoding belongs to the caller's declared protocol.
export fn exec(command: string, maxStdoutBytes: i64 = DEFAULT_EXEC_CAPTURE_BYTES,
               maxStderrBytes: i64 = DEFAULT_EXEC_CAPTURE_BYTES) -> ExecResult? {
    if (len(command) == 0 || maxStdoutBytes < 0 || maxStderrBytes < 0 ||
        maxStdoutBytes > MAX_EXEC_CAPTURE_BYTES || maxStderrBytes > MAX_EXEC_CAPTURE_BYTES) {
        return null
    }

    var stdoutPipe = sys.Pipe.open()
    if (stdoutPipe == null) { return null }

    var stderrPipe = sys.Pipe.open()
    if (stderrPipe == null) {
        stdoutPipe!.close()
        return null
    }

    var program = "/bin/sh"
    var args: Array<string> = ["-c", command]
    if (platform() == "windows") {
        program = "cmd.exe"
        args = ["/D", "/S", "/C", command]
    }

    var spawned = sys.Process.spawn(program, args,
        ProcessOptions(null, null, null, stdoutPipe!.writeEnd(), stderrPipe!.writeEnd()))
    if (spawned == null) {
        stdoutPipe!.close()
        stderrPipe!.close()
        return null
    }

    // Process.spawn borrows redirection endpoints. The parent must close both
    // write ends before waiting, otherwise EOF can never reach the readers.
    var stdoutWriteClosed = stdoutPipe!.closeWrite()
    var stderrWriteClosed = stderrPipe!.closeWrite()
    var stdoutCapture: _CapturedOutput? = null
    var stderrCapture: _CapturedOutput? = null
    var exitCode = -1
    var stdoutReady = stdoutPipe!
    var stderrReady = stderrPipe!
    scope {
        var stdoutTask = go _capturePipe(move stdoutReady, maxStdoutBytes)
        var stderrTask = go _capturePipe(move stderrReady, maxStderrBytes)
        exitCode = spawned!.wait()
        stdoutCapture = await stdoutTask
        stderrCapture = await stderrTask
    }

    if (!stdoutWriteClosed || !stderrWriteClosed ||
        stdoutCapture == null || stderrCapture == null) {
        return null
    }
    return ExecResult(stdoutCapture!.bytes, stderrCapture!.bytes, exitCode,
                      stdoutCapture!.truncated, stderrCapture!.truncated)
}
