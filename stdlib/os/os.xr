// os — typed public process/environment surface over private platform syscalls.

export final class ExecResult {
    stdout: string
    stderr: string
    exitCode: i64

    constructor(stdout: string, stderr: string, exitCode: i64) {
        this.stdout = stdout
        this.stderr = stderr
        this.exitCode = exitCode
    }
}

fn _execResult(raw: __ExecResult?) -> ExecResult? {
    if (raw == null) { return null }
    return ExecResult(raw!.stdout, raw!.stderr, raw!.exitCode)
}

// Path separator and line ending are derived from the platform name rather
// than queried, so the host reports one fact and the two spellings of it
// cannot disagree.
export fn platform() -> string { return __platform() }
export fn arch() -> string { return __arch() }
export fn sep() -> string {
    if (__platform() == "windows") { return "\\" }
    return "/"
}
export fn eol() -> string {
    if (__platform() == "windows") { return "\r\n" }
    return "\n"
}

export fn getenv(name: string) -> string? { return __getenv(name) }
export fn setenv(name: string, value: string) -> bool { return __setenv(name, value) }
export fn unsetenv(name: string) -> bool { return __unsetenv(name) }
// An entry without a separator, or one whose name is empty, is not a variable
// binding and is dropped. The rule lives here so both backends read it from
// the same place instead of each carrying a copy.
export fn environ() -> Map<string, string> {
    var out = Map<string, string>()
    for (entry in __environBlock()) {
        var eq = entry.indexOf("=")
        if (eq <= 0) { continue }
        out.set(entry.slice(0, eq), entry.slice(eq + 1))
    }
    return out
}
export fn exit(code: i64 = 0) { __exit(code) }
export fn getpid() -> i64 { return __getpid() }
export fn getcwd() -> string { return __getcwd() }
export fn hostname() -> string { return __hostname() }
export fn tmpdir() -> string { return __tmpdir() }
// The host answer wins; the environment chain is the documented fallback the
// two backends used to disagree about, so it is stated once here.
export fn username() -> string? {
    var system = __systemUsername()
    if (system != null && len(system!) > 0) { return system }
    if (platform() == "windows") {
        var named = __getenv("USERNAME")
        if (named != null && len(named!) > 0) { return named }
    }
    var user = __getenv("USER")
    if (user != null && len(user!) > 0) { return user }
    var login = __getenv("LOGNAME")
    if (login != null && len(login!) > 0) { return login }
    return null
}
// The environment wins over the host's record, which is what lets a caller
// redirect the home directory for a process. USERPROFILE is consulted only on
// Windows, where it is the platform's own spelling of the same thing.
export fn homedir() -> string? {
    var home = __getenv("HOME")
    if (home != null && len(home!) > 0) { return home }
    if (platform() == "windows") {
        var profile = __getenv("USERPROFILE")
        if (profile != null && len(profile!) > 0) { return profile }
    }
    var system = __systemHomedir()
    if (system != null && len(system!) > 0) { return system }
    return null
}
export fn uid() -> i64 { return __uid() }
export fn gid() -> i64 { return __gid() }
export fn cpuCount() -> i64 { return __cpuCount() }
export fn ppid() -> i64 { return __ppid() }
export fn kill(pid: i64, signal: i64 = 15) -> bool { return __kill(pid, signal) }
export fn totalMemory() -> i64 { return __totalMemory() }
export fn freeMemory() -> i64 { return __freeMemory() }
export fn uptime() -> f64 { return __uptime() }
export fn loadavg() -> Array<f64> { return __loadavg() }
export fn clock() -> f64 { return __clock() }
export fn sleep(ms: i64) { __sleep(ms) }

export fn exec(command: string) -> ExecResult? {
    return _execResult(__exec(command))
}

export fn spawn(program: string, args: Array<string>) -> ExecResult? {
    return _execResult(__spawn(program, args))
}
