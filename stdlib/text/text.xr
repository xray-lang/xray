// text - explicit Unicode-text operations for always-valid UTF-8 strings.

export fn lower(value: string) -> string {
    var out = StringBuilder()
    var iter = value.runes()
    while (iter.hasNext()) {
        var r = iter.next()
        var cp = (r.toUInt32() as i64)
        if (cp >= 65 && cp <= 90) {
            out.append(rune(cp + 32)!)
        } else {
            out.append(r)
        }
    }
    return out.toString()
}

export fn upper(value: string) -> string {
    var out = StringBuilder()
    var iter = value.runes()
    while (iter.hasNext()) {
        var r = iter.next()
        var cp = (r.toUInt32() as i64)
        if (cp >= 97 && cp <= 122) {
            out.append(rune(cp - 32)!)
        } else {
            out.append(r)
        }
    }
    return out.toString()
}

export fn trimStart(value: string) -> string {
    var start = 0
    var iter = value.runes()
    while (iter.hasNext()) {
        if (!iter.next().isWhitespace()) { break }
        start = start + 1
    }
    return value.slice(start, len(value))
}

export fn trimEnd(value: string) -> string {
    var end = len(value)
    while (end > 0 && value.runes().nth(end - 1).isWhitespace()) { end = end - 1 }
    return value.slice(0, end)
}

export fn trim(value: string) -> string {
    return trimEnd(trimStart(value))
}

export fn reverseRunes(value: string) -> string {
    var out = StringBuilder()
    for (var i = len(value); i > 0; i--) { out.append(value.runes().nth(i - 1)) }
    return out.toString()
}

export fn padStart(value: string, targetLength: i64, padding: string = " ") -> string {
    if (targetLength <= len(value) || len(padding) == 0) { return value }
    var out = StringBuilder()
    var needed = targetLength - len(value)
    for (var i = 0; i < needed; i++) { out.append(padding.runes().nth(i % len(padding))) }
    out.append(value)
    return out.toString()
}

export fn padEnd(value: string, targetLength: i64, padding: string = " ") -> string {
    if (targetLength <= len(value) || len(padding) == 0) { return value }
    var out = StringBuilder()
    out.append(value)
    var needed = targetLength - len(value)
    for (var i = 0; i < needed; i++) { out.append(padding.runes().nth(i % len(padding))) }
    return out.toString()
}

export fn translate(value: string, table: Map<string, string>) -> string {
    var out = StringBuilder()
    var iter = value.runes()
    while (iter.hasNext()) {
        var r = iter.next()
        var key = r.toString()
        var translated = key
        for (candidate, replacement in table) {
            if (candidate == key) {
                translated = replacement
                break
            }
        }
        out.append(translated)
    }
    return out.toString()
}
