// text - explicit Unicode-text operations for always-valid UTF-8 strings.

export fn lower(value: string) -> string {
    var out = ""
    var iter = value.runes()
    while (iter.hasNext()) {
        var r = iter.next()
        var cp = (r.toUInt32() as i64)
        if (cp >= 65 && cp <= 90) {
            out += "${rune(cp + 32)!}"
        } else {
            out += "${r}"
        }
    }
    return out
}

export fn upper(value: string) -> string {
    var out = ""
    var iter = value.runes()
    while (iter.hasNext()) {
        var r = iter.next()
        var cp = (r.toUInt32() as i64)
        if (cp >= 97 && cp <= 122) {
            out += "${rune(cp - 32)!}"
        } else {
            out += "${r}"
        }
    }
    return out
}

export fn trimStart(value: string) -> string {
    var start = 0
    var iter = value.runes()
    while (iter.hasNext()) {
        if (!iter.next().isWhitespace()) { break }
        start = start + 1
    }
    return value.slice(start, len(value))
}

export fn trimEnd(value: string) -> string {
    var end = len(value)
    while (end > 0 && value.runes().nth(end - 1).isWhitespace()) { end = end - 1 }
    return value.slice(0, end)
}

export fn trim(value: string) -> string {
    return trimEnd(trimStart(value))
}

export fn reverseRunes(value: string) -> string {
    const input = value.bytes()
    var end = len(input)
    var output: Array<u8> = []
    while (end > 0) {
        var begin = end - 1
        var first = input[begin] as i64
        while (first >= 128 && first < 192) {
            begin -= 1
            first = input[begin] as i64
        }
        for (var offset = begin; offset < end; offset++) {
            output.push(input[offset])
        }
        end = begin
    }
    return try! string.fromUtf8(output[:])
}

export fn padStart(value: string, targetLength: i64, padding: string = " ") -> string {
    if (targetLength <= len(value) || len(padding) == 0) { return value }
    var out = ""
    var needed = targetLength - len(value)
    for (var i = 0; i < needed; i++) { out += "${padding.runes().nth(i % len(padding))}" }
    out += value
    return out
}

export fn padEnd(value: string, targetLength: i64, padding: string = " ") -> string {
    if (targetLength <= len(value) || len(padding) == 0) { return value }
    var out = ""
    out += value
    var needed = targetLength - len(value)
    for (var i = 0; i < needed; i++) { out += "${padding.runes().nth(i % len(padding))}" }
    return out
}

export fn translate(value: string, table: Map<string, string>) -> string {
    const input = value.bytes()
    var position = 0
    var out = ""
    while (position < len(input)) {
        const first = input[position] as i64
        var width = 1
        if (first >= 240) { width = 4 }
        else if (first >= 224) { width = 3 }
        else if (first >= 192) { width = 2 }
        // A string is valid UTF-8 and this range is exactly one scalar.
        const key = string.fromUtf8Lossy(input[position:position+width])
        const replacement = table.get(key)
        if (replacement == null) { out += key }
        else { out += replacement! }
        position += width
    }
    return out
}
