// Built-in pull iterator handle. Generator-backed and collection-backed
// implementations share this sealed native surface.
class Iterator<T> {
    // @lowered
    hasNext() -> bool
    // @lowered
    next() -> T
    // @lowered
    nth(index: i64) -> T
    // An iterator is its own iterable; ownership is compiler-owned contract
    // data rather than part of this signature-only source.
    iterator() -> Iterator<T>
    toString() -> string
}
