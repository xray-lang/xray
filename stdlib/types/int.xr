// Built-in int type — implementation in src/runtime/value/xint_methods.c

@native
class int {
    abs() -> int
    toString() -> string
    toBigInt() -> BigInt
    toFloat() -> float
    toHex() -> string
    max(other: int) -> int
    min(other: int) -> int
    floor() -> int
    ceil() -> int
    round() -> int
    sqrt() -> float
    pow(exp: float) -> float
    checkedAdd(other: int) -> int?
    checkedSub(other: int) -> int?
    checkedMul(other: int) -> int?
    saturatingAdd(other: int) -> int
    saturatingSub(other: int) -> int
    saturatingMul(other: int) -> int
    wrappingAdd(other: int) -> int
    wrappingSub(other: int) -> int
    wrappingMul(other: int) -> int
}
