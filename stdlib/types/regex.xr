// Built-in Regex type — implementation in stdlib/regex/xregex_binding.c
class RegexMatch {
    start: i64
    end: i64
    text: string
    groups: Array<string>
}
class Regex {
    test(text: string) -> bool
    find(text: string) -> RegexMatch?
    findText(text: string) -> string?
    findGroup(text: string, index: i64) -> string?
    findAll(text: string, limit?: i64) -> Array<RegexMatch>
    replace(text: string, replacement: string) -> string
    split(text: string, limit?: i64) -> Array<string>
}
