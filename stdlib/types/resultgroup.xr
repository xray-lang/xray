// Built-in ResultGroup type; implemented by the runtime.
// First VM prototype supports integer associative reduction.

@native
class ResultGroup {
    length: int
    pendingCount: int
    batchSize: int
    isClosed: bool
    add(value: int) -> bool
    flush()
    reset(count: int) -> bool
    recv(): int?
    tryRecv(): (int?, bool)
    close()
}
