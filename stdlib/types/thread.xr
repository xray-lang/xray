// Built-in Thread<T> type (sys.Thread); implemented by the runtime.
//
// A real OS thread (not a coroutine): the body closure runs to completion on
// its own execution context. `join()` blocks the caller until it finishes and
// returns the closure's value; `detach()` releases it to run unwaited.
// Constructed via the native `call` static, i.e. `Thread<T>(body)`.

@native
class Thread<T> {
    join() -> T
    detach()
}
