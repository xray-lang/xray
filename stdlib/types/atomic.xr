// Built-in Atomic<T> type; implemented by the runtime.

@native
class Atomic<T> {
    load(ordering?: Ordering) -> T
    store(value: T, ordering?: Ordering)
    add(delta: T, ordering?: Ordering)
    sub(delta: T, ordering?: Ordering)
    fetchAdd(delta: T, ordering?: Ordering) -> T
    fetchSub(delta: T, ordering?: Ordering) -> T
    swap(value: T, ordering?: Ordering) -> T
    compareExchange(expected: T, desired: T, ordering?: Ordering) -> (T, bool)
    toggle(ordering?: Ordering) -> bool
    toString() -> string
}
