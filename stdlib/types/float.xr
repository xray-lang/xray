// Built-in float type — implementation in src/runtime/value/xfloat_methods.c

@native
class float {
    abs() -> float @no_alloc
    toString() -> string @may_alloc
    toFixed(decimals?: int) -> string @may_alloc
    toInt() -> int @no_alloc
    floor() -> int @no_alloc
    ceil() -> int @no_alloc
    round() -> int @no_alloc
    sqrt() -> float @no_alloc
    pow(exp: float) -> float @no_alloc
    isNaN() -> bool @no_alloc
}
