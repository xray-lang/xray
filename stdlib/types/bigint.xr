// Built-in BigInt type — implementation in src/runtime/object/xbigint_methods.c

@native
class BigInt {
    abs() -> BigInt @may_alloc
    toString() -> string @may_alloc
    sign() -> int @no_alloc
    isZero() -> bool @no_alloc
    isNegative() -> bool @no_alloc
    isPositive() -> bool @no_alloc
    toInt() -> int? @no_alloc
    toFloat() -> float @no_alloc
}
