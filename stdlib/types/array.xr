// Governed native value declaration. Unmarked members require separate admission.
// @native-type id=1
struct Array<T> {
    static withCapacity(capacity: i64) -> Array<T>
    capacity: i64
    // @native-operation ARRAY_PUSH allocation=may_heap failures=allocation,retain,limit ownership=unit
    ref push(value: T) -> ()
    // @lowered
    // @native-operation ARRAY_GET allocation=may_heap failures=bounds,allocation,retain,limit ownership=owned
    get(index: i64) -> T
    // @lowered
    // @native-operation ARRAY_SET allocation=may_heap failures=bounds,allocation,retain,limit ownership=unit
    ref set(index: i64, value: T) -> ()
    // @lowered
    ptr() -> Ptr<T>
    // @lowered
    mutPtr() -> MutPtr<T>
    // @native-operation ARRAY_POP allocation=may_heap failures=allocation,retain,limit ownership=owned
    ref pop() -> T?
    // @native-operation ARRAY_SHIFT allocation=may_heap failures=allocation,retain,limit ownership=owned
    ref shift() -> T?
    // @native-operation ARRAY_UNSHIFT allocation=may_heap failures=allocation,retain,limit ownership=unit
    ref unshift(value: T)
    // @native-operation ARRAY_CLEAR allocation=may_heap failures=allocation,retain,limit ownership=unit
    ref clear()
    ref reserve(capacity: i64) -> Array<T>
    // @native-operation ARRAY_RESIZE allocation=may_heap failures=allocation,retain,limit ownership=owned
    ref resize(length: i64, fill: T) -> Array<T>
    concat(...arrays: Array<T>) -> Array<T>
    // @native-operation ARRAY_INDEX_OF allocation=may_heap failures=allocation,retain,limit ownership=owned
    indexOf(value: T) -> i64
    // @native-operation ARRAY_CONTAINS allocation=may_heap failures=allocation,retain,limit ownership=owned
    contains(value: T) -> bool
    // @native-operation ARRAY_JOIN allocation=may_heap failures=allocation,retain,limit ownership=owned
    join(separator?: string) -> string
    // @native-operation ARRAY_REVERSE allocation=may_heap failures=allocation,retain,limit ownership=owned
    ref reverse() -> Array<T>
    ref sort(compareFn?: fn(a: T, b: T) -> i64) -> Array<T>
    // U is inferred only from the checked callback signature, not a receiver type parameter.
    // @native-operation ARRAY_MAP allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    map(fn: fn(item: T, index: i64) -> U) -> Array<U>
    // @native-operation ARRAY_FILTER allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    filter(fn: fn(item: T, index: i64) -> bool) -> Array<T>
    // @native-operation ARRAY_REDUCE allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    reduce(fn: fn(acc: U, item: T) -> U, initial: U) -> U
    // @native-operation ARRAY_FOR_EACH allocation=may_heap failures=allocation,retain,limit,callback ownership=unit
    forEach(fn: fn(item: T, index: i64)) -> ()
    // @native-operation ARRAY_FIND allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    find(fn: fn(item: T) -> bool) -> T?
    // @native-operation ARRAY_FIND_INDEX allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    findIndex(fn: fn(item: T) -> bool) -> i64
    // @native-operation ARRAY_EVERY allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    every(fn: fn(item: T) -> bool) -> bool
    // @native-operation ARRAY_SOME allocation=may_heap failures=allocation,retain,limit,callback ownership=owned
    some(fn: fn(item: T) -> bool) -> bool
    ref fill(value: T, start?: i64, end?: i64) -> Array<T>
    // All arrays, including Array<byte>, render the "[a, b]" container form.
    // Decode UTF-8 byte arrays explicitly with string.fromUtf8().
    toString() -> string
    // Iteration protocol — used by for-in lowering. Users can also
    // call them directly; iterator()/next() yields elements, while
    // entriesIterator()/next() yields (index, element) tuples.
    iterator() -> Iterator<T>
    entriesIterator() -> Iterator<(i64, T)>
    // @native-operation ARRAY_ENTRIES allocation=may_heap failures=allocation,retain,limit ownership=owned
    entries() -> Array<(i64, T)>
}
