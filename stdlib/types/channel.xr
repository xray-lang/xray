// Built-in Channel<T> type — implementation in src/runtime/coro/xchannel_methods.c

enum Recv<T> {
    Value(T)
    Empty
    Timeout
    Closed
}

enum SendResult {
    Sent
    Full
    Timeout
    Closed
}

@native
class Channel<T> {
    capacity: int
    isClosed: bool

    // @receiver_write
    send(value: T)
    // @receiver_write
    recv() -> Recv<T>
    // @receiver_write
    recvOr(default: T) -> T

    // @receiver_write
    trySend(value: T) -> SendResult
    // @receiver_write
    tryRecv() -> Recv<T>

    // @receiver_write
    sendTimeout(value: T, timeout: int) -> SendResult
    // @receiver_write
    recvTimeout(timeout: int) -> Recv<T>

    // @receiver_write
    close()
}
