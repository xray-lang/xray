// Built-in Channel<T> type — implementation in src/runtime/coro/xchannel_methods.c

enum Recv<T> {
    Value(T)
    Empty
    Timeout
    Closed
}

enum SendResult {
    Sent
    Full
    Timeout
    Closed
}

@native
class Channel<T> {
    length: int
    capacity: int
    isClosed: bool

    send(value: T)
    recv() -> Recv<T>
    recvOr(default: T) -> T

    trySend(value: T) -> SendResult
    tryRecv() -> Recv<T>

    sendTimeout(value: T, timeout: int) -> SendResult
    recvTimeout(timeout: int) -> Recv<T>

    close()
}
