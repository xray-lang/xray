// Built-in Channel<T> type — implementation in src/runtime/coro/xchannel_methods.c

enum Recv<T> {
    Value { value: T },
    Empty,
    Timeout,
    Closed,
}

enum SendResult {
    Sent,
    Full,
    Timeout,
    Closed,
}
class Channel<T> {
    capacity: i64
    isClosed: bool

    send(value: T)
    recv() -> Recv<T>
    recvOr(default: T) -> T

    trySend(value: T) -> SendResult
    tryRecv() -> Recv<T>

    sendTimeout(value: T, timeout: i64) -> SendResult
    recvTimeout(timeout: i64) -> Recv<T>

    close()
}
