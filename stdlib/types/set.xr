// Built-in Set<T> type — implementation in src/runtime/object/xset_methods.c
class Set<T: Hashable> {
    // @receiver_write
    add(value: T)
    contains(value: T) -> bool
    // @receiver_write
    delete(value: T) -> bool
    // @receiver_write
    clear()
    values() -> Array<T>
    forEach(fn: (value: T) -> ()) -> ()
    union(other: Set<T>) -> Set<T>
    intersection(other: Set<T>) -> Set<T>
    difference(other: Set<T>) -> Set<T>
    symmetricDifference(other: Set<T>) -> Set<T>
    isSubset(other: Set<T>) -> bool
    isSuperset(other: Set<T>) -> bool
    toArray() -> Array<T>
    // Iteration protocol — yields each element T (used by for-in).
    iterator() -> Iterator<T>
    toString() -> string
}
