// Built-in Task type (coroutine handle) — implementation in src/runtime/coro/

enum TaskResult<T> {
    Success(T)
    Failed(Exception)
    Cancelled
    Timeout
    Pending
}

enum TaskOutcome {
    Success(unknown)
    Failed(unknown)
    Cancelled
}

enum TaskStatus {
    Pending
    Running
    Success
    Failed
    Cancelled
}

@native
class Task<T> {
    done: bool
    status: TaskStatus

    cancel()
    poll() -> TaskResult<T>
    awaitResult() -> TaskResult<T>
    awaitTimeout(timeout: int) -> TaskResult<T>
}
