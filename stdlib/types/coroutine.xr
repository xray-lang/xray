// Built-in Task type (coroutine handle) — implementation in src/runtime/coro/

enum TaskResult<T> {
    Success(T)
    Failed(Error)
    Cancelled
    Timeout
    Pending
}

enum TaskStatus {
    Pending
    Running
    Success
    Failed
    Cancelled
}
class Task<T> {
    done: bool
    status: TaskStatus

    // @receiver_write
    cancel()
    // @receiver_write
    poll() -> TaskResult<T>
    // @receiver_write
    awaitResult() -> TaskResult<T>
    // @receiver_write
    awaitTimeout(timeout: i64) -> TaskResult<T>
}
