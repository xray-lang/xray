// Built-in Task type (coroutine handle) — implementation in src/runtime/coro/

enum TaskResult<T, E: Error> {
    Success { value: T },
    Error { error: E },
    Panic { info: PanicInfo },
    Cancelled,
}
class Task<T: Sendable, E: Error & Sendable = Never> {
    ref cancel()
    ref poll() -> TaskResult<T, E>?
    ref awaitResult() -> TaskResult<T, E>
    private static __allBegin(tasks: Array<Task<T, E>>) -> Task<Array<T>, E>
    private static __firstBegin(tasks: Array<Task<T, E>>) -> Task<T, E>
}
