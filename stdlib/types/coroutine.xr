// Built-in Task type (coroutine handle) — implementation in src/runtime/coro/

enum TaskResult<T> {
    Success { value: T },
    Failed { error: Error },
    Cancelled,
    Timeout,
    Pending,
}

enum TaskStatus {
    Pending,
    Running,
    Success,
    Failed,
    Cancelled,
}
class Task<T> {
    done: bool
    status: TaskStatus

    ref cancel()
    ref poll() -> TaskResult<T>
    ref awaitResult() -> TaskResult<T>
    ref awaitTimeout(timeout: i64) -> TaskResult<T>
}
