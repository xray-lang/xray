// Built-in WorkQueue<T> type; implemented by the runtime.
class WorkQueue<T> {
    shardCount: i64
    isClosed: bool
    push(value: T, shard?: i64) -> bool
    // WorkQueue<int> only: enqueue count consecutive integer jobs and return the accepted count.
    pushRange(start: i64, count: i64, shardStart?: i64) -> i64
    pop(workerId?: i64): T?
    tryPop(workerId?: i64): (T?, bool)
    close()
}
