// Prelude JSON namespace — implemented by compiler/runtime builtins. JSON is
// never a value type; source annotations use JSON.Value or JSON.Object.
class JSON {
    // @lowered
    static parse<T>(text: string, unknown?: JSON.UnknownFields) -> T
    static parseObject(text: string) -> JSON.Object
    static parseValue(text: string) -> JSON.Value
    // @lowered
    static parseWithRest<T>(text: string,
                            nestedUnknownFields?: JSON.UnknownFields) -> JSON.WithRest<T>
    // @lowered
    static decode<T>(value: JSON.Value, unknown?: JSON.UnknownFields) -> T?
    // @lowered
    static decodeObject<T>(value: JSON.Object, unknown?: JSON.UnknownFields) -> T?
    static stringify<T>(value: T, indent?: i64) -> string
    static value<T>(value: T) -> JSON.Value
    static isValid(text: string, strict?: bool) -> bool
    static kindOf(value: JSON.Value) -> string
    static isNull(value: JSON.Value) -> bool
    static isBool(value: JSON.Value) -> bool
    static isInt(value: JSON.Value) -> bool
    static isFloat(value: JSON.Value) -> bool
    static isString(value: JSON.Value) -> bool
    static isArray(value: JSON.Value) -> bool
    static isObject(value: JSON.Value) -> bool
    static asObject(value: JSON.Value) -> JSON.Object?
    static asArray(value: JSON.Value) -> Array<JSON.Value>?
    static get<T>(root: JSON.Value | JSON.Object, path: JSON.Path) -> T?
    static require<T>(root: JSON.Value | JSON.Object, path: JSON.Path) -> T
    static containsPath(root: JSON.Value | JSON.Object, path: JSON.Path) -> bool
    static set(root: JSON.Value | JSON.Object, path: JSON.Path, value: JSON.Value, createParents?: bool) -> ()
    static remove(root: JSON.Value | JSON.Object, path: JSON.Path) -> bool
    static merge<T>(parts: JSON.WithRest<T>) -> JSON.Object
}
