// Built-in Json type — implementation in src/runtime/object/xjson_methods.c

@native
class Json {
    static parse(text: string) -> Json
    static stringify(value: unknown, indent?: int) -> string
    static encode(value: unknown) -> Json
    static isValid(text: string, strict?: bool) -> bool
    static tryParse(text: string) -> Json
    static keys(obj: Json) -> Array<string>
    static values(obj: Json) -> Array<Json>
    static entries(obj: Json) -> Array<(string, Json)>
    static has(obj: Json, key: string) -> bool
    static get(obj: Json, key: string, default?: unknown) -> Json
    static size(obj: Json) -> int
    static isEmpty(obj: Json) -> bool

    keys() -> Array<string>
    values() -> Array<Json>
    entries() -> Array<(string, Json)>
    // Iteration protocol — iterator() yields each field name (used by
    // single-variable `for (k in jsonObj)`); entriesIterator() yields
    // (fieldName, value) tuples (used by `for (k, v in jsonObj)`).
    iterator() -> Iterator<string>
    entriesIterator() -> Iterator<(string, Json)>
    has(key: string) -> bool
    get(key: string) -> Json
    isEmpty() -> bool
    delete(key: string)
    clear()
    toString() -> string
}
