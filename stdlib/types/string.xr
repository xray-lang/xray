// Governed immutable string value declaration.
enum Utf8Error {
    InvalidUtf8
}
enum StringSliceError {
    InvalidByteRange
}
// @native-type id=2
struct string {
    // @native-operation STRING_FROM_UTF8 allocation=may_heap failures=utf8,allocation,retain,limit ownership=owned
    static fromUtf8(bytes: Slice<u8>) throws(Utf8Error) -> string
    static fromUtf8Lossy(bytes: Slice<u8>) -> string
    static fromRune(value: rune) -> string
    static join(parts: Array<string>, separator?: string) -> string
    // @native-operation STRING_CONTAINS allocation=no_heap failures=none ownership=owned
    contains(search: string) -> bool
    // @native-operation STRING_INDEX_OF allocation=no_heap failures=bounds,limit ownership=owned
    indexOf(search: string, start?: i64) -> i64
    // @native-operation STRING_LAST_INDEX_OF allocation=no_heap failures=limit ownership=owned
    lastIndexOf(search: string) -> i64
    // @native-operation STRING_SLICE allocation=may_heap failures=bounds,allocation,retain,limit ownership=owned
    slice(start: i64, end?: i64) -> string
    sliceBytes(start: i64, end: i64) -> string
    // @native-operation STRING_TO_STRING allocation=no_heap failures=retain ownership=owned
    toString() -> string
    split(separator: string) -> Array<string>
    // @native-operation STRING_REPLACE allocation=may_heap failures=allocation,retain,limit ownership=owned
    replace(search: string, replacement: string) -> string
    // @native-operation STRING_REPLACE_ALL allocation=may_heap failures=allocation,retain,limit ownership=owned
    replaceAll(search: string, replacement: string) -> string
    // @native-operation STRING_REPEAT allocation=may_heap failures=allocation,retain,limit ownership=owned
    repeat(count: i64) -> string
    // @native-operation STRING_STARTS_WITH allocation=no_heap failures=none ownership=owned
    startsWith(search: string) -> bool
    // @native-operation STRING_ENDS_WITH allocation=no_heap failures=none ownership=owned
    endsWith(search: string) -> bool
    // Owned UTF-8 byte bridge.
    // @native-operation STRING_COPY_BYTES allocation=may_heap failures=allocation,retain,limit ownership=owned
    copyBytes() -> Array<u8>
    // Borrowed UTF-8 bytes; readonly because strings are immutable.
    // @lowered
    bytes() -> Slice<u8>
    // @native-operation STRING_RUNES allocation=may_heap failures=allocation,retain,limit ownership=owned
    runes() -> Iterator<rune>
}
