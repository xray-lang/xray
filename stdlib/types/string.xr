// Built-in string type — implementation in src/runtime/object/xstring_methods.c
//
// Most methods declared here exist in the VM method table
// (xstring_methods.c) with matching semantics. Compiler-lowered view
// constructors such as bytes() may bypass the bound-method table to preserve
// zero-allocation value semantics. Methods also supported by the AOT dispatch
// (src/aot/xrt_method.h + xi_method_sym.def) compile to native code, while
// VM-only methods fail AOT codegen with an explicit "unsupported AOT method"
// error (never a silent null).

@native
class string {
    length: int
    byteLength: int
    charAt(index: int) -> string
    codePointAt(index: int) -> int
    byteAt(index: int) -> string?
    ord() -> int?
    concat(...strings: string) -> string
    includes(search: string) -> bool
    indexOf(search: string, start?: int) -> int
    lastIndexOf(search: string) -> int
    slice(start: int, end?: int) -> string
    substring(start: int, end?: int) -> string
    isEmpty() -> bool
    toLowerCase() -> string
    toUpperCase() -> string
    toInt() -> int?
    toFloat() -> float?
    toString() -> string
    trim() -> string
    trimStart() -> string
    trimEnd() -> string
    split(separator: string, limit?: int) -> Array<string>
    replace(search: string, replacement: string) -> string
    replaceAll(search: string, replacement: string) -> string
    repeat(count: int) -> string
    reverse() -> string
    startsWith(search: string) -> bool
    endsWith(search: string) -> bool
    padStart(length: int, pad?: string) -> string
    padEnd(length: int, pad?: string) -> string
    match(pattern: Regex) -> Array<string>?
    // Owned UTF-8 byte bridge — round-trips with Bytes.toString().
    toBytes() -> Bytes
    // Borrowed UTF-8 bytes; readonly because strings are immutable.
    // @lowered
    bytes() -> ByteSpan
    translate(table: Map<string, string>) -> string
    // Iteration protocol — iterator() yields each character, while
    // entriesIterator() yields (charIndex, character) tuples. Both
    // are used by for-in lowering and may be called directly.
    iterator() -> Iterator<char>
    entriesIterator() -> Iterator<(int, char)>
    entries() -> Array<(int, char)>
}
