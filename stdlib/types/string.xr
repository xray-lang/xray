// Built-in string type — implementation in src/runtime/object/xstring_methods.c
//
// Most methods declared here exist in the VM method table
// (xstring_methods.c) with matching semantics. Compiler-lowered view
// constructors such as bytes() may bypass the bound-method table to preserve
// zero-allocation value semantics. Methods also supported by the AOT dispatch
// (src/aot/xrt_method.h + xi_method_sym.def) compile to native code, while
// VM-only methods fail AOT codegen with an explicit "unsupported AOT method"
// error (never a silent null).

@native
enum Utf8Error {
    InvalidUtf8
}

@native
enum StringSliceError {
    InvalidByteRange
}

@native
class string {
    static fromUtf8(bytes: Slice<byte>) -> string @errors(Utf8Error.InvalidUtf8) @may_alloc
    static fromUtf8Lossy(bytes: Slice<byte>) -> string @nothrow @may_alloc
    static fromRune(value: rune) -> string @nothrow @may_alloc
    static join(parts: Array<string>, separator?: string) -> string @nothrow @may_alloc
    contains(search: string) -> bool @nothrow @no_alloc
    indexOf(search: string, start?: int) -> int @nothrow @no_alloc
    lastIndexOf(search: string) -> int @nothrow @no_alloc
    slice(start: int, end?: int) -> string @may_alloc
    sliceBytes(start: int, end: int) -> string @errors(StringSliceError.InvalidByteRange) @may_alloc
    toString() -> string @nothrow @no_alloc
    split(separator: string, limit?: int) -> Array<string> @nothrow @may_alloc
    replace(search: string, replacement: string) -> string @nothrow @may_alloc
    replaceAll(search: string, replacement: string) -> string @nothrow @may_alloc
    repeat(count: int) -> string @nothrow @may_alloc
    startsWith(search: string) -> bool @nothrow @no_alloc
    endsWith(search: string) -> bool @nothrow @no_alloc
    // Owned UTF-8 byte bridge.
    copyBytes() -> Array<byte> @nothrow @may_alloc
    // Borrowed UTF-8 bytes; readonly because strings are immutable.
    // @lowered
    bytes() -> Slice<byte> @no_alloc
    runes() -> Iterator<rune> @nothrow @may_alloc
}
