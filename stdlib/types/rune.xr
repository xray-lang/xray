// Built-in Unicode scalar type. A rune is always a valid Unicode scalar value.

@native
class rune {
    toUInt32() -> uint32 @nothrow @no_alloc
    toString() -> string @nothrow @may_alloc
    isLetter() -> bool @nothrow @no_alloc
    isNumber() -> bool @nothrow @no_alloc
    isAlphanumeric() -> bool @nothrow @no_alloc
    isWhitespace() -> bool @nothrow @no_alloc
}
