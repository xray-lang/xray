// sys process handles.
//
// The C layer exposes only private double-underscore helpers. This script
// layer keeps the public surface typed and small: Process, Pipe, Dylib, and
// portable signal names. ProcessOptions grows only through general process
// capability fields; stdio redirection reuses Pipe rather than splitting
// reader/writer endpoint classes prematurely.

enum Signal {
    TERM,
    KILL,
    INT
}

class Pipe {
    _readHandle: int
    _writeHandle: int
    _readOpen: bool
    _writeOpen: bool

    constructor(readHandle: int, writeHandle: int) {
        this._readHandle = readHandle
        this._writeHandle = writeHandle
        this._readOpen = readHandle >= 0
        this._writeOpen = writeHandle >= 0
    }

    readEnd() -> int { return this._readHandle }

    writeEnd() -> int { return this._writeHandle }

    read(maxBytes: int = 8192) -> Bytes? {
        if (!this._readOpen || maxBytes < 0) { return null }
        return __pipeRead(this._readHandle, maxBytes)
    }

    write(data: Bytes) -> int {
        if (!this._writeOpen) { return -1 }
        return __pipeWrite(this._writeHandle, data)
    }

    closeRead() -> bool {
        if (!this._readOpen) { return true }
        var ok = __pipeClose(this._readHandle)
        this._readOpen = false
        return ok
    }

    closeWrite() -> bool {
        if (!this._writeOpen) { return true }
        var ok = __pipeClose(this._writeHandle)
        this._writeOpen = false
        return ok
    }

    close() -> bool {
        var r = this.closeRead()
        var w = this.closeWrite()
        return r && w
    }

    static open() -> Pipe? {
        var ends = __pipeOpen()
        if (ends == null || ends!.length < 2) { return null }
        return Pipe(ends![0], ends![1])
    }
}

class ProcessOptions {
    cwd: string?
    env: Map<string, string>?
    stdin: int?
    stdout: int?
    stderr: int?

    constructor(cwd: string? = null, env: Map<string, string>? = null, stdin: int? = null,
                stdout: int? = null, stderr: int? = null) {
        this.cwd = cwd
        this.env = env
        this.stdin = stdin
        this.stdout = stdout
        this.stderr = stderr
    }
}

class Process {
    _id: int
    _open: bool

    constructor(id: int) {
        this._id = id
        this._open = id > 0
    }

    id: int { fn() { return this._id } }

    wait() -> int {
        if (!this._open) { return -1 }
        var code = __processWait(this._id)
        this._open = false
        return code
    }

    tryWait() -> int? {
        if (!this._open) { return -1 }
        var code = __processTryWait(this._id)
        if (code != null) {
            this._open = false
        }
        return code
    }

    kill(signal: Signal = Signal.TERM) -> bool {
        if (!this._open) { return false }
        var sig = match (signal) {
            Signal.TERM -> 15
            Signal.KILL -> 9
            Signal.INT -> 2
        }
        return __processKill(this._id, sig)
    }

    static spawn(program: string, args: Array<string> = [], options: ProcessOptions? = null) -> Process? {
        var cwd: string? = null
        var envKeys: Array<string>? = null
        var envValues: Array<string>? = null
        var stdinRead: int? = null
        var stdoutWrite: int? = null
        var stderrWrite: int? = null
        if (options != null) {
            cwd = options!.cwd
            if (options!.env != null) {
                envKeys = options!.env!.keys()
                envValues = options!.env!.values()
            }
            if (options!.stdin != null) {
                stdinRead = options!.stdin
            }
            if (options!.stdout != null) {
                stdoutWrite = options!.stdout
            }
            if (options!.stderr != null) {
                stderrWrite = options!.stderr
            }
        }
        var id = __processSpawn(program, args, cwd, envKeys, envValues,
            stdinRead, stdoutWrite, stderrWrite)
        if (id <= 0) { return null }
        return Process(id)
    }
}

class ThreadLocal<T> {
    _lock: OsMutex
    _values: Map<int, T>
    _init: () -> T

    constructor(init: () -> T) {
        this._lock = __osMutexNew()
        this._values = #{}
        this._init = init
    }

    get() -> T {
        var key = __threadLocalId()
        this._lock.lock()
        var existing = this._values.get(key)
        this._lock.unlock()
        if (existing != null) { return existing! }

        var init = this._init
        var value = init()
        this._lock.lock()
        if (!this._values.has(key)) {
            this._values.set(key, value)
        }
        var current = this._values.get(key)!
        this._lock.unlock()
        return current
    }

    set(value: T) {
        var key = __threadLocalId()
        this._lock.lock()
        this._values.set(key, value)
        this._lock.unlock()
    }
}

class Dylib {
    _handle: int
    _open: bool

    constructor(handle: int) {
        this._handle = handle
        this._open = handle != 0
    }

    symbol(name: string) -> RawPtr<uint8>? {
        if (!this._open) { return null }
        return __dylibSymbol(this._handle, name)
    }

    close() -> bool {
        if (!this._open) { return true }
        var ok = __dylibClose(this._handle)
        this._handle = 0
        this._open = false
        return ok
    }

    static open(path: string) -> Dylib? {
        var handle = __dylibOpen(path)
        if (handle == 0) { return null }
        return Dylib(handle)
    }

    static lastError() -> string {
        return __dylibLastError()
    }
}

export { Process, ProcessOptions, Signal, Pipe, ThreadLocal, Dylib }
