// sys process handles and OS-thread synchronization.
//
// The C layer exposes only private double-underscore helpers. This script
// layer keeps the public surface typed and small: Process, Pipe, Dylib, and
// portable signal names. ProcessOptions grows only through general process
// capability fields; stdio redirection reuses Pipe rather than splitting
// reader/writer endpoint classes prematurely. Synchronization policy is
// source-owned and built from atomic runtime primitives; native code is kept
// only for direct host ABI operations.

import time

enum _SysError {
    InvalidBarrierParties
}

fn _spinAcquire(flag: Atomic<bool>) {
    while (true) {
        var (_, acquired) = flag.compareExchange(false, true, Ordering.AcquireRelease)
        if (acquired) { return }
        __threadYield()
    }
}

export class OsMutex {
    private _locked: Atomic<bool>

    constructor() {
        this._locked = Atomic<bool>(false)
    }

    lock() { _spinAcquire(this._locked) }

    unlock() { this._locked.store(false, Ordering.Release) }

    tryLock() -> bool {
        var (_, acquired) = this._locked.compareExchange(false, true, Ordering.AcquireRelease)
        return acquired
    }
}

// A negative state denotes a writer; non-negative values count readers.
export class OsRwLock {
    private _state: Atomic<i64>

    constructor() {
        this._state = Atomic<i64>(0)
    }

    rdlock() {
        while (true) {
            var current = this._state.load(Ordering.Acquire)
            if (current >= 0) {
                var (_, acquired) = this._state.compareExchange(
                    current, current + 1, Ordering.AcquireRelease)
                if (acquired) { return }
            }
            __threadYield()
        }
    }

    rdunlock() { this._state.fetchSub(1, Ordering.Release) }

    wrlock() {
        while (true) {
            var (_, acquired) = this._state.compareExchange(0, -1, Ordering.AcquireRelease)
            if (acquired) { return }
            __threadYield()
        }
    }

    wrunlock() { this._state.store(0, Ordering.Release) }
}

// Waiters observe an epoch. Unlocking around the wait remains source policy;
// the only host interaction is yielding the current OS thread.
export class OsCondvar {
    private _epoch: Atomic<i64>

    constructor() {
        this._epoch = Atomic<i64>(0)
    }

    wait(mutex: OsMutex) {
        const observed = this._epoch.load(Ordering.Acquire)
        mutex.unlock()
        while (this._epoch.load(Ordering.Acquire) == observed) { __threadYield() }
        mutex.lock()
    }

    waitFor(mutex: OsMutex, timeoutNs: i64) -> bool {
        if (timeoutNs <= 0) { return false }
        const observed = this._epoch.load(Ordering.Acquire)
        const deadline = time.nanos() + timeoutNs
        mutex.unlock()
        while (this._epoch.load(Ordering.Acquire) == observed) {
            if (time.nanos() >= deadline) {
                mutex.lock()
                return false
            }
            __threadYield()
        }
        mutex.lock()
        return true
    }

    signal() { this._epoch.fetchAdd(1, Ordering.Release) }

    broadcast() { this._epoch.fetchAdd(1, Ordering.Release) }
}

export class OsBarrier {
    private _parties: i64
    private _arrived: Atomic<i64>
    private _generation: Atomic<i64>

    constructor(parties: i64) {
        if (parties <= 0) { throw _SysError.InvalidBarrierParties }
        this._parties = parties
        this._arrived = Atomic<i64>(0)
        this._generation = Atomic<i64>(0)
    }

    wait() -> bool {
        const generation = this._generation.load(Ordering.Acquire)
        const position = this._arrived.fetchAdd(1, Ordering.AcquireRelease) + 1
        if (position == this._parties) {
            this._arrived.store(0, Ordering.Release)
            this._generation.fetchAdd(1, Ordering.AcquireRelease)
            return true
        }
        while (this._generation.load(Ordering.Acquire) == generation) { __threadYield() }
        return true
    }
}

export class OsOnce {
    private _gate: Atomic<bool>
    private _done: Atomic<bool>

    constructor() {
        this._gate = Atomic<bool>(false)
        this._done = Atomic<bool>(false)
    }

    call(body: fn()) {
        if (this._done.load(Ordering.Acquire)) { return }
        _spinAcquire(this._gate)
        defer { this._gate.store(false, Ordering.Release) }
        if (!this._done.load(Ordering.Acquire)) {
            body()
            this._done.store(true, Ordering.Release)
        }
    }
}

export fn cpuCount() -> i64 { return __cpuCount() }

export fn threadYield() { __threadYield() }

export fn pinToCpu(cpu: i64) -> bool {
    if (cpu < 0) { return false }
    return __pinToCpu(cpu)
}

export enum Signal {
    TERM,
    KILL,
    INT
}

fn _signalCode(signal: Signal) -> i64 {
    return match (signal) {
        Signal.TERM -> 15
        Signal.KILL -> 9
        Signal.INT -> 2
    }
}

// KILL cannot be caught: the kernel terminates the process without delivering
// it to a handler. Refusing it here says so at the boundary, rather than
// leaving the request to fail further down for a reason the caller cannot see.
// It stays in the enum because sending it is both legal and common.
export fn onSignal(signal: Signal, handler: fn()) -> bool {
    if (signal == Signal.KILL) { return false }
    return __onSignal(_signalCode(signal), handler)
}

export class Pipe {
    _readHandle: i64
    _writeHandle: i64
    _readOpen: bool
    _writeOpen: bool

    constructor(readHandle: i64, writeHandle: i64) {
        this._readHandle = readHandle
        this._writeHandle = writeHandle
        this._readOpen = readHandle >= 0
        this._writeOpen = writeHandle >= 0
    }

    readEnd() -> i64 { return this._readHandle }

    writeEnd() -> i64 { return this._writeHandle }

    read(maxBytes: i64 = 8192) -> Array<u8>? {
        if (!this._readOpen || maxBytes < 0) { return null }
        return __pipeRead(this._readHandle, maxBytes)
    }

    write(data: Array<u8>) -> i64 {
        if (!this._writeOpen) { return -1 }
        return __pipeWrite(this._writeHandle, data)
    }

    ref closeRead() -> bool {
        if (!this._readOpen) { return true }
        var ok = __pipeClose(this._readHandle)
        this._readOpen = false
        return ok
    }

    ref closeWrite() -> bool {
        if (!this._writeOpen) { return true }
        var ok = __pipeClose(this._writeHandle)
        this._writeOpen = false
        return ok
    }

    ref close() -> bool {
        var r = this.closeRead()
        var w = this.closeWrite()
        return r && w
    }

    static open() -> Pipe? {
        var ends = __pipeOpen()
        if (ends == null || len(ends!) < 2) { return null }
        return Pipe(ends![0], ends![1])
    }
}

export class ProcessOptions {
    cwd: string?
    env: Map<string, string>?
    stdin: i64?
    stdout: i64?
    stderr: i64?
    detached: bool

    constructor(cwd: string? = null, env: Map<string, string>? = null, stdin: i64? = null,
                stdout: i64? = null, stderr: i64? = null, detached: bool = false) {
        this.cwd = cwd
        this.env = env
        this.stdin = stdin
        this.stdout = stdout
        this.stderr = stderr
        this.detached = detached
    }
}

export class Process {
    _id: i64
    _open: bool

    constructor(id: i64, detached: bool = false) {
        this._id = id
        this._open = id > 0 && !detached
    }

    id: i64 { fn() { return this._id } }

    ref wait() -> i64 {
        if (!this._open) { return -1 }
        while (true) {
            var code = this.tryWait()
            if (code != null) { return code! }
            time.sleep(1)
        }
        return -1
    }

    ref tryWait() -> i64? {
        if (!this._open) { return -1 }
        var code = __processTryWait(this._id)
        if (code != null) {
            this._open = false
        }
        return code
    }

    kill(signal: Signal = Signal.TERM) -> bool {
        if (!this._open) { return false }
        return __processKill(this._id, _signalCode(signal))
    }

    static spawn(program: string, args: Array<string> = Array<string>(0), options: ProcessOptions? = null) -> Process? {
        var cwd: string? = null
        var envKeys: Array<string>? = null
        var envValues: Array<string>? = null
        var stdinRead: i64? = null
        var stdoutWrite: i64? = null
        var stderrWrite: i64? = null
        var detached = false
        if (options != null) {
            cwd = options!.cwd
            if (options!.env != null) {
                envKeys = options!.env!.keys()
                envValues = options!.env!.values()
            }
            if (options!.stdin != null) {
                stdinRead = options!.stdin
            }
            if (options!.stdout != null) {
                stdoutWrite = options!.stdout
            }
            if (options!.stderr != null) {
                stderrWrite = options!.stderr
            }
            detached = options!.detached
        }
        var id = __processSpawn(program, args, cwd, envKeys, envValues,
            stdinRead, stdoutWrite, stderrWrite, detached)
        if (id <= 0) { return null }
        return Process(id, detached)
    }
}

enum _ThreadLocalError {
    RecursiveInit
}

fn _threadLocalPruneDeadSlots<T>(values: ref Map<i64, T>) {
    var keys = values.keys()
    for (key in keys) {
        if (!__threadLocalAlive(key)) {
            values.delete(key)
        }
    }
}

fn _threadLocalPruneDeadFlags(values: ref Map<i64, bool>) {
    var keys = values.keys()
    for (key in keys) {
        if (!__threadLocalAlive(key)) {
            values.delete(key)
        }
    }
}

export class ThreadLocal<T> {
    _lock: OsMutex
    _values: Map<i64, T>
    _initializing: Map<i64, bool>
    _init: fn() -> T

    constructor(init: fn() -> T) {
        this._lock = OsMutex()
        this._values = #{}
        this._initializing = #{}
        this._init = init
    }

    ref get() -> T {
        var key = __threadLocalId()
        {
            this._lock.lock()
            defer { this._lock.unlock() }
            _threadLocalPruneDeadSlots(ref this._values)
            if (this._values.containsKey(key)) {
                return this._values[key]
            }
            _threadLocalPruneDeadFlags(ref this._initializing)
            if (this._initializing.containsKey(key)) {
                throw _ThreadLocalError.RecursiveInit
            }
            this._initializing.set(key, true)
        }

        try {
            var init = this._init
            var value = init()
            var result = value
            {
                this._lock.lock()
                defer { this._lock.unlock() }
                _threadLocalPruneDeadSlots(ref this._values)
                _threadLocalPruneDeadFlags(ref this._initializing)
                this._initializing.delete(key)
                if (!this._values.containsKey(key)) {
                    this._values.set(key, value)
                }
                result = this._values[key]
            }
            return result
        } catch (e) {
            {
                this._lock.lock()
                defer { this._lock.unlock() }
                this._initializing.delete(key)
            }
            throw e
        }
    }

    ref set(value: T) {
        var key = __threadLocalId()
        this._lock.lock()
        defer { this._lock.unlock() }
        _threadLocalPruneDeadSlots(ref this._values)
        if (this._values.containsKey(key)) {
            this._values[key] = value
        } else {
            this._values.set(key, value)
        }
        this._initializing.delete(key)
    }
}

export class Dylib {
    _handle: i64
    _open: bool

    constructor(handle: i64) {
        this._handle = handle
        this._open = handle != 0
    }

    symbol(name: string) -> Ptr<u8>? {
        if (!this._open) { return null }
        return __dylibSymbol(this._handle, name)
    }

    ref close() -> bool {
        if (!this._open) { return true }
        var ok = __dylibClose(this._handle)
        this._handle = 0
        this._open = false
        return ok
    }

    static open(path: Path) -> Dylib? {
        var handle = __dylibOpen(path)
        if (handle == 0) { return null }
        return Dylib(handle)
    }

    static lastError() -> string {
        return __dylibLastError()
    }
}
