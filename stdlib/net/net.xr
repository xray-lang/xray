// net — network semantics over private socket/TLS/netpoll primitives.
//
// The native layer exposes only single-shot yieldable primitives plus the
// NetConn/NetListener handles. Everything with a policy dimension is decided
// here: address resolution and multi-address dial fallback (RFC 8305 order),
// timeout defaults and deadline composition, error classification into
// NetError, stream copy pumps, and datagram shaping. Connection setup
// failures throw typed NetError values; per-operation I/O keeps in-band
// results (byte counts, null on timeout) with lastError for the reason,
// so poll-style loops stay exception-free.

import time

// Portable error codes stored by the native layer (net.__lastCode). The
// numbering mirrors XrNetErrorKind and is a frozen contract with the
// primitives; classification to NetError happens only here.
const _CODE_TIMEOUT: i64 = 1
const _CODE_CLOSED: i64 = 2
const _CODE_RESET: i64 = 3
const _CODE_REFUSED: i64 = 4
const _CODE_DNS: i64 = 5
const _CODE_TLS: i64 = 6
const _CODE_IO: i64 = 7
const _CODE_INVALID: i64 = 8
const _CODE_CANCELLED: i64 = 9

const _DEFAULT_TIMEOUT_MS: i64 = 30000
const _DEFAULT_BACKLOG: i64 = 1024
const _DEFAULT_COPY_BUFFER: i64 = 65536
const _MIN_COPY_BUFFER: i64 = 1024
const _MAX_COPY_BUFFER: i64 = 1048576
const _DIRECTION_READ: i64 = 0
const _DIRECTION_WRITE: i64 = 1
const _DIRECTION_BOTH: i64 = 2

export enum NetError {
    Timeout,
    Closed,
    Reset,
    Refused,
    Dns,
    Tls,
    Io,
    Invalid,
    Cancelled,
    OutOfMemory
}

fn _classify(code: i64) -> NetError {
    if (code == _CODE_TIMEOUT) { return NetError.Timeout }
    if (code == _CODE_CLOSED) { return NetError.Closed }
    if (code == _CODE_RESET) { return NetError.Reset }
    if (code == _CODE_REFUSED) { return NetError.Refused }
    if (code == _CODE_DNS) { return NetError.Dns }
    if (code == _CODE_TLS) { return NetError.Tls }
    if (code == _CODE_INVALID) { return NetError.Invalid }
    if (code == _CODE_CANCELLED) { return NetError.Cancelled }
    return NetError.Io
}

export final class IpAddress {
    value: string

    constructor(value: string) { this.value = value }

    toString() -> string { return this.value }
}

export final class Endpoint {
    host: string
    port: i64

    constructor(host: string, port: i64) {
        this.host = host
        this.port = port
    }
}

export final class DialOptions {
    timeoutMs: i64
    tls: bool

    constructor(timeoutMs: i64 = _DEFAULT_TIMEOUT_MS, tls: bool = false) {
        this.timeoutMs = timeoutMs
        this.tls = tls
    }
}

export struct CopyBidirectionalResult {
    aToB: i64
    bToA: i64
}

// Sender identity attached to a received datagram.
export final class UdpFrom {
    n: i64
    host: string
    port: i64

    constructor(n: i64, host: string, port: i64) {
        this.n = n
        this.host = host
        this.port = port
    }
}

// ========== Resolution ==========

export fn lookup(hostname: string) -> Array<IpAddress> {
    var raw = __resolveAll(hostname)
    var out: Array<IpAddress> = []
    for (var i = 0; i < len(raw); i++) { out.push(IpAddress(raw[i])) }
    return out
}

export fn resolve(hostname: string) -> IpAddress? {
    var raw = __resolveAll(hostname)
    if (len(raw) == 0) { return null }
    return IpAddress(raw[0])
}

// ========== Dial ==========

// Try each resolved address in RFC 8305 interleaved order under one overall
// deadline. The last per-address failure code decides the thrown error so a
// refused loopback dial surfaces Refused, not a generic Io.
fn _dialTcp(host: string, port: i64, deadline: i64) -> NetConn {
    var addrs = __resolveAll(host)
    if (len(addrs) == 0) { throw NetError.Dns }
    var lastCode = _CODE_IO
    for (var i = 0; i < len(addrs); i++) {
        var remaining = deadline - time.monotonic()
        if (remaining <= 0) { throw NetError.Timeout }
        var conn = __connectFd(addrs[i], port, deadline)
        if (conn != null) { return conn! }
        lastCode = __lastConnectCode()
        if (lastCode == _CODE_TIMEOUT || lastCode == _CODE_CANCELLED) { throw _classify(lastCode) }
    }
    throw _classify(lastCode)
}

// The TLS arm hands the fresh TCP conn straight into the handshake
// primitive, which returns the same handle on success and closes it on
// failure.
fn _dialTls(host: string, port: i64, deadline: i64) -> NetConn {
    var conn = _dialTcp(host, port, deadline)
    var code = __tlsHandshake(conn, host, deadline)
    if (code != 0) { throw _classify(code) }
    return conn
}

// The options default is a null sentinel rather than `DialOptions()` because
// default-argument expressions expand in the caller's scope, where the class
// name need not be imported.
export fn dial(host: string, port: i64, options: DialOptions? = null) -> NetConn {
    var opts = options ?? DialOptions()
    if (port < 0 || port > 65535 || opts.timeoutMs <= 0) { throw NetError.Invalid }
    if (opts.tls && !__hasTLS()) { throw NetError.Tls }
    var deadline = time.monotonic() + opts.timeoutMs
    if (opts.tls) { return _dialTls(host, port, deadline) }
    return _dialTcp(host, port, deadline)
}

export fn dialEndpoint(endpoint: Endpoint, options: DialOptions? = null) -> NetConn {
    return dial(endpoint.host, endpoint.port, options)
}

// Upgrade an established TCP connection to TLS in place (STARTTLS-style
// flows). Throws on failure; the native handshake closes the connection on
// any failure path, so the caller's handle is left closed.
export fn upgradeTLS(conn: NetConn, hostname: string, timeoutMs: i64 = _DEFAULT_TIMEOUT_MS) {
    if (timeoutMs <= 0) { throw NetError.Invalid }
    if (!__hasTLS()) { throw NetError.Tls }
    var code = __tlsHandshake(conn, hostname, time.monotonic() + timeoutMs)
    if (code != 0) { throw _classify(code) }
}

export fn hasTLS() -> bool { return __hasTLS() }

fn _containsZeroByte(value: string) -> bool {
    var bytes: const Slice<u8> = value.bytes()
    for (var i = 0; i < len(bytes); i++) {
        if (bytes[i] == 0) { return true }
    }
    return false
}

// Public context identities and policy live in Xray. Their only native field
// is an opaque, non-copyable OpenSSL storage object whose destroy hook runs
// after the final Xray reference dies.
export final class TlsClientContext {
    private _storage: __TlsContextStorage

    private constructor(storage: __TlsContextStorage) { this._storage = storage }

    static create(caFile: string = "", certFile: string = "", keyFile: string = "",
                  verifyPeer: bool = true) -> TlsClientContext {
        if (!__hasTLS()) { throw NetError.Tls }
        if (_containsZeroByte(caFile) || _containsZeroByte(certFile) ||
            _containsZeroByte(keyFile) || (len(certFile) == 0) != (len(keyFile) == 0)) {
            throw NetError.Invalid
        }
        var storage = __newTlsClientContext(caFile, certFile, keyFile, verifyPeer)
        if (storage == null) { throw NetError.Tls }
        return TlsClientContext(storage!)
    }

    upgrade(conn: NetConn, hostname: string, timeoutMs: i64 = _DEFAULT_TIMEOUT_MS) {
        if (timeoutMs <= 0 || _containsZeroByte(hostname)) { throw NetError.Invalid }
        var code = __tlsClientHandshakeWithContext(
            this._storage, conn, hostname, time.monotonic() + timeoutMs)
        if (code != 0) { throw _classify(code) }
    }
}

export final class TlsServerContext {
    private _storage: __TlsContextStorage

    private constructor(storage: __TlsContextStorage) { this._storage = storage }

    static create(certFile: string, keyFile: string, caFile: string = "",
                  requireClientCertificate: bool = false) -> TlsServerContext {
        if (!__hasTLS()) { throw NetError.Tls }
        if (len(certFile) == 0 || len(keyFile) == 0 || _containsZeroByte(certFile) ||
            _containsZeroByte(keyFile) || _containsZeroByte(caFile)) {
            throw NetError.Invalid
        }
        var storage = __newTlsServerContext(
            certFile, keyFile, caFile, requireClientCertificate)
        if (storage == null) { throw NetError.Tls }
        return TlsServerContext(storage!)
    }

    accept(conn: NetConn, timeoutMs: i64 = _DEFAULT_TIMEOUT_MS) {
        if (timeoutMs <= 0) { throw NetError.Invalid }
        var code = __tlsServerHandshakeWithContext(
            this._storage, conn, time.monotonic() + timeoutMs)
        if (code != 0) { throw _classify(code) }
    }
}



// ========== Listen / accept ==========

// Native bind failures have no handle to carry an errno, so every socket,
// bind, or listen failure surfaces as the coarse NetError.Io.
fn _listenChecked(port: i64, backlog: i64, forceV4: bool) -> NetListener {
    var listener = __listenFd(port, backlog, forceV4)
    if (listener == null) { throw NetError.Io }
    return listener!
}

export fn listen(port: i64, backlog: i64 = _DEFAULT_BACKLOG, forceV4: bool = false) -> NetListener {
    if (port < 0 || port > 65535 || backlog <= 0) { throw NetError.Invalid }
    return _listenChecked(port, backlog, forceV4)
}

// Null means the accept deadline elapsed or the listener was closed;
// lastError(listener) distinguishes the two so accept loops stay cheap.
export fn accept(listener: NetListener) -> NetConn? { return __accept(listener) }

// ========== Byte I/O ==========

export fn readInto(conn: NetConn, buffer: ref Array<u8>, maxlen: i64 = 1048576) -> i64 {
    return __readInto(conn, buffer, maxlen)
}

// Convenience allocation form of readInto. Null covers both EOF and error:
// lastError(conn) is null exactly when the stream ended cleanly.
export fn readBytes(conn: NetConn, maxBytes: i64 = 4096) -> Array<u8>? {
    if (maxBytes <= 0) { throw NetError.Invalid }
    var buffer = Array<u8>(maxBytes)
    var n = __readInto(conn, buffer, maxBytes)
    if (n <= 0) { return null }
    return buffer
}

// Drains the whole buffer under the write deadline. Returns the byte count,
// which is short of len(data) when an error interrupted the drain (reason via
// lastError), and -1 when nothing was sent at all.
export fn writeBytes(conn: NetConn, data: Array<u8>) -> i64 {
    return __writeBytes(conn, data)
}

export fn shutdownRead(conn: NetConn) -> bool {
    return __shutdownDirection(conn, _DIRECTION_READ)
}

export fn shutdownWrite(conn: NetConn) -> bool {
    return __shutdownDirection(conn, _DIRECTION_WRITE)
}

export fn shutdown(conn: NetConn) -> bool {
    return __shutdownDirection(conn, _DIRECTION_BOTH)
}

export fn close(handle: NetConn | NetListener) { __close(handle) }
export fn fd(handle: NetConn | NetListener) -> i64 { return __fd(handle) }
export fn isClosed(handle: NetConn | NetListener) -> bool { return __fd(handle) < 0 }
export fn isTLS(conn: NetConn) -> bool { return __connIsTLS(conn) }
export fn port(listener: NetListener) -> i64 { return __listenerPort(listener) }

export fn setReadDeadline(conn: NetConn, deadline: i64) -> bool {
    return __setDeadlineDirection(conn, deadline, _DIRECTION_READ)
}

export fn setWriteDeadline(conn: NetConn, deadline: i64) -> bool {
    return __setDeadlineDirection(conn, deadline, _DIRECTION_WRITE)
}

export fn setDeadline(conn: NetConn, deadline: i64) -> bool {
    return __setDeadlineDirection(conn, deadline, _DIRECTION_BOTH)
}

export fn setAcceptDeadline(listener: NetListener, deadline: i64) -> bool {
    return __setAcceptDeadline(listener, deadline)
}

export fn lastError(handle: NetConn | NetListener) -> NetError? {
    var code = __lastCode(handle)
    if (code == 0) { return null }
    return _classify(code)
}

export fn lastErrno(handle: NetConn | NetListener) -> i64 { return __lastErrno(handle) }

// ========== Stream copy ==========

fn _clampCopyBuffer(size: i64) -> i64 {
    if (size < _MIN_COPY_BUFFER) { return _MIN_COPY_BUFFER }
    if (size > _MAX_COPY_BUFFER) { return _MAX_COPY_BUFFER }
    return size
}

// Pump src to dst until EOF or error; returns bytes copied. readInto sets
// buffer.length to the chunk size, so writeBytes sends exactly the received
// bytes without any per-iteration slicing or copying.
fn _pump(src: NetConn, dst: NetConn, bufferSize: i64, halfCloseOnEof: bool) -> i64 {
    var buffer = Array<u8>(bufferSize)
    var total = 0
    while (true) {
        var n = __readInto(src, buffer, bufferSize)
        if (n < 0) { return total }
        if (n == 0) {
            if (halfCloseOnEof) { shutdownWrite(dst) }
            return total
        }
        var sent = __writeBytes(dst, buffer)
        if (sent < n) { return total + (sent > 0 ? sent : 0) }
        total = total + n
    }
    return total
}

// Copy src to dst until EOF. Returns bytes copied; a mid-stream error stops
// the pump and the reason stays queryable via lastError on either handle.
export fn copy(src: NetConn, dst: NetConn, bufferSize: i64 = _DEFAULT_COPY_BUFFER) -> i64 {
    return _pump(src, dst, _clampCopyBuffer(bufferSize), false)
}

fn _pumpAndHalfClose(src: NetConn, dst: NetConn) -> i64 {
    return _pump(src, dst, _DEFAULT_COPY_BUFFER, true)
}

// Full-duplex relay is source-owned structured concurrency: each direction
// runs the ordinary source pump, and EOF half-closes the peer write side so
// request/response protocols can drain without closing either handle.
export fn copyBidirectional(a: NetConn, b: NetConn) -> CopyBidirectionalResult {
    if (isClosed(a) || isClosed(b)) { throw NetError.Closed }
    if (fd(a) == fd(b)) { throw NetError.Invalid }
    const left = a
    const right = b
    var first = 0
    var second = 0
    scope {
        var aToB = go _pumpAndHalfClose(left, right)
        var bToA = go _pumpAndHalfClose(right, left)
        first = await aToB
        second = await bToA
    }
    return CopyBidirectionalResult{aToB: first, bToA: second}
}

// ========== UDP ==========

export fn udpBind(port: i64, address: string = "") -> NetConn {
    if (port < 0 || port > 65535) { throw NetError.Invalid }
    var conn = __udpBind(port, address)
    if (conn == null) { throw NetError.Io }
    return conn!
}

fn _parseIpv4Octet(part: string) -> i64? {
    if (len(part) == 0 || len(part) > 3) { return null }
    const bytes: Slice<u8> = part.bytes()
    var value = 0
    for (var i = 0; i < len(bytes); i++) {
        var digit = bytes[i] as i64
        if (digit < 48 || digit > 57) { return null }
        value = value * 10 + digit - 48
    }
    if (value > 255) { return null }
    return value
}

fn _validIpv4MulticastGroup(group: string) -> bool {
    var parts = group.split(".")
    if (len(parts) != 4) { return false }
    var first = _parseIpv4Octet(parts[0])
    if (first == null || first! < 224 || first! > 239) { return false }
    for (var i = 1; i < 4; i++) {
        if (_parseIpv4Octet(parts[i]) == null) { return false }
    }
    return true
}

// Open one IPv4 multicast datagram socket. Group syntax and option ranges are
// source-owned; the leaf below only performs the portable socket operations.
export fn udpMulticastBind(group: string, port: i64, ttl: i64 = 1,
                           loopback: bool = false) -> NetConn {
    if (!_validIpv4MulticastGroup(group) || port <= 0 || port > 65535 || ttl < 0 || ttl > 255) {
        throw NetError.Invalid
    }
    var conn = __udpMulticastBind(group, port, ttl, loopback)
    if (conn == null) { throw NetError.Io }
    return conn!
}

fn _deadlineFromTimeout(timeoutMs: i64) -> i64 {
    if (timeoutMs < 0) { return 0 }
    return time.monotonic() + timeoutMs
}

// Resolve once, send one datagram. Argument and resolution failures throw;
// socket-layer failures return -1 with the reason on lastError(handle).
export fn sendTo(handle: NetConn, data: Array<u8>, host: string, port: i64,
                 timeoutMs: i64 = _DEFAULT_TIMEOUT_MS) -> i64 {
    if (port < 0 || port > 65535) { throw NetError.Invalid }
    var addrs = __resolveAll(host)
    if (len(addrs) == 0) { throw NetError.Dns }
    return __udpSendTo(handle, data, addrs[0], port, _deadlineFromTimeout(timeoutMs))
}

// Receive one datagram into the caller buffer. A negative timeout waits
// without limit; null means timeout, cancellation, or error — see lastError.
// The sender identity is read back from the handle, so recvFrom assumes one
// reader per UDP socket.
export fn recvFrom(handle: NetConn, buffer: ref Array<u8>, timeoutMs: i64 = -1) -> UdpFrom? {
    var n = __udpRecvInto(handle, buffer, _deadlineFromTimeout(timeoutMs))
    if (n < 0) { return null }
    return UdpFrom(n, __udpFromHost(handle), __udpFromPort(handle))
}
