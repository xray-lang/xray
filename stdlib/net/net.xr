// net — network semantics over private socket/TLS/netpoll primitives.
//
// The native layer exposes only single-shot yieldable primitives plus the
// NetConn/NetListener handles. Everything with a policy dimension is decided
// here: address resolution and multi-address dial fallback (RFC 8305 order),
// timeout defaults and deadline composition, error classification into
// NetError, stream copy pumps, and datagram shaping. Connection setup
// failures throw typed NetError values; per-operation I/O keeps in-band
// results (byte counts, null on timeout) with lastError for the reason,
// so poll-style loops stay exception-free.

// Portable error codes stored by the native layer (net.__lastCode). The
// numbering mirrors XrNetErrorKind and is a frozen contract with the
// primitives; classification to NetError happens only here.
const _CODE_TIMEOUT: int = 1
const _CODE_CLOSED: int = 2
const _CODE_RESET: int = 3
const _CODE_REFUSED: int = 4
const _CODE_DNS: int = 5
const _CODE_TLS: int = 6
const _CODE_IO: int = 7
const _CODE_INVALID: int = 8
const _CODE_CANCELLED: int = 9

const _DEFAULT_TIMEOUT_MS: int = 30000
const _DEFAULT_BACKLOG: int = 1024
const _DEFAULT_COPY_BUFFER: int = 65536
const _MIN_COPY_BUFFER: int = 1024
const _MAX_COPY_BUFFER: int = 1048576

fn _classify(code: int) -> NetError {
    if (code == _CODE_TIMEOUT) { return NetError.Timeout }
    if (code == _CODE_CLOSED) { return NetError.Closed }
    if (code == _CODE_RESET) { return NetError.Reset }
    if (code == _CODE_REFUSED) { return NetError.Refused }
    if (code == _CODE_DNS) { return NetError.Dns }
    if (code == _CODE_TLS) { return NetError.Tls }
    if (code == _CODE_INVALID) { return NetError.Invalid }
    if (code == _CODE_CANCELLED) { return NetError.Cancelled }
    return NetError.Io
}

export final class IpAddress {
    value: string

    constructor(value: string) { this.value = value }

    toString() -> string { return this.value }
}

export final class Endpoint {
    host: string
    port: int

    constructor(host: string, port: int) {
        this.host = host
        this.port = port
    }
}

export final class DialOptions {
    timeoutMs: int
    tls: bool

    constructor(timeoutMs: int = _DEFAULT_TIMEOUT_MS, tls: bool = false) {
        this.timeoutMs = timeoutMs
        this.tls = tls
    }
}

export final class CopyBidirectionalResult {
    aToB: int
    bToA: int

    constructor(aToB: int, bToA: int) {
        this.aToB = aToB
        this.bToA = bToA
    }
}

// Sender identity attached to a received datagram.
export final class UdpFrom {
    n: int
    host: string
    port: int

    constructor(n: int, host: string, port: int) {
        this.n = n
        this.host = host
        this.port = port
    }
}

// ========== Resolution ==========

export fn lookup(hostname: string) -> Array<IpAddress> {
    var raw = __resolveAll(hostname)
    var out: Array<IpAddress> = []
    for (var i = 0; i < len(raw); i++) { out.push(IpAddress(raw[i])) }
    return out
}

export fn resolve(hostname: string) -> IpAddress? {
    var raw = __resolveAll(hostname)
    if (len(raw) == 0) { return null }
    return IpAddress(raw[0])
}

// ========== Dial ==========

// Try each resolved address in RFC 8305 interleaved order under one overall
// deadline. The last per-address failure code decides the thrown error so a
// refused loopback dial surfaces Refused, not a generic Io.
fn _dialTcp(host: string, port: int, deadline: int) -> NetConn {
    var addrs = __resolveAll(host)
    if (len(addrs) == 0) { throw NetError.Dns }
    var lastCode = _CODE_IO
    for (var i = 0; i < len(addrs); i++) {
        var remaining = deadline - __nowMs()
        if (remaining <= 0) { throw NetError.Timeout }
        var conn = __connectFd(addrs[i], port, remaining)
        if (conn != null) { return conn! }
        lastCode = __lastConnectCode()
        if (lastCode == _CODE_TIMEOUT || lastCode == _CODE_CANCELLED) { throw _classify(lastCode) }
    }
    throw _classify(lastCode)
}

// The TLS arm hands the fresh TCP conn straight into the handshake
// primitive, which returns the same handle on success and closes it on
// failure.
fn _dialTls(host: string, port: int, deadline: int) -> NetConn {
    var conn = _dialTcp(host, port, deadline)
    var code = __tlsHandshake(conn, host, deadline)
    if (code != 0) { throw _classify(code) }
    return conn
}

// The options default is a null sentinel rather than `DialOptions()` because
// default-argument expressions expand in the caller's scope, where the class
// name need not be imported.
export fn dial(host: string, port: int, options: DialOptions? = null) -> NetConn {
    var opts = options ?? DialOptions()
    if (port < 0 || port > 65535 || opts.timeoutMs <= 0) { throw NetError.Invalid }
    if (opts.tls && !__hasTLS()) { throw NetError.Tls }
    var deadline = __nowMs() + opts.timeoutMs
    if (opts.tls) { return _dialTls(host, port, deadline) }
    return _dialTcp(host, port, deadline)
}

export fn dialEndpoint(endpoint: Endpoint, options: DialOptions? = null) -> NetConn {
    return dial(endpoint.host, endpoint.port, options)
}

// Upgrade an established TCP connection to TLS in place (STARTTLS-style
// flows). Throws on failure; the native handshake closes the connection on
// any failure path, so the caller's handle is left closed.
export fn upgradeTLS(conn: NetConn, hostname: string, timeoutMs: int = _DEFAULT_TIMEOUT_MS) {
    if (timeoutMs <= 0) { throw NetError.Invalid }
    if (!__hasTLS()) { throw NetError.Tls }
    var code = __tlsHandshake(conn, hostname, __nowMs() + timeoutMs)
    if (code != 0) { throw _classify(code) }
}

export fn hasTLS() -> bool { return __hasTLS() }



// ========== Listen / accept ==========

// Native bind failures have no handle to carry an errno, so every socket,
// bind, or listen failure surfaces as the coarse NetError.Io.
fn _listenChecked(port: int, backlog: int, forceV4: bool) -> NetListener {
    var listener = __listenFd(port, backlog, forceV4)
    if (listener == null) { throw NetError.Io }
    return listener!
}

export fn listen(port: int, backlog: int = _DEFAULT_BACKLOG, forceV4: bool = false) -> NetListener {
    if (port < 0 || port > 65535 || backlog <= 0) { throw NetError.Invalid }
    return _listenChecked(port, backlog, forceV4)
}

// Null means the accept deadline elapsed or the listener was closed;
// lastError(listener) distinguishes the two so accept loops stay cheap.
export fn accept(listener: NetListener) -> NetConn? { return __accept(listener) }

// ========== Byte I/O ==========

export fn readInto(conn: NetConn, buffer: ref Array<byte>, maxlen: int = 1048576) -> int {
    return __readInto(conn, buffer, maxlen)
}

// Convenience allocation form of readInto. Null covers both EOF and error:
// lastError(conn) is null exactly when the stream ended cleanly.
export fn readBytes(conn: NetConn, maxBytes: int = 4096) -> Array<byte>? {
    if (maxBytes <= 0) { throw NetError.Invalid }
    var buffer = Array<byte>(maxBytes)
    var n = __readInto(conn, buffer, maxBytes)
    if (n <= 0) { return null }
    return buffer
}

// Drains the whole buffer under the write deadline. Returns the byte count,
// which is short of len(data) when an error interrupted the drain (reason via
// lastError), and -1 when nothing was sent at all.
export fn writeBytes(conn: NetConn, data: Array<byte>) -> int {
    return __writeBytes(conn, data)
}

export fn shutdownRead(conn: NetConn) -> bool { return __shutdownRead(conn) }
export fn shutdownWrite(conn: NetConn) -> bool { return __shutdownWrite(conn) }
export fn shutdown(conn: NetConn) -> bool { return __shutdown(conn) }
export fn close(handle: NetConn | NetListener) { __close(handle) }
export fn fd(handle: NetConn | NetListener) -> int { return __fd(handle) }

export fn setReadDeadline(conn: NetConn, deadline: int) -> bool {
    return __setReadDeadline(conn, deadline)
}

export fn setWriteDeadline(conn: NetConn, deadline: int) -> bool {
    return __setWriteDeadline(conn, deadline)
}

export fn setDeadline(conn: NetConn, deadline: int) -> bool {
    return __setDeadline(conn, deadline)
}

export fn setAcceptDeadline(listener: NetListener, deadline: int) -> bool {
    return __setAcceptDeadline(listener, deadline)
}

export fn lastError(handle: NetConn | NetListener) -> NetError? {
    var code = __lastCode(handle)
    if (code == 0) { return null }
    return _classify(code)
}

export fn lastErrno(handle: NetConn | NetListener) -> int { return __lastErrno(handle) }

// ========== Stream copy ==========

fn _clampCopyBuffer(size: int) -> int {
    if (size < _MIN_COPY_BUFFER) { return _MIN_COPY_BUFFER }
    if (size > _MAX_COPY_BUFFER) { return _MAX_COPY_BUFFER }
    return size
}

// Pump src to dst until EOF or error; returns bytes copied. readInto sets
// buffer.length to the chunk size, so writeBytes sends exactly the received
// bytes without any per-iteration slicing or copying.
fn _pump(src: NetConn, dst: NetConn, bufferSize: int) -> int {
    var buffer = Array<byte>(bufferSize)
    var total = 0
    while (true) {
        var n = __readInto(src, buffer, bufferSize)
        if (n < 0) { return total }
        if (n == 0) { return total }
        var sent = __writeBytes(dst, buffer)
        if (sent < n) { return total + (sent > 0 ? sent : 0) }
        total = total + n
    }
    return total
}

// Copy src to dst until EOF. Returns bytes copied; a mid-stream error stops
// the pump and the reason stays queryable via lastError on either handle.
export fn copy(src: NetConn, dst: NetConn, bufferSize: int = _DEFAULT_COPY_BUFFER) -> int {
    return _pump(src, dst, _clampCopyBuffer(bufferSize))
}

// Full-duplex relay. The two direction pumps run as native coroutines: the
// analyzer accepts spawning them from Xray, but the AOT cross-execution
// transfer planner has no verified plan yet for handing the same two handles
// to two child tasks, so the pair-pump stays a native primitive until that
// plan lands.
export fn copyBidirectional(a: NetConn, b: NetConn) -> CopyBidirectionalResult {
    var raw = __copyBidirectional(a, b)
    return CopyBidirectionalResult(raw.aToB, raw.bToA)
}

// ========== UDP ==========

export fn udpBind(port: int, address: string = "") -> NetConn {
    if (port < 0 || port > 65535) { throw NetError.Invalid }
    var conn = __udpBind(port, address)
    if (conn == null) { throw NetError.Io }
    return conn!
}

// Resolve once, send one datagram. Argument and resolution failures throw;
// socket-layer failures return -1 with the reason on lastError(handle).
export fn sendTo(handle: NetConn, data: Array<byte>, host: string, port: int,
                 timeoutMs: int = _DEFAULT_TIMEOUT_MS) -> int {
    if (port < 0 || port > 65535) { throw NetError.Invalid }
    var addrs = __resolveAll(host)
    if (len(addrs) == 0) { throw NetError.Dns }
    return __udpSendTo(handle, data, addrs[0], port, timeoutMs)
}

// Receive one datagram into the caller buffer. A negative timeout waits
// without limit; null means timeout, cancellation, or error — see lastError.
// The sender identity is read back from the handle, so recvFrom assumes one
// reader per UDP socket.
export fn recvFrom(handle: NetConn, buffer: ref Array<byte>, timeoutMs: int = -1) -> UdpFrom? {
    var n = __udpRecvInto(handle, buffer, timeoutMs)
    if (n < 0) { return null }
    return UdpFrom(n, __udpFromHost(handle), __udpFromPort(handle))
}
