// base64 - RFC 4648 Base64 encoding/decoding, pure Xray.
//
// Public binary input is always Slice<byte>. Decoding returns owned bytes and
// reports recoverable user-input failures through Base64Error instead of null.

export enum Base64Alphabet {
    Standard,
    UrlSafe
}

export enum Base64PaddingPolicy {
    Required,
    Optional,
    Forbidden
}

export enum Base64Error {
    InvalidLength(length: int),
    InvalidByte(byteOffset: int, value: byte),
    InvalidPadding(byteOffset: int),
    NonCanonicalTrailingBits(byteOffset: int)
}

export class Base64EncodeOptions {
    alphabet: Base64Alphabet
    padding: bool

    constructor() {
        this.alphabet = Base64Alphabet.Standard
        this.padding = true
    }
}

export class Base64DecodeOptions {
    alphabet: Base64Alphabet
    padding: Base64PaddingPolicy

    constructor() {
        this.alphabet = Base64Alphabet.Standard
        this.padding = Base64PaddingPolicy.Required
    }
}

fn _encodeRune(index: int, alphabet: Base64Alphabet) -> rune {
    if (index < 26) { return rune(65 + index)! }
    if (index < 52) { return rune(97 + index - 26)! }
    if (index < 62) { return rune(48 + index - 52)! }
    if (index == 62) {
        return alphabet == Base64Alphabet.UrlSafe ? '-' : '+'
    }
    return alphabet == Base64Alphabet.UrlSafe ? '_' : '/'
}

fn _decodeChar(c: int, alphabet: Base64Alphabet) -> int {
    if (c >= 65 && c <= 90) { return c - 65 }    // A-Z -> 0..25
    if (c >= 97 && c <= 122) { return c - 71 }   // a-z -> 26..51
    if (c >= 48 && c <= 57) { return c + 4 }     // 0-9 -> 52..61
    if (alphabet == Base64Alphabet.Standard) {
        if (c == 43) { return 62 }               // '+'
        if (c == 47) { return 63 }               // '/'
    } else {
        if (c == 45) { return 62 }               // '-'
        if (c == 95) { return 63 }               // '_'
    }
    return -1
}

// Shared non-throwing scanner result:
//   kind: 0 valid, 1 length, 2 byte, 3 padding, 4 trailing bits
//   arg: error length/offset; byteValue: InvalidByte payload
//   end/rem/outLen: validated decode plan
fn _scan(text: string, options: Base64DecodeOptions) -> (int, int, byte, int, int, int) {
    var src: Slice<byte> = text.bytes()
    var end = len(src)
    while (end > 0 && src[end - 1] == 61) { end = end - 1 }

    var zero: byte = 0
    var paddingCount = len(src) - end
    var rem = end % 4
    if (paddingCount > 2) {
        return (3, end, zero, 0, 0, 0)
    }
    for (var i = 0; i < end; i++) {
        if (src[i] == 61) {
            return (3, i, zero, 0, 0, 0)
        }
    }
    if (rem == 1) {
        return (1, end, zero, 0, 0, 0)
    }
    if (options.padding == Base64PaddingPolicy.Forbidden && paddingCount > 0) {
        return (3, end, zero, 0, 0, 0)
    }
    if (rem == 0) {
        if (paddingCount > 0) {
            return (3, end, zero, 0, 0, 0)
        }
    } else {
        var requiredPadding = 2
        if (rem == 3) { requiredPadding = 1 }
        if (options.padding == Base64PaddingPolicy.Required && paddingCount != requiredPadding) {
            return (3, end, zero, 0, 0, 0)
        }
        if (options.padding == Base64PaddingPolicy.Optional &&
            paddingCount != 0 && paddingCount != requiredPadding) {
            return (3, end, zero, 0, 0, 0)
        }
    }

    for (var i = 0; i < end; i++) {
        if (_decodeChar(src[i] as int, options.alphabet) < 0) {
            return (2, i, src[i], 0, 0, 0)
        }
    }
    if (rem == 2 && (_decodeChar(src[end - 1] as int, options.alphabet) & 15) != 0) {
        return (4, end - 1, zero, 0, 0, 0)
    }
    if (rem == 3 && (_decodeChar(src[end - 1] as int, options.alphabet) & 3) != 0) {
        return (4, end - 1, zero, 0, 0, 0)
    }

    var outLen = (end / 4) * 3
    if (rem == 2) { outLen = outLen + 1 }
    else if (rem == 3) { outLen = outLen + 2 }
    return (0, 0, zero, end, rem, outLen)
}

fn _encodeAlpha(data: Slice<byte>, alphabet: Base64Alphabet, padding: bool) -> string {
    var n = len(data)
    var out = StringBuilder()
    var i = 0
    while (i + 3 <= n) {
        var b0 = data[i] as int
        var b1 = data[i + 1] as int
        var b2 = data[i + 2] as int
        out.append(_encodeRune(b0 >> 2, alphabet))
        out.append(_encodeRune(((b0 & 3) << 4) | (b1 >> 4), alphabet))
        out.append(_encodeRune(((b1 & 15) << 2) | (b2 >> 6), alphabet))
        out.append(_encodeRune(b2 & 63, alphabet))
        i = i + 3
    }
    var rem = n - i
    if (rem == 1) {
        var b0 = data[i] as int
        out.append(_encodeRune(b0 >> 2, alphabet))
        out.append(_encodeRune((b0 & 3) << 4, alphabet))
        if (padding) { out.append("==") }
    } else if (rem == 2) {
        var b0 = data[i] as int
        var b1 = data[i + 1] as int
        out.append(_encodeRune(b0 >> 2, alphabet))
        out.append(_encodeRune(((b0 & 3) << 4) | (b1 >> 4), alphabet))
        out.append(_encodeRune((b1 & 15) << 2, alphabet))
        if (padding) { out.append("=") }
    }
    return out.toString()
}

fn _decodeValidated(src: Slice<byte>, end: int, rem: int, outLen: int,
                    options: Base64DecodeOptions) -> Array<byte> {
    var out = Array<byte>(outLen)
    var oi = 0
    var i = 0
    while (i + 4 <= end) {
        var c0 = _decodeChar(src[i] as int, options.alphabet)
        var c1 = _decodeChar(src[i + 1] as int, options.alphabet)
        var c2 = _decodeChar(src[i + 2] as int, options.alphabet)
        var c3 = _decodeChar(src[i + 3] as int, options.alphabet)
        out[oi] = (((c0 << 2) | (c1 >> 4)) & 255) as byte
        out[oi + 1] = ((((c1 & 15) << 4) | (c2 >> 2)) & 255) as byte
        out[oi + 2] = ((((c2 & 3) << 6) | c3) & 255) as byte
        oi = oi + 3
        i = i + 4
    }
    if (rem == 2) {
        var c0 = _decodeChar(src[i] as int, options.alphabet)
        var c1 = _decodeChar(src[i + 1] as int, options.alphabet)
        out[oi] = (((c0 << 2) | (c1 >> 4)) & 255) as byte
    } else if (rem == 3) {
        var c0 = _decodeChar(src[i] as int, options.alphabet)
        var c1 = _decodeChar(src[i + 1] as int, options.alphabet)
        var c2 = _decodeChar(src[i + 2] as int, options.alphabet)
        out[oi] = (((c0 << 2) | (c1 >> 4)) & 255) as byte
        out[oi + 1] = ((((c1 & 15) << 4) | (c2 >> 2)) & 255) as byte
    }
    return out
}

fn _decodeImpl(text: string, options: Base64DecodeOptions) -> Array<byte> {
    var scan = _scan(text, options)
    if (scan.0 == 1) { throw Base64Error.InvalidLength(scan.1) }
    if (scan.0 == 2) { throw Base64Error.InvalidByte(scan.1, scan.2) }
    if (scan.0 == 3) { throw Base64Error.InvalidPadding(scan.1) }
    if (scan.0 == 4) { throw Base64Error.NonCanonicalTrailingBits(scan.1) }

    var src: Slice<byte> = text.bytes()
    return _decodeValidated(src, scan.3, scan.4, scan.5, options)
}

export fn encode(data: Slice<byte>, options: Base64EncodeOptions? = null) -> string {
    var resolved = options == null ? Base64EncodeOptions() : options!
    return _encodeAlpha(data, resolved.alphabet, resolved.padding)
}

export fn decode(text: string, options: Base64DecodeOptions? = null) -> Array<byte> {
    var resolved = options == null ? Base64DecodeOptions() : options!
    return _decodeImpl(text, resolved)
}

export fn isValid(text: string, options: Base64DecodeOptions? = null) -> bool {
    var resolved = options == null ? Base64DecodeOptions() : options!
    return _scan(text, resolved).0 == 0
}
