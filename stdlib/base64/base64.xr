// base64 — RFC 4648 Base64 encoding/decoding, pure Xray.
//
// encode/decode work on the UTF-8 bytes of a string; encodeBytes/decodeToBytes
// work on raw Array<byte>. Decoding accepts both the standard (+/) and URL-safe (-_)
// alphabets and tolerates missing padding; structurally invalid input returns
// null. Byte-indexed scanning over Array<byte> keeps the hot path allocation-light.

const STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn utf8String(bytes: Array<byte>) -> string? {
    return string.fromUtf8(bytes[:])
}

// Encode raw bytes with the given 64-rune alphabet; append '=' padding when
// `padding` is true (standard) and omit it otherwise (URL-safe default).
fn encodeAlpha(data: Array<byte>, alpha: string, padding: bool) -> string {
    var n = len(data)
    var out = StringBuilder()
    var i = 0
    while (i + 3 <= n) {
        var b0 = data[i]
        var b1 = data[i + 1]
        var b2 = data[i + 2]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth(((b0 & 3) << 4) | (b1 >> 4)))
        out.append(alpha.runes().nth(((b1 & 15) << 2) | (b2 >> 6)))
        out.append(alpha.runes().nth(b2 & 63))
        i = i + 3
    }
    var rem = n - i
    if (rem == 1) {
        var b0 = data[i]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth((b0 & 3) << 4))
        if (padding) { out.append("==") }
    } else if (rem == 2) {
        var b0 = data[i]
        var b1 = data[i + 1]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth(((b0 & 3) << 4) | (b1 >> 4)))
        out.append(alpha.runes().nth((b1 & 15) << 2))
        if (padding) { out.append("=") }
    }
    return out.toString()
}

// Map a base64 character's byte value to its 6-bit value, or -1 if it is not a
// base64 character. Accepts both standard (+/) and URL-safe (-_) alphabets.
fn decodeChar(c: int) -> int {
    if (c >= 65 && c <= 90) { return c - 65 }    // A-Z -> 0..25
    if (c >= 97 && c <= 122) { return c - 71 }   // a-z -> 26..51
    if (c >= 48 && c <= 57) { return c + 4 }     // 0-9 -> 52..61
    if (c == 43 || c == 45) { return 62 }        // '+' or '-'
    if (c == 47 || c == 95) { return 63 }        // '/' or '_'
    return -1
}

// Decode a base64 string into raw bytes; returns null on any invalid input
// (bad characters, misplaced padding, or a length that cannot form whole bytes).
fn decodeBytes(s: string) -> Array<byte>? {
    var src = s.copyBytes()
    var end = len(src)
    // Strip trailing '=' (byte 61) padding.
    while (end > 0 && src[end - 1] == 61) { end = end - 1 }
    // At most two padding chars, and no '=' before the tail.
    if (len(src) - end > 2) { return null }
    for (var i = 0; i < end; i++) {
        if (src[i] == 61) { return null }
    }
    var rem = end % 4
    if (rem == 1) { return null }  // 6 bits cannot form a byte

    var full = end / 4
    var outLen = full * 3
    if (rem == 2) { outLen = outLen + 1 }
    else if (rem == 3) { outLen = outLen + 2 }

    var out = Array<byte>(outLen)
    var oi = 0
    var i = 0
    while (i + 4 <= end) {
        var c0 = decodeChar(src[i])
        var c1 = decodeChar(src[i + 1])
        var c2 = decodeChar(src[i + 2])
        var c3 = decodeChar(src[i + 3])
        if (c0 < 0 || c1 < 0 || c2 < 0 || c3 < 0) { return null }
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
        out[oi + 1] = (((c1 & 15) << 4) | (c2 >> 2)) & 255
        out[oi + 2] = (((c2 & 3) << 6) | c3) & 255
        oi = oi + 3
        i = i + 4
    }
    if (rem == 2) {
        var c0 = decodeChar(src[i])
        var c1 = decodeChar(src[i + 1])
        if (c0 < 0 || c1 < 0) { return null }
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
    } else if (rem == 3) {
        var c0 = decodeChar(src[i])
        var c1 = decodeChar(src[i + 1])
        var c2 = decodeChar(src[i + 2])
        if (c0 < 0 || c1 < 0 || c2 < 0) { return null }
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
        out[oi + 1] = (((c1 & 15) << 4) | (c2 >> 2)) & 255
    }
    return out
}

// encode — standard alphabet with padding, over the string's UTF-8 bytes.
fn encode(data: string) -> string {
    return encodeAlpha(data.copyBytes(), STD, true)
}

// decode — standard/URL-safe input to a UTF-8 string; null on invalid input.
fn decode(data: string) -> string? {
    var bytes = decodeBytes(data)
    if (bytes == null) { return null }
    return utf8String(bytes!)
}

// encodeUrl — URL-safe alphabet, no padding.
fn encodeUrl(data: string) -> string {
    return encodeAlpha(data.copyBytes(), URL, false)
}

// decodeUrl — the decoder already accepts both alphabets.
fn decodeUrl(data: string) -> string? {
    return decode(data)
}

// encodeBytes — standard alphabet with padding, over raw bytes.
fn encodeBytes(data: Array<byte>) -> string {
    return encodeAlpha(data, STD, true)
}

// decodeToBytes — decode to raw bytes; null on invalid input.
fn decodeToBytes(data: string) -> Array<byte>? {
    return decodeBytes(data)
}

// isValid — whether the input is structurally valid base64.
fn isValid(data: string) -> bool {
    var src = data.copyBytes()
    var end = len(src)
    while (end > 0 && src[end - 1] == 61) { end = end - 1 }
    if (len(src) - end > 2) { return false }
    for (var i = 0; i < end; i++) {
        if (src[i] == 61) { return false }
        if (decodeChar(src[i]) < 0) { return false }
    }
    if (end % 4 == 1) { return false }
    return true
}

export { encode, decode, encodeUrl, decodeUrl, encodeBytes, decodeToBytes, isValid }
