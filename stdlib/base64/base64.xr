// base64 - RFC 4648 Base64 encoding/decoding, pure Xray.
//
// Public binary input is always Slice<byte>. Decoding returns owned bytes and
// reports recoverable user-input failures through Base64Error instead of null.

const STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

enum Base64Alphabet {
    Standard,
    UrlSafe
}

enum Base64PaddingPolicy {
    Required,
    Optional,
    Forbidden
}

enum Base64Error {
    InvalidLength(length: int),
    InvalidByte(byteOffset: int, value: byte),
    InvalidPadding(byteOffset: int),
    NonCanonicalTrailingBits(byteOffset: int)
}

class Base64EncodeOptions {
    alphabet: Base64Alphabet
    padding: bool

    constructor() {
        this.alphabet = Base64Alphabet.Standard
        this.padding = true
    }
}

class Base64DecodeOptions {
    alphabet: Base64Alphabet
    padding: Base64PaddingPolicy

    constructor() {
        this.alphabet = Base64Alphabet.Standard
        this.padding = Base64PaddingPolicy.Required
    }
}

fn _alphabet(options: Base64Alphabet) -> string {
    if (options == Base64Alphabet.UrlSafe) { return URL }
    return STD
}

fn _encodeOptions(options: Base64EncodeOptions?) -> Base64EncodeOptions {
    if (options == null) { return Base64EncodeOptions() }
    return options!
}

fn _decodeOptions(options: Base64DecodeOptions?) -> Base64DecodeOptions {
    if (options == null) { return Base64DecodeOptions() }
    return options!
}

fn _decodeChar(c: int, alphabet: Base64Alphabet) -> int {
    if (c >= 65 && c <= 90) { return c - 65 }    // A-Z -> 0..25
    if (c >= 97 && c <= 122) { return c - 71 }   // a-z -> 26..51
    if (c >= 48 && c <= 57) { return c + 4 }     // 0-9 -> 52..61
    if (alphabet == Base64Alphabet.Standard) {
        if (c == 43) { return 62 }               // '+'
        if (c == 47) { return 63 }               // '/'
    } else {
        if (c == 45) { return 62 }               // '-'
        if (c == 95) { return 63 }               // '_'
    }
    return -1
}

fn _decodeRequired(src: Slice<byte>, offset: int, options: Base64DecodeOptions) -> int {
    var value = _decodeChar(src[offset], options.alphabet)
    if (value < 0) {
        throw Base64Error.InvalidByte(offset, src[offset])
    }
    return value
}

fn _checkPadding(src: Slice<byte>, end: int, paddingCount: int, rem: int,
                 options: Base64DecodeOptions) {
    if (paddingCount > 2) {
        throw Base64Error.InvalidPadding(end)
    }
    for (var i = 0; i < end; i++) {
        if (src[i] == 61) {
            throw Base64Error.InvalidPadding(i)
        }
    }
    if (rem == 1) {
        throw Base64Error.InvalidLength(end)
    }
    if (options.padding == Base64PaddingPolicy.Forbidden && paddingCount > 0) {
        throw Base64Error.InvalidPadding(end)
    }
    if (rem == 0) {
        if (paddingCount > 0) {
            throw Base64Error.InvalidPadding(end)
        }
        return
    }

    var requiredPadding = 2
    if (rem == 3) { requiredPadding = 1 }
    if (options.padding == Base64PaddingPolicy.Required && paddingCount != requiredPadding) {
        throw Base64Error.InvalidPadding(end)
    }
    if (options.padding == Base64PaddingPolicy.Optional &&
        paddingCount != 0 && paddingCount != requiredPadding) {
        throw Base64Error.InvalidPadding(end)
    }
}

fn _encodeAlpha(data: Slice<byte>, alpha: string, padding: bool) -> string {
    var n = len(data)
    var out = StringBuilder()
    var i = 0
    while (i + 3 <= n) {
        var b0 = data[i]
        var b1 = data[i + 1]
        var b2 = data[i + 2]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth(((b0 & 3) << 4) | (b1 >> 4)))
        out.append(alpha.runes().nth(((b1 & 15) << 2) | (b2 >> 6)))
        out.append(alpha.runes().nth(b2 & 63))
        i = i + 3
    }
    var rem = n - i
    if (rem == 1) {
        var b0 = data[i]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth((b0 & 3) << 4))
        if (padding) { out.append("==") }
    } else if (rem == 2) {
        var b0 = data[i]
        var b1 = data[i + 1]
        out.append(alpha.runes().nth(b0 >> 2))
        out.append(alpha.runes().nth(((b0 & 3) << 4) | (b1 >> 4)))
        out.append(alpha.runes().nth((b1 & 15) << 2))
        if (padding) { out.append("=") }
    }
    return out.toString()
}

fn _decodeImpl(text: string, options: Base64DecodeOptions) -> Array<byte> {
    var src: Slice<byte> = text.bytes()
    var end = len(src)
    while (end > 0 && src[end - 1] == 61) { end = end - 1 }

    var paddingCount = len(src) - end
    var rem = end % 4
    _checkPadding(src, end, paddingCount, rem, options)

    var full = end / 4
    var outLen = full * 3
    if (rem == 2) { outLen = outLen + 1 }
    else if (rem == 3) { outLen = outLen + 2 }

    var out = Array<byte>(outLen)
    var oi = 0
    var i = 0
    while (i + 4 <= end) {
        var c0 = _decodeRequired(src, i, options)
        var c1 = _decodeRequired(src, i + 1, options)
        var c2 = _decodeRequired(src, i + 2, options)
        var c3 = _decodeRequired(src, i + 3, options)
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
        out[oi + 1] = (((c1 & 15) << 4) | (c2 >> 2)) & 255
        out[oi + 2] = (((c2 & 3) << 6) | c3) & 255
        oi = oi + 3
        i = i + 4
    }
    if (rem == 2) {
        var c0 = _decodeRequired(src, i, options)
        var c1 = _decodeRequired(src, i + 1, options)
        if ((c1 & 15) != 0) {
            throw Base64Error.NonCanonicalTrailingBits(i + 1)
        }
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
    } else if (rem == 3) {
        var c0 = _decodeRequired(src, i, options)
        var c1 = _decodeRequired(src, i + 1, options)
        var c2 = _decodeRequired(src, i + 2, options)
        if ((c2 & 3) != 0) {
            throw Base64Error.NonCanonicalTrailingBits(i + 2)
        }
        out[oi] = ((c0 << 2) | (c1 >> 4)) & 255
        out[oi + 1] = (((c1 & 15) << 4) | (c2 >> 2)) & 255
    }
    return out
}

fn encode(data: Slice<byte>, options: Base64EncodeOptions? = null) -> string {
    var resolved = _encodeOptions(options)
    return _encodeAlpha(data, _alphabet(resolved.alphabet), resolved.padding)
}

fn decode(text: string, options: Base64DecodeOptions? = null) -> Array<byte> {
    return _decodeImpl(text, _decodeOptions(options))
}

fn isValid(text: string, options: Base64DecodeOptions? = null) -> bool {
    try {
        var decoded = _decodeImpl(text, _decodeOptions(options))
        return len(decoded) >= 0
    } catch (e: Base64Error) {
        return false
    }
}

export {
    Base64Alphabet,
    Base64PaddingPolicy,
    Base64Error,
    Base64EncodeOptions,
    Base64DecodeOptions,
    encode,
    decode,
    isValid
}
