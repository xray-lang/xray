// Expand a 32-byte key into 15 round keys, 240 bytes in all.
fn aesExpandKey(key: Array<u8>) -> Array<u8> {
    var w = Array<u8>((AES_ROUNDS + 1) * 16)
    for (var i = 0; i < AES_KEY_WORDS * 4; i++) { w[i] = key[i] }

    var total = (AES_ROUNDS + 1) * 4
    for (var i = AES_KEY_WORDS; i < total; i++) {
        var t0 = w[(i - 1) * 4] as i64
        var t1 = w[(i - 1) * 4 + 1] as i64
        var t2 = w[(i - 1) * 4 + 2] as i64
        var t3 = w[(i - 1) * 4 + 3] as i64
        if (i % AES_KEY_WORDS == 0) {
            // RotWord then SubWord, then add the round constant.
            var r0 = t0
            t0 = (AES_SBOX[t1] as i64) ^ (AES_RCON[i / AES_KEY_WORDS] as i64)
            t1 = AES_SBOX[t2] as i64
            t2 = AES_SBOX[t3] as i64
            t3 = AES_SBOX[r0] as i64
        } else if (i % AES_KEY_WORDS == 4) {
            t0 = AES_SBOX[t0] as i64
            t1 = AES_SBOX[t1] as i64
            t2 = AES_SBOX[t2] as i64
            t3 = AES_SBOX[t3] as i64
        }
        w[i * 4] = (((w[(i - AES_KEY_WORDS) * 4] as i64) ^ t0) & 255) as u8
        w[i * 4 + 1] = (((w[(i - AES_KEY_WORDS) * 4 + 1] as i64) ^ t1) & 255) as u8
        w[i * 4 + 2] = (((w[(i - AES_KEY_WORDS) * 4 + 2] as i64) ^ t2) & 255) as u8
        w[i * 4 + 3] = (((w[(i - AES_KEY_WORDS) * 4 + 3] as i64) ^ t3) & 255) as u8
    }
    return w
}

fn addRoundKey(state: ref Array<u8>, rk: Array<u8>, round: i64) {
    for (var i = 0; i < 16; i++) {
        state[i] = (((state[i] as i64) ^ (rk[round * 16 + i] as i64)) & 255) as u8
    }
}

// The state is column-major: byte i sits at row i%4, column i/4. Each row
// rotates left by its own index, done with scalars so a block costs no
// allocation per round.
fn shiftRows(state: ref Array<u8>) {
    var t = state[1]
    state[1] = state[5]; state[5] = state[9]; state[9] = state[13]; state[13] = t
    t = state[2]; state[2] = state[10]; state[10] = t
    t = state[6]; state[6] = state[14]; state[14] = t
    t = state[15]
    state[15] = state[11]; state[11] = state[7]; state[7] = state[3]; state[3] = t
}

fn invShiftRows(state: ref Array<u8>) {
    var t = state[13]
    state[13] = state[9]; state[9] = state[5]; state[5] = state[1]; state[1] = t
    t = state[2]; state[2] = state[10]; state[10] = t
    t = state[6]; state[6] = state[14]; state[14] = t
    t = state[3]
    state[3] = state[7]; state[7] = state[11]; state[11] = state[15]; state[15] = t
}

fn mixColumns(state: ref Array<u8>) {
    for (var c = 0; c < 4; c++) {
        var a0 = state[c * 4] as i64
        var a1 = state[c * 4 + 1] as i64
        var a2 = state[c * 4 + 2] as i64
        var a3 = state[c * 4 + 3] as i64
        state[c * 4] = (((GF_MUL2[a0] as i64) ^ (GF_MUL3[a1] as i64) ^ a2 ^ a3) & 255) as u8
        state[c * 4 + 1] = ((a0 ^ (GF_MUL2[a1] as i64) ^ (GF_MUL3[a2] as i64) ^ a3) & 255) as u8
        state[c * 4 + 2] = ((a0 ^ a1 ^ (GF_MUL2[a2] as i64) ^ (GF_MUL3[a3] as i64)) & 255) as u8
        state[c * 4 + 3] = (((GF_MUL3[a0] as i64) ^ a1 ^ a2 ^ (GF_MUL2[a3] as i64)) & 255) as u8
    }
}

fn invMixColumns(state: ref Array<u8>) {
    for (var c = 0; c < 4; c++) {
        var a0 = state[c * 4] as i64
        var a1 = state[c * 4 + 1] as i64
        var a2 = state[c * 4 + 2] as i64
        var a3 = state[c * 4 + 3] as i64
        state[c * 4] = (((GF_MUL14[a0] as i64) ^ (GF_MUL11[a1] as i64) ^ (GF_MUL13[a2] as i64) ^ (GF_MUL9[a3] as i64)) & 255) as u8
        state[c * 4 + 1] = (((GF_MUL9[a0] as i64) ^ (GF_MUL14[a1] as i64) ^ (GF_MUL11[a2] as i64) ^ (GF_MUL13[a3] as i64)) & 255) as u8
        state[c * 4 + 2] = (((GF_MUL13[a0] as i64) ^ (GF_MUL9[a1] as i64) ^ (GF_MUL14[a2] as i64) ^ (GF_MUL11[a3] as i64)) & 255) as u8
        state[c * 4 + 3] = (((GF_MUL11[a0] as i64) ^ (GF_MUL13[a1] as i64) ^ (GF_MUL9[a2] as i64) ^ (GF_MUL14[a3] as i64)) & 255) as u8
    }
}

// Both directions transform the state where it lies, so a CBC run reuses one
// sixteen-byte buffer for the whole message.
fn aesEncryptBlock(rk: Array<u8>, state: ref Array<u8>) {
    addRoundKey(ref state, rk, 0)
    for (var round = 1; round < AES_ROUNDS; round++) {
        for (var i = 0; i < 16; i++) { state[i] = AES_SBOX[state[i] as i64] }
        shiftRows(ref state)
        mixColumns(ref state)
        addRoundKey(ref state, rk, round)
    }
    for (var i = 0; i < 16; i++) { state[i] = AES_SBOX[state[i] as i64] }
    shiftRows(ref state)
    addRoundKey(ref state, rk, AES_ROUNDS)
}

fn aesDecryptBlock(rk: Array<u8>, state: ref Array<u8>) {
    addRoundKey(ref state, rk, AES_ROUNDS)
    for (var round = AES_ROUNDS - 1; round > 0; round--) {
        invShiftRows(ref state)
        for (var i = 0; i < 16; i++) { state[i] = AES_INV_SBOX[state[i] as i64] }
        addRoundKey(ref state, rk, round)
        invMixColumns(ref state)
    }
    invShiftRows(ref state)
    for (var i = 0; i < 16; i++) { state[i] = AES_INV_SBOX[state[i] as i64] }
    addRoundKey(ref state, rk, 0)
}


// ── AEAD ──
//
// Encrypt-then-MAC over AES-256-CBC. The user key is stretched into an
// independent cipher key and MAC key, the plaintext is PKCS#7 padded and
// chained under a fresh IV, and the tag covers the IV together with the
// ciphertext, so tampering is detected before anything is decrypted rather
// than surfacing as corrupted output.
//
// Wire format: hex(IV(16) || ciphertext(16n) || tag(32)).

const AEAD_ENC_LABEL: string = "xray-aead-enc-v1"
const AEAD_MAC_LABEL: string = "xray-aead-mac-v1"
const AEAD_TAG_LEN: i64 = 32
const AEAD_OVERHEAD: i64 = 48

fn hexDigit(c: i64) -> i64 {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 87 }
    if (c >= 65 && c <= 70) { return c - 55 }
    return -1
}

fn hexToBytes(view: Slice<u8>) -> Array<u8>? {
    if (len(view) % 2 != 0) { return null }
    var out: Array<u8> = []
    for (var i = 0; i < len(view); i = i + 2) {
        var hi = hexDigit(view[i] as i64)
        var lo = hexDigit(view[i + 1] as i64)
        if (hi < 0 || lo < 0) { return null }
        out.push((((hi * 16) + lo) & 255) as u8)
    }
    return out
}

fn aeadKey(key: Array<u8>, label: string) -> Array<u8> {
    return hmacBytes("sha256", key, toArray(label.bytes()))!
}

fn cbcEncrypt(rk: Array<u8>, iv: Array<u8>, padded: Array<u8>) -> Array<u8> {
    var out: Array<u8> = []
    var state = Array<u8>(AES_BLOCK)
    for (var i = 0; i < AES_BLOCK; i++) { state[i] = iv[i] }
    var off = 0
    while (off < len(padded)) {
        // The previous ciphertext block is already in state, so chaining is an
        // xor in place rather than a copy.
        for (var i = 0; i < AES_BLOCK; i++) {
            state[i] = (((padded[off + i] as i64) ^ (state[i] as i64)) & 255) as u8
        }
        aesEncryptBlock(rk, ref state)
        for (var i = 0; i < AES_BLOCK; i++) { out.push(state[i]) }
        off = off + AES_BLOCK
    }
    return out
}

fn cbcDecrypt(rk: Array<u8>, iv: Array<u8>, cipher: Array<u8>) -> Array<u8> {
    var out: Array<u8> = []
    var state = Array<u8>(AES_BLOCK)
    var prev = Array<u8>(AES_BLOCK)
    for (var i = 0; i < AES_BLOCK; i++) { prev[i] = iv[i] }
    var off = 0
    while (off < len(cipher)) {
        for (var i = 0; i < AES_BLOCK; i++) { state[i] = cipher[off + i] }
        aesDecryptBlock(rk, ref state)
        for (var i = 0; i < AES_BLOCK; i++) {
            out.push((((state[i] as i64) ^ (prev[i] as i64)) & 255) as u8)
            prev[i] = cipher[off + i]
        }
        off = off + AES_BLOCK
    }
    return out
}

// Authenticated encryption. The result is hex so it survives anywhere a string
// goes, which is what this module has always published.
export fn encrypt(key: string, plaintext: string) -> string {
    var k = toArray(key.bytes())
    var encKey = aeadKey(k, AEAD_ENC_LABEL)
    var macKey = aeadKey(k, AEAD_MAC_LABEL)

    // PKCS#7 always adds a block when the plaintext already fills one, so the
    // final byte is never ambiguous about how much to remove.
    var plain = toArray(plaintext.bytes())
    var pad = AES_BLOCK - (len(plain) % AES_BLOCK)
    var padded: Array<u8> = []
    for (var i = 0; i < len(plain); i++) { padded.push(plain[i]) }
    for (var i = 0; i < pad; i++) { padded.push((pad & 255) as u8) }

    var iv = entropyBytes(AES_BLOCK)
    var raw: Array<u8> = []
    for (var i = 0; i < AES_BLOCK; i++) { raw.push(iv[i]) }
    var cipher = cbcEncrypt(aesExpandKey(encKey), iv, padded)
    for (var i = 0; i < len(cipher); i++) { raw.push(cipher[i]) }

    var tag = hmacBytes("sha256", macKey, raw)!
    for (var i = 0; i < len(tag); i++) { raw.push(tag[i]) }
    return hexOf(raw)
}

// Answers null for anything that does not authenticate, without distinguishing
// a bad tag from bad padding: telling those apart is what makes a padding
// oracle.
export fn decrypt(key: string, ciphertext: string) -> string? {
    var raw = hexToBytes(ciphertext.bytes())
    if (raw == null) { return null }
    var bytes = raw!
    var cipherLen = len(bytes) - AEAD_OVERHEAD
    if (cipherLen <= 0 || cipherLen % AES_BLOCK != 0) { throw CryptoError.InvalidLength }

    var k = toArray(key.bytes())
    var macKey = aeadKey(k, AEAD_MAC_LABEL)

    var signed: Array<u8> = []
    for (var i = 0; i < AES_BLOCK + cipherLen; i++) { signed.push(bytes[i]) }
    var actual: Array<u8> = []
    for (var i = 0; i < AEAD_TAG_LEN; i++) { actual.push(bytes[AES_BLOCK + cipherLen + i]) }
    if (!__timingSafeEqualBytes(hmacBytes("sha256", macKey, signed)!, actual)) { return null }

    var iv = Array<u8>(AES_BLOCK)
    for (var i = 0; i < AES_BLOCK; i++) { iv[i] = bytes[i] }
    var cipher: Array<u8> = []
    for (var i = 0; i < cipherLen; i++) { cipher.push(bytes[AES_BLOCK + i]) }

    var encKey = aeadKey(k, AEAD_ENC_LABEL)
    var plain = cbcDecrypt(aesExpandKey(encKey), iv, cipher)

    var pad = plain[len(plain) - 1] as i64
    if (pad <= 0 || pad > AES_BLOCK || pad > len(plain)) { return null }
    for (var i = len(plain) - pad; i < len(plain); i++) {
        if ((plain[i] as i64) != pad) { return null }
    }
    var out: Array<u8> = []
    for (var i = 0; i < len(plain) - pad; i++) { out.push(plain[i]) }
    return string.fromUtf8(out[:])
}
