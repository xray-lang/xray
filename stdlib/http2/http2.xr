// http2 — HTTP/2 framing, HPACK and request orchestration, written in Xray.
//
// Everything on this page is arithmetic over bytes: the HPACK static and
// dynamic tables, the RFC 7541 integer and Huffman codings, the nine-byte
// frame header, the SETTINGS / WINDOW_UPDATE / GOAWAY payloads, the stream
// state machine and the flow-control accounting. None of it needs a socket,
// so none of it needs C.
//
// Transport is composed entirely from net's generic connection, TLS/ALPN and
// byte-stream surface. HTTP/2 owns only its protocol choices and byte-level
// state machine; it has no module-specific native leaves.
//
// This module is also the single owner of the HTTP/2 admission rules. They
// used to exist twice — once here in Xray and once in C — with two different
// failure channels for the same input, so a forbidden header name raised
// ProtocolError while a malformed method returned null and became
// ConnectionFailed. Every rule is now stated once, in _validateRequest, and
// every rejection leaves through Http2Error.

import net
import { NetError } from net
import time

// ---- Frame types (RFC 7540 Section 6) ----
const FRAME_DATA = 0x0
const FRAME_HEADERS = 0x1
const FRAME_PRIORITY = 0x2
const FRAME_RST_STREAM = 0x3
const FRAME_SETTINGS = 0x4
const FRAME_PUSH_PROMISE = 0x5
const FRAME_PING = 0x6
const FRAME_GOAWAY = 0x7
const FRAME_WINDOW_UPDATE = 0x8
const FRAME_CONTINUATION = 0x9

// ---- Frame flags ----
const FLAG_END_STREAM = 0x1
const FLAG_END_HEADERS = 0x4
const FLAG_PADDED = 0x8
const FLAG_PRIORITY = 0x20
const FLAG_ACK = 0x1

// ---- SETTINGS identifiers (RFC 7540 Section 6.5.2) ----
const SETTINGS_HEADER_TABLE_SIZE = 0x1
const SETTINGS_ENABLE_PUSH = 0x2
const SETTINGS_MAX_CONCURRENT_STREAMS = 0x3
const SETTINGS_INITIAL_WINDOW_SIZE = 0x4
const SETTINGS_MAX_FRAME_SIZE = 0x5
const SETTINGS_MAX_HEADER_LIST_SIZE = 0x6

// ---- Error codes (RFC 7540 Section 7) ----
export const NO_ERROR = 0x0
export const PROTOCOL_ERROR = 0x1
export const INTERNAL_ERROR = 0x2
export const FLOW_CONTROL_ERROR = 0x3
export const SETTINGS_TIMEOUT = 0x4
export const STREAM_CLOSED = 0x5
export const FRAME_SIZE_ERROR = 0x6
export const REFUSED_STREAM = 0x7
export const CANCEL = 0x8
export const COMPRESSION_ERROR = 0x9
export const CONNECT_ERROR = 0xa
export const ENHANCE_YOUR_CALM = 0xb
export const INADEQUATE_SECURITY = 0xc
export const HTTP_1_1_REQUIRED = 0xd

// ---- Protocol constants ----
const FRAME_HEADER_SIZE = 9
const DEFAULT_HEADER_TABLE_SIZE = 4096
const DEFAULT_MAX_CONCURRENT_STREAMS = 100
const DEFAULT_INITIAL_WINDOW_SIZE = 65535
const DEFAULT_MAX_FRAME_SIZE = 16384
const MAX_ALLOWED_FRAME_SIZE = 16777215
const MAX_WINDOW = 2147483647

// Transport policy belongs to this source module. net only exposes generic
// TLS/ALPN configuration and the negotiated protocol result.
const H2_ALPN = "h2"
const MAX_TRANSPORT_TIMEOUT_MS: i64 = 2147483647

// The connection preface a client sends before anything else (RFC 7540
// Section 3.5). Twenty-four bytes, fixed.
const PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

// Response ceilings. A peer chooses how many headers to send and how large
// they are, so both need a bound that does not depend on the peer.
const MAX_RESPONSE_HEADERS = 128
const MAX_RESPONSE_HEADER_BYTES = 65536

// The request-header ceiling. Four pseudo-headers plus this many custom
// headers is what one HEADERS frame carries here.
const MAX_REQUEST_HEADERS = 28

// How much of a response body to accept before giving up on a peer that
// never ends the stream.
const MAX_RESPONSE_BODY_BYTES = 268435456

// How many frames to process for one request before concluding the peer is
// not going to finish. The C implementation had no such bound and would spin
// on a connection until the coroutine supervisor cancelled it.
const MAX_FRAMES_PER_REQUEST = 100000

// ---- Errors ----

// Every rejection this module makes leaves through one of these. The old
// split -- some rules raising an error and others returning null, which the
// caller then reported as a connection failure -- meant one bad header could
// surface under two unrelated names depending on which layer noticed it.
export enum Http2Error {
    // A request this module refuses to put on the wire: a header name or
    // value outside the grammar, a connection-specific header, a method that
    // is not a token, or more headers than one HEADERS frame carries.
    ProtocolError { reason: string },
    // The peer could not be reached, or the connection failed before a
    // complete response arrived.
    ConnectionFailed { target: string },
    // The peer spoke something other than HTTP/2.
    FramingError { reason: string },
    // The peer's HPACK block could not be decoded (RFC 7541 Section 4.2
    // makes this a connection error).
    CompressionError { reason: string },
    // The build has no TLS provider, so no HTTP/2 connection is possible.
    TlsUnavailable
}

// ---- Admission rules: this module is their only owner ----

// RFC 7230 `tchar`. Header names and methods are both tokens.
fn _isTokenByte(c: i64) -> bool {
    if (c >= 48 && c <= 57) { return true }    // 0-9
    if (c >= 65 && c <= 90) { return true }    // A-Z
    if (c >= 97 && c <= 122) { return true }   // a-z
    return c == 33 || c == 35 || c == 36 || c == 37 ||   // ! # $ %
           c == 38 || c == 39 || c == 42 || c == 43 ||   // & ' * +
           c == 45 || c == 46 || c == 94 || c == 95 ||   // - . ^ _
           c == 96 || c == 124 || c == 126               // ` | ~
}

// A method must be a non-empty token (RFC 7540 Section 8.1.2.3 inherits the
// HTTP/1.1 grammar). The C binding checked this; http.xr checked something
// looser -- no control characters and no spaces -- so `GET@X` passed one and
// failed the other, and the disagreement surfaced as a connection failure.
fn _methodValid(method: string) -> bool {
    var b: const Slice<u8> = method.bytes()
    if (len(b) == 0) { return false }
    for (var i = 0; i < len(b); i++) {
        if (!_isTokenByte(b[i] as i64)) { return false }
    }
    return true
}

// A header name must be a non-empty token. `:` is not a token character, so
// this also rejects the pseudo-headers a caller must not supply -- this
// module writes those itself.
fn _headerNameValid(name: string) -> bool {
    var b: const Slice<u8> = name.bytes()
    if (len(b) == 0) { return false }
    for (var i = 0; i < len(b); i++) {
        if (!_isTokenByte(b[i] as i64)) { return false }
    }
    return true
}

// A header value may hold anything printable plus horizontal tab, and
// obs-text above 0x7F. It may not hold a control character, which is what
// stops header injection.
fn _headerValueValid(value: string) -> bool {
    var b: const Slice<u8> = value.bytes()
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c == 9) { continue }
        if (c < 0x20 || c == 0x7F) { return false }
    }
    return true
}

// ASCII-lowercase a header name. RFC 7540 Section 8.1.2 requires lowercase
// field names on the wire, and a conformant peer answers a mixed-case name
// with RST_STREAM(PROTOCOL_ERROR).
fn _asciiLower(s: string) -> string {
    var b: const Slice<u8> = s.bytes()
    var out = Array<u8>(len(b))
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        out[i] = (c >= 65 && c <= 90 ? c + 32 : c) as u8
    }
    return string.fromUtf8(out[:])
}

fn _trimAscii(s: string) -> string {
    var b: const Slice<u8> = s.bytes()
    var start = 0
    var end = len(b)
    while (start < end && (b[start] == 32 || b[start] == 9)) { start = start + 1 }
    while (end > start && (b[end - 1] == 32 || b[end - 1] == 9)) { end = end - 1 }
    var out = Array<u8>(end - start)
    for (var i = start; i < end; i++) { out[i - start] = b[i] }
    return string.fromUtf8(out[:])
}

// RFC 7540 Section 8.1.2.2: connection-specific header fields must not
// appear in an HTTP/2 request. `te` is the one exception, and only with the
// value `trailers`.
fn _headerForbidden(lowerName: string, value: string) -> bool {
    if (lowerName == "connection" || lowerName == "keep-alive" ||
        lowerName == "proxy-connection" || lowerName == "transfer-encoding" ||
        lowerName == "upgrade" || lowerName == "host") {
        return true
    }
    if (lowerName == "te" && _asciiLower(_trimAscii(value)) != "trailers") {
        return true
    }
    return false
}

// Check one request against every admission rule, raising on the first
// violation. Both the header count and the parallel-array length live here:
// callers hand over two arrays and the pairing is only meaningful when they
// are the same length.
fn _validateRequest(method: string, names: Array<string>, values: Array<string>) {
    if (!_methodValid(method)) {
        throw Http2Error.ProtocolError { reason: "method is not a token: " + method }
    }
    if (len(names) != len(values)) {
        throw Http2Error.ProtocolError { reason: "header names and values differ in length" }
    }
    if (len(names) > MAX_REQUEST_HEADERS) {
        throw Http2Error.ProtocolError { reason: "too many headers for one HEADERS frame" }
    }
    for (var i = 0; i < len(names); i++) {
        if (!_headerNameValid(names[i])) {
            throw Http2Error.ProtocolError { reason: "invalid header name: " + names[i] }
        }
        if (!_headerValueValid(values[i])) {
            throw Http2Error.ProtocolError { reason: "invalid header value for: " + names[i] }
        }
        var lower = _asciiLower(names[i])
        if (_headerForbidden(lower, values[i])) {
            throw Http2Error.ProtocolError { reason: "header not allowed in HTTP/2: " + lower }
        }
    }
}
// ---- HPACK static table (RFC 7541 Appendix A) ----
//
// Index 0 is unused: HPACK indices are 1-based, so entry 0 is a placeholder
// that keeps the array index and the protocol index the same number.
