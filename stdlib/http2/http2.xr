// ---- HPACK integer coding (RFC 7541 Section 5.1) ----

// Append `value` with an N-bit prefix. `first` carries the flag bits already
// positioned in the byte's high (8 - prefixBits) places; this writes the
// whole byte and any continuation octets after it.
fn _writeInt(out: ref Array<u8>, first: i64, value: i64, prefixBits: i64) {
    var maxPrefix = (1 << prefixBits) - 1
    if (value < maxPrefix) {
        out.push((first | value) as u8)
        return
    }
    out.push((first | maxPrefix) as u8)
    var rest = value - maxPrefix
    while (rest >= 128) {
        out.push(((rest & 127) | 128) as u8)
        rest = rest >> 7
    }
    out.push(rest as u8)
}

// Decode the prefix integer at src[pos]. Answers (value, next), where a
// negative `next` means the encoding was truncated or ran past the ceiling.
//
// RFC 7541 Section 5.1 puts no bound on the continuation octets, but every
// field that reaches here is at most 2^31 - 1 in HTTP/2. The C decoder this
// replaces shifted without a bound, so a peer could send a long run of
// continuation octets and overflow the accumulator.
fn _readInt(src: Array<u8>, pos: i64, limit: i64, prefixBits: i64) -> (i64, i64) {
    if (pos >= limit) { return (0, -1) }
    var maxPrefix = (1 << prefixBits) - 1
    var value = (src[pos] as i64) & maxPrefix
    if (value < maxPrefix) { return (value, pos + 1) }
    var i = pos + 1
    var shift = 0
    while (i < limit) {
        var b = src[i] as i64
        value = value + ((b & 127) << shift)
        if (value > MAX_WINDOW) { return (0, -1) }
        i = i + 1
        if ((b & 128) == 0) { return (value, i) }
        shift = shift + 7
        if (shift > 28) { return (0, -1) }
    }
    return (0, -1)
}

// ---- HPACK Huffman coding (RFC 7541 Section 5.2, Appendix B) ----
//
// The Appendix B code is canonical: sort its 257 codes by (bit length, code
// value) and the codes of each length form one contiguous ascending run.
// That turns decoding into arithmetic over five constant arrays instead of a
// pointer trie built on first use, which is what the C version did behind a
// once-guard over mutable file-scope state. HUFFMAN_FIRST_CODE[n] is the
// smallest code of length n, HUFFMAN_FIRST_INDEX[n] where that length's
// symbols begin in HUFFMAN_SYMBOL, and HUFFMAN_COUNT[n] how many there are.
//
// tests/unit/http/test_http2_huffman.c rebuilds all six arrays from RFC 7541
// Appendix B and compares them against this file entry by entry.

const HUFFMAN_MAX_BITS = 30
const HUFFMAN_EOS = 256

// Encoded length in bytes of src[start:end].
fn _huffmanLength(src: Array<u8>, start: i64, end: i64) -> i64 {
    var bits = 0
    for (var i = start; i < end; i++) {
        bits = bits + HUFFMAN_BITS[src[i] as i64]
    }
    return (bits + 7) / 8
}

// Append the Huffman form of src[start:end]. RFC 7541 Section 5.2 pads the
// last byte with the most significant bits of the EOS code, which are all
// ones.
fn _huffmanWrite(out: ref Array<u8>, src: Array<u8>, start: i64, end: i64) {
    var acc = 0
    var nbits = 0
    for (var i = start; i < end; i++) {
        var sym = src[i] as i64
        acc = (acc << HUFFMAN_BITS[sym]) | HUFFMAN_CODE[sym]
        nbits = nbits + HUFFMAN_BITS[sym]
        while (nbits >= 8) {
            nbits = nbits - 8
            out.push(((acc >> nbits) & 255) as u8)
        }
    }
    if (nbits > 0) {
        var pad = 8 - nbits
        out.push((((acc << pad) | ((1 << pad) - 1)) & 255) as u8)
    }
}

// Decode src[start:end], or answer null when the input is not a valid
// Huffman string. RFC 7541 Section 5.2 makes three things errors: a literal
// EOS symbol, padding longer than seven bits, and padding that is not a
// prefix of the EOS code.
fn _huffmanRead(src: Array<u8>, start: i64, end: i64) -> Array<u8>? {
    var out = Array<u8>()
    var code = 0
    var nbits = 0
    for (var i = start; i < end; i++) {
        var byte = src[i] as i64
        for (var b = 7; b >= 0; b--) {
            code = (code << 1) | ((byte >> b) & 1)
            nbits = nbits + 1
            if (nbits > HUFFMAN_MAX_BITS) { return null }
            var n = HUFFMAN_COUNT[nbits]
            if (n > 0) {
                var firstCode = HUFFMAN_FIRST_CODE[nbits]
                if (code >= firstCode && code < firstCode + n) {
                    var sym = HUFFMAN_SYMBOL[HUFFMAN_FIRST_INDEX[nbits] + (code - firstCode)]
                    if (sym == HUFFMAN_EOS) { return null }
                    out.push(sym as u8)
                    code = 0
                    nbits = 0
                }
            }
        }
    }
    if (nbits > 0) {
        if (nbits > 7) { return null }
        if (code != (1 << nbits) - 1) { return null }
    }
    return out
}

// ---- HPACK string literals (RFC 7541 Section 5.2) ----

// Write one string literal, Huffman-coded when that is shorter. The C
// encoder always wrote raw literals; choosing per string is what the RFC
// intends and costs one extra pass over the bytes.
fn _writeString(out: ref Array<u8>, s: string) {
    var raw = s.copyBytes()
    var n = len(raw)
    var huffLen = _huffmanLength(raw, 0, n)
    if (huffLen < n) {
        _writeInt(ref out, 0x80, huffLen, 7)
        _huffmanWrite(ref out, raw, 0, n)
    } else {
        _writeInt(ref out, 0x00, n, 7)
        for (var i = 0; i < n; i++) { out.push(raw[i]) }
    }
}

// Read one string literal. Answers (bytes, next); a negative `next` means
// the literal was malformed or ran past `limit`.
fn _readString(src: Array<u8>, pos: i64, limit: i64) -> (Array<u8>, i64) {
    var empty = Array<u8>()
    if (pos >= limit) { return (empty, -1) }
    var huffman = ((src[pos] as i64) & 0x80) != 0
    var head = _readInt(src, pos, limit, 7)
    var strLen = head.0
    var next = head.1
    if (next < 0) { return (empty, -1) }
    if (strLen > limit - next) { return (empty, -1) }
    if (huffman) {
        var decoded = _huffmanRead(src, next, next + strLen)
        if (decoded == null) { return (empty, -1) }
        return (decoded!, next + strLen)
    }
    var out = Array<u8>(strLen)
    for (var i = 0; i < strLen; i++) { out[i] = src[next + i] }
    return (out, next + strLen)
}

// ---- HPACK dynamic table (RFC 7541 Section 4) ----

// Entry 0 is the most recently added, which is the order HPACK indices use.
// The table is small by construction -- 4096 bytes of budget against a 32
// byte per-entry overhead caps it at 128 entries -- so the shift on eviction
// is bounded and cheap.
final class HpackTable {
    names: Array<string>
    values: Array<string>
    sizes: Array<i64>
    size: i64
    maxSize: i64

    constructor(maxSize: i64 = DEFAULT_HEADER_TABLE_SIZE) {
        this.names = []
        this.values = []
        this.sizes = []
        this.size = 0
        this.maxSize = maxSize
    }

    count() -> i64 { return len(this.names) }

    // Drop the oldest entry. It lives at the end of the arrays.
    ref evictOne() {
        var last = len(this.names) - 1
        if (last < 0) { return }
        this.size = this.size - this.sizes[last]
        this.names.pop()
        this.values.pop()
        this.sizes.pop()
    }

    // RFC 7541 Section 4.4: an entry larger than the whole table empties it
    // and is not inserted.
    ref add(name: string, value: string) {
        var entrySize = len(name.bytes()) + len(value.bytes()) + 32
        while (this.size + entrySize > this.maxSize && len(this.names) > 0) {
            this.evictOne()
        }
        if (entrySize > this.maxSize) {
            this.clear()
            return
        }
        this.names.unshift(name)
        this.values.unshift(value)
        this.sizes.unshift(entrySize)
        this.size = this.size + entrySize
    }

    ref clear() {
        this.names.clear()
        this.values.clear()
        this.sizes.clear()
        this.size = 0
    }

    // RFC 7541 Section 4.3: shrinking the table evicts until it fits. The C
    // decoder assigned the new maximum and evicted nothing, so a peer could
    // shrink the table and leave it over budget.
    ref setMaxSize(newMax: i64) {
        this.maxSize = newMax
        while (this.size > this.maxSize && len(this.names) > 0) {
            this.evictOne()
        }
    }
}

// ---- HPACK decoding ----

// One decoded header block. Names and values are parallel.
export final class HeaderList {
    names: Array<string>
    values: Array<string>

    constructor() {
        this.names = []
        this.values = []
    }

    count() -> i64 { return len(this.names) }

    ref add(name: string, value: string) {
        this.names.push(name)
        this.values.push(value)
    }
}

// The decoding half of an HPACK context. The dynamic table is connection
// state: it must see every block the peer sends, in order, or later blocks
// decode to the wrong headers.
export final class HpackDecoder {
    table: HpackTable

    constructor(maxTableSize: i64 = DEFAULT_HEADER_TABLE_SIZE) {
        this.table = HpackTable(maxTableSize)
    }

    // Resolve an index against the static table then the dynamic one.
    // Answers null when the index names nothing.
    lookupName(index: i64) -> string? {
        if (index <= 0) { return null }
        if (index <= STATIC_TABLE_SIZE) { return STATIC_NAMES[index] }
        var d = index - STATIC_TABLE_SIZE - 1
        if (d >= this.table.count()) { return null }
        return this.table.names[d]
    }

    lookupValue(index: i64) -> string? {
        if (index <= 0) { return null }
        if (index <= STATIC_TABLE_SIZE) { return STATIC_VALUES[index] }
        var d = index - STATIC_TABLE_SIZE - 1
        if (d >= this.table.count()) { return null }
        return this.table.values[d]
    }

    // Decode one header block. Answers null on any error; RFC 7541 Section
    // 4.2 makes every HPACK failure a connection error, so there is no
    // partial result worth returning.
    ref decode(block: Array<u8>) -> HeaderList? {
        return this.decodeRange(block, 0, len(block))
    }

    ref decodeRange(block: Array<u8>, start: i64, limit: i64) -> HeaderList? {
        var out = HeaderList()
        var pos = start
        while (pos < limit) {
            var b = block[pos] as i64
            if ((b & 0x80) != 0) {
                // Indexed header field (Section 6.1).
                var r = _readInt(block, pos, limit, 7)
                if (r.1 < 0) { return null }
                pos = r.1
                var name = this.lookupName(r.0)
                var value = this.lookupValue(r.0)
                if (name == null || value == null) { return null }
                out.add(name!, value!)
            } else if ((b & 0x40) != 0) {
                // Literal with incremental indexing (Section 6.2.1).
                var r = _readInt(block, pos, limit, 6)
                if (r.1 < 0) { return null }
                pos = r.1
                var pair = this.readNameValue(block, pos, limit, r.0)
                if (pair == null) { return null }
                pos = pair!.pos
                this.table.add(pair!.name, pair!.value)
                out.add(pair!.name, pair!.value)
            } else if ((b & 0x20) != 0) {
                // Dynamic table size update (Section 6.3).
                var r = _readInt(block, pos, limit, 5)
                if (r.1 < 0) { return null }
                pos = r.1
                // Section 6.3 caps the new size at the value the decoder
                // advertised in SETTINGS_HEADER_TABLE_SIZE. The C decoder
                // took whatever the peer asked for.
                if (r.0 > DEFAULT_HEADER_TABLE_SIZE) { return null }
                this.table.setMaxSize(r.0)
            } else {
                // Literal without indexing / never indexed (6.2.2, 6.2.3).
                var r = _readInt(block, pos, limit, 4)
                if (r.1 < 0) { return null }
                pos = r.1
                var pair = this.readNameValue(block, pos, limit, r.0)
                if (pair == null) { return null }
                pos = pair!.pos
                out.add(pair!.name, pair!.value)
            }
            if (out.count() > MAX_RESPONSE_HEADERS) { return null }
        }
        return out
    }

    // A literal's name comes either from an index or from an inline string;
    // its value is always inline.
    ref readNameValue(block: Array<u8>, pos: i64, limit: i64, nameIndex: i64) -> _NameValue? {
        var at = pos
        var name = ""
        if (nameIndex == 0) {
            var ns = _readString(block, at, limit)
            if (ns.1 < 0) { return null }
            at = ns.1
            name = string.fromUtf8Lossy(ns.0[:])
        } else {
            var found = this.lookupName(nameIndex)
            if (found == null) { return null }
            name = found!
        }
        var vs = _readString(block, at, limit)
        if (vs.1 < 0) { return null }
        at = vs.1
        return _NameValue(name, string.fromUtf8Lossy(vs.0[:]), at)
    }
}

final class _NameValue {
    name: string
    value: string
    pos: i64

    constructor(name: string, value: string, pos: i64) {
        this.name = name
        this.value = value
        this.pos = pos
    }
}

// ---- HPACK encoding ----

// The encoding half of an HPACK context.
//
// This encoder indexes: it looks a header up in the static table, emits a
// one-byte reference when name and value both match, and otherwise emits a
// literal that names the field by index when only the name matches. The C
// encoder ignored its own table and wrote every field as a literal with a
// new name, so `:method GET` cost eleven bytes on the wire instead of one.
//
// The dynamic table is deliberately not fed. Adding to it is only a win
// across requests on one connection, and this module opens a connection per
// request (see `request`), so entries would never be read back.
export final class HpackEncoder {
    table: HpackTable

    constructor(maxTableSize: i64 = DEFAULT_HEADER_TABLE_SIZE) {
        this.table = HpackTable(maxTableSize)
    }

    // Answer the static-table index whose name and value both match, or 0.
    staticFull(name: string, value: string) -> i64 {
        for (var i = 1; i <= STATIC_TABLE_SIZE; i++) {
            if (STATIC_NAMES[i] == name && STATIC_VALUES[i] == value) { return i }
        }
        return 0
    }

    // Answer the lowest static-table index with this name, or 0.
    staticName(name: string) -> i64 {
        for (var i = 1; i <= STATIC_TABLE_SIZE; i++) {
            if (STATIC_NAMES[i] == name) { return i }
        }
        return 0
    }

    // Append one header. The name is lowercased first: RFC 7540 Section
    // 8.1.2 requires it, and a conformant peer answers a mixed-case name
    // with RST_STREAM(PROTOCOL_ERROR).
    ref encodeHeader(out: ref Array<u8>, name: string, value: string) {
        var lower = _asciiLower(name)
        var full = this.staticFull(lower, value)
        if (full > 0) {
            _writeInt(ref out, 0x80, full, 7)
            return
        }
        var nameIndex = this.staticName(lower)
        if (nameIndex > 0) {
            // Literal without indexing, indexed name (Section 6.2.2).
            _writeInt(ref out, 0x00, nameIndex, 4)
            _writeString(ref out, value)
            return
        }
        // Literal without indexing, new name (Section 6.2.2).
        out.push(0x00 as u8)
        _writeString(ref out, lower)
        _writeString(ref out, value)
    }

    ref encode(names: Array<string>, values: Array<string>) -> Array<u8> {
        var out = Array<u8>()
        for (var i = 0; i < len(names); i++) {
            this.encodeHeader(ref out, names[i], values[i])
        }
        return out
    }
}
// ---- Frame header (RFC 7540 Section 4.1) ----
//
// Nine bytes: a 24-bit length, an 8-bit type, 8 bits of flags, and a 32-bit
// stream identifier whose top bit is reserved and always cleared.

export final class FrameHeader {
    length: i64
    kind: i64
    flags: i64
    streamId: i64

    constructor(length: i64, kind: i64, flags: i64, streamId: i64) {
        this.length = length
        this.kind = kind
        this.flags = flags
        this.streamId = streamId
    }

    hasFlag(flag: i64) -> bool { return (this.flags & flag) != 0 }
}

fn _writeU32(out: ref Array<u8>, v: i64) {
    out.push(((v >> 24) & 255) as u8)
    out.push(((v >> 16) & 255) as u8)
    out.push(((v >> 8) & 255) as u8)
    out.push((v & 255) as u8)
}

fn _readU32(src: Array<u8>, pos: i64) -> i64 {
    return ((src[pos] as i64) << 24) | ((src[pos + 1] as i64) << 16) |
           ((src[pos + 2] as i64) << 8) | (src[pos + 3] as i64)
}

// Append a nine-byte frame header. A length above the 24-bit ceiling would
// silently truncate, so it is refused instead; the C writer truncated.
export fn writeFrameHeader(out: ref Array<u8>, length: i64, kind: i64, flags: i64,
                           streamId: i64) {
    if (length < 0 || length > MAX_ALLOWED_FRAME_SIZE) {
        throw Http2Error.FramingError { reason: "frame length out of range: " + string(length) }
    }
    out.push(((length >> 16) & 255) as u8)
    out.push(((length >> 8) & 255) as u8)
    out.push((length & 255) as u8)
    out.push((kind & 255) as u8)
    out.push((flags & 255) as u8)
    out.push(((streamId >> 24) & 0x7F) as u8)
    out.push(((streamId >> 16) & 255) as u8)
    out.push(((streamId >> 8) & 255) as u8)
    out.push((streamId & 255) as u8)
}

// Read a nine-byte frame header at `pos`, or null when fewer than nine bytes
// remain. The C parser read nine bytes without checking that nine were
// there.
export fn readFrameHeader(src: Array<u8>, pos: i64) -> FrameHeader? {
    if (pos + FRAME_HEADER_SIZE > len(src)) { return null }
    var length = ((src[pos] as i64) << 16) | ((src[pos + 1] as i64) << 8) |
                 (src[pos + 2] as i64)
    var kind = src[pos + 3] as i64
    var flags = src[pos + 4] as i64
    var streamId = _readU32(src, pos + 5) & MAX_WINDOW
    return FrameHeader(length, kind, flags, streamId)
}

// Check an inbound frame header's shape. Answers NO_ERROR when it is
// acceptable, otherwise the RFC 7540 Section 7 code to report.
//
// Order matters and is preserved from the C implementation: the stream
// identifier is judged before the length, so PRIORITY on stream 0 with a
// correct length is PROTOCOL_ERROR rather than a size error.
export fn validateFrameHeader(header: FrameHeader) -> i64 {
    var kind = header.kind
    if (kind == FRAME_DATA || kind == FRAME_HEADERS || kind == FRAME_PRIORITY ||
        kind == FRAME_RST_STREAM) {
        if (header.streamId == 0) { return PROTOCOL_ERROR }
    }
    if (kind == FRAME_SETTINGS) {
        if (header.streamId != 0) { return PROTOCOL_ERROR }
        if (header.hasFlag(FLAG_ACK) && header.length != 0) { return FRAME_SIZE_ERROR }
    } else if (kind == FRAME_HEADERS) {
        if (!header.hasFlag(FLAG_END_HEADERS)) { return PROTOCOL_ERROR }
    } else if (kind == FRAME_PRIORITY) {
        if (header.length != 5) { return FRAME_SIZE_ERROR }
    } else if (kind == FRAME_RST_STREAM) {
        if (header.length != 4) { return FRAME_SIZE_ERROR }
    } else if (kind == FRAME_PUSH_PROMISE || kind == FRAME_CONTINUATION) {
        return PROTOCOL_ERROR
    } else if (kind == FRAME_PING) {
        if (header.streamId != 0) { return PROTOCOL_ERROR }
        if (header.length != 8) { return FRAME_SIZE_ERROR }
    } else if (kind == FRAME_GOAWAY) {
        if (header.streamId != 0) { return PROTOCOL_ERROR }
        if (header.length < 8) { return FRAME_SIZE_ERROR }
    } else if (kind == FRAME_WINDOW_UPDATE) {
        if (header.length != 4) { return FRAME_SIZE_ERROR }
    }
    return NO_ERROR
}

// ---- SETTINGS (RFC 7540 Section 6.5) ----

// The six settings, indexed by their protocol identifier. Slot 0 is unused
// so that a setting's index and its wire identifier are the same number.
export final class Settings {
    values: Array<i64>

    constructor() {
        this.values = [0, DEFAULT_HEADER_TABLE_SIZE, 1, DEFAULT_MAX_CONCURRENT_STREAMS,
                       DEFAULT_INITIAL_WINDOW_SIZE, DEFAULT_MAX_FRAME_SIZE, MAX_WINDOW]
    }

    get(id: i64) -> i64 {
        if (id < 1 || id > 6) { return 0 }
        return this.values[id]
    }

    ref set(id: i64, value: i64) {
        if (id < 1 || id > 6) { return }
        this.values[id] = value
    }
}

// Judge one setting against RFC 7540 Section 6.5.2.
fn _validateSetting(id: i64, value: i64) -> i64 {
    if (id == SETTINGS_ENABLE_PUSH) {
        if (value > 1) { return PROTOCOL_ERROR }
    } else if (id == SETTINGS_INITIAL_WINDOW_SIZE) {
        if (value > MAX_WINDOW) { return FLOW_CONTROL_ERROR }
    } else if (id == SETTINGS_MAX_FRAME_SIZE) {
        if (value < DEFAULT_MAX_FRAME_SIZE || value > MAX_ALLOWED_FRAME_SIZE) {
            return PROTOCOL_ERROR
        }
    }
    return NO_ERROR
}

// Apply a SETTINGS payload, or answer the error code to report.
//
// The scan runs twice on purpose. A payload carrying a valid setting and
// then an invalid one must leave the peer's settings untouched, so nothing
// is written until every entry has been judged.
export fn applySettingsPayload(settings: ref Settings, payload: Array<u8>, start: i64,
                               length: i64) -> i64 {
    if (length % 6 != 0) { return FRAME_SIZE_ERROR }
    if (start + length > len(payload)) { return FRAME_SIZE_ERROR }
    var i = 0
    while (i < length) {
        var id = ((payload[start + i] as i64) << 8) | (payload[start + i + 1] as i64)
        var value = _readU32(payload, start + i + 2)
        var err = _validateSetting(id, value)
        if (err != NO_ERROR) { return err }
        i = i + 6
    }
    i = 0
    while (i < length) {
        var id = ((payload[start + i] as i64) << 8) | (payload[start + i + 1] as i64)
        var value = _readU32(payload, start + i + 2)
        if (id >= 1 && id <= 6) { settings.set(id, value) }
        i = i + 6
    }
    return NO_ERROR
}

// Append one six-byte SETTINGS entry.
fn _writeSetting(out: ref Array<u8>, id: i64, value: i64) {
    out.push(((id >> 8) & 255) as u8)
    out.push((id & 255) as u8)
    _writeU32(ref out, value)
}

// The SETTINGS frame a client sends immediately after the preface.
export fn encodeClientSettings(settings: Settings) -> Array<u8> {
    var payload = Array<u8>()
    _writeSetting(ref payload, SETTINGS_MAX_CONCURRENT_STREAMS,
                  settings.get(SETTINGS_MAX_CONCURRENT_STREAMS))
    _writeSetting(ref payload, SETTINGS_INITIAL_WINDOW_SIZE,
                  settings.get(SETTINGS_INITIAL_WINDOW_SIZE))
    _writeSetting(ref payload, SETTINGS_MAX_FRAME_SIZE,
                  settings.get(SETTINGS_MAX_FRAME_SIZE))
    // A client never accepts server push, and says so rather than relying on
    // the peer's default.
    _writeSetting(ref payload, SETTINGS_ENABLE_PUSH, 0)

    var out = Array<u8>()
    writeFrameHeader(ref out, len(payload), FRAME_SETTINGS, 0, 0)
    out.appendFrom(payload[:])
    return out
}

export fn encodeSettingsAck() -> Array<u8> {
    var out = Array<u8>()
    writeFrameHeader(ref out, 0, FRAME_SETTINGS, FLAG_ACK, 0)
    return out
}

export fn encodeWindowUpdate(streamId: i64, increment: i64) -> Array<u8> {
    var out = Array<u8>()
    writeFrameHeader(ref out, 4, FRAME_WINDOW_UPDATE, 0, streamId)
    _writeU32(ref out, increment & MAX_WINDOW)
    return out
}

export fn encodeRstStream(streamId: i64, errorCode: i64) -> Array<u8> {
    var out = Array<u8>()
    writeFrameHeader(ref out, 4, FRAME_RST_STREAM, 0, streamId)
    _writeU32(ref out, errorCode)
    return out
}

// GOAWAY carries the highest stream this endpoint actually processed, which
// tells the peer what it may safely retry. The C sender hardcoded zero.
export fn encodeGoaway(lastStreamId: i64, errorCode: i64) -> Array<u8> {
    var out = Array<u8>()
    writeFrameHeader(ref out, 8, FRAME_GOAWAY, 0, 0)
    _writeU32(ref out, lastStreamId & MAX_WINDOW)
    _writeU32(ref out, errorCode)
    return out
}

export fn encodePingAck(payload: Array<u8>, start: i64) -> Array<u8> {
    var out = Array<u8>()
    writeFrameHeader(ref out, 8, FRAME_PING, FLAG_ACK, 0)
    for (var i = 0; i < 8; i++) { out.push(payload[start + i]) }
    return out
}

// ---- Stream state (RFC 7540 Section 5.1) ----

export enum StreamState {
    Idle,
    Open,
    HalfClosedLocal,
    HalfClosedRemote,
    Closed
}

fn _startsWithColon(s: string) -> bool {
    var b: const Slice<u8> = s.bytes()
    return len(b) > 0 && b[0] == 58
}

// RFC 7540 Section 8.1.2.4: `:status` is exactly three digits. The C reader
// accepted any prefix, so `"200abc"` became 200 and `"abc"` became 0.
fn _parseStatus(value: string) -> i64 {
    var b: const Slice<u8> = value.bytes()
    if (len(b) != 3) { return 0 }
    var status = 0
    for (var i = 0; i < 3; i++) {
        var c = b[i] as i64
        if (c < 48 || c > 57) { return 0 }
        status = status * 10 + (c - 48)
    }
    return status
}
// ---- Request target ----

// Just enough of a URL to open a connection and write the pseudo-headers:
// the authority to connect to and the path to ask for.
final class Target {
    host: string
    port: i64
    path: string
    authority: string

    constructor(host: string, port: i64, path: string, authority: string) {
        this.host = host
        this.port = port
        this.path = path
        this.authority = authority
    }
}

fn _indexOfByte(b: const Slice<u8>, needle: i64, from: i64) -> i64 {
    for (var i = from; i < len(b); i++) {
        if ((b[i] as i64) == needle) { return i }
    }
    return -1
}

fn _sliceString(b: const Slice<u8>, start: i64, end: i64) -> string {
    var out = Array<u8>(end - start)
    for (var i = start; i < end; i++) { out[i - start] = b[i] }
    return string.fromUtf8Lossy(out[:])
}

fn _parsePort(text: string) -> i64 {
    var b: const Slice<u8> = text.bytes()
    if (len(b) == 0 || len(b) > 5) {
        throw Http2Error.ProtocolError { reason: "invalid port: " + text }
    }
    var port = 0
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 48 || c > 57) {
            throw Http2Error.ProtocolError { reason: "invalid port: " + text }
        }
        port = port * 10 + (c - 48)
    }
    if (port < 1 || port > 65535) {
        throw Http2Error.ProtocolError { reason: "invalid port: " + text }
    }
    return port
}

// Parse an absolute https URL. HTTP/2 here runs over TLS only: RFC 7540
// Section 3.4's prior-knowledge cleartext mode and Section 3.2's Upgrade
// dance are both out of scope, so anything but https is refused rather than
// silently downgraded.
fn _parseTarget(url: string) -> Target {
    var b: const Slice<u8> = url.bytes()
    var schemeEnd = -1
    for (var i = 0; i + 2 < len(b); i++) {
        if ((b[i] as i64) == 58 && (b[i + 1] as i64) == 47 && (b[i + 2] as i64) == 47) {
            schemeEnd = i
            break
        }
    }
    if (schemeEnd < 0) {
        throw Http2Error.ProtocolError { reason: "URL has no scheme: " + url }
    }
    var scheme = _asciiLower(_sliceString(b, 0, schemeEnd))
    if (scheme != "https") {
        throw Http2Error.ProtocolError { reason: "HTTP/2 requires https, got: " + scheme }
    }

    var authStart = schemeEnd + 3
    var authEnd = len(b)
    for (var i = authStart; i < len(b); i++) {
        var c = b[i] as i64
        if (c == 47 || c == 63 || c == 35) { authEnd = i; break }
    }
    var authority = _sliceString(b, authStart, authEnd)
    var ab: const Slice<u8> = authority.bytes()
    if (len(ab) == 0) {
        throw Http2Error.ProtocolError { reason: "URL has no authority: " + url }
    }
    // Credentials in the authority are refused rather than forwarded.
    if (_indexOfByte(ab, 64, 0) >= 0) {
        throw Http2Error.ProtocolError { reason: "URL must not carry userinfo: " + url }
    }

    var host = authority
    var port = 443
    if ((ab[0] as i64) == 91) {
        // IPv6 literal: the colon that separates the port comes after `]`.
        var closeAt = _indexOfByte(ab, 93, 0)
        if (closeAt < 0) {
            throw Http2Error.ProtocolError { reason: "unterminated IPv6 literal: " + url }
        }
        host = _sliceString(ab, 1, closeAt)
        if (closeAt + 1 < len(ab)) {
            if ((ab[closeAt + 1] as i64) != 58) {
                throw Http2Error.ProtocolError { reason: "bad authority: " + authority }
            }
            port = _parsePort(_sliceString(ab, closeAt + 2, len(ab)))
        }
    } else {
        var colon = _indexOfByte(ab, 58, 0)
        if (colon >= 0) {
            host = _sliceString(ab, 0, colon)
            port = _parsePort(_sliceString(ab, colon + 1, len(ab)))
        }
    }
    if (len(host.bytes()) == 0) {
        throw Http2Error.ProtocolError { reason: "URL has no host: " + url }
    }

    var path = "/"
    if (authEnd < len(b)) {
        var hash = _indexOfByte(b, 35, authEnd)
        var pathEnd = hash < 0 ? len(b) : hash
        if (pathEnd > authEnd) { path = _sliceString(b, authEnd, pathEnd) }
    }
    if (len(path.bytes()) == 0) { path = "/" }
    return Target(host, port, path, authority)
}

// ---- The exchange ----

// One HTTP/2 connection carrying one request, and the state that belongs to
// both: the leaf handle, the inbound bytes not yet consumed, the HPACK
// contexts, the settings each end advertised, and the single stream.
//
// Connection and stream are one object because this module opens a
// connection per request. HPACK's dynamic table is connection state, so
// reusing a connection means carrying encoder and decoder tables between
// calls; module-level mutable state is not thread-safe
// (LANGUAGE_SPEC.md:4272), which is where those tables would have to live.
// The C implementation pooled connections and could keep the tables in C.
// Giving up the pool is what buys the tables a safe home while they live
// here; it costs a TLS handshake per request and is recorded as such.
final class Exchange {
    outbox: Array<u8>
    buf: Array<u8>
    pos: i64
    settings: Settings
    peerSettings: Settings
    decoder: HpackDecoder
    encoder: HpackEncoder
    connWindow: i64
    goawayCode: i64

    streamId: i64
    state: StreamState
    sendWindow: i64
    recvWindow: i64
    status: i64
    headers: HeaderList
    headerBytes: i64
    responseBody: Array<u8>
    resetCode: i64
    bodyPos: i64
    bodySent: bool

    constructor() {
        this.outbox = Array<u8>()
        this.buf = Array<u8>()
        this.pos = 0
        this.settings = Settings()
        this.peerSettings = Settings()
        this.decoder = HpackDecoder()
        this.encoder = HpackEncoder()
        this.connWindow = DEFAULT_INITIAL_WINDOW_SIZE
        this.goawayCode = -1

        // Client-initiated streams are odd-numbered; this connection carries
        // exactly one, so it is always stream 1.
        this.streamId = 1
        this.state = StreamState.Idle
        this.sendWindow = DEFAULT_INITIAL_WINDOW_SIZE
        this.recvWindow = DEFAULT_INITIAL_WINDOW_SIZE
        this.status = 0
        this.headers = HeaderList()
        this.headerBytes = 0
        this.responseBody = Array<u8>()
        this.resetCode = -1
        this.bodyPos = 0
        this.bodySent = false
    }

    // Queue bytes for the next flush. Nothing in this class writes to the
    // socket except `run`, which is what keeps every other method free of a
    // suspension point -- see the note on `run`.
    ref queue(bytes: Array<u8>) {
        this.outbox.appendFrom(bytes[:])
    }

    available() -> i64 { return len(this.buf) - this.pos }

    // Drop the consumed prefix once it is worth the copy, so a long response
    // does not keep a growing dead prefix alive.
    ref compact() {
        if (this.pos == 0) { return }
        if (this.pos < DEFAULT_MAX_FRAME_SIZE && this.pos * 2 < len(this.buf)) { return }
        this.buf = copy(this.buf[this.pos:len(this.buf)])
        this.pos = 0
    }

    // How many more bytes are needed before a whole frame is buffered, or 0
    // when one already is. Pure: the answer is a property of the buffer.
    frameShortfall() -> i64 {
        if (this.available() < FRAME_HEADER_SIZE) {
            return FRAME_HEADER_SIZE - this.available()
        }
        var header = readFrameHeader(this.buf, this.pos)
        if (header == null) { return FRAME_HEADER_SIZE - this.available() }
        var whole = FRAME_HEADER_SIZE + header!.length
        return this.available() < whole ? whole - this.available() : 0
    }

    // RFC 7540 Section 3.5: the preface, then this endpoint's SETTINGS,
    // before any other frame.
    ref start() {
        var opening = PREFACE.copyBytes()
        var settingsFrame = encodeClientSettings(this.settings)
        opening.appendFrom(settingsFrame[:])
        this.queue(opening)
    }

    // Build and send the HEADERS frame. The four pseudo-headers come first
    // and in this order, as RFC 7540 Section 8.1.2.1 requires.
    ref sendHeaders(target: Target, method: string, names: Array<string>,
                values: Array<string>, endStream: bool) {
        var block = Array<u8>()
        this.encoder.encodeHeader(ref block, ":method", method)
        this.encoder.encodeHeader(ref block, ":path", target.path)
        this.encoder.encodeHeader(ref block, ":scheme", "https")
        this.encoder.encodeHeader(ref block, ":authority", target.authority)
        for (var i = 0; i < len(names); i++) {
            this.encoder.encodeHeader(ref block, names[i], values[i])
        }
        // Every block this module sends fits one frame: at most 28 caller
        // headers plus four pseudo-headers, so CONTINUATION never arises on
        // the sending side.
        if (len(block) > this.peerSettings.get(SETTINGS_MAX_FRAME_SIZE)) {
            throw Http2Error.ProtocolError { reason: "header block exceeds the peer's maximum frame size" }
        }
        var flags = FLAG_END_HEADERS | (endStream ? FLAG_END_STREAM : 0)
        var out = Array<u8>()
        writeFrameHeader(ref out, len(block), FRAME_HEADERS, flags, this.streamId)
        out.appendFrom(block[:])
        this.queue(out)
        this.state = endStream ? StreamState.HalfClosedLocal : StreamState.Open
    }

    // Send whatever of the pending body the peer's windows currently allow.
    //
    // This never reads a frame. An earlier shape had it call pumpOneFrame
    // when the window closed, which reads naturally but makes one suspending
    // method call another; the compiler then could not ground the coroutine
    // state for that call site in a multi-module program and refused with
    // XR_SEM_0019 (selector=pumpOneFrame). Draining and sending are now two
    // methods that never call each other, and `run` alternates between them.
    ref pushBody(payload: Array<u8>) {
        if (this.bodySent) { return }
        var total = len(payload)
        if (total == 0) {
            // A zero-length body still has to end the stream, and an empty
            // DATA frame is how. The C sender skipped the frame but marked
            // the stream half-closed anyway, so the peer waited forever.
            var frame = Array<u8>()
            writeFrameHeader(ref frame, 0, FRAME_DATA, FLAG_END_STREAM, this.streamId)
            this.queue(frame)
            this.bodySent = true
            this.state = StreamState.HalfClosedLocal
            return
        }
        var maxFrame = this.peerSettings.get(SETTINGS_MAX_FRAME_SIZE)
        while (this.bodyPos < total) {
            var room = this.sendWindow < this.connWindow ? this.sendWindow : this.connWindow
            if (room <= 0) { return }
            var chunk = total - this.bodyPos
            if (chunk > maxFrame) { chunk = maxFrame }
            if (chunk > room) { chunk = room }
            var last = this.bodyPos + chunk >= total
            var frame = Array<u8>()
            writeFrameHeader(ref frame, chunk, FRAME_DATA, last ? FLAG_END_STREAM : 0,
                             this.streamId)
            frame.appendFrom(payload[this.bodyPos:this.bodyPos + chunk])
            this.queue(frame)
            this.sendWindow = this.sendWindow - chunk
            this.connWindow = this.connWindow - chunk
            this.bodyPos = this.bodyPos + chunk
        }
        this.bodySent = true
        this.state = StreamState.HalfClosedLocal
    }

    // Act on exactly one buffered frame. Pure: the bytes are already here.
    ref consumeOneFrame() {
        var header = readFrameHeader(this.buf, this.pos)
        if (header == null) {
            throw Http2Error.FramingError { reason: "truncated frame header" }
        }
        var h = header!
        // A peer may not send a frame larger than this endpoint advertised.
        // The C receiver allocated whatever length the peer claimed, up to
        // 16 MB, without ever comparing it to its own SETTINGS.
        if (h.length > this.settings.get(SETTINGS_MAX_FRAME_SIZE)) {
            this.queue(encodeGoaway(this.streamId, FRAME_SIZE_ERROR))
            throw Http2Error.FramingError { reason: "peer frame exceeds the advertised maximum" }
        }
        var payloadStart = this.pos + FRAME_HEADER_SIZE
        this.pos = payloadStart + h.length

        var shapeError = validateFrameHeader(h)
        if (shapeError != NO_ERROR) {
            this.queue(encodeGoaway(this.streamId, shapeError))
            throw Http2Error.FramingError { reason: "peer sent a malformed frame" }
        }
        this.handleFrame(h, payloadStart)
    }

    // Answer the payload's bounds with any padding removed.
    stripPadding(h: FrameHeader, payloadStart: i64) -> (i64, i64) {
        var start = payloadStart
        var end = payloadStart + h.length
        if (!h.hasFlag(FLAG_PADDED)) { return (start, end) }
        if (h.length < 1) {
            throw Http2Error.FramingError { reason: "padded frame has no pad length" }
        }
        var pad = this.buf[start] as i64
        start = start + 1
        if (pad > end - start) {
            throw Http2Error.FramingError { reason: "frame padding exceeds the payload" }
        }
        return (start, end - pad)
    }

    ref handleFrame(h: FrameHeader, payloadStart: i64) {
        if (h.kind == FRAME_SETTINGS) {
            if (h.hasFlag(FLAG_ACK)) { return }
            var err = applySettingsPayload(ref this.peerSettings, this.buf, payloadStart,
                                           h.length)
            if (err != NO_ERROR) {
                this.queue(encodeGoaway(this.streamId, err))
                throw Http2Error.FramingError { reason: "peer sent invalid SETTINGS" }
            }
            this.queue(encodeSettingsAck())
            return
        }
        if (h.kind == FRAME_HEADERS) {
            var bounds = this.stripPadding(h, payloadStart)
            var blockStart = bounds.0
            var blockEnd = bounds.1
            if (h.hasFlag(FLAG_PRIORITY)) {
                if (blockEnd - blockStart < 5) {
                    throw Http2Error.FramingError { reason: "HEADERS priority section is truncated" }
                }
                blockStart = blockStart + 5
            }
            if (h.streamId == this.streamId && blockEnd > blockStart) {
                var block = this.decoder.decodeRange(this.buf, blockStart, blockEnd)
                if (block == null) {
                    this.queue(encodeGoaway(this.streamId, COMPRESSION_ERROR))
                    throw Http2Error.CompressionError { reason: "could not decode the peer's header block" }
                }
                this.acceptHeaders(block!)
            }
            if (h.hasFlag(FLAG_END_STREAM) && h.streamId == this.streamId) {
                this.state = StreamState.HalfClosedRemote
            }
            return
        }
        if (h.kind == FRAME_DATA) {
            var bounds = this.stripPadding(h, payloadStart)
            if (h.streamId == this.streamId && bounds.1 > bounds.0) {
                if (len(this.responseBody) + (bounds.1 - bounds.0) > MAX_RESPONSE_BODY_BYTES) {
                    this.queue(encodeRstStream(this.streamId, ENHANCE_YOUR_CALM))
                    throw Http2Error.ProtocolError { reason: "response body exceeds the size ceiling" }
                }
                this.responseBody.appendFrom(this.buf[bounds.0:bounds.1])
            }
            if (h.length > 0) {
                // RFC 7540 Section 6.9.1 counts the whole payload, padding
                // included, against both windows.
                this.recvWindow = this.recvWindow - h.length
                this.connWindow = this.connWindow - h.length
                this.replenish()
            }
            if (h.hasFlag(FLAG_END_STREAM) && h.streamId == this.streamId) {
                this.state = StreamState.HalfClosedRemote
            }
            return
        }
        if (h.kind == FRAME_PING) {
            if (!h.hasFlag(FLAG_ACK)) { this.queue(encodePingAck(this.buf, payloadStart)) }
            return
        }
        if (h.kind == FRAME_RST_STREAM) {
            if (h.streamId == this.streamId) {
                this.resetCode = _readU32(this.buf, payloadStart)
                this.state = StreamState.Closed
            }
            return
        }
        if (h.kind == FRAME_GOAWAY) {
            // RFC 7540 Section 6.8. The C receiver ignored GOAWAY entirely
            // and kept reading until the socket broke.
            var lastStream = _readU32(this.buf, payloadStart) & MAX_WINDOW
            this.goawayCode = _readU32(this.buf, payloadStart + 4)
            if (this.streamId > lastStream || this.goawayCode != NO_ERROR) {
                if (this.resetCode < 0) { this.resetCode = this.goawayCode }
                this.state = StreamState.Closed
            }
            return
        }
        if (h.kind == FRAME_WINDOW_UPDATE) {
            this.applyWindowUpdate(h, payloadStart)
            return
        }
        // PRIORITY and anything unrecognised are ignored, as RFC 7540
        // Section 4.1 requires for unknown types.
    }

    // Give the peer room again once half the window is gone. The C receiver
    // sent two WINDOW_UPDATE frames after every DATA frame no matter how
    // small, which is two extra writes per frame.
    ref replenish() {
        if (this.connWindow < DEFAULT_INITIAL_WINDOW_SIZE / 2) {
            var bump = DEFAULT_INITIAL_WINDOW_SIZE - this.connWindow
            this.queue(encodeWindowUpdate(0, bump))
            this.connWindow = this.connWindow + bump
        }
        if (this.recvWindow < DEFAULT_INITIAL_WINDOW_SIZE / 2 &&
            this.state != StreamState.Closed) {
            var bump = DEFAULT_INITIAL_WINDOW_SIZE - this.recvWindow
            this.queue(encodeWindowUpdate(this.streamId, bump))
            this.recvWindow = this.recvWindow + bump
        }
    }

    ref applyWindowUpdate(h: FrameHeader, payloadStart: i64) {
        var inc = _readU32(this.buf, payloadStart) & MAX_WINDOW
        if (inc == 0) {
            if (h.streamId == 0) {
                this.queue(encodeGoaway(this.streamId, PROTOCOL_ERROR))
                throw Http2Error.FramingError { reason: "peer sent a zero connection window update" }
            }
            this.queue(encodeRstStream(h.streamId, PROTOCOL_ERROR))
            if (h.streamId == this.streamId) { this.state = StreamState.Closed }
            return
        }
        if (h.streamId == 0) {
            if (this.connWindow + inc > MAX_WINDOW) {
                this.queue(encodeGoaway(this.streamId, FLOW_CONTROL_ERROR))
                throw Http2Error.FramingError { reason: "connection window overflowed" }
            }
            this.connWindow = this.connWindow + inc
            return
        }
        if (h.streamId == this.streamId) {
            if (this.sendWindow + inc > MAX_WINDOW) {
                this.queue(encodeRstStream(this.streamId, FLOW_CONTROL_ERROR))
                throw Http2Error.FramingError { reason: "stream window overflowed" }
            }
            this.sendWindow = this.sendWindow + inc
        }
    }

    // Take one decoded block onto the stream. `:status` becomes the response
    // status; the remaining pseudo-headers are not part of the header list a
    // caller sees. The ceilings bound what one response may cost regardless
    // of what the peer sends.
    ref acceptHeaders(block: HeaderList) {
        for (var i = 0; i < block.count(); i++) {
            var name = block.names[i]
            var value = block.values[i]
            if (name == ":status") {
                this.status = _parseStatus(value)
                continue
            }
            if (len(name.bytes()) == 0 || _startsWithColon(name)) { continue }
            if (this.headers.count() >= MAX_RESPONSE_HEADERS) {
                throw Http2Error.ProtocolError { reason: "response has too many headers" }
            }
            var cost = len(name.bytes()) + len(value.bytes())
            if (this.headerBytes + cost > MAX_RESPONSE_HEADER_BYTES) {
                throw Http2Error.ProtocolError { reason: "response headers exceed the size ceiling" }
            }
            this.headerBytes = this.headerBytes + cost
            this.headers.add(name, value)
        }
    }
}

// ---- Public surface ----

// HTTP/2 needs TLS but no additional host capability beyond net's provider.
export fn supported() -> bool { return net.hasTLS() }

// Run the exchange on an already-open connection. Split out so that the
// caller can close the handle on every path without a `defer`, which cannot
// hold a suspending call.
// Drive one exchange to completion.
//
// The loop lives here rather than on Exchange because every socket call has
// to sit in one function that no other suspending function calls: the
// semantic-plan verifier cannot ground the coroutine state for a suspending
// method that calls another suspending method, and refuses the whole module
// with XR_SEM_0019 naming the inner call. Exchange therefore holds only pure
// arithmetic over `outbox` and `buf`, and this function is the only place
// bytes cross the boundary. `ex` is a local, so its fields stay writable
// here; a borrowed parameter would not be.
fn _exchange(conn: NetConn, target: Target, method: string, names: Array<string>,
             values: Array<string>, body: Array<u8>) ->
             (i64, Array<string>, Array<string>, Array<u8>) {
    var ex = Exchange()
    ex.start()
    var hasBody = len(body) > 0
    ex.sendHeaders(target, method, names, values, !hasBody)
    ex.bodySent = !hasBody

    var frames = 0
    while (true) {
        ex.pushBody(body)
        if (len(ex.outbox) > 0) {
            var count = net.writeBytes(conn, ex.outbox)
            if (count != len(ex.outbox)) {
                throw Http2Error.ConnectionFailed { target: "write failed" }
            }
            ex.outbox = Array<u8>()
        }
        if (ex.state == StreamState.Closed ||
            ex.state == StreamState.HalfClosedRemote) {
            break
        }
        ex.compact()
        while (ex.frameShortfall() > 0) {
            var chunk = Array<u8>(DEFAULT_MAX_FRAME_SIZE)
            var received = net.readInto(conn, ref chunk, DEFAULT_MAX_FRAME_SIZE)
            if (received < 0) {
                throw Http2Error.ConnectionFailed { target: "read failed" }
            }
            if (received == 0) {
                throw Http2Error.ConnectionFailed { target: "connection closed before the response ended" }
            }
            ex.buf.appendFrom(chunk[:])
        }
        ex.consumeOneFrame()
        frames = frames + 1
        if (frames > MAX_FRAMES_PER_REQUEST) {
            throw Http2Error.ConnectionFailed { target: "peer never ended the response stream" }
        }
    }

    if (ex.resetCode > 0) {
        // A reset stream has no response. The C client reported one anyway,
        // as HTTP 200 with an empty body.
        throw Http2Error.ConnectionFailed { target: "stream reset by peer with code " +
                                          string(ex.resetCode) }
    }
    if (ex.status == 0) {
        throw Http2Error.ProtocolError { reason: "response carried no valid :status" }
    }
    return (ex.status, ex.headers.names, ex.headers.values, ex.responseBody)
}

fn _connect(host: string, port: i64, timeoutMs: i64) -> NetConn {
    if (!net.hasTLS()) { throw Http2Error.TlsUnavailable }
    var conn: NetConn? = null
    try {
        var protocols: Array<string> = [H2_ALPN]
        conn = net.dialTLS(host, port, timeoutMs, protocols)
        var live = conn!
        if (net.negotiatedProtocol(live) != H2_ALPN) {
            net.close(live)
            throw Http2Error.FramingError { reason: "peer did not negotiate HTTP/2" }
        }
        if (!net.setDeadline(live, time.monotonic() + timeoutMs)) {
            net.close(live)
            throw Http2Error.ConnectionFailed { target: host }
        }
        return live
    } catch (e: NetError) {
        if (conn != null) { net.close(conn!) }
        throw Http2Error.ConnectionFailed { target: host }
    }
}

// Execute one HTTP/2 request and answer (status, headerNames, headerValues,
// body). The two header arrays are parallel: entry i of `headerNames` pairs
// with entry i of `headerValues`.
//
// Everything but the generic net transport happens here: this validates the
// request, encodes it, moves bytes through NetConn, and decodes the response.
// Every refusal leaves through Http2Error, so one bad input has one name.
//
export fn request(url: string, method: string, headerNames: Array<string>,
                  headerValues: Array<string>, body: Array<u8>,
                  timeoutMs: i64) -> (i64, Array<string>, Array<string>, Array<u8>) {
    _validateRequest(method, headerNames, headerValues)
    if (timeoutMs <= 0 || timeoutMs > MAX_TRANSPORT_TIMEOUT_MS) {
        throw Http2Error.ProtocolError { reason: "timeout is outside the transport range" }
    }
    var target = _parseTarget(url)

    var host = target.host
    var port = target.port
    var conn = _connect(host, port, timeoutMs)
    try {
        var answer = _exchange(conn, target, method, headerNames, headerValues, body)
        net.close(conn)
        return answer
    } catch (e) {
        net.close(conn)
        throw e
    }
}
