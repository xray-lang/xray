// _probe — pure-Xray stdlib module capability matrix (task 148 phase 0 item 5).
//
// This module intentionally exercises every export shape a migrated stdlib
// module can use, so tests/diff can pin VM/AOT parity for each of them:
//   * module-level functions (named import + namespace call)
//   * module-level values/constants
//   * variadic functions
//   * exported functions that use closure/defer internally
//   * a plain class, and functions constructing/consuming that class
//   * static methods and generic class methods with closure-taking bodies
// Keep it tiny: it ships in every binary as the permanent compiler gate.

let probeSeed = 148

// --- module-level functions (gap B: slot_funcs direct call) ---

fn probeAdd(a: int, b: int) -> int {
    return a + b
}

fn probeConcat(a: string, b: string) -> string {
    return a + "|" + b
}

// --- variadic function (gap A: rest-parameter ABI) ---
fn probeSum(...nums: int) -> int {
    let total = 0
    for (let i = 0; i < nums.length; i++) {
        total = total + nums[i]
    }
    return total
}

// --- closure + defer in exported module functions (T3.4 permanent guard) ---

fn probeDeferValue(base: int) -> int {
    let total = base
    {
        defer { total = total + 7 }
        total = total + 1
    }
    return total
}

fn probeMakeAdder(base: int) -> (int) -> int {
    return fn(v: int) -> int {
        return base + v
    }
}

fn probeApply(value: int, body: (int) -> int) -> int {
    return body(value)
}

// --- class + functions using it (gap C: intra-module class/function mix) ---

class ProbeBox {
    label: string
    count: int

    constructor(label: string, count: int) {
        this.label = label
        this.count = count
    }

    describe() -> string {
        return this.label + ":" + this.count.toString()
    }

    static tagged(label: string, count: int) -> ProbeBox {
        return ProbeBox("tag:" + label, count)
    }
}

fn probeMakeBox(label: string, count: int) -> ProbeBox {
    return ProbeBox(label, count)
}

fn probeReadBox(box: ProbeBox) -> string {
    return box.describe()
}

// --- generic class with closure-taking method (sync-shape regression) ---

class ProbeCell<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    map<U>(body: (T) -> U) -> U {
        return body(this.value)
    }
}

class ProbeBag {
    boxes: Array<ProbeBox>

    constructor(boxes: Array<ProbeBox>) {
        this.boxes = boxes
    }

    labels() -> string {
        let out: Array<string> = []
        for (let i = 0; i < this.boxes.length; i++) {
            out.push(this.boxes[i].describe())
        }
        return out.join("|")
    }
}

fn probeMakeBag() -> ProbeBag {
    return ProbeBag([ProbeBox("a", 1), ProbeBox.tagged("b", 2)])
}

export {
    probeSeed,
    probeAdd,
    probeConcat,
    probeSum,
    probeDeferValue,
    probeMakeAdder,
    probeApply,
    ProbeBox,
    probeMakeBox,
    probeReadBox,
    ProbeCell,
    ProbeBag,
    probeMakeBag
}
