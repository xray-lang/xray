// _probe — pure-Xray stdlib module capability matrix (task 148 phase 0 item 5).
//
// This module intentionally exercises every export shape a migrated stdlib
// module can use, so tests/diff can pin VM/AOT parity for each of them:
//   * module-level functions (named import + namespace call)
//   * module-level values/constants
//   * variadic functions
//   * exported functions that use closures and static cleanup internally
//   * a plain class, and functions constructing/consuming that class
//   * static methods and generic class methods with closure-taking bodies
// Keep it tiny: it ships in every binary as the permanent compiler gate.

export const probeSeed = 148

// --- module-level functions (gap B: slot_funcs direct call) ---

export fn probeAdd(a: i64, b: i64) -> i64 {
    return a + b
}

export fn probeConcat(a: string, b: string) -> string {
    return a + "|" + b
}

// --- variadic function (gap A: rest-parameter ABI) ---
export fn probeSum(...nums: i64) -> i64 {
    var total = 0
    for (var i = 0; i < len(nums); i++) {
        total = total + nums[i]
    }
    return total
}

// --- closure and static cleanup in exported module functions (T3.4 permanent guard) ---

export fn probeDeferValue(base: i64) -> i64 {
    var total = base
    {
        defer { total = total + 7 }
        total = total + 1
    }
    return total
}

export fn probeMakeAdder(base: i64) -> fn(i64) -> i64 {
    return fn(v: i64) -> i64 {
        return base + v
    }
}

export fn probeApply(value: i64, body: fn(i64) -> i64) -> i64 {
    return body(value)
}

// --- class + functions using it (gap C: intra-module class/function mix) ---

export class ProbeBox {
    label: string
    count: i64

    constructor(label: string, count: i64) {
        this.label = label
        this.count = count
    }

    describe() -> string {
        return this.label + ":" + this.count.toString()
    }

    static tagged(label: string, count: i64) -> ProbeBox {
        return ProbeBox("tag:" + label, count)
    }
}

export fn probeMakeBox(label: string, count: i64) -> ProbeBox {
    return ProbeBox(label, count)
}

export fn probeReadBox(box: ProbeBox) -> string {
    return box.describe()
}

// --- generic class with closure-taking method (sync-shape regression) ---

export class ProbeCell<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    map<U>(body: fn(T) -> U) -> U {
        return body(this.value)
    }
}

export class ProbeBag {
    boxes: Array<ProbeBox>

    constructor(boxes: Array<ProbeBox>) {
        this.boxes = boxes
    }

    labels() -> string {
        var out: Array<string> = []
        for (var i = 0; i < len(this.boxes); i++) {
            out.push(this.boxes[i].describe())
        }
        return out.join("|")
    }
}

export fn probeMakeBag() -> ProbeBag {
    return ProbeBag([ProbeBox("a", 1), ProbeBox.tagged("b", 2)])
}
