// http - pure-Xray HTTP helpers and HTTP/1.x client/server control plane.
//
// Socket/TLS primitives and HTTP/2 data-plane remain native runtime boundaries.
// Public HTTP/1.x request/response formatting, client, routing, and server
// dispatch live here.

import { encode, decodeForm, parse as parseUrl, parseQuery, resolve as resolveUrl } from url
import crypto
import io
import net
import time

const COOKIE_MAX_INPUT_LEN = 8192
const COOKIE_SECONDS_PER_DAY = 86400
const HTTP_DEFAULT_TIMEOUT_MS = 30000
const HTTP_MAX_RESPONSE_BYTES = 104857600
const HTTP_SERVER_MAX_BODY_BYTES = 1048576
const HTTP_SERVER_READ_CHUNK_BYTES = 8192
const HTTP_SERVER_ACCEPT_POLL_MS = 100
const HTTP_SERVER_BACKLOG = 1024

fn _floorDiv(a: int, b: int) -> int {
    var q = a / b
    var r = a % b
    if (r < 0) { q = q - 1 }
    return q
}

fn _daysFromCivil(year: int, month: int, day: int) -> int {
    var y = year
    if (month <= 2) { y = y - 1 }
    var era = _floorDiv(y, 400)
    var yoe = y - era * 400
    var mp = month + 9
    if (month > 2) { mp = month - 3 }
    var doy = (153 * mp + 2) / 5 + day - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn _timeFromCivil(year: int, month: int, day: int, hour: int, minute: int, second: int) -> int {
    return _daysFromCivil(year, month, day) * COOKIE_SECONDS_PER_DAY + hour * 3600 +
           minute * 60 + second
}

fn _parseIntStrict(s: string) -> int? {
    var t = s.trim()
    if (len(t) == 0) { return null }
    var sign = 1
    var i = 0
    if (t.charAt(0) == "-") {
        sign = -1
        i = 1
    } else if (t.charAt(0) == "+") {
        i = 1
    }
    if (i >= len(t)) { return null }
    var out = 0
    while (i < len(t)) {
        var c = t.charAt(i).ord()!
        if (c < 48 || c > 57) { return null }
        out = out * 10 + (c - 48)
        i = i + 1
    }
    return sign * out
}

fn _splitWs(s: string) -> Array<string> {
    var out: Array<string> = []
    var i = 0
    while (i < len(s)) {
        while (i < len(s) && (s.charAt(i) == " " || s.charAt(i) == "\t")) {
            i = i + 1
        }
        var start = i
        while (i < len(s) && s.charAt(i) != " " && s.charAt(i) != "\t") {
            i = i + 1
        }
        if (i > start) { out.push(s.slice(start, i)) }
    }
    return out
}

fn _monthNumber(raw: string) -> int {
    var m = raw.toLowerCase()
    if (m == "jan") { return 1 }
    if (m == "feb") { return 2 }
    if (m == "mar") { return 3 }
    if (m == "apr") { return 4 }
    if (m == "may") { return 5 }
    if (m == "jun") { return 6 }
    if (m == "jul") { return 7 }
    if (m == "aug") { return 8 }
    if (m == "sep") { return 9 }
    if (m == "oct") { return 10 }
    if (m == "nov") { return 11 }
    if (m == "dec") { return 12 }
    return 0
}

fn _parseHms(raw: string) -> Array<int>? {
    var parts = raw.split(":")
    if (len(parts) < 2 || len(parts) > 3) { return null }
    var h = _parseIntStrict(parts[0])
    var m = _parseIntStrict(parts[1])
    var s = 0
    if (len(parts) == 3) {
        var ss = _parseIntStrict(parts[2])
        if (ss == null) { return null }
        s = ss!
    }
    if (h == null || m == null) { return null }
    if (h! < 0 || h! > 23 || m! < 0 || m! > 59 || s < 0 || s > 60) { return null }
    return [h!, m!, s]
}

fn _dateTimestamp(year: int, month: int, day: int, hmsRaw: string) -> int? {
    var hms = _parseHms(hmsRaw)
    if (hms == null) { return null }
    if (year < 1601 || month < 1 || month > 12 || day < 1 || day > 31) { return null }
    return _timeFromCivil(year, month, day, hms![0], hms![1], hms![2])
}

fn _twoDigitCookieYear(y: int) -> int {
    if (y >= 0 && y <= 68) { return 2000 + y }
    if (y >= 69 && y <= 99) { return 1900 + y }
    return y
}

fn _parseCookieDate(raw: string) -> int {
    var tokens = _splitWs(raw.trim())
    if (len(tokens) >= 5 && tokens[0].endsWith(",")) {
        var day = _parseIntStrict(tokens[1])
        var month = _monthNumber(tokens[2])
        var year = _parseIntStrict(tokens[3])
        if (day != null && year != null && month > 0) {
            var ts = _dateTimestamp(year!, month, day!, tokens[4])
            if (ts != null) { return ts! }
        }
    }

    if (len(tokens) >= 3 && tokens[0].endsWith(",")) {
        var dateParts = tokens[1].split("-")
        if (len(dateParts) == 3) {
            var day2 = _parseIntStrict(dateParts[0])
            var month2 = _monthNumber(dateParts[1])
            var year2 = _parseIntStrict(dateParts[2])
            if (day2 != null && year2 != null && month2 > 0) {
                var ts2 = _dateTimestamp(_twoDigitCookieYear(year2!), month2, day2!, tokens[2])
                if (ts2 != null) { return ts2! }
            }
        }
    }

    if (len(tokens) >= 5) {
        var month3 = _monthNumber(tokens[1])
        var day3 = _parseIntStrict(tokens[2])
        var year3 = _parseIntStrict(tokens[4])
        if (day3 != null && year3 != null && month3 > 0) {
            var ts3 = _dateTimestamp(year3!, month3, day3!, tokens[3])
            if (ts3 != null) { return ts3! }
        }
    }

    return 0
}

fn _defaultCookiePath(requestPath: string) -> string {
    if (len(requestPath) == 0 || requestPath.charAt(0) != "/") { return "/" }
    var last = requestPath.lastIndexOf("/")
    if (last <= 0) { return "/" }
    return requestPath.slice(0, last)
}

fn _domainMatches(cookieDomain: string, requestDomain: string) -> bool {
    if (len(cookieDomain) == 0 || len(requestDomain) == 0) { return false }
    var cd = cookieDomain.toLowerCase()
    if (cd.startsWith(".")) { cd = cd.slice(1) }
    var rd = requestDomain.toLowerCase()
    if (cd == rd) { return true }
    return len(rd) > len(cd) + 1 &&
           rd.endsWith("." + cd)
}

fn _pathMatches(cookiePath: string, requestPath: string) -> bool {
    if (len(cookiePath) == 0 || len(requestPath) == 0) { return true }
    if (!requestPath.startsWith(cookiePath)) { return false }
    if (len(requestPath) == len(cookiePath)) { return true }
    if (cookiePath.endsWith("/")) { return true }
    return requestPath.charAt(len(cookiePath)) == "/"
}

fn _sameCookie(a: Cookie, b: Cookie) -> bool {
    return a.name == b.name &&
           a.domain.toLowerCase() == b.domain.toLowerCase() &&
           a.path == b.path
}

fn _cookieNow(nowSeconds: int) -> int {
    if (nowSeconds > 0) { return nowSeconds }
    return time.now() / 1000
}

class Cookie {
    name: string
    value: string
    domain: string
    path: string
    expires: int
    secure: bool
    httpOnly: bool
    sameSite: string
    hostOnly: bool

    constructor(
        name: string,
        value: string,
        domain: string,
        path: string,
        expires: int = 0,
        secure: bool = false,
        httpOnly: bool = false,
        sameSite: string = "",
        hostOnly: bool = false
    ) {
        this.name = name
        this.value = value
        this.domain = domain
        this.path = path
        this.expires = expires
        this.secure = secure
        this.httpOnly = httpOnly
        this.sameSite = sameSite
        this.hostOnly = hostOnly
    }

    isExpired(nowSeconds: int = 0) -> bool {
        return this.expires > 0 && this.expires <= _cookieNow(nowSeconds)
    }

    matches(domain: string, path: string, isSecure: bool = false, nowSeconds: int = 0) -> bool {
        if (this.isExpired(nowSeconds)) { return false }
        if (this.hostOnly) {
            if (this.domain.toLowerCase() != domain.toLowerCase()) { return false }
        } else if (!_domainMatches(this.domain, domain)) {
            return false
        }
        if (!_pathMatches(this.path, path)) { return false }
        if (this.secure && !isSecure) { return false }
        return true
    }

    serialize() -> string {
        return this.name + "=" + this.value
    }
}

class CookieJar {
    cookies: Array<Cookie>
    maxCookies: int

    constructor(maxCookies: int = 300) {
        this.cookies = []
        this.maxCookies = maxCookies
    }

    count: int { fn() { return len(this.cookies) } }

    add(cookie: Cookie, nowSeconds: int = 0) {
        var now = _cookieNow(nowSeconds)
        var next: Array<Cookie> = []
        var replaced = false
        for (var i = 0; i < len(this.cookies); i++) {
            var existing = this.cookies[i]
            if (_sameCookie(existing, cookie)) {
                replaced = true
            } else if (!existing.isExpired(now)) {
                next.push(existing)
            }
        }
        if (!cookie.isExpired(now)) {
            next.push(cookie)
        } else if (!replaced) {
            // Expired Set-Cookie with no matching entry is simply ignored.
        }
        while (this.maxCookies > 0 && len(next) > this.maxCookies) {
            next.shift()
        }
        this.cookies = next
    }

    addFromResponse(setCookieHeaders: Array<string>, requestDomain: string, requestPath: string, nowSeconds: int = 0) {
        var now = _cookieNow(nowSeconds)
        for (var i = 0; i < len(setCookieHeaders); i++) {
            var cookie = parseSetCookie(setCookieHeaders[i], requestDomain, requestPath, now)
            if (cookie != null) { this.add(cookie!, now) }
        }
    }

    getHeader(domain: string, path: string, isSecure: bool = false, nowSeconds: int = 0) -> string? {
        var now = _cookieNow(nowSeconds)
        var out = StringBuilder()
        var first = true
        for (var i = 0; i < len(this.cookies); i++) {
            var c = this.cookies[i]
            if (!c.matches(domain, path, isSecure, now)) { continue }
            if (!first) { out.append("; ") }
            out.append(c.serialize())
            first = false
        }
        if (first) { return null }
        return out.toString()
    }

    cleanup(nowSeconds: int = 0) {
        var now = _cookieNow(nowSeconds)
        var next: Array<Cookie> = []
        for (var i = 0; i < len(this.cookies); i++) {
            var c = this.cookies[i]
            if (!c.isExpired(now)) { next.push(c) }
        }
        this.cookies = next
    }

    clearDomain(domain: string) {
        var target = domain.toLowerCase()
        var next: Array<Cookie> = []
        for (var i = 0; i < len(this.cookies); i++) {
            var c = this.cookies[i]
            if (c.domain.toLowerCase() != target) { next.push(c) }
        }
        this.cookies = next
    }

    clear() {
        this.cookies = []
    }
}

fn parseSetCookie(header: string, requestDomain: string = "", requestPath: string = "/",
                  nowSeconds: int = 0) -> Cookie? {
    var now = _cookieNow(nowSeconds)
    if (len(header) == 0 || header.byteLength > COOKIE_MAX_INPUT_LEN) { return null }
    var parts = header.split(";")
    if (len(parts) == 0) { return null }
    var first = parts[0]
    var eq = first.indexOf("=")
    if (eq < 0) { return null }
    var name = first.slice(0, eq).trim()
    var value = first.slice(eq + 1).trim()
    if (len(name) == 0) { return null }

    var domain = requestDomain
    var path = _defaultCookiePath(requestPath)
    var expires = 0
    var secure = false
    var httpOnly = false
    var sameSite = ""
    var hostOnly = true

    for (var i = 1; i < len(parts); i++) {
        var attr = parts[i].trim()
        if (len(attr) == 0) { continue }
        var attrEq = attr.indexOf("=")
        var attrName = attr
        var attrValue = ""
        if (attrEq >= 0) {
            attrName = attr.slice(0, attrEq).trim()
            attrValue = attr.slice(attrEq + 1).trim()
        }
        var key = attrName.toLowerCase()
        if (key == "domain" && len(attrValue) > 0) {
            domain = attrValue
            if (domain.startsWith(".")) { domain = domain.slice(1) }
            if (!_domainMatches(domain, requestDomain)) { return null }
            hostOnly = false
        } else if (key == "path" && len(attrValue) > 0) {
            path = attrValue
        } else if (key == "expires" && len(attrValue) > 0) {
            expires = _parseCookieDate(attrValue)
        } else if (key == "max-age" && len(attrValue) > 0) {
            var delta = _parseIntStrict(attrValue)
            if (delta != null) { expires = now + delta! }
        } else if (key == "secure") {
            secure = true
        } else if (key == "httponly") {
            httpOnly = true
        } else if (key == "samesite" && len(attrValue) > 0) {
            var ss = attrValue.toLowerCase()
            if (ss == "strict") {
                sameSite = "Strict"
            } else if (ss == "lax") {
                sameSite = "Lax"
            } else if (ss == "none") {
                sameSite = "None"
            }
        }
    }

    if (sameSite == "None" && !secure) { return null }
    return Cookie(name, value, domain, path, expires, secure, httpOnly, sameSite, hostOnly)
}

fn cookieJar(maxCookies: int = 300) -> CookieJar {
    return CookieJar(maxCookies)
}

class _FormField {
    kind: string
    name: string
    value: string
    filename: string
    contentType: string

    constructor(
        kind: string,
        name: string,
        value: string,
        filename: string,
        contentType: string
    ) {
        this.kind = kind
        this.name = name
        this.value = value
        this.filename = filename
        this.contentType = contentType
    }
}

fn _normalizeLimit(limit: int) -> int {
    if (limit <= 0) { return 0 }
    return limit
}

fn _limitExceeded(limit: int, current: int, added: int) -> bool {
    return limit > 0 && current + added > limit
}

fn _boundary() -> string {
    return "----XrayFormBoundary" + crypto.randomBytes(16)
}

fn _basename(path: string) -> string {
    var start = 0
    for (var i = 0; i < len(path); i++) {
        var c = path.charAt(i)
        if (c == "/" || c == "\\") { start = i + 1 }
    }
    return path.slice(start)
}

fn _guessMimeType(filename: string) -> string {
    var dot = filename.lastIndexOf(".")
    if (dot < 0 || dot + 1 >= len(filename)) {
        return "application/octet-stream"
    }

    var ext = filename.slice(dot + 1).toLowerCase()
    if (ext == "txt") { return "text/plain" }
    if (ext == "html" || ext == "htm") { return "text/html" }
    if (ext == "css") { return "text/css" }
    if (ext == "js") { return "application/javascript" }
    if (ext == "json") { return "application/json" }
    if (ext == "xml") { return "application/xml" }
    if (ext == "pdf") { return "application/pdf" }
    if (ext == "zip") { return "application/zip" }
    if (ext == "gz") { return "application/gzip" }
    if (ext == "tar") { return "application/x-tar" }
    if (ext == "png") { return "image/png" }
    if (ext == "jpg" || ext == "jpeg") { return "image/jpeg" }
    if (ext == "gif") { return "image/gif" }
    if (ext == "svg") { return "image/svg+xml" }
    if (ext == "ico") { return "image/x-icon" }
    if (ext == "mp3") { return "audio/mpeg" }
    if (ext == "mp4") { return "video/mp4" }
    if (ext == "webm") { return "video/webm" }
    return "application/octet-stream"
}

fn _headerParam(s: string) -> string {
    var out = StringBuilder()
    for (var i = 0; i < len(s); i++) {
        var c = s.charAt(i)
        if (c == "\"") {
            out.append("\\\"")
        } else if (c == "\\") {
            out.append("\\\\")
        } else if (c == "\r" || c == "\n") {
            out.append("_")
        } else {
            out.append(c)
        }
    }
    return out.toString()
}

fn _routeMethodKey(method: string) -> string {
    return method.trim().toLowerCase()
}

fn _routePathOnly(path: string) -> string {
    var q = path.indexOf("?")
    if (q >= 0) { return path.slice(0, q) }
    return path
}

fn _routeValidPath(path: string) -> bool {
    return len(path) > 0 && path.charAt(0) == "/"
}

fn _routeSegments(path: string) -> Array<string> {
    var clean = _routePathOnly(path)
    if (clean == "/" || len(clean) == 0) { return [] }
    if (clean.charAt(0) == "/") { clean = clean.slice(1) }
    return clean.split("/")
}

fn _routeWildcardName(seg: string) -> string? {
    if (len(seg) > 1 && seg.charAt(0) == "*") { return seg.slice(1) }
    if (len(seg) > 3 && seg.startsWith("{*") && seg.endsWith("}")) {
        return seg.slice(2, len(seg) - 1)
    }
    return null
}

fn _routeParamName(seg: string) -> string? {
    if (len(seg) > 1 && seg.charAt(0) == ":") { return seg.slice(1) }
    return null
}

fn _routePatternValid(pattern: string) -> bool {
    if (!_routeValidPath(pattern) || pattern.indexOf("?") >= 0) { return false }
    var segs = _routeSegments(pattern)
    for (var i = 0; i < len(segs); i++) {
        var wildcard = _routeWildcardName(segs[i])
        if (wildcard != null) {
            return len(wildcard!) > 0 && i == len(segs) - 1
        }
        var param = _routeParamName(segs[i])
        if (param != null && len(param!) == 0) { return false }
    }
    return true
}

fn _routePatternIsStatic(pattern: string) -> bool {
    var segs = _routeSegments(pattern)
    for (var i = 0; i < len(segs); i++) {
        if (_routeWildcardName(segs[i]) != null || _routeParamName(segs[i]) != null) {
            return false
        }
    }
    return true
}

fn _joinRouteTail(segs: Array<string>, start: int) -> string {
    var out = StringBuilder()
    for (var i = start; i < len(segs); i++) {
        if (i > start) { out.append("/") }
        out.append(segs[i])
    }
    return out.toString()
}

fn _matchRoutePath(pattern: string, path: string) -> Json {
    var pSegs = _routeSegments(pattern)
    var vSegs = _routeSegments(path)
    var params: Json = {}
    var i = 0
    var j = 0

    while (i < len(pSegs)) {
        var p = pSegs[i]
        var wildcard = _routeWildcardName(p)
        if (wildcard != null) {
            params[wildcard!] = _joinRouteTail(vSegs, j)
            return params
        }

        if (j >= len(vSegs)) { return null }

        var param = _routeParamName(p)
        if (param != null) {
            if (len(vSegs[j]) == 0) { return null }
            params[param!] = vSegs[j]
        } else if (p != vSegs[j]) {
            return null
        }
        i = i + 1
        j = j + 1
    }

    if (j != len(vSegs)) { return null }
    return params
}

class RouteMatch {
    value: unknown
    params: Json

    constructor(value: unknown, params: Json) {
        this.value = value
        this.params = params
    }
}

class _RouteEntry {
    method: string
    path: string
    value: unknown

    constructor(method: string, path: string, value: unknown) {
        this.method = method
        this.path = path
        this.value = value
    }
}

class Router {
    private routes: Array<_RouteEntry>

    constructor() {
        this.routes = []
    }

    add(method: string, path: string, value: unknown) -> bool {
        var m = _routeMethodKey(method)
        if (len(m) == 0 || !_routePatternValid(path)) { return false }
        for (var i = 0; i < len(this.routes); i++) {
            var entry = this.routes[i]
            if (entry.method == m && entry.path == path) {
                this.routes[i] = _RouteEntry(m, path, value)
                return true
            }
        }
        this.routes.push(_RouteEntry(m, path, value))
        return true
    }

    find(method: string, path: string) -> RouteMatch? {
        var m = _routeMethodKey(method)
        if (len(m) == 0 || !_routeValidPath(path)) { return null }

        var dynamicMatch: RouteMatch? = null
        for (var i = 0; i < len(this.routes); i++) {
            var entry = this.routes[i]
            if (entry.method != m) { continue }
            var params = _matchRoutePath(entry.path, path)
            if (params != null) {
                var found = RouteMatch(entry.value, params)
                if (_routePatternIsStatic(entry.path)) { return found }
                if (dynamicMatch == null) { dynamicMatch = found }
            }
        }
        return dynamicMatch
    }
}

fn router() -> Router {
    return Router()
}

class _RouteHandler {
    handler: (Json) -> unknown

    constructor(handler: (Json) -> unknown) {
        this.handler = handler
    }
}

class _ServerRouteMatch {
    value: unknown
    handler: _RouteHandler?
    params: Json

    constructor(value: unknown, params: Json, handler: _RouteHandler? = null) {
        this.value = value
        this.params = params
        this.handler = handler
    }
}

class _ServerRouteEntry {
    method: string
    path: string
    value: unknown
    handler: _RouteHandler?

    constructor(method: string, path: string, value: unknown, handler: _RouteHandler? = null) {
        this.method = method
        this.path = path
        this.value = value
        this.handler = handler
    }
}

class _ServerRouter {
    routes: Array<_ServerRouteEntry>

    constructor() {
        this.routes = []
    }

    add(method: string, path: string, value: unknown) -> bool {
        return this.addRoute(method, path, value, null)
    }

    addRoute(method: string, path: string, value: unknown, handler: _RouteHandler?) -> bool {
        var m = _routeMethodKey(method)
        if (len(m) == 0 || !_routePatternValid(path)) { return false }
        for (var i = 0; i < len(this.routes); i++) {
            var entry = this.routes[i]
            if (entry.method == m && entry.path == path) {
                this.routes[i] = _ServerRouteEntry(m, path, value, handler)
                return true
            }
        }
        this.routes.push(_ServerRouteEntry(m, path, value, handler))
        return true
    }

    find(method: string, path: string) -> _ServerRouteMatch? {
        var m = _routeMethodKey(method)
        if (len(m) == 0 || !_routeValidPath(path)) { return null }

        var dynamicMatch: _ServerRouteMatch? = null
        for (var i = 0; i < len(this.routes); i++) {
            var entry = this.routes[i]
            if (entry.method != m) { continue }
            var params = _matchRoutePath(entry.path, path)
            if (params != null) {
                var found = _ServerRouteMatch(entry.value, params, entry.handler)
                if (_routePatternIsStatic(entry.path)) { return found }
                if (dynamicMatch == null) { dynamicMatch = found }
            }
        }
        return dynamicMatch
    }
}

var _serverRouter = _ServerRouter()
var _serverRunning = false
var _serverListener: NetListener? = null

fn route(method: string, path: string, handler: unknown) {
    if (typeName(handler) == "function") {
        _serverRouter.addRoute(method, path, handler, _RouteHandler(handler as (Json) -> unknown))
        return
    }
    _serverRouter.add(method, path, handler)
}

fn _serverTargetPath(target: string) -> string {
    var q = target.indexOf("?")
    if (q >= 0) { return target.slice(0, q) }
    return target
}

fn _serverTargetQuery(target: string) -> Json {
    var q = target.indexOf("?")
    if (q < 0) {
        var empty: Json = {}
        return empty
    }
    return parseQuery(target.slice(q + 1))
}

fn _serverRequestJson(msg: RequestMessage, params: Json) -> Json {
    var req: Json = {}
    req["method"] = msg.head.method
    req["path"] = _serverTargetPath(msg.head.target)
    req["query"] = _serverTargetQuery(msg.head.target)
    req["headers"] = msg.head.headers
    req["body"] = msg.body
    req["contentLength"] = msg.head.contentLength
    req["params"] = params
    return req
}

fn _serverStatusResponse(status: int, body: string, keepAlive: bool = false) -> string {
    var text = responseText(status, body, "text/plain; charset=utf-8", null, keepAlive)
    if (text != null) { return text! }
    return "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 21\r\nConnection: close\r\n\r\nInternal Server Error"
}

fn _serverHeadersFrom(value: unknown) -> Json {
    if (value == null) { return null }
    var encoded = Json.encode(value)
    if (typeName(encoded) == "Json") { return encoded }
    return null
}

fn _serverArrayResponse(value: unknown, keepAlive: bool) -> string {
    var arr = value as Array
    var status = 200
    var contentType = "text/plain; charset=utf-8"
    var body = ""
    var headers: Json = null

    if (len(arr) >= 1 && typeName(arr[0]) == "int") { status = int(arr[0]) }
    if (len(arr) >= 2 && typeName(arr[1]) == "string") { contentType = string(arr[1]) }
    if (len(arr) >= 3 && arr[2] != null) { body = string(arr[2]) }
    if (len(arr) >= 4) { headers = _serverHeadersFrom(arr[3]) }

    var text = responseText(status, body, contentType, headers, keepAlive)
    if (text != null) { return text! }
    return _serverStatusResponse(500, "Internal Server Error", false)
}

fn _serverResponseFor(value: unknown, keepAlive: bool) -> string {
    var kind = typeName(value)
    if (kind == "null") { return _serverStatusResponse(204, "", keepAlive) }
    if (kind == "Array") { return _serverArrayResponse(value, keepAlive) }
    if (kind == "string") {
        return responseText(200, string(value), "text/plain; charset=utf-8", null, keepAlive)!
    }
    if (kind == "int" || kind == "float" || kind == "bool") {
        return responseText(200, string(value), "text/plain; charset=utf-8", null, keepAlive)!
    }
    return responseText(200, Json.stringify(value), "application/json; charset=utf-8", null,
                        keepAlive)!
}

fn _serverWriteAll(conn: NetConn, data: string) -> bool {
    var pos = 0
    while (pos < data.byteLength) {
        var chunk = _byteSlice(data, pos, data.byteLength)
        if (chunk == null) { return false }
        var n = net.write(conn, chunk!)
        if (n <= 0) { return false }
        pos = pos + n
    }
    return true
}

fn _serverDispatch(conn: NetConn, msg: RequestMessage) -> bool {
    var path = _serverTargetPath(msg.head.target)
    var found = _serverRouter.find(msg.head.method, path)
    if (found == null) {
        return _serverWriteAll(conn, _serverStatusResponse(404, "Not Found", msg.head.keepAlive)) &&
               msg.head.keepAlive
    }

    var result: unknown = found!.value
    if (found!.handler != null) {
        var req = _serverRequestJson(msg, found!.params)
        try {
            var handler = found!.handler!.handler
            result = handler(req)
        } catch (e) {
            var body = "Internal Server Error: " + string(e)
            _serverWriteAll(conn, _serverStatusResponse(500, body, false))
            return false
        }

        if (typeName(result) == "string") {
            // Keep dynamic handler strings in this frame; AOT can lose payloads
            // when that unknown value crosses another helper boundary.
            var body = string(result)
            return _serverWriteAll(
                conn,
                responseText(200, body, "text/plain; charset=utf-8", null, msg.head.keepAlive)!
            ) && msg.head.keepAlive
        }
    }

    return _serverWriteAll(conn, _serverResponseFor(result, msg.head.keepAlive)) &&
           msg.head.keepAlive
}

fn _serveHttpConnection(conn: NetConn) {
    var raw = ""
    while (_serverRunning) {
        var headEnd = _responseHeadEnd(raw)
        if (headEnd >= 0) {
            var head = parseRequestHead(raw)
            if (head == null) {
                _serverWriteAll(conn, _serverStatusResponse(400, "Bad Request", false))
                net.close(conn)
                return
            }
            if (head!.contentLength > HTTP_SERVER_MAX_BODY_BYTES) {
                _serverWriteAll(conn, _serverStatusResponse(413, "Payload Too Large", false))
                net.close(conn)
                return
            }

            var msg = parseRequestText(raw, HTTP_SERVER_MAX_BODY_BYTES)
            if (msg != null) {
                var keep = _serverDispatch(conn, msg!)
                if (!keep) {
                    net.close(conn)
                    return
                }
                var rest = _byteSlice(raw, msg!.consumedBytes, raw.byteLength)
                raw = rest ?? ""
                if (raw.byteLength > 0) { continue }
            }
        }
        if (raw.byteLength > HTTP_SERVER_MAX_BODY_BYTES + HTTP_SERVER_READ_CHUNK_BYTES) {
            _serverWriteAll(conn, _serverStatusResponse(413, "Payload Too Large", false))
            net.close(conn)
            return
        }

        var chunk = net.read(conn, HTTP_SERVER_READ_CHUNK_BYTES)
        if (chunk == null) {
            net.close(conn)
            return
        }
        raw = raw + chunk!
    }
    net.close(conn)
}

fn listen(port: int) -> bool {
    if (_serverRunning) { return false }
    var listener = net.listen(port, HTTP_SERVER_BACKLOG)
    if (listener == null) { return false }

    _serverListener = listener
    _serverRunning = true
    while (_serverRunning) {
        net.setAcceptDeadline(listener!, time.monotonic() + HTTP_SERVER_ACCEPT_POLL_MS)
        var conn = net.accept(listener!)
        if (conn != null) {
            go _serveHttpConnection(conn!)
            continue
        }
        var err = net.lastError(listener!)
        if (!_serverRunning || err == "closed") { break }
        if (err == "timeout") { continue }
        break
    }

    _serverRunning = false
    net.close(listener!)
    _serverListener = null
    return true
}

fn stopServer() {
    _serverRunning = false
    if (_serverListener != null) {
        net.close(_serverListener!)
        _serverListener = null
    }
}

// MultipartBody - Built multipart/form-data payload and matching Content-Type.
class MultipartBody {
    body: string
    contentType: string

    constructor(body: string, contentType: string) {
        this.body = body
        this.contentType = contentType
    }
}

// FormData - Explicit multipart/form-data builder.
class FormData {
    boundary: string
    fields: Array<_FormField>
    totalSize: int
    maxTotalSize: int
    maxFileSize: int

    constructor(maxTotalSize: int, maxFileSize: int) {
        this.boundary = _boundary()
        this.fields = []
        this.totalSize = 0
        this.maxTotalSize = _normalizeLimit(maxTotalSize)
        this.maxFileSize = _normalizeLimit(maxFileSize)
    }

    append(name: string, value: string) -> bool {
        var size = value.byteLength
        if (_limitExceeded(this.maxTotalSize, this.totalSize, size)) {
            return false
        }
        this.fields.push(_FormField("text", name, value, "", ""))
        this.totalSize = this.totalSize + size
        return true
    }

    appendFile(name: string, path: string) -> bool {
        var data = io.readFile(path)
        if (data == null) { return false }

        var content = data!
        var size = content.byteLength
        if (size <= 0) { return false }
        if (_limitExceeded(this.maxFileSize, 0, size)) { return false }
        if (_limitExceeded(this.maxTotalSize, this.totalSize, size)) { return false }

        var filename = _basename(path)
        if (len(filename) == 0) { filename = "file" }
        this.fields.push(_FormField("file", name, content, filename, _guessMimeType(filename)))
        this.totalSize = this.totalSize + size
        return true
    }

    build() -> MultipartBody {
        var out = StringBuilder()
        for (var i = 0; i < len(this.fields); i++) {
            var field = this.fields[i]
            out.append("--")
            out.append(this.boundary)
            out.append("\r\n")

            if (field.kind == "text") {
                out.append("Content-Disposition: form-data; name=\"")
                out.append(_headerParam(field.name))
                out.append("\"\r\n\r\n")
                out.append(field.value)
            } else {
                out.append("Content-Disposition: form-data; name=\"")
                out.append(_headerParam(field.name))
                out.append("\"; filename=\"")
                out.append(_headerParam(field.filename))
                out.append("\"\r\n")
                out.append("Content-Type: ")
                out.append(field.contentType)
                out.append("\r\n\r\n")
                out.append(field.value)
            }
            out.append("\r\n")
        }

        out.append("--")
        out.append(this.boundary)
        out.append("--\r\n")

        return MultipartBody(
            out.toString(),
            "multipart/form-data; boundary=" + this.boundary
        )
    }
}

// formData - Create an explicit multipart/form-data builder.
fn formData(
    maxTotalSize: int = 67108864,
    maxFileSize: int = 33554432
) -> FormData {
    return FormData(maxTotalSize, maxFileSize)
}

fn _hasCtlOr(s: string, extra: string) -> bool {
    for (var i = 0; i < len(s); i++) {
        var c = s.charAt(i)
        var o = c.ord()!
        if (o < 0x20 || o == 0x7F || extra.indexOf(c) >= 0) { return true }
    }
    return false
}

fn _isTokenChar(c: string) -> bool {
    var o = c.ord()!
    return (o >= 65 && o <= 90) ||
           (o >= 97 && o <= 122) ||
           (o >= 48 && o <= 57) ||
           c == "!" || c == "#" || c == "$" || c == "%" ||
           c == "&" || c == "'" || c == "*" || c == "+" ||
           c == "-" || c == "." || c == "^" || c == "_" ||
           c == "`" || c == "|" || c == "~"
}

fn _headerNameValid(name: string) -> bool {
    if (len(name) == 0) { return false }
    for (var i = 0; i < len(name); i++) {
        if (!_isTokenChar(name.charAt(i))) { return false }
    }
    return true
}

fn _headerValueValid(value: string) -> bool {
    for (var i = 0; i < len(value); i++) {
        var o = value.charAt(i).ord()!
        if (o == 9) { continue }
        if (o < 0x20 || o == 0x7F) { return false }
    }
    return true
}

fn _requestMethod(method: string) -> string? {
    var m = method.trim().toUpperCase()
    if (len(m) == 0 || _hasCtlOr(m, " \t\r\n")) { return null }
    return m
}

fn _requestPath(path: string) -> string? {
    var p = path
    if (len(p) == 0) { p = "/" }
    if (p.charAt(0) != "/" || _hasCtlOr(p, " \r\n")) { return null }
    return p
}

fn _requestTarget(raw: string) -> string? {
    var t = raw.trim()
    if (len(t) == 0 || _hasCtlOr(t, " \t\r\n")) { return null }
    return t
}

fn _hostHeaderValue(host: string) -> string? {
    var h = host.trim()
    if (len(h) == 0) { return null }
    if (_hasCtlOr(h, " /\r\n")) { return null }
    return h
}

fn _headerKeyEquals(name: string, target: string) -> bool {
    return name.toLowerCase() == target.toLowerCase()
}

fn _sensitiveHeader(name: string) -> bool {
    var n = name.toLowerCase()
    return n == "authorization" || n == "proxy-authorization"
}

fn _reservedResponseHeader(name: string) -> bool {
    var n = name.toLowerCase()
    return n == "content-length" ||
           n == "content-type" ||
           n == "connection" ||
           n == "transfer-encoding" ||
           n == "trailer"
}

fn _appendHeader(out: StringBuilder, name: string, value: string) {
    out.append(name)
    out.append(": ")
    out.append(value)
    out.append("\r\n")
}

fn _trimLineEnd(line: string) -> string {
    if (line.endsWith("\r")) { return line.slice(0, len(line) - 1) }
    return line
}

fn _responseHeadEnd(raw: string) -> int {
    var crlf = raw.indexOf("\r\n\r\n")
    if (crlf >= 0) { return crlf + 4 }
    var lf = raw.indexOf("\n\n")
    if (lf >= 0) { return lf + 2 }
    return -1
}

fn _parseStatusCode(raw: string) -> int {
    if (len(raw) != 3) { return -1 }
    var code = 0
    for (var i = 0; i < len(raw); i++) {
        var o = raw.charAt(i).ord()!
        if (o < 48 || o > 57) { return -1 }
        code = code * 10 + (o - 48)
    }
    return code
}

fn _hexValue(c: string) -> int {
    var o = c.ord()!
    if (o >= 48 && o <= 57) { return o - 48 }
    if (o >= 65 && o <= 70) { return 10 + o - 65 }
    if (o >= 97 && o <= 102) { return 10 + o - 97 }
    return -1
}

fn _parseChunkSize(line: string) -> int? {
    var semi = line.indexOf(";")
    var raw = line
    if (semi >= 0) { raw = line.slice(0, semi) }
    raw = raw.trim()
    if (len(raw) == 0) { return null }

    var size = 0
    for (var i = 0; i < len(raw); i++) {
        var v = _hexValue(raw.charAt(i))
        if (v < 0) { return null }
        size = size * 16 + v
    }
    return size
}

fn _parseHeaderLine(line: string) -> (string, string)? {
    if (len(line) == 0) { return null }
    if (line.charAt(0) == " " || line.charAt(0) == "\t") { return null }
    var colon = line.indexOf(":")
    if (colon <= 0) { return null }
    var name = line.slice(0, colon)
    var value = line.slice(colon + 1).trim()
    if (!_headerNameValid(name) || !_headerValueValid(value)) { return null }
    return (name, value)
}

fn _headerListGet(pairs: Array<(string, string)>, name: string) -> string? {
    var target = name.toLowerCase()
    for (var i = 0; i < len(pairs); i++) {
        if (pairs[i].0.toLowerCase() == target) { return pairs[i].1 }
    }
    return null
}

fn _headerListAll(pairs: Array<(string, string)>, name: string) -> Array<string> {
    var target = name.toLowerCase()
    var out: Array<string> = []
    for (var i = 0; i < len(pairs); i++) {
        if (pairs[i].0.toLowerCase() == target) { out.push(pairs[i].1) }
    }
    return out
}

fn _hasHeaderToken(value: string, token: string) -> bool {
    var needle = token.toLowerCase()
    var start = 0
    while (start <= len(value)) {
        var comma = value.indexOf(",", start)
        var end = len(value)
        if (comma >= 0) { end = comma }
        if (value.slice(start, end).trim().toLowerCase() == needle) {
            return true
        }
        if (comma < 0) { break }
        start = comma + 1
    }
    return false
}

fn _teIsSupportedChunked(value: string) -> bool {
    var trimmed = value.trim()
    if (len(trimmed) == 0) { return false }
    return trimmed.indexOf(",") < 0 && trimmed.toLowerCase() == "chunked"
}

fn _chunkedFramingFrom(pairs: Array<(string, string)>) -> bool? {
    var chunked = false
    for (var i = 0; i < len(pairs); i++) {
        if (!_headerKeyEquals(pairs[i].0, "Transfer-Encoding")) { continue }
        if (!_teIsSupportedChunked(pairs[i].1)) { return null }
        chunked = true
    }
    return chunked
}

fn _contentLengthFrom(pairs: Array<(string, string)>) -> int? {
    var found = false
    var length = -1
    for (var i = 0; i < len(pairs); i++) {
        if (!_headerKeyEquals(pairs[i].0, "Content-Length")) { continue }
        var parsed = _parseIntStrict(pairs[i].1)
        if (parsed == null || parsed! < 0) { return null }
        if (found && parsed! != length) { return null }
        found = true
        length = parsed!
    }
    return length
}

fn _byteCrlfIndex(raw: string, start: int) -> int {
    var pos = start
    while (pos + 1 < raw.byteLength) {
        if (raw.byteAt(pos) == "\r" && raw.byteAt(pos + 1) == "\n") {
            return pos
        }
        pos = pos + 1
    }
    return -1
}

fn _byteSlice(raw: string, start: int, end: int) -> string? {
    if (start < 0 || end < start || end > raw.byteLength) { return null }
    if (len(raw) == raw.byteLength) { return raw.slice(start, end) }

    var out = StringBuilder()
    for (var i = start; i < end; i++) {
        var b = raw.byteAt(i)
        if (b == null) { return null }
        out.append(b!)
    }
    return out.toString()
}

fn _byteCrlfAt(raw: string, pos: int) -> bool {
    return pos + 1 < raw.byteLength &&
           raw.byteAt(pos) == "\r" &&
           raw.byteAt(pos + 1) == "\n"
}

fn _responseAllowsBody(status: int) -> bool {
    return !(status >= 100 && status < 200) && status != 204 && status != 304
}

fn _keepAlive(version: string, pairs: Array<(string, string)>) -> bool {
    var keep = version == "HTTP/1.1"
    for (var i = 0; i < len(pairs); i++) {
        if (!_headerKeyEquals(pairs[i].0, "Connection")) { continue }
        if (_hasHeaderToken(pairs[i].1, "close")) { return false }
        if (_hasHeaderToken(pairs[i].1, "keep-alive")) { keep = true }
    }
    return keep
}

fn _httpUrlOk(raw: string) -> bool {
    var p = parseUrl(raw)
    var scheme = p.protocol.toLowerCase()
    return (scheme == "http:" || scheme == "https:") && len(p.hostname) > 0
}

fn _originPort(raw: string) -> int {
    var p = parseUrl(raw)
    if (len(p.port) > 0) {
        var port = _parseIntStrict(p.port)
        if (port != null) { return port! }
    }
    if (p.protocol.toLowerCase() == "https:") { return 443 }
    return 80
}

fn _sameOrigin(a: string, b: string) -> bool {
    var pa = parseUrl(a)
    var pb = parseUrl(b)
    return pa.protocol.toLowerCase() == pb.protocol.toLowerCase() &&
           pa.hostname.toLowerCase() == pb.hostname.toLowerCase() &&
           _originPort(a) == _originPort(b)
}

class _HttpRequestUrl {
    scheme: string
    host: string
    port: int
    path: string
    isHttps: bool

    constructor(scheme: string, host: string, port: int, path: string, isHttps: bool) {
        this.scheme = scheme
        this.host = host
        this.port = port
        this.path = path
        this.isHttps = isHttps
    }
}

class HttpResponse {
    status: int
    statusText: string
    headers: Json
    body: string
    error: string?
    ok: bool

    constructor(status: int, statusText: string, headers: Json, body: string, error: string?) {
        this.status = status
        this.statusText = statusText
        this.headers = headers
        this.body = body
        this.error = error
        this.ok = error == null && status >= 200 && status < 300
    }
}

fn _httpResponse(status: int, statusText: string, headers: Json, body: string,
                 error: string?) -> HttpResponse {
    return HttpResponse(status, statusText, headers, body, error)
}

fn _httpError(error: string) -> HttpResponse {
    var headers: Json = {}
    return HttpResponse(0, "", headers, "", error)
}

fn _firstAuthorityEnd(raw: string, start: int) -> int {
    var i = start
    while (i < len(raw)) {
        var ch = raw.charAt(i)
        if (ch == "/" || ch == "?" || ch == "#") { return i }
        i = i + 1
    }
    return len(raw)
}

fn _findCharBefore(raw: string, needle: string, start: int, end: int) -> int {
    var i = start
    while (i < end) {
        if (raw.charAt(i) == needle) { return i }
        i = i + 1
    }
    return -1
}

fn _parsePortStrict(raw: string) -> int? {
    if (len(raw) == 0 || len(raw) > 5) { return null }
    var port = 0
    for (var i = 0; i < len(raw); i++) {
        var c = raw.charAt(i).ord()!
        if (c < 48 || c > 57) { return null }
        port = port * 10 + (c - 48)
    }
    if (port <= 0 || port > 65535) { return null }
    return port
}

fn _httpPathFrom(raw: string, pos: int) -> string {
    var path = "/"
    if (pos < len(raw)) {
        path = raw.slice(pos)
        var hash = path.indexOf("#")
        if (hash >= 0) { path = path.slice(0, hash) }
        if (len(path) == 0) {
            path = "/"
        } else if (path.charAt(0) == "?") {
            path = "/" + path
        }
    }
    return path
}

fn _parseHttpRequestUrl(rawUrl: string) -> _HttpRequestUrl? {
    var raw = rawUrl.trim()
    if (len(raw) == 0) { return null }

    var scheme = "http"
    var isHttps = false
    var port = 80
    var pos = 0
    var schemeEnd = raw.indexOf("://")
    if (schemeEnd >= 0) {
        scheme = raw.slice(0, schemeEnd).toLowerCase()
        if (scheme != "http" && scheme != "https") { return null }
        isHttps = scheme == "https"
        port = isHttps ? 443 : 80
        pos = schemeEnd + 3
    }

    var authorityEnd = _firstAuthorityEnd(raw, pos)
    if (_findCharBefore(raw, "@", pos, authorityEnd) >= 0) { return null }

    var host = ""
    var rawPort = ""
    if (pos < authorityEnd && raw.charAt(pos) == "[") {
        var close = _findCharBefore(raw, "]", pos + 1, authorityEnd)
        if (close < 0) { return null }
        host = raw.slice(pos + 1, close)
        pos = close + 1
        if (pos < authorityEnd) {
            if (raw.charAt(pos) != ":") { return null }
            rawPort = raw.slice(pos + 1, authorityEnd)
        }
    } else {
        var colon = _findCharBefore(raw, ":", pos, authorityEnd)
        if (colon >= 0) {
            host = raw.slice(pos, colon)
            rawPort = raw.slice(colon + 1, authorityEnd)
        } else {
            host = raw.slice(pos, authorityEnd)
        }
        if (host.indexOf(":") >= 0) { return null }
    }

    if (len(host) == 0) { return null }
    if (_hasCtlOr(host, " /\r\n")) { return null }

    if (len(rawPort) > 0) {
        var parsedPort = _parsePortStrict(rawPort)
        if (parsedPort == null) { return null }
        port = parsedPort!
    }

    return _HttpRequestUrl(scheme, host, port, _httpPathFrom(raw, authorityEnd), isHttps)
}

fn _httpRequestHostHeader(url: _HttpRequestUrl) -> string {
    var host = url.host
    if (host.indexOf(":") >= 0 && !host.startsWith("[")) {
        host = "[" + host + "]"
    }
    var defaultPort = (!url.isHttps && url.port == 80) || (url.isHttps && url.port == 443)
    if (!defaultPort) { host = host + ":" + string(url.port) }
    return host
}

fn _httpRequestUrlText(url: _HttpRequestUrl) -> string {
    return url.scheme + "://" + _httpRequestHostHeader(url) + url.path
}

fn _requestTimeout(options: Json) -> int {
    var raw = Json.get(options, "timeout", null)
    if (raw == null || typeName(raw) != "int") { return HTTP_DEFAULT_TIMEOUT_MS }
    var t = int(raw)
    if (t <= 0) { return HTTP_DEFAULT_TIMEOUT_MS }
    return t
}

fn _requestMaxRedirects(options: Json) -> int {
    var raw = Json.get(options, "maxRedirects", null)
    if (raw == null || typeName(raw) != "int") { return 5 }
    var n = int(raw)
    if (n < 0) { return 0 }
    return n
}

fn _requestFollowRedirects(options: Json) -> bool {
    var raw = Json.get(options, "followRedirects", null)
    if (raw == null || typeName(raw) != "bool") { return true }
    return bool(raw)
}

fn _requestBody(options: Json) -> string {
    var raw = Json.get(options, "body", null)
    if (raw == null) { return "" }
    return string(raw)
}

fn _requestHeaders(options: Json) -> Json {
    var raw = Json.get(options, "headers", null)
    if (raw == null) { return null }
    return raw
}

fn _headersHave(headers: Json, name: string) -> bool {
    if (headers == null) { return false }
    for (key in headers) {
        if (_headerKeyEquals(string(key), name)) { return true }
    }
    return false
}

fn _requestWireHeaders(headers: Json) -> Json {
    if (_headersHave(headers, "Accept-Encoding")) { return headers }
    var out: Json = {}
    if (headers != null) {
        for (key in headers) {
            var name = string(key)
            out[name] = Json.get(headers, name, null)
        }
    }
    out["Accept-Encoding"] = "identity"
    return Json.encode(out)
}

fn _headersLocation(headers: Json) -> string? {
    if (headers == null) { return null }
    for (key in headers) {
        var name = string(key)
        if (_headerKeyEquals(name, "Location")) {
            var value = Json.get(headers, name, null)
            if (value == null) { return null }
            return string(value)
        }
    }
    return null
}

fn _readHttpResponse(conn: NetConn, method: string) -> ResponseMessage? {
    var raw = ""
    var closeDelimited = false
    while (raw.byteLength <= HTTP_MAX_RESPONSE_BYTES) {
        var chunk = net.read(conn, 8192)
        if (chunk == null) {
            break
        }
        raw = raw + chunk!

        var head = parseResponseHead(raw)
        if (head == null) { continue }
        var noBody = !_responseAllowsBody(head!.status) || method == "HEAD"
        closeDelimited = !noBody && !head!.chunked && head!.contentLength < 0 && !head!.keepAlive
        if (closeDelimited) { continue }

        var parsed = parseResponseText(raw)
        if (parsed != null) { return parsed! }
    }
    if (closeDelimited) {
        return parseResponseText(raw)
    }
    return null
}

fn _singleRequest(url: _HttpRequestUrl, method: string, headers: Json, body: string,
                  timeoutMs: int, stripSensitive: bool) -> HttpResponse {
    var conn = url.isHttps ? net.dialTLS(url.host, url.port, timeoutMs) :
                             net.dial(url.host, url.port, timeoutMs)
    if (conn == null) { return _httpError("Connection failed") }

    var deadline = time.monotonic() + timeoutMs
    net.setDeadline(conn!, deadline)

    var request = requestText(method, url.path, _requestWireHeaders(headers), body, _httpRequestHostHeader(url),
                              stripSensitive)
    if (request == null) {
        net.close(conn!)
        return _httpError("Protocol parse error")
    }

    if (net.write(conn!, request!) != request!.byteLength) {
        net.close(conn!)
        return _httpError("Write failed")
    }

    var msg = _readHttpResponse(conn!, method)
    net.close(conn!)
    if (msg == null) { return _httpError("Protocol parse error") }
    return _httpResponse(msg!.head.status, msg!.head.reason, msg!.head.headers, msg!.body, null)
}

fn request(options: Json) -> HttpResponse {
    var rawUrl = Json.get(options, "url", null)
    if (rawUrl == null) { return _httpError("URL parse error") }
    var current = _parseHttpRequestUrl(string(rawUrl))
    if (current == null) { return _httpError("URL parse error") }

    var rawMethod = Json.get(options, "method", "GET")
    var method = _requestMethod(string(rawMethod))
    if (method == null) { return _httpError("Protocol parse error") }

    var headers = _requestHeaders(options)
    var body = _requestBody(options)
    var timeoutMs = _requestTimeout(options)
    var followRedirects = _requestFollowRedirects(options)
    var maxRedirects = _requestMaxRedirects(options)
    var redirects = 0
    var stripSensitive = false

    while (true) {
        var response = _singleRequest(current!, method!, headers, body, timeoutMs, stripSensitive)
        if (!followRedirects || !isRedirectStatus(response.status) || redirects >= maxRedirects) {
            return response
        }

        var location = _headersLocation(response.headers)
        if (location == null) { return response }
        var next = redirectDecision(response.status, _httpRequestUrlText(current!), location!,
                                    method!, stripSensitive)
        if (next == null) { return response }

        var nextUrl = _parseHttpRequestUrl(next!.url)
        if (nextUrl == null) { return _httpError("URL parse error") }

        current = nextUrl
        method = next!.method
        stripSensitive = next!.stripSensitiveHeaders
        if (next!.dropBody) { body = "" }
        redirects = redirects + 1
    }
    return _httpError("URL parse error")
}

// ResponseHead - Parsed HTTP/1.x response status line and headers.
class ResponseHead {
    version: string
    status: int
    reason: string
    headers: Json
    headerPairs: Array<(string, string)>
    headerBytes: int
    contentLength: int
    chunked: bool
    keepAlive: bool

    constructor(
        version: string,
        status: int,
        reason: string,
        headers: Json,
        headerPairs: Array<(string, string)>,
        headerBytes: int,
        contentLength: int,
        chunked: bool,
        keepAlive: bool
    ) {
        this.version = version
        this.status = status
        this.reason = reason
        this.headers = headers
        this.headerPairs = headerPairs
        this.headerBytes = headerBytes
        this.contentLength = contentLength
        this.chunked = chunked
        this.keepAlive = keepAlive
    }

    getHeader(name: string) -> string? {
        return _headerListGet(this.headerPairs, name)
    }

    getHeaders(name: string) -> Array<string> {
        return _headerListAll(this.headerPairs, name)
    }
}

// RedirectDecision - Pure redirect control-plane result for the HTTP client.
class RedirectDecision {
    url: string
    method: string
    stripSensitiveHeaders: bool
    dropBody: bool

    constructor(url: string, method: string, stripSensitiveHeaders: bool, dropBody: bool) {
        this.url = url
        this.method = method
        this.stripSensitiveHeaders = stripSensitiveHeaders
        this.dropBody = dropBody
    }
}

// ChunkedBody - Decoded Transfer-Encoding: chunked body and parsed trailers.
class ChunkedBody {
    body: string
    trailers: Json
    trailerPairs: Array<(string, string)>
    consumedBytes: int

    constructor(
        body: string,
        trailers: Json,
        trailerPairs: Array<(string, string)>,
        consumedBytes: int
    ) {
        this.body = body
        this.trailers = trailers
        this.trailerPairs = trailerPairs
        this.consumedBytes = consumedBytes
    }

    getTrailer(name: string) -> string? {
        return _headerListGet(this.trailerPairs, name)
    }

    getTrailers(name: string) -> Array<string> {
        return _headerListAll(this.trailerPairs, name)
    }
}

// RequestHead - Parsed HTTP/1.x request line and headers.
class RequestHead {
    method: string
    target: string
    version: string
    headers: Json
    headerPairs: Array<(string, string)>
    headerBytes: int
    contentLength: int
    chunked: bool
    keepAlive: bool

    constructor(
        method: string,
        target: string,
        version: string,
        headers: Json,
        headerPairs: Array<(string, string)>,
        headerBytes: int,
        contentLength: int,
        chunked: bool,
        keepAlive: bool
    ) {
        this.method = method
        this.target = target
        this.version = version
        this.headers = headers
        this.headerPairs = headerPairs
        this.headerBytes = headerBytes
        this.contentLength = contentLength
        this.chunked = chunked
        this.keepAlive = keepAlive
    }

    getHeader(name: string) -> string? {
        return _headerListGet(this.headerPairs, name)
    }

    getHeaders(name: string) -> Array<string> {
        return _headerListAll(this.headerPairs, name)
    }
}

// RequestMessage - Parsed HTTP/1.x request head and decoded body.
class RequestMessage {
    head: RequestHead
    body: string
    trailers: Json
    trailerPairs: Array<(string, string)>
    consumedBytes: int

    constructor(
        head: RequestHead,
        body: string,
        trailers: Json,
        trailerPairs: Array<(string, string)>,
        consumedBytes: int
    ) {
        this.head = head
        this.body = body
        this.trailers = trailers
        this.trailerPairs = trailerPairs
        this.consumedBytes = consumedBytes
    }

    getHeader(name: string) -> string? {
        return this.head.getHeader(name)
    }

    getTrailer(name: string) -> string? {
        return _headerListGet(this.trailerPairs, name)
    }

    getTrailers(name: string) -> Array<string> {
        return _headerListAll(this.trailerPairs, name)
    }
}

// ResponseMessage - Parsed HTTP/1.x response head and decoded body.
class ResponseMessage {
    head: ResponseHead
    body: string
    trailers: Json
    trailerPairs: Array<(string, string)>
    consumedBytes: int

    constructor(
        head: ResponseHead,
        body: string,
        trailers: Json,
        trailerPairs: Array<(string, string)>,
        consumedBytes: int
    ) {
        this.head = head
        this.body = body
        this.trailers = trailers
        this.trailerPairs = trailerPairs
        this.consumedBytes = consumedBytes
    }

    getHeader(name: string) -> string? {
        return this.head.getHeader(name)
    }

    getTrailer(name: string) -> string? {
        return _headerListGet(this.trailerPairs, name)
    }

    getTrailers(name: string) -> Array<string> {
        return _headerListAll(this.trailerPairs, name)
    }
}

// parseChunkedBody - Decode a complete Transfer-Encoding: chunked body.
fn parseChunkedBody(
    raw: string,
    maxBodyBytes: int = 67108864,
    maxTrailerHeaders: int = 50
) -> ChunkedBody? {
    var pos = 0
    var total = 0
    var body = StringBuilder()

    while (true) {
        var lineEnd = _byteCrlfIndex(raw, pos)
        if (lineEnd < 0) { return null }
        var line = _byteSlice(raw, pos, lineEnd)
        if (line == null) { return null }
        var size = _parseChunkSize(line!)
        if (size == null) { return null }
        pos = lineEnd + 2

        if (size! == 0) {
            var trailers: Json = {}
            var pairs: Array<(string, string)> = []
            while (true) {
                var trailerEnd = _byteCrlfIndex(raw, pos)
                if (trailerEnd < 0) { return null }
                var line = _byteSlice(raw, pos, trailerEnd)
                if (line == null) { return null }
                pos = trailerEnd + 2
                if (len(line!) == 0) {
                    return ChunkedBody(body.toString(), trailers, pairs, pos)
                }

                var parsed = _parseHeaderLine(line!)
                if (parsed == null) { return null }
                pairs.push(parsed!)
                trailers[parsed!.0] = parsed!.1
                if (maxTrailerHeaders > 0 && len(pairs) > maxTrailerHeaders) {
                    return null
                }
            }
        }

        if (maxBodyBytes > 0 && total + size! > maxBodyBytes) { return null }
        if (pos + size! + 2 > raw.byteLength) { return null }
        var chunk = _byteSlice(raw, pos, pos + size!)
        if (chunk == null) { return null }
        body.append(chunk!)
        pos = pos + size!
        if (!_byteCrlfAt(raw, pos)) { return null }
        pos = pos + 2
        total = total + size!
    }
    return null
}

// decodeChunkedBody - Decode a chunked body and discard trailers.
fn decodeChunkedBody(raw: string, maxBodyBytes: int = 67108864) -> string? {
    var parsed = parseChunkedBody(raw, maxBodyBytes)
    if (parsed == null) { return null }
    return parsed!.body
}

// parseRequestHead - Parse an HTTP/1.x request head without reading sockets.
fn parseRequestHead(raw: string, maxHeaders: int = 100) -> RequestHead? {
    var end = _responseHeadEnd(raw)
    if (end < 0) { return null }
    var lines = raw.slice(0, end).split("\n")
    if (len(lines) == 0) { return null }

    var requestLine = _trimLineEnd(lines[0])
    var firstSpace = requestLine.indexOf(" ")
    if (firstSpace <= 0) { return null }
    var rest = requestLine.slice(firstSpace + 1)
    var secondSpace = rest.indexOf(" ")
    if (secondSpace <= 0) { return null }

    var method = _requestMethod(requestLine.slice(0, firstSpace))
    var target = _requestTarget(rest.slice(0, secondSpace))
    var version = rest.slice(secondSpace + 1)
    if (method == null || target == null) { return null }
    if (version != "HTTP/1.0" && version != "HTTP/1.1") { return null }

    var headers: Json = {}
    var pairs: Array<(string, string)> = []
    for (var i = 1; i < len(lines); i++) {
        var line = _trimLineEnd(lines[i])
        if (len(line) == 0) { break }
        var parsed = _parseHeaderLine(line)
        if (parsed == null) { return null }
        pairs.push(parsed!)
        headers[parsed!.0] = parsed!.1
        if (maxHeaders > 0 && len(pairs) > maxHeaders) { return null }
    }

    var contentLength = _contentLengthFrom(pairs)
    if (contentLength == null) { return null }
    var chunked = _chunkedFramingFrom(pairs)
    if (chunked == null || (chunked! && contentLength! >= 0)) { return null }
    return RequestHead(
        method!,
        target!,
        version,
        headers,
        pairs,
        end,
        contentLength!,
        chunked!,
        _keepAlive(version, pairs)
    )
}

// parseRequestText - Parse a complete HTTP/1.x request text.
fn parseRequestText(
    raw: string,
    maxBodyBytes: int = 67108864,
    maxHeaders: int = 100,
    maxTrailerHeaders: int = 50
) -> RequestMessage? {
    var head = parseRequestHead(raw, maxHeaders)
    if (head == null) { return null }

    var bodyStart = head!.headerBytes
    var trailers: Json = {}
    var trailerPairs: Array<(string, string)> = []

    if (head!.chunked) {
        var chunkedRaw = _byteSlice(raw, bodyStart, raw.byteLength)
        if (chunkedRaw == null) { return null }
        var chunked = parseChunkedBody(chunkedRaw!, maxBodyBytes, maxTrailerHeaders)
        if (chunked == null) { return null }
        return RequestMessage(
            head!,
            chunked!.body,
            chunked!.trailers,
            chunked!.trailerPairs,
            bodyStart + chunked!.consumedBytes
        )
    }

    if (head!.contentLength >= 0) {
        if (maxBodyBytes > 0 && head!.contentLength > maxBodyBytes) { return null }
        var bodyEnd = bodyStart + head!.contentLength
        var fixedBody = _byteSlice(raw, bodyStart, bodyEnd)
        if (fixedBody == null) { return null }
        return RequestMessage(
            head!,
            fixedBody!,
            trailers,
            trailerPairs,
            bodyEnd
        )
    }

    return RequestMessage(head!, "", trailers, trailerPairs, bodyStart)
}

// parseResponseText - Parse a complete HTTP/1.x response text.
fn parseResponseText(
    raw: string,
    maxBodyBytes: int = 67108864,
    maxHeaders: int = 100,
    maxTrailerHeaders: int = 50
) -> ResponseMessage? {
    var head = parseResponseHead(raw, maxHeaders)
    if (head == null) { return null }

    var bodyStart = head!.headerBytes
    var trailers: Json = {}
    var trailerPairs: Array<(string, string)> = []

    if (!_responseAllowsBody(head!.status)) {
        return ResponseMessage(head!, "", trailers, trailerPairs, bodyStart)
    }

    if (head!.chunked) {
        var chunkedRaw = _byteSlice(raw, bodyStart, raw.byteLength)
        if (chunkedRaw == null) { return null }
        var chunked = parseChunkedBody(chunkedRaw!, maxBodyBytes, maxTrailerHeaders)
        if (chunked == null) { return null }
        return ResponseMessage(
            head!,
            chunked!.body,
            chunked!.trailers,
            chunked!.trailerPairs,
            bodyStart + chunked!.consumedBytes
        )
    }

    if (head!.contentLength >= 0) {
        if (maxBodyBytes > 0 && head!.contentLength > maxBodyBytes) { return null }
        var bodyEnd = bodyStart + head!.contentLength
        var fixedBody = _byteSlice(raw, bodyStart, bodyEnd)
        if (fixedBody == null) { return null }
        return ResponseMessage(
            head!,
            fixedBody!,
            trailers,
            trailerPairs,
            bodyEnd
        )
    }

    var body = _byteSlice(raw, bodyStart, raw.byteLength)
    if (body == null) { return null }
    if (maxBodyBytes > 0 && body.byteLength > maxBodyBytes) { return null }
    return ResponseMessage(head!, body!, trailers, trailerPairs, raw.byteLength)
}

// parseResponseHead - Parse an HTTP/1.x response head without reading sockets.
fn parseResponseHead(raw: string, maxHeaders: int = 100) -> ResponseHead? {
    var end = _responseHeadEnd(raw)
    if (end < 0) { return null }
    var lines = raw.slice(0, end).split("\n")
    if (len(lines) == 0) { return null }

    var statusLine = _trimLineEnd(lines[0])
    var firstSpace = statusLine.indexOf(" ")
    if (firstSpace < 0) { return null }
    var version = statusLine.slice(0, firstSpace)
    if (version != "HTTP/1.0" && version != "HTTP/1.1") { return null }

    var rest = statusLine.slice(firstSpace + 1)
    var secondSpace = rest.indexOf(" ")
    var statusRaw = rest
    var reason = ""
    if (secondSpace >= 0) {
        statusRaw = rest.slice(0, secondSpace)
        reason = rest.slice(secondSpace + 1).trim()
    }
    var status = _parseStatusCode(statusRaw)
    if (status < 100 || status > 999) { return null }

    var headers: Json = {}
    var pairs: Array<(string, string)> = []
    for (var i = 1; i < len(lines); i++) {
        var line = _trimLineEnd(lines[i])
        if (len(line) == 0) { break }
        if (line.charAt(0) == " " || line.charAt(0) == "\t") { return null }
        var colon = line.indexOf(":")
        if (colon <= 0) { return null }
        var name = line.slice(0, colon)
        var value = line.slice(colon + 1).trim()
        if (!_headerNameValid(name) || !_headerValueValid(value)) { return null }
        pairs.push((name, value))
        headers[name] = value
        if (maxHeaders > 0 && len(pairs) > maxHeaders) { return null }
    }

    var contentLength = _contentLengthFrom(pairs)
    if (contentLength == null) { return null }
    var chunked = _chunkedFramingFrom(pairs)
    if (chunked == null || (chunked! && contentLength! >= 0)) { return null }
    return ResponseHead(
        version,
        status,
        reason,
        headers,
        pairs,
        end,
        contentLength!,
        chunked!,
        _keepAlive(version, pairs)
    )
}

// isRedirectStatus - True for HTTP redirect codes that carry Location.
fn isRedirectStatus(status: int) -> bool {
    return status == 301 || status == 302 || status == 303 ||
           status == 307 || status == 308
}

// redirectTarget - Resolve a Location value against the current URL.
fn redirectTarget(currentUrl: string, location: string) -> string? {
    var loc = location.trim()
    if (len(loc) == 0 || !_headerValueValid(loc)) { return null }
    if (!_httpUrlOk(currentUrl)) { return null }
    var resolved = resolveUrl(currentUrl, loc)
    if (!_httpUrlOk(resolved)) { return null }
    return resolved
}

// redirectDecision - Compute the next URL/method and credential stripping rule.
fn redirectDecision(
    status: int,
    currentUrl: string,
    location: string,
    method: string = "GET",
    alreadyStripped: bool = false
) -> RedirectDecision? {
    if (!isRedirectStatus(status)) { return null }
    var nextUrl = redirectTarget(currentUrl, location)
    if (nextUrl == null) { return null }

    var nextMethod = _requestMethod(method)
    if (nextMethod == null) { return null }
    var dropBody = false
    if (status == 303 && nextMethod! != "HEAD") {
        nextMethod = "GET"
        dropBody = true
    }

    var strip = alreadyStripped || !_sameOrigin(currentUrl, nextUrl!)
    return RedirectDecision(nextUrl!, nextMethod!, strip, dropBody)
}

// requestText - Format a complete HTTP/1.1 request string without performing I/O.
fn requestText(
    method: string,
    path: string,
    headers: Json = null,
    body: string = "",
    host: string = "",
    stripSensitive: bool = false
) -> string? {
    var m = _requestMethod(method)
    var p = _requestPath(path)
    if (m == null || p == null) { return null }

    var hasHost = false
    var hasContentLength = false
    var hasUserAgent = false
    var hasAccept = false
    var hasAcceptEncoding = false
    var hasConnection = false
    var custom: Array<(string, string)> = []

    if (headers != null) {
        for (key in headers) {
            var name = string(key)
            var rawValue = Json.get(headers, name, null)
            if (rawValue == null) { continue }
            var value = string(rawValue)
            if (!_headerNameValid(name) || !_headerValueValid(value)) { return null }
            if (stripSensitive && _sensitiveHeader(name)) { continue }

            if (_headerKeyEquals(name, "Host")) { hasHost = true }
            if (_headerKeyEquals(name, "Content-Length")) { hasContentLength = true }
            if (_headerKeyEquals(name, "User-Agent")) { hasUserAgent = true }
            if (_headerKeyEquals(name, "Accept")) { hasAccept = true }
            if (_headerKeyEquals(name, "Accept-Encoding")) { hasAcceptEncoding = true }
            if (_headerKeyEquals(name, "Connection")) { hasConnection = true }
            custom.push((name, value))
        }
    }

    var out = StringBuilder()
    out.append(m!)
    out.append(" ")
    out.append(p!)
    out.append(" HTTP/1.1\r\n")

    for (var i = 0; i < len(custom); i++) {
        _appendHeader(out, custom[i].0, custom[i].1)
    }

    if (!hasHost) {
        var h = _hostHeaderValue(host)
        if (h == null) { return null }
        _appendHeader(out, "Host", h!)
    }
    if (!hasUserAgent) { _appendHeader(out, "User-Agent", "xray-http/1.0") }
    if (!hasAccept) { _appendHeader(out, "Accept", "*/*") }
    if (!hasConnection) { _appendHeader(out, "Connection", "keep-alive") }
    if (!hasAcceptEncoding) { _appendHeader(out, "Accept-Encoding", "gzip, deflate") }
    if (body.byteLength > 0 && !hasContentLength) {
        _appendHeader(out, "Content-Length", string(body.byteLength))
    }
    out.append("\r\n")
    out.append(body)
    return out.toString()
}

fn _statusReason(status: int) -> string {
    if (status == 100) { return "Continue" }
    if (status == 101) { return "Switching Protocols" }
    if (status == 102) { return "Processing" }
    if (status == 103) { return "Early Hints" }
    if (status == 200) { return "OK" }
    if (status == 201) { return "Created" }
    if (status == 202) { return "Accepted" }
    if (status == 203) { return "Non-Authoritative Information" }
    if (status == 204) { return "No Content" }
    if (status == 205) { return "Reset Content" }
    if (status == 206) { return "Partial Content" }
    if (status == 300) { return "Multiple Choices" }
    if (status == 301) { return "Moved Permanently" }
    if (status == 302) { return "Found" }
    if (status == 303) { return "See Other" }
    if (status == 304) { return "Not Modified" }
    if (status == 305) { return "Use Proxy" }
    if (status == 307) { return "Temporary Redirect" }
    if (status == 308) { return "Permanent Redirect" }
    if (status == 400) { return "Bad Request" }
    if (status == 401) { return "Unauthorized" }
    if (status == 402) { return "Payment Required" }
    if (status == 403) { return "Forbidden" }
    if (status == 404) { return "Not Found" }
    if (status == 405) { return "Method Not Allowed" }
    if (status == 406) { return "Not Acceptable" }
    if (status == 407) { return "Proxy Authentication Required" }
    if (status == 408) { return "Request Timeout" }
    if (status == 409) { return "Conflict" }
    if (status == 410) { return "Gone" }
    if (status == 411) { return "Length Required" }
    if (status == 412) { return "Precondition Failed" }
    if (status == 413) { return "Payload Too Large" }
    if (status == 414) { return "URI Too Long" }
    if (status == 415) { return "Unsupported Media Type" }
    if (status == 416) { return "Range Not Satisfiable" }
    if (status == 417) { return "Expectation Failed" }
    if (status == 418) { return "I'm a teapot" }
    if (status == 421) { return "Misdirected Request" }
    if (status == 422) { return "Unprocessable Content" }
    if (status == 423) { return "Locked" }
    if (status == 424) { return "Failed Dependency" }
    if (status == 425) { return "Too Early" }
    if (status == 426) { return "Upgrade Required" }
    if (status == 428) { return "Precondition Required" }
    if (status == 429) { return "Too Many Requests" }
    if (status == 431) { return "Request Header Fields Too Large" }
    if (status == 451) { return "Unavailable For Legal Reasons" }
    if (status == 500) { return "Internal Server Error" }
    if (status == 501) { return "Not Implemented" }
    if (status == 502) { return "Bad Gateway" }
    if (status == 503) { return "Service Unavailable" }
    if (status == 504) { return "Gateway Timeout" }
    if (status == 505) { return "HTTP Version Not Supported" }
    if (status == 507) { return "Insufficient Storage" }
    if (status == 508) { return "Loop Detected" }
    if (status == 510) { return "Not Extended" }
    if (status == 511) { return "Network Authentication Required" }
    return "Unknown"
}

// urlEncode - Percent-encode using the HTTP module's historical URL helper
// semantics: unreserved RFC 3986 bytes pass through, every other UTF-8 byte
// becomes %XX, and spaces become %20 rather than +.
fn urlEncode(s: string) -> string {
    return encode(s)
}

// urlDecode - Percent-decode and treat + as a space, matching the former HTTP
// helper semantics for form-style query fragments.
fn urlDecode(s: string) -> string {
    return decodeForm(s)
}

// responseText - Format a complete HTTP/1.1 response with explicit headers.
fn responseText(
    status: int,
    body: string = "",
    contentType: string = "text/plain; charset=utf-8",
    headers: Json = null,
    keepAlive: bool = true
) -> string? {
    var ct = contentType
    if (len(ct) == 0) { ct = "text/plain; charset=utf-8" }
    if (!_headerValueValid(ct)) { return null }

    var custom: Array<(string, string)> = []
    if (headers != null) {
        for (key in headers) {
            var name = string(key)
            var rawValue = Json.get(headers, name, null)
            if (rawValue == null) { continue }
            var value = string(rawValue)
            if (!_headerNameValid(name) ||
                !_headerValueValid(value) ||
                _reservedResponseHeader(name)) {
                return null
            }
            custom.push((name, value))
        }
    }

    var out = StringBuilder()
    out.append("HTTP/1.1 ")
    out.append(string(status))
    out.append(" ")
    out.append(_statusReason(status))
    out.append("\r\n")
    _appendHeader(out, "Content-Type", ct)
    _appendHeader(out, "Content-Length", string(body.byteLength))
    for (var i = 0; i < len(custom); i++) {
        _appendHeader(out, custom[i].0, custom[i].1)
    }
    _appendHeader(out, "Connection", keepAlive ? "keep-alive" : "close")
    out.append("\r\n")
    out.append(body)
    return out.toString()
}

