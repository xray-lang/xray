// encoding — hex + UTF-8 + UTF-16 conversions, pure Xray.
//
// hex works on the string's UTF-8 bytes; UTF-16 encode/decode walk Unicode
// code points and surrogate pairs with explicit endianness and BOM handling.
// All algorithms are byte-indexed with bit ops, matching the RFC/Unicode rules.

let LE = 0
let BE = 1

let HEX = "0123456789abcdef"

// ---- hex ----

// Map a hex character's byte value to its nibble, or -1 if not a hex digit.
fn hexVal(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48 }    // 0-9
    if (c >= 97 && c <= 102) { return c - 87 }   // a-f
    if (c >= 65 && c <= 70) { return c - 55 }    // A-F
    return -1
}

fn hexEncode(data: string) -> string {
    let src = data.toBytes()
    let out = ""
    for (let i = 0; i < src.length; i++) {
        let b = src[i]
        out = out + HEX.charAt(b >> 4)
        out = out + HEX.charAt(b & 15)
    }
    return out
}

fn hexDecode(hex: string) -> Bytes? {
    let src = hex.toBytes()
    let n = src.length
    if (n % 2 != 0) { return null }
    let out = Bytes(n / 2)
    let oi = 0
    let i = 0
    while (i < n) {
        let hi = hexVal(src[i])
        let lo = hexVal(src[i + 1])
        if (hi < 0 || lo < 0) { return null }
        out[oi] = (hi << 4) | lo
        oi = oi + 1
        i = i + 2
    }
    return out
}

fn hexDecodeString(hex: string) -> string? {
    let b = hexDecode(hex)
    if (b == null) { return null }
    return b.toString()
}

fn hexValid(hex: string) -> bool {
    let src = hex.toBytes()
    let n = src.length
    if (n % 2 != 0) { return false }
    for (let i = 0; i < n; i++) {
        if (hexVal(src[i]) < 0) { return false }
    }
    return true
}

// ---- UTF-8 ----

fn utf8ByteLength(data: string) -> int {
    return data.toBytes().length
}

fn utf8Count(data: string) -> int {
    return data.length
}

// Validate that the string's bytes form well-formed UTF-8. A Xray string is
// already valid UTF-8, but scanning keeps the semantics honest and total.
fn utf8Valid(data: string) -> bool {
    let src = data.toBytes()
    let n = src.length
    let i = 0
    while (i < n) {
        let b = src[i]
        let extra = 0
        if (b < 0x80) { extra = 0 }
        else if (b >= 0xC0 && b < 0xE0) { extra = 1 }
        else if (b >= 0xE0 && b < 0xF0) { extra = 2 }
        else if (b >= 0xF0 && b < 0xF8) { extra = 3 }
        else { return false }
        if (i + extra >= n) { return false }
        for (let j = 1; j <= extra; j++) {
            let c = src[i + j]
            if (c < 0x80 || c >= 0xC0) { return false }
        }
        i = i + extra + 1
    }
    return true
}

// ---- UTF-16 ----

// Write a 16-bit code unit into Bytes in the requested endianness.
fn putU16(out: Bytes, oi: int, unit: int, endian: int) {
    if (endian == BE) {
        out[oi] = (unit >> 8) & 255
        out[oi + 1] = unit & 255
    } else {
        out[oi] = unit & 255
        out[oi + 1] = (unit >> 8) & 255
    }
}

// Read a 16-bit code unit from Bytes in the requested endianness. The bytes are
// promoted to int before shifting: a Bytes element is uint8, so `<< 8` in the
// uint8 domain would truncate the high byte to zero.
fn getU16(src: Bytes, i: int, endian: int) -> int {
    let lo: int = src[i]
    let hi: int = src[i + 1]
    if (endian == BE) {
        return (lo << 8) | hi
    }
    return (hi << 8) | lo
}

fn utf16Encode(data: string, endian: int = 0) -> Bytes {
    let cpCount = data.length
    // First pass: count 16-bit units (BMP = 1, supplementary = 2).
    let units = 0
    for (let i = 0; i < cpCount; i++) {
        let cp = data.codePointAt(i)
        if (cp >= 0x10000) { units = units + 2 } else { units = units + 1 }
    }
    let out = Bytes(units * 2)
    let oi = 0
    for (let i = 0; i < cpCount; i++) {
        let cp = data.codePointAt(i)
        if (cp >= 0x10000) {
            let v = cp - 0x10000
            putU16(out, oi, 0xD800 + (v >> 10), endian)
            putU16(out, oi + 2, 0xDC00 + (v & 0x3FF), endian)
            oi = oi + 4
        } else {
            putU16(out, oi, cp, endian)
            oi = oi + 2
        }
    }
    return out
}

// UTF-8 byte length of a code point.
fn utf8Len(cp: int) -> int {
    if (cp < 0x80) { return 1 }
    if (cp < 0x800) { return 2 }
    if (cp < 0x10000) { return 3 }
    return 4
}

// Encode a code point as UTF-8 into Bytes; returns the next write offset.
fn putUtf8(out: Bytes, oi: int, cp: int) -> int {
    if (cp < 0x80) {
        out[oi] = cp
        return oi + 1
    } else if (cp < 0x800) {
        out[oi] = 0xC0 | (cp >> 6)
        out[oi + 1] = 0x80 | (cp & 0x3F)
        return oi + 2
    } else if (cp < 0x10000) {
        out[oi] = 0xE0 | (cp >> 12)
        out[oi + 1] = 0x80 | ((cp >> 6) & 0x3F)
        out[oi + 2] = 0x80 | (cp & 0x3F)
        return oi + 3
    }
    out[oi] = 0xF0 | (cp >> 18)
    out[oi + 1] = 0x80 | ((cp >> 12) & 0x3F)
    out[oi + 2] = 0x80 | ((cp >> 6) & 0x3F)
    out[oi + 3] = 0x80 | (cp & 0x3F)
    return oi + 4
}

// Decode UTF-16 bytes to a string. Auto-detects a leading BOM (FE FF = BE,
// FF FE = LE); without a BOM the `endian` argument selects byte order.
fn utf16Decode(data: Bytes, endian: int = 0, stripBom: bool = true) -> string? {
    let n = data.length
    if (n == 0) { return "" }

    let e = endian
    let start = 0
    if (n >= 2) {
        let b0 = data[0]
        let b1 = data[1]
        if (b0 == 0xFE && b1 == 0xFF) {
            e = BE
            if (stripBom) { start = 2 }
        } else if (b0 == 0xFF && b1 == 0xFE) {
            e = LE
            if (stripBom) { start = 2 }
        }
    }

    // Pass 1: decode code units (with surrogate pairs) into code points.
    let cps: Array<int> = []
    let i = start
    while (i + 1 < n) {
        let u = getU16(data, i, e)
        i = i + 2
        if (u >= 0xD800 && u <= 0xDBFF && i + 1 < n) {
            let u2 = getU16(data, i, e)
            if (u2 >= 0xDC00 && u2 <= 0xDFFF) {
                cps.push(0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00))
                i = i + 2
                continue
            }
        }
        cps.push(u)
    }

    // Pass 2: encode code points as UTF-8 and materialize the string.
    let outLen = 0
    for (let k = 0; k < cps.length; k++) { outLen = outLen + utf8Len(cps[k]) }
    let out = Bytes(outLen)
    let oi = 0
    for (let k = 0; k < cps.length; k++) { oi = putUtf8(out, oi, cps[k]) }
    return out.toString()
}

export {
    LE, BE,
    hexEncode, hexDecode, hexDecodeString, hexValid,
    utf8Valid, utf8Count, utf8ByteLength,
    utf16Encode, utf16Decode
}
