// encoding — hex + UTF-8 + UTF-16 conversions, pure Xray.
//
// hex works on explicit byte slices; UTF-16 encode/decode walk Unicode
// code points and surrogate pairs with explicit endianness and BOM handling.
// All algorithms are byte-indexed with bit ops, matching the RFC/Unicode rules.

const HEX = "0123456789abcdef"

// ---- hex ----

export enum HexError {
    OddLength(length: int),
    InvalidDigit(byteOffset: int, value: byte)
}

// Map a hex character's byte value to its nibble, or -1 if not a hex digit.
fn _hexVal(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48 }    // 0-9
    if (c >= 97 && c <= 102) { return c - 87 }   // a-f
    if (c >= 65 && c <= 70) { return c - 55 }    // A-F
    return -1
}

export fn hexEncode(data: Slice<byte>) -> string {
    var src = data
    var alphabet: Slice<byte> = HEX.bytes()
    var out = StringBuilder()
    for (var i = 0; i < len(src); i++) {
        var b = src[i] as int
        out.append(rune(int(alphabet[b >> 4]))!)
        out.append(rune(int(alphabet[b & 15]))!)
    }
    return out.toString()
}

export fn hexDecode(hex: string) -> Array<byte> {
    var src: Slice<byte> = hex.bytes()
    var n = len(src)
    if (n % 2 != 0) { throw HexError.OddLength(n) }
    var out = Array<byte>(n / 2)
    var oi = 0
    var i = 0
    while (i < n) {
        var hi = _hexVal(src[i] as int)
        if (hi < 0) { throw HexError.InvalidDigit(i, src[i]) }
        var lo = _hexVal(src[i + 1] as int)
        if (lo < 0) { throw HexError.InvalidDigit(i + 1, src[i + 1]) }
        out[oi] = ((hi << 4) | lo) as byte
        oi = oi + 1
        i = i + 2
    }
    return out
}

export fn hexValid(hex: string) -> bool {
    var src: Slice<byte> = hex.bytes()
    if (len(src) % 2 != 0) { return false }
    for (var i = 0; i < len(src); i++) {
        if (_hexVal(src[i] as int) < 0) { return false }
    }
    return true
}

// ---- UTF-8 ----

fn _utf8Cont(b: int) -> bool {
    return b >= 0x80 && b <= 0xBF
}

// Validate that arbitrary bytes form strict, shortest-form UTF-8.
export fn utf8Valid(data: Slice<byte>) -> bool {
    var src = data
    var n = len(src)
    var i = 0
    while (i < n) {
        var b = src[i] as int
        if (b < 0x80) {
            i = i + 1
        } else if (b >= 0xC2 && b <= 0xDF) {
            if (i + 1 >= n || !_utf8Cont(src[i + 1] as int)) { return false }
            i = i + 2
        } else if (b == 0xE0) {
            if (i + 2 >= n) { return false }
            if (src[i + 1] < 0xA0 || src[i + 1] > 0xBF || !_utf8Cont(src[i + 2] as int)) { return false }
            i = i + 3
        } else if (b >= 0xE1 && b <= 0xEC) {
            if (i + 2 >= n || !_utf8Cont(src[i + 1] as int) || !_utf8Cont(src[i + 2] as int)) { return false }
            i = i + 3
        } else if (b == 0xED) {
            if (i + 2 >= n) { return false }
            if (src[i + 1] < 0x80 || src[i + 1] > 0x9F || !_utf8Cont(src[i + 2] as int)) { return false }
            i = i + 3
        } else if (b >= 0xEE && b <= 0xEF) {
            if (i + 2 >= n || !_utf8Cont(src[i + 1] as int) || !_utf8Cont(src[i + 2] as int)) { return false }
            i = i + 3
        } else if (b == 0xF0) {
            if (i + 3 >= n) { return false }
            if (src[i + 1] < 0x90 || src[i + 1] > 0xBF ||
                !_utf8Cont(src[i + 2] as int) || !_utf8Cont(src[i + 3] as int)) {
                return false
            }
            i = i + 4
        } else if (b >= 0xF1 && b <= 0xF3) {
            if (i + 3 >= n ||
                !_utf8Cont(src[i + 1] as int) || !_utf8Cont(src[i + 2] as int) ||
                !_utf8Cont(src[i + 3] as int)) {
                return false
            }
            i = i + 4
        } else if (b == 0xF4) {
            if (i + 3 >= n) { return false }
            if (src[i + 1] < 0x80 || src[i + 1] > 0x8F ||
                !_utf8Cont(src[i + 2] as int) || !_utf8Cont(src[i + 3] as int)) {
                return false
            }
            i = i + 4
        } else {
            return false
        }
    }
    return true
}

// ---- UTF-16 ----

export enum Utf16Error {
    OddByteLength(length: int),
    UnexpectedLowSurrogate(byteOffset: int, value: int),
    MissingLowSurrogate(byteOffset: int, value: int),
    InvalidLowSurrogate(byteOffset: int, value: int)
}

export class Utf16DecodeOptions {
    order: Endian
    consumeBom: bool

    constructor() {
        this.order = Endian.LE
        this.consumeBom = true
    }
}

export class Utf16EncodeOptions {
    order: Endian

    constructor() {
        this.order = Endian.LE
    }
}

// Write a 16-bit code unit into Array<byte> in the requested endianness.
fn putU16(out: ref Array<byte>, oi: int, unit: int, order: Endian) {
    if (order == Endian.BE) {
        out[oi] = ((unit >> 8) & 255) as byte
        out[oi + 1] = (unit & 255) as byte
    } else {
        out[oi] = (unit & 255) as byte
        out[oi + 1] = ((unit >> 8) & 255) as byte
    }
}

// Read a 16-bit code unit from Slice<byte> in the requested endianness. The bytes are
// promoted to int before shifting: a Array<byte> element is byte, so `<< 8` in the
// byte domain would truncate the high byte to zero.
fn getU16(src: Slice<byte>, i: int, order: Endian) -> int {
    var lo: int = src[i] as int
    var hi: int = src[i + 1] as int
    if (order == Endian.BE) {
        return (lo << 8) | hi
    }
    return (hi << 8) | lo
}

export fn utf16Encode(data: string, options: Utf16EncodeOptions = Utf16EncodeOptions()) -> Array<byte> {
    var opts = options
    var order = opts.order
    var cpCount = len(data)
    // First pass: count 16-bit units (BMP = 1, supplementary = 2).
    var units = 0
    for (var i = 0; i < cpCount; i++) {
        var cp = data.runes().nth(i).toUInt32() as int
        if (cp >= 0x10000) { units = units + 2 } else { units = units + 1 }
    }
    var out = Array<byte>(units * 2)
    var oi = 0
    for (var i = 0; i < cpCount; i++) {
        var cp = data.runes().nth(i).toUInt32() as int
        if (cp >= 0x10000) {
            var v = cp - 0x10000
            putU16(ref out, oi, 0xD800 + (v >> 10), order)
            putU16(ref out, oi + 2, 0xDC00 + (v & 0x3FF), order)
            oi = oi + 4
        } else {
            putU16(ref out, oi, cp, order)
            oi = oi + 2
        }
    }
    return out
}

// UTF-8 byte length of a code point.
fn utf8Len(cp: int) -> int {
    if (cp < 0x80) { return 1 }
    if (cp < 0x800) { return 2 }
    if (cp < 0x10000) { return 3 }
    return 4
}

// Encode a code point as UTF-8 into Array<byte>; returns the next write offset.
fn putUtf8(out: ref Array<byte>, oi: int, cp: int) -> int {
    if (cp < 0x80) {
        out[oi] = cp as byte
        return oi + 1
    } else if (cp < 0x800) {
        out[oi] = (0xC0 | (cp >> 6)) as byte
        out[oi + 1] = (0x80 | (cp & 0x3F)) as byte
        return oi + 2
    } else if (cp < 0x10000) {
        out[oi] = (0xE0 | (cp >> 12)) as byte
        out[oi + 1] = (0x80 | ((cp >> 6) & 0x3F)) as byte
        out[oi + 2] = (0x80 | (cp & 0x3F)) as byte
        return oi + 3
    }
    out[oi] = (0xF0 | (cp >> 18)) as byte
    out[oi + 1] = (0x80 | ((cp >> 12) & 0x3F)) as byte
    out[oi + 2] = (0x80 | ((cp >> 6) & 0x3F)) as byte
    out[oi + 3] = (0x80 | (cp & 0x3F)) as byte
    return oi + 4
}

// Decode UTF-16 bytes to a string. Auto-detects a leading BOM (FE FF = BE,
// FF FE = LE); without a BOM the options byte order selects byte order.
export fn utf16Decode(data: Slice<byte>, options: Utf16DecodeOptions = Utf16DecodeOptions()) -> string {
    var n = len(data)
    if (n % 2 != 0) { throw Utf16Error.OddByteLength(n) }

    var opts = options
    var order = opts.order
    var start = 0
    if (n >= 2) {
        var b0 = data[0]
        var b1 = data[1]
        if (b0 == 0xFE && b1 == 0xFF) {
            order = Endian.BE
            if (opts.consumeBom) { start = 2 }
        } else if (b0 == 0xFF && b1 == 0xFE) {
            order = Endian.LE
            if (opts.consumeBom) { start = 2 }
        }
    }

    // Pass 1: decode code units (with surrogate pairs) into code points.
    var cps: Array<int> = []
    var i = start
    while (i + 1 < n) {
        var u = getU16(data, i, order)
        var byteOffset = i
        i = i + 2
        if (u >= 0xDC00 && u <= 0xDFFF) {
            throw Utf16Error.UnexpectedLowSurrogate(byteOffset, u)
        }
        if (u >= 0xD800 && u <= 0xDBFF) {
            if (i + 1 >= n) { throw Utf16Error.MissingLowSurrogate(byteOffset, u) }
            var u2 = getU16(data, i, order)
            if (u2 >= 0xDC00 && u2 <= 0xDFFF) {
                cps.push(0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00))
                i = i + 2
                continue
            }
            throw Utf16Error.InvalidLowSurrogate(i, u2)
        }
        cps.push(u)
    }

    // Pass 2: encode code points as UTF-8 and materialize the string.
    var outLen = 0
    for (var k = 0; k < len(cps); k++) { outLen = outLen + utf8Len(cps[k]) }
    var out = Array<byte>(outLen)
    var oi = 0
    for (var k = 0; k < len(cps); k++) { oi = putUtf8(ref out, oi, cps[k]) }
    return string.fromUtf8(out[:])!
}
