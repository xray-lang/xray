import text

// log - pure-Xray structured logging surface.
//
// The C side only anchors `import log`. Logger state, formatting, child context,
// level filtering, file output, and fatal exit semantics live here.

import io
import os

export enum LogLevel {
    Debug,
    Info,
    Warn,
    Error,
    Fatal
}

export enum LogFormat {
    Text,
    JSON
}

const _QUEUE_LIMIT = 256

var _level = LogLevel.Info
var _format = LogFormat.Text
var _output: Path? = null
var _source = false
var _async = false
var _asyncQueue: Array<string> = []
var _dropped = 0

fn _levelValue(level: LogLevel) -> i64 {
    return match (level) {
        LogLevel.Debug -> 0,
        LogLevel.Info  -> 1,
        LogLevel.Warn  -> 2,
        LogLevel.Error -> 3,
        LogLevel.Fatal -> 4
    }
}

fn _levelName(level: LogLevel) -> string {
    return match (level) {
        LogLevel.Debug -> "DEBUG",
        LogLevel.Info  -> "INFO",
        LogLevel.Warn  -> "WARN",
        LogLevel.Error -> "ERROR",
        LogLevel.Fatal -> "FATAL"
    }
}

fn _jsonEscape(s: string) -> string {
    var out = StringBuilder()
    out.append("\"")
    for (var i = 0; i < len(s); i++) {
        var c = s.runes().nth(i)
        if (c == "\"") {
            out.append("\\\"")
        } else if (c == "\\") {
            out.append("\\\\")
        } else if (c == "\n") {
            out.append("\\n")
        } else if (c == "\r") {
            out.append("\\r")
        } else if (c == "\t") {
            out.append("\\t")
        } else {
            out.append(c)
        }
    }
    out.append("\"")
    return out.toString()
}

fn _jsonValue(value: JSON.Value) -> string {
    var t = typeName(value)
    if (t == "null") { return "null" }
    if (t == "bool") { return (value as bool) ? "true" : "false" }
    if (t == "i64" || t == "f64") { return string(value) }
    return _jsonEscape(string(value))
}

fn _needsQuote(s: string) -> bool {
    for (var i = 0; i < len(s); i++) {
        var c = s.runes().nth(i)
        if (c == " " || c == "\"" || c == "=" || c == "\n" || c == "\t") {
            return true
        }
    }
    return false
}

fn _message(args: Array<JSON.Value>) -> string {
    if (len(args) == 0) { return "" }
    return string(args[0])
}

fn _appendTextAttrs(out: ref StringBuilder, args: Array<JSON.Value>, start: i64) {
    var i = start
    while (i + 1 < len(args)) {
        var key = string(args[i])
        var val = string(args[i + 1])
        out.append(" ")
        out.append(key)
        out.append("=")
        if (_needsQuote(val)) {
            out.append("\"")
            out.append(val)
            out.append("\"")
        } else {
            out.append(val)
        }
        i = i + 2
    }
}

fn _appendJsonAttrs(out: ref StringBuilder, args: Array<JSON.Value>, start: i64) {
    var i = start
    while (i + 1 < len(args)) {
        out.append(",")
        out.append(_jsonEscape(string(args[i])))
        out.append(":")
        out.append(_jsonValue(args[i + 1]))
        i = i + 2
    }
}

fn _formatLine(logger: Logger, level: LogLevel, args: Array<JSON.Value>) -> string {
    var msg = _message(args)
    if (logger.format == LogFormat.JSON) {
        var out = StringBuilder()
        out.append("{\"level\":")
        out.append(_jsonEscape(_levelName(level)))
        out.append(",\"msg\":")
        out.append(_jsonEscape(msg))
        if (logger.source) { out.append(",\"source\":true") }
        if (len(logger.jsonContext) > 0) {
            out.append(",")
            out.append(logger.jsonContext)
        }
        _appendJsonAttrs(ref out, args, 1)
        out.append("}")
        return out.toString()
    }

    var out = StringBuilder()
    out.append(_levelName(level))
    if (logger.source) { out.append(" [source]") }
    if (len(msg) > 0) {
        out.append(" ")
        out.append(msg)
    }
    if (len(logger.textContext) > 0) {
        out.append(" ")
        out.append(logger.textContext)
    }
    _appendTextAttrs(ref out, args, 1)
    return out.toString()
}

fn _writeRaw(output: Path?, line: string) {
    if (output == null) {
        print(line)
    } else {
        io.appendFile(output!, line + "\n")
    }
}

fn _queueLine(line: string) {
    if (len(_asyncQueue) >= _QUEUE_LIMIT) {
        _dropped = _dropped + 1
        return
    }
    _asyncQueue.push(line)
}

fn _emit(logger: Logger, line: string) {
    if (logger.asyncMode) {
        _queueLine(line)
    } else {
        _writeRaw(logger.output, line)
    }
}

fn _logAt(logger: Logger, level: LogLevel, args: Array<JSON.Value>) {
    if (_levelValue(level) < _levelValue(logger.level)) { return }
    _emit(logger, _formatLine(logger, level, args))
}

fn _rootLogger() -> Logger {
    return Logger(_level, _format, _output, _source, _async, "", "")
}

fn _contextText(args: Array<JSON.Value>) -> string {
    var out = StringBuilder()
    _appendTextAttrs(ref out, args, 0)
    var s = out.toString()
    if (len(s) > 0 && s.runes().nth(0) == ' ') { return s.slice(1) }
    return s
}

fn _contextJson(args: Array<JSON.Value>) -> string {
    var out = StringBuilder()
    _appendJsonAttrs(ref out, args, 0)
    var s = out.toString()
    if (len(s) > 0 && s.runes().nth(0) == ',') { return s.slice(1) }
    return s
}

fn _joinContext(parent: string, child: string, sep: string) -> string {
    if (len(parent) == 0) { return child }
    if (len(child) == 0) { return parent }
    return parent + sep + child
}

fn _makeChild(parent: Logger, fields: Array<JSON.Value>) -> Logger {
    return Logger(
        parent.level,
        parent.format,
        parent.output,
        parent.source,
        parent.asyncMode,
        _joinContext(parent.jsonContext, _contextJson(fields), ","),
        _joinContext(parent.textContext, _contextText(fields), " ")
    )
}

export class Logger {
    level: LogLevel
    format: LogFormat
    output: Path?
    source: bool
    asyncMode: bool
    jsonContext: string
    textContext: string

    constructor(
        level: LogLevel = LogLevel.Info,
        format: LogFormat = LogFormat.Text,
        output: Path? = null,
        source: bool = false,
        asyncMode: bool = false,
        jsonContext: string = "",
        textContext: string = ""
    ) {
        this.level = level
        this.format = format
        this.output = output
        this.source = source
        this.asyncMode = asyncMode
        this.jsonContext = jsonContext
        this.textContext = textContext
    }

    debug(...args: JSON.Value) {
        _logAt(this, LogLevel.Debug, args)
    }

    info(...args: JSON.Value) {
        _logAt(this, LogLevel.Info, args)
    }

    warn(...args: JSON.Value) {
        _logAt(this, LogLevel.Warn, args)
    }

    error(...args: JSON.Value) {
        _logAt(this, LogLevel.Error, args)
    }

    fatal(...args: JSON.Value) {
        _logAt(this, LogLevel.Fatal, args)
        flush()
        os.exit(1)
    }

    child(...fields: JSON.Value) -> Logger {
        return _makeChild(this, fields)
    }
}

export fn debug(...args: JSON.Value) {
    _logAt(_rootLogger(), LogLevel.Debug, args)
}

export fn info(...args: JSON.Value) {
    _logAt(_rootLogger(), LogLevel.Info, args)
}

export fn warn(...args: JSON.Value) {
    _logAt(_rootLogger(), LogLevel.Warn, args)
}

export fn error(...args: JSON.Value) {
    _logAt(_rootLogger(), LogLevel.Error, args)
}

export fn fatal(...args: JSON.Value) {
    _logAt(_rootLogger(), LogLevel.Fatal, args)
    flush()
    os.exit(1)
}

export fn setLevel(level: LogLevel) {
    _level = level
}

export fn setFormat(format: LogFormat) {
    _format = format
}

export fn setOutput(path: Path) {
    flush()
    _output = path
}

export fn isEnabled(level: LogLevel) -> bool {
    return _levelValue(level) >= _levelValue(_level)
}

export fn enableSource(enabled: bool = true) {
    _source = enabled
}

export fn enableAsync(enabled: bool = true) {
    if (!enabled && _async) { flush() }
    _async = enabled
}

export fn flush() {
    while (len(_asyncQueue) > 0) {
        var line = _asyncQueue.shift() ?? ""
        _writeRaw(_output, line)
    }
    if (_dropped > 0) {
        _writeRaw(_output, "[log] dropped=" + string(_dropped))
        _dropped = 0
    }
}

export fn child(...fields: JSON.Value) -> Logger {
    return _makeChild(_rootLogger(), fields)
}
