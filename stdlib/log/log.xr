import text

// log - pure-Xray structured logging surface.
//
// The C side only anchors `import log`. Logger state, formatting, child context,
// level filtering, file output, and fatal exit semantics live here.

import io
import os

export enum LogLevel {
    Debug,
    Info,
    Warn,
    Error,
    Fatal
}

export enum LogFormat {
    Text,
    JSON
}

const _QUEUE_LIMIT = 256

var _level = LogLevel.Info
var _format = LogFormat.Text
var _output: Path? = null
var _source = false
var _async = false
var _asyncQueue: Array<string> = []
var _dropped = 0

fn _levelValue(level: LogLevel) -> i64 {
    return match (level) {
        LogLevel.Debug => 0,
        LogLevel.Info  => 1,
        LogLevel.Warn  => 2,
        LogLevel.Error => 3,
        LogLevel.Fatal => 4,
    }
}

fn _levelName(level: LogLevel) -> string {
    return match (level) {
        LogLevel.Debug => "DEBUG",
        LogLevel.Info  => "INFO",
        LogLevel.Warn  => "WARN",
        LogLevel.Error => "ERROR",
        LogLevel.Fatal => "FATAL",
    }
}

fn _jsonEscape(s: string) -> string {
    var out = ""
    out += "\""
    for (var i = 0; i < len(s); i++) {
        var c = s.runes().nth(i)
        if (c == '"') {
            out += "\\\""
        } else if (c == '\\') {
            out += "\\\\"
        } else if (c == '\n') {
            out += "\\n"
        } else if (c == '\r') {
            out += "\\r"
        } else if (c == '\t') {
            out += "\\t"
        } else {
            out += "${c}"
        }
    }
    out += "\""
    return out
}

fn _jsonValue(value: JSON.Value) -> string {
    return JSON.stringify(value)
}

fn _needsQuote(s: string) -> bool {
    for (var i = 0; i < len(s); i++) {
        var c = s.runes().nth(i)
        if (c == ' ' || c == '"' || c == '=' || c == '\n' || c == '\t') {
            return true
        }
    }
    return false
}

fn _appendTextAttrs(out: ref string, fields: JSON.Object) {
    for (key, value in fields) {
        var val = string(value)
        out += " "
        out += key
        out += "="
        if (_needsQuote(val)) {
            out += "\""
            out += val
            out += "\""
        } else {
            out += val
        }
    }
}

fn _appendJsonAttrs(out: ref string, fields: JSON.Object) {
    for (key, value in fields) {
        out += ","
        out += _jsonEscape(key)
        out += ":"
        out += _jsonValue(value)
    }
}

fn _formatLine(logger: Logger, level: LogLevel, message: string, fields: JSON.Object) -> string {
    if (logger.format == LogFormat.JSON) {
        var out = ""
        out += "{\"level\":"
        out += _jsonEscape(_levelName(level))
        out += ",\"msg\":"
        out += _jsonEscape(message)
        if (logger.source) { out += ",\"source\":true" }
        if (len(logger.jsonContext) > 0) {
            out += ","
            out += logger.jsonContext
        }
        _appendJsonAttrs(ref out, fields)
        out += "}"
        return out
    }

    var out = ""
    out += _levelName(level)
    if (logger.source) { out += " [source]" }
    if (len(message) > 0) {
        out += " "
        out += message
    }
    if (len(logger.textContext) > 0) {
        out += " "
        out += logger.textContext
    }
    _appendTextAttrs(ref out, fields)
    return out
}

fn _writeRaw(output: Path?, line: string) {
    if (output == null) {
        print(line)
    } else {
        io.appendFile(output!, line + "\n")
    }
}

fn _queueLine(line: string) {
    if (len(_asyncQueue) >= _QUEUE_LIMIT) {
        _dropped = _dropped + 1
        return
    }
    _asyncQueue.push(line)
}

fn _emit(logger: Logger, line: string) {
    if (logger.asyncMode) {
        _queueLine(line)
    } else {
        _writeRaw(logger.output, line)
    }
}

fn _logAt(logger: Logger, level: LogLevel, message: string, fields: JSON.Object) {
    if (_levelValue(level) < _levelValue(logger.level)) { return }
    _emit(logger, _formatLine(logger, level, message, fields))
}

fn _rootLogger() -> Logger {
    return Logger(_level, _format, _output, _source, _async, "", "")
}

fn _contextText(fields: JSON.Object) -> string {
    var out = ""
    _appendTextAttrs(ref out, fields)
    var s = out
    if (len(s) > 0 && s.runes().nth(0) == ' ') { return s.slice(1) }
    return s
}

fn _contextJson(fields: JSON.Object) -> string {
    var out = ""
    _appendJsonAttrs(ref out, fields)
    var s = out
    if (len(s) > 0 && s.runes().nth(0) == ',') { return s.slice(1) }
    return s
}

fn _joinContext(parent: string, child: string, sep: string) -> string {
    if (len(parent) == 0) { return child }
    if (len(child) == 0) { return parent }
    return parent + sep + child
}

fn _makeChild(parent: Logger, fields: JSON.Object) -> Logger {
    return Logger(
        parent.level,
        parent.format,
        parent.output,
        parent.source,
        parent.asyncMode,
        _joinContext(parent.jsonContext, _contextJson(fields), ","),
        _joinContext(parent.textContext, _contextText(fields), " ")
    )
}

export class Logger {
    level: LogLevel
    format: LogFormat
    output: Path?
    source: bool
    asyncMode: bool
    jsonContext: string
    textContext: string

    init(
        level: LogLevel = LogLevel.Info,
        format: LogFormat = LogFormat.Text,
        output: Path? = null,
        source: bool = false,
        asyncMode: bool = false,
        jsonContext: string = "",
        textContext: string = ""
    ) {
        this.level = level
        this.format = format
        this.output = output
        this.source = source
        this.asyncMode = asyncMode
        this.jsonContext = jsonContext
        this.textContext = textContext
    }

    debug(message: string, fields: JSON.Object = {}) {
        _logAt(this, LogLevel.Debug, message, fields)
    }

    info(message: string, fields: JSON.Object = {}) {
        _logAt(this, LogLevel.Info, message, fields)
    }

    warn(message: string, fields: JSON.Object = {}) {
        _logAt(this, LogLevel.Warn, message, fields)
    }

    error(message: string, fields: JSON.Object = {}) {
        _logAt(this, LogLevel.Error, message, fields)
    }

    fatal(message: string, fields: JSON.Object = {}) {
        _logAt(this, LogLevel.Fatal, message, fields)
        flush()
        os.exit(1)
    }

    child(fields: JSON.Object) -> Logger {
        return _makeChild(this, fields)
    }
}

export fn debug(message: string, fields: JSON.Object = {}) {
    _logAt(_rootLogger(), LogLevel.Debug, message, fields)
}

export fn info(message: string, fields: JSON.Object = {}) {
    _logAt(_rootLogger(), LogLevel.Info, message, fields)
}

export fn warn(message: string, fields: JSON.Object = {}) {
    _logAt(_rootLogger(), LogLevel.Warn, message, fields)
}

export fn error(message: string, fields: JSON.Object = {}) {
    _logAt(_rootLogger(), LogLevel.Error, message, fields)
}

export fn fatal(message: string, fields: JSON.Object = {}) {
    _logAt(_rootLogger(), LogLevel.Fatal, message, fields)
    flush()
    os.exit(1)
}

export fn setLevel(level: LogLevel) {
    _level = level
}

export fn setFormat(format: LogFormat) {
    _format = format
}

export fn setOutput(path: Path) {
    flush()
    _output = path
}

export fn isEnabled(level: LogLevel) -> bool {
    return _levelValue(level) >= _levelValue(_level)
}

export fn enableSource(enabled: bool = true) {
    _source = enabled
}

export fn enableAsync(enabled: bool = true) {
    if (!enabled && _async) { flush() }
    _async = enabled
}

export fn flush() {
    while (len(_asyncQueue) > 0) {
        var line = _asyncQueue.shift() ?? ""
        _writeRaw(_output, line)
    }
    if (_dropped > 0) {
        _writeRaw(_output, "[log] dropped=" + string(_dropped))
        _dropped = 0
    }
}

export fn child(fields: JSON.Object) -> Logger {
    return _makeChild(_rootLogger(), fields)
}
