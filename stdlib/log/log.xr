// log - pure-Xray structured logging surface.
//
// The C side only anchors `import log`. Logger state, formatting, child context,
// level filtering, file output, and fatal exit semantics live here.

import io
import os

const DEBUG = 10
const INFO = 20
const WARN = 30
const ERROR = 40
const FATAL = 50

const _QUEUE_LIMIT = 256

var _level = INFO
var _format = "text"
var _output = "stderr"
var _source = false
var _async = false
var _asyncQueue: Array<string> = []
var _dropped = 0

fn _levelName(level: int) -> string {
    if (level == DEBUG) { return "DEBUG" }
    if (level == INFO) { return "INFO" }
    if (level == WARN) { return "WARN" }
    if (level == ERROR) { return "ERROR" }
    if (level == FATAL) { return "FATAL" }
    return "UNKNOWN"
}

fn _parseLevel(value: unknown) -> int {
    if (typeName(value) == "int") { return value }
    var name = string(value).toLowerCase()
    if (name == "debug") { return DEBUG }
    if (name == "info") { return INFO }
    if (name == "warn" || name == "warning") { return WARN }
    if (name == "error") { return ERROR }
    if (name == "fatal") { return FATAL }
    return INFO
}

fn _jsonEscape(s: string) -> string {
    var out = StringBuilder()
    out.append("\"")
    for (var i = 0; i < len(s); i++) {
        var c = s.charAt(i)
        if (c == "\"") {
            out.append("\\\"")
        } else if (c == "\\") {
            out.append("\\\\")
        } else if (c == "\n") {
            out.append("\\n")
        } else if (c == "\r") {
            out.append("\\r")
        } else if (c == "\t") {
            out.append("\\t")
        } else {
            out.append(c)
        }
    }
    out.append("\"")
    return out.toString()
}

fn _jsonValue(value: unknown) -> string {
    var t = typeName(value)
    if (t == "null") { return "null" }
    if (t == "bool") { return value ? "true" : "false" }
    if (t == "int" || t == "float") { return string(value) }
    return _jsonEscape(string(value))
}

fn _needsQuote(s: string) -> bool {
    for (var i = 0; i < len(s); i++) {
        var c = s.charAt(i)
        if (c == " " || c == "\"" || c == "=" || c == "\n" || c == "\t") {
            return true
        }
    }
    return false
}

fn _message(args: Array<unknown>) -> string {
    if (len(args) == 0) { return "" }
    return string(args[0])
}

fn _appendTextAttrs(out: StringBuilder, args: Array<unknown>, start: int) {
    var i = start
    while (i + 1 < len(args)) {
        var key = string(args[i])
        var val = string(args[i + 1])
        out.append(" ")
        out.append(key)
        out.append("=")
        if (_needsQuote(val)) {
            out.append("\"")
            out.append(val)
            out.append("\"")
        } else {
            out.append(val)
        }
        i = i + 2
    }
}

fn _appendJsonAttrs(out: StringBuilder, args: Array<unknown>, start: int) {
    var i = start
    while (i + 1 < len(args)) {
        out.append(",")
        out.append(_jsonEscape(string(args[i])))
        out.append(":")
        out.append(_jsonValue(args[i + 1]))
        i = i + 2
    }
}

fn _formatLine(logger: Logger, level: int, args: Array<unknown>) -> string {
    var msg = _message(args)
    if (logger.format == "json") {
        var out = StringBuilder()
        out.append("{\"level\":")
        out.append(_jsonEscape(_levelName(level)))
        out.append(",\"msg\":")
        out.append(_jsonEscape(msg))
        if (logger.source) { out.append(",\"source\":true") }
        if (len(logger.jsonContext) > 0) {
            out.append(",")
            out.append(logger.jsonContext)
        }
        _appendJsonAttrs(out, args, 1)
        out.append("}")
        return out.toString()
    }

    var out = StringBuilder()
    out.append(_levelName(level))
    if (logger.source) { out.append(" [source]") }
    if (len(msg) > 0) {
        out.append(" ")
        out.append(msg)
    }
    if (len(logger.textContext) > 0) {
        out.append(" ")
        out.append(logger.textContext)
    }
    _appendTextAttrs(out, args, 1)
    return out.toString()
}

fn _writeRaw(output: string, line: string) {
    if (output == "stdout" || output == "stderr" || len(output) == 0) {
        print(line)
    } else {
        io.appendFile(output, line + "\n")
    }
}

fn _queueLine(line: string) {
    if (len(_asyncQueue) >= _QUEUE_LIMIT) {
        _dropped = _dropped + 1
        return
    }
    _asyncQueue.push(line)
}

fn _emit(logger: Logger, line: string) {
    if (logger.asyncMode) {
        _queueLine(line)
    } else {
        _writeRaw(logger.output, line)
    }
}

fn _logAt(logger: Logger, level: int, args: Array<unknown>) {
    if (level < logger.level) { return }
    _emit(logger, _formatLine(logger, level, args))
}

fn _rootLogger() -> Logger {
    return Logger(_level, _format, _output, _source, _async, "", "")
}

fn _contextText(args: Array<unknown>) -> string {
    var out = StringBuilder()
    _appendTextAttrs(out, args, 0)
    var s = out.toString()
    if (len(s) > 0 && s.charAt(0) == " ") { return s.slice(1) }
    return s
}

fn _contextJson(args: Array<unknown>) -> string {
    var out = StringBuilder()
    _appendJsonAttrs(out, args, 0)
    var s = out.toString()
    if (len(s) > 0 && s.charAt(0) == ",") { return s.slice(1) }
    return s
}

fn _joinContext(parent: string, child: string, sep: string) -> string {
    if (len(parent) == 0) { return child }
    if (len(child) == 0) { return parent }
    return parent + sep + child
}

fn _makeChild(parent: Logger, fields: Array<unknown>) -> Logger {
    return Logger(
        parent.level,
        parent.format,
        parent.output,
        parent.source,
        parent.asyncMode,
        _joinContext(parent.jsonContext, _contextJson(fields), ","),
        _joinContext(parent.textContext, _contextText(fields), " ")
    )
}

class Logger {
    level: int
    format: string
    output: string
    source: bool
    asyncMode: bool
    jsonContext: string
    textContext: string

    constructor(
        level: int = INFO,
        format: string = "text",
        output: string = "stderr",
        source: bool = false,
        asyncMode: bool = false,
        jsonContext: string = "",
        textContext: string = ""
    ) {
        this.level = level
        this.format = format
        this.output = output
        this.source = source
        this.asyncMode = asyncMode
        this.jsonContext = jsonContext
        this.textContext = textContext
    }

    debug(...args: unknown) {
        _logAt(this, DEBUG, args)
    }

    info(...args: unknown) {
        _logAt(this, INFO, args)
    }

    warn(...args: unknown) {
        _logAt(this, WARN, args)
    }

    error(...args: unknown) {
        _logAt(this, ERROR, args)
    }

    fatal(...args: unknown) {
        _logAt(this, FATAL, args)
        flush()
        os.exit(1)
    }

    child(...fields: unknown) -> Logger {
        return _makeChild(this, fields)
    }
}

fn debug(...args: unknown) {
    _logAt(_rootLogger(), DEBUG, args)
}

fn info(...args: unknown) {
    _logAt(_rootLogger(), INFO, args)
}

fn warn(...args: unknown) {
    _logAt(_rootLogger(), WARN, args)
}

fn error(...args: unknown) {
    _logAt(_rootLogger(), ERROR, args)
}

fn fatal(...args: unknown) {
    _logAt(_rootLogger(), FATAL, args)
    flush()
    os.exit(1)
}

fn setLevel(level: unknown) {
    _level = _parseLevel(level)
}

fn setFormat(format: string) {
    var f = format.toLowerCase()
    if (f == "json") {
        _format = "json"
    } else {
        _format = "text"
    }
}

fn setOutput(path: string) {
    flush()
    _output = path
}

fn isEnabled(level: int) -> bool {
    return level >= _level
}

fn enableSource(enabled: bool = true) {
    _source = enabled
}

fn enableAsync(enabled: bool = true) {
    if (!enabled && _async) { flush() }
    _async = enabled
}

fn flush() {
    while (len(_asyncQueue) > 0) {
        var line = _asyncQueue.shift() ?? ""
        _writeRaw(_output, line)
    }
    if (_dropped > 0) {
        _writeRaw(_output, "[log] dropped=" + string(_dropped))
        _dropped = 0
    }
}

fn child(...fields: unknown) -> Logger {
    return _makeChild(_rootLogger(), fields)
}

export {
    DEBUG,
    INFO,
    WARN,
    ERROR,
    FATAL,
    Logger,
    debug,
    info,
    warn,
    error,
    fatal,
    setLevel,
    setFormat,
    setOutput,
    isEnabled,
    enableSource,
    enableAsync,
    flush,
    child
}
