// parallel — structured CPU batch parallelism public API.
//
// This file is the canonical user surface and bootstrap/reference semantics.
// Hosted VM/AOT calls to these exports are expected to lower to XI_PAR_* once
// the intrinsic pass is enabled; the bodies below intentionally stay simple so
// stdlib bootstrap, module export scans, and type checking have a source truth.
export enum ParallelError {
    NegativeWorkers,
    ClosedPlan,
    ConcurrentDispatch
}

export class Options {
    workers: i64

    constructor(workers: i64 = 0) {
        this.workers = workers
    }
}

fn _checkOptions(options: Options) {
    if (options.workers < 0) {
        throw ParallelError.NegativeWorkers
    }
}

fn _referenceLaneCount(options: Options) -> i64 {
    _checkOptions(options)
    if (options.workers > 0) {
        return options.workers
    }
    return 1
}
export fn forEach(range: Range, body: fn(i64), options: Options = Options()) {
    _checkOptions(options)
    for (offset in 0..range.count()) {
        body(range[offset])
    }
}
export fn map<T>(range: Range, body: fn(i64) -> T, options: Options = Options()) -> Array<T> {
    _checkOptions(options)
    var out: Array<T> = []
    for (offset in 0..range.count()) {
        out.push(body(range[offset]))
    }
    return out
}
export fn mapInto<T>(range: Range, output: ref Array<T>, body: fn(i64) -> T, options: Options = Options()) {
    _checkOptions(options)
    output.clear()
    for (offset in 0..range.count()) {
        output.push(body(range[offset]))
    }
}
export fn reduce<A>(range: Range, initial: A, body: fn(i64) -> A, combine: fn(A, A) -> A, options: Options = Options()) -> A {
    _checkOptions(options)
    var acc = initial
    for (offset in 0..range.count()) {
        acc = combine(acc, body(range[offset]))
    }
    return acc
}

export class Plan<S> {
    options: Options
    private _states: Array<S>
    private _closed: bool
    private _active: bool
    private _releasePending: bool

    constructor(options: Options, init: fn(i64) -> S) {
        var laneCount = _referenceLaneCount(options)
        var states: Array<S> = []
        for (lane in 0..laneCount) {
            states.push(init(lane))
        }
        this.options = options
        this._states = states
        this._closed = false
        this._active = false
        this._releasePending = false
    }

    private _begin() {
        if (this._closed) {
            throw ParallelError.ClosedPlan
        }
        if (this._active) {
            throw ParallelError.ConcurrentDispatch
        }
        this._active = true
    }

    private _end() {
        this._active = false
        if (this._releasePending) {
            this._states.clear()
            this._releasePending = false
        }
    }

    private _stateFor(offset: i64) -> S {
        var laneCount = len(this._states)
        var lane = offset % laneCount
        return this._states[lane]
    }
    forEach(range: Range, body: fn(S, i64)) {
        this._begin()
        defer {
            this._end()
        }
        for (offset in 0..len(range)) {
            body(this._stateFor(offset), range[offset])
        }
    }
    map<T>(range: Range, body: fn(S, i64) -> T) -> Array<T> {
        this._begin()
        defer {
            this._end()
        }
        var out: Array<T> = []
        for (offset in 0..len(range)) {
            out.push(body(this._stateFor(offset), range[offset]))
        }
        return out
    }
    mapInto<T>(range: Range, output: ref Array<T>, body: fn(S, i64) -> T) {
        this._begin()
        defer {
            this._end()
        }
        output.clear()
        for (offset in 0..len(range)) {
            output.push(body(this._stateFor(offset), range[offset]))
        }
    }
    reduce<A>(range: Range, initial: A, body: fn(S, i64) -> A, combine: fn(A, A) -> A) -> A {
        this._begin()
        defer {
            this._end()
        }
        var acc = initial
        for (offset in 0..len(range)) {
            acc = combine(acc, body(this._stateFor(offset), range[offset]))
        }
        return acc
    }

    close() {
        if (!this._closed) {
            this._closed = true
            if (this._active) {
                this._releasePending = true
            } else {
                this._states.clear()
            }
        }
    }
}
