// parallel — structured CPU batch parallelism public API.
//
// This file is the canonical user surface and bootstrap/reference semantics.
// Hosted VM/AOT calls to these exports are expected to lower to XI_PAR_* once
// the intrinsic pass is enabled; the bodies below intentionally stay simple so
// stdlib bootstrap, module export scans, and type checking have a source truth.

enum ParallelError {
    NegativeWorkers,
    ClosedPlan,
    ConcurrentDispatch
}

class Options {
    workers: int

    constructor(workers: int = 0) {
        this.workers = workers
    }
}

fn _checkOptions(options: Options) {
    if (options.workers < 0) {
        throw ParallelError.NegativeWorkers
    }
}

fn _referenceLaneCount(options: Options) -> int {
    _checkOptions(options)
    if (options.workers > 0) {
        return options.workers
    }
    return 1
}

fn forEach(range: Range, body: (int) -> (), options: Options = Options()) {
    _checkOptions(options)
    for (offset in 0..range.count()) {
        body(range[offset])
    }
}

fn map<T>(range: Range, body: (int) -> T, options: Options = Options()) -> Array<T> {
    _checkOptions(options)
    var out: Array<T> = []
    for (offset in 0..range.count()) {
        out.push(body(range[offset]))
    }
    return out
}

fn mapInto<T>(
    range: Range,
    output: Array<T>,
    body: (int) -> T,
    options: Options = Options()
) -> Array<T> {
    _checkOptions(options)
    output.clear()
    for (offset in 0..range.count()) {
        output.push(body(range[offset]))
    }
    return output
}

fn reduce<A>(
    range: Range,
    initial: A,
    body: (int) -> A,
    combine: (A, A) -> A,
    options: Options = Options()
) -> A {
    _checkOptions(options)
    var acc = initial
    for (offset in 0..range.count()) {
        acc = combine(acc, body(range[offset]))
    }
    return acc
}

class Plan<S> {
    options: Options
    private _states: Array<S>
    private _closed: bool
    private _active: bool
    private _releasePending: bool

    constructor(options: Options, init: (int) -> S) {
        var laneCount = _referenceLaneCount(options)
        var states: Array<S> = []
        for (lane in 0..laneCount) {
            states.push(init(lane))
        }
        this.options = options
        this._states = states
        this._closed = false
        this._active = false
        this._releasePending = false
    }

    private _begin() {
        if (this._closed) {
            throw ParallelError.ClosedPlan
        }
        if (this._active) {
            throw ParallelError.ConcurrentDispatch
        }
        this._active = true
    }

    private _end() {
        this._active = false
        if (this._releasePending) {
            this._states.clear()
            this._releasePending = false
        }
    }

    private _stateFor(offset: int) -> S {
        var laneCount = len(this._states)
        var lane = offset % laneCount
        return this._states[lane]
    }

    forEach(range: Range, body: (S, int) -> ()) {
        this._begin()
        defer { this._end() }
        for (offset in 0..len(range)) {
            body(this._stateFor(offset), range[offset])
        }
    }

    map<T>(range: Range, body: (S, int) -> T) -> Array<T> {
        this._begin()
        defer { this._end() }
        var out: Array<T> = []
        for (offset in 0..len(range)) {
            out.push(body(this._stateFor(offset), range[offset]))
        }
        return out
    }

    mapInto<T>(range: Range, output: Array<T>, body: (S, int) -> T) -> Array<T> {
        this._begin()
        defer { this._end() }
        output.clear()
        for (offset in 0..len(range)) {
            output.push(body(this._stateFor(offset), range[offset]))
        }
        return output
    }

    reduce<A>(range: Range, initial: A, body: (S, int) -> A, combine: (A, A) -> A) -> A {
        this._begin()
        defer { this._end() }
        var acc = initial
        for (offset in 0..len(range)) {
            acc = combine(acc, body(this._stateFor(offset), range[offset]))
        }
        return acc
    }

    close() {
        if (!this._closed) {
            this._closed = true
            if (this._active) {
                this._releasePending = true
            } else {
                this._states.clear()
            }
        }
    }
}

export { Options, Plan, ParallelError, forEach, map, mapInto, reduce }
