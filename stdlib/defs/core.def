module cluster {
  enum ClusterDelivery {
    variants: "Accepted, InvalidTopic, InvalidEnvelope, Unavailable, Overloaded, Disconnected"
    doc: "Outcome of handing one opaque service envelope to the cluster transport"
  }

  enum ClusterNodeState {
    variants: "Idle, Connecting, Handshaking, Connected, Closing"
    doc: "Lifecycle state of a remote cluster node"
  }

  object ClusterTlsStatus {
    fields: "const enabled: bool, const clientReady: bool, const serverReady: bool"
    exact: true
    doc: "Effective TLS posture of a running cluster node"
  }

  object ClusterNodeInfo {
    fields: "const name: string, const host: string, const port: i64, const state: ClusterNodeState, const framesSent: i64, const framesReceived: i64, const bytesSent: i64, const bytesReceived: i64, const sendErrors: i64, const slowConsumerEvents: i64, const rttMs: i64, const outQueueBytes: i64, const outQueueFrames: i64, const slow: bool, const phi: f64, const missedHeartbeats: i64"
    exact: true
    doc: "Typed diagnostic snapshot for one remote cluster node"
  }

  object ClusterInfo {
    fields: "const self: string, const port: i64, const running: bool, const nodes: Array<ClusterNodeInfo>, const listeners: i64, const deadNodes: i64, const heartbeatIntervalMs: i64, const heartbeatTimeoutMs: i64, const maxMissedHeartbeats: i64, const tls: ClusterTlsStatus"
    exact: true
    doc: "Typed diagnostic snapshot for the local cluster runtime"
  }

  fn __start {
    signature: "(name: string, port: i64, secret: string, tlsEnabled: bool, caFile: string, certFile: string, keyFile: string, insecure: bool): bool"
    doc: "Start the backend-neutral cluster runtime from normalized scalar configuration"
    vm: "cluster_start_primitive"
    argc: 8
    arg_spec: "svsvsssv"
    aot: "xrt_cluster_start"
    aot_direct: true
    link_object: true
    layer: "runtime"
    caps: "channel"
  }

  fn __join {
    signature: "(addr: string): bool"
    doc: "Join cluster by address without blocking the scheduler worker"
    vm: "cluster_join"
    vm_binding: "yieldable"
    argc: 1
    arg_spec: "s"
    aot: "xrt_cluster_join"
    aot_direct: true
    link_object: true
    layer: "runtime"
    caps: "channel"
  }

  fn self {
    signature: "(): string"
    doc: "Get own node name"
    vm: "cluster_self"
    argc: 0
    arg_spec: ""
    aot_direct: false
    link_object: false
    layer: "runtime"
    return_ownership: "fresh"
  }

  fn nodes {
    signature: "(): Array<string>"
    doc: "List cluster node names"
    vm: "cluster_nodes"
    argc: 0
    arg_spec: ""
    aot_direct: false
    link_object: false
    layer: "runtime"
    return_ownership: "fresh"
  }

  fn monitor {
    signature: "(name: string, coro_name?: string): Channel"
    doc: "Monitor node or remote coroutine"
    vm: "cluster_monitor_coro_fn"
    argc: 2
    arg_spec: "vv"
    aot_direct: false
    link_object: false
    layer: "runtime"
    return_ownership: "fresh"
  }

  fn discover {
    signature: "(): ()"
    doc: "Start LAN auto-discovery"
    vm: "cluster_discover_fn"
    argc: 0
    arg_spec: ""
    aot_direct: false
    link_object: false
    layer: "runtime"
  }

  fn __stop {
    signature: "(): ()"
    doc: "Stop cluster node"
    vm: "cluster_stop_fn"
    argc: 0
    arg_spec: ""
    aot: "xrt_cluster_stop"
    aot_direct: true
    link_object: true
    layer: "runtime"
    caps: "channel"
  }

  fn info {
    signature: "(): ClusterInfo?"
    doc: "Get cluster status info"
    vm: "cluster_info_fn"
    argc: 0
    arg_spec: ""
    aot_direct: false
    link_object: false
    layer: "runtime"
    return_ownership: "fresh"
  }

  fn send {
    signature: "(topic: string, envelope: move Buffer): ClusterDelivery"
    doc: "Hand one canonical opaque service envelope to local and connected transports"
    vm: "cluster_send_primitive"
    argc: 2
    arg_spec: "sv"
    aot: "xrt_cluster_send"
    ret: "enum_i64"
    aot_enum: "ClusterDelivery"
    aot_direct: true
    link_object: true
    layer: "runtime"
    caps: "channel"
    effect: "nothrow"
    allocation: "may_heap"
    return_ownership: "borrowed_static"
  }

  fn __listen {
    signature: "(pattern: string, capacity: i64): Channel<Buffer>?"
    doc: "Create a bounded receiver for opaque canonical service envelopes"
    vm: "cluster_listen_fn"
    argc: 2
    arg_spec: "sv"
    aot: "xrt_cluster_listen"
    aot_direct: true
    link_object: true
    layer: "runtime"
    return_ownership: "fresh"
    caps: "channel"
  }
