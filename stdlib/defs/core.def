module path {
  handle PathInfo {
    fields: "const root: string, const dir: string, const base: string, const name: string, const ext: string"
  }

  const sep {
    signature: ": string"
    doc: "Platform path separator"
    vm: "path.sep"
    vm_value: "xrs_string_value_c(isolate, xr_path_core_sep_str())"
    aot_const: "helper_value"
    aot: "xrt_path_sep"
    layer: "core"
  }

  const delimiter {
    signature: ": string"
    doc: "Platform path-list delimiter"
    vm: "path.delimiter"
    vm_value: "xrs_string_value_c(isolate, xr_path_core_delimiter_str())"
    aot_const: "helper_value"
    aot: "xrt_path_delimiter"
    layer: "core"
  }

  fn join {
    signature: "(...parts: string): string"
    doc: "Join path segments"
    vm: "path_join"
    aot: "xrt_path_join"
    argc: variadic
    arg_spec: "*"
    aot_direct: true
    link_object: false
    layer: "core"
  }

  fn isAbsolute {
    signature: "(path: string): bool"
    doc: "Check if path is absolute"
    vm: "path_isAbsolute"
    aot: "xrt_path_is_absolute"
    argc: 1
    arg_spec: "s"
    aot_direct: true
    link_object: false
    layer: "core"
  }

  fn dirname {
    signature: "(path: string): string"
    doc: "Get directory name"
