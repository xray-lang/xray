// simd — portable fixed-width integer vectors.
//
// These source bodies are the scalar semantic truth used by the VM and by
// unsupported AOT targets. Compiler-owned @intrinsic identities map the same
// operations to typed Xi vector ops without relying on paths or source names.
export struct U8x16 align(16) {
    private _lanes: [byte; 16]

    @no_alloc
    static fromLanes(lanes: [byte; 16]) -> U8x16 {
        return U8x16{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U8x16.splat")
    @no_alloc
    static splat(value: byte) -> U8x16 {
        return U8x16{_lanes: [value; 16]}
    }

    @intrinsic("simd.U8x16.load")
    @no_alloc
    static load(data: Slice<byte>, offset: int = 0) -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 16) {
            lanes[i] = data[offset + i]
            i += 1
        }
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.store")
    @no_alloc
    store(output: ref Slice<byte>, offset: int = 0) {
        var i = 0
        while (i < 16) {
            output[offset + i] = this._lanes[i]
            i += 1
        }
    }

    @intrinsic("simd.U8x16.extract")
    @no_alloc
    extract(lane: int) -> byte {
        return this._lanes[lane]
    }

    @intrinsic("simd.U8x16.replace")
    @no_alloc
    replace(lane: int, value: byte) -> U8x16 {
        var lanes = copy(this._lanes)
        lanes[lane] = value
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.bitAnd")
    @no_alloc
    bitAnd(other: U8x16) -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 16) {
            lanes[i] = this._lanes[i] & other._lanes[i]
            i += 1
        }
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.bitOr")
    @no_alloc
    bitOr(other: U8x16) -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 16) {
            lanes[i] = this._lanes[i] | other._lanes[i]
            i += 1
        }
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.bitXor")
    @no_alloc
    bitXor(other: U8x16) -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 16) {
            lanes[i] = this._lanes[i] ^ other._lanes[i]
            i += 1
        }
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.bitNot")
    @no_alloc
    bitNot() -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 16) {
            lanes[i] = ~this._lanes[i]
            i += 1
        }
        return U8x16{_lanes: lanes}
    }

    @intrinsic("simd.U8x16.reinterpretU32")
    @no_alloc
    reinterpretU32() -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            var base = i * 4
            lanes[i] = (this._lanes[base] as uint32) | ((this._lanes[base + 1] as uint32) << 8) | ((this._lanes[base + 2] as uint32) << 16) | ((this._lanes[base + 3] as uint32) << 24)
            i += 1
        }
        return U32x4.fromLanes(lanes)
    }

    @intrinsic("simd.U8x16.reinterpretU64")
    @no_alloc
    reinterpretU64() -> U64x2 {
        var lanes: [uint64; 2] = [0; 2]
        var i = 0
        while (i < 2) {
            var base = i * 8
            lanes[i] = (this._lanes[base] as uint64) | ((this._lanes[base + 1] as uint64) << 8) | ((this._lanes[base + 2] as uint64) << 16) | ((this._lanes[base + 3] as uint64) << 24) | ((this._lanes[base + 4] as uint64) << 32) | ((this._lanes[base + 5] as uint64) << 40) | ((this._lanes[base + 6] as uint64) << 48) | ((this._lanes[base + 7] as uint64) << 56)
            i += 1
        }
        return U64x2.fromLanes(lanes)
    }
}

export struct U32x4 align(16) {
    private _lanes: [uint32; 4]

    @no_alloc
    static fromLanes(lanes: [uint32; 4]) -> U32x4 {
        return U32x4{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U32x4.splat")
    @no_alloc
    static splat(value: uint32) -> U32x4 {
        return U32x4{_lanes: [value; 4]}
    }

    @intrinsic("simd.U32x4.load")
    @no_alloc
    static load(data: Slice<uint32>, offset: int = 0) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = data[offset + i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.store")
    @no_alloc
    store(output: ref Slice<uint32>, offset: int = 0) {
        var i = 0
        while (i < 4) {
            output[offset + i] = this._lanes[i]
            i += 1
        }
    }

    @intrinsic("simd.U32x4.extract")
    @no_alloc
    extract(lane: int) -> uint32 {
        return this._lanes[lane]
    }

    @intrinsic("simd.U32x4.replace")
    @no_alloc
    replace(lane: int, value: uint32) -> U32x4 {
        var lanes = copy(this._lanes)
        lanes[lane] = value
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.add")
    @no_alloc
    add(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] + other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.sub")
    @no_alloc
    sub(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] - other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.mul")
    @no_alloc
    mul(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] * other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.bitAnd")
    @no_alloc
    bitAnd(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] & other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.bitOr")
    @no_alloc
    bitOr(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] | other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.bitXor")
    @no_alloc
    bitXor(other: U32x4) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] ^ other._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.bitNot")
    @no_alloc
    bitNot() -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = ~this._lanes[i]
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.shiftLeft")
    @no_alloc
    shiftLeft(bits: int) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] << bits
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.shiftRight")
    @no_alloc
    shiftRight(bits: int) -> U32x4 {
        var lanes: [uint32; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            lanes[i] = this._lanes[i] >> bits
            i += 1
        }
        return U32x4{_lanes: lanes}
    }

    @intrinsic("simd.U32x4.shuffle")
    @no_alloc
    shuffle(i0: int, i1: int, i2: int, i3: int) -> U32x4 {
        return U32x4{_lanes: [this._lanes[i0], this._lanes[i1], this._lanes[i2], this._lanes[i3]]}
    }

    @intrinsic("simd.U32x4.swapAdjacent")
    @no_alloc
    swapAdjacent() -> U32x4 {
        return U32x4{_lanes: [this._lanes[1], this._lanes[0], this._lanes[3], this._lanes[2]]}
    }

    @intrinsic("simd.U32x4.widenMulEven")
    @no_alloc
    widenMulEven(other: U32x4) -> U64x2 {
        return U64x2.fromLanes([(this._lanes[0] as uint64) * (other._lanes[0] as uint64), (this._lanes[2] as uint64) * (other._lanes[2] as uint64)])
    }

    @intrinsic("simd.U32x4.widenMulOdd")
    @no_alloc
    widenMulOdd(other: U32x4) -> U64x2 {
        return U64x2.fromLanes([(this._lanes[1] as uint64) * (other._lanes[1] as uint64), (this._lanes[3] as uint64) * (other._lanes[3] as uint64)])
    }

    @intrinsic("simd.U32x4.unzipEven")
    @no_alloc
    unzipEven(other: U32x4) -> U32x4 {
        return U32x4{_lanes: [this._lanes[0], this._lanes[2], other._lanes[0], other._lanes[2]]}
    }

    @intrinsic("simd.U32x4.unzipOdd")
    @no_alloc
    unzipOdd(other: U32x4) -> U32x4 {
        return U32x4{_lanes: [this._lanes[1], this._lanes[3], other._lanes[1], other._lanes[3]]}
    }

    @intrinsic("simd.U32x4.widenMulLow")
    @no_alloc
    widenMulLow(other: U32x4) -> U64x2 {
        return U64x2.fromLanes([(this._lanes[0] as uint64) * (other._lanes[0] as uint64), (this._lanes[1] as uint64) * (other._lanes[1] as uint64)])
    }

    @intrinsic("simd.U32x4.widenMulHigh")
    @no_alloc
    widenMulHigh(other: U32x4) -> U64x2 {
        return U64x2.fromLanes([(this._lanes[2] as uint64) * (other._lanes[2] as uint64), (this._lanes[3] as uint64) * (other._lanes[3] as uint64)])
    }

    @intrinsic("simd.U32x4.reinterpretU8")
    @no_alloc
    reinterpretU8() -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 4) {
            var word = this._lanes[i]
            var base = i * 4
            lanes[base] = (word & 255) as byte
            lanes[base + 1] = ((word >> 8) & 255) as byte
            lanes[base + 2] = ((word >> 16) & 255) as byte
            lanes[base + 3] = ((word >> 24) & 255) as byte
            i += 1
        }
        return U8x16.fromLanes(lanes)
    }

    @intrinsic("simd.U32x4.reinterpretU64")
    @no_alloc
    reinterpretU64() -> U64x2 {
        return U64x2.fromLanes([(this._lanes[0] as uint64) | ((this._lanes[1] as uint64) << 32), (this._lanes[2] as uint64) | ((this._lanes[3] as uint64) << 32)])
    }
}

export struct U64x2 align(16) {
    private _lanes: [uint64; 2]

    @no_alloc
    static fromLanes(lanes: [uint64; 2]) -> U64x2 {
        return U64x2{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U64x2.splat")
    @no_alloc
    static splat(value: uint64) -> U64x2 {
        return U64x2{_lanes: [value; 2]}
    }

    @intrinsic("simd.U64x2.load")
    @no_alloc
    static load(data: Slice<uint64>, offset: int = 0) -> U64x2 {
        return U64x2{_lanes: [data[offset], data[offset + 1]]}
    }

    @intrinsic("simd.U64x2.store")
    @no_alloc
    store(output: ref Slice<uint64>, offset: int = 0) {
        output[offset] = this._lanes[0]
        output[offset + 1] = this._lanes[1]
    }

    @intrinsic("simd.U64x2.extract")
    @no_alloc
    extract(lane: int) -> uint64 {
        return this._lanes[lane]
    }

    @intrinsic("simd.U64x2.replace")
    @no_alloc
    replace(lane: int, value: uint64) -> U64x2 {
        var lanes = copy(this._lanes)
        lanes[lane] = value
        return U64x2{_lanes: lanes}
    }

    @intrinsic("simd.U64x2.add")
    @no_alloc
    add(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] + other._lanes[0], this._lanes[1] + other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.sub")
    @no_alloc
    sub(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] - other._lanes[0], this._lanes[1] - other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.mul")
    @no_alloc
    mul(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] * other._lanes[0], this._lanes[1] * other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.bitAnd")
    @no_alloc
    bitAnd(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] & other._lanes[0], this._lanes[1] & other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.bitOr")
    @no_alloc
    bitOr(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] | other._lanes[0], this._lanes[1] | other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.bitXor")
    @no_alloc
    bitXor(other: U64x2) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] ^ other._lanes[0], this._lanes[1] ^ other._lanes[1]]}
    }

    @intrinsic("simd.U64x2.bitNot")
    @no_alloc
    bitNot() -> U64x2 {
        return U64x2{_lanes: [~this._lanes[0], ~this._lanes[1]]}
    }

    @intrinsic("simd.U64x2.shiftLeft")
    @no_alloc
    shiftLeft(bits: int) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] << bits, this._lanes[1] << bits]}
    }

    @intrinsic("simd.U64x2.shiftRight")
    @no_alloc
    shiftRight(bits: int) -> U64x2 {
        return U64x2{_lanes: [this._lanes[0] >> bits, this._lanes[1] >> bits]}
    }

    @intrinsic("simd.U64x2.swapLanes")
    @no_alloc
    swapLanes() -> U64x2 {
        return U64x2{_lanes: [this._lanes[1], this._lanes[0]]}
    }

    @intrinsic("simd.U64x2.shuffle")
    @no_alloc
    shuffle(i0: int, i1: int) -> U64x2 {
        return U64x2{_lanes: [this._lanes[i0], this._lanes[i1]]}
    }

    @intrinsic("simd.U64x2.reduceAdd")
    @no_alloc
    reduceAdd() -> uint64 {
        return this._lanes[0] + this._lanes[1]
    }

    @intrinsic("simd.U64x2.reinterpretU32")
    @no_alloc
    reinterpretU32() -> U32x4 {
        return U32x4.fromLanes([(this._lanes[0] & 4294967295) as uint32, (this._lanes[0] >> 32) as uint32, (this._lanes[1] & 4294967295) as uint32, (this._lanes[1] >> 32) as uint32])
    }

    @intrinsic("simd.U64x2.reinterpretU8")
    @no_alloc
    reinterpretU8() -> U8x16 {
        var lanes: [byte; 16] = [0; 16]
        var i = 0
        while (i < 2) {
            var word = this._lanes[i]
            var base = i * 8
            lanes[base] = (word & 255) as byte
            lanes[base + 1] = ((word >> 8) & 255) as byte
            lanes[base + 2] = ((word >> 16) & 255) as byte
            lanes[base + 3] = ((word >> 24) & 255) as byte
            lanes[base + 4] = ((word >> 32) & 255) as byte
            lanes[base + 5] = ((word >> 40) & 255) as byte
            lanes[base + 6] = ((word >> 48) & 255) as byte
            lanes[base + 7] = ((word >> 56) & 255) as byte
            i += 1
        }
        return U8x16.fromLanes(lanes)
    }
}

// Compile-target SIMD capability. VM and unsupported targets retain the
// portable 128-bit semantic baseline; AOT rewrites this query to the exact
// target plan so dead wide branches disappear before machine code emission.
export struct Capabilities {
    private _marker: byte

    @intrinsic("simd.Capabilities.nativeBytes")
    @no_alloc
    static nativeBytes() -> int {
        return 16
    }
}

export struct U8x32 align(32) {
    private _lanes: [byte; 32]

    @no_alloc
    static fromLanes(lanes: [byte; 32]) -> U8x32 {
        return U8x32{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U8x32.load")
    @no_alloc
    static load(data: Slice<byte>, offset: int = 0) -> U8x32 {
        var lanes: [byte; 32] = [0; 32]
        var i = 0
        while (i < 32) {
            lanes[i] = data[offset + i]
            i += 1
        }
        return U8x32{_lanes: lanes}
    }

    @intrinsic("simd.U8x32.store")
    @no_alloc
    store(output: ref Slice<byte>, offset: int = 0) {
        var i = 0
        while (i < 32) {
            output[offset + i] = this._lanes[i]
            i += 1
        }
    }

    @intrinsic("simd.U8x32.bitXor")
    @no_alloc
    bitXor(other: U8x32) -> U8x32 {
        var lanes: [byte; 32] = [0; 32]
        var i = 0
        while (i < 32) {
            lanes[i] = this._lanes[i] ^ other._lanes[i]
            i += 1
        }
        return U8x32{_lanes: lanes}
    }

    @intrinsic("simd.U8x32.reinterpretU32")
    @no_alloc
    reinterpretU32() -> U32x8 {
        var lanes: [uint32; 8] = [0; 8]
        var i = 0
        while (i < 8) {
            var base = i * 4
            lanes[i] = (this._lanes[base] as uint32) | ((this._lanes[base + 1] as uint32) << 8) | ((this._lanes[base + 2] as uint32) << 16) | ((this._lanes[base + 3] as uint32) << 24)
            i += 1
        }
        return U32x8.fromLanes(lanes)
    }

    @intrinsic("simd.U8x32.reinterpretU64")
    @no_alloc
    reinterpretU64() -> U64x4 {
        var lanes: [uint64; 4] = [0; 4]
        var i = 0
        while (i < 4) {
            var base = i * 8
            lanes[i] = (this._lanes[base] as uint64) | ((this._lanes[base + 1] as uint64) << 8) | ((this._lanes[base + 2] as uint64) << 16) | ((this._lanes[base + 3] as uint64) << 24) | ((this._lanes[base + 4] as uint64) << 32) | ((this._lanes[base + 5] as uint64) << 40) | ((this._lanes[base + 6] as uint64) << 48) | ((this._lanes[base + 7] as uint64) << 56)
            i += 1
        }
        return U64x4.fromLanes(lanes)
    }
}

export struct U32x8 align(32) {
    private _lanes: [uint32; 8]

    @no_alloc
    static fromLanes(lanes: [uint32; 8]) -> U32x8 {
        return U32x8{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U32x8.swapAdjacent")
    @no_alloc
    swapAdjacent() -> U32x8 {
        return U32x8{_lanes: [this._lanes[1], this._lanes[0], this._lanes[3], this._lanes[2], this._lanes[5], this._lanes[4], this._lanes[7], this._lanes[6]]}
    }

    @intrinsic("simd.U32x8.widenMulEven")
    @no_alloc
    widenMulEven(other: U32x8) -> U64x4 {
        return U64x4.fromLanes([(this._lanes[0] as uint64) * (other._lanes[0] as uint64), (this._lanes[2] as uint64) * (other._lanes[2] as uint64), (this._lanes[4] as uint64) * (other._lanes[4] as uint64), (this._lanes[6] as uint64) * (other._lanes[6] as uint64)])
    }
}

export struct U64x4 align(32) {
    private _lanes: [uint64; 4]

    @no_alloc
    static fromLanes(lanes: [uint64; 4]) -> U64x4 {
        return U64x4{_lanes: copy(lanes)}
    }

    @intrinsic("simd.U64x4.load")
    @no_alloc
    static load(data: Slice<uint64>, offset: int = 0) -> U64x4 {
        return U64x4{_lanes: [data[offset], data[offset + 1], data[offset + 2], data[offset + 3]]}
    }

    @intrinsic("simd.U64x4.store")
    @no_alloc
    store(output: ref Slice<uint64>, offset: int = 0) {
        output[offset] = this._lanes[0]
        output[offset + 1] = this._lanes[1]
        output[offset + 2] = this._lanes[2]
        output[offset + 3] = this._lanes[3]
    }

    @intrinsic("simd.U64x4.add")
    @no_alloc
    add(other: U64x4) -> U64x4 {
        return U64x4{_lanes: [this._lanes[0] + other._lanes[0], this._lanes[1] + other._lanes[1], this._lanes[2] + other._lanes[2], this._lanes[3] + other._lanes[3]]}
    }

    @intrinsic("simd.U64x4.reduceAdd")
    @no_alloc
    reduceAdd() -> uint64 {
        return this._lanes[0] + this._lanes[1] + this._lanes[2] + this._lanes[3]
    }

    @intrinsic("simd.U64x4.swapAdjacent")
    @no_alloc
    swapAdjacent() -> U64x4 {
        return U64x4{_lanes: [this._lanes[1], this._lanes[0], this._lanes[3], this._lanes[2]]}
    }
}
