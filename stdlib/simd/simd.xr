        var i = 0
        while (i < 8) {
            lanes[i] = this._lanes[i] << bits
            i += 1
        }
        return U64x8{_lanes: lanes}
    }

    shiftRight(bits: int) -> U64x8 {
        var lanes: [u64; 8] = [0; 8]
        var i = 0
        while (i < 8) {
            lanes[i] = this._lanes[i] >> bits
            i += 1
        }
        return U64x8{_lanes: lanes}
    }

    swapAdjacent() -> U64x8 {
        var lanes: [u64; 8] = [0; 8]
        var i = 0
        while (i < 8) {
            lanes[i] = this._lanes[i ^ 1]
            i += 1
        }
        return U64x8{_lanes: lanes}
    }

    reinterpretU32() -> U32x16 {
        var lanes: [u32; 16] = [0; 16]
        var i = 0
        while (i < 8) {
            lanes[i * 2] = (this._lanes[i] & 4294967295) as u32
            lanes[i * 2 + 1] = (this._lanes[i] >> 32) as u32
            i += 1
        }
        return U32x16.fromLanes(lanes)
    }
}
