import text

// csv - typed pure-Xray CSV parser and writer.
//
// CSV's wire domain is textual rows. Application-specific conversion belongs
// in an explicit schema/decode layer, never in the tokenizer.

export enum CsvDelimiter {
    Exact(rune),
    Auto
}

export enum CsvHeader {
    None,
    FirstRow,
    Explicit(Array<string>)
}

export enum CsvErrorKind {
    UnterminatedQuote,
    InvalidEscape,
    FieldCountMismatch
}

export class CsvDiagnostic {
    kind: CsvErrorKind
    byteOffset: int
    line: int
    record: int
    column: int
    message: string

    constructor(kind: CsvErrorKind, byteOffset: int, line: int, record: int, column: int,
                message: string) {
        this.kind = kind
        this.byteOffset = byteOffset
        this.line = line
        this.record = record
        this.column = column
        this.message = message
    }
}

export enum CsvError {
    InvalidOption(string),
    InputLimitExceeded(int),
    FieldLimitExceeded(int),
    ColumnLimitExceeded(int),
    UnterminatedQuote(int, int, int, int, string),
    InvalidEscape(int, int, int, int, string),
    FieldCountMismatch(int, int, int, int, string)
}

export type CsvParseOptions = {
    delimiter: CsvDelimiter,
    quoteChar: rune,
    escapeChar: rune,
    header: CsvHeader,
    trimFields: bool,
    skipEmptyLines: bool,
    commentPrefix: string,
    skipRecords: int,
    maxRecords: int,
    maxInputBytes: int,
    maxFieldBytes: int,
    maxColumns: int
}

export type CsvWriteOptions = {
    delimiter: rune,
    quoteChar: rune,
    escapeChar: rune,
    linebreak: string
}

export fn defaultParseOptions() -> CsvParseOptions {
    var options: CsvParseOptions = {
        delimiter: CsvDelimiter.Exact(','),
        quoteChar: '"',
        escapeChar: '"',
        header: CsvHeader.None,
        trimFields: false,
        skipEmptyLines: true,
        commentPrefix: "",
        skipRecords: 0,
        maxRecords: 0,
        maxInputBytes: 16 * 1024 * 1024,
        maxFieldBytes: 1024 * 1024,
        maxColumns: 16384
    }
    return options
}

export fn defaultWriteOptions() -> CsvWriteOptions {
    var options: CsvWriteOptions = {
        delimiter: ',',
        quoteChar: '"',
        escapeChar: '"',
        linebreak: "\n"
    }
    return options
}

export class CsvDocument {
    headers: Array<string>
    rows: Array<Array<string>>

    constructor() {
        this.headers = []
        this.rows = []
    }
}

export class CsvParseReport {
    document: CsvDocument
    diagnostics: Array<CsvDiagnostic>
    delimiter: rune
    linebreak: string
    truncated: bool

    constructor(document: CsvDocument, diagnostics: Array<CsvDiagnostic>, delimiter: rune,
                linebreak: string, truncated: bool) {
        this.document = document
        this.diagnostics = diagnostics
        this.delimiter = delimiter
        this.linebreak = linebreak
        this.truncated = truncated
    }
}

const STATE_FIELD_START = 0
const STATE_UNQUOTED = 1
const STATE_QUOTED = 2
const STATE_QUOTE_END = 3

class _CsvState {
    document: CsvDocument
    diagnostics: Array<CsvDiagnostic>
    delimiter: rune
    linebreak: string
    truncated: bool
    currentRow: Array<string>
    currentRecord: int
    currentColumn: int
    physicalLine: int
    byteOffset: int
    expectedColumns: int
    firstFieldQuoted: bool
    currentFieldBytes: int

    constructor(delimiter: rune) {
        this.document = CsvDocument()
        this.diagnostics = []
        this.delimiter = delimiter
        this.linebreak = ""
        this.truncated = false
        this.currentRow = []
        this.currentRecord = 0
        this.currentColumn = 0
        this.physicalLine = 1
        this.byteOffset = 0
        this.expectedColumns = -1
        this.firstFieldQuoted = false
        this.currentFieldBytes = 0
    }
}

fn _validateParseOptions(options: CsvParseOptions) {
    if (options.skipRecords < 0 || options.maxRecords < 0 || options.maxInputBytes < 0 ||
        options.maxFieldBytes < 0 || options.maxColumns < 0) {
        throw CsvError.InvalidOption("CSV limits and record counts must be non-negative")
    }
}

fn _validateWriteOptions(options: CsvWriteOptions) {
    if (options.delimiter == options.quoteChar) {
        throw CsvError.InvalidOption("delimiter and quoteChar must differ")
    }
    if (len(options.linebreak) == 0) {
        throw CsvError.InvalidOption("linebreak must not be empty")
    }
}

fn _isNewline(c: rune) -> bool {
    return c == '\n' || c == '\r'
}

fn _detectDelimiter(data: string, quoteChar: rune, escapeChar: rune) -> rune {
    var candidates: Array<rune> = [',', '\t', ';', '|']
    var counts: Array<int> = [0, 0, 0, 0]
    var quoted = false
    var limit = len(data)
    if (limit > 4096) { limit = 4096 }

    var i = 0
    while (i < limit) {
        var c = data.runes().nth(i)
        if (quoted && c == escapeChar && i + 1 < limit && data.runes().nth(i + 1) == quoteChar) {
            i = i + 2
            continue
        }
        if (c == quoteChar) {
            quoted = !quoted
        } else if (!quoted && !_isNewline(c)) {
            for (var j = 0; j < len(candidates); j++) {
                if (c == candidates[j]) { counts[j] = counts[j] + 1 }
            }
        }
        i = i + 1
    }

    var best = ','
    var bestCount = 0
    for (var j = 0; j < len(candidates); j++) {
        if (counts[j] > bestCount) {
            best = candidates[j]
            bestCount = counts[j]
        }
    }
    return best
}

fn _resolveDelimiter(data: string, options: CsvParseOptions) -> rune {
    var delimiter = match (options.delimiter) {
        CsvDelimiter.Exact(value) -> value,
        CsvDelimiter.Auto         -> _detectDelimiter(data, options.quoteChar, options.escapeChar)
    }
    if (delimiter == options.quoteChar) {
        throw CsvError.InvalidOption("delimiter and quoteChar must differ")
    }
    return delimiter
}

fn _explicitHeaders(header: CsvHeader) -> Array<string> {
    var empty: Array<string> = []
    return match (header) {
        CsvHeader.Explicit(values) -> values,
        _                          -> empty
    }
}

fn _addDiagnostic(state: ref _CsvState, kind: CsvErrorKind, message: string) {
    state.diagnostics.push(CsvDiagnostic(
        kind,
        state.byteOffset,
        state.physicalLine,
        state.currentRecord,
        state.currentColumn,
        message
    ))
}

fn _addRecordDiagnostic(state: ref _CsvState, kind: CsvErrorKind, record: int, message: string) {
    state.diagnostics.push(CsvDiagnostic(
        kind,
        state.byteOffset,
        state.physicalLine,
        record,
        state.currentColumn,
        message
    ))
}

fn _checkFieldLimit(state: _CsvState, options: CsvParseOptions) {
    if (options.maxFieldBytes > 0 && state.currentFieldBytes > options.maxFieldBytes) {
        throw CsvError.FieldLimitExceeded(options.maxFieldBytes)
    }
}

fn _utf8Width(value: rune) -> int {
    var scalar = value.toUInt32()
    if (scalar <= 0x7F) { return 1 }
    if (scalar <= 0x7FF) { return 2 }
    if (scalar <= 0xFFFF) { return 3 }
    return 4
}

fn _appendRune(state: ref _CsvState, field: ref StringBuilder, value: rune,
               options: CsvParseOptions) {
    field.append(value)
    state.currentFieldBytes = state.currentFieldBytes + _utf8Width(value)
    _checkFieldLimit(state, options)
}

fn _appendText(state: ref _CsvState, field: ref StringBuilder, value: string,
               options: CsvParseOptions) {
    field.append(value)
    state.currentFieldBytes = state.currentFieldBytes + len(value.bytes())
    _checkFieldLimit(state, options)
}

fn _finishField(state: ref _CsvState, options: CsvParseOptions, field: ref StringBuilder) {
    if (options.maxColumns > 0 && state.currentColumn + 1 > options.maxColumns) {
        throw CsvError.ColumnLimitExceeded(options.maxColumns)
    }
    var value = field.toString()
    if (options.trimFields) { value = text.trim(value) }
    state.currentRow.push(value)
    state.currentColumn = state.currentColumn + 1
    field.clear()
    state.currentFieldBytes = 0
}

fn _observeLinebreak(state: ref _CsvState, value: string) {
    if (len(state.linebreak) == 0) {
        state.linebreak = value
    } else if (state.linebreak != value) {
        state.linebreak = "mixed"
    }
    state.physicalLine = state.physicalLine + 1
}

fn _newlineWidth(data: string, pos: int) -> int {
    if (data.runes().nth(pos) == '\r' && pos + 1 < len(data) &&
        data.runes().nth(pos + 1) == '\n') {
        return 2
    }
    return 1
}

fn _newlineText(data: string, pos: int, width: int) -> string {
    if (width == 2) { return "\r\n" }
    return data.runes().nth(pos).toString()
}

fn _startsWith(s: string, prefix: string) -> bool {
    return len(prefix) > 0 && len(s) >= len(prefix) && s.slice(0, len(prefix)) == prefix
}

fn _clearRow(state: ref _CsvState) {
    state.currentRow = []
    state.currentColumn = 0
    state.firstFieldQuoted = false
}

fn _isEmptyRow(row: Array<string>) -> bool {
    return len(row) == 0 || (len(row) == 1 && len(row[0]) == 0)
}

fn _consumeRow(state: ref _CsvState, options: CsvParseOptions) -> bool {
    var row = state.currentRow
    var record = state.currentRecord
    state.currentRecord = state.currentRecord + 1

    if (options.skipEmptyLines && _isEmptyRow(row)) {
        _clearRow(ref state)
        return false
    }

    if (!state.firstFieldQuoted && len(row) > 0 &&
        _startsWith(row[0], options.commentPrefix)) {
        _clearRow(ref state)
        return false
    }

    if (record < options.skipRecords) {
        _clearRow(ref state)
        return false
    }

    var headerConsumed = match (options.header) {
        CsvHeader.FirstRow -> len(state.document.headers) == 0,
        _                  -> false
    }
    if (headerConsumed) {
        state.document.headers = copy(row)
        state.expectedColumns = len(row)
        _clearRow(ref state)
        return false
    }

    if (state.expectedColumns < 0) {
        state.expectedColumns = len(row)
    } else if (len(row) != state.expectedColumns) {
        _addRecordDiagnostic(
            ref state,
            CsvErrorKind.FieldCountMismatch,
            record,
            "Expected " + string(state.expectedColumns) + " fields, got " + string(len(row))
        )
    }

    state.document.rows.push(copy(row))
    _clearRow(ref state)
    if (options.maxRecords > 0 && len(state.document.rows) >= options.maxRecords) {
        state.truncated = true
        return true
    }
    return false
}

fn _parseImpl(data: string, options: CsvParseOptions) -> CsvParseReport {
    _validateParseOptions(options)
    if (options.maxInputBytes > 0 && len(data.bytes()) > options.maxInputBytes) {
        throw CsvError.InputLimitExceeded(options.maxInputBytes)
    }

    var delimiter = _resolveDelimiter(data, options)
    var state = _CsvState(delimiter)
    var explicitHeaders = _explicitHeaders(options.header)
    for (name in explicitHeaders) { state.document.headers.push(name) }
    if (len(state.document.headers) > 0) {
        state.expectedColumns = len(state.document.headers)
    }

    var field = StringBuilder()
    var parserState = STATE_FIELD_START
    var pos = 0
    var bytePos = 0
    if (len(data) > 0 && data.runes().nth(0) == '\u{FEFF}') {
        pos = 1
        bytePos = 3
    }

    while (pos < len(data)) {
        var startPos = pos
        state.byteOffset = bytePos
        var c = data.runes().nth(pos)

        if (parserState == STATE_FIELD_START) {
            if (c == options.quoteChar) {
                if (state.currentColumn == 0) { state.firstFieldQuoted = true }
                parserState = STATE_QUOTED
            } else if (c == delimiter) {
                _finishField(ref state, options, ref field)
            } else if (_isNewline(c)) {
                _finishField(ref state, options, ref field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(ref state, _newlineText(data, pos, width))
                if (_consumeRow(ref state, options)) { break }
                pos = pos + width - 1
            } else {
                _appendRune(ref state, ref field, c, options)
                parserState = STATE_UNQUOTED
            }
        } else if (parserState == STATE_UNQUOTED) {
            if (c == delimiter) {
                _finishField(ref state, options, ref field)
                parserState = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(ref state, options, ref field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(ref state, _newlineText(data, pos, width))
                if (_consumeRow(ref state, options)) { break }
                pos = pos + width - 1
                parserState = STATE_FIELD_START
            } else {
                _appendRune(ref state, ref field, c, options)
            }
        } else if (parserState == STATE_QUOTED) {
            if (c == options.escapeChar && pos + 1 < len(data) &&
                data.runes().nth(pos + 1) == options.quoteChar) {
                _appendRune(ref state, ref field, options.quoteChar, options)
                pos = pos + 1
            } else if (c == options.quoteChar) {
                parserState = STATE_QUOTE_END
            } else if (_isNewline(c)) {
                var width = _newlineWidth(data, pos)
                var newline = _newlineText(data, pos, width)
                _appendText(ref state, ref field, newline, options)
                _observeLinebreak(ref state, newline)
                pos = pos + width - 1
            } else {
                _appendRune(ref state, ref field, c, options)
            }
        } else {
            if (c == delimiter) {
                _finishField(ref state, options, ref field)
                parserState = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(ref state, options, ref field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(ref state, _newlineText(data, pos, width))
                if (_consumeRow(ref state, options)) { break }
                pos = pos + width - 1
                parserState = STATE_FIELD_START
            } else {
                _addDiagnostic(ref state, CsvErrorKind.InvalidEscape,
                               "Unexpected character after closing quote")
                _appendRune(ref state, ref field, c, options)
                parserState = STATE_UNQUOTED
            }
        }
        bytePos = bytePos + _utf8Width(c)
        if (pos > startPos) { bytePos = bytePos + _utf8Width(data.runes().nth(pos)) }
        pos = pos + 1
    }

    state.byteOffset = len(data.bytes())
    if (parserState == STATE_QUOTED) {
        _addDiagnostic(ref state, CsvErrorKind.UnterminatedQuote, "Unterminated quoted field")
    }
    if (len(field) > 0 || state.currentColumn > 0 || len(state.currentRow) > 0 ||
        parserState == STATE_QUOTED || parserState == STATE_QUOTE_END) {
        _finishField(ref state, options, ref field)
    }
    if (len(state.currentRow) > 0 && !state.truncated) {
        _consumeRow(ref state, options)
    }
    if (len(state.linebreak) == 0) { state.linebreak = "" }

    return CsvParseReport(state.document, state.diagnostics, delimiter, state.linebreak,
                          state.truncated)
}

// parseReport explicitly opts into recovery and returns any partial document
// together with typed diagnostics.
export fn parseReport(data: string, options: CsvParseOptions? = null) -> CsvParseReport {
    var resolved = options == null ? defaultParseOptions() : options!
    return _parseImpl(data, resolved)
}

fn _throwDiagnostic(diagnostic: CsvDiagnostic) {
    if (diagnostic.kind == CsvErrorKind.UnterminatedQuote) {
        throw CsvError.UnterminatedQuote(
            diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
            diagnostic.message
        )
    }
    if (diagnostic.kind == CsvErrorKind.InvalidEscape) {
        throw CsvError.InvalidEscape(
            diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
            diagnostic.message
        )
    }
    throw CsvError.FieldCountMismatch(
        diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
        diagnostic.message
    )
}

// parse is strict: the first recoverable syntax diagnostic enters the enum
// value error channel.
export fn parse(data: string, options: CsvParseOptions? = null) -> CsvDocument {
    var resolved = options == null ? defaultParseOptions() : options!
    var report = _parseImpl(data, resolved)
    if (len(report.diagnostics) > 0) {
        _throwDiagnostic(report.diagnostics[0])
    }
    return report.document
}

fn _needsQuoting(value: string, options: CsvWriteOptions) -> bool {
    if (len(value) == 0) { return false }
    if (value.runes().nth(0) == ' ' || value.runes().nth(0) == '\t' ||
        value.runes().nth(len(value) - 1) == ' ' ||
        value.runes().nth(len(value) - 1) == '\t') {
        return true
    }
    for (var i = 0; i < len(value); i++) {
        var c = value.runes().nth(i)
        if (c == options.delimiter || c == options.quoteChar || c == options.escapeChar ||
            _isNewline(c)) {
            return true
        }
    }
    return false
}

fn _writeField(out: ref StringBuilder, value: string, options: CsvWriteOptions) {
    if (!_needsQuoting(value, options)) {
        out.append(value)
        return
    }
    out.append(options.quoteChar)
    var prefixMode = options.escapeChar != options.quoteChar
    for (var i = 0; i < len(value); i++) {
        var c = value.runes().nth(i)
        if (c == options.quoteChar || (prefixMode && c == options.escapeChar)) {
            out.append(options.escapeChar)
            out.append(c)
        } else {
            out.append(c)
        }
    }
    out.append(options.quoteChar)
}

fn _writeRow(out: ref StringBuilder, row: Array<string>, options: CsvWriteOptions) {
    for (var i = 0; i < len(row); i++) {
        if (i > 0) { out.append(options.delimiter) }
        _writeField(ref out, row[i], options)
    }
    out.append(options.linebreak)
}

// stringify accepts only CsvDocument and never guesses how arbitrary values
// should be coerced.
export fn stringify(document: CsvDocument, options: CsvWriteOptions? = null) -> string {
    var resolved = options == null ? defaultWriteOptions() : options!
    _validateWriteOptions(resolved)
    var out = StringBuilder()
    if (len(document.headers) > 0) {
        _writeRow(ref out, document.headers, resolved)
    }
    for (row in document.rows) {
        _writeRow(ref out, row, resolved)
    }
    return out.toString()
}
