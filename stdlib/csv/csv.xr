// csv - typed pure-Xray CSV parser and writer.
//
// CSV's wire domain is textual rows. Application-specific conversion belongs
// in an explicit schema/decode layer, never in the tokenizer.

enum CsvDelimiter {
    Exact(string),
    Auto
}

enum CsvHeader {
    None,
    FirstRow,
    Explicit(Array<string>)
}

enum CsvErrorKind {
    UnterminatedQuote,
    InvalidEscape,
    FieldCountMismatch
}

class CsvDiagnostic {
    kind: CsvErrorKind
    byteOffset: int
    line: int
    record: int
    column: int
    message: string

    constructor(kind: CsvErrorKind, byteOffset: int, line: int, record: int, column: int,
                message: string) {
        this.kind = kind
        this.byteOffset = byteOffset
        this.line = line
        this.record = record
        this.column = column
        this.message = message
    }
}

enum CsvError {
    InvalidOption(string),
    InputLimitExceeded(int),
    FieldLimitExceeded(int),
    ColumnLimitExceeded(int),
    UnterminatedQuote(int, int, int, int, string),
    InvalidEscape(int, int, int, int, string),
    FieldCountMismatch(int, int, int, int, string)
}

type CsvParseOptions = {
    delimiter: CsvDelimiter,
    quoteChar: string,
    escapeChar: string,
    header: CsvHeader,
    trimFields: bool,
    skipEmptyLines: bool,
    commentPrefix: string,
    skipRecords: int,
    maxRecords: int,
    maxInputBytes: int,
    maxFieldBytes: int,
    maxColumns: int
}

type CsvWriteOptions = {
    delimiter: string,
    quoteChar: string,
    escapeChar: string,
    linebreak: string
}

fn defaultParseOptions() -> CsvParseOptions {
    var options: CsvParseOptions = {
        delimiter: CsvDelimiter.Exact(","),
        quoteChar: "\"",
        escapeChar: "\"",
        header: CsvHeader.None,
        trimFields: false,
        skipEmptyLines: true,
        commentPrefix: "",
        skipRecords: 0,
        maxRecords: 0,
        maxInputBytes: 16 * 1024 * 1024,
        maxFieldBytes: 1024 * 1024,
        maxColumns: 16384
    }
    return options
}

fn defaultWriteOptions() -> CsvWriteOptions {
    var options: CsvWriteOptions = {
        delimiter: ",",
        quoteChar: "\"",
        escapeChar: "\"",
        linebreak: "\n"
    }
    return options
}

fn _parseOptions(options: CsvParseOptions?) -> CsvParseOptions {
    if (options == null) { return defaultParseOptions() }
    return options!
}

fn _writeOptions(options: CsvWriteOptions?) -> CsvWriteOptions {
    if (options == null) { return defaultWriteOptions() }
    return options!
}

class CsvDocument {
    headers: Array<string>
    rows: Array<Array<string>>

    constructor() {
        this.headers = []
        this.rows = []
    }
}

class CsvParseReport {
    document: CsvDocument
    diagnostics: Array<CsvDiagnostic>
    delimiter: string
    linebreak: string
    truncated: bool

    constructor(document: CsvDocument, diagnostics: Array<CsvDiagnostic>, delimiter: string,
                linebreak: string, truncated: bool) {
        this.document = document
        this.diagnostics = diagnostics
        this.delimiter = delimiter
        this.linebreak = linebreak
        this.truncated = truncated
    }
}

const STATE_FIELD_START = 0
const STATE_UNQUOTED = 1
const STATE_QUOTED = 2
const STATE_QUOTE_END = 3

class _CsvState {
    document: CsvDocument
    diagnostics: Array<CsvDiagnostic>
    delimiter: string
    linebreak: string
    truncated: bool
    currentRow: Array<string>
    currentRecord: int
    currentColumn: int
    physicalLine: int
    byteOffset: int
    expectedColumns: int
    firstFieldQuoted: bool

    constructor(delimiter: string) {
        this.document = CsvDocument()
        this.diagnostics = []
        this.delimiter = delimiter
        this.linebreak = ""
        this.truncated = false
        this.currentRow = []
        this.currentRecord = 0
        this.currentColumn = 0
        this.physicalLine = 1
        this.byteOffset = 0
        this.expectedColumns = -1
        this.firstFieldQuoted = false
    }
}

fn _validateCharacter(name: string, value: string) {
    if (value.length != 1) {
        throw CsvError.InvalidOption(name + " must contain exactly one character")
    }
}

fn _validateParseOptions(options: CsvParseOptions) {
    _validateCharacter("quoteChar", options.quoteChar)
    _validateCharacter("escapeChar", options.escapeChar)
    if (options.skipRecords < 0 || options.maxRecords < 0 || options.maxInputBytes < 0 ||
        options.maxFieldBytes < 0 || options.maxColumns < 0) {
        throw CsvError.InvalidOption("CSV limits and record counts must be non-negative")
    }
}

fn _validateWriteOptions(options: CsvWriteOptions) {
    _validateCharacter("delimiter", options.delimiter)
    _validateCharacter("quoteChar", options.quoteChar)
    _validateCharacter("escapeChar", options.escapeChar)
    if (options.delimiter == options.quoteChar) {
        throw CsvError.InvalidOption("delimiter and quoteChar must differ")
    }
    if (options.linebreak.length == 0) {
        throw CsvError.InvalidOption("linebreak must not be empty")
    }
}

fn _isNewline(c: string) -> bool {
    return c == "\n" || c == "\r"
}

fn _detectDelimiter(data: string, quoteChar: string, escapeChar: string) -> string {
    var candidates: Array<string> = [",", "\t", ";", "|"]
    var counts: Array<int> = [0, 0, 0, 0]
    var quoted = false
    var limit = data.length
    if (limit > 4096) { limit = 4096 }

    var i = 0
    while (i < limit) {
        var c = data.charAt(i)
        if (quoted && c == escapeChar && i + 1 < limit && data.charAt(i + 1) == quoteChar) {
            i = i + 2
            continue
        }
        if (c == quoteChar) {
            quoted = !quoted
        } else if (!quoted && !_isNewline(c)) {
            for (var j = 0; j < candidates.length; j++) {
                if (c == candidates[j]) { counts[j] = counts[j] + 1 }
            }
        }
        i = i + 1
    }

    var best = ","
    var bestCount = 0
    for (var j = 0; j < candidates.length; j++) {
        if (counts[j] > bestCount) {
            best = candidates[j]
            bestCount = counts[j]
        }
    }
    return best
}

fn _resolveDelimiter(data: string, options: CsvParseOptions) -> string {
    var delimiter = match (options.delimiter) {
        CsvDelimiter.Exact(value) -> value,
        CsvDelimiter.Auto         -> _detectDelimiter(data, options.quoteChar, options.escapeChar)
    }
    _validateCharacter("delimiter", delimiter)
    if (delimiter == options.quoteChar) {
        throw CsvError.InvalidOption("delimiter and quoteChar must differ")
    }
    return delimiter
}

fn _explicitHeaders(header: CsvHeader) -> Array<string> {
    var empty: Array<string> = []
    return match (header) {
        CsvHeader.Explicit(values) -> values,
        _                          -> empty
    }
}

fn _addDiagnostic(state: _CsvState, kind: CsvErrorKind, message: string) {
    state.diagnostics.push(CsvDiagnostic(
        kind,
        state.byteOffset,
        state.physicalLine,
        state.currentRecord,
        state.currentColumn,
        message
    ))
}

fn _addRecordDiagnostic(state: _CsvState, kind: CsvErrorKind, record: int, message: string) {
    state.diagnostics.push(CsvDiagnostic(
        kind,
        state.byteOffset,
        state.physicalLine,
        record,
        state.currentColumn,
        message
    ))
}

fn _appendField(field: StringBuilder, value: string, options: CsvParseOptions) {
    field.append(value)
    if (options.maxFieldBytes > 0 && field.length > options.maxFieldBytes) {
        throw CsvError.FieldLimitExceeded(options.maxFieldBytes)
    }
}

fn _finishField(state: _CsvState, options: CsvParseOptions, field: StringBuilder) {
    if (options.maxColumns > 0 && state.currentColumn + 1 > options.maxColumns) {
        throw CsvError.ColumnLimitExceeded(options.maxColumns)
    }
    var value = field.toString()
    if (options.trimFields) { value = value.trim() }
    state.currentRow.push(value)
    state.currentColumn = state.currentColumn + 1
    field.clear()
}

fn _observeLinebreak(state: _CsvState, value: string) {
    if (state.linebreak.length == 0) {
        state.linebreak = value
    } else if (state.linebreak != value) {
        state.linebreak = "mixed"
    }
    state.physicalLine = state.physicalLine + 1
}

fn _newlineWidth(data: string, pos: int) -> int {
    if (data.charAt(pos) == "\r" && pos + 1 < data.length && data.charAt(pos + 1) == "\n") {
        return 2
    }
    return 1
}

fn _newlineText(data: string, pos: int, width: int) -> string {
    if (width == 2) { return "\r\n" }
    return data.charAt(pos)
}

fn _startsWith(s: string, prefix: string) -> bool {
    return prefix.length > 0 && s.length >= prefix.length && s.slice(0, prefix.length) == prefix
}

fn _clearRow(state: _CsvState) {
    state.currentRow = []
    state.currentColumn = 0
    state.firstFieldQuoted = false
}

fn _isEmptyRow(row: Array<string>) -> bool {
    return row.length == 0 || (row.length == 1 && row[0].length == 0)
}

fn _consumeRow(state: _CsvState, options: CsvParseOptions) -> bool {
    var row = state.currentRow
    var record = state.currentRecord
    state.currentRecord = state.currentRecord + 1

    if (options.skipEmptyLines && _isEmptyRow(row)) {
        _clearRow(state)
        return false
    }

    if (!state.firstFieldQuoted && row.length > 0 &&
        _startsWith(row[0], options.commentPrefix)) {
        _clearRow(state)
        return false
    }

    if (record < options.skipRecords) {
        _clearRow(state)
        return false
    }

    var headerConsumed = match (options.header) {
        CsvHeader.FirstRow -> state.document.headers.length == 0,
        _                  -> false
    }
    if (headerConsumed) {
        state.document.headers = row
        state.expectedColumns = row.length
        _clearRow(state)
        return false
    }

    if (state.expectedColumns < 0) {
        state.expectedColumns = row.length
    } else if (row.length != state.expectedColumns) {
        _addRecordDiagnostic(
            state,
            CsvErrorKind.FieldCountMismatch,
            record,
            "Expected " + string(state.expectedColumns) + " fields, got " + string(row.length)
        )
    }

    state.document.rows.push(row)
    _clearRow(state)
    if (options.maxRecords > 0 && state.document.rows.length >= options.maxRecords) {
        state.truncated = true
        return true
    }
    return false
}

fn _parseImpl(data: string, options: CsvParseOptions) -> CsvParseReport {
    _validateParseOptions(options)
    if (options.maxInputBytes > 0 && data.byteLength > options.maxInputBytes) {
        throw CsvError.InputLimitExceeded(options.maxInputBytes)
    }

    var delimiter = _resolveDelimiter(data, options)
    var state = _CsvState(delimiter)
    var explicitHeaders = _explicitHeaders(options.header)
    for (name in explicitHeaders) { state.document.headers.push(name) }
    if (state.document.headers.length > 0) {
        state.expectedColumns = state.document.headers.length
    }

    var field = StringBuilder()
    var parserState = STATE_FIELD_START
    var pos = 0
    if (data.length > 0 && data.charAt(0) == "\u{FEFF}") { pos = 1 }

    while (pos < data.length) {
        state.byteOffset = pos
        var c = data.charAt(pos)

        if (parserState == STATE_FIELD_START) {
            if (c == options.quoteChar) {
                if (state.currentColumn == 0) { state.firstFieldQuoted = true }
                parserState = STATE_QUOTED
            } else if (c == delimiter) {
                _finishField(state, options, field)
            } else if (_isNewline(c)) {
                _finishField(state, options, field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(state, _newlineText(data, pos, width))
                if (_consumeRow(state, options)) { break }
                pos = pos + width - 1
            } else {
                _appendField(field, c, options)
                parserState = STATE_UNQUOTED
            }
        } else if (parserState == STATE_UNQUOTED) {
            if (c == delimiter) {
                _finishField(state, options, field)
                parserState = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(state, options, field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(state, _newlineText(data, pos, width))
                if (_consumeRow(state, options)) { break }
                pos = pos + width - 1
                parserState = STATE_FIELD_START
            } else {
                _appendField(field, c, options)
            }
        } else if (parserState == STATE_QUOTED) {
            if (c == options.escapeChar && pos + 1 < data.length &&
                data.charAt(pos + 1) == options.quoteChar) {
                _appendField(field, options.quoteChar, options)
                pos = pos + 1
            } else if (c == options.quoteChar) {
                parserState = STATE_QUOTE_END
            } else if (_isNewline(c)) {
                var width = _newlineWidth(data, pos)
                var newline = _newlineText(data, pos, width)
                _appendField(field, newline, options)
                _observeLinebreak(state, newline)
                pos = pos + width - 1
            } else {
                _appendField(field, c, options)
            }
        } else {
            if (c == delimiter) {
                _finishField(state, options, field)
                parserState = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(state, options, field)
                var width = _newlineWidth(data, pos)
                _observeLinebreak(state, _newlineText(data, pos, width))
                if (_consumeRow(state, options)) { break }
                pos = pos + width - 1
                parserState = STATE_FIELD_START
            } else {
                _addDiagnostic(state, CsvErrorKind.InvalidEscape,
                               "Unexpected character after closing quote")
                _appendField(field, c, options)
                parserState = STATE_UNQUOTED
            }
        }
        pos = pos + 1
    }

    state.byteOffset = data.length
    if (parserState == STATE_QUOTED) {
        _addDiagnostic(state, CsvErrorKind.UnterminatedQuote, "Unterminated quoted field")
    }
    if (field.length > 0 || state.currentColumn > 0 || state.currentRow.length > 0 ||
        parserState == STATE_QUOTED || parserState == STATE_QUOTE_END) {
        _finishField(state, options, field)
    }
    if (state.currentRow.length > 0 && !state.truncated) {
        _consumeRow(state, options)
    }
    if (state.linebreak.length == 0) { state.linebreak = "" }

    return CsvParseReport(state.document, state.diagnostics, delimiter, state.linebreak,
                          state.truncated)
}

// parseReport explicitly opts into recovery and returns any partial document
// together with typed diagnostics.
fn parseReport(data: string, options: CsvParseOptions? = null) -> CsvParseReport {
    return _parseImpl(data, _parseOptions(options))
}

fn _throwDiagnostic(diagnostic: CsvDiagnostic) {
    if (diagnostic.kind == CsvErrorKind.UnterminatedQuote) {
        throw CsvError.UnterminatedQuote(
            diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
            diagnostic.message
        )
    }
    if (diagnostic.kind == CsvErrorKind.InvalidEscape) {
        throw CsvError.InvalidEscape(
            diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
            diagnostic.message
        )
    }
    throw CsvError.FieldCountMismatch(
        diagnostic.byteOffset, diagnostic.line, diagnostic.record, diagnostic.column,
        diagnostic.message
    )
}

// parse is strict: the first recoverable syntax diagnostic enters the enum
// value error channel.
fn parse(data: string, options: CsvParseOptions? = null) -> CsvDocument {
    var report = _parseImpl(data, _parseOptions(options))
    if (report.diagnostics.length > 0) {
        _throwDiagnostic(report.diagnostics[0])
    }
    return report.document
}

fn _needsQuoting(value: string, options: CsvWriteOptions) -> bool {
    if (value.length == 0) { return false }
    if (value.charAt(0) == " " || value.charAt(0) == "\t" ||
        value.charAt(value.length - 1) == " " || value.charAt(value.length - 1) == "\t") {
        return true
    }
    for (var i = 0; i < value.length; i++) {
        var c = value.charAt(i)
        if (c == options.delimiter || c == options.quoteChar || c == options.escapeChar ||
            _isNewline(c)) {
            return true
        }
    }
    return false
}

fn _writeField(out: StringBuilder, value: string, options: CsvWriteOptions) {
    if (!_needsQuoting(value, options)) {
        out.append(value)
        return
    }
    out.append(options.quoteChar)
    var prefixMode = options.escapeChar != options.quoteChar
    for (var i = 0; i < value.length; i++) {
        var c = value.charAt(i)
        if (c == options.quoteChar || (prefixMode && c == options.escapeChar)) {
            out.append(options.escapeChar)
            out.append(c)
        } else {
            out.append(c)
        }
    }
    out.append(options.quoteChar)
}

fn _writeRow(out: StringBuilder, row: Array<string>, options: CsvWriteOptions) {
    for (var i = 0; i < row.length; i++) {
        if (i > 0) { out.append(options.delimiter) }
        _writeField(out, row[i], options)
    }
    out.append(options.linebreak)
}

// stringify accepts only CsvDocument and never guesses how arbitrary values
// should be coerced.
fn stringify(document: CsvDocument, options: CsvWriteOptions? = null) -> string {
    var resolved = _writeOptions(options)
    _validateWriteOptions(resolved)
    var out = StringBuilder()
    if (document.headers.length > 0) {
        _writeRow(out, document.headers, resolved)
    }
    for (row in document.rows) {
        _writeRow(out, row, resolved)
    }
    return out.toString()
}

export {
    CsvDelimiter,
    CsvHeader,
    CsvErrorKind,
    CsvDiagnostic,
    CsvError,
    CsvParseOptions,
    CsvWriteOptions,
    defaultParseOptions,
    defaultWriteOptions,
    CsvDocument,
    CsvParseReport,
    parseReport,
    parse,
    stringify
}
