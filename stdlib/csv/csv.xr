// csv - pure-Xray CSV parser and writer.
//
// CSV is an L4 algorithm module: parsing, dynamic typing, header mapping, and
// stringification live here. File IO stays at the `io` boundary via
// parseFile/writeFile.

import io

const STATE_FIELD_START = 0
const STATE_UNQUOTED = 1
const STATE_QUOTED = 2
const STATE_QUOTE_END = 3

class CsvConfig {
    delimiter: string
    quoteChar: string
    escapeChar: string
    header: bool
    columns: Json
    hasColumns: bool
    dynamicTyping: bool
    trimFields: bool
    skipEmptyLines: bool
    comments: string
    skipRows: int
    maxRows: int
    relaxQuotes: bool
    relaxColumns: bool
    linebreak: string
    nullStrings: Json
    hasNullStrings: bool

    constructor() {
        this.delimiter = ","
        this.quoteChar = "\""
        this.escapeChar = "\""
        this.header = false
        this.columns = []
        this.hasColumns = false
        this.dynamicTyping = false
        this.trimFields = false
        this.skipEmptyLines = true
        this.comments = ""
        this.skipRows = 0
        this.maxRows = 0
        this.relaxQuotes = false
        this.relaxColumns = false
        this.linebreak = "\n"
        this.nullStrings = []
        this.hasNullStrings = false
    }
}

class CsvResult {
    data: Json
    errors: Json
    rows: int
    columns: int
    delimiter: string
    linebreak: string
    truncated: bool
    aborted: bool
    currentRow: Json
    currentRowNum: int
    currentColNum: int
    expectedColumns: int

    constructor(delimiter: string) {
        this.data = []
        this.errors = []
        this.rows = 0
        this.columns = 0
        this.delimiter = delimiter
        this.linebreak = "\n"
        this.truncated = false
        this.aborted = false
        this.currentRow = []
        this.currentRowNum = 0
        this.currentColNum = 0
        this.expectedColumns = -1
    }
}

fn _jsonString(options: Json, key: string, fallback: string) -> string {
    var v = Json.get(options, key, fallback)
    if (typename(v) == "string") { return v }
    return fallback
}

fn _jsonChar(options: Json, key: string, fallback: string) -> string {
    var s = _jsonString(options, key, fallback)
    if (s.length == 0) { return fallback }
    return s.charAt(0)
}

fn _jsonBool(options: Json, key: string, fallback: bool) -> bool {
    var v = Json.get(options, key, fallback)
    if (typename(v) == "bool") { return v }
    return fallback
}

fn _jsonInt(options: Json, key: string, fallback: int) -> int {
    var v = Json.get(options, key, fallback)
    if (typename(v) == "int") { return v }
    return fallback
}

fn _config(optionsValue: unknown) -> CsvConfig {
    var options = Json.encode(optionsValue)
    if (typename(options) != "Json") {
        var emptyOptions: Json = {}
        options = emptyOptions
    }

    var cfg = CsvConfig()
    cfg.delimiter = _jsonChar(options, "delimiter", ",")
    cfg.quoteChar = _jsonChar(options, "quoteChar", "\"")
    cfg.escapeChar = _jsonChar(options, "escapeChar", "\"")
    cfg.header = _jsonBool(options, "header", false)
    cfg.dynamicTyping = _jsonBool(options, "dynamicTyping", false)
    cfg.trimFields = _jsonBool(options, "trimFields", false)
    cfg.skipEmptyLines = _jsonBool(options, "skipEmptyLines", true)
    cfg.comments = _jsonString(options, "comments", "")
    cfg.skipRows = _jsonInt(options, "skipRows", 0)
    cfg.maxRows = _jsonInt(options, "maxRows", 0)
    cfg.relaxQuotes = _jsonBool(options, "relaxQuotes", false)
    cfg.relaxColumns = _jsonBool(options, "relaxColumns", false)
    cfg.linebreak = _jsonString(options, "linebreak", "\n")
    if (cfg.linebreak.length == 0) { cfg.linebreak = "\n" }

    var cols = Json.get(options, "columns", null)
    if (typename(cols) == "Array") {
        cfg.columns = cols
        cfg.hasColumns = true
    }

    if (Json.has(options, "nullStrings")) {
        var ns = Json.get(options, "nullStrings", [])
        if (typename(ns) == "Array") {
            cfg.nullStrings = ns
            cfg.hasNullStrings = true
        }
    }

    return cfg
}

fn _addError(result: CsvResult, typ: string, message: string) {
    result.errors.push({
        type: typ,
        line: -1,
        row: result.currentRowNum,
        column: result.currentColNum,
        message: message
    })
    result.aborted = true
}

fn _isDigitCode(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn _numberKind(s: string) -> int {
    if (s.length == 0) { return 0 }
    var i = 0
    if (s.charAt(i) == "+" || s.charAt(i) == "-") {
        i = i + 1
        if (i >= s.length) { return 0 }
    }

    var wholeDigits = 0
    while (i < s.length && _isDigitCode(s.charAt(i).ord()!)) {
        wholeDigits = wholeDigits + 1
        i = i + 1
    }

    var isFloat = false
    var fracDigits = 0
    if (i < s.length && s.charAt(i) == ".") {
        isFloat = true
        i = i + 1
        while (i < s.length && _isDigitCode(s.charAt(i).ord()!)) {
            fracDigits = fracDigits + 1
            i = i + 1
        }
        if (wholeDigits == 0 && fracDigits == 0) { return 0 }
    }

    if (wholeDigits == 0 && fracDigits == 0) { return 0 }

    if (i < s.length && (s.charAt(i) == "e" || s.charAt(i) == "E")) {
        isFloat = true
        i = i + 1
        if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) {
            i = i + 1
        }
        var expDigits = 0
        while (i < s.length && _isDigitCode(s.charAt(i).ord()!)) {
            expDigits = expDigits + 1
            i = i + 1
        }
        if (expDigits == 0) { return 0 }
    }

    if (i != s.length) { return 0 }
    if (isFloat) { return 2 }
    return 1
}

fn _matchesConfiguredNull(field: string, cfg: CsvConfig) -> bool {
    if (cfg.hasNullStrings) {
        for (v in cfg.nullStrings) {
            if (typename(v) == "string" && field == string(v)) { return true }
        }
        return false
    }
    var lower = field.toLowerCase()
    return field.length == 0 || lower == "null"
}

fn _convertValue(field: string, cfg: CsvConfig) -> Json {
    if (!cfg.dynamicTyping) { return field }

    if (_matchesConfiguredNull(field, cfg)) { return null }

    var lower = field.toLowerCase()
    if (lower == "true") { return true }
    if (lower == "false") { return false }

    var kind = _numberKind(field)
    if (kind == 1) {
        var i = field.toInt()
        if (i != null) { return i! }
    } else if (kind == 2) {
        var f = field.toFloat()
        if (f != null) { return f! }
    }
    return field
}

fn _finishField(result: CsvResult, cfg: CsvConfig, fieldBuilder: StringBuilder) {
    var field = fieldBuilder.toString()
    if (cfg.trimFields) { field = field.trim() }
    result.currentRow.push(_convertValue(field, cfg))
    result.currentColNum = result.currentColNum + 1
    fieldBuilder.clear()
}

fn _startsWith(s: string, prefix: string) -> bool {
    if (prefix.length == 0) { return false }
    if (s.length < prefix.length) { return false }
    return s.slice(0, prefix.length) == prefix
}

fn _isSkippedEmptyRow(row: Json) -> bool {
    if (row.length == 0) { return true }
    if (row.length != 1) { return false }
    var first = row[0]
    return typename(first) == "string" && string(first).length == 0
}

fn _finishRow(result: CsvResult, cfg: CsvConfig, header: Json, mapRows: bool) -> bool {
    var colCount = result.currentRow.length

    if (cfg.skipEmptyLines && _isSkippedEmptyRow(result.currentRow)) {
        result.currentRow = []
        result.currentColNum = 0
        return false
    }

    if (cfg.comments.length > 0 && colCount > 0) {
        var first = result.currentRow[0]
        if (typename(first) == "string" && _startsWith(string(first), cfg.comments)) {
            result.currentRow = []
            result.currentColNum = 0
            return false
        }
    }

    if (result.currentRowNum < cfg.skipRows) {
        result.currentRow = []
        result.currentColNum = 0
        result.currentRowNum = result.currentRowNum + 1
        return false
    }

    if (result.expectedColumns < 0) {
        result.expectedColumns = colCount
        result.columns = colCount
    } else if (colCount != result.expectedColumns && !cfg.relaxColumns) {
        _addError(result, "FieldMismatch",
                  "Expected " + string(result.expectedColumns) + " fields, got " + string(colCount))
    }

    if (mapRows) {
        var obj: Json = {}
        var n = colCount
        if (header.length < n) { n = header.length }
        for (var i = 0; i < n; i++) {
            obj[string(header[i])] = result.currentRow[i]
        }
        result.data.push(obj)
    } else {
        result.data.push(result.currentRow)
    }

    result.rows = result.rows + 1
    result.currentRow = []
    result.currentColNum = 0
    result.currentRowNum = result.currentRowNum + 1

    if (cfg.maxRows > 0 && result.rows >= cfg.maxRows) {
        result.truncated = true
        return true
    }
    return false
}

fn _consumeHeader(result: CsvResult) -> Json {
    var header = result.currentRow
    result.currentRow = []
    result.currentColNum = 0
    result.currentRowNum = result.currentRowNum + 1
    result.expectedColumns = header.length
    result.columns = header.length
    return header
}

fn _isNewline(c: string) -> bool {
    return c == "\n" || c == "\r"
}

fn _skipCRLF(data: string, pos: int, result: CsvResult) -> int {
    if (pos + 1 < data.length && data.charAt(pos) == "\r" && data.charAt(pos + 1) == "\n") {
        result.linebreak = "\r\n"
        return pos + 1
    }
    return pos
}

fn _parseImpl(data: string, cfg: CsvConfig) -> CsvResult {
    var result = CsvResult(cfg.delimiter)
    var header: Json = cfg.columns
    var hasHeader = cfg.hasColumns
    var mapRows = cfg.header || cfg.hasColumns
    var field = StringBuilder()
    var state = STATE_FIELD_START

    var pos = 0
    if (data.length > 0 && data.charAt(0) == "\u{FEFF}") { pos = 1 }

    while (pos < data.length) {
        var c = data.charAt(pos)

        if (state == STATE_FIELD_START) {
            if (c == cfg.quoteChar) {
                state = STATE_QUOTED
            } else if (c == cfg.delimiter) {
                _finishField(result, cfg, field)
            } else if (_isNewline(c)) {
                _finishField(result, cfg, field)
                if (cfg.header && !hasHeader && result.currentRowNum == 0) {
                    header = _consumeHeader(result)
                    hasHeader = true
                } else if (_finishRow(result, cfg, header, mapRows)) {
                    break
                }
                pos = _skipCRLF(data, pos, result)
            } else {
                field.append(c)
                state = STATE_UNQUOTED
            }
        } else if (state == STATE_UNQUOTED) {
            if (c == cfg.delimiter) {
                _finishField(result, cfg, field)
                state = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(result, cfg, field)
                if (cfg.header && !hasHeader && result.currentRowNum == 0) {
                    header = _consumeHeader(result)
                    hasHeader = true
                } else if (_finishRow(result, cfg, header, mapRows)) {
                    break
                }
                pos = _skipCRLF(data, pos, result)
                state = STATE_FIELD_START
            } else {
                field.append(c)
            }
        } else if (state == STATE_QUOTED) {
            if (c == cfg.escapeChar && pos + 1 < data.length &&
                data.charAt(pos + 1) == cfg.quoteChar) {
                field.append(cfg.quoteChar)
                pos = pos + 1
            } else if (c == cfg.quoteChar) {
                state = STATE_QUOTE_END
            } else {
                field.append(c)
            }
        } else if (state == STATE_QUOTE_END) {
            if (c == cfg.delimiter) {
                _finishField(result, cfg, field)
                state = STATE_FIELD_START
            } else if (_isNewline(c)) {
                _finishField(result, cfg, field)
                if (cfg.header && !hasHeader && result.currentRowNum == 0) {
                    header = _consumeHeader(result)
                    hasHeader = true
                } else if (_finishRow(result, cfg, header, mapRows)) {
                    break
                }
                pos = _skipCRLF(data, pos, result)
                state = STATE_FIELD_START
            } else if (c == cfg.quoteChar) {
                if (cfg.relaxQuotes) {
                    field.append(c)
                    state = STATE_QUOTED
                } else {
                    _addError(result, "InvalidEscape", "Unexpected quote after closing quote")
                }
            } else {
                if (!cfg.relaxQuotes) {
                    _addError(result, "InvalidEscape", "Unexpected character after closing quote")
                } else {
                    field.append(c)
                    state = STATE_UNQUOTED
                }
            }
        }

        pos = pos + 1
    }

    if (state == STATE_QUOTED) {
        _addError(result, "UnterminatedQuote", "Unterminated quote")
        return result
    }

    if (field.length > 0 || result.currentColNum > 0 || result.currentRow.length > 0) {
        _finishField(result, cfg, field)
    }

    if (result.currentRow.length > 0) {
        if (cfg.header && !hasHeader && result.currentRowNum == 0) {
            header = _consumeHeader(result)
            hasHeader = true
        } else {
            _finishRow(result, cfg, header, mapRows)
        }
    }

    return result
}

fn _detectDelimiter(data: string) -> string {
    var candidates: Array<string> = [",", "\t", ";", "|"]
    var counts: Array<int> = [0, 0, 0, 0]
    var inQuote = false
    var limit = data.length
    if (limit > 4096) { limit = 4096 }

    for (var i = 0; i < limit; i++) {
        var c = data.charAt(i)
        if (c == "\"") {
            inQuote = !inQuote
            continue
        }
        if (inQuote || _isNewline(c)) { continue }
        for (var j = 0; j < candidates.length; j++) {
            if (c == candidates[j]) { counts[j] = counts[j] + 1 }
        }
    }

    var best = ","
    var bestCount = 0
    for (var j = 0; j < candidates.length; j++) {
        if (counts[j] > bestCount) {
            bestCount = counts[j]
            best = candidates[j]
        }
    }
    return best
}

// parse - Parse CSV text into row arrays, or Json objects when header/columns is enabled.
fn parse(data: string, options: unknown = null) -> Array<Json> {
    var cfg = _config(options)
    return _parseImpl(data, cfg).data as Array<Json>
}

// parseDetailed - Parse CSV text and return data, errors, and parser metadata.
fn parseDetailed(data: string, options: unknown = null) -> Json {
    var cfg = _config(options)
    var result = _parseImpl(data, cfg)
    return {
        data: result.data,
        errors: result.errors,
        meta: {
            rows: result.rows,
            columns: result.columns,
            delimiter: result.delimiter,
            linebreak: result.linebreak,
            truncated: result.truncated,
            aborted: result.aborted
        }
    }
}

// parseTsv - Parse tab-separated text.
fn parseTsv(data: string, options: unknown = null) -> Array<Json> {
    var cfg = _config(options)
    cfg.delimiter = "\t"
    return _parseImpl(data, cfg).data as Array<Json>
}

// parseAuto - Detect a common delimiter and parse the text.
fn parseAuto(data: string, options: unknown = null) -> Array<Json> {
    var cfg = _config(options)
    cfg.delimiter = _detectDelimiter(data)
    return _parseImpl(data, cfg).data as Array<Json>
}

fn _needsQuoting(s: string, cfg: CsvConfig) -> bool {
    if (s.length == 0) { return false }
    if (s.charAt(0) == " " || s.charAt(0) == "\t" ||
        s.charAt(s.length - 1) == " " || s.charAt(s.length - 1) == "\t") {
        return true
    }
    for (var i = 0; i < s.length; i++) {
        var c = s.charAt(i)
        if (c == cfg.delimiter || c == cfg.quoteChar || c == cfg.escapeChar || _isNewline(c)) {
            return true
        }
    }
    return false
}

fn _writeField(out: StringBuilder, value: string, cfg: CsvConfig) {
    if (!_needsQuoting(value, cfg)) {
        out.append(value)
        return
    }
    out.append(cfg.quoteChar)
    var prefixMode = cfg.escapeChar != cfg.quoteChar
    for (var i = 0; i < value.length; i++) {
        var c = value.charAt(i)
        if (c == cfg.quoteChar || (prefixMode && c == cfg.escapeChar)) {
            if (prefixMode) {
                out.append(cfg.escapeChar)
                out.append(c)
            } else {
                out.append(cfg.quoteChar)
                out.append(cfg.quoteChar)
            }
        } else {
            out.append(c)
        }
    }
    out.append(cfg.quoteChar)
}

fn _fieldText(value: Json) -> string {
    var kind = typename(value)
    if (value == null) { return "" }
    if (kind == "string") { return string(value) }
    if (kind == "int" || kind == "float" || kind == "bool") { return string(value) }
    return Json.stringify(value)
}

fn _writeRow(out: StringBuilder, rowValue: unknown, cfg: CsvConfig) {
    var row = Json.encode(rowValue)
    if (typename(row) != "Array") { return }
    for (var i = 0; i < row.length; i++) {
        if (i > 0) { out.append(cfg.delimiter) }
        _writeField(out, _fieldText(row[i]), cfg)
    }
    out.append(cfg.linebreak)
}

// stringify - Convert row arrays or Json object rows to CSV text.
fn stringify(data: unknown, options: unknown = null) -> string {
    var rows = Json.encode(data)
    if (typename(rows) != "Array") { return "" }
    var cfg = _config(options)
    var out = StringBuilder()

    var headers: Array<string> = []
    var isObjectRows = false
    if (rows.length > 0 && typename(rows[0]) == "Json") {
        isObjectRows = true
        headers = rows[0].keys()
        if (cfg.header) { _writeRow(out, headers, cfg) }
    }

    for (var i = 0; i < rows.length; i++) {
        var row = rows[i]
        if (isObjectRows && typename(row) == "Json") {
            var values: Json = []
            for (key in headers) {
                values.push(Json.get(row, key, null))
            }
            _writeRow(out, values, cfg)
        } else if (typename(row) == "Array") {
            _writeRow(out, row, cfg)
        }
    }

    return out.toString()
}

// parseFile - Read a file through io and parse its CSV text.
fn parseFile(path: string, options: unknown = null) -> Array<Json> {
    var content = io.readFile(path)
    if (content == null) {
        var empty: Array<Json> = []
        return empty
    }
    return parse(content!, options)
}

// writeFile - Stringify data and write it through io.
fn writeFile(path: string, data: unknown, options: unknown = null) -> bool {
    return io.writeFile(path, stringify(data, options))
}

export { parse, parseDetailed, parseTsv, parseAuto, stringify, parseFile, writeFile }
