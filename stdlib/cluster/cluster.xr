// cluster - the cluster control plane, stated in Xray.
//
// WHY THIS FILE EXISTS
//   The VM and the AOT backend each carry a whole cluster transport of their
//   own -- stdlib/cluster/cluster.c and stdlib/cluster/cluster_aot.c. Any rule
//   restated in both of them is a rule with two answers, and the two answers
//   have already drifted apart. Both backends compile this file, so a rule
//   stated here has exactly one answer. Every rule that can be stated here is
//   stated here, and the leaves below are left with no policy of their own.
//
// WHAT LIVES HERE
//   The address grammar, the topic language, the node-name rule, the admission
//   checks the four entry points apply, the wire-format constants, the
//   handshake version, the hop limit and the heartbeat schedule.
//
// WHAT DOES NOT
//   Sockets, multicast, TLS, the netpoll, OS threads and the channel subsystem.
//   Those are private native leaves; all protocol bytes, authentication rules,
//   failure-detector math and discovery admission policy live below in Xray.
//
// WIRE FORMAT
//   Normative. Native peer I/O reads only the bounded opaque frame bytes; it
//   does not carry an encoder, decoder, authentication or dispatch projection.
//   tests/diff/cases/semantics/stdlib/cluster_wire_protocol_pure_direct.xr
//   pins this source implementation to byte-exact known answers.
//
//     frame     := u32be(1 + len(payload)) u8(type) payload
//     transport := u8(hopLimit) u8(len(topic)) topic envelope
//     hsReq     := u8(version) u8(len(name)) name nonce[16] u32be(flags)
//     hsAck     := u8(version) u8(len(name)) name nonce[16] proof[32] u32be(flags)
//     hsDone    := proof[32]
//     heartbeat := i64be(timestampMs)
//     coroMon   := u8(len(name)) name
//     coroExit  := u8(len(name)) name u8(len(reason)) reason
//
//   Every length is one byte, so a node name is at most NODE_NAME_MAX and a
//   topic at most TOPIC_PATTERN_MAX. Both are checked here, before a leaf sees
//   them, which is why the leaves no longer check them. proof is
//   HMAC-SHA256(secret, nonce): the primitive is a crypto leaf, the
//   construction is the line above.

import crypto
import math
import mem
import net
import { DialOptions, NetError, UdpFrom } from net
import time

// ========== Protocol constants ==========

// The handshake version both peers must agree on. Bumping it is a wire break:
// there is no version negotiation and none is wanted.
export const HANDSHAKE_VERSION = 6
export const HANDSHAKE_TIMEOUT_MS = 5000

// How many further hops a published envelope may take. Each hop decrements;
// the frame dies when the count reaches zero.
export const TOPIC_DEFAULT_HOP_LIMIT = 3
export const TOPIC_MAX_HOP_LIMIT = 255

export const NODE_NAME_MAX = 63
export const TOPIC_PATTERN_MAX = 127
export const CORO_NAME_MAX = 127

// These are byte limits at the native boundary, not Unicode-scalar limits.
// Keeping them here makes rejection part of the language API instead of
// letting one backend truncate while another rejects.
export const ADDRESS_HOST_MAX_BYTES = 255
export const SHARED_SECRET_MAX_BYTES = 63

// Frame layout. FRAME_HEADER_SIZE is the big-endian length prefix; the type
// octet follows it and is counted inside the prefixed length.
export const FRAME_HEADER_SIZE = 4
export const FRAME_MAX_PAYLOAD = 16777216
export const NONCE_SIZE = 16
export const PROOF_SIZE = 32

// One byte each, matching the type octet on the wire.
export const FRAME_HANDSHAKE_REQ = 0x01
export const FRAME_HANDSHAKE_ACK = 0x02
export const FRAME_HANDSHAKE_DONE = 0x03
export const FRAME_HANDSHAKE_ERR = 0x04
export const FRAME_HEARTBEAT_PING = 0x05
export const FRAME_HEARTBEAT_PONG = 0x06
export const FRAME_TRANSPORT_ENVELOPE = 0x07
export const FRAME_CORO_MONITOR = 0x08
export const FRAME_CORO_DEMONITOR = 0x09
export const FRAME_CORO_EXIT = 0x0A

// An envelope is opaque to the transport, but it is not shapeless: the service
// layer above puts a fixed 64-byte header on every one, and a frame shorter
// than that cannot be a well-formed envelope.
export const ENVELOPE_HEADER_SIZE = 64

// A subscription channel is bounded. Zero would drop every message and the
// upper bound is what the channel subsystem will allocate.
export const SUBSCRIPTION_CAPACITY_MAX = 1048576
export const TOPIC_DELIVERY_FANOUT_MAX = 256
export const OUTPUT_QUEUE_HIGH_WATERMARK_BYTES = 4194304
const _PEER_READ_STALE = 1
const _PEER_READ_RUNTIME_STOPPED = 2
const _PEER_READ_EOF = 3
const _PEER_READ_IO_ERROR = 4
const _PEER_READ_INVALID_LENGTH = 5
const _PEER_READ_PAYLOAD_TOO_LARGE = 6
const _PEER_READ_RESOURCE_UNAVAILABLE = 7
const _PEER_READ_CANCELLED = 8
const _PEER_READ_INVALID_LIMIT = 9
const _PEER_READ_PROVIDER_ERROR = 10
const _PEER_WRITE_DRAINED = 0
const _PEER_WRITE_STALE = 1
const _PEER_WRITE_RUNTIME_STOPPED = 2
const _PEER_WRITE_QUEUE_FULL = 3
const _PEER_WRITE_QUEUE_STOPPED = 4
const _PEER_WRITE_RESOURCE_UNAVAILABLE = 5
const _PEER_WRITE_SOCKET_CLOSED = 6
const _PEER_WRITE_IO_ERROR = 7
const _PEER_WRITE_CANCELLED = 8
const _PEER_WRITE_PROVIDER_ERROR = 9
const _PEER_QUEUE_ACCEPTED = 0
const _PEER_QUEUE_FULL = 1
const _PEER_QUEUE_STOPPED = 2
const _PEER_QUEUE_RESOURCE_UNAVAILABLE = 3
const _PEER_QUEUE_INVALID = 4
export const NODE_MONITOR_CAPACITY = 8
export const COROUTINE_MONITOR_CAPACITY = 1

// The heartbeat schedule. These are the values a node runs with; the leaf is
// told them rather than holding a second copy.
export const HEARTBEAT_INTERVAL_MS = 5000
export const HEARTBEAT_TIMEOUT_MS = 15000
export const MAX_MISSED_HEARTBEATS = 3
export const HEARTBEAT_TICK_MIN_MS = 500
export const TOMBSTONE_RETENTION_MS = 60000

// The phi detector has one policy threshold and one bounded observation
// window. Neither value is a transport concern.
export const PHI_THRESHOLD = 8.0
export const PHI_WINDOW_SIZE = 100
export const PHI_MIN_SAMPLES = 3

// LAN discovery only announces candidates. Authentication still happens on
// the TCP connection, so the datagram contains a non-secret cluster selector.
export const DISCOVERY_MAGIC = 0x58524459
export const DISCOVERY_VERSION = 2
export const DISCOVERY_MULTICAST_GROUP = "239.42.42.42"
export const DISCOVERY_MULTICAST_PORT = 47200
export const DISCOVERY_INTERVAL_MS = 3000
const _DISCOVERY_MULTICAST_TTL = 1
const _DISCOVERY_LOOPBACK = false
const _DISCOVERY_ANNOUNCEMENT_MAX_SIZE = 128
const _CLUSTER_PROTOCOL_FLAGS = 0x01
const _HANDSHAKE_FRAME_BODY_MAX = 513
const _ACCEPT_POLL_MS = 500

type _ClusterSourceState = {
    selfName: string,
    port: i64,
    secret: string,
    heartbeatIntervalMs: i64,
    heartbeatTimeoutMs: i64,
    maxMissedHeartbeats: i64,
    tlsEnabled: bool,
    tlsClientReady: bool,
    tlsServerReady: bool,
}

// Topic routing is ordinary source state. Holding the Channel in this record
// gives the registry its own strong reference, while temporary delivery
// snapshots keep each target alive after the registry lock is released.
type _TopicSubscription = {
    runtimeToken: i64,
    pattern: string,
    notifications: Channel<Buffer>,
}

// Source-owned loops use generation tokens so a retiring coroutine cannot
// affect a later start on the same isolate. Discovery has a separate token
// because callers may enable or restart it independently of cluster startup.
const _discoveryNextToken: Atomic<i64> = Atomic<i64>(0)
const _discoveryActiveToken: Atomic<i64> = Atomic<i64>(0)
const _discoveryHashBits: Atomic<i64> = Atomic<i64>(0)
const _runtimeNextToken: Atomic<i64> = Atomic<i64>(0)
const _runtimeActiveToken: Atomic<i64> = Atomic<i64>(0)
// Serializes source generation retirement with the non-suspending node-down
// notification leaf. This closes the check/call window without moving active
// generation or notification policy into the provider.
const _runtimeDecisionLock: Atomic<bool> = Atomic<bool>(false)
const _topicStateLock: Atomic<bool> = Atomic<bool>(false)
var _topicSubscriptions: Array<_TopicSubscription> = []
// The protected section only copies or swaps one small record and never
// suspends, so a lock-free flag preserves the synchronous public query surface
// without exposing ordinary mutable module state across worker coroutines.
const _sourceStateLock: Atomic<bool> = Atomic<bool>(false)
var _sourceState: _ClusterSourceState? = null

fn _lockSourceState() {
    while (true) {
        var (_, acquired) = _sourceStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockRuntimeDecision() {
    while (true) {
        var (_, acquired) = _runtimeDecisionLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockTopicState() {
    while (true) {
        var (_, acquired) = _topicStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

// Retirement first makes new registrations fail their locked token recheck.
// Detaching the complete registry under the lock makes the cutover atomic;
// closing the detached channels afterwards keeps wakeups out of the spinlock.
fn _closeTopicSubscriptions() {
    _lockTopicState()
    var retired = _topicSubscriptions
    _topicSubscriptions = []
    _topicStateLock.store(false)
    for (var i = 0; i < len(retired); i++) {
        retired[i].notifications.close()
    }
}

fn _retireRuntimeGeneration(token: i64) -> bool {
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() != token) {
        _runtimeDecisionLock.store(false)
        return false
    }
    _runtimeActiveToken.store(0)
    _runtimeDecisionLock.store(false)
    return true
}

fn _retireCurrentRuntimeGeneration() {
    _lockRuntimeDecision()
    _runtimeActiveToken.store(0)
    _runtimeDecisionLock.store(false)
}

fn _notifyNodeDownIfCurrent(token: i64, name: string) {
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() == token) { __notifyNodeDown(name) }
    _runtimeDecisionLock.store(false)
}

fn _sourceStateSnapshot() -> _ClusterSourceState? {
    _lockSourceState()
    var state = copy(_sourceState)
    _sourceStateLock.store(false)
    return state
}

fn _installSourceState(state: _ClusterSourceState) -> bool {
    _lockSourceState()
    if (_sourceState != null) {
        _sourceStateLock.store(false)
        return false
    }
    _sourceState = state
    _sourceStateLock.store(false)
    return true
}

fn _clearSourceState() {
    _lockSourceState()
    _sourceState = null
    _sourceStateLock.store(false)
}

// ========== Wire protocol ===========

export type ClusterFrame = {
    kind: i64,
    payload: Array<u8>,
}

export type ClusterTransportFrame = {
    hopLimit: i64,
    topic: string,
    envelope: Array<u8>,
}

export type ClusterHandshakeRequest = {
    name: string,
    nonce: Array<u8>,
    flags: i64,
}

export type ClusterHandshakeAck = {
    name: string,
    nonce: Array<u8>,
    proof: Array<u8>,
    flags: i64,
}

export type ClusterCoroExit = {
    name: string,
    reason: string,
}

export type ClusterDiscoveryAnnouncement = {
    name: string,
    port: i64,
    clusterHash: u64,
}

type _DiscoveryTombstone = {
    name: string,
    markedAtMs: i64,
}

type _DiscoveryTombstoneSet = {
    entries: Array<_DiscoveryTombstone>,
    names: Array<string>,
}

type _DiscoveryDatagram = {
    sender: UdpFrom,
    bytes: Array<u8>,
}

fn _bytes(text: string) -> Array<u8> {
    var view: const Slice<u8> = text.bytes()
    var out = Array<u8>(len(view))
    for (var i = 0; i < len(view); i++) { out[i] = view[i] }
    return out
}

fn _materializeBuffer(buffer: Buffer) -> Array<u8> {
    var count = len(buffer.asBytes())
    var out = Array<u8>(count)
    for (var i = 0; i < count; i++) { out[i] = buffer.asBytes()[i] }
    return out
}

fn _copyBytes(src: Array<u8>, start: i64, end: i64) -> Array<u8>? {
    if (start < 0 || end < start || end > len(src)) { return null }
    var out = Array<u8>(end - start)
    for (var i = start; i < end; i++) { out[i - start] = src[i] }
    return out
}

fn _text(src: Array<u8>, start: i64, end: i64) -> string? {
    var bytes = _copyBytes(src, start, end)
    if (bytes == null) { return null }
    try {
        return string.fromUtf8(bytes![:])
    } catch (e: Utf8Error) {
        return null
    }
}

fn _appendBytes(out: ref Array<u8>, src: Array<u8>) {
    for (var i = 0; i < len(src); i++) { out.push(src[i]) }
}

fn _writeU16(out: ref Array<u8>, value: i64) {
    out.push(((value >> 8) & 255) as u8)
    out.push((value & 255) as u8)
}

fn _writeU32(out: ref Array<u8>, value: i64) {
    out.push(((value >> 24) & 255) as u8)
    out.push(((value >> 16) & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
    out.push((value & 255) as u8)
}

fn _writeU64(out: ref Array<u8>, value: u64) {
    for (var i = 7; i >= 0; i--) {
        out.push(((value >> ((i * 8) as u64)) & (255 as u64)) as u8)
    }
}

fn _readU16(src: Array<u8>, pos: i64) -> i64 {
    return ((src[pos] as i64) << 8) | (src[pos + 1] as i64)
}

fn _readU32(src: Array<u8>, pos: i64) -> i64 {
    return ((src[pos] as i64) << 24) | ((src[pos + 1] as i64) << 16) |
           ((src[pos + 2] as i64) << 8) | (src[pos + 3] as i64)
}

fn _readU64(src: Array<u8>, pos: i64) -> u64 {
    var value: u64 = 0
    for (var i = 0; i < 8; i++) {
        value = (value << (8 as u64)) | (src[pos + i] as u64)
    }
    return value
}

fn _validFrameKind(kind: i64) -> bool {
    return kind >= FRAME_HANDSHAKE_REQ && kind <= FRAME_CORO_EXIT
}

fn _validFlags(flags: i64) -> bool { return flags >= 0 && flags <= 4294967295 }

// A complete frame encoder/decoder, not a header helper. Exact length checks
// make trailing bytes a protocol error instead of silently accepting two
// concatenated frames as one.
export fn encodeFrame(kind: i64, payload: Array<u8>) -> Array<u8>? {
    if (!_validFrameKind(kind) || len(payload) + 1 > FRAME_MAX_PAYLOAD) { return null }
    var out: Array<u8> = []
    _writeU32(ref out, len(payload) + 1)
    out.push(kind as u8)
    _appendBytes(ref out, payload)
    return out
}

export fn decodeFrame(data: Array<u8>) -> ClusterFrame? {
    if (len(data) < FRAME_HEADER_SIZE + 1) { return null }
    var total = _readU32(data, 0)
    if (total < 1 || total > FRAME_MAX_PAYLOAD || total + FRAME_HEADER_SIZE != len(data)) {
        return null
    }
    var kind = data[FRAME_HEADER_SIZE] as i64
    if (!_validFrameKind(kind)) { return null }
    var payload = _copyBytes(data, FRAME_HEADER_SIZE + 1, len(data))
    if (payload == null) { return null }
    var frame: ClusterFrame = { kind: kind, payload: payload! }
    return frame
}

export fn encodeTransportFrame(hopLimit: i64, topic: string,
                               envelope: Array<u8>) -> Array<u8>? {
    if (hopLimit < 0 || hopLimit > TOPIC_MAX_HOP_LIMIT || !validTopicName(topic) ||
        len(envelope) < ENVELOPE_HEADER_SIZE) { return null }
    var topicBytes = _bytes(topic)
    var payload: Array<u8> = []
    payload.push(hopLimit as u8)
    payload.push(len(topicBytes) as u8)
    _appendBytes(ref payload, topicBytes)
    _appendBytes(ref payload, envelope)
    return encodeFrame(FRAME_TRANSPORT_ENVELOPE, payload)
}

export fn decodeTransportFrame(data: Array<u8>) -> ClusterTransportFrame? {
    var frame = decodeFrame(data)
    if (frame == null || frame!.kind != FRAME_TRANSPORT_ENVELOPE) { return null }
    var payload = frame!.payload
    if (len(payload) < 2) { return null }
    var topicLen = payload[1] as i64
    if (topicLen <= 0 || 2 + topicLen + ENVELOPE_HEADER_SIZE > len(payload)) { return null }
    var topic = _text(payload, 2, 2 + topicLen)
    if (topic == null || !validTopicName(topic!)) { return null }
    var envelope = _copyBytes(payload, 2 + topicLen, len(payload))
    if (envelope == null) { return null }
    var result: ClusterTransportFrame = {
        hopLimit: payload[0] as i64,
        topic: topic!,
        envelope: envelope!,
    }
    return result
}

export fn encodeHandshakeRequest(request: ClusterHandshakeRequest) -> Array<u8>? {
    var name = _bytes(request.name)
    if (!validNodeName(request.name) || len(request.nonce) != NONCE_SIZE ||
        !_validFlags(request.flags)) { return null }
    var payload: Array<u8> = []
    payload.push(HANDSHAKE_VERSION as u8)
    payload.push(len(name) as u8)
    _appendBytes(ref payload, name)
    _appendBytes(ref payload, request.nonce)
    _writeU32(ref payload, request.flags)
    return encodeFrame(FRAME_HANDSHAKE_REQ, payload)
}

export fn decodeHandshakeRequest(payload: Array<u8>) -> ClusterHandshakeRequest? {
    if (len(payload) < 2 + NONCE_SIZE + 4 || payload[0] as i64 != HANDSHAKE_VERSION) {
        return null
    }
    var nameLen = payload[1] as i64
    if (2 + nameLen + NONCE_SIZE + 4 != len(payload)) { return null }
    var name = _text(payload, 2, 2 + nameLen)
    var nonce = _copyBytes(payload, 2 + nameLen, 2 + nameLen + NONCE_SIZE)
    if (name == null || !validNodeName(name!) || nonce == null) { return null }
    var result: ClusterHandshakeRequest = {
        name: name!, nonce: nonce!, flags: _readU32(payload, len(payload) - 4),
    }
    return result
}

export fn encodeHandshakeAck(ack: ClusterHandshakeAck) -> Array<u8>? {
    var name = _bytes(ack.name)
    if (!validNodeName(ack.name) || len(ack.nonce) != NONCE_SIZE ||
        len(ack.proof) != PROOF_SIZE || !_validFlags(ack.flags)) { return null }
    var payload: Array<u8> = []
    payload.push(HANDSHAKE_VERSION as u8)
    payload.push(len(name) as u8)
    _appendBytes(ref payload, name)
    _appendBytes(ref payload, ack.nonce)
    _appendBytes(ref payload, ack.proof)
    _writeU32(ref payload, ack.flags)
    return encodeFrame(FRAME_HANDSHAKE_ACK, payload)
}

export fn decodeHandshakeAck(payload: Array<u8>) -> ClusterHandshakeAck? {
    if (len(payload) < 2 + NONCE_SIZE + PROOF_SIZE + 4 ||
        payload[0] as i64 != HANDSHAKE_VERSION) { return null }
    var nameLen = payload[1] as i64
    if (2 + nameLen + NONCE_SIZE + PROOF_SIZE + 4 != len(payload)) { return null }
    var name = _text(payload, 2, 2 + nameLen)
    var nonce = _copyBytes(payload, 2 + nameLen, 2 + nameLen + NONCE_SIZE)
    var proof = _copyBytes(payload, 2 + nameLen + NONCE_SIZE,
                           2 + nameLen + NONCE_SIZE + PROOF_SIZE)
    if (name == null || !validNodeName(name!) || nonce == null || proof == null) { return null }
    var result: ClusterHandshakeAck = {
        name: name!, nonce: nonce!, proof: proof!, flags: _readU32(payload, len(payload) - 4),
    }
    return result
}

export fn encodeHandshakeDone(proof: Array<u8>) -> Array<u8>? {
    if (len(proof) != PROOF_SIZE) { return null }
    return encodeFrame(FRAME_HANDSHAKE_DONE, proof)
}

export fn decodeHandshakeDone(payload: Array<u8>) -> Array<u8>? {
    if (len(payload) != PROOF_SIZE) { return null }
    return _copyBytes(payload, 0, len(payload))
}

export fn encodeHeartbeat(kind: i64, timestampMs: i64) -> Array<u8>? {
    if (kind != FRAME_HEARTBEAT_PING && kind != FRAME_HEARTBEAT_PONG) { return null }
    var payload: Array<u8> = []
    _writeU64(ref payload, timestampMs as u64)
    return encodeFrame(kind, payload)
}

export fn decodeHeartbeat(payload: Array<u8>) -> i64? {
    if (len(payload) != 8) { return null }
    return _readU64(payload, 0) as i64
}

export fn encodeCoroMonitor(kind: i64, name: string) -> Array<u8>? {
    if ((kind != FRAME_CORO_MONITOR && kind != FRAME_CORO_DEMONITOR) ||
        !_validName(name, CORO_NAME_MAX)) { return null }
    var nameBytes = _bytes(name)
    var payload: Array<u8> = [len(nameBytes) as u8]
    _appendBytes(ref payload, nameBytes)
    return encodeFrame(kind, payload)
}

export fn decodeCoroMonitor(payload: Array<u8>) -> string? {
    if (len(payload) < 1 || payload[0] as i64 + 1 != len(payload)) { return null }
    var name = _text(payload, 1, len(payload))
    if (name == null || !_validName(name!, CORO_NAME_MAX)) { return null }
    return name
}

export fn encodeCoroExit(value: ClusterCoroExit) -> Array<u8>? {
    var name = _bytes(value.name)
    var reason = _bytes(value.reason)
    if (!_validName(value.name, CORO_NAME_MAX) || len(reason) > 255) { return null }
    var payload: Array<u8> = [len(name) as u8]
    _appendBytes(ref payload, name)
    payload.push(len(reason) as u8)
    _appendBytes(ref payload, reason)
    return encodeFrame(FRAME_CORO_EXIT, payload)
}

export fn decodeCoroExit(payload: Array<u8>) -> ClusterCoroExit? {
    if (len(payload) < 2) { return null }
    var nameLen = payload[0] as i64
    if (1 + nameLen >= len(payload)) { return null }
    var reasonLen = payload[1 + nameLen] as i64
    if (2 + nameLen + reasonLen != len(payload)) { return null }
    var name = _text(payload, 1, 1 + nameLen)
    var reason = _text(payload, 2 + nameLen, len(payload))
    if (name == null || !_validName(name!, CORO_NAME_MAX) || reason == null) { return null }
    var result: ClusterCoroExit = { name: name!, reason: reason! }
    return result
}

// The native reader owns only socket framing. Every protocol decision after a
// complete bounded frame reaches this source callback, keyed by a unique peer
// generation so a delayed continuation cannot address a replacement peer.
fn _forwardRemoteMonitor(peerGeneration: i64, name: string) {
    const notifications = Coro.monitor(name)
    var reason = match (notifications.recv()) {
        Recv.Value { value: value } -> value
        _ -> "noproc"
    }
    var exited: ClusterCoroExit = { name: name, reason: reason }
    var response = encodeCoroExit(exited)
    if (response != null) { _enqueueControlFrame(peerGeneration, response!) }
}

// Detachment is generation-keyed and returns the detached node name as a raw
// provider fact. Only the source generation that stayed active throughout the
// detach may select the node-down notification effect.
fn _disconnectPeer(peerGeneration: i64) {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return }
    var name = __detachPeer(peerGeneration)
    if (name != null) { _notifyNodeDownIfCurrent(token, name!) }
}

fn _enqueueControlFrame(peerGeneration: i64, wire: Array<u8>) {
    var admission = __peerEnqueue(peerGeneration, wire)
    if (admission == _PEER_QUEUE_FULL ||
        admission == _PEER_QUEUE_RESOURCE_UNAVAILABLE ||
        admission == _PEER_QUEUE_INVALID) {
        _disconnectPeer(peerGeneration)
    }
}

fn _dispatchInboundFrame(peerGeneration: i64, receivedAtMs: i64,
                         wire: Array<u8>) -> bool {
    var frame = decodeFrame(wire)
    if (frame == null) { return false }
    if (frame!.kind == FRAME_HEARTBEAT_PING) {
        var timestamp = decodeHeartbeat(frame!.payload)
        if (timestamp == null) { return true }
        var response = encodeHeartbeat(FRAME_HEARTBEAT_PONG, timestamp!)
        if (response != null) { _enqueueControlFrame(peerGeneration, response!) }
        __observeHeartbeat(peerGeneration, receivedAtMs, -1)
        return true
    }
    if (frame!.kind == FRAME_HEARTBEAT_PONG) {
        var timestamp = decodeHeartbeat(frame!.payload)
        if (timestamp != null) {
            var rtt = receivedAtMs - timestamp!
            __observeHeartbeat(peerGeneration, receivedAtMs, rtt < 0 ? 0 : rtt)
        }
        return true
    }
    if (frame!.kind == FRAME_TRANSPORT_ENVELOPE) {
        var transport = decodeTransportFrame(wire)
        if (transport == null) { return true }
        _deliverTopic(transport!.topic, transport!.envelope)
        if (transport!.hopLimit > 0) {
            var forward = encodeTransportFrame(transport!.hopLimit - 1, transport!.topic,
                                               transport!.envelope)
            if (forward != null) { __broadcast(peerGeneration, forward!) }
        }
        return true
    }
    if (frame!.kind == FRAME_CORO_MONITOR) {
        var name = decodeCoroMonitor(frame!.payload)
        if (name != null) { go _forwardRemoteMonitor(peerGeneration, name!) }
        return true
    }
    if (frame!.kind == FRAME_CORO_EXIT) {
        var exited = decodeCoroExit(frame!.payload)
        if (exited != null) {
            __notifyRemoteMonitor(peerGeneration, exited!.name, exited!.reason)
        }
        return true
    }
    // CORO_DEMONITOR is deliberately a no-op until remote monitor identity is
    // part of the wire contract; the protocol has no safe removal key today.
    return true
}

fn _dispatchInboundResult(peerGeneration: i64, wire: Array<u8>?, reason: i64) {
    var keep = false
    if (wire != null) {
        keep = _dispatchInboundFrame(peerGeneration, time.monotonic(), wire!)
        if (!keep) { _disconnectPeer(peerGeneration) }
    } else if (reason == _PEER_READ_EOF || reason == _PEER_READ_IO_ERROR ||
        reason == _PEER_READ_INVALID_LENGTH || reason == _PEER_READ_PAYLOAD_TOO_LARGE ||
        reason == _PEER_READ_RESOURCE_UNAVAILABLE || reason == _PEER_READ_INVALID_LIMIT ||
        reason == _PEER_READ_PROVIDER_ERROR) {
        _disconnectPeer(peerGeneration)
    }
    if (keep) { _dispatchInbound(peerGeneration) }
}

fn _dispatchInbound(peerGeneration: i64) {
    var started = __readPeer(peerGeneration, FRAME_MAX_PAYLOAD, _dispatchInboundResult)
    if (started != 0) { _dispatchInboundResult(peerGeneration, null, started) }
}

// HMAC-SHA256 is provided by crypto.xr; cluster owns the proof construction
// and fixed sizes. No native cluster authentication policy remains.
export fn computeHandshakeProof(secret: string, nonce: Array<u8>) -> Array<u8>? {
    if (len(nonce) != NONCE_SIZE) { return null }
    return crypto.hmacBytes("sha256", _bytes(secret), nonce)
}

export fn handshakeProofEqual(left: Array<u8>, right: Array<u8>) -> bool {
    if (len(left) != PROOF_SIZE || len(right) != PROOF_SIZE) { return false }
    return crypto.timingSafeEqualBytes(left, right)
}

// ========== Failure detection ===========

// Native peer tables retain detector samples because socket callbacks update
// them under the peer lock. Both live health decisions and diagnostic snapshots
// project those raw scalars through this one source-owned formula.
fn _phiValue(samples: i64, mean: f64, variance: f64,
             lastHeartbeatMs: i64, nowMs: i64) -> f64 {
    if (lastHeartbeatMs == 0 || samples < 2) { return 0.0 }
    var elapsed = (nowMs - lastHeartbeatMs) as f64
    if (elapsed < 0.0) { elapsed = 0.0 }
    var stddev = math.sqrt(variance)
    if (stddev < 1.0) { stddev = 1.0 }
    var y = (elapsed - mean) / stddev
    var later = 1.0 / (1.0 + math.exp(1.7155 * y))
    if (later < 0.000000000000001) { later = 0.000000000000001 }
    return -math.log10(later)
}

export final class PhiDetector {
    intervals: Array<f64>
    sampleCount: i64
    writeIndex: i64
    mean: f64
    variance: f64
    sum: f64
    sumSquares: f64
    lastHeartbeatMs: i64

    constructor(expectedIntervalMs: i64 = HEARTBEAT_INTERVAL_MS) {
        this.intervals = Array<f64>(PHI_WINDOW_SIZE)
        this.sampleCount = 0
        this.writeIndex = 0
        this.mean = expectedIntervalMs as f64
        this.variance = 100.0
        this.sum = 0.0
        this.sumSquares = 0.0
        this.lastHeartbeatMs = 0
    }

    ref record(nowMs: i64) {
        if (this.lastHeartbeatMs > 0) {
            var interval = (nowMs - this.lastHeartbeatMs) as f64
            if (interval < 0.0) { interval = 0.0 }
            if (this.sampleCount >= PHI_WINDOW_SIZE) {
                var old = this.intervals[this.writeIndex]
                this.sum = this.sum - old
                this.sumSquares = this.sumSquares - old * old
            } else {
                this.sampleCount = this.sampleCount + 1
            }
            this.intervals[this.writeIndex] = interval
            this.writeIndex = (this.writeIndex + 1) % PHI_WINDOW_SIZE
            this.sum = this.sum + interval
            this.sumSquares = this.sumSquares + interval * interval
            this.mean = this.sum / (this.sampleCount as f64)
            this.variance = this.sumSquares / (this.sampleCount as f64) - this.mean * this.mean
            if (this.variance < 1.0) { this.variance = 1.0 }
        }
        this.lastHeartbeatMs = nowMs
    }

    value(nowMs: i64) -> f64 {
        return _phiValue(this.sampleCount, this.mean, this.variance,
                         this.lastHeartbeatMs, nowMs)
    }
}

// The writer reports only transport facts: the queue crossed its configured
// high-watermark or the socket stopped accepting bytes. Detaching that peer is
// a source policy decision and uses the same generation-safe path as inbound
// termination, so a delayed callback cannot close a replacement connection.
fn _dispatchOutboundResult(peerGeneration: i64, status: i64) {
    if (status == _PEER_WRITE_STALE || status == _PEER_WRITE_RUNTIME_STOPPED ||
        status == _PEER_WRITE_QUEUE_STOPPED || status == _PEER_WRITE_CANCELLED) {
        return
    }
    if (status == _PEER_WRITE_QUEUE_FULL ||
        status == _PEER_WRITE_RESOURCE_UNAVAILABLE ||
        status == _PEER_WRITE_SOCKET_CLOSED || status == _PEER_WRITE_IO_ERROR ||
        status == _PEER_WRITE_PROVIDER_ERROR) {
        _disconnectPeer(peerGeneration)
        return
    }
    if (status == _PEER_WRITE_DRAINED) { _dispatchOutbound(peerGeneration) }
}

fn _dispatchOutbound(peerGeneration: i64) {
    var started = __writePeer(peerGeneration, _dispatchOutboundResult)
    if (started != 0) { _dispatchOutboundResult(peerGeneration, started) }
}

// During detector warm-up the fixed timeout is deliberately conservative;
// once three samples exist, phi alone decides liveness.
export fn heartbeatIsDead(phi: f64, samples: i64, elapsedMs: i64,
                          missedHeartbeats: i64, timeoutMs: i64,
                          maxMissedHeartbeats: i64) -> bool {
    if (samples >= PHI_MIN_SAMPLES) { return phi > PHI_THRESHOLD }
    if (elapsedMs <= timeoutMs) { return false }
    return missedHeartbeats + 1 >= maxMissedHeartbeats
}

export fn heartbeatTickInterval(intervalMs: i64) -> i64 {
    var tick = intervalMs / 2
    return tick < HEARTBEAT_TICK_MIN_MS ? HEARTBEAT_TICK_MIN_MS : tick
}

export fn tombstoneIsLive(markedAtMs: i64, nowMs: i64) -> bool {
    if (nowMs < markedAtMs) { return true }
    return nowMs - markedAtMs < TOMBSTONE_RETENTION_MS
}

// ========== Discovery policy ===========

export fn discoveryClusterHash(secret: string) -> u64 {
    if (len(secret) == 0) { return 0 }
    var hash: u64 = 14695981039346656037
    var bytes: const Slice<u8> = secret.bytes()
    for (var i = 0; i < len(bytes); i++) {
        hash = (hash ^ (bytes[i] as u64)) * (1099511628211 as u64)
    }
    return hash
}

export fn encodeDiscoveryAnnouncement(value: ClusterDiscoveryAnnouncement) -> Array<u8>? {
    if (!validNodeName(value.name) || value.port <= 0 || value.port > 65535) { return null }
    var name = _bytes(value.name)
    var out: Array<u8> = []
    _writeU32(ref out, DISCOVERY_MAGIC)
    out.push(DISCOVERY_VERSION as u8)
    out.push(len(name) as u8)
    _appendBytes(ref out, name)
    _writeU16(ref out, value.port)
    _writeU64(ref out, value.clusterHash)
    return out
}

export fn decodeDiscoveryAnnouncement(data: Array<u8>) -> ClusterDiscoveryAnnouncement? {
    if (len(data) < 16 || _readU32(data, 0) != DISCOVERY_MAGIC ||
        data[4] as i64 != DISCOVERY_VERSION) { return null }
    var nameLen = data[5] as i64
    if (6 + nameLen + 2 + 8 != len(data)) { return null }
    var name = _text(data, 6, 6 + nameLen)
    var port = _readU16(data, 6 + nameLen)
    if (name == null || !validNodeName(name!) || port <= 0) { return null }
    var result: ClusterDiscoveryAnnouncement = {
        name: name!, port: port, clusterHash: _readU64(data, 8 + nameLen),
    }
    return result
}

export fn shouldJoinDiscoveredNode(selfName: string, connectedNames: Array<string>,
                                   tombstones: Array<string>,
                                   announcement: ClusterDiscoveryAnnouncement,
                                   expectedClusterHash: u64) -> bool {
    if (announcement.clusterHash != expectedClusterHash || announcement.name == selfName) {
        return false
    }
    for (var i = 0; i < len(tombstones); i++) {
        if (tombstones[i] == announcement.name) { return false }
    }
    for (var i = 0; i < len(connectedNames); i++) {
        if (connectedNames[i] == announcement.name) { return false }
    }
    return true
}

fn _releaseDiscovery(token: i64) {
    var (_, released) = _discoveryActiveToken.compareExchange(token, 0)
}

fn _drainDiscoveryTombstones(notifications: Channel<string>,
                             tombstones: Array<_DiscoveryTombstone>,
                             nowMs: i64) -> Array<_DiscoveryTombstone> {
    var current: Array<_DiscoveryTombstone> = []
    for (var i = 0; i < len(tombstones); i++) { current.push(tombstones[i]) }
    while (true) {
        match (notifications.tryRecv()) {
            Recv.Value { value: departed } -> {
                var retained: Array<_DiscoveryTombstone> = []
                for (var i = 0; i < len(current); i++) {
                    var entry = current[i]
                    if (entry.name != departed && tombstoneIsLive(entry.markedAtMs, nowMs)) {
                        retained.push(entry)
                    }
                }
                retained.push({ name: departed, markedAtMs: nowMs })
                current = retained
            }
            _ -> { break }
        }
    }
    return current
}

fn _liveDiscoveryTombstones(tombstones: Array<_DiscoveryTombstone>,
                            nowMs: i64) -> _DiscoveryTombstoneSet {
    var retained: Array<_DiscoveryTombstone> = []
    var names: Array<string> = []
    for (var i = 0; i < len(tombstones); i++) {
        var entry = tombstones[i]
        if (tombstoneIsLive(entry.markedAtMs, nowMs)) {
            retained.push(entry)
            names.push(entry.name)
        }
    }
    var result: _DiscoveryTombstoneSet = { entries: retained, names: names }
    return result
}

fn _hexNibble(c: rune) -> i64 {
    var n = c.toUInt32()
    if (n >= 48 && n <= 57) { return (n - 48) as i64 }
    if (n >= 65 && n <= 70) { return (n - 55) as i64 }
    if (n >= 97 && n <= 102) { return (n - 87) as i64 }
    return -1
}

fn _handshakeNonce() -> Array<u8>? {
    var hex = crypto.randomBytes(NONCE_SIZE)
    if (len(hex) != NONCE_SIZE * 2) { return null }
    var nonce = Array<u8>(NONCE_SIZE)
    for (var i = 0; i < NONCE_SIZE; i++) {
        var hi = _hexNibble(hex.runes().nth(i * 2))
        var lo = _hexNibble(hex.runes().nth(i * 2 + 1))
        if (hi < 0 || lo < 0) { return null }
        nonce[i] = (((hi << 4) | lo) & 255) as u8
    }
    return nonce
}

fn _readExact(conn: NetConn, count: i64) -> Array<u8>? {
    if (count <= 0) { return null }
    var out: Array<u8> = []
    while (len(out) < count) {
        var remaining = count - len(out)
        var chunk = Array<u8>(remaining)
        var n = net.readInto(conn, ref chunk, remaining)
        if (n <= 0) { return null }
        _appendBytes(ref out, chunk)
    }
    return out
}

fn _readHandshakeFrame(conn: NetConn) -> ClusterFrame? {
    var header = _readExact(conn, FRAME_HEADER_SIZE)
    if (header == null) { return null }
    var bodySize = _readU32(header!, 0)
    if (bodySize < 1 || bodySize > _HANDSHAKE_FRAME_BODY_MAX) { return null }
    var body = _readExact(conn, bodySize)
    if (body == null) { return null }
    var wire = header!
    _appendBytes(ref wire, body!)
    return decodeFrame(wire)
}

fn _mayPublishPeer(name: string) -> bool {
    if (name == self() || __recentlyDeparted(name)) { return false }
    var connected = nodes()
    if (connected == null) { return false }
    for (var i = 0; i < len(connected!); i++) {
        if (connected![i] == name) { return false }
    }
    return true
}

// Fold dial's error into a nullable result before establishing the unique
// local that is eventually transferred into the node registry.
fn _dialJoinPeer(host: string, port: i64, timeoutMs: i64) -> NetConn? {
    try {
        return net.dial(host, port, DialOptions(timeoutMs, false))
    } catch (e: NetError) {
        return null
    }
}

fn _joinPeer(host: string, port: i64) -> bool {
    var source = _sourceStateSnapshot()
    if (source == null) { return false }
    var config = source!
    var deadline = time.monotonic() + HANDSHAKE_TIMEOUT_MS
    var pending = _dialJoinPeer(host, port, HANDSHAKE_TIMEOUT_MS)
    if (pending == null) { return false }
    var live: NetConn = pending!
    pending = null
    if (!net.setDeadline(live, deadline)) {
        net.close(live)
        return false
    }

    if (config.tlsEnabled && __joinTls(live, host, deadline) != 0) {
        // The TLS provider consumes the failed socket, matching net.upgradeTLS.
        return false
    }

    var nonce = _handshakeNonce()
    if (nonce == null) {
        net.close(live)
        return false
    }
    var requestValue: ClusterHandshakeRequest = {
        name: self(), nonce: nonce!, flags: _CLUSTER_PROTOCOL_FLAGS,
    }
    var request = encodeHandshakeRequest(requestValue)
    if (request == null || net.writeBytes(live, request!) != len(request!)) {
        net.close(live)
        return false
    }

    var frame = _readHandshakeFrame(live)
    if (frame == null || frame!.kind != FRAME_HANDSHAKE_ACK) {
        net.close(live)
        return false
    }
    var ack = decodeHandshakeAck(frame!.payload)
    if (ack == null) {
        net.close(live)
        return false
    }
    var expected = computeHandshakeProof(config.secret, nonce!)
    if (expected == null || !handshakeProofEqual(expected!, ack!.proof)) {
        net.close(live)
        return false
    }

    var doneProof = computeHandshakeProof(config.secret, ack!.nonce)
    if (doneProof == null) {
        net.close(live)
        return false
    }
    var done = encodeHandshakeDone(doneProof!)
    if (done == null || net.writeBytes(live, done!) != len(done!)) {
        net.close(live)
        return false
    }
    if (!_mayPublishPeer(ack!.name)) {
        net.close(live)
        return false
    }
    return __adoptPeer(move live, ack!.name, host, port, ack!.flags,
                       config.heartbeatIntervalMs, _dispatchInbound, _dispatchOutbound)
}

fn _serveAcceptedPeer(conn: move NetConn, token: i64, selfName: string, secret: string,
                      tlsEnabled: bool, tlsServerReady: bool, heartbeatIntervalMs: i64) {
    var deadline = time.monotonic() + HANDSHAKE_TIMEOUT_MS
    if (_runtimeActiveToken.load() != token || !net.setDeadline(conn, deadline)) {
        net.close(conn)
        return
    }

    if (tlsEnabled && !tlsServerReady) {
        net.close(conn)
        return
    }
    if (tlsEnabled && __acceptTls(conn, deadline) != 0) {
        // The TLS provider closes the failed handle.
        return
    }
    if (_runtimeActiveToken.load() != token) {
        net.close(conn)
        return
    }

    var frame = _readHandshakeFrame(conn)
    if (frame == null || frame!.kind != FRAME_HANDSHAKE_REQ) {
        net.close(conn)
        return
    }
    var request = decodeHandshakeRequest(frame!.payload)
    if (request == null || !_mayPublishPeer(request!.name)) {
        net.close(conn)
        return
    }

    var nonce = _handshakeNonce()
    if (nonce == null) {
        net.close(conn)
        return
    }
    var proof = computeHandshakeProof(secret, request!.nonce)
    if (proof == null) {
        net.close(conn)
        return
    }
    var ackValue: ClusterHandshakeAck = {
        name: selfName, nonce: nonce!, proof: proof!, flags: _CLUSTER_PROTOCOL_FLAGS,
    }
    var ack = encodeHandshakeAck(ackValue)
    if (ack == null || net.writeBytes(conn, ack!) != len(ack!)) {
        net.close(conn)
        return
    }

    var doneFrame = _readHandshakeFrame(conn)
    if (doneFrame == null || doneFrame!.kind != FRAME_HANDSHAKE_DONE) {
        net.close(conn)
        return
    }
    var done = decodeHandshakeDone(doneFrame!.payload)
    var expected = computeHandshakeProof(secret, nonce!)
    if (done == null || expected == null || !handshakeProofEqual(done!, expected!)) {
        net.close(conn)
        return
    }
    if (_runtimeActiveToken.load() != token || !_mayPublishPeer(request!.name)) {
        net.close(conn)
        return
    }
    __adoptPeer(move conn, request!.name, "", 0, request!.flags, heartbeatIntervalMs,
                _dispatchInbound, _dispatchOutbound)
}

// Keep the affine connection inside a single-iteration frame. A loop-carried
// local would have one source identity on both sides of its back edge, which
// cannot be consumed by one iteration and then reused by the next.
fn _acceptOne(listener: NetListener, token: i64, selfName: string, secret: string,
              tlsEnabled: bool, tlsServerReady: bool, heartbeatIntervalMs: i64) -> bool {
    if (!net.setAcceptDeadline(listener, time.monotonic() + _ACCEPT_POLL_MS)) {
        if (_runtimeActiveToken.load() != token) { return false }
        time.sleep(10)
        return true
    }
    var accepted = net.accept(listener)
    if (accepted == null) {
        if (_runtimeActiveToken.load() != token) { return false }
        if (net.lastError(listener) != NetError.Timeout) { time.sleep(10) }
        return true
    }
    var live: NetConn = accepted!
    accepted = null
    if (_runtimeActiveToken.load() != token) {
        net.close(live)
        return false
    }
    go _serveAcceptedPeer(move live, token, selfName, secret, tlsEnabled, tlsServerReady,
                          heartbeatIntervalMs)
    return true
}

fn _acceptLoop(listener: NetListener, token: i64, selfName: string, secret: string,
               tlsEnabled: bool, tlsServerReady: bool, heartbeatIntervalMs: i64) {
    var live = listener
    defer { net.close(live) }
    while (_runtimeActiveToken.load() == token &&
           _acceptOne(live, token, selfName, secret, tlsEnabled, tlsServerReady,
                      heartbeatIntervalMs)) {}
}

fn _stopFailedHealthGeneration(token: i64) {
    if (!_retireRuntimeGeneration(token)) { return }
    _closeTopicSubscriptions()
    __stop()
    _clearSourceState()
}

fn _healthLoop(token: i64, tickMs: i64, heartbeatTimeoutMs: i64,
               maxMissedHeartbeats: i64) {
    while (_runtimeActiveToken.load() == token) {
        time.sleep(tickMs)
        if (_runtimeActiveToken.load() != token) { return }
        var sentAtMs = time.monotonic()
        var heartbeat = encodeHeartbeat(FRAME_HEARTBEAT_PING, sentAtMs)
        if (heartbeat == null) {
            _stopFailedHealthGeneration(token)
            return
        }
        var peers = __healthSnapshot(heartbeat!, sentAtMs)
        if (peers == null) {
            _stopFailedHealthGeneration(token)
            return
        }
        for (var i = 0; i < len(peers!); i++) {
            var peer = peers![i]
            var elapsedMs = sentAtMs - peer.lastReceivedAtMs
            var phi = _phiValue(peer.samples, peer.mean, peer.variance,
                                peer.detectorLastHeartbeatMs, sentAtMs)
            var expiredDuringWarmup = peer.samples < PHI_MIN_SAMPLES &&
                                      elapsedMs > heartbeatTimeoutMs
            var dead = heartbeatIsDead(phi, peer.samples, elapsedMs, peer.missedHeartbeats,
                                       heartbeatTimeoutMs, maxMissedHeartbeats)
            if (dead || expiredDuringWarmup) {
                var nextMissed = expiredDuringWarmup ? peer.missedHeartbeats + 1
                                                     : peer.missedHeartbeats
                __applyHealthDecision(peer.peerGeneration, peer.lastReceivedAtMs,
                                      peer.missedHeartbeats, nextMissed, dead, sentAtMs)
            }
        }
    }
}

fn _activateClusterSource(started: bool, state: _ClusterSourceState, tickMs: i64,
                          pending: move NetListener?) -> bool {
    if (pending == null) { return false }
    const listener: NetListener = pending!
    pending = null
    if (!started) {
        net.close(listener)
        return false
    }
    if (!_installSourceState(state)) {
        net.close(listener)
        __stop()
        return false
    }
    _discoveryHashBits.store(discoveryClusterHash(state.secret) as i64)
    var token = _runtimeNextToken.fetchAdd(1) + 1
    var (_, acquired) = _runtimeActiveToken.compareExchange(0, token)
    if (!acquired) {
        net.close(listener)
        __stop()
        _clearSourceState()
        return false
    }
    go _healthLoop(token, tickMs, state.heartbeatTimeoutMs, state.maxMissedHeartbeats)
    if (state.tlsEnabled && !state.tlsServerReady) {
        net.close(listener)
        return true
    }
    if (!__trackListener(listener)) {
        _retireRuntimeGeneration(token)
        _closeTopicSubscriptions()
        net.close(listener)
        __stop()
        _clearSourceState()
        return false
    }
    // Tracking intentionally establishes a borrowed provider alias used only
    // to wake stop.  Transfer a retained listener reference to the accept
    // coroutine; that coroutine remains the sole closer.
    go _acceptLoop(listener, token, state.selfName, state.secret, state.tlsEnabled,
                   state.tlsServerReady, state.heartbeatIntervalMs)
    return true
}

fn _joinDiscoveredNode(host: string, port: i64) { _joinPeer(host, port) }

// Isolate coroutine creation from the loop-carried tombstone owner.  The
// scheduling frame contains only copied scalar values, so the discovery loop
// never carries a borrowed ref-place load across `go`.
fn _scheduleDiscoveredNode(host: string, port: i64) {
    go _joinDiscoveredNode(host, port)
}

// The mutable receive buffer belongs to one suspension frame. Returning the
// filled array prevents a ref-place load from becoming loop-carried across the
// next recvFrom suspension.
fn _receiveDiscoveryDatagram(conn: NetConn, waitMs: i64) -> _DiscoveryDatagram? {
    var bytes = Array<u8>(_DISCOVERY_ANNOUNCEMENT_MAX_SIZE)
    var sender = net.recvFrom(conn, ref bytes, waitMs)
    if (sender == null) { return null }
    var datagram: _DiscoveryDatagram = { sender: sender!, bytes: bytes }
    return datagram
}

fn _discoveryLoop(socket: move NetConn, notifications: Channel<string>, selfName: string,
                  expectedHash: u64, announcement: move Array<u8>, token: i64) {
    var live = socket
    var wire = announcement
    defer {
        net.close(live)
        notifications.close()
        _releaseDiscovery(token)
    }

    var tombstones: Array<_DiscoveryTombstone> = []
    var nextAnnouncementMs = 0
    while (_discoveryActiveToken.load() == token) {
        var nowMs = time.monotonic()
        tombstones = _drainDiscoveryTombstones(notifications, tombstones, nowMs)
        if (nowMs >= nextAnnouncementMs) {
            try {
                net.sendTo(live, wire, DISCOVERY_MULTICAST_GROUP,
                           DISCOVERY_MULTICAST_PORT, 0)
            } catch (e) {}
            nextAnnouncementMs = nowMs + DISCOVERY_INTERVAL_MS
        }

        var waitMs = nextAnnouncementMs - time.monotonic()
        if (waitMs < 1) { waitMs = 1 }
        var datagram = _receiveDiscoveryDatagram(live, waitMs)
        if (datagram == null) {
            var error = net.lastError(live)
            if (error != null && error != NetError.Timeout) { return }
            continue
        }
        if (_discoveryActiveToken.load() != token) { return }

        nowMs = time.monotonic()
        tombstones = _drainDiscoveryTombstones(notifications, tombstones, nowMs)
        var candidate = decodeDiscoveryAnnouncement(datagram!.bytes)
        var connected = nodes()
        if (candidate == null || connected == null) { continue }
        var tombstoneSet = _liveDiscoveryTombstones(tombstones, nowMs)
        tombstones = tombstoneSet.entries
        var departed = tombstoneSet.names
        if (shouldJoinDiscoveredNode(selfName, connected!, departed, candidate!, expectedHash)) {
            var peerHost = copy(datagram!.sender.host)
            var peerPort = candidate!.port
            // End every optional-record projection before `go`: these
            // projections are borrowed places, whereas the coroutine receives
            // only the independent host/port values above.
            datagram = null
            candidate = null
            connected = null
            _scheduleDiscoveredNode(peerHost, peerPort)
        }
    }
}

// ========== Configuration ==========

export type ClusterTlsOptions = {
    enabled: bool,
    caFile: string?,
    certFile: string?,
    keyFile: string?,
    insecure: bool,
}

export type ClusterConfig = {
    name: string,
    port: i64,
    secret: string?,
    tls: ClusterTlsOptions?,
    // The heartbeat schedule, when this node wants one of its own. Omitting a
    // field leaves it null and takes the constant above, so the defaults still
    // have exactly one owner and a caller who needs a faster detector no longer
    // has to be told the numbers are not negotiable.
    heartbeatIntervalMs: i64?,
    heartbeatTimeoutMs: i64?,
    maxMissedHeartbeats: i64?,
}

// Public cluster values are declared here rather than injected by the native
// registry. The transport crosses the private boundary with scalar codes and
// internal snapshots; this module owns the public nominal identities and the
// mapping from runtime state to the API.
export enum ClusterDelivery {
    Accepted,
    InvalidTopic,
    InvalidEnvelope,
    Unavailable,
    Overloaded,
    Disconnected,
}

export enum ClusterNodeState {
    Idle,
    Connecting,
    Handshaking,
    Connected,
    Closing,
}

export type ClusterTlsStatus = {
    enabled: bool,
    clientReady: bool,
    serverReady: bool,
}

export type ClusterNodeInfo = {
    name: string,
    host: string,
    port: i64,
    state: ClusterNodeState,
    framesSent: i64,
    framesReceived: i64,
    bytesSent: i64,
    bytesReceived: i64,
    sendErrors: i64,
    slowConsumerEvents: i64,
    rttMs: i64,
    outQueueBytes: i64,
    outQueueFrames: i64,
    slow: bool,
    phi: f64,
    missedHeartbeats: i64,
}

export type ClusterInfo = {
    self: string,
    port: i64,
    running: bool,
    nodes: Array<ClusterNodeInfo>,
    listeners: i64,
    deadNodes: i64,
    heartbeatIntervalMs: i64,
    heartbeatTimeoutMs: i64,
    maxMissedHeartbeats: i64,
    tls: ClusterTlsStatus,
}

export enum AddressError {
    MissingPort { address: string },
    InvalidHost { host: string },
    InvalidPort { port: string }
}

export class NodeAddress {
    host: string
    port: i64

    constructor(host: string, port: i64) {
        this.host = host
        this.port = port
    }
}

// ========== Naming rules ==========

// Byte-indexed on purpose. `s.runes().nth(i)` costs O(i), so the obvious
// rune loop would make every one of these rules quadratic in the length of a
// name that is checked on every join and every publish.
fn _asciiPrintable(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 0x20 || c > 0x7E) { return false }
    }
    return true
}

fn _asciiVisible(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 0x21 || c > 0x7E) { return false }
    }
    return true
}

fn _containsZeroByte(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        if (b[i] == 0) { return true }
    }
    return false
}

fn _fitsCString(s: string, maxBytes: i64, allowEmpty: bool) -> bool {
    const b: Slice<u8> = s.bytes()
    if ((!allowEmpty && len(b) == 0) || len(b) > maxBytes) { return false }
    return !_containsZeroByte(s)
}

fn _validName(s: string, maxLen: i64) -> bool {
    return len(s) > 0 && len(s) <= maxLen && _asciiPrintable(s)
}

export fn validNodeName(name: string) -> bool {
    return _validName(name, NODE_NAME_MAX)
}

export fn validCoroutineName(name: string) -> bool {
    return _validName(name, CORO_NAME_MAX)
}

// ========== Address grammar ==========

fn _parsePort(raw: string) -> i64 {
    const b: Slice<u8> = raw.bytes()
    if (len(b) == 0) { return 0 }
    var out = 0
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 48 || c > 57) { return 0 }
        out = out * 10 + (c - 48)
        if (out > 65535) { return 0 }
    }
    return out
}

fn _stripIpv6Brackets(host: string) -> string {
    if (len(host) >= 2 && host.runes().nth(0) == '[' && host.runes().nth(len(host) - 1) == ']') {
        return host.slice(1, len(host) - 1)
    }
    return host
}

// One address grammar for the whole language. Before this file owned it there
// were three: the VM split on the last colon and never stripped brackets, the
// AOT half stripped brackets but handed the port text straight to
// getaddrinfo(3), which resolves service names -- so "db:http" refused on one
// backend and connected to port 80 on the other.
export fn parseAddress(addr: string) -> NodeAddress {
    var colon = addr.lastIndexOf(":")
    if (colon <= 0 || colon + 1 >= len(addr)) { throw AddressError.MissingPort { address: addr } }
    var rawHost = addr.slice(0, colon)
    var host = _stripIpv6Brackets(rawHost)
    if (!_fitsCString(host, ADDRESS_HOST_MAX_BYTES, false) ||
        (rawHost.indexOf(":") >= 0 && !rawHost.startsWith("["))) {
        throw AddressError.InvalidHost { host: rawHost }
    }
    var rawPort = addr.slice(colon + 1)
    var port = _parsePort(rawPort)
    if (port <= 0) { throw AddressError.InvalidPort { port: rawPort } }
    return NodeAddress(host, port)
}

// ========== Topic language ==========

fn _hasEmptyTopicSegment(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    if (len(b) == 0) { return true }
    if (b[0] == 0x2E || b[len(b) - 1] == 0x2E) { return true }
    for (var i = 1; i < len(b); i++) {
        if (b[i] == 0x2E && b[i - 1] == 0x2E) { return true }
    }
    return false
}

export fn validTopicName(topic: string) -> bool {
    if (len(topic) == 0 || len(topic) > TOPIC_PATTERN_MAX || !_asciiVisible(topic) ||
        _hasEmptyTopicSegment(topic)) { return false }
    return topic.indexOf("*") < 0 && topic.indexOf(">") < 0
}

export fn validTopicPattern(pattern: string) -> bool {
    if (len(pattern) == 0 || len(pattern) > TOPIC_PATTERN_MAX || !_asciiVisible(pattern) ||
        _hasEmptyTopicSegment(pattern)) { return false }
    var parts = pattern.split(".")
    for (var i = 0; i < len(parts); i++) {
        var part = parts[i]
        if (part == ">") { return i == len(parts) - 1 }
        if (part == "*") { continue }
        if (part.indexOf("*") >= 0 || part.indexOf(">") >= 0) { return false }
    }
    return true
}

export fn topicMatches(pattern: string, topic: string) -> bool {
    if (!validTopicPattern(pattern) || !validTopicName(topic)) { return false }

    var p = pattern.split(".")
    var t = topic.split(".")
    var pi = 0
    var ti = 0
    while (pi < len(p)) {
        var part = p[pi]
        if (part == ">") {
            return ti < len(t)
        }
        if (ti >= len(t)) { return false }
        if (part != "*" && part != t[ti]) { return false }
        pi = pi + 1
        ti = ti + 1
    }
    return ti == len(t)
}

fn _registerTopicSubscription(pattern: string, capacity: i64) -> Channel<Buffer>? {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return null }
    var notifications = Channel<Buffer>(capacity)

    _lockTopicState()
    if (_runtimeActiveToken.load() != token) {
        _topicStateLock.store(false)
        notifications.close()
        return null
    }
    var subscription: _TopicSubscription = {
        runtimeToken: token,
        pattern: pattern,
        notifications: notifications,
    }
    _topicSubscriptions.push(subscription)
    _topicStateLock.store(false)
    return notifications
}

// Pruning and target retention share one critical section. The returned array
// owns independent shared Channel references, so delivery can wake consumers
// without holding the source registry lock.
fn _topicTargets(topic: string, token: i64,
                 full: ref i64, stopped: ref i64) -> Array<Channel<Buffer>> {
    var retained: Array<_TopicSubscription> = []
    var targets: Array<Channel<Buffer>> = []
    _lockTopicState()
    for (var i = 0; i < len(_topicSubscriptions); i++) {
        var subscription = _topicSubscriptions[i]
        if (subscription.runtimeToken != token || subscription.notifications.isClosed) {
            if (subscription.runtimeToken == token &&
                topicMatches(subscription.pattern, topic)) {
                stopped = stopped + 1
            }
            subscription.notifications.close()
            continue
        }
        retained.push(subscription)
        if (!topicMatches(subscription.pattern, topic)) { continue }
        if (len(targets) >= TOPIC_DELIVERY_FANOUT_MAX) {
            full = full + 1
            continue
        }
        targets.push(subscription.notifications)
    }
    _topicSubscriptions = retained
    _topicStateLock.store(false)
    return targets
}

fn _bufferFromBytes(source: Array<u8>) -> Buffer {
    var out = mem.alloc(len(source))
    if (len(source) > 0) {
        unsafe {
            mem.withSliceMut<u8>(out.borrowPtr(), len(out), ref out,
                fn(target: ref Slice<u8>) {
                    var bytes: Slice<u8> = source[:]
                    target.copyFrom(bytes)
                })
        }
    }
    return out
}

fn _deliverTopic(topic: string, envelope: Array<u8>) -> __ClusterDeliveryStats? {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return null }
    var full = 0
    var stopped = 0
    var targets = _topicTargets(topic, token, ref full, ref stopped)
    if (_runtimeActiveToken.load() != token) { return null }

    var accepted = 0
    for (var i = 0; i < len(targets); i++) {
        var payload = _bufferFromBytes(envelope)
        match (targets[i].trySend(move payload)) {
            SendResult.Sent -> { accepted = accepted + 1 }
            SendResult.Closed -> { stopped = stopped + 1 }
            SendResult.Full -> { full = full + 1 }
            SendResult.Timeout -> { full = full + 1 }
        }
    }
    var stats: __ClusterDeliveryStats = {
        accepted: accepted,
        full: full,
        stopped: stopped,
        resource: 0,
    }
    return stats
}

fn _topicListenerCount() -> i64 {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return 0 }
    var retained: Array<_TopicSubscription> = []
    _lockTopicState()
    for (var i = 0; i < len(_topicSubscriptions); i++) {
        var subscription = _topicSubscriptions[i]
        if (subscription.runtimeToken == token && !subscription.notifications.isClosed) {
            retained.push(subscription)
        } else {
            subscription.notifications.close()
        }
    }
    _topicSubscriptions = retained
    var count = len(_topicSubscriptions)
    _topicStateLock.store(false)
    return count
}

// ========== Node identity and membership ==========

// Identity and immutable configuration remain in the module that validated
// them. The native runtime only snapshots mutable peer registries and counters.
export fn self() -> string {
    var state = _sourceStateSnapshot()
    return state == null ? "" : state!.selfName
}

// A node that has not joined a cluster has no membership to report, which is a
// different answer from an empty cluster and is reported as one.
export fn nodes() -> Array<string>? {
    if (_sourceStateSnapshot() == null) { return null }
    var raw = __runtimeSnapshot()
    if (raw == null) { return null }
    var names: Array<string> = []
    for (var i = 0; i < len(raw!.nodes); i++) { names.push(raw!.nodes[i].name) }
    return names
}

export fn discover() -> bool {
    var snapshot = info()
    if (snapshot == null || !snapshot!.running) { return false }
    var hash = _discoveryHashBits.load() as u64
    var value: ClusterDiscoveryAnnouncement = {
        name: snapshot!.self,
        port: snapshot!.port,
        clusterHash: hash,
    }
    var announcement = encodeDiscoveryAnnouncement(value)
    if (announcement == null) { return false }

    var token = _discoveryNextToken.fetchAdd(1) + 1
    var (_, acquired) = _discoveryActiveToken.compareExchange(0, token)
    if (!acquired) { return false }

    var socket = __discoveryOpen(DISCOVERY_MULTICAST_GROUP, DISCOVERY_MULTICAST_PORT,
                                 _DISCOVERY_MULTICAST_TTL, _DISCOVERY_LOOPBACK)
    if (socket == null) {
        _releaseDiscovery(token)
        return false
    }
    var notifications = monitor("*")
    if (notifications == null) {
        net.close(socket!)
        _releaseDiscovery(token)
        return false
    }

    var live: NetConn = socket!
    socket = null
    const sharedNotifications: Channel<string> = notifications!
    var wire: Array<u8> = announcement!
    announcement = null
    go _discoveryLoop(move live, sharedNotifications, snapshot!.self, hash, move wire, token)
    return true
}

export fn info() -> ClusterInfo? {
    var maybeState = _sourceStateSnapshot()
    if (maybeState == null) { return null }
    var raw = __runtimeSnapshot()
    if (raw == null) { return null }
    var state = maybeState!
    var snapshot = raw!
    var nodes: Array<ClusterNodeInfo> = []
    var observedAtMs = time.monotonic()
    for (var i = 0; i < len(snapshot.nodes); i++) {
        var node = snapshot.nodes[i]
        var publicNode: ClusterNodeInfo = {
            name: node.name,
            host: node.host,
            port: node.port,
            // Only connected peers are published in the native registry; idle,
            // handshake and closing states remain source-owned transition state.
            state: ClusterNodeState.Connected,
            framesSent: node.framesSent,
            framesReceived: node.framesReceived,
            bytesSent: node.bytesSent,
            bytesReceived: node.bytesReceived,
            sendErrors: node.sendErrors,
            slowConsumerEvents: node.slowConsumerEvents,
            rttMs: node.rttMs,
            outQueueBytes: node.outQueueBytes,
            outQueueFrames: node.outQueueFrames,
            slow: node.slow,
            phi: _phiValue(node.samples, node.mean, node.variance,
                           node.detectorLastHeartbeatMs, observedAtMs),
            missedHeartbeats: node.missedHeartbeats,
        }
        nodes.push(publicNode)
    }
    var tls: ClusterTlsStatus = {
        enabled: state.tlsEnabled,
        clientReady: state.tlsClientReady,
        serverReady: state.tlsServerReady,
    }
    var result: ClusterInfo = {
        self: state.selfName,
        port: state.port,
        running: true,
        nodes: nodes,
        listeners: _topicListenerCount(),
        deadNodes: snapshot.deadNodes,
        heartbeatIntervalMs: state.heartbeatIntervalMs,
        heartbeatTimeoutMs: state.heartbeatTimeoutMs,
        maxMissedHeartbeats: state.maxMissedHeartbeats,
        tls: tls,
    }
    return result
}

// The monitor channel carries the node or coroutine name that ended, and the
// termination reason for a remote coroutine; both are published as strings.
// The source wrapper owns target validation and dispatches to exact node and
// coroutine leaves, so the native boundary has no optional-argument policy.
export fn monitor(name: string, coroName: string? = null) -> Channel<string>? {
    if (coroName == null) {
        if (name != "*" && !validNodeName(name)) { return null }
        var notifications = Channel<string>(NODE_MONITOR_CAPACITY)
        if (!__registerNodeMonitor(name, notifications)) {
            notifications.close()
            return null
        }
        return notifications
    }
    if (!validNodeName(name) || !validCoroutineName(coroName!)) { return null }
    var notifications = Channel<string>(COROUTINE_MONITOR_CAPACITY)
    var request = encodeCoroMonitor(FRAME_CORO_MONITOR, coroName!)
    if (request == null) {
        notifications.close()
        return null
    }
    var peerGeneration = __registerCoroutineMonitor(name, coroName!, notifications)
    if (peerGeneration == 0) {
        notifications.close()
        return null
    }
    var admission = __peerEnqueue(peerGeneration, request!)
    if (admission != _PEER_QUEUE_ACCEPTED) {
        if (admission == _PEER_QUEUE_FULL ||
            admission == _PEER_QUEUE_RESOURCE_UNAVAILABLE ||
            admission == _PEER_QUEUE_INVALID) {
            _disconnectPeer(peerGeneration)
        }
        __unregisterCoroutineMonitor(name, coroName!, notifications)
        notifications.close()
        return null
    }
    return notifications
}

// ========== Lifecycle ==========

fn _clusterListener(port: i64) -> NetListener? {
    try {
        return net.listen(port, 128)
    } catch (e: NetError) {
        return null
    }
}

// A node whose name is not a legal node name cannot start. The listener and
// both long-lived loops are ordinary Xray values and coroutines; the runtime
// leaf only constructs TLS contexts and synchronized registries. The heartbeat
// schedule is passed down because the locked health projection needs the same
// thresholds, while its cadence remains entirely source-owned.
export fn start(config: ClusterConfig) -> bool {
    if (_sourceStateSnapshot() != null) { return false }
    if (!validNodeName(config.name)) { return false }
    if (config.port < 0 || config.port > 65535) { return false }
    var interval = config.heartbeatIntervalMs ?? HEARTBEAT_INTERVAL_MS
    var timeout = config.heartbeatTimeoutMs ?? HEARTBEAT_TIMEOUT_MS
    var missed = config.maxMissedHeartbeats ?? MAX_MISSED_HEARTBEATS
    // A schedule that cannot detect anything is a configuration mistake, not a
    // tuning choice: a detector needs at least one interval to elapse before it
    // may call a peer late, and at least one missed beat before it kills it.
    if (interval <= 0 || timeout < interval || missed <= 0) { return false }
    var tick = heartbeatTickInterval(interval)
    var secret = config.secret ?? ""
    if (!_fitsCString(secret, SHARED_SECRET_MAX_BYTES, true)) { return false }
    var tlsEnabled = false
    var caFile = ""
    var certFile = ""
    var keyFile = ""
    var insecure = false
    if (config.tls != null) {
        var tls = config.tls!
        tlsEnabled = tls.enabled
        caFile = tls.caFile ?? ""
        certFile = tls.certFile ?? ""
        keyFile = tls.keyFile ?? ""
        insecure = tls.insecure
        if (_containsZeroByte(caFile) || _containsZeroByte(certFile) ||
            _containsZeroByte(keyFile)) {
            return false
        }
        if ((len(certFile) == 0) != (len(keyFile) == 0)) { return false }
    }

    var listener = _clusterListener(config.port)
    if (listener == null) { return false }
    var port = net.port(listener!)
    if (port < 0 || port > 65535) {
        net.close(listener!)
        return false
    }
    var started = __start(
        config.name,
        port,
        secret,
        tlsEnabled,
        caFile,
        certFile,
        keyFile,
        insecure,
        OUTPUT_QUEUE_HIGH_WATERMARK_BYTES,
        TOMBSTONE_RETENTION_MS
    )
    var state: _ClusterSourceState = {
        selfName: config.name,
        port: port,
        secret: secret,
        heartbeatIntervalMs: interval,
        heartbeatTimeoutMs: timeout,
        maxMissedHeartbeats: missed,
        tlsEnabled: tlsEnabled,
        tlsClientReady: tlsEnabled,
        tlsServerReady: tlsEnabled && len(certFile) > 0,
    }
    return _activateClusterSource(started, state, tick, move listener)
}

// The address is parsed here and the leaf is handed a host and a port, so the
// grammar has one owner. A malformed address raises AddressError rather than
// answering false: "you spelled the address wrong" and "the peer did not
// answer" are different facts, and both backends used to flatten them into the
// same false.
export fn join(addr: string) -> bool {
    var parsed = parseAddress(addr)
    return _joinPeer(parsed.host, parsed.port)
}

export fn stop() {
    _discoveryActiveToken.store(0)
    _retireCurrentRuntimeGeneration()
    _closeTopicSubscriptions()
    _clearSourceState()
    __stop()
}

// ========== Publish and subscribe ==========

// A pattern that is not a legal topic pattern, or a capacity outside what a
// bounded channel can hold, has no subscription to create. Both were checked
// three times before -- twice in the VM path, once in the AOT one -- and are
// checked once here.
export fn listen(pattern: string, capacity: i64 = 1024) -> Channel<Buffer>? {
    if (!validTopicPattern(pattern)) { return null }
    if (capacity <= 0 || capacity > SUBSCRIPTION_CAPACITY_MAX) { return null }
    return _registerTopicSubscription(pattern, capacity)
}

// Queue and channel providers report only why each admission succeeded or
// failed. This source policy is shared by local and remote publication.
fn _deliveryFromStats(stats: __ClusterDeliveryStats?) -> ClusterDelivery {
    if (stats == null) { return ClusterDelivery.Unavailable }
    var observed = stats!
    if (observed.accepted > 0) { return ClusterDelivery.Accepted }
    if (observed.full > 0) { return ClusterDelivery.Overloaded }
    if (observed.resource > 0) { return ClusterDelivery.Unavailable }
    if (observed.stopped > 0) { return ClusterDelivery.Disconnected }
    return ClusterDelivery.Disconnected
}

// One publication has two independent destinations. Success wins because at
// least one subscriber accepted the envelope; overload wins over a completely
// disconnected route, and caller errors remain errors even if another route
// could not observe them.
fn _combinePublicationDelivery(local: ClusterDelivery,
                               remote: ClusterDelivery) -> ClusterDelivery {
    if (local == ClusterDelivery.InvalidTopic || remote == ClusterDelivery.InvalidTopic) {
        return ClusterDelivery.InvalidTopic
    }
    if (local == ClusterDelivery.InvalidEnvelope || remote == ClusterDelivery.InvalidEnvelope) {
        return ClusterDelivery.InvalidEnvelope
    }
    if (local == ClusterDelivery.Accepted || remote == ClusterDelivery.Accepted) {
        return ClusterDelivery.Accepted
    }
    if (local == ClusterDelivery.Overloaded || remote == ClusterDelivery.Overloaded) {
        return ClusterDelivery.Overloaded
    }
    if (local == ClusterDelivery.Unavailable || remote == ClusterDelivery.Unavailable) {
        return ClusterDelivery.Unavailable
    }
    return ClusterDelivery.Disconnected
}

export fn send(topic: string, envelope: move Buffer,
               hopLimit: i64 = TOPIC_DEFAULT_HOP_LIMIT) -> ClusterDelivery {
    if (!validTopicName(topic)) { return ClusterDelivery.InvalidTopic }
    if (hopLimit < 0 || hopLimit > TOPIC_MAX_HOP_LIMIT) { return ClusterDelivery.InvalidTopic }
    var envelopeBytes = _materializeBuffer(envelope)
    if (len(envelopeBytes) < ENVELOPE_HEADER_SIZE) {
        return ClusterDelivery.InvalidEnvelope
    }
    var remoteWire = encodeTransportFrame(hopLimit, topic, envelopeBytes)
    var local = _deliveryFromStats(_deliverTopic(topic, envelopeBytes))
    var remote = remoteWire == null ? ClusterDelivery.InvalidEnvelope
                                    : _deliveryFromStats(__broadcast(0, remoteWire!))
    return _combinePublicationDelivery(local, remote)
}
