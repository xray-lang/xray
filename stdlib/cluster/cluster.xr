// cluster - the cluster control plane, stated in Xray.
//
// WHY THIS FILE EXISTS
//   Cluster policy once crossed source and native implementations, which let
//   the two backends answer the same question differently. Both backends now
//   compile this file, so protocol, queue and lifecycle policy has exactly one
//   owner. Host resources enter only through generic net and crypto APIs.
//
// WHAT LIVES HERE
//   The address grammar, the topic language, the node-name rule, the admission
//   checks the four entry points apply, peer membership, framed transport,
//   queue admission and fairness, the handshake version, the hop limit and the
//   heartbeat schedule.
//
// WHAT DOES NOT
//   Sockets, multicast, TLS, the netpoll, OS threads and the channel subsystem.
//   Their generic resource providers own host mechanics; all protocol bytes,
//   authentication rules, failure-detector math and discovery admission policy
//   live below in Xray.
//
// WIRE FORMAT
//   Normative. Source code reads the four-byte frame boundary through the
//   generic net API, owns its bounds and queues complete wire frames. Native
//   code does not carry a cluster encoder, decoder, framing or dispatch path.
//   Byte-exact protocol tests pin this source implementation to known answers.
//
//     frame     := u32be(1 + len(payload)) u8(type) payload
//     transport := u8(hopLimit) u8(len(topic)) topic envelope
//     hsReq     := u8(version) u8(len(name)) name nonce[16] u32be(flags)
//     hsAck     := u8(version) u8(len(name)) name nonce[16] proof[32] u32be(flags)
//     hsDone    := proof[32]
//     heartbeat := i64be(timestampMs)
//     coroMon   := u8(len(name)) name
//     coroExit  := u8(len(name)) name u8(len(reason)) reason
//
//   Every length is one byte, so a node name is at most NODE_NAME_MAX and a
//   topic at most TOPIC_PATTERN_MAX. Both are checked here before generic
//   transport I/O. proof is
//   HMAC-SHA256(secret, nonce): the primitive is a crypto leaf, the
//   construction is the line above.

import crypto
import math
import mem
import net
import {
    DialOptions,
    Endpoint,
    NetConn,
    NetError,
    NetListener,
    TlsClientContext,
    TlsServerContext,
    UdpFrom
} from net
import time

// ========== Protocol constants ==========

// The handshake version both peers must agree on. Bumping it is a wire break:
// there is no version negotiation and none is wanted.
export const HANDSHAKE_VERSION = 6
export const HANDSHAKE_TIMEOUT_MS = 5000

// How many further hops a published envelope may take. Each hop decrements;
// the frame dies when the count reaches zero.
export const TOPIC_DEFAULT_HOP_LIMIT = 3
export const TOPIC_MAX_HOP_LIMIT = 255

export const NODE_NAME_MAX = 63
export const TOPIC_PATTERN_MAX = 127
export const CORO_NAME_MAX = 127

// These are byte limits at the transport boundary, not Unicode-scalar limits.
// Keeping them here makes rejection part of the language API instead of
// letting one backend truncate while another rejects.
export const ADDRESS_HOST_MAX_BYTES = 255
export const SHARED_SECRET_MAX_BYTES = 63

// Frame layout. FRAME_HEADER_SIZE is the big-endian length prefix; the type
// octet follows it and is counted inside the prefixed length.
export const FRAME_HEADER_SIZE = 4
export const FRAME_MAX_PAYLOAD = 16777216
export const NONCE_SIZE = 16
export const PROOF_SIZE = 32

// One byte each, matching the type octet on the wire.
export const FRAME_HANDSHAKE_REQ = 0x01
export const FRAME_HANDSHAKE_ACK = 0x02
export const FRAME_HANDSHAKE_DONE = 0x03
export const FRAME_HANDSHAKE_ERR = 0x04
export const FRAME_HEARTBEAT_PING = 0x05
export const FRAME_HEARTBEAT_PONG = 0x06
export const FRAME_TRANSPORT_ENVELOPE = 0x07
export const FRAME_CORO_MONITOR = 0x08
export const FRAME_CORO_EXIT = 0x0A

// An envelope is opaque to the transport, but it is not shapeless: the service
// layer above puts a fixed 64-byte header on every one, and a frame shorter
// than that cannot be a well-formed envelope.
export const ENVELOPE_HEADER_SIZE = 64

// A subscription channel is bounded. Zero would drop every message and the
// upper bound is what the channel subsystem will allocate.
export const SUBSCRIPTION_CAPACITY_MAX = 1048576
export const TOPIC_DELIVERY_FANOUT_MAX = 256
export const OUTPUT_QUEUE_HIGH_WATERMARK_BYTES = 4194304
const _PEER_QUEUE_ACCEPTED = 0
const _PEER_QUEUE_FULL = 1
const _PEER_QUEUE_STOPPED = 2
const _PEER_QUEUE_INVALID = 3
const _PEER_QUEUE_EMPTY = 4
export const NODE_MONITOR_CAPACITY = 8
export const COROUTINE_MONITOR_CAPACITY = 1

// The heartbeat schedule is source-owned and has no native policy copy.
export const HEARTBEAT_INTERVAL_MS = 5000
export const HEARTBEAT_TIMEOUT_MS = 15000
export const MAX_MISSED_HEARTBEATS = 3
export const HEARTBEAT_TICK_MIN_MS = 500
export const TOMBSTONE_RETENTION_MS = 60000

// The phi detector has one policy threshold and one bounded observation
// window. Neither value is a transport concern.
export const PHI_THRESHOLD = 8.0
export const PHI_WINDOW_SIZE = 100
export const PHI_MIN_SAMPLES = 3

// LAN discovery only announces candidates. Authentication still happens on
// the TCP connection, so the datagram contains a non-secret cluster selector.
export const DISCOVERY_MAGIC = 0x58524459
export const DISCOVERY_VERSION = 2
export const DISCOVERY_MULTICAST_GROUP = "239.42.42.42"
export const DISCOVERY_MULTICAST_PORT = 47200
export const DISCOVERY_INTERVAL_MS = 3000
const _DISCOVERY_MULTICAST_TTL = 1
const _DISCOVERY_LOOPBACK = false
const _DISCOVERY_ANNOUNCEMENT_MAX_SIZE = 128
const _CLUSTER_PROTOCOL_FLAGS = 0x01
const _HANDSHAKE_FRAME_BODY_MAX = 513
const _ACCEPT_POLL_MS = 500
const _REMOTE_MONITOR_POLL_MS = 500

type _ClusterSourceState = {
    runtimeToken: i64,
    selfName: string,
    port: i64,
    secret: string,
    heartbeatIntervalMs: i64,
    heartbeatTimeoutMs: i64,
    maxMissedHeartbeats: i64,
    tlsEnabled: bool,
}

type _SourceListener = {
    runtimeToken: i64,
    listener: NetListener,
}

type _DiscoveryGeneration = {
    runtimeToken: i64,
    discoveryToken: i64,
    socket: NetConn?,
}

type _ClusterTlsResources = {
    runtimeToken: i64,
    client: TlsClientContext,
    server: TlsServerContext,
}

// Topic routing is ordinary source state. Holding the Channel in this record
// gives the registry its own strong reference, while temporary delivery
// snapshots keep each target alive after the registry lock is released.
type _TopicSubscription = {
    runtimeToken: i64,
    pattern: string,
    notifications: Channel<Buffer>,
}

type _NodeMonitor = {
    target: string,
    notifications: Channel<string>,
}

type _RemoteMonitor = {
    id: i64,
    peerGeneration: i64,
    coroutineName: string,
    notifications: Channel<string>,
}

type _RemoteMonitorRegistration = {
    id: i64,
    peerGeneration: i64,
}

type _NodeDownMonitors = {
    nodeOneShot: Array<Channel<string>>,
    nodeStreams: Array<Channel<string>>,
    remote: Array<Channel<string>>,
}

type _PhiPeerState = {
    runtimeToken: i64,
    peerGeneration: i64,
    adoptedAtMs: i64,
    missedHeartbeats: i64,
    detector: PhiDetector,
}

type _PhiPeerSnapshot = {
    recorded: bool,
    adoptedAtMs: i64,
    missedHeartbeats: i64,
    samples: i64,
    mean: f64,
    variance: f64,
    lastHeartbeatMs: i64,
}

const _PEER_RESERVED = 0
const _PEER_COMMITTED = 1
const _PEER_DEPARTING = 2

// Peer identity and authenticated admission are independent from transport
// resources, so directory transitions remain stable while an endpoint drains.
type _PeerDirectoryEntry = {
    runtimeToken: i64,
    generation: i64,
    name: string,
    endpoint: Endpoint?,
    flags: i64,
    state: i64,
}

type _PeerReservation = {
    runtimeToken: i64,
    generation: i64,
}

// A peer endpoint is immutable after authentication. Both transport
// directions share the same NetConn exactly as net.copyBidirectional does;
// shutdown wakes both directions and the coordinator performs the sole close
// after its structured children finish.
final class _PeerEndpoint {
    runtimeToken: i64
    generation: i64
    conn: NetConn
    ready: Channel<i64>
    wake: Channel<i64>

    constructor(runtimeToken: i64, generation: i64,
                conn: NetConn, ready: Channel<i64>, wake: Channel<i64>) {
        this.runtimeToken = runtimeToken
        this.generation = generation
        this.conn = conn
        this.ready = ready
        this.wake = wake
    }
}

// Raw transport state is orthogonal to the source-owned peer directory and
// failure detector. Every field is protected by _peerTransportLock, and no
// operation suspends while that lock is held.
type _PeerTransportState = {
    endpoint: const _PeerEndpoint,
    committed: bool,
    outbound: Array<Array<u8>>,
    queuedBytes: i64,
    full: bool,
    lastReceivedAtMs: i64,
    framesSent: i64,
    framesReceived: i64,
    bytesSent: i64,
    bytesReceived: i64,
    sendErrors: i64,
    slowConsumerEvents: i64,
    rttMs: i64,
}

type _PeerTransportHealthSnapshot = {
    peerGeneration: i64,
    lastReceivedAtMs: i64,
}

type _PeerTransportSnapshot = {
    peerGeneration: i64,
    framesSent: i64,
    framesReceived: i64,
    bytesSent: i64,
    bytesReceived: i64,
    sendErrors: i64,
    slowConsumerEvents: i64,
    rttMs: i64,
    outQueueBytes: i64,
    outQueueFrames: i64,
    slow: bool,
    lastReceivedAtMs: i64,
}

type _DeliveryStats = {
    accepted: i64,
    full: i64,
    stopped: i64,
}

type _PeerTake = {
    status: i64,
    wire: Array<u8>?,
}

// Source-owned loops use generation tokens so a retiring coroutine cannot
// affect a later start on the same isolate. Discovery has a separate token
// because callers may enable or restart it independently of cluster startup.
const _discoveryNextToken: Atomic<i64> = Atomic<i64>(0)
const _runtimeNextToken: Atomic<i64> = Atomic<i64>(0)
const _runtimeActiveToken: Atomic<i64> = Atomic<i64>(0)
const _peerNextGeneration: Atomic<i64> = Atomic<i64>(0)
const _monitorNextId: Atomic<i64> = Atomic<i64>(0)
// Serializes source generation retirement with non-suspending node-down
// publication. This closes the check/publish window while keeping generation
// and notification policy in source.
const _runtimeDecisionLock: Atomic<bool> = Atomic<bool>(false)
const _discoveryStateLock: Atomic<bool> = Atomic<bool>(false)
var _discoveryGeneration: _DiscoveryGeneration? = null
const _topicStateLock: Atomic<bool> = Atomic<bool>(false)
var _topicSubscriptions: Array<_TopicSubscription> = []
const _phiStateLock: Atomic<bool> = Atomic<bool>(false)
var _phiPeerStates: Array<_PhiPeerState> = []
const _peerDirectoryLock: Atomic<bool> = Atomic<bool>(false)
var _peerDirectory: Array<_PeerDirectoryEntry> = []
const _peerTransportLock: Atomic<bool> = Atomic<bool>(false)
var _peerTransports: Array<_PeerTransportState> = []
// The protected section only copies or swaps one small record and never
// suspends, so a lock-free flag preserves the synchronous public query surface
// without exposing ordinary mutable module state across worker coroutines.
const _sourceStateLock: Atomic<bool> = Atomic<bool>(false)
var _sourceState: _ClusterSourceState? = null
var _sourceListener: _SourceListener? = null
var _sourceTlsResources: _ClusterTlsResources? = null
const _monitorStateLock: Atomic<bool> = Atomic<bool>(false)
var _monitorRuntimeToken = 0
var _nodeMonitors: Array<_NodeMonitor> = []
var _remoteMonitors: Array<_RemoteMonitor> = []
var _recentDepartures: Array<_RecentDeparture> = []

fn _lockSourceState() {
    while (true) {
        var (_, acquired) = _sourceStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockRuntimeDecision() {
    while (true) {
        var (_, acquired) = _runtimeDecisionLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockDiscoveryState() {
    while (true) {
        var (_, acquired) = _discoveryStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockTopicState() {
    while (true) {
        var (_, acquired) = _topicStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockMonitorState() {
    while (true) {
        var (_, acquired) = _monitorStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockPhiState() {
    while (true) {
        var (_, acquired) = _phiStateLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockPeerDirectory() {
    while (true) {
        var (_, acquired) = _peerDirectoryLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _lockPeerTransport() {
    while (true) {
        var (_, acquired) = _peerTransportLock.compareExchange(false, true)
        if (acquired) { return }
    }
}

fn _clearPeerDirectoryLocked() {
    _lockPeerDirectory()
    _peerDirectory = []
    _peerDirectoryLock.store(false)
}

fn _peerNameConflict(name: string) -> bool {
    _lockPeerDirectory()
    var found = false
    for (var i = 0; i < len(_peerDirectory); i++) {
        if (_peerDirectory[i].name == name) { found = true }
    }
    _peerDirectoryLock.store(false)
    return found
}

fn _reservePeer(runtimeToken: i64, name: string, endpoint: Endpoint?,
                flags: i64) -> _PeerReservation? {
    var reservation: _PeerReservation? = null
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() == runtimeToken && !_recentlyDeparted(name)) {
        var generation = _peerNextGeneration.fetchAdd(1) + 1
        if (generation > 0) {
            _lockPeerDirectory()
            var conflict = false
            for (var i = 0; i < len(_peerDirectory); i++) {
                if (_peerDirectory[i].name == name ||
                    _peerDirectory[i].generation == generation) {
                    conflict = true
                }
            }
            if (!conflict) {
                _peerDirectory.push({
                    runtimeToken: runtimeToken,
                    generation: generation,
                    name: name,
                    endpoint: endpoint,
                    flags: flags,
                    state: _PEER_RESERVED,
                })
                reservation = { runtimeToken: runtimeToken, generation: generation }
            }
            _peerDirectoryLock.store(false)
        }
    }
    _runtimeDecisionLock.store(false)
    return reservation
}

// Directory visibility and transport admission are one transition. The ready
// channel remains closed until both registries agree, so no observer can see a
// directory-only ghost and no reader can dispatch a pre-admission frame.
fn _commitPeer(reservation: _PeerReservation) -> bool {
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() != reservation.runtimeToken) {
        _runtimeDecisionLock.store(false)
        return false
    }
    _lockPeerDirectory()
    var committed = false
    var directoryIndex = -1
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.runtimeToken == reservation.runtimeToken &&
            entry.generation == reservation.generation && entry.state == _PEER_RESERVED) {
            directoryIndex = i
        }
    }
    if (directoryIndex >= 0) {
        _lockPeerTransport()
        var transportIndex = -1
        for (var i = 0; i < len(_peerTransports); i++) {
            var peer = _peerTransports[i]
            if (peer.endpoint.runtimeToken == reservation.runtimeToken &&
                peer.endpoint.generation == reservation.generation && !peer.committed) {
                transportIndex = i
            }
        }
        if (transportIndex >= 0) {
            var transport = _peerTransports[transportIndex]
            transport.committed = true
            _peerTransports[transportIndex] = transport
            var directory = _peerDirectory[directoryIndex]
            directory.state = _PEER_COMMITTED
            _peerDirectory[directoryIndex] = directory
            committed = true
        }
        _peerTransportLock.store(false)
    }
    _peerDirectoryLock.store(false)
    _runtimeDecisionLock.store(false)
    return committed
}

fn _removePeerDirectoryEntry(runtimeToken: i64, generation: i64) {
    _lockPeerDirectory()
    var retained: Array<_PeerDirectoryEntry> = []
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.runtimeToken != runtimeToken || entry.generation != generation) {
            retained.push(entry)
        }
    }
    _peerDirectory = retained
    _peerDirectoryLock.store(false)
}

fn _beginPeerDeparture(runtimeToken: i64,
                       generation: i64) -> _PeerDirectoryEntry? {
    _lockPeerDirectory()
    var departing: _PeerDirectoryEntry? = null
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.runtimeToken == runtimeToken && entry.generation == generation &&
            entry.state != _PEER_DEPARTING) {
            departing = entry
            entry.state = _PEER_DEPARTING
            _peerDirectory[i] = entry
        }
    }
    _peerDirectoryLock.store(false)
    return departing
}

fn _peerDirectorySnapshot(runtimeToken: i64) -> Array<_PeerDirectoryEntry> {
    _lockPeerDirectory()
    var peers: Array<_PeerDirectoryEntry> = []
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.runtimeToken == runtimeToken && entry.state == _PEER_COMMITTED) {
            peers.push(entry)
        }
    }
    _peerDirectoryLock.store(false)
    return peers
}

fn _peerName(generation: i64) -> string? {
    _lockPeerDirectory()
    var name: string? = null
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.generation == generation && entry.state == _PEER_COMMITTED) {
            name = entry.name
        }
    }
    _peerDirectoryLock.store(false)
    return name
}

fn _peerGeneration(name: string) -> i64 {
    _lockPeerDirectory()
    var generation = 0
    for (var i = 0; i < len(_peerDirectory); i++) {
        var entry = _peerDirectory[i]
        if (entry.name == name && entry.state == _PEER_COMMITTED) {
            generation = entry.generation
        }
    }
    _peerDirectoryLock.store(false)
    return generation
}
// Retirement first makes new registrations fail their locked token recheck.
// Detaching only the retired generation keeps a concurrent restart intact;
// closing the detached channels afterwards keeps wakeups out of the spinlock.
fn _closeTopicSubscriptions(runtimeToken: i64) {
    _lockTopicState()
    var retired: Array<_TopicSubscription> = []
    var retained: Array<_TopicSubscription> = []
    for (var i = 0; i < len(_topicSubscriptions); i++) {
        var subscription = _topicSubscriptions[i]
        if (subscription.runtimeToken == runtimeToken) { retired.push(subscription) }
        else { retained.push(subscription) }
    }
    _topicSubscriptions = retained
    _topicStateLock.store(false)
    for (var i = 0; i < len(retired); i++) {
        retired[i].notifications.close()
    }
}

fn _clearPhiPeerStates(runtimeToken: i64) {
    var retained: Array<_PhiPeerState> = []
    _lockPhiState()
    for (var i = 0; i < len(_phiPeerStates); i++) {
        var state = _phiPeerStates[i]
        if (state.runtimeToken != runtimeToken) { retained.push(state) }
    }
    _phiPeerStates = retained
    _phiStateLock.store(false)
}

fn _closeChannels(channels: Array<Channel<string>>) {
    for (var i = 0; i < len(channels); i++) { channels[i].close() }
}

fn _clearMonitorStateLocked(token: i64) {
    _lockMonitorState()
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return
    }
    var channels: Array<Channel<string>> = []
    for (var i = 0; i < len(_nodeMonitors); i++) {
        channels.push(_nodeMonitors[i].notifications)
    }
    for (var i = 0; i < len(_remoteMonitors); i++) {
        channels.push(_remoteMonitors[i].notifications)
    }
    _nodeMonitors = []
    _remoteMonitors = []
    _recentDepartures = []
    _monitorRuntimeToken = 0
    _monitorStateLock.store(false)
    _closeChannels(channels)
}

fn _activateRuntimeGeneration(token: i64) -> bool {
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() != 0) {
        _runtimeDecisionLock.store(false)
        return false
    }
    _lockPeerDirectory()
    if (len(_peerDirectory) != 0) {
        _peerDirectoryLock.store(false)
        _runtimeDecisionLock.store(false)
        return false
    }
    _peerDirectoryLock.store(false)
    _lockMonitorState()
    if (_monitorRuntimeToken != 0 || len(_nodeMonitors) != 0 || len(_remoteMonitors) != 0 ||
        len(_recentDepartures) != 0) {
        _monitorStateLock.store(false)
        _runtimeDecisionLock.store(false)
        return false
    }
    _monitorRuntimeToken = token
    _monitorStateLock.store(false)
    _runtimeActiveToken.store(token)
    _runtimeDecisionLock.store(false)
    return true
}

fn _retireRuntimeGeneration(token: i64) -> bool {
    _lockRuntimeDecision()
    if (_runtimeActiveToken.load() != token) {
        _runtimeDecisionLock.store(false)
        return false
    }
    _runtimeActiveToken.store(0)
    _clearMonitorStateLocked(token)
    _clearPeerDirectoryLocked()
    _runtimeDecisionLock.store(false)
    return true
}

fn _retireCurrentRuntimeGeneration() -> i64 {
    _lockRuntimeDecision()
    var token = _runtimeActiveToken.load()
    _runtimeActiveToken.store(0)
    if (token != 0) { _clearMonitorStateLocked(token) }
    _clearPeerDirectoryLocked()
    _runtimeDecisionLock.store(false)
    return token
}

fn _pruneRecentDeparturesLocked(nowMs: i64) {
    var retained: Array<_RecentDeparture> = []
    for (var i = 0; i < len(_recentDepartures); i++) {
        var entry = _recentDepartures[i]
        if (tombstoneIsLive(entry.markedAtMs, nowMs)) { retained.push(entry) }
    }
    _recentDepartures = retained
}

fn _recordRecentDepartureLocked(name: string, markedAtMs: i64) {
    _pruneRecentDeparturesLocked(markedAtMs)
    var retained: Array<_RecentDeparture> = []
    for (var i = 0; i < len(_recentDepartures); i++) {
        var entry = _recentDepartures[i]
        if (entry.name != name) { retained.push(entry) }
    }
    retained.push({ name: name, markedAtMs: markedAtMs })
    _recentDepartures = retained
}

fn _recentlyDeparted(name: string) -> bool {
    _lockMonitorState()
    if (_monitorRuntimeToken == 0) {
        _monitorStateLock.store(false)
        return true
    }
    _pruneRecentDeparturesLocked(time.monotonic())
    var found = false
    for (var i = 0; i < len(_recentDepartures); i++) {
        if (_recentDepartures[i].name == name) { found = true }
    }
    _monitorStateLock.store(false)
    return found
}

fn _recentDepartureSnapshot(runtimeToken: i64, nowMs: i64) -> Array<string>? {
    _lockMonitorState()
    if (_monitorRuntimeToken != runtimeToken ||
        _runtimeActiveToken.load() != runtimeToken) {
        _monitorStateLock.store(false)
        return null
    }
    _pruneRecentDeparturesLocked(nowMs)
    var names: Array<string> = []
    for (var i = 0; i < len(_recentDepartures); i++) {
        names.push(_recentDepartures[i].name)
    }
    _monitorStateLock.store(false)
    return names
}

fn _recentDepartureCount(runtimeToken: i64, nowMs: i64) -> i64 {
    _lockMonitorState()
    if (_monitorRuntimeToken != runtimeToken ||
        _runtimeActiveToken.load() != runtimeToken) {
        _monitorStateLock.store(false)
        return -1
    }
    _pruneRecentDeparturesLocked(nowMs)
    var count = len(_recentDepartures)
    _monitorStateLock.store(false)
    return count
}

fn _takeNodeDownMonitors(token: i64, peerGeneration: i64,
                         name: string, markedAtMs: i64) -> _NodeDownMonitors? {
    _lockMonitorState()
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return null
    }
    _recordRecentDepartureLocked(name, markedAtMs)
    var nodeOneShot: Array<Channel<string>> = []
    var nodeStreams: Array<Channel<string>> = []
    var retainedNode: Array<_NodeMonitor> = []
    for (var i = 0; i < len(_nodeMonitors); i++) {
        var entry = _nodeMonitors[i]
        if (entry.target == "*") {
            nodeStreams.push(entry.notifications)
            retainedNode.push(entry)
        } else if (entry.target == name) {
            nodeOneShot.push(entry.notifications)
        } else {
            retainedNode.push(entry)
        }
    }
    var remote: Array<Channel<string>> = []
    var retainedRemote: Array<_RemoteMonitor> = []
    for (var i = 0; i < len(_remoteMonitors); i++) {
        var entry = _remoteMonitors[i]
        if (entry.peerGeneration == peerGeneration) {
            remote.push(entry.notifications)
        } else {
            retainedRemote.push(entry)
        }
    }
    _nodeMonitors = retainedNode
    _remoteMonitors = retainedRemote
    _monitorStateLock.store(false)
    return { nodeOneShot: nodeOneShot, nodeStreams: nodeStreams, remote: remote }
}

fn _publishOneShot(channels: Array<Channel<string>>, result: string) {
    for (var i = 0; i < len(channels); i++) {
        channels[i].trySend(result)
        channels[i].close()
    }
}

fn _notifyNodeDownIfCurrent(token: i64, peerGeneration: i64,
                            name: string, markedAtMs: i64) {
    _lockRuntimeDecision()
    var targets = _runtimeActiveToken.load() == token
        ? _takeNodeDownMonitors(token, peerGeneration, name, markedAtMs)
        : null
    _runtimeDecisionLock.store(false)
    if (targets == null) { return }
    for (var i = 0; i < len(targets!.nodeStreams); i++) {
        targets!.nodeStreams[i].trySend(name)
    }
    _publishOneShot(targets!.nodeOneShot, name)
    _publishOneShot(targets!.remote, "nodedown")
}

fn _registerNodeMonitor(token: i64, target: string,
                        notifications: Channel<string>) -> bool {
    _lockMonitorState()
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return false
    }
    _nodeMonitors.push({ target: target, notifications: notifications })
    _monitorStateLock.store(false)
    return true
}

fn _registerRemoteMonitor(token: i64, nodeName: string, coroutineName: string,
                          notifications: Channel<string>) -> _RemoteMonitorRegistration? {
    var peerGeneration = _peerGeneration(nodeName)
    if (peerGeneration == 0) { return null }
    var id = _monitorNextId.fetchAdd(1) + 1
    if (id <= 0) { return null }
    _lockMonitorState()
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return null
    }
    _remoteMonitors.push({
        id: id,
        peerGeneration: peerGeneration,
        coroutineName: coroutineName,
        notifications: notifications,
    })
    _monitorStateLock.store(false)
    var current = _peerName(peerGeneration)
    if (current == null || current! != nodeName) {
        _unregisterRemoteMonitor(token, id)
        return null
    }
    return { id: id, peerGeneration: peerGeneration }
}

fn _unregisterRemoteMonitor(token: i64, id: i64) -> bool {
    _lockMonitorState()
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return false
    }
    var removed = false
    var retained: Array<_RemoteMonitor> = []
    for (var i = 0; i < len(_remoteMonitors); i++) {
        var entry = _remoteMonitors[i]
        if (!removed && entry.id == id) {
            removed = true
        } else {
            retained.push(entry)
        }
    }
    _remoteMonitors = retained
    _monitorStateLock.store(false)
    return removed
}

fn _takeRemoteExitMonitors(token: i64, peerGeneration: i64,
                           coroutineName: string) -> Array<Channel<string>> {
    _lockMonitorState()
    var matched: Array<Channel<string>> = []
    if (_monitorRuntimeToken != token) {
        _monitorStateLock.store(false)
        return matched
    }
    var retained: Array<_RemoteMonitor> = []
    for (var i = 0; i < len(_remoteMonitors); i++) {
        var entry = _remoteMonitors[i]
        if (entry.peerGeneration == peerGeneration && entry.coroutineName == coroutineName) {
            matched.push(entry.notifications)
        } else {
            retained.push(entry)
        }
    }
    _remoteMonitors = retained
    _monitorStateLock.store(false)
    return matched
}

fn _notifyRemoteExit(peerGeneration: i64, coroutineName: string, reason: string) {
    var token = _runtimeActiveToken.load()
    if (token == 0 || _peerName(peerGeneration) == null) { return }
    var matched = _takeRemoteExitMonitors(token, peerGeneration, coroutineName)
    _publishOneShot(matched, reason)
}

fn _peerIdentityCurrent(peerGeneration: i64, expectedName: string) -> bool {
    var current = _peerName(peerGeneration)
    return current != null && current! == expectedName
}

fn _sourceStateSnapshot(runtimeToken: i64) -> _ClusterSourceState? {
    _lockSourceState()
    var state: _ClusterSourceState? = null
    if (_runtimeActiveToken.load() == runtimeToken && _sourceState != null &&
        _sourceState!.runtimeToken == runtimeToken) {
        state = copy(_sourceState)
    }
    _sourceStateLock.store(false)
    return state
}

fn _currentSourceStateSnapshot() -> _ClusterSourceState? {
    var runtimeToken = _runtimeActiveToken.load()
    var state: _ClusterSourceState? = null
    if (runtimeToken != 0) { state = _sourceStateSnapshot(runtimeToken) }
    return state
}

fn _installSourceState(state: _ClusterSourceState, tls: _ClusterTlsResources?) -> bool {
    _lockSourceState()
    var tlsMatches = tls == null || tls!.runtimeToken == state.runtimeToken
    if (_sourceState != null || _sourceTlsResources != null || !tlsMatches ||
        _runtimeActiveToken.load() != state.runtimeToken) {
        _sourceStateLock.store(false)
        return false
    }
    _sourceState = state
    _sourceTlsResources = tls
    _sourceStateLock.store(false)
    return true
}

fn _clearSourceState(runtimeToken: i64) {
    _lockSourceState()
    if (_sourceState != null && _sourceState!.runtimeToken == runtimeToken) {
        _sourceState = null
    }
    if (_sourceTlsResources != null &&
        _sourceTlsResources!.runtimeToken == runtimeToken) {
        _sourceTlsResources = null
    }
    _sourceStateLock.store(false)
}

fn _tlsClientContextSnapshot(runtimeToken: i64) -> TlsClientContext? {
    _lockSourceState()
    var context: TlsClientContext? = null
    if (_runtimeActiveToken.load() == runtimeToken && _sourceTlsResources != null &&
        _sourceTlsResources!.runtimeToken == runtimeToken) {
        context = _sourceTlsResources!.client
    }
    _sourceStateLock.store(false)
    return context
}

fn _tlsServerContextSnapshot(runtimeToken: i64) -> TlsServerContext? {
    _lockSourceState()
    var context: TlsServerContext? = null
    if (_runtimeActiveToken.load() == runtimeToken && _sourceTlsResources != null &&
        _sourceTlsResources!.runtimeToken == runtimeToken) {
        context = _sourceTlsResources!.server
    }
    _sourceStateLock.store(false)
    return context
}

fn _installSourceListener(runtimeToken: i64, listener: NetListener) -> bool {
    _lockSourceState()
    var installed = _sourceListener == null && _runtimeActiveToken.load() == runtimeToken
    if (installed) {
        _sourceListener = { runtimeToken: runtimeToken, listener: listener }
    }
    _sourceStateLock.store(false)
    return installed
}

fn _takeSourceListener(runtimeToken: i64) -> NetListener? {
    _lockSourceState()
    var listener: NetListener? = null
    if (_sourceListener != null && _sourceListener!.runtimeToken == runtimeToken) {
        listener = _sourceListener!.listener
        _sourceListener = null
    }
    _sourceStateLock.store(false)
    return listener
}

fn _closeSourceListener(runtimeToken: i64) {
    var listener = _takeSourceListener(runtimeToken)
    if (listener != null) { net.close(listener!) }
}

// ========== Wire protocol ===========

export type ClusterFrame = {
    kind: i64,
    payload: Array<u8>,
}

export type ClusterTransportFrame = {
    hopLimit: i64,
    topic: string,
    envelope: Array<u8>,
}

export type ClusterHandshakeRequest = {
    name: string,
    nonce: Array<u8>,
    flags: i64,
}

export type ClusterHandshakeAck = {
    name: string,
    nonce: Array<u8>,
    proof: Array<u8>,
    flags: i64,
}

export type ClusterCoroExit = {
    name: string,
    reason: string,
}

export type ClusterDiscoveryAnnouncement = {
    name: string,
    port: i64,
    clusterHash: u64,
}

type _RecentDeparture = {
    name: string,
    markedAtMs: i64,
}

type _DiscoveryDatagram = {
    sender: UdpFrom,
    bytes: Array<u8>,
}

fn _bytes(text: string) -> Array<u8> {
    var view: const Slice<u8> = text.bytes()
    var out = Array<u8>(len(view))
    for (var i = 0; i < len(view); i++) { out[i] = view[i] }
    return out
}

fn _materializeBuffer(buffer: Buffer) -> Array<u8> {
    var count = len(buffer.asBytes())
    var out = Array<u8>(count)
    for (var i = 0; i < count; i++) { out[i] = buffer.asBytes()[i] }
    return out
}

fn _copyBytes(src: Array<u8>, start: i64, end: i64) -> Array<u8>? {
    if (start < 0 || end < start || end > len(src)) { return null }
    var out = Array<u8>(end - start)
    for (var i = start; i < end; i++) { out[i - start] = src[i] }
    return out
}

fn _text(src: Array<u8>, start: i64, end: i64) -> string? {
    var bytes = _copyBytes(src, start, end)
    if (bytes == null) { return null }
    try {
        return string.fromUtf8(bytes![:])
    } catch (e: Utf8Error) {
        return null
    }
}

fn _appendBytes(out: ref Array<u8>, src: Array<u8>) {
    for (var i = 0; i < len(src); i++) { out.push(src[i]) }
}

fn _writeU16(out: ref Array<u8>, value: i64) {
    out.push(((value >> 8) & 255) as u8)
    out.push((value & 255) as u8)
}

fn _writeU32(out: ref Array<u8>, value: i64) {
    out.push(((value >> 24) & 255) as u8)
    out.push(((value >> 16) & 255) as u8)
    out.push(((value >> 8) & 255) as u8)
    out.push((value & 255) as u8)
}

fn _writeU64(out: ref Array<u8>, value: u64) {
    for (var i = 7; i >= 0; i--) {
        out.push(((value >> ((i * 8) as u64)) & (255 as u64)) as u8)
    }
}

fn _readU16(src: Array<u8>, pos: i64) -> i64 {
    return ((src[pos] as i64) << 8) | (src[pos + 1] as i64)
}

fn _readU32(src: Array<u8>, pos: i64) -> i64 {
    return ((src[pos] as i64) << 24) | ((src[pos + 1] as i64) << 16) |
           ((src[pos + 2] as i64) << 8) | (src[pos + 3] as i64)
}

fn _readU64(src: Array<u8>, pos: i64) -> u64 {
    var value: u64 = 0
    for (var i = 0; i < 8; i++) {
        value = (value << (8 as u64)) | (src[pos + i] as u64)
    }
    return value
}

fn _validFrameKind(kind: i64) -> bool {
    return (kind >= FRAME_HANDSHAKE_REQ && kind <= FRAME_CORO_MONITOR) ||
           kind == FRAME_CORO_EXIT
}

fn _validFlags(flags: i64) -> bool { return flags >= 0 && flags <= 4294967295 }

// A complete frame encoder/decoder, not a header helper. Exact length checks
// make trailing bytes a protocol error instead of silently accepting two
// concatenated frames as one.
export fn encodeFrame(kind: i64, payload: Array<u8>) -> Array<u8>? {
    if (!_validFrameKind(kind) || len(payload) + 1 > FRAME_MAX_PAYLOAD) { return null }
    var out: Array<u8> = []
    _writeU32(ref out, len(payload) + 1)
    out.push(kind as u8)
    _appendBytes(ref out, payload)
    return out
}

export fn decodeFrame(data: Array<u8>) -> ClusterFrame? {
    if (len(data) < FRAME_HEADER_SIZE + 1) { return null }
    var total = _readU32(data, 0)
    if (total < 1 || total > FRAME_MAX_PAYLOAD || total + FRAME_HEADER_SIZE != len(data)) {
        return null
    }
    var kind = data[FRAME_HEADER_SIZE] as i64
    if (!_validFrameKind(kind)) { return null }
    var payload = _copyBytes(data, FRAME_HEADER_SIZE + 1, len(data))
    if (payload == null) { return null }
    var frame: ClusterFrame = { kind: kind, payload: payload! }
    return frame
}

export fn encodeTransportFrame(hopLimit: i64, topic: string,
                               envelope: Array<u8>) -> Array<u8>? {
    if (hopLimit < 0 || hopLimit > TOPIC_MAX_HOP_LIMIT || !validTopicName(topic) ||
        len(envelope) < ENVELOPE_HEADER_SIZE) { return null }
    var topicBytes = _bytes(topic)
    var payload: Array<u8> = []
    payload.push(hopLimit as u8)
    payload.push(len(topicBytes) as u8)
    _appendBytes(ref payload, topicBytes)
    _appendBytes(ref payload, envelope)
    return encodeFrame(FRAME_TRANSPORT_ENVELOPE, payload)
}

export fn decodeTransportFrame(data: Array<u8>) -> ClusterTransportFrame? {
    var frame = decodeFrame(data)
    if (frame == null || frame!.kind != FRAME_TRANSPORT_ENVELOPE) { return null }
    var payload = frame!.payload
    if (len(payload) < 2) { return null }
    var topicLen = payload[1] as i64
    if (topicLen <= 0 || 2 + topicLen + ENVELOPE_HEADER_SIZE > len(payload)) { return null }
    var topic = _text(payload, 2, 2 + topicLen)
    if (topic == null || !validTopicName(topic!)) { return null }
    var envelope = _copyBytes(payload, 2 + topicLen, len(payload))
    if (envelope == null) { return null }
    var result: ClusterTransportFrame = {
        hopLimit: payload[0] as i64,
        topic: topic!,
        envelope: envelope!,
    }
    return result
}

export fn encodeHandshakeRequest(request: ClusterHandshakeRequest) -> Array<u8>? {
    var name = _bytes(request.name)
    if (!validNodeName(request.name) || len(request.nonce) != NONCE_SIZE ||
        !_validFlags(request.flags)) { return null }
    var payload: Array<u8> = []
    payload.push(HANDSHAKE_VERSION as u8)
    payload.push(len(name) as u8)
    _appendBytes(ref payload, name)
    _appendBytes(ref payload, request.nonce)
    _writeU32(ref payload, request.flags)
    return encodeFrame(FRAME_HANDSHAKE_REQ, payload)
}

export fn decodeHandshakeRequest(payload: Array<u8>) -> ClusterHandshakeRequest? {
    if (len(payload) < 2 + NONCE_SIZE + 4 || payload[0] as i64 != HANDSHAKE_VERSION) {
        return null
    }
    var nameLen = payload[1] as i64
    if (2 + nameLen + NONCE_SIZE + 4 != len(payload)) { return null }
    var name = _text(payload, 2, 2 + nameLen)
    var nonce = _copyBytes(payload, 2 + nameLen, 2 + nameLen + NONCE_SIZE)
    if (name == null || !validNodeName(name!) || nonce == null) { return null }
    var result: ClusterHandshakeRequest = {
        name: name!, nonce: nonce!, flags: _readU32(payload, len(payload) - 4),
    }
    return result
}

export fn encodeHandshakeAck(ack: ClusterHandshakeAck) -> Array<u8>? {
    var name = _bytes(ack.name)
    if (!validNodeName(ack.name) || len(ack.nonce) != NONCE_SIZE ||
        len(ack.proof) != PROOF_SIZE || !_validFlags(ack.flags)) { return null }
    var payload: Array<u8> = []
    payload.push(HANDSHAKE_VERSION as u8)
    payload.push(len(name) as u8)
    _appendBytes(ref payload, name)
    _appendBytes(ref payload, ack.nonce)
    _appendBytes(ref payload, ack.proof)
    _writeU32(ref payload, ack.flags)
    return encodeFrame(FRAME_HANDSHAKE_ACK, payload)
}

export fn decodeHandshakeAck(payload: Array<u8>) -> ClusterHandshakeAck? {
    if (len(payload) < 2 + NONCE_SIZE + PROOF_SIZE + 4 ||
        payload[0] as i64 != HANDSHAKE_VERSION) { return null }
    var nameLen = payload[1] as i64
    if (2 + nameLen + NONCE_SIZE + PROOF_SIZE + 4 != len(payload)) { return null }
    var name = _text(payload, 2, 2 + nameLen)
    var nonce = _copyBytes(payload, 2 + nameLen, 2 + nameLen + NONCE_SIZE)
    var proof = _copyBytes(payload, 2 + nameLen + NONCE_SIZE,
                           2 + nameLen + NONCE_SIZE + PROOF_SIZE)
    if (name == null || !validNodeName(name!) || nonce == null || proof == null) { return null }
    var result: ClusterHandshakeAck = {
        name: name!, nonce: nonce!, proof: proof!, flags: _readU32(payload, len(payload) - 4),
    }
    return result
}

export fn encodeHandshakeDone(proof: Array<u8>) -> Array<u8>? {
    if (len(proof) != PROOF_SIZE) { return null }
    return encodeFrame(FRAME_HANDSHAKE_DONE, proof)
}

export fn decodeHandshakeDone(payload: Array<u8>) -> Array<u8>? {
    if (len(payload) != PROOF_SIZE) { return null }
    return _copyBytes(payload, 0, len(payload))
}

export fn encodeHeartbeat(kind: i64, timestampMs: i64) -> Array<u8>? {
    if (kind != FRAME_HEARTBEAT_PING && kind != FRAME_HEARTBEAT_PONG) { return null }
    var payload: Array<u8> = []
    _writeU64(ref payload, timestampMs as u64)
    return encodeFrame(kind, payload)
}

export fn decodeHeartbeat(payload: Array<u8>) -> i64? {
    if (len(payload) != 8) { return null }
    return _readU64(payload, 0) as i64
}

export fn encodeCoroMonitor(name: string) -> Array<u8>? {
    if (!_validName(name, CORO_NAME_MAX)) { return null }
    var nameBytes = _bytes(name)
    var payload: Array<u8> = [len(nameBytes) as u8]
    _appendBytes(ref payload, nameBytes)
    return encodeFrame(FRAME_CORO_MONITOR, payload)
}

export fn decodeCoroMonitor(payload: Array<u8>) -> string? {
    if (len(payload) < 1 || payload[0] as i64 + 1 != len(payload)) { return null }
    var name = _text(payload, 1, len(payload))
    if (name == null || !_validName(name!, CORO_NAME_MAX)) { return null }
    return name
}

export fn encodeCoroExit(value: ClusterCoroExit) -> Array<u8>? {
    var name = _bytes(value.name)
    var reason = _bytes(value.reason)
    if (!_validName(value.name, CORO_NAME_MAX) || len(reason) > 255) { return null }
    var payload: Array<u8> = [len(name) as u8]
    _appendBytes(ref payload, name)
    payload.push(len(reason) as u8)
    _appendBytes(ref payload, reason)
    return encodeFrame(FRAME_CORO_EXIT, payload)
}

export fn decodeCoroExit(payload: Array<u8>) -> ClusterCoroExit? {
    if (len(payload) < 2) { return null }
    var nameLen = payload[0] as i64
    if (1 + nameLen >= len(payload)) { return null }
    var reasonLen = payload[1 + nameLen] as i64
    if (2 + nameLen + reasonLen != len(payload)) { return null }
    var name = _text(payload, 1, 1 + nameLen)
    var reason = _text(payload, 2 + nameLen, len(payload))
    if (name == null || !_validName(name!, CORO_NAME_MAX) || reason == null) { return null }
    var result: ClusterCoroExit = { name: name!, reason: reason! }
    return result
}

fn _peerTransportCurrent(runtimeToken: i64, peerGeneration: i64) -> bool {
    _lockPeerTransport()
    var current = false
    if (_runtimeActiveToken.load() == runtimeToken) {
        for (var i = 0; i < len(_peerTransports); i++) {
            var endpoint = _peerTransports[i].endpoint
            if (endpoint.runtimeToken == runtimeToken &&
                endpoint.generation == peerGeneration &&
                _peerTransports[i].committed) {
                current = true
            }
        }
    }
    _peerTransportLock.store(false)
    return current
}

fn _peerTransportHealthSnapshots(runtimeToken: i64) -> Array<_PeerTransportHealthSnapshot>? {
    _lockPeerTransport()
    if (_runtimeActiveToken.load() != runtimeToken) {
        _peerTransportLock.store(false)
        return null
    }
    var snapshots: Array<_PeerTransportHealthSnapshot> = []
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.runtimeToken == runtimeToken && peer.committed) {
            snapshots.push({
                peerGeneration: peer.endpoint.generation,
                lastReceivedAtMs: peer.lastReceivedAtMs,
            })
        }
    }
    _peerTransportLock.store(false)
    return snapshots
}

fn _peerTransportSnapshots(runtimeToken: i64) -> Array<_PeerTransportSnapshot>? {
    _lockPeerTransport()
    if (_runtimeActiveToken.load() != runtimeToken) {
        _peerTransportLock.store(false)
        return null
    }
    var snapshots: Array<_PeerTransportSnapshot> = []
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.runtimeToken == runtimeToken && peer.committed) {
            snapshots.push({
                peerGeneration: peer.endpoint.generation,
                framesSent: peer.framesSent,
                framesReceived: peer.framesReceived,
                bytesSent: peer.bytesSent,
                bytesReceived: peer.bytesReceived,
                sendErrors: peer.sendErrors,
                slowConsumerEvents: peer.slowConsumerEvents,
                rttMs: peer.rttMs,
                outQueueBytes: peer.queuedBytes,
                outQueueFrames: len(peer.outbound),
                slow: peer.full,
                lastReceivedAtMs: peer.lastReceivedAtMs,
            })
        }
    }
    _peerTransportLock.store(false)
    return snapshots
}

fn _recordPeerRead(peerGeneration: i64, bytes: i64, completeFrame: bool) {
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.generation == peerGeneration && peer.committed) {
            peer.bytesReceived = peer.bytesReceived + bytes
            if (completeFrame) { peer.framesReceived = peer.framesReceived + 1 }
            _peerTransports[i] = peer
        }
    }
    _peerTransportLock.store(false)
}

fn _recordPeerWrite(peerGeneration: i64, bytes: i64, completeFrame: bool,
                    failed: bool) {
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.generation == peerGeneration && peer.committed) {
            if (bytes > 0) { peer.bytesSent = peer.bytesSent + bytes }
            if (completeFrame) { peer.framesSent = peer.framesSent + 1 }
            if (failed) { peer.sendErrors = peer.sendErrors + 1 }
            _peerTransports[i] = peer
        }
    }
    _peerTransportLock.store(false)
}

fn _enqueuePeerFrame(peerGeneration: i64, wire: Array<u8>) -> i64 {
    if (len(wire) < FRAME_HEADER_SIZE + 1 ||
        len(wire) > FRAME_HEADER_SIZE + FRAME_MAX_PAYLOAD) {
        return _PEER_QUEUE_INVALID
    }
    var owned = _copyBytes(wire, 0, len(wire))
    if (owned == null) { return _PEER_QUEUE_INVALID }
    var wake: const Channel<i64>? = null
    var outcome = _PEER_QUEUE_STOPPED
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.generation != peerGeneration || !peer.committed) { continue }
        if (_runtimeActiveToken.load() != peer.endpoint.runtimeToken) { break }
        if (peer.full) {
            outcome = _PEER_QUEUE_FULL
            break
        }
        peer.outbound.push(owned!)
        peer.queuedBytes = peer.queuedBytes + len(owned!)
        if (peer.queuedBytes >= OUTPUT_QUEUE_HIGH_WATERMARK_BYTES) { peer.full = true }
        wake = peer.endpoint.wake
        _peerTransports[i] = peer
        outcome = _PEER_QUEUE_ACCEPTED
        break
    }
    _peerTransportLock.store(false)
    if (wake != null) { wake!.trySend(1) }
    return outcome
}

fn _takePeerFrame(peerGeneration: i64) -> _PeerTake {
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.generation != peerGeneration || !peer.committed) { continue }
        if (_runtimeActiveToken.load() != peer.endpoint.runtimeToken) {
            _peerTransportLock.store(false)
            return { status: _PEER_QUEUE_STOPPED, wire: null }
        }
        if (peer.full) {
            peer.slowConsumerEvents = peer.slowConsumerEvents + 1
            _peerTransports[i] = peer
            _peerTransportLock.store(false)
            return { status: _PEER_QUEUE_FULL, wire: null }
        }
        var wire = peer.outbound.shift()
        if (wire == null) {
            _peerTransportLock.store(false)
            return { status: _PEER_QUEUE_EMPTY, wire: null }
        }
        peer.queuedBytes = peer.queuedBytes - len(wire!)
        _peerTransports[i] = peer
        _peerTransportLock.store(false)
        return { status: _PEER_QUEUE_ACCEPTED, wire: wire }
    }
    _peerTransportLock.store(false)
    return { status: _PEER_QUEUE_STOPPED, wire: null }
}

fn _peerQueueStatus(peerGeneration: i64) -> i64 {
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.generation == peerGeneration && peer.committed) {
            var status = peer.full ? _PEER_QUEUE_FULL
                                   : (len(peer.outbound) > 0 ? _PEER_QUEUE_ACCEPTED
                                                            : _PEER_QUEUE_EMPTY)
            _peerTransportLock.store(false)
            return status
        }
    }
    _peerTransportLock.store(false)
    return _PEER_QUEUE_STOPPED
}

fn _detachPeerTransport(peerGeneration: i64) -> const _PeerEndpoint? {
    _lockPeerTransport()
    var endpoint: const _PeerEndpoint? = null
    var retained: Array<_PeerTransportState> = []
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (endpoint == null && peer.endpoint.generation == peerGeneration) {
            endpoint = peer.endpoint
        } else {
            retained.push(peer)
        }
    }
    _peerTransports = retained
    _peerTransportLock.store(false)
    if (endpoint != null) {
        endpoint!.ready.close()
        endpoint!.wake.close()
        net.shutdown(endpoint!.conn)
    }
    return endpoint
}

fn _detachPeerTransportIfCurrent(runtimeToken: i64, peerGeneration: i64,
                                 expectedLastReceivedAtMs: i64) -> bool {
    _lockPeerTransport()
    var endpoint: const _PeerEndpoint? = null
    var retained: Array<_PeerTransportState> = []
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        var exact = peer.endpoint.runtimeToken == runtimeToken &&
                    peer.endpoint.generation == peerGeneration &&
                    peer.lastReceivedAtMs == expectedLastReceivedAtMs
        if (endpoint == null && exact) { endpoint = peer.endpoint }
        else { retained.push(peer) }
    }
    _peerTransports = retained
    _peerTransportLock.store(false)
    if (endpoint != null) {
        endpoint!.ready.close()
        endpoint!.wake.close()
        net.shutdown(endpoint!.conn)
        return true
    }
    return false
}

fn _stopPeerTransports(runtimeToken: i64) {
    var endpoints: Array<const _PeerEndpoint> = []
    var retained: Array<_PeerTransportState> = []
    _lockPeerTransport()
    for (var i = 0; i < len(_peerTransports); i++) {
        var peer = _peerTransports[i]
        if (peer.endpoint.runtimeToken == runtimeToken) {
            endpoints.push(peer.endpoint)
        } else {
            retained.push(peer)
        }
    }
    _peerTransports = retained
    _peerTransportLock.store(false)
    for (var i = 0; i < len(endpoints); i++) {
        endpoints[i].ready.close()
        endpoints[i].wake.close()
        net.shutdown(endpoints[i].conn)
    }
}

// Every protocol decision after one complete bounded source-read frame is
// keyed by a process-unique peer generation, so a retiring transport cannot
// address a replacement peer.
fn _forwardRemoteMonitor(peerGeneration: i64, name: string) {
    var requester = _peerName(peerGeneration)
    if (requester == null) { return }
    var requesterName = requester!
    const notifications = Coro.monitor(name)
    defer { notifications.close() }
    while (true) {
        match (notifications.recvTimeout(_REMOTE_MONITOR_POLL_MS)) {
            Recv.Value { value: reason } -> {
                if (!_peerIdentityCurrent(peerGeneration, requesterName)) { return }
                var exited: ClusterCoroExit = { name: name, reason: reason }
                var response = encodeCoroExit(exited)
                if (response != null) { _enqueueControlFrame(peerGeneration, response!) }
                return
            }
            Recv.Closed -> {
                if (!_peerIdentityCurrent(peerGeneration, requesterName)) { return }
                var exited: ClusterCoroExit = { name: name, reason: "noproc" }
                var response = encodeCoroExit(exited)
                if (response != null) { _enqueueControlFrame(peerGeneration, response!) }
                return
            }
            Recv.Timeout -> {
                if (!_peerIdentityCurrent(peerGeneration, requesterName)) { return }
            }
            Recv.Empty -> {}
        }
    }
}

fn _finishPeerDeparture(token: i64, peerGeneration: i64,
                        departed: _PeerDirectoryEntry, markedAtMs: i64) {
    _removePhiPeerState(token, peerGeneration)
    if (departed.state == _PEER_COMMITTED) {
        _notifyNodeDownIfCurrent(token, peerGeneration, departed.name, markedAtMs)
    }
    _removePeerDirectoryEntry(token, peerGeneration)
}

fn _completePeerDeparture(token: i64, peerGeneration: i64, markedAtMs: i64) {
    var departed = _beginPeerDeparture(token, peerGeneration)
    if (departed != null) {
        _finishPeerDeparture(token, peerGeneration, departed!, markedAtMs)
    }
}

// Transport detachment is generation-keyed source resource manipulation. The
// directory entry remains in a departing state until tombstone and monitor effects
// have completed, so the same name cannot be admitted through that window.
fn _disconnectPeer(peerGeneration: i64) {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return }
    var departed = _beginPeerDeparture(token, peerGeneration)
    if (departed == null) { return }
    _detachPeerTransport(peerGeneration)
    _finishPeerDeparture(token, peerGeneration, departed!, time.monotonic())
}

fn _enqueueControlFrame(peerGeneration: i64, wire: Array<u8>) {
    var admission = _enqueuePeerFrame(peerGeneration, wire)
    if (admission == _PEER_QUEUE_FULL || admission == _PEER_QUEUE_INVALID) {
        _disconnectPeer(peerGeneration)
    }
}

fn _broadcastPeersForRuntime(runtimeToken: i64, excludedGeneration: i64,
                             wire: Array<u8>) -> _DeliveryStats? {
    var result: _DeliveryStats? = null
    if (runtimeToken != 0) {
        var peers = _peerDirectorySnapshot(runtimeToken)
        if (_runtimeActiveToken.load() == runtimeToken) {
            var stats: _DeliveryStats = { accepted: 0, full: 0, stopped: 0 }
            for (var i = 0; i < len(peers); i++) {
                var generation = peers[i].generation
                if (generation == excludedGeneration) { continue }
                var admission = _enqueuePeerFrame(generation, wire)
                if (admission == _PEER_QUEUE_ACCEPTED) {
                    stats.accepted = stats.accepted + 1
                } else if (admission == _PEER_QUEUE_FULL) {
                    stats.full = stats.full + 1
                } else if (admission == _PEER_QUEUE_STOPPED) {
                    stats.stopped = stats.stopped + 1
                } else { stats.stopped = stats.stopped + 1 }
            }
            if (_runtimeActiveToken.load() == runtimeToken) { result = stats }
        }
    }
    return result
}

fn _dispatchInboundFrame(runtimeToken: i64, peerGeneration: i64, receivedAtMs: i64,
                         wire: Array<u8>) -> bool {
    if (_runtimeActiveToken.load() != runtimeToken) { return false }
    var frame = decodeFrame(wire)
    if (frame == null) { return false }
    if (frame!.kind == FRAME_HEARTBEAT_PING) {
        var timestamp = decodeHeartbeat(frame!.payload)
        if (timestamp == null) { return false }
        var response = encodeHeartbeat(FRAME_HEARTBEAT_PONG, timestamp!)
        if (response != null) { _enqueueControlFrame(peerGeneration, response!) }
        _observeHeartbeat(peerGeneration, receivedAtMs, -1)
        return true
    }
    if (frame!.kind == FRAME_HEARTBEAT_PONG) {
        var timestamp = decodeHeartbeat(frame!.payload)
        if (timestamp == null) { return false }
        var rtt = receivedAtMs - timestamp!
        _observeHeartbeat(peerGeneration, receivedAtMs, rtt < 0 ? 0 : rtt)
        return true
    }
    if (frame!.kind == FRAME_TRANSPORT_ENVELOPE) {
        var transport = decodeTransportFrame(wire)
        if (transport == null) { return false }
        _deliverTopicForRuntime(runtimeToken, transport!.topic, transport!.envelope)
        if (transport!.hopLimit > 0) {
            var forward = encodeTransportFrame(transport!.hopLimit - 1, transport!.topic,
                                               transport!.envelope)
            if (forward != null) {
                _broadcastPeersForRuntime(runtimeToken, peerGeneration, forward!)
            }
        }
        return true
    }
    if (frame!.kind == FRAME_CORO_MONITOR) {
        var name = decodeCoroMonitor(frame!.payload)
        if (name == null) { return false }
        go _forwardRemoteMonitor(peerGeneration, name!)
        return true
    }
    if (frame!.kind == FRAME_CORO_EXIT) {
        var exited = decodeCoroExit(frame!.payload)
        if (exited == null) { return false }
        _notifyRemoteExit(peerGeneration, exited!.name, exited!.reason)
        return true
    }
    return false
}

fn _readPeerExact(runtimeToken: i64, peerGeneration: i64,
                  conn: NetConn, count: i64) -> Array<u8>? {
    if (count <= 0) { return null }
    var out: Array<u8> = []
    while (len(out) < count && _peerTransportCurrent(runtimeToken, peerGeneration)) {
        var remaining = count - len(out)
        var chunk = Array<u8>(remaining)
        var n = net.readInto(conn, ref chunk, remaining)
        if (n <= 0) { return null }
        _recordPeerRead(peerGeneration, n, false)
        _appendBytes(ref out, chunk)
    }
    if (len(out) != count) { return null }
    return copy(out)
}

fn _readPeerFrame(runtimeToken: i64, peerGeneration: i64,
                  conn: NetConn) -> Array<u8>? {
    var header = _readPeerExact(runtimeToken, peerGeneration, conn, FRAME_HEADER_SIZE)
    if (header == null) { return null }
    var bodySize = _readU32(header!, 0)
    if (bodySize < 1 || bodySize > FRAME_MAX_PAYLOAD) { return null }
    var body = _readPeerExact(runtimeToken, peerGeneration, conn, bodySize)
    if (body == null) { return null }
    var wire = header!
    _appendBytes(ref wire, body!)
    _recordPeerRead(peerGeneration, 0, true)
    return wire
}

fn _peerReadLoop(runtimeToken: i64, peerGeneration: i64, conn: NetConn) {
    while (_peerTransportCurrent(runtimeToken, peerGeneration)) {
        var wire = _readPeerFrame(runtimeToken, peerGeneration, conn)
        if (wire == null ||
            !_dispatchInboundFrame(runtimeToken, peerGeneration, time.monotonic(), wire!)) {
            _disconnectPeer(peerGeneration)
            return
        }
    }
}

fn _peerWriteLoop(runtimeToken: i64, peerGeneration: i64,
                  conn: NetConn, wake: Channel<i64>) {
    while (_peerTransportCurrent(runtimeToken, peerGeneration)) {
        if (wake.recvOr(0) == 0) { return }
        var taken = _takePeerFrame(peerGeneration)
        if (taken.status == _PEER_QUEUE_FULL) {
            _disconnectPeer(peerGeneration)
            return
        }
        if (taken.status == _PEER_QUEUE_STOPPED) { return }
        if (taken.status == _PEER_QUEUE_EMPTY || taken.wire == null) { continue }
        var sent = net.writeBytes(conn, taken.wire!)
        var complete = sent == len(taken.wire!)
        _recordPeerWrite(peerGeneration, sent > 0 ? sent : 0,
                         complete, !complete)
        if (!complete) {
            _disconnectPeer(peerGeneration)
            return
        }
        // A one-slot signal channel coalesces wakeups. Re-arm it when
        // more source-owned frames remain, then yield after exactly
        // one frame so another peer writer gets a scheduling turn.
        var next = _peerQueueStatus(peerGeneration)
        if (next == _PEER_QUEUE_ACCEPTED) {
            wake.trySend(1)
        } else if (next == _PEER_QUEUE_FULL) {
            _disconnectPeer(peerGeneration)
            return
        }
        Coro.yield()
    }
}

fn _drivePeer(runtimeToken: i64, peerGeneration: i64,
              conn: NetConn, ready: Channel<i64>, wake: Channel<i64>) {
    const sharedConn = conn
    const sharedReady = ready
    const sharedWake = wake
    var admitted = sharedReady.recvOr(0)
    sharedReady.close()
    if (admitted == 0) {
        net.close(sharedConn)
        return
    }
    scope {
        go _peerReadLoop(runtimeToken, peerGeneration, sharedConn)
        go _peerWriteLoop(runtimeToken, peerGeneration, sharedConn, sharedWake)
    }
    net.close(sharedConn)
}

// Installation only publishes the immutable endpoint and raw transport state.
// The caller must register health state and commit the directory reservation
// before starting _drivePeer, so an authenticated-but-uncommitted peer cannot
// dispatch frames or become observable through public APIs.
fn _installPeerTransport(conn: move NetConn, runtimeToken: i64,
                         peerGeneration: i64,
                         connectedAtMs: i64) -> const _PeerEndpoint? {
    if (_runtimeActiveToken.load() != runtimeToken || peerGeneration <= 0 ||
        !net.setDeadline(conn, 0)) {
        net.close(conn)
        return null
    }
    const sharedConn = conn
    const sharedReady = Channel<i64>(1)
    const sharedWake = Channel<i64>(1)
    const endpoint = _PeerEndpoint(
        runtimeToken, peerGeneration, sharedConn, sharedReady, sharedWake)
    var peer: _PeerTransportState = {
        endpoint: endpoint,
        committed: false,
        outbound: [],
        queuedBytes: 0,
        full: false,
        lastReceivedAtMs: connectedAtMs,
        framesSent: 0,
        framesReceived: 0,
        bytesSent: 0,
        bytesReceived: 0,
        sendErrors: 0,
        slowConsumerEvents: 0,
        rttMs: 0,
    }
    var published = false
    _lockPeerTransport()
    if (_runtimeActiveToken.load() == runtimeToken) {
        published = true
        for (var i = 0; i < len(_peerTransports); i++) {
            if (_peerTransports[i].endpoint.generation == peerGeneration) {
                published = false
            }
        }
        if (published) { _peerTransports.push(peer) }
    }
    _peerTransportLock.store(false)
    if (!published) {
        sharedReady.close()
        sharedWake.close()
        net.close(sharedConn)
        return null
    }
    // The coordinator owns the only net.close. Its children remain behind the
    // one-shot ready gate until the caller commits the source directory entry.
    go _drivePeer(runtimeToken, peerGeneration, sharedConn, sharedReady, sharedWake)
    return endpoint
}

// HMAC-SHA256 is provided by crypto.xr; cluster owns the proof construction
// and fixed sizes. No native cluster authentication policy remains.
export fn computeHandshakeProof(secret: string, nonce: Array<u8>) -> Array<u8>? {
    if (len(nonce) != NONCE_SIZE) { return null }
    return crypto.hmacBytes("sha256", _bytes(secret), nonce)
}

export fn handshakeProofEqual(left: Array<u8>, right: Array<u8>) -> bool {
    if (len(left) != PROOF_SIZE || len(right) != PROOF_SIZE) { return false }
    return crypto.timingSafeEqualBytes(left, right)
}

// ========== Failure detection ===========

// Both live health decisions and diagnostic snapshots use the same
// source-owned formula over source-owned detector state.
fn _phiValue(samples: i64, mean: f64, variance: f64,
             lastHeartbeatMs: i64, nowMs: i64) -> f64 {
    if (lastHeartbeatMs == 0 || samples < 2) { return 0.0 }
    var elapsed = (nowMs - lastHeartbeatMs) as f64
    if (elapsed < 0.0) { elapsed = 0.0 }
    var stddev = math.sqrt(variance)
    if (stddev < 1.0) { stddev = 1.0 }
    var y = (elapsed - mean) / stddev
    var later = 1.0 / (1.0 + math.exp(1.7155 * y))
    if (later < 0.000000000000001) { later = 0.000000000000001 }
    return -math.log10(later)
}

export final class PhiDetector {
    intervals: Array<f64>
    sampleCount: i64
    writeIndex: i64
    mean: f64
    variance: f64
    sum: f64
    sumSquares: f64
    lastHeartbeatMs: i64

    constructor(expectedIntervalMs: i64 = HEARTBEAT_INTERVAL_MS) {
        this.intervals = Array<f64>(PHI_WINDOW_SIZE)
        this.sampleCount = 0
        this.writeIndex = 0
        this.mean = expectedIntervalMs as f64
        this.variance = 100.0
        this.sum = 0.0
        this.sumSquares = 0.0
        this.lastHeartbeatMs = 0
    }

    ref record(nowMs: i64) {
        if (this.lastHeartbeatMs > 0) {
            var interval = (nowMs - this.lastHeartbeatMs) as f64
            if (interval < 0.0) { interval = 0.0 }
            if (this.sampleCount >= PHI_WINDOW_SIZE) {
                var old = this.intervals[this.writeIndex]
                this.sum = this.sum - old
                this.sumSquares = this.sumSquares - old * old
            } else {
                this.sampleCount = this.sampleCount + 1
            }
            this.intervals[this.writeIndex] = interval
            this.writeIndex = (this.writeIndex + 1) % PHI_WINDOW_SIZE
            this.sum = this.sum + interval
            this.sumSquares = this.sumSquares + interval * interval
            this.mean = this.sum / (this.sampleCount as f64)
            this.variance = this.sumSquares / (this.sampleCount as f64) - this.mean * this.mean
            if (this.variance < 1.0) { this.variance = 1.0 }
        }
        this.lastHeartbeatMs = nowMs
    }

    value(nowMs: i64) -> f64 {
        return _phiValue(this.sampleCount, this.mean, this.variance,
                         this.lastHeartbeatMs, nowMs)
    }
}

fn _removePhiPeerState(runtimeToken: i64, peerGeneration: i64) {
    var retained: Array<_PhiPeerState> = []
    _lockPhiState()
    for (var i = 0; i < len(_phiPeerStates); i++) {
        var state = _phiPeerStates[i]
        if (state.runtimeToken != runtimeToken || state.peerGeneration != peerGeneration) {
            retained.push(state)
        }
    }
    _phiPeerStates = retained
    _phiStateLock.store(false)
}

fn _registerPhiPeerState(runtimeToken: i64, peerGeneration: i64,
                         adoptedAtMs: i64, expectedIntervalMs: i64) -> bool {
    if (peerGeneration == 0) { return false }
    _lockPhiState()
    if (_runtimeActiveToken.load() != runtimeToken) {
        _phiStateLock.store(false)
        return false
    }
    for (var i = 0; i < len(_phiPeerStates); i++) {
        var state = _phiPeerStates[i]
        if (state.runtimeToken == runtimeToken && state.peerGeneration == peerGeneration) {
            if (adoptedAtMs < state.adoptedAtMs) {
                state.adoptedAtMs = adoptedAtMs
                _phiPeerStates[i] = state
            }
            _phiStateLock.store(false)
            return true
        }
    }
    var state: _PhiPeerState = {
        runtimeToken: runtimeToken,
        peerGeneration: peerGeneration,
        adoptedAtMs: adoptedAtMs,
        missedHeartbeats: 0,
        detector: PhiDetector(expectedIntervalMs),
    }
    _phiPeerStates.push(state)
    _phiStateLock.store(false)
    return true
}

// Peer receive facts and detector history use separate source locks. Recording
// validates the active runtime token and exact peer generation; health joins
// only a detector snapshot whose timestamp matches the peer fact, so a partial
// observation cannot trigger a disconnect decision.
fn _recordPhiHeartbeat(runtimeToken: i64, peerGeneration: i64,
                       receivedAtMs: i64, expectedIntervalMs: i64) -> bool {
    _lockPhiState()
    if (_runtimeActiveToken.load() != runtimeToken) {
        _phiStateLock.store(false)
        return false
    }
    for (var i = 0; i < len(_phiPeerStates); i++) {
        var state = _phiPeerStates[i]
        if (state.runtimeToken == runtimeToken && state.peerGeneration == peerGeneration) {
            var lastObservedAtMs = state.detector.lastHeartbeatMs > 0
                ? state.detector.lastHeartbeatMs : state.adoptedAtMs
            if (receivedAtMs >= lastObservedAtMs) {
                state.detector.record(receivedAtMs)
                state.missedHeartbeats = 0
                _phiPeerStates[i] = state
            }
            _phiStateLock.store(false)
            return true
        }
    }
    var detector = PhiDetector(expectedIntervalMs)
    detector.record(receivedAtMs)
    var state: _PhiPeerState = {
        runtimeToken: runtimeToken,
        peerGeneration: peerGeneration,
        adoptedAtMs: receivedAtMs,
        missedHeartbeats: 0,
        detector: detector,
    }
    _phiPeerStates.push(state)
    _phiStateLock.store(false)
    return true
}

fn _recordPeerHeartbeat(runtimeToken: i64, peerGeneration: i64,
                        receivedAtMs: i64, rttMs: i64) -> bool {
    _lockPeerTransport()
    var observed = false
    if (_runtimeActiveToken.load() == runtimeToken) {
        for (var i = 0; i < len(_peerTransports); i++) {
            var peer = _peerTransports[i]
            if (peer.endpoint.runtimeToken == runtimeToken &&
                peer.endpoint.generation == peerGeneration && peer.committed) {
                if (receivedAtMs >= peer.lastReceivedAtMs) {
                    peer.lastReceivedAtMs = receivedAtMs
                    if (rttMs >= 0) { peer.rttMs = rttMs }
                    _peerTransports[i] = peer
                }
                observed = true
            }
        }
    }
    _peerTransportLock.store(false)
    return observed
}

fn _observeHeartbeat(peerGeneration: i64, receivedAtMs: i64, rttMs: i64) {
    var runtimeToken = _runtimeActiveToken.load()
    if (runtimeToken == 0) { return }
    var source = _sourceStateSnapshot(runtimeToken)
    if (source == null ||
        !_recordPeerHeartbeat(runtimeToken, peerGeneration, receivedAtMs, rttMs) ||
        !_recordPhiHeartbeat(runtimeToken, peerGeneration, receivedAtMs,
                            source!.heartbeatIntervalMs)) {
        return
    }
    if (_peerName(peerGeneration) == null) {
        _removePhiPeerState(runtimeToken, peerGeneration)
    }
}

fn _phiPeerSnapshot(runtimeToken: i64, peerGeneration: i64) -> _PhiPeerSnapshot {
    var snapshot: _PhiPeerSnapshot = {
        recorded: false,
        adoptedAtMs: 0,
        missedHeartbeats: 0,
        samples: 0,
        mean: 0.0,
        variance: 1.0,
        lastHeartbeatMs: 0,
    }
    _lockPhiState()
    if (_runtimeActiveToken.load() == runtimeToken) {
        for (var i = 0; i < len(_phiPeerStates); i++) {
            var state = _phiPeerStates[i]
            if (state.runtimeToken == runtimeToken && state.peerGeneration == peerGeneration) {
                snapshot.recorded = true
                snapshot.adoptedAtMs = state.adoptedAtMs
                snapshot.missedHeartbeats = state.missedHeartbeats
                snapshot.samples = state.detector.sampleCount
                snapshot.mean = state.detector.mean
                snapshot.variance = state.detector.variance
                snapshot.lastHeartbeatMs = state.detector.lastHeartbeatMs
            }
        }
    }
    _phiStateLock.store(false)
    return snapshot
}

fn _advanceMissedHeartbeat(runtimeToken: i64, peerGeneration: i64,
                           expectedLastReceivedAtMs: i64,
                           expectedMissedHeartbeats: i64) -> i64 {
    var nextMissedHeartbeats: i64 = -1
    _lockPhiState()
    if (_runtimeActiveToken.load() == runtimeToken) {
        for (var i = 0; i < len(_phiPeerStates); i++) {
            var state = _phiPeerStates[i]
            var lastReceivedAtMs = state.detector.lastHeartbeatMs > 0
                ? state.detector.lastHeartbeatMs : state.adoptedAtMs
            if (state.runtimeToken == runtimeToken &&
                state.peerGeneration == peerGeneration &&
                lastReceivedAtMs == expectedLastReceivedAtMs &&
                state.missedHeartbeats == expectedMissedHeartbeats) {
                state.missedHeartbeats = state.missedHeartbeats + 1
                nextMissedHeartbeats = state.missedHeartbeats
                _phiPeerStates[i] = state
            }
        }
    }
    _phiStateLock.store(false)
    return nextMissedHeartbeats
}
// During detector warm-up the fixed timeout is deliberately conservative;
// once three samples exist, phi alone decides liveness.
export fn heartbeatIsDead(phi: f64, samples: i64, elapsedMs: i64,
                          missedHeartbeats: i64, timeoutMs: i64,
                          maxMissedHeartbeats: i64) -> bool {
    if (samples >= PHI_MIN_SAMPLES) { return phi > PHI_THRESHOLD }
    if (elapsedMs <= timeoutMs) { return false }
    return missedHeartbeats + 1 >= maxMissedHeartbeats
}

export fn heartbeatTickInterval(intervalMs: i64) -> i64 {
    var tick = intervalMs / 2
    return tick < HEARTBEAT_TICK_MIN_MS ? HEARTBEAT_TICK_MIN_MS : tick
}

export fn tombstoneIsLive(markedAtMs: i64, nowMs: i64) -> bool {
    if (nowMs < markedAtMs) { return true }
    return nowMs - markedAtMs < TOMBSTONE_RETENTION_MS
}

// ========== Discovery policy ===========

export fn discoveryClusterHash(secret: string) -> u64 {
    if (len(secret) == 0) { return 0 }
    var hash: u64 = 14695981039346656037
    var bytes: const Slice<u8> = secret.bytes()
    for (var i = 0; i < len(bytes); i++) {
        hash = (hash ^ (bytes[i] as u64)) * (1099511628211 as u64)
    }
    return hash
}

export fn encodeDiscoveryAnnouncement(value: ClusterDiscoveryAnnouncement) -> Array<u8>? {
    if (!validNodeName(value.name) || value.port <= 0 || value.port > 65535) { return null }
    var name = _bytes(value.name)
    var out: Array<u8> = []
    _writeU32(ref out, DISCOVERY_MAGIC)
    out.push(DISCOVERY_VERSION as u8)
    out.push(len(name) as u8)
    _appendBytes(ref out, name)
    _writeU16(ref out, value.port)
    _writeU64(ref out, value.clusterHash)
    return out
}

export fn decodeDiscoveryAnnouncement(data: Array<u8>) -> ClusterDiscoveryAnnouncement? {
    if (len(data) < 16 || _readU32(data, 0) != DISCOVERY_MAGIC ||
        data[4] as i64 != DISCOVERY_VERSION) { return null }
    var nameLen = data[5] as i64
    if (6 + nameLen + 2 + 8 != len(data)) { return null }
    var name = _text(data, 6, 6 + nameLen)
    var port = _readU16(data, 6 + nameLen)
    if (name == null || !validNodeName(name!) || port <= 0) { return null }
    var result: ClusterDiscoveryAnnouncement = {
        name: name!, port: port, clusterHash: _readU64(data, 8 + nameLen),
    }
    return result
}

export fn shouldJoinDiscoveredNode(selfName: string, connectedNames: Array<string>,
                                   tombstones: Array<string>,
                                   announcement: ClusterDiscoveryAnnouncement,
                                   expectedClusterHash: u64) -> bool {
    if (announcement.clusterHash != expectedClusterHash || announcement.name == selfName) {
        return false
    }
    for (var i = 0; i < len(tombstones); i++) {
        if (tombstones[i] == announcement.name) { return false }
    }
    for (var i = 0; i < len(connectedNames); i++) {
        if (connectedNames[i] == announcement.name) { return false }
    }
    return true
}

fn _claimDiscovery(runtimeToken: i64, discoveryToken: i64) -> bool {
    _lockDiscoveryState()
    var claimed = _discoveryGeneration == null &&
                  _runtimeActiveToken.load() == runtimeToken
    if (claimed) {
        _discoveryGeneration = {
            runtimeToken: runtimeToken,
            discoveryToken: discoveryToken,
            socket: null,
        }
    }
    _discoveryStateLock.store(false)
    return claimed
}

fn _discoveryIsActive(runtimeToken: i64, discoveryToken: i64) -> bool {
    _lockDiscoveryState()
    var active = _discoveryGeneration != null &&
                 _discoveryGeneration!.runtimeToken == runtimeToken &&
                 _discoveryGeneration!.discoveryToken == discoveryToken &&
                 _runtimeActiveToken.load() == runtimeToken
    _discoveryStateLock.store(false)
    return active
}

fn _installDiscoverySocket(runtimeToken: i64, discoveryToken: i64,
                           socket: NetConn) -> bool {
    _lockDiscoveryState()
    var installed = _discoveryGeneration != null &&
                    _discoveryGeneration!.runtimeToken == runtimeToken &&
                    _discoveryGeneration!.discoveryToken == discoveryToken &&
                    _discoveryGeneration!.socket == null &&
                    _runtimeActiveToken.load() == runtimeToken
    if (installed) {
        var generation = _discoveryGeneration!
        generation.socket = socket
        _discoveryGeneration = generation
    }
    _discoveryStateLock.store(false)
    return installed
}

fn _releaseDiscovery(runtimeToken: i64, discoveryToken: i64) {
    _lockDiscoveryState()
    var socket: NetConn? = null
    if (_discoveryGeneration != null &&
        _discoveryGeneration!.runtimeToken == runtimeToken &&
        _discoveryGeneration!.discoveryToken == discoveryToken) {
        socket = _discoveryGeneration!.socket
        _discoveryGeneration = null
    }
    _discoveryStateLock.store(false)
    if (socket != null) { net.close(socket!) }
}

fn _stopDiscovery(runtimeToken: i64) {
    _lockDiscoveryState()
    var socket: NetConn? = null
    if (_discoveryGeneration != null &&
        _discoveryGeneration!.runtimeToken == runtimeToken) {
        socket = _discoveryGeneration!.socket
        _discoveryGeneration = null
    }
    _discoveryStateLock.store(false)
    if (socket != null) { net.close(socket!) }
}

fn _hexNibble(c: rune) -> i64 {
    var n = c.toUInt32()
    if (n >= 48 && n <= 57) { return (n - 48) as i64 }
    if (n >= 65 && n <= 70) { return (n - 55) as i64 }
    if (n >= 97 && n <= 102) { return (n - 87) as i64 }
    return -1
}

fn _handshakeNonce() -> Array<u8>? {
    var hex = crypto.randomBytes(NONCE_SIZE)
    if (len(hex) != NONCE_SIZE * 2) { return null }
    var nonce = Array<u8>(NONCE_SIZE)
    for (var i = 0; i < NONCE_SIZE; i++) {
        var hi = _hexNibble(hex.runes().nth(i * 2))
        var lo = _hexNibble(hex.runes().nth(i * 2 + 1))
        if (hi < 0 || lo < 0) { return null }
        nonce[i] = (((hi << 4) | lo) & 255) as u8
    }
    return nonce
}

fn _readExact(conn: NetConn, count: i64) -> Array<u8>? {
    if (count <= 0) { return null }
    var out: Array<u8> = []
    while (len(out) < count) {
        var remaining = count - len(out)
        var chunk = Array<u8>(remaining)
        var n = net.readInto(conn, ref chunk, remaining)
        if (n <= 0) { return null }
        _appendBytes(ref out, chunk)
    }
    return out
}

fn _readHandshakeFrame(conn: NetConn) -> ClusterFrame? {
    var header = _readExact(conn, FRAME_HEADER_SIZE)
    if (header == null) { return null }
    var bodySize = _readU32(header!, 0)
    if (bodySize < 1 || bodySize > _HANDSHAKE_FRAME_BODY_MAX) { return null }
    var body = _readExact(conn, bodySize)
    if (body == null) { return null }
    var wire = header!
    _appendBytes(ref wire, body!)
    return decodeFrame(wire)
}

fn _mayPublishPeer(runtimeToken: i64, name: string) -> bool {
    var source = _sourceStateSnapshot(runtimeToken)
    return source != null && name != source!.selfName && !_recentlyDeparted(name) &&
           !_peerNameConflict(name) && _runtimeActiveToken.load() == runtimeToken
}

fn _adoptReservedPeer(conn: move NetConn, runtimeToken: i64, name: string,
                      address: Endpoint?, flags: i64) -> bool {
    var reservation = _reservePeer(runtimeToken, name, address, flags)
    if (reservation == null) {
        net.close(conn)
        return false
    }
    var peer = reservation!
    var adoptedAtMs = time.monotonic()
    var endpoint = _installPeerTransport(
        move conn, peer.runtimeToken, peer.generation, adoptedAtMs)
    if (endpoint == null) {
        _removePeerDirectoryEntry(peer.runtimeToken, peer.generation)
        return false
    }
    var source = _sourceStateSnapshot(peer.runtimeToken)
    if (source == null ||
        !_registerPhiPeerState(peer.runtimeToken, peer.generation, adoptedAtMs,
                              source!.heartbeatIntervalMs)) {
        _detachPeerTransport(peer.generation)
        _removePeerDirectoryEntry(peer.runtimeToken, peer.generation)
        return false
    }
    if (!_commitPeer(peer)) {
        _detachPeerTransport(peer.generation)
        _removePhiPeerState(peer.runtimeToken, peer.generation)
        _removePeerDirectoryEntry(peer.runtimeToken, peer.generation)
        return false
    }
    // This is the only transition that opens the reader/writer gate. Until the
    // directory is COMMITTED, the coordinator owns the socket but cannot read,
    // write or dispatch an authenticated frame.
    endpoint!.ready.trySend(1)
    return true
}

// Fold dial's error into a nullable result before establishing the unique
// local that is eventually transferred into the node registry.
fn _dialJoinPeer(host: string, port: i64, timeoutMs: i64) -> NetConn? {
    try {
        return net.dial(host, port, DialOptions(timeoutMs, false))
    } catch (e: NetError) {
        return null
    }
}

fn _joinPeerForRuntime(runtimeToken: i64, host: string, port: i64) -> bool {
    if (runtimeToken == 0) { return false }
    var source = _sourceStateSnapshot(runtimeToken)
    if (source == null) { return false }
    var config = source!
    var deadline = time.monotonic() + HANDSHAKE_TIMEOUT_MS
    var pending = _dialJoinPeer(host, port, HANDSHAKE_TIMEOUT_MS)
    if (pending == null) { return false }
    var live: NetConn = pending!
    pending = null
    if (!net.setDeadline(live, deadline)) {
        net.close(live)
        return false
    }

    if (config.tlsEnabled) {
        var context = _tlsClientContextSnapshot(runtimeToken)
        var remaining = deadline - time.monotonic()
        if (context == null || remaining <= 0) {
            net.close(live)
            return false
        }
        try {
            context!.upgrade(live, host, remaining)
        } catch (e: NetError) {
            // The generic TLS provider closes the connection on failure.
            return false
        }
    }
    if (_runtimeActiveToken.load() != runtimeToken) {
        net.close(live)
        return false
    }

    var nonce = _handshakeNonce()
    if (nonce == null) {
        net.close(live)
        return false
    }
    var requestValue: ClusterHandshakeRequest = {
        name: config.selfName, nonce: nonce!, flags: _CLUSTER_PROTOCOL_FLAGS,
    }
    var request = encodeHandshakeRequest(requestValue)
    if (request == null || net.writeBytes(live, request!) != len(request!)) {
        net.close(live)
        return false
    }

    var frame = _readHandshakeFrame(live)
    if (frame == null || frame!.kind != FRAME_HANDSHAKE_ACK) {
        net.close(live)
        return false
    }
    var ack = decodeHandshakeAck(frame!.payload)
    if (ack == null) {
        net.close(live)
        return false
    }
    var expected = computeHandshakeProof(config.secret, nonce!)
    if (expected == null || !handshakeProofEqual(expected!, ack!.proof)) {
        net.close(live)
        return false
    }

    var doneProof = computeHandshakeProof(config.secret, ack!.nonce)
    if (doneProof == null) {
        net.close(live)
        return false
    }
    var done = encodeHandshakeDone(doneProof!)
    if (done == null || net.writeBytes(live, done!) != len(done!)) {
        net.close(live)
        return false
    }
    if (!_mayPublishPeer(runtimeToken, ack!.name)) {
        net.close(live)
        return false
    }
    return _adoptReservedPeer(
        move live, runtimeToken, ack!.name, Endpoint(host, port), ack!.flags)
}

fn _joinPeer(host: string, port: i64) -> bool {
    var runtimeToken = _runtimeActiveToken.load()
    return _joinPeerForRuntime(runtimeToken, host, port)
}

fn _serveAcceptedPeer(conn: move NetConn, token: i64, selfName: string, secret: string,
                      tlsEnabled: bool) {
    var deadline = time.monotonic() + HANDSHAKE_TIMEOUT_MS
    if (_runtimeActiveToken.load() != token || !net.setDeadline(conn, deadline)) {
        net.close(conn)
        return
    }

    if (tlsEnabled) {
        var context = _tlsServerContextSnapshot(token)
        var remaining = deadline - time.monotonic()
        if (context == null || remaining <= 0) {
            net.close(conn)
            return
        }
        try {
            context!.accept(conn, remaining)
        } catch (e: NetError) {
            // The generic TLS provider closes the connection on failure.
            return
        }
    }
    if (_runtimeActiveToken.load() != token) {
        net.close(conn)
        return
    }

    var frame = _readHandshakeFrame(conn)
    if (frame == null || frame!.kind != FRAME_HANDSHAKE_REQ) {
        net.close(conn)
        return
    }
    var request = decodeHandshakeRequest(frame!.payload)
    if (request == null || !_mayPublishPeer(token, request!.name)) {
        net.close(conn)
        return
    }

    var nonce = _handshakeNonce()
    if (nonce == null) {
        net.close(conn)
        return
    }
    var proof = computeHandshakeProof(secret, request!.nonce)
    if (proof == null) {
        net.close(conn)
        return
    }
    var ackValue: ClusterHandshakeAck = {
        name: selfName, nonce: nonce!, proof: proof!, flags: _CLUSTER_PROTOCOL_FLAGS,
    }
    var ack = encodeHandshakeAck(ackValue)
    if (ack == null || net.writeBytes(conn, ack!) != len(ack!)) {
        net.close(conn)
        return
    }

    var doneFrame = _readHandshakeFrame(conn)
    if (doneFrame == null || doneFrame!.kind != FRAME_HANDSHAKE_DONE) {
        net.close(conn)
        return
    }
    var done = decodeHandshakeDone(doneFrame!.payload)
    var expected = computeHandshakeProof(secret, nonce!)
    if (done == null || expected == null || !handshakeProofEqual(done!, expected!)) {
        net.close(conn)
        return
    }
    if (_runtimeActiveToken.load() != token || !_mayPublishPeer(token, request!.name)) {
        net.close(conn)
        return
    }
    _adoptReservedPeer(move conn, token, request!.name, null, request!.flags)
}

// Keep the affine connection inside a single-iteration frame. A loop-carried
// local would have one source identity on both sides of its back edge, which
// cannot be consumed by one iteration and then reused by the next.
fn _acceptOne(listener: NetListener, token: i64, selfName: string, secret: string,
              tlsEnabled: bool) -> bool {
    if (!net.setAcceptDeadline(listener, time.monotonic() + _ACCEPT_POLL_MS)) {
        if (_runtimeActiveToken.load() != token) { return false }
        time.sleep(10)
        return true
    }
    var accepted = net.accept(listener)
    if (accepted == null) {
        if (_runtimeActiveToken.load() != token) { return false }
        if (net.lastError(listener) != NetError.Timeout) { time.sleep(10) }
        return true
    }
    var live: NetConn = accepted!
    accepted = null
    if (_runtimeActiveToken.load() != token) {
        net.close(live)
        return false
    }
    go _serveAcceptedPeer(move live, token, selfName, secret, tlsEnabled)
    return true
}

fn _acceptLoop(listener: NetListener, token: i64, selfName: string, secret: string,
               tlsEnabled: bool) {
    var live = listener
    defer { _closeSourceListener(token) }
    while (_runtimeActiveToken.load() == token &&
           _acceptOne(live, token, selfName, secret, tlsEnabled)) {}
}

fn _stopFailedHealthGeneration(token: i64) {
    if (!_retireRuntimeGeneration(token)) { return }
    _stopDiscovery(token)
    _closeSourceListener(token)
    _closeTopicSubscriptions(token)
    _clearPhiPeerStates(token)
    _stopPeerTransports(token)
    _clearSourceState(token)
}

fn _healthLoop(token: i64, tickMs: i64, heartbeatTimeoutMs: i64,
               maxMissedHeartbeats: i64) {
    while (_runtimeActiveToken.load() == token) {
        time.sleep(tickMs)
        if (_runtimeActiveToken.load() != token) { return }
        var sentAtMs = time.monotonic()
        var heartbeat = encodeHeartbeat(FRAME_HEARTBEAT_PING, sentAtMs)
        if (heartbeat == null) {
            _stopFailedHealthGeneration(token)
            return
        }
        var peers = _peerTransportHealthSnapshots(token)
        if (peers == null) {
            _stopFailedHealthGeneration(token)
            return
        }
        for (var i = 0; i < len(peers!); i++) {
            var peer = peers![i]
            _enqueueControlFrame(peer.peerGeneration, heartbeat!)
            var detector = _phiPeerSnapshot(token, peer.peerGeneration)
            if (!detector.recorded) { continue }
            var sourceLastReceivedAtMs = detector.lastHeartbeatMs > 0
                ? detector.lastHeartbeatMs : detector.adoptedAtMs
            if (sourceLastReceivedAtMs != peer.lastReceivedAtMs) { continue }
            var elapsedMs = sentAtMs - sourceLastReceivedAtMs
            var phi = _phiValue(detector.samples, detector.mean, detector.variance,
                                detector.lastHeartbeatMs, sentAtMs)
            var expiredDuringWarmup = detector.samples < PHI_MIN_SAMPLES &&
                                      elapsedMs > heartbeatTimeoutMs
            var dead = heartbeatIsDead(phi, detector.samples, elapsedMs,
                                       detector.missedHeartbeats,
                                       heartbeatTimeoutMs, maxMissedHeartbeats)
            if (expiredDuringWarmup &&
                _advanceMissedHeartbeat(token, peer.peerGeneration,
                                        sourceLastReceivedAtMs,
                                        detector.missedHeartbeats) < 0) {
                continue
            }
            if (dead) {
                if (_detachPeerTransportIfCurrent(
                        token, peer.peerGeneration, peer.lastReceivedAtMs)) {
                    _completePeerDeparture(token, peer.peerGeneration, sentAtMs)
                }
            }
        }
    }
}

fn _activateClusterSource(state: _ClusterSourceState, tls: _ClusterTlsResources?,
                          tickMs: i64, pending: move NetListener?) -> bool {
    if (pending == null) { return false }
    const listener: NetListener = pending!
    pending = null
    var token = state.runtimeToken
    if (!_activateRuntimeGeneration(token)) {
        net.close(listener)
        return false
    }
    if (!_installSourceState(state, tls)) {
        _retireRuntimeGeneration(token)
        net.close(listener)
        return false
    }
    if (!_installSourceListener(token, listener)) {
        _retireRuntimeGeneration(token)
        _closeTopicSubscriptions(token)
        _clearPhiPeerStates(token)
        _stopPeerTransports(token)
        net.close(listener)
        _clearSourceState(token)
        return false
    }
    go _healthLoop(token, tickMs, state.heartbeatTimeoutMs, state.maxMissedHeartbeats)
    // Source state retains a strong listener reference so stop can close it
    // synchronously; the accept coroutine releases its own reference on exit.
    go _acceptLoop(listener, token, state.selfName, state.secret, state.tlsEnabled)
    return true
}

fn _joinDiscoveredNode(runtimeToken: i64, host: string, port: i64) {
    _joinPeerForRuntime(runtimeToken, host, port)
}

// Isolate coroutine creation from the loop-carried tombstone owner.  The
// scheduling frame contains only copied scalar values, so the discovery loop
// never carries a borrowed ref-place load across `go`.
fn _scheduleDiscoveredNode(runtimeToken: i64, host: string, port: i64) {
    go _joinDiscoveredNode(runtimeToken, host, port)
}

// The mutable receive buffer belongs to one suspension frame. Returning the
// filled array prevents a ref-place load from becoming loop-carried across the
// next recvFrom suspension.
fn _receiveDiscoveryDatagram(conn: NetConn, waitMs: i64) -> _DiscoveryDatagram? {
    var bytes = Array<u8>(_DISCOVERY_ANNOUNCEMENT_MAX_SIZE)
    var sender = net.recvFrom(conn, ref bytes, waitMs)
    if (sender == null) { return null }
    var datagram: _DiscoveryDatagram = { sender: sender!, bytes: bytes }
    return datagram
}

fn _discoveryLoop(socket: move NetConn, selfName: string, expectedHash: u64,
                  announcement: move Array<u8>, runtimeToken: i64,
                  discoveryToken: i64) {
    var live = socket
    var wire = announcement
    defer { _releaseDiscovery(runtimeToken, discoveryToken) }

    var nextAnnouncementMs = 0
    while (_discoveryIsActive(runtimeToken, discoveryToken)) {
        var nowMs = time.monotonic()
        if (nowMs >= nextAnnouncementMs) {
            try {
                net.sendTo(live, wire, DISCOVERY_MULTICAST_GROUP,
                           DISCOVERY_MULTICAST_PORT, 0)
            } catch (e) {}
            nextAnnouncementMs = nowMs + DISCOVERY_INTERVAL_MS
        }

        var waitMs = nextAnnouncementMs - time.monotonic()
        if (waitMs < 1) { waitMs = 1 }
        var datagram = _receiveDiscoveryDatagram(live, waitMs)
        if (datagram == null) {
            var error = net.lastError(live)
            if (error != null && error != NetError.Timeout) { return }
            continue
        }
        if (!_discoveryIsActive(runtimeToken, discoveryToken)) {
            return
        }

        nowMs = time.monotonic()
        var candidate = decodeDiscoveryAnnouncement(datagram!.bytes)
        var connected = _nodesForRuntime(runtimeToken)
        if (candidate == null || connected == null) { continue }
        var departed = _recentDepartureSnapshot(runtimeToken, nowMs)
        if (departed == null) { return }
        if (shouldJoinDiscoveredNode(selfName, connected!, departed!, candidate!, expectedHash)) {
            var peerHost = copy(datagram!.sender.host)
            var peerPort = candidate!.port
            // End every optional-record projection before `go`: these
            // projections are borrowed places, whereas the coroutine receives
            // only the independent host/port values above.
            datagram = null
            candidate = null
            connected = null
            _scheduleDiscoveredNode(runtimeToken, peerHost, peerPort)
        }
    }
}

// ========== Configuration ==========

// Every TLS-enabled node accepts peers as well as joining them, so it must have
// one complete identity. Client-only half-nodes are not admitted.
export type ClusterTlsOptions = {
    enabled: bool,
    caFile: string?,
    certFile: string?,
    keyFile: string?,
    insecure: bool,
}

// Omitting a heartbeat field takes the source-owned constant above, so the
// defaults have one owner while callers may still choose a faster detector.
export type ClusterConfig = {
    name: string,
    port: i64,
    secret: string?,
    tls: ClusterTlsOptions?,
    heartbeatIntervalMs: i64?,
    heartbeatTimeoutMs: i64?,
    maxMissedHeartbeats: i64?,
}

// Public cluster values and private peer state are declared here. Generic net
// and crypto providers own sockets, TLS, multicast and HMAC host resources;
// this module owns every cluster-specific identity, policy and lifecycle.
export enum ClusterDelivery {
    Accepted,
    InvalidTopic,
    InvalidEnvelope,
    Unavailable,
    Overloaded,
    Disconnected,
}

// An outbound peer has the address used to join it. A directly accepted peer
// has no trustworthy advertised endpoint. The optional endpoint keeps partial
// addresses unrepresentable instead of coupling two independent optionals.
export type ClusterNodeInfo = {
    name: string,
    endpoint: Endpoint?,
    framesSent: i64,
    framesReceived: i64,
    bytesSent: i64,
    bytesReceived: i64,
    sendErrors: i64,
    slowConsumerEvents: i64,
    rttMs: i64,
    outQueueBytes: i64,
    outQueueFrames: i64,
    slow: bool,
    phi: f64,
    missedHeartbeats: i64,
}

export type ClusterInfo = {
    self: string,
    port: i64,
    nodes: Array<ClusterNodeInfo>,
    listeners: i64,
    deadNodes: i64,
    heartbeatIntervalMs: i64,
    heartbeatTimeoutMs: i64,
    maxMissedHeartbeats: i64,
    tlsEnabled: bool,
}

export enum AddressError {
    MissingPort { address: string },
    InvalidHost { host: string },
    InvalidPort { port: string }
}

// ========== Naming rules ==========

// Byte-indexed on purpose. `s.runes().nth(i)` costs O(i), so the obvious
// rune loop would make every one of these rules quadratic in the length of a
// name that is checked on every join and every publish.
fn _asciiPrintable(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 0x20 || c > 0x7E) { return false }
    }
    return true
}

fn _asciiVisible(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 0x21 || c > 0x7E) { return false }
    }
    return true
}

fn _containsZeroByte(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    for (var i = 0; i < len(b); i++) {
        if (b[i] == 0) { return true }
    }
    return false
}

fn _fitsCString(s: string, maxBytes: i64, allowEmpty: bool) -> bool {
    const b: Slice<u8> = s.bytes()
    if ((!allowEmpty && len(b) == 0) || len(b) > maxBytes) { return false }
    return !_containsZeroByte(s)
}

fn _validName(s: string, maxLen: i64) -> bool {
    return len(s) > 0 && len(s) <= maxLen && _asciiPrintable(s)
}

export fn validNodeName(name: string) -> bool {
    return _validName(name, NODE_NAME_MAX)
}

export fn validCoroutineName(name: string) -> bool {
    return _validName(name, CORO_NAME_MAX)
}

// ========== Address grammar ==========

fn _parsePort(raw: string) -> i64 {
    const b: Slice<u8> = raw.bytes()
    if (len(b) == 0) { return 0 }
    var out = 0
    for (var i = 0; i < len(b); i++) {
        var c = b[i] as i64
        if (c < 48 || c > 57) { return 0 }
        out = out * 10 + (c - 48)
        if (out > 65535) { return 0 }
    }
    return out
}

fn _stripIpv6Brackets(host: string) -> string {
    if (len(host) >= 2 && host.runes().nth(0) == '[' && host.runes().nth(len(host) - 1) == ']') {
        return host.slice(1, len(host) - 1)
    }
    return host
}

// One address grammar for the whole language. Before this file owned it there
// were three: the VM split on the last colon and never stripped brackets, the
// AOT half stripped brackets but handed the port text straight to
// getaddrinfo(3), which resolves service names -- so "db:http" refused on one
// backend and connected to port 80 on the other.
export fn parseAddress(addr: string) -> Endpoint {
    var colon = addr.lastIndexOf(":")
    if (colon <= 0 || colon + 1 >= len(addr)) { throw AddressError.MissingPort { address: addr } }
    var rawHost = addr.slice(0, colon)
    var host = _stripIpv6Brackets(rawHost)
    if (!_fitsCString(host, ADDRESS_HOST_MAX_BYTES, false) ||
        (rawHost.indexOf(":") >= 0 && !rawHost.startsWith("["))) {
        throw AddressError.InvalidHost { host: rawHost }
    }
    var rawPort = addr.slice(colon + 1)
    var port = _parsePort(rawPort)
    if (port <= 0) { throw AddressError.InvalidPort { port: rawPort } }
    return Endpoint(host, port)
}

// ========== Topic language ==========

fn _hasEmptyTopicSegment(s: string) -> bool {
    const b: Slice<u8> = s.bytes()
    if (len(b) == 0) { return true }
    if (b[0] == 0x2E || b[len(b) - 1] == 0x2E) { return true }
    for (var i = 1; i < len(b); i++) {
        if (b[i] == 0x2E && b[i - 1] == 0x2E) { return true }
    }
    return false
}

export fn validTopicName(topic: string) -> bool {
    if (len(topic) == 0 || len(topic) > TOPIC_PATTERN_MAX || !_asciiVisible(topic) ||
        _hasEmptyTopicSegment(topic)) { return false }
    return topic.indexOf("*") < 0 && topic.indexOf(">") < 0
}

export fn validTopicPattern(pattern: string) -> bool {
    if (len(pattern) == 0 || len(pattern) > TOPIC_PATTERN_MAX || !_asciiVisible(pattern) ||
        _hasEmptyTopicSegment(pattern)) { return false }
    var parts = pattern.split(".")
    for (var i = 0; i < len(parts); i++) {
        var part = parts[i]
        if (part == ">") { return i == len(parts) - 1 }
        if (part == "*") { continue }
        if (part.indexOf("*") >= 0 || part.indexOf(">") >= 0) { return false }
    }
    return true
}

export fn topicMatches(pattern: string, topic: string) -> bool {
    if (!validTopicPattern(pattern) || !validTopicName(topic)) { return false }

    var p = pattern.split(".")
    var t = topic.split(".")
    var pi = 0
    var ti = 0
    while (pi < len(p)) {
        var part = p[pi]
        if (part == ">") {
            return ti < len(t)
        }
        if (ti >= len(t)) { return false }
        if (part != "*" && part != t[ti]) { return false }
        pi = pi + 1
        ti = ti + 1
    }
    return ti == len(t)
}

fn _registerTopicSubscription(pattern: string, capacity: i64) -> Channel<Buffer>? {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return null }
    var notifications = Channel<Buffer>(capacity)

    _lockTopicState()
    if (_runtimeActiveToken.load() != token) {
        _topicStateLock.store(false)
        notifications.close()
        return null
    }
    var subscription: _TopicSubscription = {
        runtimeToken: token,
        pattern: pattern,
        notifications: notifications,
    }
    _topicSubscriptions.push(subscription)
    _topicStateLock.store(false)
    return notifications
}

// Pruning and target retention share one critical section. The returned array
// owns independent shared Channel references, so delivery can wake consumers
// without holding the source registry lock.
fn _topicTargets(topic: string, token: i64,
                 full: ref i64, stopped: ref i64) -> Array<Channel<Buffer>> {
    var retained: Array<_TopicSubscription> = []
    var targets: Array<Channel<Buffer>> = []
    _lockTopicState()
    if (_runtimeActiveToken.load() != token) {
        _topicStateLock.store(false)
        return targets
    }
    for (var i = 0; i < len(_topicSubscriptions); i++) {
        var subscription = _topicSubscriptions[i]
        if (subscription.runtimeToken != token) {
            retained.push(subscription)
            continue
        }
        if (subscription.notifications.isClosed) {
            if (topicMatches(subscription.pattern, topic)) {
                stopped = stopped + 1
            }
            continue
        }
        retained.push(subscription)
        if (!topicMatches(subscription.pattern, topic)) { continue }
        if (len(targets) >= TOPIC_DELIVERY_FANOUT_MAX) {
            full = full + 1
            continue
        }
        targets.push(subscription.notifications)
    }
    _topicSubscriptions = retained
    _topicStateLock.store(false)
    return targets
}

fn _bufferFromBytes(source: Array<u8>) -> Buffer {
    var byteCount = len(source)
    var out = mem.alloc(byteCount)
    if (byteCount > 0) {
        unsafe {
            mem.withSliceMut<u8>(out.borrowPtr(), byteCount, ref out,
                fn(target: ref Slice<u8>) {
                    var bytes: Slice<u8> = source[:]
                    target.copyFrom(bytes)
                })
        }
    }
    return out
}

// Keep each moved Buffer inside one non-looping ownership frame. Every fanout
// target receives an independent allocation, while the caller retains only
// the scalar provider outcome across its loop back edge.
fn _offerTopic(target: Channel<Buffer>, envelope: Array<u8>) -> i64 {
    var payload = _bufferFromBytes(envelope)
    return match (target.trySend(move payload)) {
        SendResult.Sent -> 0
        SendResult.Closed -> 1
        SendResult.Full -> 2
        SendResult.Timeout -> 2
    }
}

fn _deliverTopicForRuntime(runtimeToken: i64, topic: string,
                           envelope: Array<u8>) -> _DeliveryStats? {
    if (runtimeToken == 0) { return null }
    var full = 0
    var stopped = 0
    var targets = _topicTargets(topic, runtimeToken, ref full, ref stopped)
    if (_runtimeActiveToken.load() != runtimeToken) { return null }

    var accepted = 0
    for (var i = 0; i < len(targets); i++) {
        var outcome = _offerTopic(targets[i], envelope)
        if (outcome == 0) { accepted = accepted + 1 }
        else if (outcome == 1) { stopped = stopped + 1 }
        else { full = full + 1 }
    }
    var stats: _DeliveryStats = {
        accepted: accepted,
        full: full,
        stopped: stopped,
    }
    if (_runtimeActiveToken.load() != runtimeToken) { return null }
    return stats
}

fn _topicListenerCount(token: i64) -> i64 {
    if (token == 0) { return -1 }
    var retained: Array<_TopicSubscription> = []
    var count = 0
    _lockTopicState()
    if (_runtimeActiveToken.load() != token) {
        _topicStateLock.store(false)
        return -1
    }
    for (var i = 0; i < len(_topicSubscriptions); i++) {
        var subscription = _topicSubscriptions[i]
        if (subscription.runtimeToken != token) {
            retained.push(subscription)
            continue
        }
        if (!subscription.notifications.isClosed) {
            retained.push(subscription)
            count = count + 1
        }
    }
    _topicSubscriptions = retained
    _topicStateLock.store(false)
    return count
}

// ========== Node identity and membership ==========

// Identity and authenticated membership live in the source directory. Public
// queries join it with generation-keyed raw transport counters and never expose
// reserved or departing entries.
export fn self() -> string {
    var state = _currentSourceStateSnapshot()
    return state == null ? "" : state!.selfName
}

fn _nodesForRuntime(runtimeToken: i64) -> Array<string>? {
    if (runtimeToken == 0 || _sourceStateSnapshot(runtimeToken) == null) { return null }
    var peers = _peerDirectorySnapshot(runtimeToken)
    if (_runtimeActiveToken.load() != runtimeToken) { return null }
    var names: Array<string> = []
    for (var i = 0; i < len(peers); i++) { names.push(peers[i].name) }
    return names
}

// A node that has not joined a cluster has no membership to report, which is a
// different answer from an empty cluster and is reported as one.
export fn nodes() -> Array<string>? {
    return _nodesForRuntime(_runtimeActiveToken.load())
}

export fn discover() -> bool {
    var runtimeToken = _runtimeActiveToken.load()
    if (runtimeToken == 0) { return false }
    var source = _sourceStateSnapshot(runtimeToken)
    if (source == null) { return false }
    var hash = discoveryClusterHash(source!.secret)
    var value: ClusterDiscoveryAnnouncement = {
        name: source!.selfName,
        port: source!.port,
        clusterHash: hash,
    }
    var announcement = encodeDiscoveryAnnouncement(value)
    if (announcement == null) { return false }

    var token = _discoveryNextToken.fetchAdd(1) + 1
    if (!_claimDiscovery(runtimeToken, token)) { return false }

    var socket: NetConn? = null
    try {
        socket = net.udpMulticastBind(DISCOVERY_MULTICAST_GROUP, DISCOVERY_MULTICAST_PORT,
                                      _DISCOVERY_MULTICAST_TTL, _DISCOVERY_LOOPBACK)
    } catch (e: NetError) {
        _releaseDiscovery(runtimeToken, token)
        return false
    }
    if (socket == null) {
        _releaseDiscovery(runtimeToken, token)
        return false
    }
    var live: NetConn = socket!
    socket = null
    if (!_installDiscoverySocket(runtimeToken, token, live)) {
        net.close(live)
        _releaseDiscovery(runtimeToken, token)
        return false
    }
    var wire: Array<u8> = announcement!
    announcement = null
    go _discoveryLoop(move live, source!.selfName, hash, move wire, runtimeToken, token)
    return true
}

export fn info() -> ClusterInfo? {
    var runtimeToken = _runtimeActiveToken.load()
    if (runtimeToken == 0) { return null }
    var maybeState = _sourceStateSnapshot(runtimeToken)
    if (maybeState == null) { return null }
    var raw = _peerTransportSnapshots(runtimeToken)
    if (raw == null || _runtimeActiveToken.load() != runtimeToken) { return null }
    var peers = _peerDirectorySnapshot(runtimeToken)
    if (_runtimeActiveToken.load() != runtimeToken) { return null }
    var state = maybeState!
    var nodes: Array<ClusterNodeInfo> = []
    var observedAtMs = time.monotonic()
    for (var i = 0; i < len(raw!); i++) {
        var node = raw![i]
        var metadata: _PeerDirectoryEntry? = null
        for (var j = 0; j < len(peers); j++) {
            if (peers[j].generation == node.peerGeneration) { metadata = peers[j] }
        }
        if (metadata == null) { continue }
        var detector = _phiPeerSnapshot(runtimeToken, node.peerGeneration)
        var sourceLastReceivedAtMs = detector.lastHeartbeatMs > 0
            ? detector.lastHeartbeatMs : detector.adoptedAtMs
        var synchronized = detector.recorded &&
                           sourceLastReceivedAtMs == node.lastReceivedAtMs
        var phi = synchronized
                    ? _phiValue(detector.samples, detector.mean, detector.variance,
                                detector.lastHeartbeatMs, observedAtMs)
                    : 0.0
        var publicNode: ClusterNodeInfo = {
            name: metadata!.name,
            endpoint: metadata!.endpoint,
            framesSent: node.framesSent,
            framesReceived: node.framesReceived,
            bytesSent: node.bytesSent,
            bytesReceived: node.bytesReceived,
            sendErrors: node.sendErrors,
            slowConsumerEvents: node.slowConsumerEvents,
            rttMs: node.rttMs,
            outQueueBytes: node.outQueueBytes,
            outQueueFrames: node.outQueueFrames,
            slow: node.slow,
            phi: phi,
            missedHeartbeats: synchronized ? detector.missedHeartbeats : 0,
        }
        nodes.push(publicNode)
    }
    var listenerCount = _topicListenerCount(runtimeToken)
    if (listenerCount < 0) { return null }
    var deadNodeCount = _recentDepartureCount(runtimeToken, observedAtMs)
    if (deadNodeCount < 0 || _runtimeActiveToken.load() != runtimeToken) { return null }
    var result: ClusterInfo = {
        self: state.selfName,
        port: state.port,
        nodes: nodes,
        listeners: listenerCount,
        deadNodes: deadNodeCount,
        heartbeatIntervalMs: state.heartbeatIntervalMs,
        heartbeatTimeoutMs: state.heartbeatTimeoutMs,
        maxMissedHeartbeats: state.maxMissedHeartbeats,
        tlsEnabled: state.tlsEnabled,
    }
    if (_runtimeActiveToken.load() != runtimeToken) { return null }
    return result
}

// The monitor channel carries the node or coroutine name that ended, and the
// termination reason for a remote coroutine; both are published as strings.
// Source registries own target validation and encoded control-frame dispatch,
// so the native boundary has no monitor or optional-argument policy.
export fn monitor(name: string, coroName: string? = null) -> Channel<string>? {
    var token = _runtimeActiveToken.load()
    if (token == 0) { return null }
    if (coroName == null) {
        if (name != "*" && !validNodeName(name)) { return null }
        var notifications = Channel<string>(NODE_MONITOR_CAPACITY)
        if (!_registerNodeMonitor(token, name, notifications)) {
            notifications.close()
            return null
        }
        return notifications
    }
    if (!validNodeName(name) || !validCoroutineName(coroName!)) { return null }
    var notifications = Channel<string>(COROUTINE_MONITOR_CAPACITY)
    var request = encodeCoroMonitor(coroName!)
    if (request == null) {
        notifications.close()
        return null
    }
    var registration = _registerRemoteMonitor(token, name, coroName!, notifications)
    if (registration == null) {
        notifications.close()
        return null
    }
    var peerGeneration = registration!.peerGeneration
    var admission = _enqueuePeerFrame(peerGeneration, request!)
    if (admission != _PEER_QUEUE_ACCEPTED) {
        if (admission == _PEER_QUEUE_FULL || admission == _PEER_QUEUE_INVALID) {
            _disconnectPeer(peerGeneration)
        }
        _unregisterRemoteMonitor(token, registration!.id)
        notifications.close()
        return null
    }
    return notifications
}

// ========== Lifecycle ==========

fn _clusterListener(port: i64) -> NetListener? {
    try {
        return net.listen(port, 128)
    } catch (e: NetError) {
        return null
    }
}

// A node whose name is not a legal node name cannot start. The listener, TLS
// contexts, transport state and long-lived loops are ordinary Xray values and
// coroutines. The generation transition is the single-winner admission point.
export fn start(config: ClusterConfig) -> bool {
    if (_currentSourceStateSnapshot() != null) { return false }
    if (!validNodeName(config.name)) { return false }
    if (config.port < 0 || config.port > 65535) { return false }
    var interval = config.heartbeatIntervalMs ?? HEARTBEAT_INTERVAL_MS
    var timeout = config.heartbeatTimeoutMs ?? HEARTBEAT_TIMEOUT_MS
    var missed = config.maxMissedHeartbeats ?? MAX_MISSED_HEARTBEATS
    // A schedule that cannot detect anything is a configuration mistake, not a
    // tuning choice: a detector needs at least one interval to elapse before it
    // may call a peer late, and at least one missed beat before it kills it.
    if (interval <= 0 || timeout < interval || missed <= 0) { return false }
    var tick = heartbeatTickInterval(interval)
    var secret = config.secret ?? ""
    if (!_fitsCString(secret, SHARED_SECRET_MAX_BYTES, true)) { return false }
    var tlsEnabled = false
    var caFile = ""
    var certFile = ""
    var keyFile = ""
    var insecure = false
    if (config.tls != null) {
        var tls = config.tls!
        tlsEnabled = tls.enabled
        caFile = tls.caFile ?? ""
        certFile = tls.certFile ?? ""
        keyFile = tls.keyFile ?? ""
        insecure = tls.insecure
        if (_containsZeroByte(caFile) || _containsZeroByte(certFile) ||
            _containsZeroByte(keyFile)) {
            return false
        }
        if ((len(certFile) == 0) != (len(keyFile) == 0)) { return false }
        if (tlsEnabled && len(certFile) == 0) { return false }
    }

    var runtimeToken = _runtimeNextToken.fetchAdd(1) + 1
    if (runtimeToken <= 0) { return false }
    var tlsResources: _ClusterTlsResources? = null
    if (tlsEnabled) {
        try {
            var client = TlsClientContext.create(caFile, certFile, keyFile, !insecure)
            var server = TlsServerContext.create(
                certFile, keyFile, caFile, !insecure)
            tlsResources = {
                runtimeToken: runtimeToken,
                client: client,
                server: server,
            }
        } catch (e: NetError) {
            return false
        }
    }

    var listener = _clusterListener(config.port)
    if (listener == null) { return false }
    var port = net.port(listener!)
    if (port <= 0 || port > 65535) {
        net.close(listener!)
        return false
    }
    var state: _ClusterSourceState = {
        runtimeToken: runtimeToken,
        selfName: config.name,
        port: port,
        secret: secret,
        heartbeatIntervalMs: interval,
        heartbeatTimeoutMs: timeout,
        maxMissedHeartbeats: missed,
        tlsEnabled: tlsEnabled,
    }
    return _activateClusterSource(state, tlsResources, tick, move listener)
}

// The address is parsed here and the generic network API receives a host and a
// port, so the grammar has one owner. A malformed address raises AddressError
// rather than answering false: "you spelled the address wrong" and "the peer
// did not answer" are different facts.
export fn join(addr: string) -> bool {
    var parsed = parseAddress(addr)
    return _joinPeer(parsed.host, parsed.port)
}

export fn stop() {
    var retiredToken = _retireCurrentRuntimeGeneration()
    if (retiredToken != 0) { _stopDiscovery(retiredToken) }
    if (retiredToken != 0) { _closeSourceListener(retiredToken) }
    if (retiredToken != 0) { _closeTopicSubscriptions(retiredToken) }
    if (retiredToken != 0) { _clearPhiPeerStates(retiredToken) }
    if (retiredToken != 0) { _stopPeerTransports(retiredToken) }
    if (retiredToken != 0) { _clearSourceState(retiredToken) }
}

// ========== Publish and subscribe ==========

// A pattern that is not a legal topic pattern, or a capacity outside what a
// bounded channel can hold, has no subscription to create. Both were checked
// three times before -- twice in the VM path, once in the AOT one -- and are
// checked once here.
export fn listen(pattern: string, capacity: i64 = 1024) -> Channel<Buffer>? {
    if (!validTopicPattern(pattern)) { return null }
    if (capacity <= 0 || capacity > SUBSCRIPTION_CAPACITY_MAX) { return null }
    return _registerTopicSubscription(pattern, capacity)
}

// The source peer queue and generic Channel operations report raw admission
// outcomes. This source policy is shared by local and remote publication.
fn _deliveryFromStats(stats: _DeliveryStats?) -> ClusterDelivery {
    if (stats == null) { return ClusterDelivery.Unavailable }
    var observed = stats!
    if (observed.accepted > 0) { return ClusterDelivery.Accepted }
    if (observed.full > 0) { return ClusterDelivery.Overloaded }
    if (observed.stopped > 0) { return ClusterDelivery.Disconnected }
    return ClusterDelivery.Disconnected
}

// One publication has two independent destinations. Success wins because at
// least one subscriber accepted the envelope; overload wins over a completely
// disconnected route, and caller errors remain errors even if another route
// could not observe them.
fn _combinePublicationDelivery(local: ClusterDelivery,
                               remote: ClusterDelivery) -> ClusterDelivery {
    if (local == ClusterDelivery.InvalidTopic || remote == ClusterDelivery.InvalidTopic) {
        return ClusterDelivery.InvalidTopic
    }
    if (local == ClusterDelivery.InvalidEnvelope || remote == ClusterDelivery.InvalidEnvelope) {
        return ClusterDelivery.InvalidEnvelope
    }
    if (local == ClusterDelivery.Accepted || remote == ClusterDelivery.Accepted) {
        return ClusterDelivery.Accepted
    }
    if (local == ClusterDelivery.Overloaded || remote == ClusterDelivery.Overloaded) {
        return ClusterDelivery.Overloaded
    }
    if (local == ClusterDelivery.Unavailable || remote == ClusterDelivery.Unavailable) {
        return ClusterDelivery.Unavailable
    }
    return ClusterDelivery.Disconnected
}

export fn send(topic: string, envelope: move Buffer,
               hopLimit: i64 = TOPIC_DEFAULT_HOP_LIMIT) -> ClusterDelivery {
    if (!validTopicName(topic)) { return ClusterDelivery.InvalidTopic }
    if (hopLimit < 0 || hopLimit > TOPIC_MAX_HOP_LIMIT) { return ClusterDelivery.InvalidTopic }
    var envelopeBytes = _materializeBuffer(envelope)
    if (len(envelopeBytes) < ENVELOPE_HEADER_SIZE) {
        return ClusterDelivery.InvalidEnvelope
    }
    var runtimeToken = _runtimeActiveToken.load()
    if (runtimeToken == 0) { return ClusterDelivery.Unavailable }
    var remoteWire = encodeTransportFrame(hopLimit, topic, envelopeBytes)
    var local = _deliveryFromStats(
        _deliverTopicForRuntime(runtimeToken, topic, envelopeBytes))
    var remote = remoteWire == null ? ClusterDelivery.InvalidEnvelope
                                    : _deliveryFromStats(
                                        _broadcastPeersForRuntime(runtimeToken, 0, remoteWire!))
    return _combinePublicationDelivery(local, remote)
}
