// cluster - pure-Xray cluster protocol helpers.
//
// Node lifecycle, sockets, TLS, opaque envelope transport, and frame I/O remain
// native runtime boundaries. Protocol constants, naming rules, address parsing,
// and topic-pattern matching live here so the cluster control-plane rules have a
// visible Xray semantic source.

// Node identity, membership and discovery are published by the Xray surface
// over private runtime leaves; the leaves carry no cluster policy.
export fn self() -> string { return __self() }
export fn nodes() -> Array<string> { return __nodes() }
export fn discover() { __discover() }

export const HANDSHAKE_VERSION = 6
export const TOPIC_DEFAULT_HOP_LIMIT = 3
export const NODE_NAME_MAX = 63
export const TOPIC_PATTERN_MAX = 127

export type ClusterTlsOptions = {
    enabled: bool,
    caFile: string?,
    certFile: string?,
    keyFile: string?,
    insecure: bool,
}

export type ClusterConfig = {
    name: string,
    port: i64,
    secret: string?,
    tls: ClusterTlsOptions?,
}

export enum AddressError {
    MissingPort(string),
    InvalidHost(string),
    InvalidPort(string)
}

export class NodeAddress {
    host: string
    port: i64

    constructor(host: string, port: i64) {
        this.host = host
        this.port = port
    }
}

fn _asciiPrintable(s: string) -> bool {
    for (var i = 0; i < len(s); i++) {
        var c = s.runes().nth(i).toUInt32()
        if (c < 0x20 || c > 0x7E) { return false }
    }
    return true
}

fn _validName(s: string, maxLen: i64) -> bool {
    return len(s) > 0 && len(s) <= maxLen && _asciiPrintable(s)
}

export fn validNodeName(name: string) -> bool {
    return _validName(name, NODE_NAME_MAX)
}

fn _parsePort(raw: string) -> i64 {
    if (len(raw) == 0) { return 0 }
    var out = 0
    for (var i = 0; i < len(raw); i++) {
        var c = raw.runes().nth(i).toUInt32()
        if (c < 48 || c > 57) { return 0 }
        out = out * 10 + ((c - 48) as i64)
        if (out > 65535) { return 0 }
    }
    return out
}

fn _stripIpv6Brackets(host: string) -> string {
    if (len(host) >= 2 && host.runes().nth(0) == '[' && host.runes().nth(len(host) - 1) == ']') {
        return host.slice(1, len(host) - 1)
    }
    return host
}

export fn parseAddress(addr: string) -> NodeAddress {
    var colon = addr.lastIndexOf(":")
    if (colon <= 0 || colon + 1 >= len(addr)) { throw AddressError.MissingPort(addr) }
    var rawHost = addr.slice(0, colon)
    var host = _stripIpv6Brackets(rawHost)
    if (len(host) == 0 || (rawHost.indexOf(":") >= 0 && !rawHost.startsWith("["))) {
        throw AddressError.InvalidHost(rawHost)
    }
    var rawPort = addr.slice(colon + 1)
    var port = _parsePort(rawPort)
    if (port <= 0) { throw AddressError.InvalidPort(rawPort) }
    return NodeAddress(host, port)
}

fn _hasEmptyTopicSegment(s: string) -> bool {
    if (len(s) == 0) { return true }
    if (s.runes().nth(0) == '.' || s.runes().nth(len(s) - 1) == '.') { return true }
    for (var i = 1; i < len(s); i++) {
        if (s.runes().nth(i) == '.' && s.runes().nth(i - 1) == '.') { return true }
    }
    return false
}

export fn validTopicName(topic: string) -> bool {
    if (len(topic) > TOPIC_PATTERN_MAX || _hasEmptyTopicSegment(topic)) { return false }
    return topic.indexOf("*") < 0 && topic.indexOf(">") < 0
}

export fn validTopicPattern(pattern: string) -> bool {
    if (len(pattern) > TOPIC_PATTERN_MAX || _hasEmptyTopicSegment(pattern)) { return false }
    var parts = pattern.split(".")
    for (var i = 0; i < len(parts); i++) {
        var part = parts[i]
        if (part == ">") { return i == len(parts) - 1 }
        if (part == "*") { continue }
        if (part.indexOf("*") >= 0 || part.indexOf(">") >= 0) { return false }
    }
    return true
}

export fn topicMatches(pattern: string, topic: string) -> bool {
    if (!validTopicPattern(pattern) || !validTopicName(topic)) { return false }

    var p = pattern.split(".")
    var t = topic.split(".")
    var pi = 0
    var ti = 0
    while (pi < len(p)) {
        var part = p[pi]
        if (part == ">") {
            return ti < len(t)
        }
        if (ti >= len(t)) { return false }
        if (part != "*" && part != t[ti]) { return false }
        pi = pi + 1
        ti = ti + 1
    }
    return ti == len(t)
}

export fn start(config: ClusterConfig) -> bool {
    var secret = config.secret ?? ""
    if (config.tls == null) {
        return __start(config.name, config.port, secret, false, "", "", "", false)
    }
    var tls = config.tls!
    return __start(
        config.name,
        config.port,
        secret,
        tls.enabled,
        tls.caFile ?? "",
        tls.certFile ?? "",
        tls.keyFile ?? "",
        tls.insecure
    )
}

export fn join(addr: string) -> bool { return __join(addr) }

export fn stop() { __stop() }

export fn listen(pattern: string, capacity: i64 = 1024) -> Channel<Buffer>? {
    return __listen(pattern, capacity)
}
