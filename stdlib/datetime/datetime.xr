// datetime - pure-Xray DateTime calendar algorithms.
//
// The platform-dependent shell is deliberately tiny and lives in `time`:
// `time.now()`, `time.localOffset()`, and `time.localOffsetAt(ts)`.
// Construction, civil calendar conversion, parsing, formatting, arithmetic,
// and comparison are ordinary Xray code so VM and AOT share one semantic source.

import time

const SECONDS_PER_DAY = 86400

class DateTimeParts {
    year: i64
    month: i64
    day: i64
    hour: i64
    minute: i64
    second: i64
    weekday: i64
    yearday: i64

    constructor(
        year: i64,
        month: i64,
        day: i64,
        hour: i64,
        minute: i64,
        second: i64,
        weekday: i64,
        yearday: i64
    ) {
        this.year = year
        this.month = month
        this.day = day
        this.hour = hour
        this.minute = minute
        this.second = second
        this.weekday = weekday
        this.yearday = yearday
    }
}

export class DateTime {
    _timestamp: i64
    _millisecond: i64
    _tzOffset: i64
    _isUtc: bool
    _year: i64
    _month: i64
    _day: i64
    _hour: i64
    _minute: i64
    _second: i64
    _weekday: i64
    _yearday: i64

    constructor(timestamp: i64, millisecond: i64 = 0, tzOffset: i64 = 0, isUtc: bool = true) {
        this._timestamp = timestamp
        this._millisecond = millisecond
        this._tzOffset = tzOffset
        this._isUtc = isUtc

        var p = _partsFromRaw(timestamp, tzOffset, isUtc)
        this._year = p.year
        this._month = p.month
        this._day = p.day
        this._hour = p.hour
        this._minute = p.minute
        this._second = p.second
        this._weekday = p.weekday
        this._yearday = p.yearday
    }

    timestamp: i64 { fn() { return this._timestamp } }
    millisecond: i64 { fn() { return this._millisecond } }
    tzOffset: i64 { fn() { return this._tzOffset } }
    isUtc: bool { fn() { return this._isUtc } }
    year: i64 { fn() { return this._year } }
    month: i64 { fn() { return this._month } }
    day: i64 { fn() { return this._day } }
    hour: i64 { fn() { return this._hour } }
    minute: i64 { fn() { return this._minute } }
    second: i64 { fn() { return this._second } }
    weekday: i64 { fn() { return this._weekday } }
    yearday: i64 { fn() { return this._yearday } }

    toString() -> string {
        return this.format("YYYY-MM-DD HH:mm:ss")
    }

    format(pattern: string = "YYYY-MM-DD HH:mm:ss") -> string {
        var out = ""
        var i = 0
        while (i < len(pattern)) {
            if (i + 4 <= len(pattern) && pattern.slice(i, i + 4) == "YYYY") {
                out = out + _pad(this._year, 4)
                i = i + 4
            } else if (i + 3 <= len(pattern) && pattern.slice(i, i + 3) == "SSS") {
                out = out + _pad(this._millisecond, 3)
                i = i + 3
            } else if (i + 2 <= len(pattern) && pattern.slice(i, i + 2) == "MM") {
                out = out + _pad(this._month, 2)
                i = i + 2
            } else if (i + 2 <= len(pattern) && pattern.slice(i, i + 2) == "DD") {
                out = out + _pad(this._day, 2)
                i = i + 2
            } else if (i + 2 <= len(pattern) && pattern.slice(i, i + 2) == "HH") {
                out = out + _pad(this._hour, 2)
                i = i + 2
            } else if (i + 2 <= len(pattern) && pattern.slice(i, i + 2) == "mm") {
                out = out + _pad(this._minute, 2)
                i = i + 2
            } else if (i + 2 <= len(pattern) && pattern.slice(i, i + 2) == "ss") {
                out = out + _pad(this._second, 2)
                i = i + 2
            } else {
                out = out + pattern.runes().nth(i).toString()
                i = i + 1
            }
        }
        return out
    }

    toISOString() -> string {
        var base = _pad(this._year, 4) + "-" + _pad(this._month, 2) + "-" +
                   _pad(this._day, 2) + "T" + _pad(this._hour, 2) + ":" +
                   _pad(this._minute, 2) + ":" + _pad(this._second, 2) + "." +
                   _pad(this._millisecond, 3)
        if (this._isUtc) {
            return base + "Z"
        }
        var off = this._tzOffset
        var sign = "+"
        if (off < 0) {
            sign = "-"
            off = -off
        }
        return base + sign + _pad(off / 60, 2) + ":" + _pad(off % 60, 2)
    }

    add(amount: i64, unit: string) -> DateTime {
        if (unit == "millisecond" || unit == "milliseconds") {
            return _fromTotalMilliseconds(this._timestamp * 1000 + this._millisecond + amount,
                                          this._tzOffset, this._isUtc)
        }
        if (unit == "second" || unit == "seconds") {
            return DateTime(this._timestamp + amount, this._millisecond, this._tzOffset,
                            this._isUtc)
        }
        if (unit == "minute" || unit == "minutes") {
            return DateTime(this._timestamp + amount * 60, this._millisecond, this._tzOffset,
                            this._isUtc)
        }
        if (unit == "hour" || unit == "hours") {
            return DateTime(this._timestamp + amount * 3600, this._millisecond, this._tzOffset,
                            this._isUtc)
        }
        if (unit == "day" || unit == "days") {
            return DateTime(this._timestamp + amount * SECONDS_PER_DAY, this._millisecond,
                            this._tzOffset, this._isUtc)
        }
        if (unit == "week" || unit == "weeks") {
            return DateTime(this._timestamp + amount * 7 * SECONDS_PER_DAY, this._millisecond,
                            this._tzOffset, this._isUtc)
        }
        if (unit == "month" || unit == "months") {
            var totalMonths = this._year * 12 + (this._month - 1) + amount
            var year = _floorDiv(totalMonths, 12)
            var month0 = _floorMod(totalMonths, 12)
            var day = this._day
            var maxDay = _daysInMonth(year, month0 + 1)
            if (day > maxDay) { day = maxDay }
            return _createWithZone(year, month0 + 1, day, this._hour, this._minute, this._second,
                                   this._millisecond, this._tzOffset, this._isUtc)
        }
        if (unit == "year" || unit == "years") {
            var year = this._year + amount
            var day = this._day
            var maxDay = _daysInMonth(year, this._month)
            if (day > maxDay) { day = maxDay }
            return _createWithZone(year, this._month, day, this._hour, this._minute, this._second,
                                   this._millisecond, this._tzOffset, this._isUtc)
        }
        return DateTime(this._timestamp + amount, this._millisecond, this._tzOffset, this._isUtc)
    }

    diff(other: DateTime, unit: string = "seconds") -> i64 {
        var diffMs = (this._timestamp - other._timestamp) * 1000 +
                     (this._millisecond - other._millisecond)
        if (unit == "millisecond" || unit == "milliseconds") { return diffMs }
        if (unit == "minute" || unit == "minutes") { return diffMs / 60000 }
        if (unit == "hour" || unit == "hours") { return diffMs / 3600000 }
        if (unit == "day" || unit == "days") { return diffMs / 86400000 }
        if (unit == "week" || unit == "weeks") { return diffMs / 604800000 }
        return diffMs / 1000
    }

    toUTC() -> DateTime {
        return DateTime(this._timestamp, this._millisecond, 0, true)
    }

    toLocal() -> DateTime {
        return DateTime(this._timestamp, this._millisecond, time.localOffsetAt(this._timestamp),
                        false)
    }

    isBefore(other: DateTime) -> bool {
        return this._timestamp < other._timestamp ||
               (this._timestamp == other._timestamp && this._millisecond < other._millisecond)
    }

    isAfter(other: DateTime) -> bool {
        return this._timestamp > other._timestamp ||
               (this._timestamp == other._timestamp && this._millisecond > other._millisecond)
    }

    equals(other: DateTime) -> bool {
        return this._timestamp == other._timestamp && this._millisecond == other._millisecond
    }

    isLeapYear() -> bool {
        return _isLeapYear(this._year)
    }

    daysInMonth() -> i64 {
        return _daysInMonth(this._year, this._month)
    }
}

export fn now() -> DateTime {
    return fromTimestampMs(time.now()).toLocal()
}

export fn utc() -> DateTime {
    return fromTimestampMs(time.now())
}

export fn create(year: i64, month: i64 = 1, day: i64 = 1, hour: i64 = 0, minute: i64 = 0,
          second: i64 = 0) -> DateTime {
    var wall = _timeFromCivil(year, month, day, hour, minute, second)
    var off = time.localOffsetAt(wall)
    return DateTime(wall - off * 60, 0, off, false)
}

export fn createUTC(year: i64, month: i64 = 1, day: i64 = 1, hour: i64 = 0, minute: i64 = 0,
             second: i64 = 0) -> DateTime {
    return DateTime(_timeFromCivil(year, month, day, hour, minute, second), 0, 0, true)
}

export fn fromTimestamp(ts: i64) -> DateTime {
    return DateTime(ts, 0, 0, true)
}

export fn fromTimestampMs(ts: i64) -> DateTime {
    return _fromTotalMilliseconds(ts, 0, true)
}

export fn parse(s: string, format: string = "ISO8601") -> DateTime? {
    var year = 0
    var month = 1
    var day = 1
    var hour = 0
    var minute = 0
    var second = 0
    var ms = 0
    var timeStart = -1

    if (format == "time") {
        var tp = _parseTimeAt(s, 0)
        if (tp == null) { return null }
        hour = tp!.hour
        minute = tp!.minute
        second = tp!.second
        year = 1970
        month = 1
        day = 1
        timeStart = 0
    } else {
        var sep: rune = '-'
        if (s.contains("/")) { sep = '/' }
        var d = _parseDateAt(s, 0, sep)
        if (d == null) { return null }
        year = d!.year
        month = d!.month
        day = d!.day

        if (format != "date") {
            var tIndex = _findTimeSeparator(s)
            if (tIndex >= 0) {
                timeStart = tIndex + 1
                var tp = _parseTimeAt(s, timeStart)
                if (tp == null) { return null }
                hour = tp!.hour
                minute = tp!.minute
                second = tp!.second
                ms = _parseMilliseconds(s, timeStart)
            }
        }
    }

    var isUtc = false
    var tzOff = 0
    if (timeStart >= 0) {
        var z = _findTimezoneStart(s, timeStart)
        if (z >= 0) {
            if (s.runes().nth(z) == 'Z') {
                isUtc = true
            } else {
                var parsedOff = _parseTimezoneOffset(s, z)
                if (parsedOff == null) { return null }
                tzOff = parsedOff!
                isUtc = true
            }
        }
    }

    var t = _timeFromCivil(year, month, day, hour, minute, second)
    if (isUtc) {
        t = t - tzOff * 60
        return DateTime(t, ms, 0, true)
    }
    var off = time.localOffsetAt(t)
    return DateTime(t - off * 60, ms, off, false)
}

export fn offset() -> i64 {
    return time.localOffset()
}

fn _isLeapYear(year: i64) -> bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn _daysInMonth(year: i64, month: i64) -> i64 {
    if (month == 1) { return 31 }
    if (month == 2) {
        if (_isLeapYear(year)) { return 29 }
        return 28
    }
    if (month == 3) { return 31 }
    if (month == 4) { return 30 }
    if (month == 5) { return 31 }
    if (month == 6) { return 30 }
    if (month == 7) { return 31 }
    if (month == 8) { return 31 }
    if (month == 9) { return 30 }
    if (month == 10) { return 31 }
    if (month == 11) { return 30 }
    if (month == 12) { return 31 }
    return 30
}

fn _floorDiv(a: i64, b: i64) -> i64 {
    var q = a / b
    var r = a % b
    if (r < 0) { q = q - 1 }
    return q
}

fn _floorMod(a: i64, b: i64) -> i64 {
    var r = a % b
    if (r < 0) { return r + b }
    return r
}

fn _daysFromCivil(year: i64, month: i64, day: i64) -> i64 {
    var y = year
    if (month <= 2) { y = y - 1 }
    var era = _floorDiv(y, 400)
    var yoe = y - era * 400
    var mp = month + 9
    if (month > 2) { mp = month - 3 }
    var doy = (153 * mp + 2) / 5 + day - 1
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn _civilFromDays(zRaw: i64) -> DateTimeParts {
    var z = zRaw + 719468
    var era = _floorDiv(z, 146097)
    var doe = z - era * 146097
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    var mp = (5 * doy + 2) / 153
    var d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if (mp >= 10) { m = mp - 9 }
    if (m <= 2) { y = y + 1 }

    var w = _floorMod(zRaw + 4, 7)
    var jan1 = _daysFromCivil(y, 1, 1)
    var yd = zRaw - jan1 + 1
    return DateTimeParts(y, m, d, 0, 0, 0, w, yd)
}

fn _timeFromCivil(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> i64 {
    return _daysFromCivil(year, month, day) * SECONDS_PER_DAY + hour * 3600 + minute * 60 +
           second
}

fn _partsFromRaw(timestamp: i64, tzOffset: i64, isUtc: bool) -> DateTimeParts {
    var t = timestamp
    if (!isUtc) { t = t + tzOffset * 60 }
    var days = _floorDiv(t, SECONDS_PER_DAY)
    var secDay = _floorMod(t, SECONDS_PER_DAY)
    var p = _civilFromDays(days)
    p.hour = secDay / 3600
    p.minute = (secDay % 3600) / 60
    p.second = secDay % 60
    return p
}

fn _createWithZone(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64,
                   millisecond: i64, tzOffset: i64, isUtc: bool) -> DateTime {
    var wall = _timeFromCivil(year, month, day, hour, minute, second)
    if (isUtc) {
        return DateTime(wall, millisecond, 0, true)
    }
    return DateTime(wall - tzOffset * 60, millisecond, tzOffset, false)
}

fn _fromTotalMilliseconds(totalMs: i64, tzOffset: i64, isUtc: bool) -> DateTime {
    var sec = _floorDiv(totalMs, 1000)
    var ms = _floorMod(totalMs, 1000)
    return DateTime(sec, ms, tzOffset, isUtc)
}

fn _pad(value: i64, width: i64) -> string {
    var v = value
    var sign = ""
    if (v < 0) {
        sign = "-"
        v = -v
    }
    var s = v.toString()
    while (len(s) < width) {
        s = "0" + s
    }
    return sign + s
}

fn _parseNDigits(s: string, start: i64, count: i64) -> i64? {
    if (start < 0 || start + count > len(s)) { return null }
    var out = 0
    for (var i = 0; i < count; i++) {
        var c = s.runes().nth(start + i).toUInt32()
        if (c < 48 || c > 57) { return null }
        out = out * 10 + ((c - 48) as i64)
    }
    return out
}

fn _parseDateAt(s: string, start: i64, sep: rune) -> DateTimeParts? {
    var y = _parseNDigits(s, start, 4)
    if (y == null) { return null }
    if (start + 4 >= len(s) || s.runes().nth(start + 4) != sep) { return null }
    var m = _parseNDigits(s, start + 5, 2)
    if (m == null) { return null }
    if (start + 7 >= len(s) || s.runes().nth(start + 7) != sep) { return null }
    var d = _parseNDigits(s, start + 8, 2)
    if (d == null) { return null }
    return DateTimeParts(y!, m!, d!, 0, 0, 0, 0, 0)
}

fn _parseTimeAt(s: string, start: i64) -> DateTimeParts? {
    var h = _parseNDigits(s, start, 2)
    if (h == null) { return null }
    if (start + 2 >= len(s) || s.runes().nth(start + 2) != ':') { return null }
    var m = _parseNDigits(s, start + 3, 2)
    if (m == null) { return null }
    var sec = 0
    if (start + 5 < len(s) && s.runes().nth(start + 5) == ':') {
        var s2 = _parseNDigits(s, start + 6, 2)
        if (s2 == null) { return null }
        sec = s2!
    }
    return DateTimeParts(1970, 1, 1, h!, m!, sec, 0, 0)
}

fn _parseMilliseconds(s: string, timeStart: i64) -> i64 {
    var dot = -1
    var i = timeStart
    while (i < len(s)) {
        var ch = s.runes().nth(i)
        if (ch == '.') {
            dot = i
            break
        }
        if (ch == 'Z' || ch == '+' || ch == '-') { break }
        i = i + 1
    }
    if (dot < 0 || dot + 1 >= len(s)) { return 0 }
    var ms = 0
    var digits = 0
    var p = dot + 1
    while (p < len(s) && digits < 3) {
        var c = s.runes().nth(p).toUInt32()
        if (c < 48 || c > 57) { break }
        ms = ms * 10 + ((c - 48) as i64)
        digits = digits + 1
        p = p + 1
    }
    while (digits < 3) {
        ms = ms * 10
        digits = digits + 1
    }
    return ms
}

fn _findTimeSeparator(s: string) -> i64 {
    for (var i = 0; i < len(s); i++) {
        var ch = s.runes().nth(i)
        if (ch == 'T' || ch == ' ') { return i }
    }
    return -1
}

fn _findTimezoneStart(s: string, start: i64) -> i64 {
    for (var i = start; i < len(s); i++) {
        var ch = s.runes().nth(i)
        if (ch == 'Z' || ch == '+' || ch == '-') { return i }
    }
    return -1
}

fn _parseTimezoneOffset(s: string, start: i64) -> i64? {
    if (start >= len(s)) { return null }
    var sign = 1
    if (s.runes().nth(start) == '-') { sign = -1 }
    var h = _parseNDigits(s, start + 1, 2)
    if (h == null) { return null }
    var m = 0
    if (start + 3 < len(s) && s.runes().nth(start + 3) == ':') {
        var mm = _parseNDigits(s, start + 4, 2)
        if (mm == null) { return null }
        m = mm!
    }
    return sign * (h! * 60 + m)
}
