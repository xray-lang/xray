# Author: xingleixu@gmail.com
# Xray Project .gitignore

# ============================================================================
# Build directories
# ============================================================================
build/
build-*/
build_*/
cmake-build-*/

# Local-only helper / scratch files. These typically embed absolute
# paths from a contributor's machine (Desktop, vcvarsall, etc.) and
# must never be shared via git.
_build_*.bat
_jit_*.bat
_commit_msg.*
/.tmp_*
/tmp_probe_*
*.tmp
__pycache__/
*.py[cod]

# ============================================================================
# Build artifacts
# ============================================================================
*.o
*.a
*.so
*.dylib
*.dll
*.exe
/xray
a.out
luac.out

# ============================================================================
# IDE / Editor
# ============================================================================
.vscode/
.idea/
.crossnote/
.cursor/
!.cursor/cli.json
.windsurf/
.devin/
.kiro/
.github/copilot-instructions.md
*.swp
*.swo
*~
.DS_Store
.instructions.md

# ============================================================================
# Debug files
# ============================================================================
*.dSYM/
/core
vgcore.*
server_err.txt
tcp_err.txt
osr_debug.log
bin/

# ============================================================================
# Internal design docs (migrated to separate xray-docs repo)
# ============================================================================
# docs/ is a symlink to ../xray-docs (separate git repo for dev documents).
docs

# ============================================================================
# CTest output
# ============================================================================
Testing/

# ============================================================================
# Temporary test files
# ============================================================================
tests/tmp/*
!tests/tmp/.gitkeep

# ============================================================================
# Fuzz corpus
# ============================================================================
# Keep curated, extension-bearing seed files in Git. libFuzzer-generated
# hash-named corpus entries remain local.
tests/fuzz/corpus/**
!tests/fuzz/corpus/**/
!tests/fuzz/corpus/**/*.xr
!tests/fuzz/corpus/stdlib_data/*.txt
!tests/fuzz/corpus/stdlib_data/*.toml
!tests/fuzz/corpus/stdlib_data/*.xml
!tests/fuzz/corpus/stdlib_data/*.yaml

# ============================================================================
# Go compiled binaries
# ============================================================================
*_go
tests/network/ws_tests/autobahn/reports/

# ============================================================================
# Editor / IDE checkpoints
# ============================================================================
.windsurf-backup/

# ============================================================================
# AOT scratch output
# ============================================================================
# `xray build --native` writes the generated C alongside the .xr source by
# default; ignore the common scratch name so it doesn't pollute git status.
/app.c
.xray-cache/
.xray-test-cache/

# ============================================================================
# Compiled bytecode bundles
# ============================================================================
# `.xrc` files are produced by the bytecode compiler / AOT runner as a
# scratch cache next to the source `.xr`. They are build artifacts and
# must never be committed.
*.xrc
