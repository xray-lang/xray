+static void xrl_diagnostic_restore(XrlDiagnosticOwnerHold *hold, size_t predecessor) {
+    if (!hold->owner) return;
+    XrtManagedHeader **anchor = (XrtManagedHeader **)((unsigned char *)hold->payload + 40);
+    XrtManagedHeader **source = (XrtManagedHeader **)((unsigned char *)hold->payload + predecessor);
+    if (*anchor != hold->owner || (source != anchor && *source)) {
+#ifdef XRL_VERIFY_HOLD_OWNER
+        (void)fprintf(stderr, "hold-owner restoration rejected at predecessor offset %zu\n", predecessor);
+#endif
+        xrt_native_managed_failure(XRT_MANAGED_ARGUMENT, 0);
+        return;
+    }
+    if (source != anchor) {
+        *source = *anchor;
+        *anchor = NULL;
+    }
+    hold->owner = NULL;
+}
+
+static void xrl_diagnostic_try_hold(XrlDiagnosticOwnerHold *hold,
+        const XrtManagedFrameLocations *locations, XrtManagedFrame *frame, void *payload) {
+    if (!xrl_diagnostic_hold_requested || hold->considered) return;
+    hold->considered = 1;
+#ifdef XRL_VERIFY_HOLD_OWNER
+    ++xrl_hold_witness.arm_attempts;
+#endif
+    if (!frame || !payload || locations->frame != frame || locations->payload != payload ||
+            !locations->slots || !locations->busy || locations->slot_count != 46 ||
+            *locations->busy) return;
+
+    static const struct { size_t slot; size_t offset; } empty[] = {
+        {3, 24}, {4, 32}, {6, 48}, {12, 96}, {14, 112},
+        {28, 224}, {29, 232}, {30, 240}, {34, 272}, {40, 320}, {43, 344},
+    };
+    for (size_t i = 0; i < sizeof(empty) / sizeof(empty[0]); ++i) {
+        const size_t slot = empty[i].slot;
+        const size_t offset = empty[i].offset;
+        if (locations->slots[slot].owner_offset != offset ||
+                locations->slots[slot].pending.value ||
+                locations->slots[slot].pending.allocation_bytes ||
+                *(XrtManagedHeader **)((unsigned char *)payload + offset)) return;
+    }
+    if (locations->slots[5].owner_offset != 40 || locations->slots[5].pending.value ||
+            locations->slots[5].pending.allocation_bytes) return;
+    hold->payload = payload;
+    hold->owner = *(XrtManagedHeader **)((unsigned char *)payload + 40);
+#ifdef XRL_VERIFY_HOLD_OWNER
+    if (hold->owner) ++xrl_hold_witness.arm_successes;
+#endif
+}
