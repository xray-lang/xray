+/* Artifact-only experiment. Slot 5 holds the only real ownership reference
+ * between the six verified owner-only edges. The pointer below tracks identity. */
+typedef struct XrlDiagnosticOwnerHold {
+    void *payload;
+    XrtManagedHeader *owner;
+    _Bool considered;
+} XrlDiagnosticOwnerHold;
+
+static _Bool xrl_diagnostic_hold_requested;
+#ifdef XRL_VERIFY_HOLD_OWNER
+
+typedef struct XrlHoldWitness {
+    unsigned int skipped[6];
+    unsigned int rejected[6];
+    unsigned int slow[6];
+    unsigned int arm_attempts;
+    unsigned int arm_successes;
+    unsigned int entry_guard_accepts;
+    unsigned int entry_guard_declines;
+    unsigned int latch_guard_attempts;
+    unsigned int latch_guard_declines;
+    unsigned int real_exit_reached;
+    unsigned int real_exit_restored;
+    unsigned int real_exit_published;
+} XrlHoldWitness;
+
+static XrlHoldWitness xrl_hold_witness;
+
+static void xrl_witness_vector(const unsigned int values[6]) {
+    (void)fprintf(stderr, "[%u,%u,%u,%u,%u,%u]", values[0], values[1], values[2],
+        values[3], values[4], values[5]);
+}
+
+static int xrl_finish_hold_witness(void) {
+    const XrlHoldWitness *result = &xrl_hold_witness;
+    static const unsigned int expected[6] = {20000, 20000, 20000, 19999, 19999, 19999};
+    _Bool passed = result->arm_attempts == 1 && result->arm_successes == 1 &&
+        result->entry_guard_accepts == 20000 && !result->entry_guard_declines &&
+        !result->latch_guard_attempts && !result->latch_guard_declines &&
+        result->real_exit_reached == 1 && result->real_exit_restored == 1 &&
+        result->real_exit_published == 1;
+    unsigned int skipped_edges = 0;
+    for (size_t edge = 0; edge < 6; ++edge) {
+        skipped_edges += result->skipped[edge];
+        if (result->skipped[edge] != expected[edge] || result->rejected[edge] ||
+                result->slow[edge]) passed = 0;
+    }
+    fputs("{\"hold_owner_witness\":true,\"skipped\":", stderr);
+    xrl_witness_vector(result->skipped);
+    fputs(",\"rejected\":", stderr);
+    xrl_witness_vector(result->rejected);
+    fputs(",\"slow\":", stderr);
+    xrl_witness_vector(result->slow);
+    (void)fprintf(stderr,
+        ",\"skipped_owner_writes\":%u,\"arm_attempts\":%u,\"arm_successes\":%u,"
+        "\"entry_guard_accepts\":%u,\"entry_guard_declines\":%u,"
+        "\"latch_guard_attempts\":%u,\"latch_guard_declines\":%u,"
+        "\"real_exit_reached\":%u,\"real_exit_restored\":%u,\"real_exit_published\":%u,"
+        "\"passed\":%s}\n",
+        2u * skipped_edges, result->arm_attempts, result->arm_successes,
+        result->entry_guard_accepts, result->entry_guard_declines,
+        result->latch_guard_attempts, result->latch_guard_declines,
+        result->real_exit_reached, result->real_exit_restored, result->real_exit_published,
+        passed ? "true" : "false");
+    return passed ? 0 : 3;
+}
+
+#endif
