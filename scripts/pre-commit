#!/usr/bin/env bash
# Git pre-commit hook: auto-format staged C/H files with clang-format.
# Works on macOS, Linux, and Windows (Git Bash / MSYS2).
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   or:   scripts/install-hooks.sh

set -e

# One version formats this tree. Two clang-format releases do not always agree,
# so a hook that takes whichever binary the PATH happens to surface first lets
# each machine reformat what the last one wrote. Pin it and say so.
REQUIRED_MAJOR=22

CF="clang-format"
if ! command -v "$CF" >/dev/null 2>&1; then
    CF="clang-format-$REQUIRED_MAJOR"
fi

# Not finding it is a failure, not a reason to continue. Skipping silently is
# how unformatted files reached the tree: three of them accumulated thousands
# of lines of drift because whoever committed them had no clang-format and the
# hook waved them through.
if ! command -v "$CF" >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found; this tree requires version $REQUIRED_MAJOR." >&2
    echo "  macOS:  brew install clang-format" >&2
    echo "  Debian: apt install clang-format-$REQUIRED_MAJOR" >&2
    echo "  To commit without formatting anyway: git commit --no-verify" >&2
    exit 1
fi

FOUND_MAJOR=$("$CF" --version 2>/dev/null | sed -E 's/.*version ([0-9]+).*/\1/')
if [ "$FOUND_MAJOR" != "$REQUIRED_MAJOR" ]; then
    echo "pre-commit: found clang-format $FOUND_MAJOR, but this tree formats with $REQUIRED_MAJOR." >&2
    echo "  Formatting with a different release rewrites files nobody touched." >&2
    echo "  Install $REQUIRED_MAJOR, or commit with: git commit --no-verify" >&2
    exit 1
fi

# Collect staged .c and .h files (excluding deleted)
STAGED=$(git diff --cached --name-only --diff-filter=d -- '*.c' '*.h')

if [ -z "$STAGED" ]; then
    exit 0
fi

# Format each staged file and re-add
FORMATTED=0
for f in $STAGED; do
    if [ -f "$f" ]; then
        # Generated artifacts must remain byte-for-byte identical to their
        # generator output; formatting them makes the sync gate fail after the
        # commit hook has already run.
        if head -n 1 "$f" | grep -Eiq 'auto-generated|automatically generated|@generated'; then
            continue
        fi
        "$CF" -i "$f"
        git add "$f"
        FORMATTED=$((FORMATTED + 1))
    fi
done

if [ "$FORMATTED" -gt 0 ]; then
    echo "pre-commit: formatted $FORMATTED file(s) with $CF"
fi
