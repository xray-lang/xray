var src = Array<byte>(4)
unsafe {
    src.setUnchecked(0, 65)
    src.setUnchecked(1, 66)
    src.setUnchecked(2, 67)
    src.setUnchecked(3, 68)
}

var out = Array<byte>(8)
var view: Slice<byte> = src[:]
unsafe {
    out.writeFromUnchecked(0, view, 0, 4)
    out.repeatAtUnchecked(4, 4, 4)
}

print(len(out))
unsafe {
    print(int(out.getUnchecked(0)))
    print(int(out.getUnchecked(7)))
}
