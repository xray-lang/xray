import text

// Demo: Testing
// @test functions, assertions, test lifecycle
//
// Run: xray test demos/07-advanced/testing.xr

enum TestErr { Expected { message: string } }

// === Basic tests ===
@test
fn test_arithmetic() {
    assertEqual(1 + 1, 2)
    assertEqual(10 * 5, 50)
    assertEqual(7 % 3, 1)
}

@test
fn test_strings() {
    var s = "Hello, World!"
    assertEqual(len(s), 13)
    assert(s.startsWith("Hello"))
    assert(s.endsWith("!"))
    assertEqual(text.lower(s), "hello, world!")
}

@test
fn test_arrays() {
    var arr = [1, 2, 3, 4, 5]
    assertEqual(len(arr), 5)
    assertEqual(arr[0], 1)
    assert(arr.contains(3))
    assert(!(arr.contains(99)))
}

@test
fn test_nullable() {
    var x: i64? = null
    assertEqual(x, null)
    assertEqual(x ?? 42, 42)

    x = 10
    assertEqual(x, 10)
    assertEqual(x ?? 42, 10)
}

@test
fn test_exceptions() {
    assertThrows(() -> {
        throw TestErr.Expected { message: "expected error" }
    })
}

// === Skip a test ===
@test(skip)
fn test_todo() {
    // Not implemented yet
    assert(false)
}

// === Test with custom timeout ===
@test(timeout: 5000)
fn test_with_timeout() {
    // This test has a 5-second timeout
    var sum = 0
    for (i in 0..1000) { sum = sum + i }
    assertEqual(sum, 499500)
}
