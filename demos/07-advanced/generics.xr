// Demo: Generics
// Generic classes, generic functions, type safety
//
// Run: xray demos/07-advanced/generics.xr

// === Generic class ===
class Box<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    get() -> T { return this.value }

    map(f: fn(T) -> T) -> Box<T> {
        return Box(f(this.value))
    }

    toString() -> string {
        return "Box(${this.value})"
    }
}

var intBox = Box(42)
var strBox = Box("hello")
print("intBox: ${intBox.toString()}, get: ${intBox.get()}")
print("strBox: ${strBox.toString()}, get: ${strBox.get()}")

// map transforms the value inside the box
var doubled = intBox.map(fn(x: int) -> int { return x * 2 })
print("doubled: ${doubled.toString()}")

// === Generic pair ===
class Pair<A, B> {
    first: A
    second: B

    constructor(a: A, b: B) {
        this.first = a
        this.second = b
    }

    toString() -> string {
        return "(${this.first}, ${this.second})"
    }
}

var p = Pair("age", 25)
print("pair: ${p.toString()}")
print("first: ${p.first}, second: ${p.second}")

// === Generic stack ===
class Stack<T> {
    private items: Array<T>

    constructor() { this.items = [] }

    push(item: T) { this.items.push(item) }

    pop() -> T? {
        if (len(this.items) == 0) { return null }
        return this.items.pop()
    }

    peek() -> T? {
        if (len(this.items) == 0) { return null }
        return this.items[len(this.items) - 1]
    }

    size() -> int { return len(this.items) }
    isEmpty() -> bool { return len(this.items) == 0 }
}

var stack = Stack<int>()
stack.push(10)
stack.push(20)
stack.push(30)
print("size: ${stack.size()}, peek: ${stack.peek()}")
print("pop: ${stack.pop()}")
print("pop: ${stack.pop()}")
print("size: ${stack.size()}")

// === Nullable types ===
fn safeDivide(a: float, b: float) -> float? {
    if (b == 0.0) { return null }
    return a / b
}

var ok = safeDivide(10.0, 3.0)
var bad = safeDivide(10.0, 0.0)
print("10/3 = ${ok ?? 0.0}")
print("10/0 = ${bad ?? 0.0} (fallback)")

// Optional chaining
var obj: Json = { inner: { value: 42 } }
print("optional chain: ${obj?.inner?.value}")
print("missing chain: ${obj?.missing?.value}")
