// Demo: Generics
// Generic classes, generic functions, type safety
//
// Run: xray demos/07-advanced/generics.xr

// === Generic class ===
class Box<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    get() -> T { return this.value }

    map(f: fn(T) -> T) -> Box<T> {
        return Box(f(this.value))
    }

    toString() -> string {
        return "Box(${this.value})"
    }
}

var intBox = Box(42)
var strBox = Box("hello")
print("intBox: ${intBox.toString()}, get: ${intBox.get()}")
print("strBox: ${strBox.toString()}, get: ${strBox.get()}")

// map transforms the value inside the box
var doubled = intBox.map(fn(x: i64) -> i64 { return x * 2 })
print("doubled: ${doubled.toString()}")

// === Generic pair ===
class Pair<A, B> {
    first: A
    second: B

    constructor(a: A, b: B) {
        this.first = a
        this.second = b
    }

    toString() -> string {
        return "(${this.first}, ${this.second})"
    }
}

var p = Pair("age", 25)
print("pair: ${p.toString()}")
print("first: ${p.first}, second: ${p.second}")

// === Generic stack ===
class Stack<T> {
    private items: Array<T>

    constructor() { this.items = [] }

    ref push(item: T) { this.items.push(item) }

    ref pop() -> T? {
        if (len(this.items) == 0) { return null }
        return this.items.pop()
    }

    peek() -> T? {
        if (len(this.items) == 0) { return null }
        return this.items[len(this.items) - 1]
    }

    size() -> i64 { return len(this.items) }
    isEmpty() -> bool { return len(this.items) == 0 }
}

var stack = Stack<i64>()
stack.push(10)
stack.push(20)
stack.push(30)
print("size: ${stack.size()}, peek: ${stack.peek()}")
print("pop: ${stack.pop()}")
print("pop: ${stack.pop()}")
print("size: ${stack.size()}")

// === Nullable types ===
fn safeDivide(a: f64, b: f64) -> f64? {
    if (b == 0.0) { return null }
    return a / b
}

var ok = safeDivide(10.0, 3.0)
var bad = safeDivide(10.0, 0.0)
print("10/3 = ${ok ?? 0.0}")
print("10/0 = ${bad ?? 0.0} (fallback)")

// Optional chaining on a statically known nullable field
type InnerValue = { value: i64 }
type OptionalWrapper = { inner: InnerValue? }
var obj: OptionalWrapper = { inner: { value: 42 } }
var empty: OptionalWrapper = { inner: null }
print("optional chain: ${obj?.inner?.value}")
print("missing chain: ${empty?.inner?.value}")
