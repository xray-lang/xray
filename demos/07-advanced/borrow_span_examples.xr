// Demo: Parameter Modes, Borrowing, Slice, and Ownership Actions
// Short examples for READ/ref/move, copy/move, Slice views, and managed Buffer.
//
// Run: xray run demos/07-advanced/borrow_span_examples.xr

import mem

// === 1. value: ordinary parameter ===
fn plusOne(value: i64) -> i64 {
    return value + 1
}

// === 2. READ: an ordinary Array parameter ===
fn sumBorrowed(data: Array<i64>) -> i64 {
    var total = 0
    for (x in data) {
        total = total + x
    }
    return total
}

// === 3. ref: mutable borrowed parameter ===
fn fillZero(buf: ref Array<u8>) {
    for (i in 0..len(buf)) {
        buf[i] = 0
    }
}

// === 4. ref: caller-visible initialization ===
fn initializeAnswer(slot: ref i64) {
    slot = 42
}

// === 5. explicit value snapshots ===
fn copyForStorage(data: Array<i64>) -> Array<i64> {
    // READ permits returning a logical copy. The explicit expression makes
    // that snapshot visible without changing the original Array.
    return copy data
}

class Holder {
    items: Array<i64>

    init() {
        this.items = []
    }
}

fn storeCopy(data: Array<i64>, holder: ref Holder) {
    // Saving a copyable READ value is legal. This expression explicitly
    // preserves the Array's value semantics in the holder.
    holder.items = copy data
}

// === 6. move: transfer ownership ===
fn takeBytes(data: move Array<u8>) -> i64 {
    return len(data)
}

fn moveExample() {
    var payload = Array<u8>(8)
    payload[0] = 1
    payload[1] = 2

    // `move` transfers ownership without copying. The old name is no longer
    // usable after this call.
    var count = takeBytes(move payload)
    print("moved bytes length: ${count}")
}

// === 7. Slice and Buffer stay local to their owner ===
fn sliceExample() {
    var values = [2, 3, 4, 5]
    var view: MutSlice<i64> = values[1:4]

    for (i in 0..len(view)) {
        view[i] = view[i] * 10
    }

    print("scaled view: ${view[0]}, ${view[1]}, ${view[2]}")
    print("owner after view write: ${values[1]}, ${values[2]}, ${values[3]}")
}

fn bufferExample() {
    var buffer = mem.allocZeroed(4)
    unsafe {
        mem.withSliceMut<u8>(buffer.borrowPtr(), len(buffer), ref buffer,
            fn(view: MutSlice<u8>) {
                view[0] = 7
                view[1] = 9
                print("buffer view: ${view[0]}, ${view[1]}, len ${len(view)}")
            })
    }
}

// === Run the examples ===
var value = 10
print("value param: ${plusOne(value)}, original: ${value}")

var nums = [1, 2, 3, 4]
print("sumBorrowed: ${sumBorrowed(nums)}")
print("nums still usable: ${len(nums)}")

var bytes = Array<u8>(4)
bytes[0] = 9
bytes[1] = 8
fillZero(ref bytes)
print("bytes after fillZero: ${bytes[0]}, ${bytes[1]}")

var answer = 0
initializeAnswer(ref answer)
print("answer after initializeAnswer: ${answer}")

var copied = copyForStorage(nums)
print("copied length: ${len(copied)}")

var holder = Holder()
storeCopy(nums, ref holder)
print("holder length: ${len(holder.items)}")

moveExample()
sliceExample()
bufferExample()
