// Demo: Variables and Types
// Shows let, const, type annotations, and basic types
//
// Run: xray demos/01-basics/variables.xr

// === let (mutable) vs const (immutable) ===
var count = 0
count = count + 1
print("count = ${count}")

const PI = 3.14159
// PI = 3.0       // ERROR: cannot reassign const
print("PI = ${PI}")

// === Type annotations ===
var age: int = 25
var height: float = 1.75
var name: string = "Alice"
var active: bool = true

print("${name}, age ${age}, height ${height}, active: ${active}")

// === Type inference ===
var x = 42            // inferred as int
var y = 3.14          // inferred as float
var s = "hello"       // inferred as string

// === Nullable types ===
var maybe: int? = null
print("maybe = ${maybe}")
maybe = 42
print("maybe = ${maybe}")

// Null coalescing operator
var value = maybe ?? 0
print("value = ${value}")

// === Multiple assignment ===
fn divmod(a: int, b: int) -> (int, int) {
    return (a / b, a % b)
}
var (quotient, remainder) = divmod(17, 5)
print("17 / 5 = ${quotient} remainder ${remainder}")

// === Destructuring ===
var [a, b, c] = [10, 20, 30]
print("a=${a}, b=${b}, c=${c}")

var person = { first: "Bob", score: 99 }
var { first, score } = person
print("${first}, score ${score}")
