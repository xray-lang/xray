// Demo: Classes and Inheritance
// class, constructor, methods, static, inheritance, override
//
// Run: xray demos/03-oop/classes.xr

// === Basic class ===
class Animal {
    name: string
    sound: string

    constructor(name: string, sound: string) {
        this.name = name
        this.sound = sound
    }

    speak() -> string {
        return "${this.name} says ${this.sound}!"
    }

    toString() -> string {
        return "Animal(${this.name})"
    }
}

var cat = Animal("Cat", "meow")
print(cat.speak())

// === Inheritance ===
class Dog extends Animal {
    breed: string

    constructor(name: string, breed: string) {
        super(name, "woof")
        this.breed = breed
    }

    speak() -> string {
        return "${this.name} (${this.breed}) says woof!"
    }

    fetch(item: string) -> string {
        return "${this.name} fetches the ${item}"
    }
}

var dog = Dog("Rex", "Labrador")
print(dog.speak())
print(dog.fetch("ball"))

// === Static methods ===
class Counter {
    private count: i64

    constructor() { this.count = 0 }

    increment() { this.count = this.count + 1 }
    getCount() -> i64 { return this.count }

    static create() -> Counter {
        return Counter()
    }
}

var c = Counter.create()
c.increment()
c.increment()
c.increment()
print("count: ${c.getCount()}")

// === Polymorphism via method override ===
var animals = [Animal("Parrot", "squawk"), Dog("Buddy", "Golden")]
for (a in animals) {
    print("  ${a.speak()}")
}
