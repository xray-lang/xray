// Demo: Goroutines (Coroutines)
// go, await, Task.all, Task.first, Task API
//
// Run: xray demos/05-concurrency/goroutines.xr

import time

// === Basic goroutine ===
fn compute(name: string, n: i64) -> i64 {
    var sum = 0
    for (i in 0..n) { sum = sum + i }
    print("${name} computed sum(0..${n}) = ${sum}")
    return sum
}

// go launches a coroutine, returns a Task
var t = go compute("task-1", 100)
var result = await t
print("result: ${result}")

// === Multiple goroutines ===
var t1 = go compute("alpha", 50)
var t2 = go compute("beta", 75)
var t3 = go compute("gamma", 100)

// Task.all waits for all tasks
var results = Task.all([t1, t2, t3])
print("all results: ${results}")

// === Task.first (first to finish wins) ===
fn slowTask(name: string, delay: i64) -> string {
    time.sleep(delay)
    return "${name} done after ${delay}ms"
}

var fast = go slowTask("fast", 10)
var slow = go slowTask("slow", 200)
var first = Task.first([fast, slow])
print("first finished: ${first}")

fn taskResultText(result: TaskResult<i64, Never>) -> string {
    return match (result) {
        TaskResult.Success { value: v } -> "TaskResult.Success(${v})",
        TaskResult.Error { error: _ } -> "TaskResult.Error",
        TaskResult.Panic { info: _ } -> "TaskResult.Panic",
        TaskResult.Cancelled -> "TaskResult.Cancelled",
    }
}

// === Task properties ===
var task = go compute("check", 10)
var val = await task
const polled = task.poll()
var pollText = "Pending"
if (polled != null) { pollText = taskResultText(polled!) }
print("task.poll: ${pollText}")
print("task.result: ${val}")
print("task.awaitResult: ${taskResultText(task.awaitResult())}")
