// Demo: Concurrency Safety Rules
// shared, Channel, parameter passing — the three ways to share data
//
// Run: xray demos/05-concurrency/shared_data.xr
//
// GOLDEN RULE: If it compiles, it's concurrency-safe.
// No locks needed. The compiler enforces safety.

// === Rule 1: shared (immutable cross-coroutine sharing) ===
// Zero-copy reads from any coroutine
const CONFIG = {
    host: "localhost",
    port: 8080,
    maxRetries: 3
}

fn worker1(id: i64) {
    // All workers can safely read CONFIG (no copy, no lock)
    print("worker-${id}: host=${CONFIG.host}, port=${CONFIG.port}")
}

scope {
    go worker1(1)
    go worker1(2)
    go worker1(3)
}

// === Rule 2: Channel (inter-coroutine communication) ===
// Channels are declared `shared` and deep-copy pointer values on send.
const ch = Channel<i64>(1)

fn sender(ch: Channel<i64>) {
    ch.send(42)
}

go sender(ch)
var val = match (ch.recv()) {
    Recv.Value { value: v } -> v
    _             -> -1
}
print("received via channel: ${val}")
ch.close()

// === Rule 3: Explicit copy or move ===
// Crossing a go boundary requires copy(...), move of an owned source, or shared identity.
fn processData(data: move Array<i64>) {
    // This is a separate copy — mutations don't affect the original
    data.push(999)
    print("child sees: ${data}")
}

var myData = [1, 2, 3]
var t = go processData(copy(myData))
await t
print("parent still has: ${myData}")

// === What you CANNOT do (compiler errors): ===
// These would all fail at compile time:
//
// var x = [1, 2, 3]
// go fn() { print(x) }()              // ERROR: cannot capture 'x' in go closure
//
// var ch2 = Channel<int>(1)            // ERROR: Channel must be `shared`
//
// shared data = [1,2,3]
// go fn() { data.push(4) }()           // ERROR: cannot capture `shared`

print("\nAll concurrency rules demonstrated safely!")
