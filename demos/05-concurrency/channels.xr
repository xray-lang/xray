// Demo: Channels
// Buffered channels, send/recv, close, patterns
//
// Run: xray demos/05-concurrency/channels.xr

// === Basic channel ===
// Channels MUST be `shared const` so multiple coroutines can capture them safely.
shared const ch = new Channel<int>(3)

// Send values (buffered, non-blocking up to capacity)
ch.send(10)
ch.send(20)
ch.send(30)

// Receive values
match (ch.recv()) {
    Recv.Value(v) -> print("recv: ${v}")
    _ -> print("recv: closed")
}
match (ch.recv()) {
    Recv.Value(v) -> print("recv: ${v}")
    _ -> print("recv: closed")
}
match (ch.recv()) {
    Recv.Value(v) -> print("recv: ${v}")
    _ -> print("recv: closed")
}
ch.close()

// === Producer-Consumer pattern ===
shared const data = new Channel<int>(5)

fn producer(out: Channel<int>, count: int) {
    for (i in 0..count) {
        out.send(i * i)
    }
    out.close()
}

fn consumer(input: Channel<int>) {
    while (true) {
        match (input.recv()) {
            Recv.Value(val) -> print("consumed: ${val}")
            Recv.Closed -> { break }
            _ -> { break }
        }
    }
}

go producer(data, 6)
consumer(data)

// === Fan-out: one producer, multiple consumers ===
shared const work = new Channel<int>(10)

fn worker(id: int, jobs: Channel<int>) {
    while (true) {
        match (jobs.recv()) {
            Recv.Value(job) -> print("worker-${id}: processed job ${job}")
            Recv.Closed -> { break }
            _ -> { break }
        }
    }
}

// Start 3 workers
scope {
    go worker(1, work)
    go worker(2, work)
    go worker(3, work)

    // Send jobs
    for (i in 0..9) {
        work.send(i)
    }
    work.close()
}

// === tryRecv (non-blocking) ===
shared const ch2 = new Channel<int>(1)
ch2.send(42)

match (ch2.tryRecv()) {
    Recv.Value(val) -> print("tryRecv: value=${val}")
    Recv.Empty -> print("tryRecv: empty")
    Recv.Closed -> print("tryRecv: closed")
    _ -> print("tryRecv: timeout")
}

match (ch2.tryRecv()) {
    Recv.Value(val) -> print("tryRecv empty: value=${val}")
    Recv.Empty -> print("tryRecv empty: empty")
    Recv.Closed -> print("tryRecv empty: closed")
    _ -> print("tryRecv empty: timeout")
}
ch2.close()
