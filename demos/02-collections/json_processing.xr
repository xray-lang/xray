// Demo: typed objects and schema-less JSON processing.
//
// Run: xray demos/02-collections/json_processing.xr

type Address = { city: string, zip: string }
type User = {
    name: string,
    age: i64,
    email: string,
    tags: Array<string>,
    address: Address,
}

// Known application data uses an exact structural-object type.
var user: User = {
    name: "Alice",
    age: 30,
    email: "alice@example.com",
    tags: ["admin", "user"],
    address: { city: "Beijing", zip: "100000" },
}
print("name: ${user.name}")
print("city: ${user.address.city}")
print("first tag: ${user.tags[0]}")

user.age = 31
var contact = { ...user, phone: "123-456-7890" }
print("updated age: ${contact.age}")
print("added phone: ${contact.phone}")
print("typed JSON: ${JSON.stringify(contact)}")

// Unknown inbound JSON stays in JSON.Value and uses explicit paths.
var text = "{\"point\":{\"x\":1,\"y\":2},\"label\":\"origin\"}"
var parsed = JSON.parseValue(text)
print("x: ${JSON.require<i64>(parsed, ["point", "x"])}")
print("missing salary: ${JSON.get<i64>(parsed, ["salary"])}")
JSON.set(parsed, ["point", "x"], 10)
print("updated: ${JSON.stringify(parsed)}")

// Unknown-key mutation uses JSON.Object, the Map<string, JSON.Value> alias.
var config: JSON.Object = JSON.parseObject("{}")
config.set("host", "localhost")
config.set("port", 8080)
config.set("debug", true)
config.set("allowed", JSON.value(["GET", "POST"]))
print("config: ${JSON.stringify(config)}")
print("config keys: ${config.keys()}")

for (key, value in config) {
    print("${key}: ${value}")
}
