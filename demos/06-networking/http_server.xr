// Demo: HTTP Server
// A simple REST API server using the http module.
//
// Run:  xray demos/06-networking/http_server.xr
// Test: curl http://localhost:3000/api/hello
//       curl http://localhost:3000/api/echo -d '{"msg":"hi"}'
//       curl -i http://localhost:3000/api/redirect
//
// NOTE: This starts a real server. Press Ctrl+C to stop.
//
// Handler API: each dynamic handler is typed
// `fn(req: HttpRequest) -> HttpResponse`.

import http
import { Headers, HttpRequest, HttpResponse, Server } from http

var server = Server()

// Simple text response
server.routeHandler("GET", "/", fn(req: HttpRequest) -> HttpResponse {
    return http.textResponse("Welcome to Xray HTTP Server!")
})

// JSON response
server.routeHandler("GET", "/api/hello", fn(req: HttpRequest) -> HttpResponse {
    return http.jsonResponse({
        message: "Hello from Xray!",
        method: string(req.method),
        path: req.path
    })
})

// Echo back request body
server.routeHandler("POST", "/api/echo", fn(req: HttpRequest) -> HttpResponse {
    var body = req.text()
    return http.jsonResponse({ echo: body, length: len(body) })
})

// Dynamic path (query params)
server.routeHandler("GET", "/api/greet", fn(req: HttpRequest) -> HttpResponse {
    var name = req.query.get("name") ?? "World"
    return http.jsonResponse({ greeting: "Hello, ${name}!" })
})

// 302 redirect with Location header
server.routeHandler("GET", "/api/redirect", fn(req: HttpRequest) -> HttpResponse {
    var headers = Headers()
    headers.add("Location", "/api/hello")
    return http.textResponse("Redirecting...", 302, headers)
})

print("Server starting on http://localhost:3000")
const serverRunning = Atomic(true)
server.listen(3000, serverRunning)
