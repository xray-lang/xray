// Demo: HTTP Server
// A simple REST API server using the http module.
//
// Run:  xray demos/06-networking/http_server.xr
// Test: curl http://localhost:3000/api/hello
//       curl http://localhost:3000/api/echo -d '{"msg":"hi"}'
//       curl -i http://localhost:3000/api/redirect
//
// NOTE: This starts a real server. Press Ctrl+C to stop.
//
// Handler API: each handler is `fn(req: Json) -> X` and the return value
// becomes the HTTP response. Supported X shapes:
//   - string                 -> 200 text/plain
//   - Json / Map / number    -> 200 application/json (auto-stringified)
//   - null                   -> 204 No Content
//   - [status, contentType, body]                -> custom status
//   - [status, contentType, body, headers: Map]  -> custom status + headers

import http

// Simple text response
http.route("GET", "/", fn(req: Json) -> string {
    return "Welcome to Xray HTTP Server!"
})

// JSON response (returning a Json object auto-serialises)
http.route("GET", "/api/hello", fn(req: Json) -> Json {
    return {
        message: "Hello from Xray!",
        method: req.method,
        path: req.path
    }
})

// Echo back request body
http.route("POST", "/api/echo", fn(req: Json) -> Json {
    let body = req.body ?? ""
    return { echo: body, length: body.length }
})

// Dynamic path (query params)
http.route("GET", "/api/greet", fn(req: Json) -> Json {
    let name = req.query.name ?? "World"
    return { greeting: "Hello, ${name}!" }
})

// 302 redirect with Location header
http.route("GET", "/api/redirect", fn(req: Json) -> Array<Json> {
    return [302, "text/plain", "Redirecting...", #{"Location": "/api/hello"}]
})

print("Server starting on http://localhost:3000")
http.listen(3000)
