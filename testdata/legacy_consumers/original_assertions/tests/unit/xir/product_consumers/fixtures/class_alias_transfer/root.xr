class Cell {
  value: i64
  init(value: i64) { this.value = value }
}
class Holder {
  child: Cell
  init(child: Cell) { this.child = child }
}
fn answer() -> i64 {
  var cell = Cell(42)
  var alias = cell
  var holder = Holder(alias)
  return holder.child.value
}
export fn consumerAnswer() -> i64 { return answer() }
