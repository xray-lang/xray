fn answer() -> i64 {
if ((div_i8(-128, -1) as i64) != -128) { return 1 }
if ((rem_i8(-128, -1) as i64) != 0) { return 2 }
if ((div_i16(-32768, -1) as i64) != -32768) { return 3 }
if ((rem_i16(-32768, -1) as i64) != 0) { return 4 }
if ((div_i32(-2147483648, -1) as i64) != -2147483648) { return 5 }
if ((rem_i32(-2147483648, -1) as i64) != 0) { return 6 }
if ((div_i64(-9223372036854775808, -1) as i64) != -9223372036854775808) { return 7 }
if ((rem_i64(-9223372036854775808, -1) as i64) != 0) { return 8 }
if ((div_u8(255, 3) as i64) != 85) { return 9 }
if ((rem_u8(255, 3) as i64) != 0) { return 10 }
if ((div_u16(65535, 3) as i64) != 21845) { return 11 }
if ((rem_u16(65535, 3) as i64) != 0) { return 12 }
if ((div_u32(4294967295, 3) as i64) != 1431655765) { return 13 }
if ((rem_u32(4294967295, 3) as i64) != 0) { return 14 }
if ((div_u64(18446744073709551615, 10) as i64) != 1844674407370955161) { return 15 }
if ((rem_u64(18446744073709551615, 10) as i64) != 5) { return 16 }
