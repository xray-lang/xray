if (rem_i64(-7, 3) != -1) { return 18 }
if (div_i64(7, -3) != -2) { return 19 }
if (rem_i64(7, -3) != 1) { return 20 }
return 0
}
export fn consumerAnswer() -> i64 { return answer() }
