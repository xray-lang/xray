fn make_matrix(n: i64, seed: i64) -> Array<i64> {
    var data: Array<i64> = []
    for (var i = 0; i < n * n; i++) {
        data.push((i * seed + 7) % 31)
    }
    return data
}

fn mmul_sum(a: Array<i64>, b: Array<i64>, n: i64) -> i64 {
    var total = 0
    for (var i = 0; i < n; i++) {
        for (var j = 0; j < n; j++) {
            var cell = 0
            for (var k = 0; k < n; k++) {
                cell = cell + a[i * n + k] * b[k * n + j]
            }
            total = total + cell
        }
    }
    return total
}

fn main() {
    var n = 28
    var a = make_matrix(n, 3)
    var b = make_matrix(n, 5)
    var result = mmul_sum(a, b, n)
    print("matrix_mul_naive=${result}")
}

main()
