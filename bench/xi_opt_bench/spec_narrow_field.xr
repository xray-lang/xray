class Payload {
    x: int
    y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }

    sum() -> int {
        return this.x + this.y
    }
}

fn run(rounds: int) -> int {
    var payload = Payload(17, 29)
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + payload.x + payload.y + payload.sum()
    }
    return total
}

fn main() {
    var result = run(220000)
    print("spec_narrow_field=${result}")
}

main()
