class BenchCounter {
    value: i64 = 0

    ref bump(x: i64) -> i64 {
        this.value = this.value + x
        return this.value
    }
}

fn run(rounds: i64) -> i64 {
    var counter = BenchCounter()
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + counter.bump((i % 5) + 1)
    }
    return total + counter.value
}

fn main() {
    var result = run(180000)
    print("oop_dispatch_mono=${result}")
}

main()
