class BenchCounter {
    value: int = 0

    bump(x: int) -> int {
        this.value = this.value + x
        return this.value
    }
}

fn run(rounds: int) -> int {
    let counter = new BenchCounter()
    let total = 0
    for (let i = 0; i < rounds; i++) {
        total = total + counter.bump((i % 5) + 1)
    }
    return total + counter.value
}

fn main() {
    let result = run(180000)
    print("oop_dispatch_mono=${result}")
}

main()
