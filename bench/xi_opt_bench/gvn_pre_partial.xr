fn choose(flag: bool, x: int, y: int) -> int {
    let a = (x * 31 + y * 17) - (x / 3)
    if (flag) {
        return a + 1
    }
    let b = (x * 31 + y * 17) - (x / 3)
    return b - 1
}

fn run(rounds: int) -> int {
    let total = 0
    for (let i = 1; i < rounds; i++) {
        total = total + choose(i % 3 == 0, i, i + 7)
    }
    return total
}

fn main() {
    let result = run(120000)
    print("gvn_pre_partial=${result}")
}

main()
