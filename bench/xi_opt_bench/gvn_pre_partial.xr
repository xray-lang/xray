fn choose(flag: bool, x: i64, y: i64) -> i64 {
    var a = (x * 31 + y * 17) - (x / 3)
    if (flag) {
        return a + 1
    }
    var b = (x * 31 + y * 17) - (x / 3)
    return b - 1
}

fn run(rounds: i64) -> i64 {
    var total = 0
    for (var i = 1; i < rounds; i++) {
        total = total + choose(i % 3 == 0, i, i + 7)
    }
    return total
}

fn main() {
    var result = run(120000)
    print("gvn_pre_partial=${result}")
}

main()
