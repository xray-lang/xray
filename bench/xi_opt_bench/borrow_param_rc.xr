struct Pair {
    a: int
    b: int
}

class Box {
    value: int

    constructor(value: int) {
        this.value = value
    }

    get() -> int {
        return this.value
    }
}

fn sumPair(p: Pair) -> int {
    return p.a + p.b
}

fn wrapPair(p: Pair) -> int {
    return sumPair(p)
}

fn readBox(box: Box) -> int {
    return box.get()
}

fn sumArray(values: Array<int>) -> int {
    return values[0] + values[1] + values[2] + values[3]
}

fn run(rounds: int) -> int {
    var pair = Pair{a: 11, b: 17}
    var box = Box(23)
    var values = [3, 5, 7, 9]
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + wrapPair(pair)
        total = total + readBox(box)
        total = total + sumArray(values)
        total = total + (i % 7)
    }
    return total
}

fn main() {
    var result = run(180000)
    print("borrow_param_rc=${result}")
}

main()
