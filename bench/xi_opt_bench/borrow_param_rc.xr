struct Pair {
    a: i64
    b: i64
}

class Box {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    get() -> i64 {
        return this.value
    }
}

fn sumPair(p: Pair) -> i64 {
    return p.a + p.b
}

fn wrapPair(p: Pair) -> i64 {
    return sumPair(p)
}

fn readBox(box: Box) -> i64 {
    return box.get()
}

fn sumArray(values: Array<i64>) -> i64 {
    return values[0] + values[1] + values[2] + values[3]
}

fn run(rounds: i64) -> i64 {
    var pair = Pair{a: 11, b: 17}
    var box = Box(23)
    var values = [3, 5, 7, 9]
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + wrapPair(pair)
        total = total + readBox(box)
        total = total + sumArray(values)
        total = total + (i % 7)
    }
    return total
}

fn main() {
    var result = run(180000)
    print("borrow_param_rc=${result}")
}

main()
