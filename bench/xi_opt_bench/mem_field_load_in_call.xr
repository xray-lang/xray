class Cell {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

fn opaque_mix(x: i64) -> i64 {
    var acc = x
    for (var i = 0; i < 4; i++) {
        acc = (acc * 13 + i * 11) % 97
    }
    return acc
}

fn run(cell: Cell, rounds: i64) -> i64 {
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + cell.value
        total = total + opaque_mix(i)
        total = total + cell.value
    }
    return total
}

fn main() {
    var cell = Cell(37)
    var result = run(cell, 160000)
    print("mem_field_load_in_call=${result}")
}

main()
