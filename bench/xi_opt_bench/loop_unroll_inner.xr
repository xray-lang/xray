fn kernel(a: i64, b: i64) -> i64 {
    var acc = a
    for (var i = 0; i < 8; i++) {
        acc = acc + b * i + 3
    }
    return acc
}

fn run(rounds: i64) -> i64 {
    var total = 0
    for (var i = 0; i < rounds; i++) {
        total = total + kernel(i, 7)
    }
    return total
}

fn main() {
    var result = run(150000)
    print("loop_unroll_inner=${result}")
}

main()
