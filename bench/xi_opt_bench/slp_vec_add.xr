fn make_data(n: i64, seed: i64) -> Array<i64> {
    var data: Array<i64> = []
    for (var i = 0; i < n; i++) {
        data.push((i * seed + 19) % 4096)
    }
    return data
}

fn vec_add_sum(a: Array<i64>, b: Array<i64>, rounds: i64) -> i64 {
    var total = 0
    var n = len(a)
    for (var r = 0; r < rounds; r++) {
        for (var i = 0; i < n; i++) {
            total = total + a[i] + b[i]
        }
    }
    return total
}

fn main() {
    var a = make_data(4096, 3)
    var b = make_data(4096, 7)
    var result = vec_add_sum(a, b, 128)
    print("slp_vec_add=${result}")
}

main()
