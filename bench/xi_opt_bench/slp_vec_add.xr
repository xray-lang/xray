fn make_data(n: int, seed: int) -> Array<int> {
    var data: Array<int> = []
    for (var i = 0; i < n; i++) {
        data.push((i * seed + 19) % 4096)
    }
    return data
}

fn vec_add_sum(a: Array<int>, b: Array<int>, rounds: int) -> int {
    var total = 0
    var n = a.length
    for (var r = 0; r < rounds; r++) {
        for (var i = 0; i < n; i++) {
            total = total + a[i] + b[i]
        }
    }
    return total
}

fn main() {
    var a = make_data(4096, 3)
    var b = make_data(4096, 7)
    var result = vec_add_sum(a, b, 128)
    print("slp_vec_add=${result}")
}

main()
