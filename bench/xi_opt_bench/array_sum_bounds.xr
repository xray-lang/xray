fn build_data(n: int) -> Array<int> {
    var data: Array<int> = []
    for (var i = 0; i < n; i++) {
        data.push((i * 17 + 3) % 1024)
    }
    return data
}

fn sum_bounds(data: Array<int>, rounds: int) -> int {
    var total = 0
    var n = data.length
    for (var r = 0; r < rounds; r++) {
        for (var i = 0; i < n; i++) {
            total = total + data[i]
        }
    }
    return total
}

fn main() {
    var data = build_data(4096)
    var result = sum_bounds(data, 256)
    print("array_sum_bounds=${result}")
}

main()
