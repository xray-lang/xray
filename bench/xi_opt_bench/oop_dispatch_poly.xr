class AnimalBench {
    seed: i64

    constructor(seed: i64) {
        this.seed = seed
    }

    score(x: i64) -> i64 {
        return this.seed + x
    }
}

class DogBench extends AnimalBench {
    constructor(seed: i64) {
        super(seed)
    }

    score(x: i64) -> i64 {
        return this.seed + x * 2
    }
}

class CatBench extends AnimalBench {
    constructor(seed: i64) {
        super(seed)
    }

    score(x: i64) -> i64 {
        return this.seed + x * 3
    }
}

fn run(rounds: i64) -> i64 {
    var animals = [DogBench(5), CatBench(7)]
    var total = 0
    for (var i = 0; i < rounds; i++) {
        var a = animals[i % len(animals)]
        total = total + a.score(i % 17)
    }
    return total
}

fn main() {
    var result = run(120000)
    print("oop_dispatch_poly=${result}")
}

main()
