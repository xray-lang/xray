fn extend(a: Array<i64>, n: i64) -> Array<i64> {
    var b = a
    var i = 0
    while (i < n) {
        b.push(i)
        i = i + 1
    }
    return b
}
fn main() {
    var a: Array<i64> = []
    a = extend(a, @N@)
    var total = 0
    var i = 0
    while (i < len(a)) {
        total = total + a[i]
        i = i + 1
    }
    print(total)
}
main()
