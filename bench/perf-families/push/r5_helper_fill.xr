fn fill(n: i64) -> Array<i64> {
    var a: Array<i64> = []
    var i = 0
    while (i < n) {
        a.push(i)
        i = i + 1
    }
    return a
}
fn main() {
    const a = fill(@N@)
    var total = 0
    var i = 0
    while (i < len(a)) {
        total = total + a[i]
        i = i + 1
    }
    print(total)
}
main()
