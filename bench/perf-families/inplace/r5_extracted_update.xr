fn bump(a: Array<i64>) -> Array<i64> {
    var b = a
    var i = 0
    while (i < len(b)) { b[i] = b[i] * 3 + 1; i = i + 1 }
    return b
}
fn main() {
    var a: Array<i64> = []
    var i = 0
    while (i < 4096) { a.push(i); i = i + 1 }
    var r = 0
    while (r < @R@) { a = bump(a); r = r + 1 }
    var total = 0
    i = 0
    while (i < len(a)) { total = total + a[i]; i = i + 1 }
    print(total)
}
main()
