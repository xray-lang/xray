fn rounds(a: Array<i64>, count: i64) -> i64 {
    var b = a
    var i = 0
    var r = 0
    while (r < count) {
        i = 0
        while (i < len(b)) { b[i] = b[i] * 3 + 1; i = i + 1 }
        r = r + 1
    }
    var total = 0
    i = 0
    while (i < len(b)) { total = total + b[i]; i = i + 1 }
    return total
}
fn main() {
    var a: Array<i64> = []
    var i = 0
    while (i < 4096) { a.push(i); i = i + 1 }
    print(rounds(a, @R@))
}
main()
