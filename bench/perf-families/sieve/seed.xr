fn main() {
    const n = @N@
    var flags: Array<i64> = []
    var i = 0
    while (i <= n) {
        flags.push(1)
        i = i + 1
    }
    var count = 0
    var p = 2
    while (p <= n) {
        if (flags[p] == 1) {
            count = count + 1
            var m = p * p
            while (m <= n) {
                flags[m] = 0
                m = m + p
            }
        }
        p = p + 1
    }
    print(count)
}
main()
