        "defined_symbol_names",
        "forbidden_symbols",
        "missing_authority_symbols",
        "raw_log_identity"
      ]
    },
    {
      "id": "retired-runtime-symbol-boundary",
      "path": "scripts/target_machine_retired_runtime_symbols.py",
      "required_regex": [
        "EXACT\\s*=\\s*frozenset",
        "PREFIXES\\s*=",
        "def matches",
        "def compiled_pattern"
      ]
    },
    {
      "id": "dependency-graph-evidence-producer",
