{
  "authorities": [
    {
      "id": "full-validation-evidence-producer",
      "path": "scripts/collect_target_machine_full_validation_evidence.py",
      "required_regex": [
        "PRODUCER\\s*=\\s*\"target-machine-full-validation-evidence/2\"",
        "LANE_REGEX",
        "BASELINE_RUNNER",
        "parse_ctest_discovery",
        "baseline_lane_statuses",
        "selection_sha256",
        "governed-full-baseline",
        "status\\s*=\\s*\"passed\"\\s+if\\s+all_ok\\s+else\\s+\"failed\"",
        "os\\.rename\\(staging, output\\)"
      ]
    },
    {
      "id": "activation-generation-evidence-producer",
      "path": "scripts/collect_target_machine_activation_generation_evidence.py",
      "required_regex": [
        "PRODUCER\\s*=\\s*\"target-machine-activation-generation-evidence/1\"",
        "runtime_compiler_symbols",
        "negative_mismatches",
        "status\\s*=\\s*\"passed\"\\s+if\\s+passed\\s+else\\s+\"failed\"",
        "os\\.rename\\(staging, output\\)"
      ]
    },
    {
      "id": "symbol-evidence-producer",
      "path": "scripts/collect_target_machine_symbol_evidence.py",
