  "installed": {
    "forbidden_path_regex": "(?i)(?:^|/)(?:xray_vm\\.h|[^/]*\\.xrc|(?:lib)?xray_vm_runtime\\.(?:a|lib|so|dylib|dll)|(?:xrc|bytecode)(?:/|$)|[^/]*bytecode[^/]*)",
    "forbidden_text_regex": "(?i)(?:\\.xrc\\b|\\bxray_vm_[A-Za-z0-9_]+\\b|\\bxr_(?:bytecode_[A-Za-z0-9_]+|detect_output_format|eval_bytecode|output_c_source|run_bytecode_file)\\b|xbytecode_io\\.h|xopcode_def\\.h)",
    "required_deliverables": [
      "xray-cli",
      "libxray-exec-core",
      "libxray-vm",
      "libxray-compiler"
    ],
    "required_public_headers": [
      "include/xray/runtime.h"
    ]
  },
  "inventories": {
    "aot_plan": "contracts/target-machine/aot-plan-destination-inventory.json",
    "legacy_product": "contracts/target-machine/legacy-product-residue.json",
    "legacy_vm": "contracts/target-machine/legacy-vm-inventory.json"
  },
  "matrix": {
    "policy": "contracts/target-machine/validation-matrix.json",
    "qualifying_tiers": [
      "supported",
      "ci-only"
    ],
    "required_artifact_routes": [
      "source-to-xsm",
      "xsm-to-xtp",
      "xtp-to-vm",
      "target-plan-to-native",
      "runtime-only-embed",
      "hosted-fragment",
      "generation-lifecycle"
    ],
    "required_dimensions": [
      "target",
      "provider",
      "artifact_route",
      "executor_or_generation",
      "build_or_sanitizer"
    ]
  },
  "policy": {
    "accepted_evidence_status": [
      "passed",
      "unsupported"
    ],
    "compatibility_or_fallback": "forbidden",
    "missing_or_unclassified": "error",
    "residue_count": 0,
    "self_certifying_write": "forbidden",
    "skip_or_allowlist": "forbidden"
  },
  "residue_scan": {
    "definition_paths": [
      "scripts/check_target_machine_completion.py"
    ],
    "roots": [
      ".github",
      "CMakeLists.txt",
      "cmake",
      "demos",
      "include",
      "scripts",
      "src",
      "stdlib",
      "tests",
      "tools"
    ],
    "rules": [
      {
        "id": "legacy-xrc",
        "path_regex": "(?i)(?:^|/)(?:xbytecode_io\\.[ch]|[^/]*\\.xrc)$",
        "text_regex": "(?i)(?:\\.xrc\\b|\\bXR_ARTIFACT_KIND_LEGACY_XRC\\b|\\bXrBcError\\b|\\bXR_BC_(?:MAGIC|VERSION|OK|ERR_[A-Z0-9_]+|STRIP_[A-Z0-9_]+)\\b|\\bXR_LEGACY_XRC_VERSION\\b|\\bxr_bytecode_[A-Za-z0-9_]+\\b|xbytecode_io)"
      },
      {
        "id": "legacy-vm",
        "path_regex": "(?i)(?:^|/)(?:xray_vm\\.h|xvm(?:_[^/]*)?\\.[ch]|xvm_[^/]*\\.inc\\.c)$",
        "text_regex": "(?i)(?:\\bxray_vm_[A-Za-z0-9_]+\\b|\\bXr(?:VMRuntime|VMConfig|VMBackendType|BytecodeModule|BytecodeBundle)\\b|\\bxr_vm_(?:interpret_proto|proto_[A-Za-z0-9_]+|run_closure_blocking|call_closure|prepare_entry)\\b)"
      },
      {
        "id": "legacy-opcode",
        "path_regex": "(?i)(?:^|/)xopcode_def\\.h$",
        "text_regex": "(?:\\bXrOpcode\\b|\\bOP_[A-Z][A-Z0-9_]+\\b|\\bXR_OPCODE_[A-Z0-9_]+\\b|xopcode_def\\.h)"
      },
      {
        "id": "legacy-tagged-frame",
        "path_regex": "(?i)(?:^|/)(?:xchunk\\.h|xinstruction\\.h)$",
        "text_regex": "(?:\\bXrBcCallFrame\\b|\\bXR_TAG_PLACE\\b|\\bmaxstacksize\\b|\\bXrValue\\s*(?:\\*+\\s*)?(?:base|registers|regs|slots|stack|stack_buf|stack_top)\\b)"
      },
      {
        "id": "legacy-xaot-plan",
        "path_regex": "(?!)",
        "text_regex": "\\bXaot[A-Za-z0-9_]*(?:Plan|Rep|Abi)\\b"
      }
    ]
  },
  "runtime_reachability": {
    "required_lanes": {
      "bytecode-flag-negative": "rejected-before-activation",
      "legacy-api-negative": "rejected-before-activation",
      "runtime-only-link": "linked-and-passed",
      "source-eval-negative": "rejected-before-activation",
      "xrc-negative": "rejected-before-activation",
      "xtp-positive": "activated-and-passed"
    }
  },
  "schema": 2,
  "symbols": {
    "forbidden_regex": "(?i)(?<![A-Za-z0-9_])_?(?:xray_vm_[A-Za-z0-9_]+|xr_vm_[A-Za-z0-9_]+|xr_(?:bytecode_[A-Za-z0-9_]+|detect_output_format|eval_bytecode|output_c_source|run_bytecode_file)|XrOpcode)\\b"
  },
  "validation": {
    "required_lanes": [
      "unit",
      "regression",
      "compile-error",
      "aot",
      "generated-c",
      "vm",
      "stdlib",
      "ffi",
      "coroutine",
      "concurrency",
      "contract",
      "asan-ubsan",
      "tsan",
      "fuzz",
      "model-stress",
      "portability",
      "performance",
      "runtime-embedding",
      "installer-package"
    ]
  }
}
