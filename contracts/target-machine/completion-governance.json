        "require_ninja_build",
        "raw_log_identity",
        "status\\s*=\\s*\"passed\"\\s+if\\s+passed\\s+else\\s+\"failed\""
      ]
    },
    {
      "id": "completion-evidence-assembler",
      "path": "scripts/assemble_target_machine_completion_evidence.py",
      "required_regex": [
        "ASSEMBLER\\s*=\\s*\"target-machine-completion-evidence-assembler/1\"",
        "validate_terminal_inventories",
        "run_final_verifier",
        "os\\.rename\\(temporary, output\\)"
      ]
    },
    {
      "id": "installed-evidence-producer",
      "path": "scripts/collect_target_machine_installed_evidence.py",
      "required_regex": [
        "PRODUCER\\s*=\\s*\"target-machine-installed-evidence/1\"",
        "run_install",
        "tree_inventory",
        "status\\s*=\\s*\"passed\"\\s+if\\s+passed\\s+else\\s+\"failed\"",
        "os\\.rename\\(staging, output\\)"
      ]
    },
    {
      "id": "exact-aot-sdk-closure",
      "path": "scripts/derive_aot_sdk_closure.py",
      "required_regex": [
        "GENERATOR\\s*=\\s*\"xray-aot-sdk-header-closure/1\"",
        "PRIVATE_ROOTS",
        "PUBLIC_ROOTS",
        "FORBIDDEN_PATH_RE",
        "FORBIDDEN_TEXT_RE"
      ]
    },
    {
      "id": "runtime-reachability-evidence-producer",
      "path": "scripts/collect_target_machine_runtime_reachability_evidence.py",
      "required_regex": [
        "PRODUCER\\s*=\\s*\"target-machine-runtime-reachability-evidence/1\"",
        "EXPECTED_RESULTS",
        "external_activation_canary",
        "raw_log_identity",
        "status\\s*=\\s*\"passed\"\\s+if\\s+all_ok\\s+else\\s+\"failed\"",
        "os\\.rename\\(staging, output\\)"
      ]
    },
    {
      "id": "matrix-evidence-producer",
      "path": "scripts/collect_target_machine_matrix_evidence.py",
      "required_regex": [
        "PRODUCER\\s*=\\s*\"target-machine-matrix-evidence/1\"",
        "validate_policy",
        "row_result_identity",
        "status\\s*=\\s*\"passed\"\\s+if\\s+all_ok\\s+else\\s+\"failed\"",
        "os\\.rename\\(staging, output\\)"
      ]
    },
    {
      "id": "semantic-schema-v26",
      "path": "src/plan/semantic/xr_semantic_ids.h",
      "required_regex": [
        "#define\\s+XR_SEMANTIC_SCHEMA_VERSION\\s+UINT32_C\\(26\\)"
      ]
    },
    {
      "id": "immutable-target-plan",
      "path": "src/plan/target/xr_target_plan.h",
      "required_regex": [
        "typedef\\s+struct\\s+XrTargetPlan\\s+XrTargetPlan",
        "xr_target_plan_is_frozen",
        "xr_target_plan_is_verified",
        "xr_target_plan_fingerprint"
      ]
    },
    {
      "id": "exact-xtp-artifact",
      "path": "src/plan/format/xr_xtp_schema.h",
      "required_regex": [
        "#define\\s+XR_XTP_SCHEMA_VERSION\\s+UINT32_C\\(24\\)",
        "XR_XTP_MAX_ARTIFACT_SIZE",
        "xr_xtp_decode_candidate"
      ]
    },
    {
      "id": "runtime-target-authority",
      "path": "src/runtime/abi/xr_runtime_target_authority.h",
      "required_regex": [
        "typedef\\s+struct\\s+XrRuntimeTargetAuthority",
        "xr_runtime_target_authority_native_hosted"
      ]
    },
    {
      "id": "runtime-artifact-authority",
      "path": "src/runtime/xr_runtime_artifact_verify.c",
      "required_regex": [
        "xr_runtime_artifact_authority_verify",
        "xr_runtime_artifact_authority_bind_candidate",
        "xr_runtime_artifact_authority_bind_plan",
        "independently verified TargetPlan"
      ]
    },
    {
      "id": "runtime-xtp-load-boundary",
      "path": "src/runtime/xr_target_plan_load.c",
      "required_regex": [
        "accepts only XTP v24 bytes",
        "xr_runtime_artifact_authority_bind_candidate",
        "xr_runtime_artifact_authority_bind_plan"
      ]
    }
  ],
  "checker": "target-machine-completion-governance/2",
  "dual_owner": {
    "inventory": "contracts/target-machine/semantic-owner-inventory.json",
    "mechanical_adapter": "representation adapter"
  },
  "evidence": {
