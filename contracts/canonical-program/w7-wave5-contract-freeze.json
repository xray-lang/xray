  "explicit_non_operations": {
    "physical_suspend_or_resume": "logical state edges and continuations in XrProgram; VM instruction offsets and native labels are private",
    "coroutine_complete": "typed return, error, panic or cancel terminal plus verified cleanup closure, not a second completion opcode",
    "provider_requirement": "sorted program metadata keyed by stable provider contract and operation identity",
    "provider_refusal": "instance admission or typed provider-call outcome, not an executable operation",
    "generation_create_or_rebind": "XrInstance lifecycle; generation never enters target-neutral XrProgram semantics",
    "generation_lease_or_drain": "XrInstance lifecycle around calls, continuations, callbacks and drops",
    "build_feature_query": "compile-time typed fact folded before XrProgram and included in semantic and cache fingerprints",
    "explicit_compile_time_target_namespace_read": "typed fact folded only in an explicitly compile-time-only target-specialized context before XrProgram; ordinary target.* reads remain CoreSpec operations in the target-neutral program",
    "host_target_probe": "forbidden semantic authority"
  },
  "logical_coroutine_program_contract": {
    "function_contract": "exact suspendability, typed effects and capabilities are closed before program writing",
    "state_rows": "stable logical state identity with pre, suspend, resume, error, panic, cancel and drop edges",
    "safepoints": "each suspend-capable operation names one logical safepoint and all continuation targets",
    "live_across": "ordered typed values plus ownership disposition and RootId obligations, never byte offsets or VM slots",
    "cleanup": "normal, error, panic and cancel paths prove exactly-once cleanup and drop closure",
    "open_targets": "publish a typed suspendability and provider obligation or fail before XrProgram; no provenance-free conservative boolean",
    "private_realization": "VM and AOT independently choose frame layout, spill placement, root maps and dispatch strategy"
  },
  "concurrency_contract": {
    "transfer": "READ, REF and MOVE rules remain the Wave 3 authority; cross-execution REF is rejected unless an explicit sharing contract admits it",
    "scheduler": "scheduler order is not canonical; CoreSpec defines allowed traces and refinement",
    "atomic": "type, width, operation and memory order must be admitted by immutable TargetProfile machine facts",
    "channel": "send and receive ownership, close state, cancellation, timeout and wakeup results are typed and independently verified",
    "structured_scope": "child creation, joining, linked failure, cancellation and cleanup obligations are explicit program facts"
  },
  "generation_provider_contract": {
    "program_requirements": "XrProgram stores sorted provider contract and operation requirements but no provider address, context or generation",
    "profile_contracts": "XrTargetProfile stores exact provider contracts and immutable target/runtime capability facts",
    "instance_binding": "XrInstance binds exact provider entries and one nonzero successor generation to one validated program/profile ExecutionId",
    "continuation_lifetime": "calls, suspended continuations, callbacks and drops hold an exact generation lease until completion",
    "reload": "successor generation creates a new instance; the old instance drains and is never mutated in place",
    "failure": "missing or mismatched contract, operation, behavior or non-virtualizable foreign capability fails before execution"
  },
