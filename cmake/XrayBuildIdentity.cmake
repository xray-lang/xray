# One identity capture supplies the compiled header and installed metadata.
function(xray_capture_build_identity source git)
    set(_commit "unknown")
    set(_dirty 0)
    if(EXISTS "${source}/.git")
        if(NOT git OR NOT EXISTS "${git}")
            message(FATAL_ERROR "Git is required to identify this source checkout")
        endif()
        execute_process(COMMAND "${git}" rev-parse --verify HEAD
            WORKING_DIRECTORY "${source}" RESULT_VARIABLE _result
            OUTPUT_VARIABLE _value OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE _error)
        string(LENGTH "${_value}" _length)
        if(NOT "${_result}" STREQUAL "0" OR NOT _length EQUAL 40 OR
           NOT _value MATCHES "^[0-9a-fA-F]+$")
            message(FATAL_ERROR "Cannot identify source HEAD: ${_error}")
        endif()
        string(TOLOWER "${_value}" _commit)
        execute_process(COMMAND "${git}" status --porcelain --untracked-files=normal
            WORKING_DIRECTORY "${source}" RESULT_VARIABLE _result
            OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE _error)
        if(NOT "${_result}" STREQUAL "0")
            message(FATAL_ERROR "Cannot determine source dirty state: ${_error}")
        endif()
        if(NOT _status STREQUAL "")
            set(_dirty 1)
        endif()
    endif()
    if(_dirty)
        set(_json true)
    else()
        set(_json false)
    endif()
    set(XRAY_GIT_COMMIT "${_commit}" PARENT_SCOPE)
    set(XRAY_GIT_DIRTY "${_dirty}" PARENT_SCOPE)
    set(XRAY_GIT_DIRTY_JSON "${_json}" PARENT_SCOPE)
endfunction()

# configure_file preserves output timestamps when the complete bytes match.
function(xray_render_build_identity source build)
    file(MAKE_DIRECTORY "${build}/generated/install")
    configure_file("${source}/cmake/xray_build_identity.h.in"
        "${build}/generated/xray_build_identity.h" @ONLY)
    configure_file("${source}/cmake/install-marker.json.in"
        "${build}/generated/install/install-marker.json" @ONLY)
    configure_file("${source}/cmake/GeneratePayloadManifest.cmake.in"
        "${build}/generated/install/GeneratePayloadManifest.cmake" @ONLY)
endfunction()

# Target order is needed even on the first build, before any include deps exist.
# Inspect configured source membership only; unrelated targets remain parallel.
function(xray_bind_identity_consumers directory)
    set(_identity_sources
        "${CMAKE_SOURCE_DIR}/src/app/cli/xcli_help.c"
        "${CMAKE_SOURCE_DIR}/src/app/cli/xcmd_toolchain.c"
        "${CMAKE_SOURCE_DIR}/src/app/toolchain/xtc_probe.c")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${_identity_sources}" _identity_sources)
    endif()
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type STREQUAL "UTILITY" OR _type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        get_target_property(_sources "${_target}" SOURCES)
        get_target_property(_source_dir "${_target}" SOURCE_DIR)
        foreach(_source IN LISTS _sources)
            if(_source MATCHES "\\$<")
                if(_source MATCHES "(xcli_help|xcmd_toolchain|xtc_probe)\\.c")
                    message(FATAL_ERROR "Identity source requires literal target membership: ${_target}")
                endif()
                continue()
            endif()
            cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${_source_dir}"
                NORMALIZE OUTPUT_VARIABLE _absolute)
            if(CMAKE_HOST_WIN32)
                string(TOLOWER "${_absolute}" _absolute)
            endif()
            if(_absolute IN_LIST _identity_sources)
                add_dependencies("${_target}" xray-build-identity-refresh)
                set_property(GLOBAL APPEND PROPERTY XRAY_BUILD_IDENTITY_CONSUMERS "${_target}")
                break()
            endif()
        endforeach()
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        xray_bind_identity_consumers("${_child}")
    endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    set(_source [==[@CMAKE_SOURCE_DIR@]==])
    if(_source MATCHES "^@[A-Za-z_]+@$")
        message(FATAL_ERROR "Identity refresh requires the configured script")
    endif()
    set(_build [==[@CMAKE_CURRENT_BINARY_DIR@]==])
    set(_git [==[@GIT_EXECUTABLE@]==])
    set(PROJECT_VERSION [==[@PROJECT_VERSION@]==])
    set(XRAY_RELEASE_TARGET [==[@XRAY_RELEASE_TARGET@]==])
    set(XRAY_BUILD_PROFILE [==[@XRAY_BUILD_PROFILE@]==])
    set(XRAY_TOOLCHAIN_PROTOCOL [==[@XRAY_TOOLCHAIN_PROTOCOL@]==])
    set(XRAY_PREFERRED_ZIG_VERSION [==[@XRAY_PREFERRED_ZIG_VERSION@]==])
    set(XRAY_REQUIRED_ZIG_RANGE [==[@XRAY_REQUIRED_ZIG_RANGE@]==])
    xray_capture_build_identity("${_source}" "${_git}")
    xray_render_build_identity("${_source}" "${_build}")
endif()
