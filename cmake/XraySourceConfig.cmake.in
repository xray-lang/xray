# This package exposes the public Source compiler/VM closure independently of the AOT runtime.
get_filename_component(_xray_source_root "${CMAKE_CURRENT_LIST_DIR}/../../xray/source-sdk" ABSOLUTE)
set(_xray_source_manifest "${_xray_source_root}/source_sdk_manifest.json")
if(NOT EXISTS "${_xray_source_manifest}" OR IS_SYMLINK "${_xray_source_manifest}")
    message(FATAL_ERROR "Missing Source SDK manifest")
endif()
file(SHA256 "${_xray_source_manifest}" _xray_source_digest)
if(NOT _xray_source_digest STREQUAL "@XR_SOURCE_MANIFEST_SHA256@")
    message(FATAL_ERROR "Source SDK manifest identity mismatch")
endif()
file(READ "${_xray_source_manifest}" _xray_source_record)
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Source SDK requires Windows x86_64")
endif()
string(JSON _xray_source_count LENGTH "${_xray_source_record}" files)
math(EXPR _xray_source_last "${_xray_source_count}-1")
foreach(index RANGE ${_xray_source_last})
    string(JSON _xray_source_path GET "${_xray_source_record}" files ${index} path)
    string(JSON _xray_source_hash GET "${_xray_source_record}" files ${index} sha256)
    string(JSON _xray_source_size GET "${_xray_source_record}" files ${index} length)
    set(_xray_source_file "${_xray_source_root}/${_xray_source_path}")
    if(NOT EXISTS "${_xray_source_file}" OR IS_DIRECTORY "${_xray_source_file}" OR IS_SYMLINK "${_xray_source_file}")
        message(FATAL_ERROR "Missing Source SDK member: ${_xray_source_path}")
    endif()
    file(SIZE "${_xray_source_file}" _xray_source_actual_size)
    file(SHA256 "${_xray_source_file}" _xray_source_actual_hash)
    if(NOT _xray_source_actual_size EQUAL _xray_source_size OR NOT _xray_source_actual_hash STREQUAL _xray_source_hash)
        message(FATAL_ERROR "Source SDK member identity mismatch: ${_xray_source_path}")
    endif()
endforeach()
if(NOT TARGET Xray::Source)
    add_library(Xray::Source INTERFACE IMPORTED)
    set_property(TARGET Xray::Source PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_xray_source_root}/include")
    string(JSON _xray_source_count LENGTH "${_xray_source_record}" archives)
    math(EXPR _xray_source_last "${_xray_source_count}-1")
    set(_xray_source_libraries)
    foreach(index RANGE ${_xray_source_last})
        string(JSON _xray_source_archive GET "${_xray_source_record}" archives ${index})
        list(APPEND _xray_source_libraries "${_xray_source_root}/${_xray_source_archive}")
    endforeach()
    list(APPEND _xray_source_libraries kernel32)
    set_property(TARGET Xray::Source PROPERTY INTERFACE_LINK_LIBRARIES "${_xray_source_libraries}")
endif()
