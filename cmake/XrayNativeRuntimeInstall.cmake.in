if(NOT "@_xnr_eligible@")
    message(FATAL_ERROR "XrayNativeRuntime requires qualified MSVC x64 Release MT SAN0")
endif()
execute_process(COMMAND "@XRAY_PYTHON@" -B
    "@PROJECT_SOURCE_DIR@/scripts/build_native_runtime_bundle.py"
    --root "@PROJECT_SOURCE_DIR@" --build "@CMAKE_BINARY_DIR@"
    --inputs "@_xnr_inputs@" --output "@_xnr_bundle@" --verify
    RESULT_VARIABLE _xnr_status)
if(NOT _xnr_status EQUAL 0)
    message(FATAL_ERROR "Native runtime bundle is missing, stale or unqualified")
endif()
file(TO_CMAKE_PATH "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" _xnr_prefix)
get_filename_component(_xnr_prefix "${_xnr_prefix}" ABSOLUTE)
set(_xnr_root "${_xnr_prefix}/lib/xray/native-runtime/@_xnr_tuple@")
set(_xnr_package "${_xnr_prefix}/lib/cmake/XrayNativeRuntime")
file(READ "@_xnr_bundle@/native_runtime_manifest.json" _xnr_json)
string(JSON _xnr_count LENGTH "${_xnr_json}" files)
math(EXPR _xnr_last "${_xnr_count}-1")
set(_xnr_members native_runtime_manifest.json)
foreach(_xnr_index RANGE 0 ${_xnr_last})
    string(JSON _xnr_path GET "${_xnr_json}" files ${_xnr_index} path)
    list(APPEND _xnr_members "${_xnr_path}")
endforeach()
function(_xnr_existing directory members)
    if(NOT EXISTS "${directory}")
        return()
    endif()
    file(REAL_PATH "${directory}" directory_real)
    if(NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}" OR
       NOT directory_real STREQUAL directory)
        message(FATAL_ERROR "Native runtime destination directory is indirect or nonregular")
    endif()
    set(allowed_directories)
    foreach(member IN LISTS members)
        get_filename_component(parent "${member}" DIRECTORY)
        if(NOT parent STREQUAL "")
            list(APPEND allowed_directories "${parent}")
        endif()
    endforeach()
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${directory}" "${directory}/*")
    foreach(entry IN LISTS entries)
        set(path "${directory}/${entry}")
        file(REAL_PATH "${path}" real)
        if(IS_SYMLINK "${path}" OR NOT real STREQUAL path)
            message(FATAL_ERROR "Native runtime destination is indirect: ${entry}")
        endif()
        if(IS_DIRECTORY "${path}")
            if(NOT entry IN_LIST allowed_directories)
                message(FATAL_ERROR "Native runtime destination has an unlisted directory: ${entry}")
            endif()
        elseif(NOT entry IN_LIST members)
            message(FATAL_ERROR "Native runtime destination has an unlisted member: ${entry}")
        endif()
    endforeach()
endfunction()
_xnr_existing("${_xnr_root}" "${_xnr_members}")
_xnr_existing("${_xnr_package}" "XrayNativeRuntimeConfig.cmake;XrayNativeRuntimeConfigVersion.cmake")
# Remove the old publication point before replacing any authenticated member.
file(REMOVE "${_xnr_package}/XrayNativeRuntimeConfig.cmake")
foreach(_xnr_index RANGE 0 ${_xnr_last})
    string(JSON _xnr_path GET "${_xnr_json}" files ${_xnr_index} path)
    get_filename_component(_xnr_parent "${_xnr_path}" DIRECTORY)
    file(INSTALL DESTINATION "${_xnr_root}/${_xnr_parent}" TYPE FILE
        FILES "@_xnr_bundle@/${_xnr_path}")
endforeach()
file(INSTALL DESTINATION "${_xnr_root}" TYPE FILE
    FILES "@_xnr_bundle@/native_runtime_manifest.json")
file(INSTALL DESTINATION "${_xnr_package}" TYPE FILE
    FILES "@_xnr_bundle@/XrayNativeRuntimeConfigVersion.cmake")
file(INSTALL DESTINATION "${_xnr_package}" TYPE FILE
    FILES "@_xnr_bundle@/XrayNativeRuntimeConfig.cmake")
