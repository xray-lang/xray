# The digest authenticates matching artifacts, not a signed publisher.
set(_xnr_version "${CMAKE_CURRENT_LIST_DIR}/XrayNativeRuntimeConfigVersion.cmake")
file(REAL_PATH "${_xnr_version}" _xnr_version_real)
if(NOT EXISTS "${_xnr_version}" OR IS_DIRECTORY "${_xnr_version}" OR
   IS_SYMLINK "${_xnr_version}" OR NOT _xnr_version_real STREQUAL _xnr_version)
    message(FATAL_ERROR "XrayNativeRuntime package version missing or indirect")
endif()
file(SHA256 "${_xnr_version}" _xnr_version_hash)
if(NOT _xnr_version_hash STREQUAL "@VERSION_SHA256@")
    message(FATAL_ERROR "XrayNativeRuntime package version identity mismatch")
endif()
get_filename_component(_xnr_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_xnr_root "${_xnr_prefix}/lib/xray/native-runtime/abi1/x86_64-windows-msvc/msvc-release-mt-san0")
set(_xnr_manifest "${_xnr_root}/native_runtime_manifest.json")
if(NOT EXISTS "${_xnr_manifest}" OR IS_DIRECTORY "${_xnr_manifest}" OR IS_SYMLINK "${_xnr_manifest}")
    message(FATAL_ERROR "XrayNativeRuntime manifest missing or indirect")
endif()
file(SHA256 "${_xnr_manifest}" _xnr_digest)
if(NOT _xnr_digest STREQUAL "@MANIFEST_SHA256@")
    message(FATAL_ERROR "XrayNativeRuntime manifest identity mismatch")
endif()
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "XrayNativeRuntime requires x64 Release")
endif()
foreach(_xnr_language C CXX)
    if(CMAKE_${_xnr_language}_COMPILER_LOADED)
        if(NOT CMAKE_${_xnr_language}_COMPILER_ID STREQUAL "MSVC" OR
           NOT CMAKE_${_xnr_language}_COMPILER_VERSION STREQUAL "19.44.35219.0" OR
           NOT CMAKE_${_xnr_language}_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
            message(FATAL_ERROR "XrayNativeRuntime provider or architecture mismatch")
        endif()
    endif()
endforeach()
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded")
    message(FATAL_ERROR "XrayNativeRuntime requires MultiThreaded")
endif()
get_cmake_property(_xnr_variables VARIABLES)
foreach(_xnr_variable IN LISTS _xnr_variables)
    if(_xnr_variable MATCHES "^CMAKE_(C|CXX)_FLAGS")
        if("${${_xnr_variable}}" MATCHES "[/-](fsanitize|clang:|fp:fast)|-ffast-math")
            message(FATAL_ERROR "XrayNativeRuntime rejects sanitizer or fast flags")
        endif()
    endif()
endforeach()
file(READ "${_xnr_manifest}" _xnr_json)
foreach(_xnr_pair "schema;1" "abi;1" "namespace;xray-native-runtime-c" "target;x86_64-windows-msvc" "provider;MSVC" "version;19.44.35219.0" "profile;Release" "crt;MT" "sanitizers;0")
    list(GET _xnr_pair 0 _xnr_key)
    list(GET _xnr_pair 1 _xnr_value)
    string(JSON _xnr_actual GET "${_xnr_json}" "${_xnr_key}")
    if(NOT _xnr_actual STREQUAL _xnr_value)
        message(FATAL_ERROR "XrayNativeRuntime tuple mismatch: ${_xnr_key}")
    endif()
endforeach()
string(JSON _xnr_count LENGTH "${_xnr_json}" files)
math(EXPR _xnr_last "${_xnr_count}-1")
set(_xnr_members)
foreach(_xnr_index RANGE 0 ${_xnr_last})
    string(JSON _xnr_path GET "${_xnr_json}" files ${_xnr_index} path)
    if(_xnr_path MATCHES "(^/|^[A-Za-z]:|\\\\|(^|/)\\.\\.?(/|$)|//)" OR _xnr_path IN_LIST _xnr_members)
        message(FATAL_ERROR "XrayNativeRuntime unsafe or duplicate member")
    endif()
    list(APPEND _xnr_members "${_xnr_path}")
    set(_xnr_file "${_xnr_root}/${_xnr_path}")
    file(REAL_PATH "${_xnr_file}" _xnr_real)
    if(NOT _xnr_real STREQUAL _xnr_file OR NOT EXISTS "${_xnr_file}" OR
       IS_DIRECTORY "${_xnr_file}" OR IS_SYMLINK "${_xnr_file}")
        message(FATAL_ERROR "XrayNativeRuntime member missing or indirect: ${_xnr_path}")
    endif()
    file(SHA256 "${_xnr_file}" _xnr_hash)
    file(SIZE "${_xnr_file}" _xnr_size)
    string(JSON _xnr_expected_hash GET "${_xnr_json}" files ${_xnr_index} sha256)
    string(JSON _xnr_expected_size GET "${_xnr_json}" files ${_xnr_index} length)
    if(NOT _xnr_hash STREQUAL _xnr_expected_hash OR NOT _xnr_size EQUAL _xnr_expected_size)
        message(FATAL_ERROR "XrayNativeRuntime member identity mismatch: ${_xnr_path}")
    endif()
endforeach()
set(_xnr_runtime_files "${_xnr_members};native_runtime_manifest.json")
set(_xnr_runtime_directories)
foreach(_xnr_member IN LISTS _xnr_runtime_files)
    get_filename_component(_xnr_parent "${_xnr_member}" DIRECTORY)
    if(NOT _xnr_parent STREQUAL "")
        list(APPEND _xnr_runtime_directories "${_xnr_parent}")
    endif()
endforeach()
file(GLOB_RECURSE _xnr_observed LIST_DIRECTORIES true RELATIVE "${_xnr_root}" "${_xnr_root}/*")
foreach(_xnr_entry IN LISTS _xnr_observed)
    if(IS_DIRECTORY "${_xnr_root}/${_xnr_entry}")
        if(NOT _xnr_entry IN_LIST _xnr_runtime_directories)
            message(FATAL_ERROR "XrayNativeRuntime unlisted runtime directory: ${_xnr_entry}")
        endif()
    elseif(NOT _xnr_entry IN_LIST _xnr_runtime_files)
        message(FATAL_ERROR "XrayNativeRuntime unlisted runtime member: ${_xnr_entry}")
    endif()
endforeach()
file(GLOB_RECURSE _xnr_package_entries LIST_DIRECTORIES true
    RELATIVE "${CMAKE_CURRENT_LIST_DIR}" "${CMAKE_CURRENT_LIST_DIR}/*")
foreach(_xnr_entry IN LISTS _xnr_package_entries)
    set(_xnr_entry_path "${CMAKE_CURRENT_LIST_DIR}/${_xnr_entry}")
    file(REAL_PATH "${_xnr_entry_path}" _xnr_entry_real)
    if(IS_DIRECTORY "${_xnr_entry_path}" OR IS_SYMLINK "${_xnr_entry_path}" OR
       NOT _xnr_entry_real STREQUAL _xnr_entry_path)
        message(FATAL_ERROR "XrayNativeRuntime indirect or nonregular package member")
    endif()
    if(NOT _xnr_entry STREQUAL "XrayNativeRuntimeConfig.cmake" AND
       NOT _xnr_entry STREQUAL "XrayNativeRuntimeConfigVersion.cmake")
        message(FATAL_ERROR "XrayNativeRuntime unlisted package member: ${_xnr_entry}")
    endif()
endforeach()
string(JSON _xnr_count LENGTH "${_xnr_json}" archives)
file(READ "${_xnr_root}/native_runtime_recipe.json" _xnr_recipe)
string(JSON _xnr_recipe_count LENGTH "${_xnr_recipe}" archives)
if(NOT _xnr_recipe_count EQUAL _xnr_count)
    message(FATAL_ERROR "XrayNativeRuntime recipe archive count mismatch")
endif()
math(EXPR _xnr_last "${_xnr_count}-1")
set(_xnr_libraries)
foreach(_xnr_index RANGE 0 ${_xnr_last})
    string(JSON _xnr_path GET "${_xnr_json}" archives ${_xnr_index})
    string(JSON _xnr_recipe_path GET "${_xnr_recipe}" archives ${_xnr_index} file)
    if(NOT _xnr_path STREQUAL _xnr_recipe_path)
        message(FATAL_ERROR "XrayNativeRuntime recipe archive order mismatch")
    endif()
    if(NOT _xnr_path IN_LIST _xnr_members OR NOT _xnr_path MATCHES "^lib/[^/]+\\.lib$")
        message(FATAL_ERROR "XrayNativeRuntime unlisted archive")
    endif()
    list(APPEND _xnr_libraries "${_xnr_root}/${_xnr_path}")
endforeach()
list(LENGTH _xnr_libraries _xnr_count)
list(REMOVE_DUPLICATES _xnr_libraries)
list(LENGTH _xnr_libraries _xnr_unique)
if(NOT _xnr_count EQUAL _xnr_unique OR _xnr_count EQUAL 0)
    message(FATAL_ERROR "XrayNativeRuntime duplicate or empty archive order")
endif()
if(TARGET Xray::NativeRuntime)
    get_target_property(_xnr_existing Xray::NativeRuntime XRAY_NATIVE_IDENTITY)
    get_target_property(_xnr_existing_root Xray::NativeRuntime XRAY_NATIVE_ROOT)
    if(NOT _xnr_existing STREQUAL _xnr_digest OR NOT _xnr_existing_root STREQUAL _xnr_root)
        message(FATAL_ERROR "XrayNativeRuntime imported target identity conflict")
    endif()
    return()
endif()
add_library(Xray::NativeRuntime INTERFACE IMPORTED)
set_target_properties(Xray::NativeRuntime PROPERTIES
    XRAY_NATIVE_IDENTITY "${_xnr_digest}" XRAY_NATIVE_ROOT "${_xnr_root}"
    INTERFACE_INCLUDE_DIRECTORIES "${_xnr_root}/include"
    INTERFACE_LINK_LIBRARIES "${_xnr_libraries}"
    INTERFACE_COMPILE_OPTIONS "/FI${_xnr_root}/include/xray_native_runtime_consumer.h"
    INTERFACE_COMPILE_FEATURES "c_std_11;cxx_std_17")
