/*
 * Canonical compiler-owned contracts for embedded builtin type members.
 * Source declarations carry signatures only; effects live here as typed data.
 * XA_NATIVE_MEMBER_CONTRACT(type, member, is_static, allocation, effect, errors_csv)
 */

/* stdlib/types/array.xr */
XA_NATIVE_MEMBER_CONTRACT("Array", "withCapacity", true, XA_ALLOCATION_CONTRACT_MAY_HEAP, XA_EFFECT_CONTRACT_MISSING, "")

