 *
 * xbuiltin_receiver_method.def - Canonical receiver-specialized builtin methods.
 *
 * X-Macro format:
 *   XB_RECEIVER_METHOD(id, source_name, receiver, result, p0, p1, p2,
 *                      param_count, min_params, type_params, effect, allocation,
 *                      unsafe_requirement, lowering)
 *   XB_RECEIVER_VARIADIC_METHOD(...) uses the same fields and marks the
 *                      final parameter as variadic rest input.
 */

#ifndef XB_RECEIVER_METHOD
#error "Define XB_RECEIVER_METHOD before including xbuiltin_receiver_method.def"
#endif
#ifndef XB_RECEIVER_VARIADIC_METHOD
#error "Define XB_RECEIVER_VARIADIC_METHOD before including xbuiltin_receiver_method.def"
#endif

/* --- Array<U8> methods --- */
XB_RECEIVER_METHOD(U8_ARRAY_APPEND_FROM, "appendFrom", XA_BUILTIN_RECEIVER_U8_ARRAY,
                   XA_BUILTIN_TYPE_U8_ARRAY, XA_BUILTIN_TYPE_U8_SLICE, XA_BUILTIN_TYPE_NONE,
                   XA_BUILTIN_TYPE_NONE, 1, 1, XA_BUILTIN_TYPE_PARAMS_NONE,
                   XA_BUILTIN_EFFECT_MUTATES_RECEIVER, XA_BUILTIN_ALLOCATION_MAY_HEAP,
                   XA_BUILTIN_UNSAFE_NONE, "xi.byte.array.copy.from")
XB_RECEIVER_METHOD(U8_ARRAY_REPEAT_FROM, "repeatFrom", XA_BUILTIN_RECEIVER_U8_ARRAY,
                   XA_BUILTIN_TYPE_U8_ARRAY, XA_BUILTIN_TYPE_INT, XA_BUILTIN_TYPE_INT,
                   XA_BUILTIN_TYPE_NONE, 2, 2, XA_BUILTIN_TYPE_PARAMS_NONE,
                   XA_BUILTIN_EFFECT_MUTATES_RECEIVER, XA_BUILTIN_ALLOCATION_MAY_HEAP,
                   XA_BUILTIN_UNSAFE_NONE, "xi.byte.array.repeat.from")
XB_RECEIVER_METHOD(U8_ARRAY_RESIZE, "resize", XA_BUILTIN_RECEIVER_U8_ARRAY,
                   XA_BUILTIN_TYPE_U8_ARRAY, XA_BUILTIN_TYPE_INT, XA_BUILTIN_TYPE_U8,
                   XA_BUILTIN_TYPE_NONE, 2, 1, XA_BUILTIN_TYPE_PARAMS_NONE,
                   XA_BUILTIN_EFFECT_MUTATES_RECEIVER, XA_BUILTIN_ALLOCATION_MAY_HEAP,
                   XA_BUILTIN_UNSAFE_NONE, "array.resize")

