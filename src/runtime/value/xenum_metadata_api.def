/*
 * Public enum metadata surface.
 *
 * This file is deliberately macro-only.  It is consumed by language tooling
 * and scripts/gen_api_inventory.py so completion, hover, knowledge, and the
 * machine-readable API inventory cannot silently disagree about descriptor
 * names or their allocation/profile contracts.
 *
 * TYPE(kind, source_name, summary, profile, effect, allocation)
 * PROPERTY(kind, source_name, result_type, summary, profile, effect, allocation)
 * STATIC_PROPERTY(source_name, result_type, summary, profile, effect, allocation)
 */

XR_ENUM_METADATA_TYPE(VARIANTS, EnumVariants,
                      "Read-only declaration-order view of an enum's variant descriptors.",
                      "all", "pure", "none")
XR_ENUM_METADATA_TYPE(VARIANT, EnumVariant,
                      "Typed descriptor for one declared enum variant; never an enum value.",
                      "all", "pure", "none")
XR_ENUM_METADATA_TYPE(PAYLOADS, EnumPayloads,
                      "Read-only declaration-order view of one variant's payload fields.",
                      "all", "pure", "none")
XR_ENUM_METADATA_TYPE(PAYLOAD_FIELD, EnumPayloadField,
                      "Typed descriptor for one declared payload field.",
                      "all", "pure", "none")

XR_ENUM_METADATA_PROPERTY(VARIANTS, length, "i64",
                          "Number of declared variants in the owning enum.",
                          "all", "pure", "none")

XR_ENUM_METADATA_PROPERTY(VARIANT, ordinal, "i64",
                          "Zero-based declaration ordinal of this variant.",
                          "all", "pure", "none")
XR_ENUM_METADATA_PROPERTY(VARIANT, name, "string",
                          "Declared variant name; retains the cold name sidecar when used.",
                          "hosted-or-name-metadata", "pure", "materializes-string")
XR_ENUM_METADATA_PROPERTY(VARIANT, payloadCount, "i64",
                          "Number of declared payload fields.",
                          "all", "pure", "none")
XR_ENUM_METADATA_PROPERTY(VARIANT, isUnit, "bool",
                          "Whether this variant has no payload fields.",
                          "all", "pure", "none")
XR_ENUM_METADATA_PROPERTY(VARIANT, payloads, "EnumPayloads<E>",
                          "Read-only declaration-order view of this variant's payload fields.",
                          "profile-with-payload-metadata", "pure", "none")

XR_ENUM_METADATA_PROPERTY(PAYLOADS, length, "i64",
                          "Number of payload fields in the selected variant.",
                          "profile-with-payload-metadata", "pure", "none")

XR_ENUM_METADATA_PROPERTY(PAYLOAD_FIELD, index, "i64",
                          "Zero-based declaration index of this payload field.",
                          "profile-with-payload-metadata", "pure", "none")
XR_ENUM_METADATA_PROPERTY(PAYLOAD_FIELD, name, "string",
                          "Declared payload field name; retains the cold name sidecar when used.",
                          "hosted-or-name-metadata", "pure", "materializes-string")
XR_ENUM_METADATA_PROPERTY(PAYLOAD_FIELD, type, "i64",
                          "Canonical TypeId token for the concrete payload field type.",
                          "profile-with-type-metadata", "pure", "none")

XR_ENUM_STATIC_PROPERTY(variants, "EnumVariants<E>",
                        "Read-only declaration-order variant descriptor view for a concrete enum.",
                        "all", "pure", "none")
