/* Scalar operations have no executor-specific representation or call protocol. */
XR_LIR_OP(CONST, "const", 0)
XR_LIR_OP(ADD, "add", 2)
XR_LIR_OP(SUB, "sub", 2)
XR_LIR_OP(MUL, "mul", 2)
XR_LIR_OP(NEG, "neg", 1)
XR_LIR_OP(DIV, "div", 2)
XR_LIR_OP(REM, "rem", 2)
XR_LIR_OP(FADD, "fadd", 2)
XR_LIR_OP(FSUB, "fsub", 2)
XR_LIR_OP(FMUL, "fmul", 2)
XR_LIR_OP(FDIV, "fdiv", 2)
XR_LIR_OP(FNEG, "fneg", 1)
XR_LIR_OP(ICMP, "icmp", 2)
XR_LIR_OP(FCMP, "fcmp", 2)
XR_LIR_OP(INTCAST, "intcast", 1)
XR_LIR_OP(ITOF, "itof", 1)
XR_LIR_OP(FCAST, "fcast", 1)
/* A Cell owns scalar storage in the defining ordinary function activation. */
XR_LIR_OP(CELL_NEW, "cell_new", 1)
XR_LIR_OP(CELL_READ, "cell_read", 1)
XR_LIR_OP(CELL_WRITE, "cell_write", 2)
XR_LIR_OP(CALL, "call", -1)
XR_LIR_OP(CALL_INTRINSIC, "call_intrinsic", -1)
XR_LIR_OP(BR, "br", 0)
XR_LIR_OP(CONDBR, "condbr", 1)
XR_LIR_OP(RET, "ret", -1)
/* The module owns these immutable bytes; this is not a general pointer constant. */
XR_LIR_OP(LITERAL_ADDR, "literal_addr", 0)
XR_LIR_OP(STRING_LITERAL, "string_literal", 0)
XR_LIR_OP(STRING_I64, "string_i64", 1)
XR_LIR_OP(STRING_CONCAT, "string_concat", 2)
XR_LIR_OP(STRING_RETAIN, "string_retain", 1)
XR_LIR_OP(STRING_DROP, "string_drop", 1)
XR_LIR_OP(STRING_CELL_DROP, "string_cell_drop", 1)
XR_LIR_OP(STRING_PRINT, "string_print", 1)
XR_LIR_OP(STRING_LEN, "string_len", 1)
XR_LIR_OP(STRING_F64, "string_f64", 1)
XR_LIR_OP(FTOI, "ftoi", 1)
/* State capabilities belong to the execution, independently of call frames. */
XR_LIR_OP(MODULE_BEGIN, "module_begin", 1)
XR_LIR_OP(MODULE_READY, "module_ready", 1)
XR_LIR_OP(STATE_CONSTRUCT, "state_construct", -1)
XR_LIR_OP(STATE_PUBLISH, "state_publish", 1)
XR_LIR_OP(STATE_INITIALIZE, "state_initialize", -1)
XR_LIR_OP(STATE_REFERENCE, "state_reference", 1)
XR_LIR_OP(STATE_READ, "state_read", 1)
XR_LIR_OP(STATE_WRITE, "state_write", -1)
/* Array owners use the canonical value kernel; Cells stay in their activation. */
XR_LIR_OP(ARRAY_RETAIN, "array_retain", 1)
XR_LIR_OP(ARRAY_DROP, "array_drop", 1)
XR_LIR_OP(ARRAY_CELL_DROP, "array_cell_drop", 1)
/* Borrowing preserves the actual mutable binding without reading its value. */
XR_LIR_OP(ARRAY_BORROW, "array_borrow", 1)
XR_LIR_OP(ARRAY_REF_READ, "array_ref_read", 1)
XR_LIR_OP(ARRAY_REF_WRITE, "array_ref_write", 2)
/* Fixed aggregates are unboxed values. GET retains its bounds trap even when
 * the result is unused; receiver evaluation precedes that instruction. */
XR_LIR_OP(FIXED_ARRAY_NEW, "fixed_array_new", -1)
XR_LIR_OP(FIXED_ARRAY_GET, "fixed_array_get", 2)
/* Nullable values carry one presence byte and their exact inline payload. */
XR_LIR_OP(NULLABLE_NONE, "nullable_none", 0)
XR_LIR_OP(NULLABLE_SOME, "nullable_some", -1)
XR_LIR_OP(NULLABLE_IS_SOME, "nullable_is_some", 1)
XR_LIR_OP(NULLABLE_UNWRAP, "nullable_unwrap", 1)
