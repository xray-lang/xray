/* Scalar operations have no executor-specific representation or call protocol. */
XR_LIR_OP(CONST, "const", 0)
XR_LIR_OP(ADD, "add", 2)
XR_LIR_OP(SUB, "sub", 2)
XR_LIR_OP(MUL, "mul", 2)
XR_LIR_OP(NEG, "neg", 1)
XR_LIR_OP(DIV, "div", 2)
XR_LIR_OP(REM, "rem", 2)
XR_LIR_OP(FADD, "fadd", 2)
XR_LIR_OP(FSUB, "fsub", 2)
XR_LIR_OP(FMUL, "fmul", 2)
XR_LIR_OP(FDIV, "fdiv", 2)
XR_LIR_OP(FNEG, "fneg", 1)
XR_LIR_OP(ICMP, "icmp", 2)
XR_LIR_OP(FCMP, "fcmp", 2)
XR_LIR_OP(INTCAST, "intcast", 1)
XR_LIR_OP(ITOF, "itof", 1)
XR_LIR_OP(FCAST, "fcast", 1)
/* Builtin Cells name activation storage. Constructed Cell types retain their
 * canonical binding through the explicit callable scope owner. */
XR_LIR_OP(CELL_NEW, "cell_new", 1)
XR_LIR_OP(CELL_READ, "cell_read", 1)
XR_LIR_OP(CELL_WRITE, "cell_write", 2)
XR_LIR_OP(CALL, "call", -1)
XR_LIR_OP(CALL_INTRINSIC, "call_intrinsic", -1)
XR_LIR_OP(BR, "br", 0)
XR_LIR_OP(CONDBR, "condbr", 1)
XR_LIR_OP(RET, "ret", -1)
/* The module owns these immutable bytes; this is not a general pointer constant. */
XR_LIR_OP(LITERAL_ADDR, "literal_addr", 0)
XR_LIR_OP(STRING_LITERAL, "string_literal", 0)
XR_LIR_OP(STRING_I64, "string_i64", 1)
XR_LIR_OP(STRING_CONCAT, "string_concat", 2)
XR_LIR_OP(STRING_RETAIN, "string_retain", 1)
XR_LIR_OP(STRING_DROP, "string_drop", 1)
XR_LIR_OP(STRING_CELL_DROP, "string_cell_drop", 1)
XR_LIR_OP(STRING_PRINT, "string_print", 1)
XR_LIR_OP(STRING_LEN, "string_len", 1)
XR_LIR_OP(STRING_BYTE_LEN, "string_byte_len", 1)
XR_LIR_OP(STRING_F64, "string_f64", 1)
XR_LIR_OP(FTOI, "ftoi", 1)
/* State capabilities belong to the execution, independently of call frames. */
XR_LIR_OP(MODULE_BEGIN, "module_begin", 1)
XR_LIR_OP(MODULE_READY, "module_ready", 1)
XR_LIR_OP(STATE_CONSTRUCT, "state_construct", -1)
XR_LIR_OP(STATE_PUBLISH, "state_publish", 1)
XR_LIR_OP(STATE_INITIALIZE, "state_initialize", -1)
XR_LIR_OP(STATE_REFERENCE, "state_reference", 1)
XR_LIR_OP(STATE_READ, "state_read", 1)
XR_LIR_OP(STATE_WRITE, "state_write", -1)
/* Array owners use the canonical value kernel; Cells stay in their activation. */
XR_LIR_OP(ARRAY_RETAIN, "array_retain", 1)
XR_LIR_OP(ARRAY_DROP, "array_drop", 1)
XR_LIR_OP(ARRAY_CELL_DROP, "array_cell_drop", 1)
/* Borrowing preserves the actual mutable binding without reading its value. */
XR_LIR_OP(ARRAY_BORROW, "array_borrow", 1)
XR_LIR_OP(ARRAY_REF_READ, "array_ref_read", 1)
XR_LIR_OP(ARRAY_REF_WRITE, "array_ref_write", 2)
/* Fixed aggregates are unboxed values. GET retains its bounds trap even when
 * the result is unused; receiver evaluation precedes that instruction. */
XR_LIR_OP(FIXED_ARRAY_NEW, "fixed_array_new", -1)
XR_LIR_OP(FIXED_ARRAY_GET, "fixed_array_get", 2)
/* Nullable values carry one presence byte and their exact inline payload. */
XR_LIR_OP(NULLABLE_NONE, "nullable_none", 0)
XR_LIR_OP(NULLABLE_SOME, "nullable_some", -1)
XR_LIR_OP(NULLABLE_IS_SOME, "nullable_is_some", 1)
XR_LIR_OP(NULLABLE_UNWRAP, "nullable_unwrap", 1)
/* Retired activation opcodes are invalid; keep their ordinals for rejection. */
XR_LIR_OP(VIEW_FRAME_ENTER, "view_frame_enter", 0)
XR_LIR_OP(VIEW_FRAME_LEAVE, "view_frame_leave", 1)
/* Function values bind an exact code declaration and its actual environment. */
XR_LIR_OP(FUNCTION_REF, "function_ref", -1)
XR_LIR_OP(CALL_INDIRECT, "call_indirect", -1)
/* Scope handles borrow one actual synchronous lexical or temporary owner. */
XR_LIR_OP(FUNCTION_SCOPE_ENTER, "function_scope_enter", -1)
XR_LIR_OP(FUNCTION_SCOPE_LEAVE, "function_scope_leave", -1)
XR_LIR_OP(FUNCTION_BIND, "function_bind", 2)
XR_LIR_OP(STATE_GROUP_INITIALIZE, "state_group_initialize", -1)
XR_LIR_OP(FUNCTION_WEAKEN, "function_weaken", 1)
/* bits names a local Slice resource target, not a readable SSA operand. */
XR_LIR_OP(SLICE_CLEANUP, "slice_cleanup", 0)
XR_LIR_OP(SLICE_FORMAL_CLEANUP, "slice_formal_cleanup", 0)
XR_LIR_OP(MAP_RETAIN, "map_retain", 1)
XR_LIR_OP(MAP_DROP, "map_drop", 1)
XR_LIR_OP(MAP_CELL_DROP, "map_cell_drop", 1)
XR_LIR_OP(MAP_BORROW, "map_borrow", 1)
XR_LIR_OP(MAP_REF_READ, "map_ref_read", 1)
XR_LIR_OP(MAP_REF_WRITE, "map_ref_write", 2)
XR_LIR_OP(MAP_LITERAL_NEW, "map_literal_new", -1)
/* Canonical boxes preserve their exact constructed identity through copies. */
XR_LIR_OP(VALUE_RETAIN, "value_retain", 1)
XR_LIR_OP(VALUE_DROP, "value_drop", 1)
/* Both nominal records and structural Tuples use these inline field operations. */
XR_LIR_OP(RECORD_NEW, "record_new", -1)
XR_LIR_OP(RECORD_FIELD, "record_field", 1)
XR_LIR_OP(CLASS_NEW, "class_new", -1)
XR_LIR_OP(CLASS_FIELD, "class_field", 1)
XR_LIR_OP(CLASS_ARRAY_WRITE, "class_array_write", 2)
XR_LIR_OP(CLASS_ARRAY_PUSH, "class_array_push", 2)

/* Exact Set<i64> roles, independent of Map intrinsic identity. */
XR_LIR_OP(SET_NEW, "set_new", 0)
XR_LIR_OP(SET_LEN, "set_len", 1)
XR_LIR_OP(SET_CONTAINS, "set_contains", 2)
XR_LIR_OP(SET_DISPLAY, "set_display", 1)
XR_LIR_OP(SET_ADD, "set_add", 2)
XR_LIR_OP(SET_REMOVE, "set_remove", 2)
XR_LIR_OP(SET_CLEAR, "set_clear", 1)
XR_LIR_OP(SET_RETAIN, "set_retain", 1)
XR_LIR_OP(SET_DROP, "set_drop", 1)
XR_LIR_OP(SET_CELL_DROP, "set_cell_drop", 1)
XR_LIR_OP(SET_BORROW, "set_borrow", 1)
XR_LIR_OP(SET_REF_READ, "set_ref_read", 1)
XR_LIR_OP(SET_REF_WRITE, "set_ref_write", 2)
/* Both operands are evaluated before this effect, including on success. */
XR_LIR_OP(ASSERT_CONDITION, "assert_condition", 2)
XR_LIR_OP(I64_TRY_PARSE, "i64_try_parse", 1)
XR_LIR_OP(F64_TRY_PARSE, "f64_try_parse", 1)
XR_LIR_OP(BOOL_TRY_PARSE, "bool_try_parse", 1)

/* A Class-identity union value is one nominal managed handle. ADOPT retains the
 * existing header and only changes the static class identity; the runtime
 * discriminant is the header's immutable per-class ops, never a tag byte. */
XR_LIR_OP(CLASS_ADOPT, "class_adopt", 1)
/* Tests that runtime nominal identity against bits (one placed class type). */
XR_LIR_OP(CLASS_IS, "class_is", 1)
/* A tagged sum keeps one stored tag and one active variant payload. SUM_NEW
 * names its variant in bits and its complete payload fields as operands;
 * SUM_TAG reads the declaration-order tag as i64; SUM_GET names one flattened
 * payload field in bits. Payload fields are owner-free in this phase. */
XR_LIR_OP(SUM_NEW, "sum_new", -1)
XR_LIR_OP(SUM_TAG, "sum_tag", 1)
XR_LIR_OP(SUM_GET, "sum_get", 1)
/* Strings compare by content: length first, then the complete bytes, so an
 * embedded NUL is part of the value rather than a terminator. EQ and NE are
 * the only predicates; ordered comparison stays unimplemented. */
XR_LIR_OP(STRING_EQUAL, "string_equal", 2)
XR_LIR_OP(CLASS_SCALAR_WRITE, "class_scalar_write", 2)
/* Calls the registered host leaf in bits with its exact number of borrowed Path strings. */
XR_LIR_OP(HOST_PATH_BOOL, "host_path_bool", -1)
XR_LIR_OP(HOST_FILE_OPEN_WRITE, "host_file_open_write", 2)
XR_LIR_OP(HOST_FILE_CLOSE, "host_file_close", 1)
XR_LIR_OP(HOST_FILE_WRITE, "host_file_write", 3)
XR_LIR_OP(HOST_PATH_CLASS, "host_path_class", 1)
XR_LIR_OP(HOST_FILE_READ, "host_file_read", 2)
XR_LIR_OP(HOST_ENV_GET, "host_env_get", 1)
XR_LIR_OP(HOST_TEXT_RESULT, "host_text_result", 1)
/* A registered directory operation consumes a Path String borrow or a root token. */
XR_LIR_OP(HOST_DIRECTORY, "host_directory", 1)
XR_LIR_OP(STRING_SLICE, "string_slice", 3)
/* Replaces occurrences into a new String; bits selects all matches. */
XR_LIR_OP(STRING_REPLACE, "string_replace", 3)
XR_LIR_OP(STRING_INDEX_OF, "string_index_of", 3)
XR_LIR_OP(STRING_LAST_INDEX_OF, "string_last_index_of", 2)
/* One ordered comparison over two live String borrows; predicate is LT..GE. */
XR_LIR_OP(STRING_ORDER, "string_order", 2)
/* One predicate over two live String borrows; bits is the test selector. */
XR_LIR_OP(STRING_TEST, "string_test", 2)
XR_LIR_OP(INVOKE, "invoke", -1)
XR_LIR_OP(RETURN_ERROR, "return_error", 1)
XR_LIR_OP(PANIC_ERROR, "panic_error", 1)
XR_LIR_OP(UNCAUGHT_ERROR, "uncaught_error", 1)
/* Bit operations preserve the exact left operand width. Shift counts are
 * independent integer operands and use their low six bits. */
XR_LIR_OP(BIT_AND, "bit_and", 2)
XR_LIR_OP(BIT_OR, "bit_or", 2)
XR_LIR_OP(BIT_XOR, "bit_xor", 2)
XR_LIR_OP(SHL, "shl", 2)
XR_LIR_OP(SHR, "shr", 2)
/* A proved zero divisor has drained its active synchronous cleanup frontier. */
XR_LIR_OP(ARITHMETIC_PANIC, "arithmetic_panic", 0)
