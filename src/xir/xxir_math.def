/* Fixed operation identities; signatures are checked against governed math declarations. */
XR_XIR_MATH_UNARY(ABS,1,"__abs",fabs)
XR_XIR_MATH_INTEGER(FLOOR,2,"__floor",floor)
XR_XIR_MATH_INTEGER(CEIL,3,"__ceil",ceil)
XR_XIR_MATH_INTEGER(ROUND,4,"__round",round)
XR_XIR_MATH_UNARY(SQRT,5,"__sqrt",sqrt)
XR_XIR_MATH_BINARY(POW,6,"__pow",pow)
XR_XIR_MATH_UNARY(SIN,7,"__sin",sin)
XR_XIR_MATH_UNARY(COS,8,"__cos",cos)
XR_XIR_MATH_UNARY(TAN,9,"__tan",tan)
XR_XIR_MATH_UNARY(ASIN,10,"__asin",asin)
XR_XIR_MATH_UNARY(ACOS,11,"__acos",acos)
XR_XIR_MATH_UNARY(ATAN,12,"__atan",atan)
XR_XIR_MATH_BINARY(ATAN2,13,"__atan2",atan2)
XR_XIR_MATH_UNARY(LOG,14,"__log",log)
XR_XIR_MATH_UNARY(LOG10,15,"__log10",log10)
XR_XIR_MATH_UNARY(LOG2,16,"__log2",log2)
XR_XIR_MATH_UNARY(EXP,17,"__exp",exp)
XR_XIR_MATH_ENTROPY(RANDOM,18,"__random",F64)
XR_XIR_MATH_ENTROPY(RANDOM_INT,19,"__randomInt",I64)
XR_XIR_MATH_UNARY(SINH,20,"__sinh",sinh)
XR_XIR_MATH_UNARY(COSH,21,"__cosh",cosh)
XR_XIR_MATH_UNARY(TANH,22,"__tanh",tanh)
XR_XIR_MATH_BINARY(HYPOT,23,"__hypot",hypot)
XR_XIR_MATH_UNARY(CBRT,24,"__cbrt",cbrt)
XR_XIR_MATH_INTEGER(TRUNC,25,"__trunc",trunc)
XR_XIR_MATH_BINARY(FMOD,26,"__fmod",fmod)
XR_XIR_MATH_UNARY(LOG1P,27,"__log1p",log1p)
XR_XIR_MATH_UNARY(EXPM1,28,"__expm1",expm1)
