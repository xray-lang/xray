add_library(xray_cli_toolchain_config STATIC
    "${CMAKE_CURRENT_LIST_DIR}/xcli_toolchain_config.c"
    "${CMAKE_CURRENT_LIST_DIR}/../toolchain/xtc_model.c")
target_link_libraries(xray_cli_toolchain_config PUBLIC xray_xir_source)
if(TARGET xray_toolchain_process)
    target_link_libraries(xray_cli_toolchain_config PUBLIC xray_toolchain_process)
endif()
if(WIN32)
    add_library(xray_cli_native_probe STATIC "${CMAKE_CURRENT_LIST_DIR}/xcli_native_probe.c")
    target_link_libraries(xray_cli_native_probe PUBLIC xray_source_compile xray_xir_native_projection
        xray_xir_local_toolchain xray_xir_native_admission xray_cli_toolchain_config)
    target_compile_features(xray_cli_native_probe PUBLIC c_std_11)
    set_target_properties(xray_cli_native_probe PROPERTIES C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
    target_compile_definitions(xray_cli_native_probe PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _CRT_SECURE_NO_WARNINGS)
    if(MSVC)
        target_compile_options(xray_cli_native_probe PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(xray_cli_native_probe PRIVATE -Wall -Wextra -Werror)
    endif()
    add_library(xray_cli_toolchain_update STATIC "${CMAKE_CURRENT_LIST_DIR}/xcli_toolchain_update.c")
    target_link_libraries(xray_cli_toolchain_update PUBLIC xray_cli_toolchain_config xray_xir_publication)
    target_compile_features(xray_cli_toolchain_update PUBLIC c_std_11)
    set_target_properties(xray_cli_toolchain_update PROPERTIES C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
    target_compile_definitions(xray_cli_toolchain_update PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    if(MSVC)
        target_compile_options(xray_cli_toolchain_update PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(xray_cli_toolchain_update PRIVATE -Wall -Wextra -Werror)
    endif()
endif()
target_include_directories(xray_cli_toolchain_config PUBLIC "${PROJECT_SOURCE_DIR}/src")
target_compile_features(xray_cli_toolchain_config PUBLIC c_std_11)
set_target_properties(xray_cli_toolchain_config PROPERTIES C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
if(MSVC)
    target_compile_options(xray_cli_toolchain_config PRIVATE /W4 /WX /utf-8)
else()
    target_compile_options(xray_cli_toolchain_config PRIVATE -Wall -Wextra -Werror)
endif()
