; AOT ABI source.
; This file describes how AOT function boundaries carry Xray types.

(define-aot-abi int
  :type-kind XR_KIND_INT
  :nullable no
  :abi-class scalar
  :default-rep i64
  :native-width yes
  :typed-boundary yes)

(define-aot-abi float
  :type-kind XR_KIND_FLOAT
  :nullable no
  :abi-class scalar
  :default-rep f64
  :native-width yes
  :typed-boundary yes)

(define-aot-abi bool
  :type-kind XR_KIND_BOOL
  :nullable no
  :abi-class scalar
  :default-rep bool
  :native-width no
  :typed-boundary yes)

(define-aot-abi unit
  :type-kind XR_KIND_UNIT
  :nullable no
  :abi-class void
  :default-rep void
  :native-width no
  :typed-boundary no)

(define-aot-abi string
  :type-kind XR_KIND_STRING
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :native-width no
  :typed-boundary yes)

(define-aot-abi array
  :type-kind XR_KIND_ARRAY
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :native-width no
  :typed-boundary yes)

(define-aot-abi map
  :type-kind XR_KIND_MAP
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :native-width no
  :typed-boundary yes)

(define-aot-abi set
  :type-kind XR_KIND_SET
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :native-width no
  :typed-boundary yes)

(define-aot-abi tuple
  :type-kind XR_KIND_TUPLE
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :native-width no
  :typed-boundary yes)

; FFI raw pointer (RawPtr<T> / RawMut<T>). Carried as an address-width integer
; so the GC never traces it; the FFI boundary casts int64 <-> the real C pointer
; type. Native (non-tagged) boundary, exactly like the other scalars.
(define-aot-abi pointer
  :type-kind XR_KIND_POINTER
  :nullable no
  :abi-class scalar
  :default-rep i64
  :native-width no
  :typed-boundary yes)
