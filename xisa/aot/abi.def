; AOT ABI source.
; This file describes how AOT function boundaries carry Xray types.

(define-aot-abi int
  :type-kind XR_KIND_INT
  :nullable no
  :abi-class scalar
  :default-rep i64
  :scalar-rep yes
  :typed-boundary yes)

(define-aot-abi float
  :type-kind XR_KIND_FLOAT
  :nullable no
  :abi-class scalar
  :default-rep f64
  :scalar-rep yes
  :typed-boundary yes)

(define-aot-abi bool
  :type-kind XR_KIND_BOOL
  :nullable no
  :abi-class scalar
  :default-rep bool
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi unit
  :type-kind XR_KIND_UNIT
  :nullable no
  :abi-class void
  :default-rep void
  :scalar-rep no
  :typed-boundary no)

(define-aot-abi string
  :type-kind XR_KIND_STRING
  :nullable no
  :abi-class tagged
  :default-rep tagged
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi array
  :type-kind XR_KIND_ARRAY
  :nullable no
  :abi-class tagged
  :default-rep tagged
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi slice
  :type-kind XR_KIND_SLICE
  :nullable no
  :abi-class aggregate
  :default-rep slice
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi map
  :type-kind XR_KIND_MAP
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi set
  :type-kind XR_KIND_SET
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi tuple
  :type-kind XR_KIND_TUPLE
  :nullable no
  :abi-class pointer
  :default-rep ptr
  :scalar-rep no
  :typed-boundary yes)

(define-aot-abi struct_object
  :type-kind XR_KIND_STRUCT_OBJECT
  :nullable yes
  :abi-class tagged
  :default-rep tagged
  :scalar-rep no
  :typed-boundary no)

; FFI raw pointer (Ptr<T> / MutPtr<T>). Carried as a native C pointer in AOT
; hot code, but never treated as an owning/GC-traced pointer. Tagged/VM boundaries
; still encode it as an address-width integer so VM and AOT value semantics align.
(define-aot-abi pointer
  :type-kind XR_KIND_POINTER
  :nullable no
  :abi-class scalar
  :default-rep rawptr
  :scalar-rep no
  :typed-boundary yes)
