; AOT layout source.
; This file describes how native struct/class fields are carried in generated C.

(define-aot-layout i8
  :native-type XR_NATIVE_I8
  :field-kind scalar
  :rep i8
  :c-type "int8_t"
  :heap-field yes
  :ref-tag none)

(define-aot-layout u8
  :native-type XR_NATIVE_U8
  :field-kind scalar
  :rep u8
  :c-type "uint8_t"
