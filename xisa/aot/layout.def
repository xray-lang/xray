  :ref-tag none)

(define-aot-layout array-ref
  :native-type XR_NATIVE_ARRAY_REF
  :field-kind pointer-ref
  :rep tagged
  :c-type "xrt_array_t *"
  :heap-field yes
  :ref-tag XR_TAG_ARRAY)

(define-aot-layout map-ref
  :native-type XR_NATIVE_MAP_REF
