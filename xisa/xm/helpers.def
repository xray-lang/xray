# xisa/xm/helpers.def — JIT runtime helper registry (single truth source)
#
# Replaces the hand-written XM_HELPER_DEF X-macro in xm_helper_table.h.
# xisagen generates xm_helpers_gen.h (enum XmHelperId + XmHelperMeta table).
#
# Format:
#   XM_HELPER(NAME, NARGS, RET_REP, FLAGS, PTR_TRUST, POST_CALL)
#
#   NAME     C function suffix after "xr_jit_" (lowercase)
#   NARGS    call_arg_pool arguments consumed (NOT counting coro, extra_arg ABI)
#   RET_REP  return representation:
#              TAGGED — XrJitResult, dynamic tag in x1
#              PTR    — always returns a GC pointer
#              I64    — always returns int64 (also used for bool)
#              F64    — always returns float64
#              VOID   — no meaningful return value
#   FLAGS    bitwise OR of:
#              GC | DEOPT | THROW | SUSPEND |
#              ENTER_VM | USER_CODE | STACKMAP  (or NONE)
#   PTR_TRUST  pointer provenance:
#              NONE      — helper does not expose a GC/runtime pointer result
#              GC        — helper result is runtime-managed when pointer-typed
#              EXTERNAL  — helper can expose an external pointer
#   POST_CALL  post-call checks required after the helper returns:
#              DEOPT | THROW | SUSPEND  (or NONE)

# ===== Call / Invoke =====
XM_HELPER(call_self,           0, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(call_func,           0, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(invoke_method,       0, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(invoke_direct,       0, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(closure_new,         0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(closure_set_upval,   0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(upval_get,           0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(upval_set,           0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(upval_cell_get,      0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(upval_cell_set,      0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(cell_new,            0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(cell_get_direct,     0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(cell_set_direct,     0, VOID,   NONE,                                     NONE, NONE)

# ===== Arithmetic (mixed-type fallback) =====
XM_HELPER(rt_add,              2, TAGGED, GC|STACKMAP,                              GC,   NONE)
XM_HELPER(rt_sub,              2, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(rt_mul,              2, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(rt_div,              2, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(rt_mod,              2, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(rt_eq,               2, I64,    NONE,                                     NONE, NONE)
XM_HELPER(eq_value,            2, I64,    NONE,                                     NONE, NONE)

# ===== Property Access =====
XM_HELPER(getprop,             1, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(setprop,             2, VOID,   GC|ENTER_VM|USER_CODE|STACKMAP,       NONE, NONE)
XM_HELPER(getfield_ic,         0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(getbuiltin,          0, TAGGED, NONE,                                     GC,   NONE)

# ===== Index / Container Access =====
XM_HELPER(index_get,           2, TAGGED, GC|DEOPT|ENTER_VM|USER_CODE|STACKMAP, GC,   DEOPT)
XM_HELPER(index_set,           3, VOID,   GC|ENTER_VM|USER_CODE|STACKMAP,       NONE, NONE)
XM_HELPER(tarray_get,          2, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(tarray_set,          3, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(map_get,             2, TAGGED, GC|STACKMAP,                              GC,   NONE)
XM_HELPER(map_set,             3, VOID,   GC|STACKMAP,                              NONE, NONE)
XM_HELPER(map_increment,       2, VOID,   GC|STACKMAP,                              NONE, NONE)

# ===== Shared Variables =====
XM_HELPER(get_shared,          0, TAGGED, GC|STACKMAP,                              GC,   NONE)
XM_HELPER(set_shared,          1, VOID,   GC|STACKMAP,                              NONE, NONE)

# ===== Reference Counting (compile-time RC: dup / drop) =====
# Mirror the VM OP_DUP / OP_DROP dispatch. The value (with its tag) is passed
# in call_args[0]; the helper reconstructs the XrValue and, when it is a heap
# pointer, adjusts the refcount. drop runs the destructor and returns the
# block to the per-coroutine RC freelist on the last reference. No GC, no
# throw, no deopt — pure refcount arithmetic.
XM_HELPER(rc_dup,              1, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(rc_drop,             1, VOID,   NONE,                                     NONE, NONE)
# drop_reuse: drop the object; if RC reaches zero, return reclaimed pointer
# (reuse token) instead of freeing. Returns 0 (NULL) if object still alive.
XM_HELPER(rc_drop_reuse,       1, PTR,    GC|STACKMAP,                              GC,   NONE)
# alloc_at: allocate using reuse token (arg[0]) if non-NULL, else fresh alloc.
# extra_arg = (gc_type << 16) | alloc_size. Returns newly initialized object.
XM_HELPER(rc_alloc_at,         1, PTR,    GC|STACKMAP,                              GC,   NONE)

# ===== Exception =====
XM_HELPER(throw,               1, VOID,   THROW|STACKMAP,                           NONE, THROW)

# ===== Type Operations =====
XM_HELPER(is_type,             1, I64,    NONE,                                     NONE, NONE)
XM_HELPER(checktype,           1, I64,    NONE,                                     NONE, NONE)
XM_HELPER(typename,            1, PTR,    NONE,                                     GC,   NONE)
XM_HELPER(typeof,              1, I64,    NONE,                                     NONE, NONE)
XM_HELPER(deep_copy,           1, PTR,    GC|STACKMAP,                              GC,   NONE)

# ===== String Operations =====
XM_HELPER(chr,                 0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(substring,           0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(str_repeat,          0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(tostring,            1, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(strbuf_new,          0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(strbuf_append,       0, VOID,   GC|STACKMAP,                              NONE, NONE)
XM_HELPER(strbuf_finish,       0, PTR,    GC|STACKMAP,                              GC,   NONE)

# ===== Struct Native Storage =====
XM_HELPER(new_struct,          0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(struct_get,          0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(struct_set,          0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(struct_copy,         0, PTR,    GC|STACKMAP,                              GC,   NONE)

# ===== Container Construction =====
XM_HELPER(rt_array_new,        0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(rt_array_push,       0, VOID,   GC|STACKMAP,                              NONE, NONE)
XM_HELPER(rt_array_len,        0, I64,    NONE,                                     NONE, NONE)
XM_HELPER(rt_map_new,          0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(newrange,            0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(range_unpack,        0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(newset,              0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(slice,               0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(bytes_new,           0, PTR,    GC|STACKMAP,                              GC,   NONE)

# ===== Enum =====
XM_HELPER(enum_access,         0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(enum_name,           0, PTR,    NONE,                                     GC,   NONE)
XM_HELPER(enum_convert,        0, TAGGED, NONE,                                     GC,   NONE)

# ===== IO / Debug =====
XM_HELPER(print,               0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(dump,                0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(assert,              1, VOID,   THROW|STACKMAP,                           NONE, THROW)
XM_HELPER(assert_eq,           2, VOID,   THROW|STACKMAP,                           NONE, THROW)
XM_HELPER(assert_ne,           2, VOID,   THROW|STACKMAP,                           NONE, THROW)

# ===== Channel / Concurrency =====
XM_HELPER(chan_new,             0, PTR,    GC|STACKMAP,                              GC,   NONE)
XM_HELPER(chan_close,           0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(chan_is_closed,       0, I64,    NONE,                                     NONE, NONE)
XM_HELPER(chan_try_send,        0, I64,    NONE,                                     NONE, NONE)
XM_HELPER(chan_try_recv,        0, TAGGED, NONE,                                     GC,   NONE)
XM_HELPER(chan_send,            0, TAGGED, GC|SUSPEND|ENTER_VM|STACKMAP,             GC,   SUSPEND)
XM_HELPER(chan_send_block,      0, VOID,   SUSPEND|ENTER_VM|STACKMAP,                NONE, SUSPEND)
XM_HELPER(chan_recv,            0, TAGGED, GC|SUSPEND|ENTER_VM|STACKMAP,             GC,   SUSPEND)
XM_HELPER(chan_recv_block,      0, VOID,   SUSPEND|ENTER_VM|STACKMAP,                NONE, SUSPEND)
XM_HELPER(scope_enter,         0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(scope_exit,          0, VOID,   NONE,                                     NONE, NONE)
XM_HELPER(go,                  0, TAGGED, GC|SUSPEND|ENTER_VM|USER_CODE|STACKMAP,   GC,   SUSPEND)
XM_HELPER(await,               0, TAGGED, SUSPEND|ENTER_VM|STACKMAP,                GC,   SUSPEND)
XM_HELPER(await_block,         0, VOID,   SUSPEND|ENTER_VM|STACKMAP,                NONE, SUSPEND)
