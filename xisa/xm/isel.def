# xisa/xm/isel.def — XmOp → machine instruction selection mapping
#
# Declarative mapping from high-level Xm IR opcodes (ops.def) to concrete
# machine instructions (*.isa files) for each target architecture.
#
# FORMAT:
#   ISEL(xm_op, target, pattern, mcinsn, [notes])
#
# FIELDS:
#   xm_op    XmOp name without XM_ prefix (must exist in ops.def)
#   target   x64 | arm64 | riscv64
#   pattern  Lowering pattern (see below)
#   mcinsn   Primary machine instruction(s), comma-separated
#   notes    Optional: quirks, constraints, or multi-insn sequences
#
# PATTERNS:
#   GP_RR_COMM     2-op commutative GP:  rd = op(rd_or_arg0, arg1)
#   GP_RR          2-op non-commutative: rd = op(arg0, arg1) [x64: mov+op]
#   GP_RRR         3-op GP:              rd = op(rs1, rs2)   [arm64/riscv64]
#   GP_R           1-op GP unary:        rd = op(arg0)
#   FP_RR_COMM     2-op commutative FP
#   FP_RR          2-op non-commutative FP
#   FP_RRR         3-op FP
#   FP_R           1-op FP unary
#   CMP_RR_CC      GP compare + condition code → setcc/cset/slt
#   FCMP_RR_CC     FP compare + condition code
#   CONV           Type conversion (i2f, f2i)
#   MEM_LOAD       Load from [base + disp]
#   MEM_STORE      Store to [base + disp]
#   CALL_HELPER    Lowered as runtime helper call
#   CUSTOM         Hand-written handler (too complex for a pattern)
#
# NOTES ON ARCHITECTURE DIFFERENCES:
#   - x64:     destructive 2-operand ISA, needs mov+op for non-commutative
#              shifts require CL register; div/mod uses RAX:RDX + IDIV
#   - arm64:   clean 3-operand ISA, most ops are single-insn
#              no hardware trap on integer div-by-zero (returns 0)
#   - riscv64: clean 3-operand ISA, similar to arm64
#              no hardware trap on integer div-by-zero (returns -1 or dividend)
#              hardware FNEG (fsgnjn.d), no XOR sign-bit trick needed
#
# Generator output: xm_isel_gen.h (validation table + coverage report)

# ═══════════════════════════════════════════════════════════════════════
# Integer Arithmetic
# ═══════════════════════════════════════════════════════════════════════

ISEL(ADD,  x64,     GP_RR_COMM,  x64.add.rr)
ISEL(ADD,  arm64,   GP_RRR,      arm64.add.rrr)
ISEL(ADD,  riscv64, GP_RRR,      riscv64.add)

ISEL(SUB,  x64,     GP_RR,       x64.sub.rr)
ISEL(SUB,  arm64,   GP_RRR,      arm64.sub.rrr)
ISEL(SUB,  riscv64, GP_RRR,      riscv64.sub)

ISEL(MUL,  x64,     GP_RR_COMM,  x64.imul.rr)
ISEL(MUL,  arm64,   GP_RRR,      arm64.mul.rrr)
ISEL(MUL,  riscv64, GP_RRR,      riscv64.mul)

ISEL(DIV,  x64,     CUSTOM,      x64.idiv.r,          "RAX:RDX sequence + div-by-zero guard + INT64_MIN/-1 wrap")
ISEL(DIV,  arm64,   GP_RRR,      arm64.sdiv.rrr,      "no trap on div-by-zero (returns 0)")
ISEL(DIV,  riscv64, GP_RRR,      riscv64.div,          "no trap on div-by-zero (returns -1)")

ISEL(MOD,  x64,     CUSTOM,      x64.idiv.r,          "same as DIV, result in RDX")
ISEL(MOD,  arm64,   CUSTOM,      arm64.sdiv.rrr+arm64.msub.rrrr, "rd = rn - (rn/rm)*rm")
ISEL(MOD,  riscv64, GP_RRR,      riscv64.rem,          "hardware remainder instruction")

ISEL(NEG,  x64,     GP_R,        x64.neg.r)
ISEL(NEG,  arm64,   GP_RRR,      arm64.sub.rrr,       "SUB rd, XZR, rm")
ISEL(NEG,  riscv64, GP_RRR,      riscv64.sub,          "SUB rd, x0, rs")

# ═══════════════════════════════════════════════════════════════════════
# Bitwise Logic
# ═══════════════════════════════════════════════════════════════════════

ISEL(AND,  x64,     GP_RR_COMM,  x64.and.rr)
ISEL(AND,  arm64,   GP_RRR,      arm64.and.rrr)
ISEL(AND,  riscv64, GP_RRR,      riscv64.and)

ISEL(OR,   x64,     GP_RR_COMM,  x64.or.rr)
ISEL(OR,   arm64,   GP_RRR,      arm64.orr.rrr)
ISEL(OR,   riscv64, GP_RRR,      riscv64.or)

ISEL(XOR,  x64,     GP_RR_COMM,  x64.xor.rr)
ISEL(XOR,  arm64,   GP_RRR,      arm64.eor.rrr)
ISEL(XOR,  riscv64, GP_RRR,      riscv64.xor)

ISEL(NOT,  x64,     GP_R,        x64.not.r)
ISEL(NOT,  arm64,   GP_RRR,      arm64.mvn.rr,        "ORN rd, XZR, rm")
ISEL(NOT,  riscv64, GP_RRR,      riscv64.xori,         "XORI rd, rs, -1")

ISEL(SHL,  x64,     CUSTOM,      x64.shl.rcl,         "shift count must be in CL")
ISEL(SHL,  arm64,   GP_RRR,      arm64.lsl.rrr)
ISEL(SHL,  riscv64, GP_RRR,      riscv64.sll)

ISEL(SHR,  x64,     CUSTOM,      x64.sar.rcl,         "shift count must be in CL")
ISEL(SHR,  arm64,   GP_RRR,      arm64.asr.rrr)
ISEL(SHR,  riscv64, GP_RRR,      riscv64.sra)

# ═══════════════════════════════════════════════════════════════════════
# Float Arithmetic
# ═══════════════════════════════════════════════════════════════════════

ISEL(FADD, x64,     FP_RR_COMM,  x64.addsd)
ISEL(FADD, arm64,   FP_RRR,      arm64.fadd)
ISEL(FADD, riscv64, FP_RRR,      riscv64.fadd.d)

ISEL(FSUB, x64,     FP_RR,       x64.subsd)
ISEL(FSUB, arm64,   FP_RRR,      arm64.fsub)
ISEL(FSUB, riscv64, FP_RRR,      riscv64.fsub.d)

ISEL(FMUL, x64,     FP_RR_COMM,  x64.mulsd)
ISEL(FMUL, arm64,   FP_RRR,      arm64.fmul)
ISEL(FMUL, riscv64, FP_RRR,      riscv64.fmul.d)

ISEL(FDIV, x64,     FP_RR,       x64.divsd)
ISEL(FDIV, arm64,   FP_RRR,      arm64.fdiv)
ISEL(FDIV, riscv64, FP_RRR,      riscv64.fdiv.d)

ISEL(FNEG, x64,     CUSTOM,      x64.xorpd,           "XOR sign bit with 0x8000000000000000")
ISEL(FNEG, arm64,   FP_R,        arm64.fneg)
ISEL(FNEG, riscv64, FP_R,        riscv64.fsgnjn.d, "pseudo: fneg.d rd, rs = fsgnjn.d rd, rs, rs")

# ═══════════════════════════════════════════════════════════════════════
# Type Conversion
# ═══════════════════════════════════════════════════════════════════════

ISEL(I2F,  x64,     CONV,        x64.cvtsi2sd)
ISEL(I2F,  arm64,   CONV,        arm64.scvtf)
ISEL(I2F,  riscv64, CONV,        riscv64.fcvt.d.l)

ISEL(F2I,  x64,     CONV,        x64.cvttsd2si)
ISEL(F2I,  arm64,   CONV,        arm64.fcvtzs)
ISEL(F2I,  riscv64, CONV,        riscv64.fcvt.l.d)

# ═══════════════════════════════════════════════════════════════════════
# Integer Comparison
# ═══════════════════════════════════════════════════════════════════════
# x64:     CMP + SETcc (one handler for all 6 conditions)
# arm64:   CMP + CSET  (one handler for all 6 conditions)
# riscv64: SLT/SLTU + branch or XOR-based for EQ/NE

ISEL(EQ,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=E")
ISEL(EQ,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=EQ")
ISEL(EQ,   riscv64, CMP_RR_CC,   riscv64.sub+riscv64.sltiu, "rd = (rs1-rs2) == 0 → sub+sltiu(1)")

ISEL(NE,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=NE")
ISEL(NE,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=NE")
ISEL(NE,   riscv64, CMP_RR_CC,   riscv64.sub+riscv64.sltu, "rd = (rs1-rs2) != 0 → sub+sltu(x0,rd)")

ISEL(LT,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=L")
ISEL(LT,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=LT")
ISEL(LT,   riscv64, GP_RRR,      riscv64.slt)

ISEL(LE,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=LE")
ISEL(LE,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=LE")
ISEL(LE,   riscv64, CMP_RR_CC,   riscv64.slt+riscv64.xori, "!(rs2 < rs1) → slt(tmp,rs2,rs1)+xori(rd,tmp,1)")

ISEL(GT,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=G")
ISEL(GT,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=GT")
ISEL(GT,   riscv64, GP_RRR,      riscv64.slt,             "swap operands: slt(rd, rs2, rs1)")

ISEL(GE,   x64,     CMP_RR_CC,   x64.cmp.rr+x64.setcc,  "cc=GE")
ISEL(GE,   arm64,   CMP_RR_CC,   arm64.cmp.rr+arm64.cset, "cc=GE")
ISEL(GE,   riscv64, CMP_RR_CC,   riscv64.slt+riscv64.xori, "!(rs1 < rs2) → slt(tmp,rs1,rs2)+xori(rd,tmp,1)")

# ═══════════════════════════════════════════════════════════════════════
# Float Comparison
# ═══════════════════════════════════════════════════════════════════════
# x64:     UCOMISD + SETcc with NaN-aware parity flag handling
# arm64:   FCMP + CSET with correct NaN semantics
# riscv64: FEQ.D/FLT.D/FLE.D return 0/1 in GPR — single instruction

ISEL(FEQ,  x64,     FCMP_RR_CC,  x64.ucomisd+x64.setcc, "E && NP")
ISEL(FEQ,  arm64,   FCMP_RR_CC,  arm64.fcmp+arm64.cset,  "cc=EQ")
ISEL(FEQ,  riscv64, GP_RRR,      riscv64.feq.d)

ISEL(FNE,  x64,     FCMP_RR_CC,  x64.ucomisd+x64.setcc, "NE || P")
ISEL(FNE,  arm64,   FCMP_RR_CC,  arm64.fcmp+arm64.cset,  "cc=NE")
ISEL(FNE,  riscv64, CMP_RR_CC,   riscv64.feq.d+riscv64.xori, "feq+xori(rd,rd,1)")

ISEL(FLT,  x64,     FCMP_RR_CC,  x64.ucomisd+x64.setcc, "B")
ISEL(FLT,  arm64,   FCMP_RR_CC,  arm64.fcmp+arm64.cset,  "cc=MI")
ISEL(FLT,  riscv64, GP_RRR,      riscv64.flt.d)

ISEL(FLE,  x64,     FCMP_RR_CC,  x64.ucomisd+x64.setcc, "BE")
ISEL(FLE,  arm64,   FCMP_RR_CC,  arm64.fcmp+arm64.cset,  "cc=LS")
ISEL(FLE,  riscv64, GP_RRR,      riscv64.fle.d)

# ═══════════════════════════════════════════════════════════════════════
# Tagged Value / Box / Unbox
# ═══════════════════════════════════════════════════════════════════════

ISEL(BOX_I64,   x64,     CUSTOM, -, "tag encoding: imm OR + shift")
ISEL(BOX_I64,   arm64,   CUSTOM, -, "tag encoding: movk + orr")
ISEL(BOX_I64,   riscv64, CUSTOM, -, "tag encoding: lui + or")

ISEL(BOX_F64,   x64,     CUSTOM, -, "move f64 bits to GPR, apply tag")
ISEL(BOX_F64,   arm64,   CUSTOM, -, "fmov to GPR, apply tag")
ISEL(BOX_F64,   riscv64, CUSTOM, -, "fmv.x.d to GPR, apply tag")

ISEL(UNBOX_I64, x64,     CUSTOM, -, "shift/mask to strip tag")
ISEL(UNBOX_I64, arm64,   CUSTOM, -, "shift/mask to strip tag")
ISEL(UNBOX_I64, riscv64, CUSTOM, -, "shift/mask to strip tag")

ISEL(UNBOX_F64, x64,     CUSTOM, -, "mask tag, movq to XMM")
ISEL(UNBOX_F64, arm64,   CUSTOM, -, "mask tag, fmov to FP reg")
ISEL(UNBOX_F64, riscv64, CUSTOM, -, "mask tag, fmv.d.x to FP reg")

# ═══════════════════════════════════════════════════════════════════════
# Memory Access
# ═══════════════════════════════════════════════════════════════════════

ISEL(LOAD,       x64,     MEM_LOAD,  x64.mov.rm,        "64-bit load; F64 uses movsd.rm")
ISEL(LOAD,       arm64,   MEM_LOAD,  arm64.ldr,         "64-bit load; F64 uses fldr")
ISEL(LOAD,       riscv64, MEM_LOAD,  riscv64.ld,         "64-bit load; F64 uses fld")

ISEL(STORE,      x64,     MEM_STORE, x64.mov.mr,        "64-bit store; F64 uses movsd.mr")
ISEL(STORE,      arm64,   MEM_STORE, arm64.str,         "64-bit store; F64 uses fstr")
ISEL(STORE,      riscv64, MEM_STORE, riscv64.sd,         "64-bit store; F64 uses fsd")

ISEL(LOAD8Z,     x64,     MEM_LOAD,  x64.movzx.rm8)
ISEL(LOAD8Z,     arm64,   MEM_LOAD,  arm64.ldrb)
ISEL(LOAD8Z,     riscv64, MEM_LOAD,  riscv64.lbu)

ISEL(LOAD8S,     x64,     MEM_LOAD,  x64.movsx.rm8)
ISEL(LOAD8S,     arm64,   MEM_LOAD,  arm64.ldrsb)
ISEL(LOAD8S,     riscv64, MEM_LOAD,  riscv64.lb)

ISEL(STORE8,     x64,     MEM_STORE, x64.mov.mr8)
ISEL(STORE8,     arm64,   MEM_STORE, arm64.strb)
ISEL(STORE8,     riscv64, MEM_STORE, riscv64.sb)

ISEL(LOAD16Z,    x64,     MEM_LOAD,  x64.movzx.rm16)
ISEL(LOAD16Z,    arm64,   MEM_LOAD,  arm64.ldrh)
ISEL(LOAD16Z,    riscv64, MEM_LOAD,  riscv64.lhu)

ISEL(LOAD16S,    x64,     MEM_LOAD,  x64.movsx.rm16)
ISEL(LOAD16S,    arm64,   MEM_LOAD,  arm64.ldrsh)
ISEL(LOAD16S,    riscv64, MEM_LOAD,  riscv64.lh)

ISEL(STORE16,    x64,     MEM_STORE, x64.mov.mr16)
ISEL(STORE16,    arm64,   MEM_STORE, arm64.strh)
ISEL(STORE16,    riscv64, MEM_STORE, riscv64.sh)

ISEL(LOAD32Z,    x64,     MEM_LOAD,  x64.mov.rm32)
ISEL(LOAD32Z,    arm64,   MEM_LOAD,  arm64.ldr_w)
ISEL(LOAD32Z,    riscv64, MEM_LOAD,  riscv64.lwu)

ISEL(LOAD32S,    x64,     MEM_LOAD,  x64.movsxd.rm)
ISEL(LOAD32S,    arm64,   MEM_LOAD,  arm64.ldrsw)
ISEL(LOAD32S,    riscv64, MEM_LOAD,  riscv64.lw)

ISEL(STORE32,    x64,     MEM_STORE, x64.mov.mr32)
ISEL(STORE32,    arm64,   MEM_STORE, arm64.str_w)
ISEL(STORE32,    riscv64, MEM_STORE, riscv64.sw)

# ═══════════════════════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════════════════════

ISEL(CONST_I64,  x64,     CUSTOM, x64.mov.ri64,        "MOV r64, imm64")
ISEL(CONST_I64,  arm64,   CUSTOM, arm64.movz+arm64.movk, "up to 4 MOVZ/MOVK")
ISEL(CONST_I64,  riscv64, CUSTOM, riscv64.lui+riscv64.addi, "LUI+ADDI or longer sequence for >32-bit")

ISEL(CONST_F64,  x64,     CUSTOM, -, "load imm64 to GP then MOVQ to XMM; 0.0 = XORPD")
ISEL(CONST_F64,  arm64,   CUSTOM, -, "load imm64 to GP then FMOV to FP; 0.0 = FMOV #0")
ISEL(CONST_F64,  riscv64, CUSTOM, -, "load imm64 to GP then FMV.D.X; 0.0 = fcvt.d.l(x0)")

ISEL(CONST_PTR,  x64,     CUSTOM, x64.mov.ri64)
ISEL(CONST_PTR,  arm64,   CUSTOM, arm64.movz+arm64.movk)
ISEL(CONST_PTR,  riscv64, CUSTOM, riscv64.lui+riscv64.addi)

# ═══════════════════════════════════════════════════════════════════════
# Control Flow
# ═══════════════════════════════════════════════════════════════════════

ISEL(JMP,        x64,     CUSTOM, x64.jmp.rel32)
ISEL(JMP,        arm64,   CUSTOM, arm64.b)
ISEL(JMP,        riscv64, CUSTOM, riscv64.jal,          "JAL x0, offset")

ISEL(BR,         x64,     CUSTOM, x64.test.rr+x64.jcc.rel32, "TEST reg,reg + Jcc")
ISEL(BR,         arm64,   CUSTOM, arm64.cbnz,           "CBNZ or CBZ")
ISEL(BR,         riscv64, CUSTOM, riscv64.bne,           "BNE rs, x0, offset")

ISEL(RET,        x64,     CUSTOM, -, "restore frame + RET")
ISEL(RET,        arm64,   CUSTOM, -, "restore frame + RET (BR X30)")
ISEL(RET,        riscv64, CUSTOM, -, "restore frame + JALR x0, ra, 0")

# ═══════════════════════════════════════════════════════════════════════
# Move / Select / PHI
# ═══════════════════════════════════════════════════════════════════════

ISEL(MOV,        x64,     GP_R,    x64.mov.rr,          "also handles FP via movsd")
ISEL(MOV,        arm64,   GP_R,    arm64.mov.rr,        "also handles FP via fmov")
ISEL(MOV,        riscv64, GP_R,    riscv64.addi,         "MV pseudo: addi rd, rs, 0; FP via fmv.d")

ISEL(SELECT_COND, x64,    CUSTOM, x64.test.rr,          "TEST + set flags for SELECT")
ISEL(SELECT_COND, arm64,  CUSTOM, arm64.cmp.ri12,        "CMP rn, #0")
ISEL(SELECT_COND, riscv64,CUSTOM, -,                     "stash condition for following SELECT")

ISEL(SELECT,     x64,     CUSTOM, x64.cmov.rr,          "CMOVcc based on prior flags")
ISEL(SELECT,     arm64,   CUSTOM, arm64.csel,            "CSEL rd, rn, rm, NE")
ISEL(SELECT,     riscv64, CUSTOM, riscv64.bne+riscv64.addi, "branch-around pattern: BNE cond,x0,+8; MV rd,false; J +4; MV rd,true")

ISEL(NOP,        x64,     CUSTOM, x64.nop)
ISEL(NOP,        arm64,   CUSTOM, arm64.nop)
ISEL(NOP,        riscv64, CUSTOM, riscv64.nop)

ISEL(PHI,        x64,     CUSTOM, -, "resolved by register allocator edge copies")
ISEL(PHI,        arm64,   CUSTOM, -, "resolved by register allocator edge copies")
ISEL(PHI,        riscv64, CUSTOM, -, "resolved by register allocator edge copies")

ISEL(REDEFINE,   x64,     GP_R,   x64.mov.rr)
ISEL(REDEFINE,   arm64,   GP_R,   arm64.mov.rr)
ISEL(REDEFINE,   riscv64, GP_R,   riscv64.addi,         "MV pseudo")

# ═══════════════════════════════════════════════════════════════════════
# Runtime Helpers (all lowered as CALL_C to xr_jit_* functions)
# ═══════════════════════════════════════════════════════════════════════

ISEL(RT_ADD,       x64,     CALL_HELPER, -, "xr_jit_rt_add")
ISEL(RT_ADD,       arm64,   CALL_HELPER, -, "xr_jit_rt_add")
ISEL(RT_ADD,       riscv64, CALL_HELPER, -, "xr_jit_rt_add")

ISEL(RT_SUB,       x64,     CALL_HELPER, -, "xr_jit_rt_sub")
ISEL(RT_SUB,       arm64,   CALL_HELPER, -, "xr_jit_rt_sub")
ISEL(RT_SUB,       riscv64, CALL_HELPER, -, "xr_jit_rt_sub")

ISEL(RT_MUL,       x64,     CALL_HELPER, -, "xr_jit_rt_mul")
ISEL(RT_MUL,       arm64,   CALL_HELPER, -, "xr_jit_rt_mul")
ISEL(RT_MUL,       riscv64, CALL_HELPER, -, "xr_jit_rt_mul")

ISEL(RT_DIV,       x64,     CALL_HELPER, -, "xr_jit_rt_div")
ISEL(RT_DIV,       arm64,   CALL_HELPER, -, "xr_jit_rt_div")
ISEL(RT_DIV,       riscv64, CALL_HELPER, -, "xr_jit_rt_div")

ISEL(RT_MOD,       x64,     CALL_HELPER, -, "xr_jit_rt_mod")
ISEL(RT_MOD,       arm64,   CALL_HELPER, -, "xr_jit_rt_mod")
ISEL(RT_MOD,       riscv64, CALL_HELPER, -, "xr_jit_rt_mod")

ISEL(RT_UNM,       x64,     CALL_HELPER, -, "xr_jit_rt_unm")
ISEL(RT_UNM,       arm64,   CALL_HELPER, -, "xr_jit_rt_unm")
ISEL(RT_UNM,       riscv64, CALL_HELPER, -, "xr_jit_rt_unm")

ISEL(RT_LT,        x64,     CALL_HELPER, -, "xr_jit_rt_lt")
ISEL(RT_LT,        arm64,   CALL_HELPER, -, "xr_jit_rt_lt")
ISEL(RT_LT,        riscv64, CALL_HELPER, -, "xr_jit_rt_lt")

ISEL(RT_LE,        x64,     CALL_HELPER, -, "xr_jit_rt_le")
ISEL(RT_LE,        arm64,   CALL_HELPER, -, "xr_jit_rt_le")
ISEL(RT_LE,        riscv64, CALL_HELPER, -, "xr_jit_rt_le")

ISEL(RT_EQ,        x64,     CALL_HELPER, -, "xr_jit_rt_eq")
ISEL(RT_EQ,        arm64,   CALL_HELPER, -, "xr_jit_rt_eq")
ISEL(RT_EQ,        riscv64, CALL_HELPER, -, "xr_jit_rt_eq")

ISEL(RT_PRINT,     x64,     CALL_HELPER, -, "xr_jit_print")
ISEL(RT_PRINT,     arm64,   CALL_HELPER, -, "xr_jit_print")
ISEL(RT_PRINT,     riscv64, CALL_HELPER, -, "xr_jit_print")

ISEL(RT_ARRAY_NEW, x64,     CALL_HELPER, -, "xr_jit_rt_array_new")
ISEL(RT_ARRAY_NEW, arm64,   CALL_HELPER, -, "xr_jit_rt_array_new")
ISEL(RT_ARRAY_NEW, riscv64, CALL_HELPER, -, "xr_jit_rt_array_new")

ISEL(RT_ARRAY_PUSH, x64,    CALL_HELPER, -, "xr_jit_rt_array_push")
ISEL(RT_ARRAY_PUSH, arm64,  CALL_HELPER, -, "xr_jit_rt_array_push")
