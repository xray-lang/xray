; xisa/arch/arm64/isa.isa — AArch64 machine instruction schema
;
; AArch64 instructions are fixed-width 32-bit.
; Encoding fields: rd, rn, rm, imm12, imm16, imm26, cond, shift, etc.

; ==================================================================
; Register class definitions
; ==================================================================

(define-regclass arm64.gpr64
  :regs (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15
         x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 fp lr sp)
  :encoding-bits 5)

(define-regclass arm64.gpr32
  :regs (w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15
         w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 wfp wlr wsp)
  :encoding-bits 5)

; ==================================================================
; ALU reg,reg (64-bit)
; ==================================================================

(define-mcinsn arm64.add.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x8b000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 8b")
                   ((x3 x4 x5) "83 00 05 8b")
                   ((x28 fp lr) "bc 03 1e 8b"))
  :golden-asm     (((x0 x1 x2) "add x0, x1, x2")
                   ((x3 x4 x5) "add x3, x4, x5"))
  :external-reference llvm-mc)

(define-mcinsn arm64.sub.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xcb000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 cb")
                   ((x3 x4 x5) "83 00 05 cb")
                   ((x28 fp lr) "bc 03 1e cb"))
  :golden-asm     (((x0 x1 x2) "sub x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.and.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x8a000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 8a")
                   ((x3 x4 x5) "83 00 05 8a"))
  :golden-asm     (((x0 x1 x2) "and x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.orr.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xaa000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 aa")
                   ((x3 x4 x5) "83 00 05 aa"))
  :golden-asm     (((x0 x1 x2) "orr x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.eor.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xca000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 ca")
                   ((x3 x4 x5) "83 00 05 ca"))
  :golden-asm     (((x0 x1 x2) "eor x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.mul.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x9b007c00 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 7c 02 9b")
                   ((x3 x4 x5) "83 7c 05 9b"))
  :golden-asm     (((x0 x1 x2) "mul x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.sdiv.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x9ac00c00 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 0c c2 9a")
                   ((x3 x4 x5) "83 0c c5 9a"))
  :golden-asm     (((x0 x1 x2) "sdiv x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.subs.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xeb000000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 00 02 eb")
                   ((x3 x4 x5) "83 00 05 eb"))
  :golden-asm     (((x0 x1 x2) "subs x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.msub.rrrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64) ($ra reg:gpr64))
  :constraints    ()
  :encoding       (0x9b008000 (field 0 5 $rd) (field 5 5 $rn) (field 10 5 $ra) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2 x3) "20 8c 02 9b")
                   ((x5 x6 x7 x8) "c5 a0 07 9b"))
  :golden-asm     (((x0 x1 x2 x3) "msub x0, x1, x2, x3"))
  :external-reference llvm-mc)

(define-mcinsn arm64.add.lsl
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64) ($shift imm:u6))
  :constraints    ()
  :encoding       (0x8b000000 (field 0 5 $rd) (field 5 5 $rn) (field 10 6 $shift) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2 3) "20 0c 02 8b")
                   ((x0 x1 x2 0) "20 00 02 8b"))
  :golden-asm     (((x0 x1 x2 3) "add x0, x1, x2, lsl #3"))
  :external-reference llvm-mc)

; ==================================================================
; ALU reg,imm
; ==================================================================

(define-mcinsn arm64.add.ri12
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($imm imm:u12))
  :constraints    ()
  :encoding       (0x91000000 (field 0 5 $rd) (field 5 5 $rn) (field 10 12 $imm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 1) "20 04 00 91")
                   ((x0 x1 42) "20 a8 00 91")
                   ((sp sp 16) "ff 43 00 91"))
  :golden-asm     (((x0 x1 1) "add x0, x1, #1")
                   ((sp sp 16) "add sp, sp, #16"))
  :external-reference llvm-mc)

(define-mcinsn arm64.sub.ri12
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($imm imm:u12))
  :constraints    ()
  :encoding       (0xd1000000 (field 0 5 $rd) (field 5 5 $rn) (field 10 12 $imm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((sp sp 16) "ff 43 00 d1")
                   ((x0 x1 1) "20 04 00 d1"))
  :golden-asm     (((sp sp 16) "sub sp, sp, #16"))
  :external-reference llvm-mc)

(define-mcinsn arm64.cmp.ri12
  :operands       (($rn reg:gpr64) ($imm imm:u12))
  :constraints    ()
  :encoding       (0xf100001f (field 5 5 $rn) (field 10 12 $imm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 0) "1f 00 00 f1")
                   ((x1 42) "3f a8 00 f1"))
  :golden-asm     (((x0 0) "cmp x0, #0"))
  :external-reference llvm-mc)

(define-mcinsn arm64.subs_imm_w
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($imm imm:u12))
  :constraints    ()
  :encoding       (0x71000000 (field 0 5 $rd) (field 5 5 $rn) (field 10 12 $imm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 42) "20 a8 00 71"))
  :golden-asm     (((x0 x1 42) "subs w0, w1, #42"))
  :external-reference llvm-mc)

; ==================================================================
; Logical (additional)
; ==================================================================

(define-mcinsn arm64.mvn.rr
  :operands       (($rd reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xaa2003e0 (field 0 5 $rd) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1) "e0 03 21 aa")
                   ((x3 x4) "e3 03 24 aa"))
  :golden-asm     (((x0 x1) "mvn x0, x1"))
  :external-reference llvm-mc)

; ==================================================================
; MOV
; ==================================================================

(define-mcinsn arm64.mov.rr
  :operands       (($rd reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0xaa0003e0 (field 0 5 $rd) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1) "e0 03 01 aa")
                   ((x3 x4) "e3 03 04 aa"))
  :golden-asm     (((x0 x1) "mov x0, x1"))
  :external-reference llvm-mc)

(define-mcinsn arm64.movz
  :operands       (($rd reg:gpr64) ($imm imm:u16) ($shift imm:u8))
  :constraints    ()
  :encoding       (0xd2800000 (field 0 5 $rd) (field 5 16 $imm) (field-scaled 21 2 $shift 16))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 42 0) "40 05 80 d2")
                   ((x0 0xFFFF 16) "e0 ff bf d2"))
  :golden-asm     (((x0 42 0) "mov x0, #42")
                   ((x0 0xFFFF 16) "movz x0, #0xffff, lsl #16"))
  :external-reference llvm-mc)

(define-mcinsn arm64.movk
  :operands       (($rd reg:gpr64) ($imm imm:u16) ($shift imm:u8))
  :constraints    ()
  :encoding       (0xf2800000 (field 0 5 $rd) (field 5 16 $imm) (field-scaled 21 2 $shift 16))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 42 0) "40 05 80 f2")
                   ((x0 0xFFFF 16) "e0 ff bf f2"))
  :golden-asm     (((x0 42 0) "movk x0, #42")
                   ((x0 0xFFFF 16) "movk x0, #0xffff, lsl #16"))
  :external-reference llvm-mc)

(define-mcinsn arm64.cset
  :operands       (($rd reg:gpr64) ($cond cc))
  :constraints    ()
  :encoding       (0x9a9f07e0 (field 0 5 $rd) (field-xor 12 4 $cond 1))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 0) "e0 17 9f 9a")
                   ((x0 1) "e0 07 9f 9a")
                   ((x3 11) "e3 a7 9f 9a"))
  :golden-asm     (((x0 0) "cset x0, eq"))
  :external-reference llvm-mc)

; ==================================================================
; Shift
; ==================================================================

(define-mcinsn arm64.lsl.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x9ac02000 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 20 c2 9a")
                   ((x3 x4 x5) "83 20 c5 9a"))
  :golden-asm     (((x0 x1 x2) "lsl x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.lsr.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x9ac02400 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 24 c2 9a")
                   ((x3 x4 x5) "83 24 c5 9a"))
  :golden-asm     (((x0 x1 x2) "lsr x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.asr.rrr
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64))
  :constraints    ()
  :encoding       (0x9ac02800 (field 0 5 $rd) (field 5 5 $rn) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2) "20 28 c2 9a")
                   ((x3 x4 x5) "83 28 c5 9a"))
  :golden-asm     (((x0 x1 x2) "asr x0, x1, x2"))
  :external-reference llvm-mc)

(define-mcinsn arm64.lsr_imm
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($shift imm:u6))
  :constraints    ()
  :encoding       (0x53007c00 (field 0 5 $rd) (field 5 5 $rn) (field 16 6 $shift))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 4) "20 7c 04 53"))
  :golden-asm     (((x0 x1 4) "lsr w0, w1, #4"))
  :external-reference llvm-mc)

(define-mcinsn arm64.lsr_imm64
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($shift imm:u6))
  :constraints    ()
  :encoding       (0xd340fc00 (field 0 5 $rd) (field 5 5 $rn) (field 16 6 $shift))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 4) "20 fc 44 d3"))
  :golden-asm     (((x0 x1 4) "lsr x0, x1, #4"))
  :external-reference llvm-mc)

; ==================================================================
; Compare (additional)
; ==================================================================

(define-mcinsn arm64.csel
  :operands       (($rd reg:gpr64) ($rn reg:gpr64) ($rm reg:gpr64) ($cond cc))
  :constraints    ()
  :encoding       (0x9a800000 (field 0 5 $rd) (field 5 5 $rn) (field 12 4 $cond) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2 0) "20 00 82 9a")
                   ((x0 x1 x2 1) "20 10 82 9a"))
  :golden-asm     (((x0 x1 x2 0) "csel x0, x1, x2, eq"))
  :external-reference llvm-mc)

(define-mcinsn arm64.fcsel
