  :encoding       (0x1e600c00 (field 0 5 $rd) (field 5 5 $rn) (field 12 4 $cond) (field 16 5 $rm))
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 x2 0) "20 0c 62 1e"))
  :golden-asm     (((x0 x1 x2 0) "fcsel d0, d1, d2, eq"))
  :external-reference llvm-mc)

; ==================================================================
; Memory: Load / Store [base, #imm]
; ==================================================================

(define-mcinsn arm64.ldr.bi9
  :operands       (($rt reg:gpr64) ($rn reg:gpr64) ($imm imm:i9))
  :constraints    ()
  :encoding       (0xf8400000 (field 0 5 $rt) (field 5 5 $rn) (field 12 9 $imm))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 0) "20 00 40 f8")
                   ((x0 sp 8) "e0 83 40 f8")
                   ((x3 fp -8) "a3 83 5f f8"))
  :golden-asm     (((x0 x1 0) "ldur x0, [x1]")
                   ((x0 sp 8) "ldur x0, [sp, #8]"))
  :external-reference llvm-mc)

(define-mcinsn arm64.str.bi9
  :operands       (($rt reg:gpr64) ($rn reg:gpr64) ($imm imm:i9))
  :constraints    ()
  :encoding       (0xf8000000 (field 0 5 $rt) (field 5 5 $rn) (field 12 9 $imm))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 0) "20 00 00 f8")
                   ((x0 sp 8) "e0 83 00 f8")
                   ((x3 fp -8) "a3 83 1f f8"))
  :golden-asm     (((x0 x1 0) "stur x0, [x1]")
                   ((x0 sp 8) "stur x0, [sp, #8]"))
  :external-reference llvm-mc)

; ==================================================================
; Memory: Load / Store [base, #scaled_offset]
; ==================================================================

(define-mcinsn arm64.ldr
  :operands       (($rt reg:gpr64) ($rn reg:gpr64) ($offset imm:i32))
  :constraints    ()
  :encoding       (0xf9400000 (field 0 5 $rt) (field 5 5 $rn) (field-scaled 10 12 $offset 8))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 0) "20 00 40 f9")
                   ((x0 sp 8) "e0 07 40 f9")
                   ((x3 fp 16) "a3 0b 40 f9"))
  :golden-asm     (((x0 x1 0) "ldr x0, [x1]")
                   ((x0 sp 8) "ldr x0, [sp, #8]"))
  :external-reference llvm-mc)

(define-mcinsn arm64.str
  :operands       (($rt reg:gpr64) ($rn reg:gpr64) ($offset imm:i32))
  :constraints    ()
  :encoding       (0xf9000000 (field 0 5 $rt) (field 5 5 $rn) (field-scaled 10 12 $offset 8))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 0) "20 00 00 f9")
                   ((x0 sp 8) "e0 07 00 f9"))
  :golden-asm     (((x0 x1 0) "str x0, [x1]"))
  :external-reference llvm-mc)

(define-mcinsn arm64.ldp
  :operands       (($rt1 reg:gpr64) ($rt2 reg:gpr64) ($rn reg:gpr64) ($offset imm:i32))
  :constraints    ()
  :encoding       (0xa9400000 (field 0 5 $rt1) (field 5 5 $rn) (field 10 5 $rt2) (field-scaled 15 7 $offset 8))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 sp 0) "e0 07 40 a9")
                   ((x0 x1 sp 16) "e0 07 41 a9"))
  :golden-asm     (((x0 x1 sp 0) "ldp x0, x1, [sp]"))
  :external-reference llvm-mc)

(define-mcinsn arm64.stp
  :operands       (($rt1 reg:gpr64) ($rt2 reg:gpr64) ($rn reg:gpr64) ($offset imm:i32))
  :constraints    ()
  :encoding       (0xa9000000 (field 0 5 $rt1) (field 5 5 $rn) (field 10 5 $rt2) (field-scaled 15 7 $offset 8))
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x0 x1 sp 0) "e0 07 00 a9")
                   ((x0 x1 sp 16) "e0 07 01 a9"))
  :golden-asm     (((x0 x1 sp 0) "stp x0, x1, [sp]"))
  :external-reference llvm-mc)

