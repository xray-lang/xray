; ---- FP memory (64-bit double) ----

(define-mcinsn arm64.ldr_fp
  :operands       (($rt reg:gpr64) ($rn reg:gpr64) ($offset imm:i32))
  :constraints    ()
  :encoding       (0xfd400000 (field 0 5 $rt) (field 5 5 $rn) (field-scaled 10 12 $offset 8))
  :flags          (memory)
  :min-bytes      4
