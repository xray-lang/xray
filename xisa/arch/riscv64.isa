  :encoding       (i-type 0x03 0x5 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 50 01 00"))
  :golden-asm     (((x1 x2 0) "lhu x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.lwu
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x6 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 60 01 00"))
  :golden-asm     (((x1 x2 0) "lwu x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.sb
  :operands       (($rs2 reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (s-type 0x23 0x0 $rs1 $rs2 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "23 00 11 00"))
  :golden-asm     (((x1 x2 0) "sb x1, 0(x2)"))
