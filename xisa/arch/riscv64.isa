  :encoding       (i-type 0x1b 0x5 $rd $rs1 $imm)
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 1) "9b 50 11 00"))
  :golden-asm     (((x1 x2 1) "srliw x1, x2, 1"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.sraiw
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x1b 0x5 $rd $rs1 $imm)
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0x401) "9b 50 11 40"))
  :golden-asm     (((x1 x2 0x401) "sraiw x1, x2, 1"))
  :external-reference riscv-spec)

; ==================================================================
; Load / Store
; ==================================================================

(define-mcinsn riscv64.lb
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x0 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 00 01 00"))
  :golden-asm     (((x1 x2 0) "lb x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.lh
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x1 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 10 01 00"))
  :golden-asm     (((x1 x2 0) "lh x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.lw
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x2 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 20 01 00"))
  :golden-asm     (((x1 x2 0) "lw x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.ld
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x3 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 30 01 00")
                   ((x10 x8 8) "03 35 84 00")
                   ((x1 x2 -8) "83 30 81 ff"))
  :golden-asm     (((x1 x2 0) "ld x1, 0(x2)")
                   ((x10 x8 8) "ld x10, 8(x8)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.lbu
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
  :constraints    ()
  :encoding       (i-type 0x03 0x4 $rd $rs1 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "83 40 01 00"))
  :golden-asm     (((x1 x2 0) "lbu x1, 0(x2)"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.lhu
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
