  :constraints    ()
  :encoding       (i-type 0x1b 0x1 $rd $rs1 $imm)
  :flags          ()
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 1) "9b 10 11 00"))
  :golden-asm     (((x1 x2 1) "slliw x1, x2, 1"))
  :external-reference riscv-spec)

(define-mcinsn riscv64.srliw
  :operands       (($rd reg:gpr) ($rs1 reg:gpr) ($imm imm:i12))
