  :encoding       (s-type 0x23 0x1 $rs1 $rs2 $imm)
  :flags          (memory)
  :min-bytes      4
  :max-bytes      4
  :golden-bytes   (((x1 x2 0) "23 10 11 00"))
  :golden-asm     (((x1 x2 0) "sh x1, 0(x2)"))
