; Xi lowering target coverage source.
; Entries describe which backend targets implement a semantic op slice.

(lower xi.const
  :match ()
  :required-targets (vm-bytecode jit-xm aot-c)
  :vm-bytecode (driver emit_const)
  :jit-xm (driver xi2xm_const)
  :aot-c (driver xicgen_const))

