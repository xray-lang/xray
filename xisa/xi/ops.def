  :targets (vm-bytecode aot-c aot-verify))

(define-xi-op xi.chan.try.send
  :class coroutine
  :arity 2
  :result-ownership none
  :tbaa-group chan
  :escape-use global
  ;; Internal select send predicate: arg0 = channel (borrowed receiver),
  ;; arg1 = value (consumed on success/abandoned on failure), result = bool.
  ;; User-facing Channel.trySend remains XI_CALL_METHOD/OP_INVOKE and returns SendResult.
  :own-use stored-value
  :effects (side-effect memory-write)
  :sync acq-rel
  :requires ()
  :observable ()
  :targets (vm-bytecode aot-verify))

