; Every operation belongs to exactly one language-semantic owner category.
; These groups deliberately exclude target support, lowering policy, provider
; spelling and C representation. xisagen rejects missing, unknown or duplicate
; membership before it can produce the SemanticPlan registry.
(define-xi-semantic-owner declarative-primitive
  :operations (
    xi.const
    xi.param
    xi.add
    xi.sub
    xi.mul
    xi.convert
    xi.box
    xi.unbox
