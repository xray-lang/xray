; FFI raw-pointer load/store. The address is an address-width int; aux_int holds
; the XrFFIType width of the pointee. No bounds check (unsafe-only). These carry
; TBAA-TOP: a raw pointer may address any object in the program, so a ptr.store
; must clobber every group. TBAA-NONE would be the opposite of conservative --
; xi_tbaa_may_alias treats NONE as "not a memory op" and returns no-alias, which
; would let LICM hoist an aliasing array load out of a loop containing this store.
(define-xi-op xi.ptr.load
  :class memory-read
  :arity 2
  ; A raw-pointer load is a shallow view of storage owned by the pointee.  In
  ; particular, loading a value-ABI aggregate must not acquire its ARC fields.
  :result-ownership borrowed
  :own-use borrow
  :tbaa-group top
  :effects (memory-read)
  :requires ()
  :observable ()
  :targets (vm-bytecode aot-c aot-verify))

