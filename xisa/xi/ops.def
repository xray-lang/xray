(define-xi-op xi.chan.send
  :class coroutine
  :arity 2
  :result-ownership none
  :tbaa-group chan
  :escape-use global
  ;; arg0 = channel (borrowed receiver), arg1 = value (consumed into the buffer).
  ;; The channel must NOT be consumed: send neither owns nor releases it, so a
  ;; consuming use would atomic-incref the channel handle without a matching
  ;; release and leak it (channels are now plain atomic shared-RC objects).
  :own-use stored-value
  :effects (side-effect may-suspend memory-write)
  :sync acq-rel
  :requires ()
  :observable ()
  :targets (vm-bytecode aot-verify))

(define-xi-op xi.chan.recv
  :class coroutine
  :arity 1
  :tbaa-group chan
  ;; arg0 = channel (borrowed): recv reads from it and returns a fresh result;
  ;; it neither owns nor releases the channel handle.
  :own-use borrow
  :effects (side-effect may-suspend memory-read)
  :sync acq-rel
  :requires ()
  :observable ()
  :targets (vm-bytecode aot-verify))

