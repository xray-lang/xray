// Concurrent loopback echo benchmark: compares io_uring completion mode vs the
// epoll readiness backend (XRAY_IO_BACKEND=epoll). Measures wall time for
// conns * rounds request/response round-trips. Run via tests/manual; not a
// regression test.
import net
import { NetConn, NetListener } from net
import time

fn echoConn(c: NetConn) {
    var buf = Array<u8>(4096)
    while (true) {
        var n = net.readInto(c, ref buf, 4096)
        if (n <= 0) { break }
        net.writeBytes(c, buf)
    }
    net.close(c)
}

fn server(lst: NetListener, ready: Channel<i64>) {
    ready.send(1)
    while (true) {
        var c = net.accept(lst)
        if (c == null) { break }
        go echoConn(c!)
    }
}

fn client(port: i64, rounds: i64, done: Channel<i64>) {
    var c = net.dial("127.0.0.1", port)
    var ping = "ping".copyBytes()
    var buf = Array<u8>(4096)
    var i = 0
    while (i < rounds) {
        net.writeBytes(c, ping)
        var n = net.readInto(c, ref buf, 4096)
        if (n <= 0) { break }
        i = i + 1
    }
    net.close(c)
    done.send(1)
}

@test
fn bench_echo() {
    var conns = 100
    var rounds = 500
    var lst = net.listen(0, 128)
    var port = net.port(lst)

    const ready = Channel(1)
    go server(lst, ready)
    ready.recv()

    const done = Channel(conns)
    var start = time.monotonic()
    var i = 0
    while (i < conns) {
        go client(port, rounds, done)
        i = i + 1
    }
    var got = 0
    while (got < conns) {
        done.recv()
        got = got + 1
    }
    var elapsed = time.monotonic() - start
    var total = conns * rounds
    print("BENCH_TOTAL")
    print(total)
    print("BENCH_ELAPSED_MS")
    print(elapsed)
    net.close(lst)
}
