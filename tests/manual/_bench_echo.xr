// Concurrent loopback echo benchmark: compares io_uring completion mode vs the
// epoll readiness backend (XRAY_IO_BACKEND=epoll). Measures wall time for
// conns * rounds request/response round-trips. Run via tests/manual; not a
// regression test.
import net
import time

fn echoConn(c: NetConn) {
    while (true) {
        var s = net.read(c)
        if (s == null) { break }
        net.write(c, s!)
    }
    net.close(c)
}

fn server(lst: NetListener, ready: Channel<int>) {
    ready.send(1)
    while (true) {
        var c = net.accept(lst)
        if (c == null) { break }
        go echoConn(c!)
    }
}

fn client(port: int, rounds: int, done: Channel<int>) {
    var c = net.dial("127.0.0.1", port)!
    var i = 0
    while (i < rounds) {
        net.write(c, "ping")
        var r = net.read(c)
        if (r == null) { break }
        i = i + 1
    }
    net.close(c)
    done.send(1)
}

@test
fn bench_echo() {
    var conns = 100
    var rounds = 500
    var lst = net.listen(0, 128)!
    var port = lst.port()

    shared ready = Channel(1)
    go server(lst, ready)
    ready.recv()

    shared done = Channel(conns)
    var start = time.monotonic()
    var i = 0
    while (i < conns) {
        go client(port, rounds, done)
        i = i + 1
    }
    var got = 0
    while (got < conns) {
        done.recv()
        got = got + 1
    }
    var elapsed = time.monotonic() - start
    var total = conns * rounds
    print("BENCH_TOTAL")
    print(total)
    print("BENCH_ELAPSED_MS")
    print(elapsed)
    net.close(lst)
}
