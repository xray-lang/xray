// High-concurrency loopback echo benchmark variant: more concurrent connections
// to expose io_uring's batched, lock-free per-worker rings vs epoll readiness.
// Run via tests/manual; not a regression test. conns/rounds chosen to keep the
// total round-trip count comparable while scaling connection fan-out.
import net
import time

fn echoConn(c: NetConn) {
    while (true) {
        var s = net.read(c)
        if (s == null) { break }
        net.write(c, s!)
    }
    net.close(c)
}

fn server(lst: NetListener, ready: Channel<int>) {
    ready.send(1)
    while (true) {
        var c = net.accept(lst)
        if (c == null) { break }
        go echoConn(c!)
    }
}

fn client(port: int, rounds: int, done: Channel<int>) {
    var c = net.dial("127.0.0.1", port)!
    var i = 0
    while (i < rounds) {
        net.write(c, "ping")
        var r = net.read(c)
        if (r == null) { break }
        i = i + 1
    }
    net.close(c)
    done.send(1)
}

@test
fn bench_echo_hi() {
    var conns = 1000
    var rounds = 50
    var lst = net.listen(0, 1024)!
    var port = lst.port()

    var ready = Channel(1)
    go server(lst, ready)
    ready.recv()

    var done = Channel(conns)
    var start = time.monotonic()
    var i = 0
    while (i < conns) {
        go client(port, rounds, done)
        i = i + 1
    }
    var got = 0
    while (got < conns) {
        done.recv()
        got = got + 1
    }
    var elapsed = time.monotonic() - start
    var total = conns * rounds
    print("BENCH_TOTAL")
    print(total)
    print("BENCH_ELAPSED_MS")
    print(elapsed)
    net.close(lst)
}
