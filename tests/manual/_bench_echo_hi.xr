// High-concurrency loopback echo benchmark variant: more concurrent connections
// to expose io_uring's batched, lock-free per-worker rings vs epoll readiness.
// Run via tests/manual; not a regression test. conns/rounds chosen to keep the
// total round-trip count comparable while scaling connection fan-out.
import net
import time

fn echoConn(c: NetConn) {
    while (true) {
        let s = net.read(c)
        if (s == null) { break }
        net.write(c, s!)
    }
    net.close(c)
}

fn server(lst: NetListener, ready: Channel<int>) {
    ready.send(1)
    while (true) {
        let c = net.accept(lst)
        if (c == null) { break }
        go echoConn(c!)
    }
}

fn client(port: int, rounds: int, done: Channel<int>) {
    let c = net.dial("127.0.0.1", port)!
    let i = 0
    while (i < rounds) {
        net.write(c, "ping")
        let r = net.read(c)
        if (r == null) { break }
        i = i + 1
    }
    net.close(c)
    done.send(1)
}

@test
fn bench_echo_hi() {
    let conns = 1000
    let rounds = 50
    let lst = net.listen(0, 1024)!
    let port = lst.port()

    let ready = Channel(1)
    go server(lst, ready)
    ready.recv()

    let done = Channel(conns)
    let start = time.monotonic()
    let i = 0
    while (i < conns) {
        go client(port, rounds, done)
        i = i + 1
    }
    let got = 0
    while (got < conns) {
        done.recv()
        got = got + 1
    }
    let elapsed = time.monotonic() - start
    let total = conns * rounds
    print("BENCH_TOTAL")
    print(total)
    print("BENCH_ELAPSED_MS")
    print(elapsed)
    net.close(lst)
}
