// anchor: adt-enum-payload-tostring
//
// Explicit stringification of a payload-carrying enum variant must render
// the payload list exactly like print() does: "Enum.Member(p1, p2, ...)",
// with nested strings quoted. VM and AOT previously diverged here — the AOT
// explicit-toString and concat paths formatted only "Enum.Member" (name-only
// scratch-buffer formatting), while print() went through the shared
// payload-aware formatter. Every stringification surface below must agree
// byte-for-byte across backends.

enum E { A { value: i64 }, B }
enum P { Pair { first: i64, second: string }, Solo }
enum W { Wrap { value: E }, Empty }

var e = E.A { value: 7 }

// The reported divergence: explicit toString() concatenated into a string.
print("x=" + e.toString())

// string() conversion takes the same runtime path as toString().
print(string(e))

// Interpolation lowers to the parts-based concat, which formats enum
// operands itself rather than via toString().
print("i=${e}")
print("c=${e}")

// A zero-payload variant of a payload-carrying enum keeps the bare
// "Enum.Member" form (no parentheses) on both backends.
print(E.B.toString())
print("b=${E.B}")

// Multiple payloads: nested string payloads render quoted, matching print.
var p = P.Pair { first: 3, second: "hi" }
print(p.toString())
print("p=${p}")

// Enum payload nested inside another enum renders recursively.
var w = W.Wrap { value: E.A { value: 9 } }
print(w.toString())
print("w=${w}")

// Generic (erased) receiver dispatches toString dynamically and must make
// the same payload-aware rendering decision.
fn describe<T>(v: T) -> string {
    return "g=" + v.toString()
}
print(describe(e))
print(describe(p))

// Payload text has no fixed-size bound: a string payload far longer than
// any formatting scratch buffer must survive untruncated.
var long = P.Pair { first: 42, second: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
print("L=" + long.toString())
print("M=${long}")
