// anchor: spread-object-eval-order
// 181: pin strict left-to-right evaluation order and overwrite precedence of
// object/object and Json spread operands interleaved with explicit fields that
// carry observable side effects. A backend that reorders operand evaluation or
// mis-resolves overwrite precedence diverges from the pinned output below.

type Pair = { x: int, y: int }

var order = 0

fn mark(step: int) -> int {
    order = order * 10 + step
    return step
}

fn source(step: int, x: int, y: int) -> Pair {
    mark(step)
    return { x: x, y: y }
}

// Interleaved spreads and explicit fields, each with a side effect.
var merged = {
    ...source(1, 10, 11),
    y: mark(2),
    ...source(3, 30, 31),
    z: mark(4),
}
print(order)      // 1234: strict left-to-right operand evaluation
print(merged.x)   // 30: later spread overrides earlier spread's x
print(merged.y)   // 31: later spread overrides earlier explicit y
print(merged.z)   // 4

// Explicit field placed after a spread wins over the spread's same-named field.
order = 0
var overridden = {
    ...source(5, 1, 2),
    y: mark(6),
}
print(order)         // 56
print(overridden.x)  // 1
print(overridden.y)  // 6: explicit y after spread overrides spread's y

// Nested inline spread evaluates before the trailing explicit field.
order = 0
var chained = {
    ...source(7, 100, 200),
    ...{ x: mark(8), w: mark(9) },
}
print(order)       // 789
print(chained.x)   // 8: inline spread overrides source x
print(chained.y)   // 200: retained from first spread
print(chained.w)   // 9

// Json spread with a computed key: base spread evaluates before computed entry.
order = 0
var key = "dyn"
var jsonBase: Json = { a: mark(1), b: mark(2) }
var computed: Json = { ...jsonBase, [key]: mark(3) }
print(order)          // 123
print(computed.a)     // 1
print(computed["dyn"])// 3
