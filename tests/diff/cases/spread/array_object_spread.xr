// anchor: spread-array-object
// D40: array spread [...a, ...b, x] and object spread {...base, x: 1}.
// Exercised through the VM/AOT differential runner for parity.

// ---- Array spread ----
var a = [1, 2, 3]
var b = [4, 5]

var head = [0, ...a]
print(head)

var tail = [...a, 99]
print(tail)

var middle = [...a, 42, ...b]
print(middle)
print(len(middle))

var only = [...a]
print(only)
print(len(only))

var empty: Array<i64> = []
var from_empty = [...empty, ...b]
print(from_empty)

var nested = [[1, 2], [3]]
var flat = [...nested[0], ...nested[1], 7]
print(flat)

// string element arrays
var s1 = ["x", "y"]
var s2 = ["z"]
print([...s1, "mid", ...s2])

// spread does not consume the source: a is still usable
print(a)
print(len(a))

// ---- Object spread ----
var base = { x: 1, y: 2 }

var added = { ...base, z: 3 }
print(added.x, added.y, added.z)

var overridden = { ...base, y: 20 }
print(overridden.x, overridden.y)

var two = { ...base, ...{ y: 7, w: 8 } }
print(two.x, two.y, two.w)

var q = 11
var with_shorthand = { ...base, q }
print(with_shorthand.x, with_shorthand.q)

// later spread overrides earlier
var chain = { ...base, ...{ x: 100 }, y: 200 }
print(chain.x, chain.y)

// source object is not consumed
print(base.x, base.y)
