// anchor: basic-arrays
let a = [1, 2, 3, 4, 5]
print(a.length)
a.push(6)
print(a[5])

let doubled = a.map((x) -> x * 2)
for (i in 0..doubled.length) {
    print(doubled[i])
}

let evens = a.filter((x) -> x % 2 == 0)
print(evens.length)

let total = a.reduce((acc, x) -> acc + x, 0)
print(total)

let tail = a[-4:-1]
print(tail.length)
print(tail[0])
tail[1] = 33
print(a[3])

let syntax_tail = a[-4:-1]
print(syntax_tail.length)
print(syntax_tail[1])

let fill_range = [1, 2, 3, 4, 5, 6]
fill_range.fill(9, 2, 5)
print(fill_range[2])
print(fill_range[5])
fill_range.fill(7, -3, -1)
print(fill_range[3])
print(fill_range[4])
fill_range.fill(4, 4)
print(fill_range[4])
print(fill_range[5])

let bytes = Bytes(6)
bytes.fill(1)
bytes.fill(255, 1, 4)
print(bytes[0])
print(bytes[1])
print(bytes[3])
print(bytes[4])
print(bytes.indexOf(255))
print(bytes.indexOf(42))
print(bytes.includes(255))
print(bytes.includes(42))

let packet = Bytes(8)
packet[0] = 1
packet[1] = 2
packet[2] = 3
packet[3] = 4
packet[4] = 5
packet[5] = 6
packet[6] = 7
packet[7] = 8
let packetView: ByteSpan = packet
let packet32: uint32 = packetView.loadLE<uint32>(0)
let packet64: uint64 = packetView.loadLE<uint64>(0)
print(int(packet32))
print(int(packet64))

let copied = Bytes.withCapacity(6)
unsafe {
    copied.appendFromUnchecked(packetView, 1, 3)
}
print(copied[0])
print(copied[2])

let repeated = Bytes.withCapacity(9)
let seed = Bytes(3)
seed[0] = 65
seed[1] = 66
seed[2] = 67
unsafe {
    repeated.appendFromUnchecked(seed, 0, 3)
    repeated.repeatFromUnchecked(3, 6)
}
print(repeated[3])
print(repeated[8])
