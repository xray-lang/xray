// anchor: basic-arrays
let a = [1, 2, 3, 4, 5]
print(a.length)
a.push(6)
print(a[5])

let doubled = a.map((x) -> x * 2)
for (i in 0..doubled.length) {
    print(doubled[i])
}

let evens = a.filter((x) -> x % 2 == 0)
print(evens.length)

let total = a.reduce((acc, x) -> acc + x, 0)
print(total)

let tail = a.slice(-4, -1)
print(tail.length)
print(tail[0])
tail[1] = 33
print(a[3])

let syntax_tail = a[-4:-1]
print(syntax_tail.length)
print(syntax_tail[1])

let fill_range = [1, 2, 3, 4, 5, 6]
fill_range.fill(9, 2, 5)
print(fill_range[2])
print(fill_range[5])
fill_range.fill(7, -3, -1)
print(fill_range[3])
print(fill_range[4])
fill_range.fill(4, 4)
print(fill_range[4])
print(fill_range[5])

let bytes = new Bytes(6)
bytes.fill(1)
bytes.fill(255, 1, 4)
print(bytes[0])
print(bytes[1])
print(bytes[3])
print(bytes[4])
