// anchor: basic-ranges
var r = 2..9
print(len(r))
print(r.contains(2))
print(r.contains(8))
print(r.contains(9))
print(r[0])
print(r[-1])
print(r[-7])
print(r[-8])
print(r.toString())
var values = r.toArray()
print(len(values))
print(values[0])
print(values[6])

var total = 0
for (i in 2..9) {
    total = total + i
}
print(total)
