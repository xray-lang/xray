// anchor: basic-closures-recursion
fn makeCounter() -> fn() -> int {
    var n = 0
    return () -> {
        n = n + 1
        return n
    }
}

var c = makeCounter()
print(c())
print(c())
print(c())

var base = 10
print(((x: int) -> x + base)(5))

fn fib(n: int) -> int {
    if (n < 2) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

for (i in 0..10) {
    print(fib(i))
}
