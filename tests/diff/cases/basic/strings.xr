// anchor: basic-strings
let s = "Hello, World"
print(s.length)
print(s.toUpperCase())
print(s.toLowerCase())
print("Hello 世界🌍".toUpperCase())
print("Hello 世界🌍".toLowerCase())
print(s.substring(0, 5))
print(s.includes("World"))
print(s.indexOf("World"))
print("a" + "b" + "c")
print(s.charAt(1))
print("你好🌍".reverse())
print("a你b".reverse())

let parts = "a,b,c,d".split(",")
print(parts.length)
for (i in 0..parts.length) {
    print(parts[i])
}
