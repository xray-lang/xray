// anchor: basic-strings
var s = "Hello, World"
print(len(s))
print(s.toUpperCase())
print(s.toLowerCase())
print("Hello 世界🌍".toUpperCase())
print("Hello 世界🌍".toLowerCase())
print(s.substring(0, 5))
print("abcdef".substring(-3, 3))
print("abcdef".substring(2, -1))
print("abcdef".slice(-3, -1))
print("abcdef".slice(2, -1))
print("abcdef"[-3:-1])
print("abcdef"[2:-1])
print("abcdef"[9:12])
print(s.contains("World"))
print(s.indexOf("World"))
print("a" + "b" + "c")
print(s.charAt(1))
print("你好🌍".charAt(1))
print("你好🌍".charAt(-1))
print("abc".charAt(9))
print("é".byteAt(-1)?.ord())
print("世界".codePointAt(1))
print("A".codePointAt(-1))
print("A你🌍"[0])
print("A你🌍"[1])
print("A你🌍"[2])
print("A你🌍"[-1])
print("A你🌍"[9])
print("你好🌍".reverse())
print("a你b".reverse())
print(" \t\r\n-17tail".toInt())
print("abc".toInt())
print(" \n-3.5e2tail".toFloat())
print("abc".toFloat())
print("ab".repeat(3))
print("xy".repeat(-2))
print("".repeat(5))
print("好".repeat(2))
print("42".padStart(5, "0"))
print("hi".padEnd(5, "!"))
print("x".padStart(3))
print("x".padEnd(3))
print("abc".padEnd(5, ""))
print("好".padStart(6, "."))
print("hello world".replace("world", "xray"))
print("hello".replace("", "x"))
print("aaaa".replace("aa", "X"))
print("aaaa".replaceAll("aa", "X"))
print("abc".replaceAll("b", ""))

var parts = "a,b,c,d".split(",")
print(len(parts))
for (i in 0..len(parts)) {
    print(parts[i])
}
var edgeParts = "a,,b,".split(",")
print(len(edgeParts))
for (i in 0..len(edgeParts)) {
    print(edgeParts[i])
}
var charParts = "ab".split("")
print(len(charParts))
for (i in 0..len(charParts)) {
    print(charParts[i])
}
