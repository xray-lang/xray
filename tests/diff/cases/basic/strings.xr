// anchor: basic-strings
let s = "Hello, World"
print(s.length)
print(s.toUpperCase())
print(s.toLowerCase())
print("Hello 世界🌍".toUpperCase())
print("Hello 世界🌍".toLowerCase())
print(s.substring(0, 5))
print("abcdef".substring(-3, 3))
print("abcdef".substring(2, -1))
print("abcdef".slice(-3, -1))
print("abcdef".slice(2, -1))
print("abcdef"[-3:-1])
print("abcdef"[2:-1])
print("abcdef"[9:12])
print(s.includes("World"))
print(s.indexOf("World"))
print("a" + "b" + "c")
print(s.charAt(1))
print("你好🌍".charAt(1))
print("你好🌍".charAt(-1))
print("abc".charAt(9))
print("é".byteAt(-1).ord())
print("世界".codePointAt(1))
print("A".codePointAt(-1))
print("你好🌍".reverse())
print("a你b".reverse())
print(" \t\r\n-17tail".toInt())
print("abc".toInt())
print(" \n-3.5e2tail".toFloat())
print("abc".toFloat())
print("ab".repeat(3))
print("xy".repeat(-2))
print("".repeat(5))
print("好".repeat(2))
print("42".padStart(5, "0"))
print("hi".padEnd(5, "!"))
print("x".padStart(3))
print("x".padEnd(3))
print("abc".padEnd(5, ""))
print("好".padStart(6, "."))
print("hello world".replace("world", "xray"))
print("hello".replace("", "x"))
print("aaaa".replace("aa", "X"))
print("aaaa".replaceAll("aa", "X"))
print("abc".replaceAll("b", ""))

let parts = "a,b,c,d".split(",")
print(parts.length)
for (i in 0..parts.length) {
    print(parts[i])
}
let edgeParts = "a,,b,".split(",")
print(edgeParts.length)
for (i in 0..edgeParts.length) {
    print(edgeParts[i])
}
let charParts = "ab".split("")
print(charParts.length)
for (i in 0..charParts.length) {
    print(charParts[i])
}
