import text

// anchor: basic-strings
var s = "Hello, World"
print(len(s))
print(text.upper(s))
print(text.lower(s))
print(text.upper("Hello 世界🌍"))
print(text.lower("Hello 世界🌍"))
print(s.slice(0, 5))
print("abcdef".slice(3, 6))
print("abcdef".slice(2, 5))
print("abcdef".slice(3, 5))
print(s.contains("World"))
print(s.indexOf("World"))
print("a" + "b" + "c")
print(s.runes().nth(1))
print("你好🌍".runes().nth(1))
print("你好🌍".runes().nth(2))
print("abc".runes().nth(2))
print("é".bytes()[1])
print("世界".runes().nth(1).toUInt32())
print("A".runes().nth(0).toUInt32())
print("A你🌍".runes().nth(0))
print("A你🌍".runes().nth(1))
print("A你🌍".runes().nth(2))
print(text.reverseRunes("你好🌍"))
print(text.reverseRunes("a你b"))
print(i64.tryParse(" \t\r\n-17tail"))
print(i64.tryParse("abc"))
print(f64.tryParse(" \n-3.5e2tail"))
print(f64.tryParse("abc"))
print("ab".repeat(3))
print("xy".repeat(-2))
print("".repeat(5))
print("好".repeat(2))
print(text.padStart("42", 5, "0"))
print(text.padEnd("hi", 5, "!"))
print(text.padStart("x", 3))
print(text.padEnd("x", 3))
print(text.padEnd("abc", 5, ""))
print(text.padStart("好", 6, "."))
print("hello world".replace("world", "xray"))
print("hello".replace("", "x"))
print("aaaa".replace("aa", "X"))
print("aaaa".replaceAll("aa", "X"))
print("abc".replaceAll("b", ""))

var parts = "a,b,c,d".split(",")
print(len(parts))
for (i in 0..len(parts)) {
    print(parts[i])
}
var edgeParts = "a,,b,".split(",")
print(len(edgeParts))
for (i in 0..len(edgeParts)) {
    print(edgeParts[i])
}
var charParts = "ab".split("")
print(len(charParts))
for (i in 0..len(charParts)) {
    print(charParts[i])
}
