// Liveness: the CORRECT blocking form makes progress on both backends —
// this is the control case the busy-poll variants are measured against.
fn producer(ch: Channel<i64>, n: i64) {
    var i = 0
    while (i < n) {
        ch.send(i)
        i = i + 1
    }
    ch.close()
}

fn main_sum() -> i64 {
    var ch = Channel<i64>(4)
    var t = go producer(ch, 200)
    var total = 0
    for (v in ch) {
        total = total + v
    }
    await t
    return total
}

print("start")
print(main_sum())
print("done")
