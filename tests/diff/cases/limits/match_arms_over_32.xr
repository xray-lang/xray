// anchor: lowerer-match-arms-over-32
// Match lowering used to silently ignore arms after the first 32.
fn pick(x: int) -> int {
    return match (x) {
        0 -> 100
        1 -> 101
        2 -> 102
        3 -> 103
        4 -> 104
        5 -> 105
        6 -> 106
        7 -> 107
        8 -> 108
        9 -> 109
        10 -> 110
        11 -> 111
        12 -> 112
        13 -> 113
        14 -> 114
        15 -> 115
        16 -> 116
        17 -> 117
        18 -> 118
        19 -> 119
        20 -> 120
        21 -> 121
        22 -> 122
        23 -> 123
        24 -> 124
        25 -> 125
        26 -> 126
        27 -> 127
        28 -> 128
        29 -> 129
        30 -> 130
        31 -> 131
        32 -> 132
        33 -> 133
        34 -> 134
        35 -> 135
        36 -> 136
        37 -> 137
        38 -> 138
        39 -> 139
        _ -> -1
    }
}

print(pick(35))
print(pick(99))
