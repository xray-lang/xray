// anchor: lowerer-struct-literal-over-32
// Struct literals used to silently initialize only the first 32 fields.
struct Wide {
    f00: i64
    f01: i64
    f02: i64
    f03: i64
    f04: i64
    f05: i64
    f06: i64
    f07: i64
    f08: i64
    f09: i64
    f10: i64
    f11: i64
    f12: i64
    f13: i64
    f14: i64
    f15: i64
    f16: i64
    f17: i64
    f18: i64
    f19: i64
    f20: i64
    f21: i64
    f22: i64
    f23: i64
    f24: i64
    f25: i64
    f26: i64
    f27: i64
    f28: i64
    f29: i64
    f30: i64
    f31: i64
    f_32: i64
}

var w = Wide{f00: 0, f01: 1, f02: 2, f03: 3, f04: 4, f05: 5, f06: 6, f07: 7, f08: 8, f09: 9, f10: 10, f11: 11, f12: 12, f13: 13, f14: 14, f15: 15, f16: 16, f17: 17, f18: 18, f19: 19, f20: 20, f21: 21, f22: 22, f23: 23, f24: 24, f25: 25, f26: 26, f27: 27, f28: 28, f29: 29, f30: 30, f31: 31, f_32: 32}
print(w.f31 + w.f_32)
