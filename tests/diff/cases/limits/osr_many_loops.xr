// anchor: osr-entries-over-8
// A function with more than 8 loop headers exceeds the old fixed OSR entry cap
// (8) and the fixed frame-patch arrays sized for it. Under --jit-force codegen
// emits an OSR stub per loop header via the dynamic osr_snaps / safepoints /
// frame_patch buffers; before this change a 9th loop header overran them.
// Output must be identical across VM / JIT / AOT.
// (Loop bodies print a constant and carry no cross-loop state, to keep the case
// focused on loop-header count.)
fn many() {
    for (i in 0..2) { print(1) }
    for (i in 0..2) { print(2) }
    for (i in 0..2) { print(3) }
    for (i in 0..2) { print(4) }
    for (i in 0..2) { print(5) }
    for (i in 0..2) { print(6) }
    for (i in 0..2) { print(7) }
    for (i in 0..2) { print(8) }
    for (i in 0..2) { print(9) }
    for (i in 0..2) { print(10) }
}

many()
print(0)
