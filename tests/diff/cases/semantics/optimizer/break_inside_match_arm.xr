// anchor: break-inside-match-arm
// The break is nested inside a match arm rather than an if body, so the loop's
// exit edge leaves a multi-way dispatch.
fn run() {
    var sum = 0
    for (i in 0..20) {
        match (i % 4) {
            0 -> { sum = sum + 1 }
            1 -> { sum = sum + 10 }
            2 -> { break }
            _ -> { sum = sum + 100 }
        }
    }
    print(sum)
}

run()
