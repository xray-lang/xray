// anchor: break-while-induction-local-variable-bound
// The exit bound is a local whose value is loop-invariant but not a literal.
fn run() {
    var limit = 5
    var i = 0
    var sum = 0
    while (i < 100) {
        if (i >= limit) {
            break
        }
        sum = sum + i
        i = i + 1
    }
    print(sum)
    print(i)
}

run()
