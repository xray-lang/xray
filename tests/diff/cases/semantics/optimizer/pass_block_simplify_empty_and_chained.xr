// anchor: pass-block-simplify-empty-and-chained
// Block simplification: empty blocks and single-predecessor chains collapse. The
// observable order of the prints is what must not move.
fn run(n: i64) {
    if (n > 0) {
        if (n > 1) {
            if (n > 2) {
                print("three")
            }
        }
    }
    var i = 0
    while (i < 2) {
        i = i + 1
    }
    print(i)
    print(n)
}

run(3)
run(1)
