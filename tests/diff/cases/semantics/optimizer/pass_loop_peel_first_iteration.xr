// anchor: pass-loop-peel-first-iteration
// Loop peeling: the body's condition is only true on the first iteration, so
// peeling that iteration makes the rest of the loop unconditional.
fn run() {
    var sum = 0
    var first = true
    for (var i = 0; i < 8; i++) {
        if (first) {
            sum = sum + 100
            first = false
        } else {
            sum = sum + i
        }
    }
    print(sum)
}

run()
