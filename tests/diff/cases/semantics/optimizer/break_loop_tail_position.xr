// anchor: break-loop-tail-position
// The break sits at the end of the body rather than the start, so the body's
// side effects happen on the exiting iteration too.
fn run() {
    var sum = 0
    var i = 0
    while (i < 100) {
        sum = sum + i
        i = i + 1
        if (i >= 5) {
            break
        }
    }
    print(sum)
    print(i)
}

run()
