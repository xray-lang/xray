// prelude_name_lookalike_classes.xr
// VM/AOT differential coverage for user classes that reuse builtin type names.
//
// Builtin names are ordinary identifiers, so these declarations are legal and
// shadow the builtins. Every member below deliberately reuses a method name
// that CGen otherwise pattern-matches on the *builtin* receiver of the same
// name (Buffer.borrowPtr / Buffer.asBytes, Regex.test, StringBuilder.append /
// toString, Range.count). Both backends must call the user's method; matching
// the name alone would dispatch AOT into the runtime's C helper for the
// builtin and hand it an unrelated object.

class Buffer {
    n: int
    constructor(n: int) { this.n = n }
    borrowPtr() -> int { return this.n + 100 }
    asBytes() -> int { return this.n + 200 }
    asMutBytes() -> int { return this.n + 300 }
}

class Regex {
    p: string
    constructor(p: string) { this.p = p }
    test(s: string) -> bool { return s == this.p }
}

class StringBuilder {
    parts: string
    constructor() { this.parts = "" }
    append(s: string) -> string {
        this.parts = this.parts + "<" + s + ">"
        return this.parts
    }
    toString() -> string { return "user:" + this.parts }
    clear() -> int { return 7 }
}

class Range {
    lo: int
    hi: int
    constructor(lo: int, hi: int) {
        this.lo = lo
        this.hi = hi
    }
    count() -> int { return this.hi - this.lo }
}

var buf = Buffer(5)
print(buf.borrowPtr())
print(buf.asBytes())
print(buf.asMutBytes())

var re = Regex("hit")
print(re.test("hit"))
print(re.test("miss"))

var sb = StringBuilder()
sb.append("a")
sb.append("b")
print(sb.toString())
print(sb.clear())

var r = Range(4, 9)
print(r.count())
print(r.lo + r.hi)

// The builtin Range is still reached through the `a..b` literal, which no
// declaration shadows: its own count/len/index keep the builtin semantics even
// though `class Range` is declared right above. This combination also pins the
// representation plan — a builtin named instance has no declaration identity,
// so it must not adopt the same-named user class's native pointer storage. When
// it did, CGen emitted a `void *` local initialized from a tagged XrValue and
// the generated C failed to compile.
var built_in = 2..6
print(built_in.count())
print(len(built_in))
print(built_in[1])

var sum = 0
for (i in 2..6) {
    sum = sum + i
}
print(sum)
