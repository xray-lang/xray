// anchor: arg-evaluation-order
// Function arguments evaluate left-to-right across VM / JIT / AOT.
fn tap(tag: string, v: i64) -> i64 {
    print(tag)
    return v
}

fn sum3(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c
}

var r = sum3(tap("A", 1), tap("B", 2), tap("C", 3))
print(r)

var arr = [tap("X", 10), tap("Y", 20)]
print(arr[0] + arr[1])
