// Structural width constraints were removed; all fields belong to this nominal type.
struct Named {
    name: string
    age: i64 = 0
    zzz: i64 = 0
    id: i64 = 0
}

fn readDirect(value: Named) -> string {
    return value.name
}

fn readBracket(value: Named) -> string {
    return value.name
}

fn main() -> string {
    var a = readDirect(Named{ name: "ada", age: 1 })
    var b = readDirect(Named{ name: "bob", zzz: 2 })
    var c = readBracket(Named{ age: 3, name: "cat" })
    var d = readBracket(Named{ id: 4, name: "dot" })
    return a + b + c + d
}

print(main())
