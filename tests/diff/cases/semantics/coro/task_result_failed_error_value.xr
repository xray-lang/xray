enum TaskResultErr { Msg { message: string } }

fn fail_with_enum() -> i64 {
    throw TaskResultErr.Msg { message: "task-error" }
    return 0
}

var task = go fail_with_enum()
var result = task.awaitResult()

match (result) {
    TaskResult.Failed { error: err } -> {
        print(typeName(err))
        match (err) {
            TaskResultErr.Msg { message } -> print(message)
            _ -> print("unexpected payload")
        }
    }
    _ -> print("unexpected status")
}
