// anchor: coro-poll-trysend-safepoint
// A nonblocking send poll loop must yield when the channel is full, otherwise
// deterministic single-worker AOT can starve the drainer coroutine forever.

fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn spin_until_sent(ch: Channel<i64>, out: Channel<i64>) {
    var ok = false
    while (!ok) {
        ok = sent(ch.trySend(42))
    }
    out.send(1)
}

fn drain_one(ch: Channel<i64>) {
    var ignored = ch.recv()
}

const data: Channel<i64> = Channel(1)
const out: Channel<i64> = Channel(1)

assertEqual(sent(data.trySend(7)), true)

go spin_until_sent(data, out)
go drain_one(data)

var done = match (out.recvTimeout(1000)) {
    Recv.Value { value: v } -> v
    _ -> -1
}
var value = match (data.recvTimeout(1000)) {
    Recv.Value { value: v } -> v
    _ -> -1
}

data.close()
out.close()

assertEqual(done, 1)
assertEqual(value, 42)
print(done)
print(value)
