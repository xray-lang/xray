// anchor: coro-poll-tryrecv-safepoint
// A nonblocking recv poll loop must remain cooperative in AOT coroutines.
// Without the poll safepoint, deterministic single-worker AOT spins forever
// before the producer coroutine can run.

fn recv_int(ch: Channel<i64>) -> i64 {
    return match (ch.tryRecv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn producer(ch: Channel<i64>) {
    ch.send(42)
}

fn spin_until_value(ch: Channel<i64>, out: Channel<i64>) {
    var got = -1
    while (got < 0) {
        got = recv_int(ch)
    }
    out.send(got)
}

const data: Channel<i64> = Channel(0)
const out: Channel<i64> = Channel(1)

go spin_until_value(data, out)
go producer(data)

var result = match (out.recvTimeout(1000)) {
    Recv.Value(v) -> v
    _ -> -1
}

data.close()
out.close()

assertEqual(result, 42)
print(result)
