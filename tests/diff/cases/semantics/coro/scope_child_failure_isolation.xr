enum DiffScopeErr { Msg { message: string } }

fn ok(ch: Channel<i64>) -> i64 {
    ch.send(1)
    return 11
}

fn fail(ch: Channel<i64>) -> i64 {
    ch.send(10)
    throw DiffScopeErr.Msg { message: "diff_fail" }
    return 0
}

fn recv_sum(ch: Channel<i64>, count: i64) -> i64 {
    var sum = 0
    for (var i = 0; i < count; i++) {
        match (ch.recv()) {
            Recv.Value { value: v } -> { sum = sum + v }
            _ -> {}
        }
    }
    return sum
}

const ch = Channel<i64>(2)
scope {
    go ok(ch)
    go fail(ch)
}

print(recv_sum(ch, 2))
ch.close()
