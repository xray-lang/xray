fn drain_sum(ch: Channel<int>) -> int {
    var sum = 0
    for (msg in ch) {
        sum += msg
    }
    return sum
}

const ints = Channel<int>(4)
ints.send(2)
ints.send(5)
ints.send(8)
ints.close()
print(drain_sum(ints))

const fallback_ints = Channel<int>(1)
fallback_ints.send(42)
fallback_ints.close()
print(fallback_ints.recvOr(-1))
print(fallback_ints.recvOr(-1))

const words = Channel<string>(1)
words.send("xray")
words.close()
print(words.recvOr("fallback"))
print(words.recvOr("fallback"))
