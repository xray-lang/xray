fn buildMap() -> Map<i64, i64> {
    var values: Map<i64, i64> = #{}
    values[7] = 11
    return values
}

fn buildSet() -> Set<i64> {
    var values: Set<i64> = #[3, 5]
    return values
}

var mapTask = go buildMap()
var setTask = go buildSet()
var mapResult = await mapTask
var setResult = await setTask
print(mapResult[7])
print(setResult.contains(5))
