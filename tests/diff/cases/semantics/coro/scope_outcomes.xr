enum DiffScopeErr { Msg(string) }

fn ok(ch: Channel<int>) -> int {
    ch.send(1)
    return 11
}

fn fail(ch: Channel<int>) -> int {
    ch.send(10)
    throw DiffScopeErr.Msg("diff_fail")
    return 0
}

fn recv_sum(ch: Channel<int>, count: int) -> int {
    var sum = 0
    for (var i = 0; i < count; i++) {
        match (ch.recv()) {
            Recv.Value(v) -> { sum = sum + v }
            _ -> {}
        }
    }
    return sum
}

const ch = Channel<int>(2)
supervisor scope {
    go ok(ch)
    go fail(ch)
}

print(recv_sum(ch, 2))
ch.close()
