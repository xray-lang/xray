import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
const q: WorkQueue<i64> = WorkQueue<i64>(4, 2)

assertEqual(q.shardCount, 4)
assertEqual(len(q), 0)
assert(!(q.isClosed))

assert(q.push(1, 0))
assert(q.push(2, 0))
assert(q.push(3, 1))
assertEqual(len(q), 3)

var (own, own_ok) = q.tryPop(0)
assert(own_ok)
assertEqual(own, 2)

var (stolen, stolen_ok) = q.tryPop(1)
assert(stolen_ok)
assertEqual(stolen, 3)

var (remaining, remaining_ok) = q.tryPop(2)
assert(remaining_ok)
assertEqual(remaining, 1)

var (_, empty_ok) = q.tryPop(0)
assert(!(empty_ok))
assertEqual(len(q), 0)

q.close()
assert(q.isClosed)
assert(!(q.push(9, 0)))

print("workqueue native ok")
