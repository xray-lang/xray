import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
const q: WorkQueue<i64> = WorkQueue<i64>(4, 2)

assert_eq(q.shardCount, 4)
assert_eq(len(q), 0)
assert_false(q.isClosed)

assert_true(q.push(1, 0))
assert_true(q.push(2, 0))
assert_true(q.push(3, 1))
assert_eq(len(q), 3)

var (own, own_ok) = q.tryPop(0)
assert_true(own_ok)
assert_eq(own, 2)

var (stolen, stolen_ok) = q.tryPop(1)
assert_true(stolen_ok)
assert_eq(stolen, 3)

var (remaining, remaining_ok) = q.tryPop(2)
assert_true(remaining_ok)
assert_eq(remaining, 1)

var (_, empty_ok) = q.tryPop(0)
assert_false(empty_ok)
assert_eq(len(q), 0)

q.close()
assert_true(q.isClosed)
assert_false(q.push(9, 0))

print("workqueue native ok")
