// anchor: coro-await-over-array
// `await all [...]` / `await any [...]` over an array of tasks must produce
// identical results on VM and AOT. Regression: the AOT tasks-array reader cast
// the runtime array through a struct whose field order did not match the shared
// array ABI, so it read a garbage length, returned no tasks, and the awaits
// silently produced nothing on AOT while the VM printed the results.
fn compute(n: i64) -> i64 {
    return n * 100
}

// await all over an array bound to a variable
var a = go compute(1)
var b = go compute(2)
var c = go compute(3)
var group = [a, b, c]
print(await all group)

// await all over an array literal
var d = go compute(4)
var e = go compute(5)
print(await all [d, e])

// await any over an array literal; both already resolved -> array-order first
var f = go compute(6)
var g = go compute(7)
await f
await g
print(await any [f, g])
