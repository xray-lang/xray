// anchor: fixed-array-index-oob-panic-shape
struct Buf {
    data: [i64; 4]
}

fn show_direct_read(i: i64) {
    var buf = Buf{data: [1, 2, 3, 4]}
    try {
        print(buf.data[i])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_direct_write(i: i64) {
    var buf = Buf{data: [1, 2, 3, 4]}
    try {
        buf.data[i] = 9
        print(buf.data[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn write_view(view: ref [i64; 4], i: i64) {
    view[i] = 9
}

fn show_view_write(i: i64) {
    var buf = Buf{data: [1, 2, 3, 4]}
    try {
        write_view(ref buf.data, i)
        print(buf.data[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

show_direct_read(-1)
show_direct_write(4)
show_view_write(5)
