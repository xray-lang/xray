// anchor: panic-exception-shape
// `catch panic (p)` exposes an Exception-shaped value on both VM and AOT:
// message is the user-visible text without the Exxxx prefix, and code is the
// numeric runtime error code.
fn show_index_read(i: int) {
    let xs = [1, 2, 3]
    try {
        print(xs[i])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_index_write(i: int) {
    let xs = [1, 2, 3]
    try {
        xs[i] = 9
        print(xs[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_div_zero() {
    try {
        print(10 / 0)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_mod_zero() {
    try {
        print(10 % 0)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_bytes_load_oob() {
    let bytes = Bytes(4, 1)
    let view: ByteSpan = bytes
    try {
        let value: uint32 = view.loadLE<uint32>(2)
        print(int(value))
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_bytes_copy_within_oob() {
    let bytes = Bytes.withCapacity(4)
    unsafe {
        bytes.pushUnchecked(1)
    }
    try {
        unsafe {
            bytes.repeatFromUnchecked(2, 4)
        }
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_bytes_ctor_type_error() {
    try {
        let bytes1 = Bytes("bad")
        print(bytes1.length)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }

    try {
        let bytes2 = Bytes(2, "bad")
        print(bytes2.length)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_slice_bounds_type_error() {
    let xs = [1, 2, 3]
    try {
        print(xs["a":"b"].length)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

show_index_read(-1)
show_index_write(5)
show_div_zero()
show_mod_zero()
show_bytes_load_oob()
show_bytes_copy_within_oob()
show_bytes_ctor_type_error()
show_slice_bounds_type_error()
