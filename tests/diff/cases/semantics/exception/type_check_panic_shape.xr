// anchor: type-check-panic-shape
// Typed JSON path reads must raise the same structured type-mismatch panic on
// VM and AOT when the selected value does not match the requested type.

fn takes_bool(x: bool) {
    print("bool=" + x.toString())
}

var dyn: JSON.Object = JSON.parseObject("{\"badInt\":3.5,\"badBool\":1}")

try {
    var value: int = JSON.require<int>(dyn, ["badInt"])
    print(value)
} catch panic (p) {
    print(p.message)
    print(p.code)
}

try {
    takes_bool(JSON.require<bool>(dyn, ["badBool"]))
    print("bad-arg")
} catch panic (p) {
    print(p.message)
    print(p.code)
}

try {
    print(JSON.require<int>(dyn, ["badInt"]))
    print("bad-return")
} catch panic (p) {
    print(p.message)
    print(p.code)
}
