// anchor: string-number-conversion-panic-shape
// diff-backends: vm
// diff-aot-reject: XR_AOT_REFINEMENT_REPRESENTATION_SCHEMA_UNAVAILABLE
// The AOT refinement authority rejects the builtin numeric conversions before
// codegen -- XR_AOT_REFINEMENT_REPRESENTATION_SCHEMA_UNAVAILABLE -- so the
// native lane cannot build this case yet. That gap predates this case and is
// not specific to strings: semantics/int/contextual_numeric_conversion.xr is
// rejected the same way with no string conversion in it at all. The runtime
// side is still shared: all three profiles call one parse core and one pair of
// message constants, and the parse core itself is covered by
// tests/unit/stdlib/test_string_core.c. Drop this directive once native
// planning admits the conversions.
//
// §13.2: int(s) / float(s) parse the whole string and throw when it is not a
// decimal number. Both builtins are declared to return non-null int / float,
// so a failed parse has no null to hand back -- it raises the same structured
// panic, with the same code and text, on every backend.
//
// The accepted grammar is shared by i64/f64 parse and tryParse.
// already enforce, so trailing residue such as "12abc" is a rejection rather
// than a silent 12, and integer overflow is rejected instead of saturated.

// Indexed through an array so the values reach the conversion at runtime
// rather than as folded literals.
var ints: Array<string> = ["12", "  -7 ", "+42", "9223372036854775807"]
var i = 0
while (i < len(ints)) {
    print((ints[i] as i64))
    i = i + 1
}

var badInts: Array<string> = ["12abc", "", "   ", "0x10", "1.5", "12 34", "+", "9223372036854775808"]
var j = 0
while (j < len(badInts)) {
    try {
        print((badInts[j] as i64))
    } catch panic (p) {
        print(string(p.code) + " " + p.message)
    }
    j = j + 1
}

var floats: Array<string> = ["1.5e3", ".5", "1.", "  2.5  ", "-0.125"]
var k = 0
while (k < len(floats)) {
    print((floats[k] as f64))
    k = k + 1
}

var badFloats: Array<string> = ["1.5x", "", "1e", "1e+", ".", "inf", "nan"]
var m = 0
while (m < len(badFloats)) {
    try {
        print((badFloats[m] as f64))
    } catch panic (p) {
        print(string(p.code) + " " + p.message)
    }
    m = m + 1
}
