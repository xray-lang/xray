// anchor: string-number-conversion-panic-shape
// diff-backends: vm
// diff-aot-reject: XR_TARGET_1003
// TargetPlan currently rejects the exact scalar parse call before native
// codegen because it has no exact target authority for the static primitive
// method. The runtime side is still shared: all profiles call one parse core
// and one pair of message constants, and the parse core itself is covered by
// tests/unit/stdlib/test_string_core.c. Drop this directive once TargetPlan
// admits the parse calls.
//
// Required i64/f64 parsing consumes the whole string and throws when it is not
// a decimal number. Both methods return a non-null scalar, so failed parsing
// raises the same structured panic, with the same code and text, on every
// backend. Text parsing is intentionally not an `as` numeric conversion.
//
// parse and tryParse share the accepted grammar, so trailing residue such as
// "12abc" is rejected rather than yielding 12, and integer overflow is
// rejected instead of saturated.

// Indexed through an array so the values reach the conversion at runtime
// rather than as folded literals.
var ints: Array<string> = ["12", "  -7 ", "+42", "9223372036854775807"]
var i = 0
while (i < len(ints)) {
    print(i64.parse(ints[i]))
    i = i + 1
}

var badInts: Array<string> = ["12abc", "", "   ", "0x10", "1.5", "12 34", "+", "9223372036854775808"]
var j = 0
while (j < len(badInts)) {
    try {
        print(i64.parse(badInts[j]))
    } catch panic (p) {
        print(string(p.code) + " " + p.message)
    }
    j = j + 1
}

var floats: Array<string> = ["1.5e3", ".5", "1.", "  2.5  ", "-0.125"]
var k = 0
while (k < len(floats)) {
    print(f64.parse(floats[k]))
    k = k + 1
}

var badFloats: Array<string> = ["1.5x", "", "1e", "1e+", ".", "inf", "nan"]
var m = 0
while (m < len(badFloats)) {
    try {
        print(f64.parse(badFloats[m]))
    } catch panic (p) {
        print(string(p.code) + " " + p.message)
    }
    m = m + 1
}
