// anchor: string-number-parse-error-shape
// Required i64/f64 parsing consumes the whole string. Failure is a typed
// NumberParseError; it never crosses the panic channel. The runtime-neutral
// parser KAT covers the full accepted grammar, while this fixture locks the
// VM/AOT failure channel and exact public variants.

var validInt = "  -7 "
print(i64.parse(validInt))

var invalidInt = "12abc"
try {
    print(i64.parse(invalidInt))
} catch NumberParseError.InvalidSyntax {
    print("i64.InvalidSyntax")
} catch NumberParseError.OutOfRange {
    print("i64.OutOfRange")
}

var overflowInt = "9223372036854775808"
try {
    print(i64.parse(overflowInt))
} catch NumberParseError.InvalidSyntax {
    print("overflow.InvalidSyntax")
} catch NumberParseError.OutOfRange {
    print("overflow.OutOfRange")
}

var validFloat = "1.5e3"
print(f64.parse(validFloat))
var hugeFloat = "1e400"
print(f64.parse(hugeFloat))

var invalidFloat = "1e+"
try {
    print(f64.parse(invalidFloat))
} catch NumberParseError.InvalidSyntax {
    print("f64.InvalidSyntax")
} catch NumberParseError.OutOfRange {
    print("f64.OutOfRange")
}

var optionalInvalid = "not-a-number"
print(i64.tryParse(optionalInvalid) == null)
print(f64.tryParse(optionalInvalid) == null)
