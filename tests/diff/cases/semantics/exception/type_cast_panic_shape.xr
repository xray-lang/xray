// anchor: type-cast-panic-shape
// Non-primitive unsafe `as` casts must raise the same structured type-mismatch
// panic on VM and AOT; safe casts still return null.

var dyn: Json = { "bad": 3.5, "items": [1, 2, 3] }

try {
    var value = dyn.bad as Array<Json>
    print(len(value))
} catch panic (p) {
    print(p.message)
    print(p.code)
}

var maybeItems = dyn.items as Array<Json>?
if (maybeItems == null) {
    print("missing")
} else {
    print(len(maybeItems))
}

var maybeBad = dyn.bad as Array<Json>?
if (maybeBad == null) {
    print("safe-null")
} else {
    print(len(maybeBad))
}
