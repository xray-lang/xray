// anchor: float-f32-rounding
// float32 values are computed in double then narrowed to single precision on
// store; VM and AOT must apply the same narrowing for identical observable
// results.
var a: float32 = 0.1
var b: float32 = 0.2
var c: float32 = a * b
print(c)
var d: float32 = a + b
print(d)
var e: float32 = a * a + b * b
print(e)
var f: float32 = 1.0 / 3.0
print(f)
