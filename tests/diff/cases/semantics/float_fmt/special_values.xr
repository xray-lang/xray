// anchor: float-special-values
// Signed zeros must render identically on every backend: -0.0 keeps its sign
// through formatting and arithmetic, and +0.0 compares equal to -0.0. IEEE
// infinities and NaN from arithmetic are covered by float_fmt/ieee_arithmetic.
print(-0.0)
print(0.0)
print(0.0 == -0.0)
print(0.0 * -1.0)
print(-1.0 * 0.0)
print((0.0 * -1.0) == 0.0)
print(1.0 / 2.0)
print(-1.0 / 4.0)
