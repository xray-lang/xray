// anchor: nullable-primitive-display
// C5: nullable primitives (int?/float?/bool?) are kept. A null value must
// render as "null" (not its raw numeric payload) and non-null values must
// round-trip, identically in VM and AOT.

var i: i64? = null
var f: f64? = null
var b: bool? = null
print(i)              // null
print(f)              // null
print(b)              // null
print(string(i))      // null
print("i=" + string(i))

var i2: i64? = 5
var f2: f64? = 1.5
var b2: bool? = true
print(i2)             // 5
print(f2)             // 1.5
print(b2)             // true
print("i2=" + string(i2))
print("f2=" + string(f2))
print("b2=" + string(b2))
print("cat=" + string(i))
