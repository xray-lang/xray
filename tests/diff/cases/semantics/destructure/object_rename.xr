// anchor: destructure-object-rename
struct User {
    name: string
    age: i64
    city: string
}

var user = User{ name: "Alice", age: 30, city: "Shanghai" }

var localName = user.name
var age = user.age
print(localName)
print(age)

var otherName = ""
var otherCity = ""
otherName = user.name
otherCity = user.city
print(otherName)
print(otherCity)
