import { Capabilities, U8x16, U8x32, U32x4, U32x8, U64x2, U64x4 } from simd

fn run() {
    var bytes = Array<byte>(32)
    for (i in 0..32) {
        bytes[i] = (i * 17 + 3) & 255
    }
    var byteView: Slice<byte> = bytes[:]
    var b = U8x16.load(byteView, 3)
    assert_eq(b.extract(0), bytes[3])
    assert_eq(b.extract(15), bytes[18])
    assert_eq(b.bitXor(U8x16.splat(255)).extract(4), (~bytes[7]) as byte)
    var words = Array<uint32>([1, 2, 3, 4, 5, 6])
    var wordView: Slice<uint32> = words[:]
    var a32 = U32x4.load(wordView, 1)
    var b32 = U32x4.splat(7)
    assert_eq(a32.add(b32).extract(0), 9)
    assert_eq(a32.mul(b32).extract(3), 35)
    assert_eq(a32.shiftLeft(3).shiftRight(3).extract(2), 4)
    assert_eq(a32.shuffle(3, 2, 1, 0).extract(0), 5)
    assert_eq(a32.swapAdjacent().extract(0), 3)
    assert_eq(a32.swapAdjacent().extract(2), 5)
    var wide = a32.widenMulEven(b32)
    assert_eq(wide.extract(0), 14)
    assert_eq(wide.extract(1), 28)
    assert_eq(a32.widenMulOdd(b32).reduceAdd(), 56)
    var lanes64: [uint64; 2] = [18446744073709551615, 9]
    var a64 = U64x2.fromLanes(lanes64)
    assert_eq(a64.add(U64x2.splat(1)).extract(0), 0)
    assert_eq(a64.swapLanes().extract(0), 9)
    assert_eq(a64.replace(1, 21).extract(1), 21)
    assert_eq(a64.reinterpretU32().extract(0), 4294967295)
    assert_eq(a64.reinterpretU32().reinterpretU64().extract(1), 9)
    var roundTrip = b.reinterpretU32().reinterpretU8()
    for (i in 0..16) {
        assert_eq(roundTrip.extract(i), b.extract(i))
    }
    var importedReturn = b.reinterpretU32()
    assert_eq(importedReturn.swapAdjacent().extract(0), importedReturn.extract(1))
    var roundTrip64 = b.reinterpretU64().reinterpretU8()
    for (i in 0..16) {
        assert_eq(roundTrip64.extract(i), b.extract(i))
    }
    var out = Array<uint64>(4)
    var outView: Slice<uint64> = out[:]
    a64.store(outView, 1)
    assert_eq(out[1], lanes64[0])
    assert_eq(out[2], lanes64[1])
    var wideWords: [uint32; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var x32 = U32x8.fromLanes(wideWords)
    var products = x32.widenMulEven(x32.swapAdjacent())
    var wide64: [uint64; 4] = [10, 20, 30, 40]
    var combined = U64x4.fromLanes(wide64).add(U64x4.fromLanes(wide64).swapAdjacent())
    combined = combined.add(products)
    assert_eq(combined.reduceAdd(), 300)
    var wideOut = Array<uint64>(4)
    var wideOutView: Slice<uint64> = wideOut[:]
    combined.store(wideOutView)
    assert_eq(wideOut[0], 32)
    assert_eq(wideOut[1], 42)
    assert_eq(wideOut[2], 100)
    assert_eq(wideOut[3], 126)
    var xbytes = U8x32.load(byteView).bitXor(U8x32.load(byteView))
    xbytes.reinterpretU64().store(wideOutView)
    assert_eq(wideOut[0], 0)
    assert(Capabilities.nativeBytes() >= 16)
    print("OK simd portable integer vectors")
}

run()
