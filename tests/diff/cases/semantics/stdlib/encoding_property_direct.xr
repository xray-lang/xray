// Deterministic task-200 encoding property corpus. The full-byte hex vector is
// generated independently with Python bytes.hex; VM and AOT must also agree on
// generated roundtrips, strict UTF-8 boundaries, UTF-16 pairs, and typed errors.

import encoding
import { HexError, Utf16DecodeOptions, Utf16EncodeOptions, Utf16Error } from encoding

const ALL_BYTES_HEX = ""

fn sameBytes(a: Array<u8>, b: Array<u8>) -> bool {
    if (len(a) != len(b)) { return false }
    for (var i = 0; i < len(a); i++) {
        if (a[i] != b[i]) { return false }
    }
    return true
}

fn nextState(state: i64) -> i64 {
    return (state * 48271) % 2147483647
}

fn fuzzBytes(length: i64, seed: i64) -> Array<u8> {
    var out = Array<u8>(length)
    var state = seed
    for (var i = 0; i < length; i++) {
        state = nextState(state)
        out[i] = (state & 255) as u8
    }
    return out
}

fn utf16EncodeOptions(order: Endian) -> Utf16EncodeOptions {
    var options = Utf16EncodeOptions()
    options.order = order
    return options
}

fn utf16DecodeOptions(order: Endian) -> Utf16DecodeOptions {
    var options = Utf16DecodeOptions()
    options.order = order
    return options
}

fn hexErrorCode(text: string) -> i64 {
    try {
        var decoded = encoding.hexDecode(text)
        return -1 - len(decoded)
    } catch (e: HexError) {
        return match (e) {
            HexError.OddLength(length) -> 1000 + length,
            HexError.InvalidDigit(offset, value) -> 2000 + offset
        }
    }
}

fn utf16ErrorCode(data: Slice<u8>) -> i64 {
    try {
        var decoded = encoding.utf16Decode(data)
        return -1 - len(decoded)
    } catch (e: Utf16Error) {
        return match (e) {
            Utf16Error.OddByteLength(length) -> 1000 + length,
            Utf16Error.UnexpectedLowSurrogate(offset, value) -> 2000 + offset,
            Utf16Error.MissingLowSurrogate(offset, value) -> 3000 + offset,
            Utf16Error.InvalidLowSurrogate(offset, value) -> 4000 + offset
        }
    }
}

var allBytes = Array<u8>(256)
for (var i = 0; i < 256; i++) { allBytes[i] = i as u8 }
print(encoding.hexEncode(allBytes[:]) == ALL_BYTES_HEX)

var roundtripOk = true
for (var length = 0; length <= 96; length++) {
    var input = fuzzBytes(length, 193 + length)
    var decoded = encoding.hexDecode(encoding.hexEncode(input[:]))
    if (!sameBytes(input, decoded)) { roundtripOk = false }
}
print(roundtripOk)

var singleByteUtf8Ok = true
var one = Array<u8>(1)
for (var value = 0; value < 256; value++) {
    one[0] = value as u8
    if (encoding.utf8Valid(one[:]) != (value < 128)) { singleByteUtf8Ok = false }
}
print(singleByteUtf8Ok)

var twoByteUtf8Ok = true
var pair = Array<u8>(2)
for (var lead = 0xC2; lead <= 0xDF; lead++) {
    pair[0] = lead as u8
    for (var trail = 0x80; trail <= 0xBF; trail++) {
        pair[1] = trail as u8
        if (!encoding.utf8Valid(pair[:])) { twoByteUtf8Ok = false }
    }
}
print(twoByteUtf8Ok)

var text = "A😀𝄞"
var le = encoding.utf16Encode(text)
var be = encoding.utf16Encode(text, utf16EncodeOptions(Endian.BE))
print(len(le))
print(encoding.utf16Decode(le[:]) == text)
print(encoding.utf16Decode(be[:], utf16DecodeOptions(Endian.BE)) == text)

print(hexErrorCode("abc"))
print(hexErrorCode("0g"))
var odd = Array<u8>(1)
print(utf16ErrorCode(odd[:]))
var low = Array<u8>(2)
low[0] = 0x00
low[1] = 0xDC
print(utf16ErrorCode(low[:]))
var high = Array<u8>(2)
high[0] = 0x00
high[1] = 0xD8
print(utf16ErrorCode(high[:]))
var invalidPair = Array<u8>(4)
invalidPair[0] = 0x00
invalidPair[1] = 0xD8
invalidPair[2] = 0x41
invalidPair[3] = 0x00
print(utf16ErrorCode(invalidPair[:]))
