// mem.pageAlloc's optional protection argument belongs to its Xray declaration;
// both call shapes reach one exact private native mapping leaf.
import mem

fn run() {
    var first = mem.pageAlloc(4096)
    print(first.isNull())
    print(mem.pageFree(first, 4096))

    // PROT_READ | PROT_WRITE. Keep this fixture focused on source default
    // materialization and explicit native-leaf arguments.
    var second = mem.pageAlloc(4096, 3)
    print(second.isNull())
    print(mem.pageFree(second, 4096))
    print("ok")
}

run()
