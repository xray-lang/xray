// AOT core-math direct calls must preserve the stdlib runtime's dynamic value
// shape for integer-preserving helpers. These used to lower to double-only C
// expressions, producing 42.0/3.0/7.0 and "float" where the VM produced ints.
import math
import { min as mmin, max as mmax, clamp as cclamp } from "math"

let a = math.abs(-42)
print(typeof(a))
print(a)

let amin = math.abs(math.MIN_INT)
print(typeof(amin))

print(typeof(math.min()))
print(math.min())

let mn = math.min(3, 7, 5)
print(typeof(mn))
print(mn)

let mx = math.max(3, 7, 5)
print(typeof(mx))
print(mx)

let cl = math.clamp(5, 10, 0)
print(typeof(cl))
print(cl)

print(mmin(9, 4, 6))
print(mmax(9, 4, 6))
print(cclamp(15, 10, 0))

print(typeof(math.min(3.5, 7.2)))
print(math.clamp(5.5, 10.0, 0.0))

print(math.floor(1.8))
print(math.ceil(1.2))
print(math.round(1.6))
print(math.trunc(1.8))
print(math.sin(0))
print(math.cos(0))
print(math.tan(0))
print(math.asin(0))
print(math.acos(1))
print(math.atan(0))
print(math.atan2(0, 1))
print(math.log(1))
print(math.log10(100))
print(math.log2(8))
print(math.exp(0))
print(math.sinh(0))
print(math.cosh(0))
print(math.tanh(0))
print(math.hypot(3, 4))
print(math.cbrt(27))
print(math.fmod(7, 4))
print(math.log1p(0))
print(math.expm1(0))
print(math.lerp(2, 4, 0.25))
print(math.degToRad(0))
print(math.radToDeg(0))
print(math.sign(-10))
print(math.isNaN(math.sqrt(-1)))
print(math.isFinite(1))
print(math.isFinite(math.sqrt(-1)))
