// Pure-Xray cluster protocol helper surface.
import cluster
import {
    AddressError,
    HANDSHAKE_VERSION,
    TOPIC_DEFAULT_HOP_LIMIT,
    validNodeName,
    parseAddress,
    validTopicName,
    validTopicPattern,
    topicMatches
} from cluster

print(HANDSHAKE_VERSION)
print(TOPIC_DEFAULT_HOP_LIMIT)

print(validNodeName("node-a"))
print(validNodeName(""))
print(validNodeName("bad\nname"))
var addr = parseAddress("127.0.0.1:9000")
print(addr.host)
print(addr.port)

var v6 = parseAddress("[::1]:9001")
print(v6.host)
print(v6.port)

fn addressError(text: string) -> string {
    try {
        parseAddress(text)
    } catch (e: AddressError) {
        return match (e) {
            AddressError.MissingPort { address: value } -> "missing:" + value,
            AddressError.InvalidHost { host: value } -> "host:" + value,
            AddressError.InvalidPort { port: value } -> "port:" + value
        }
    }
    return "none"
}

print(addressError("missing-port"))
print(addressError("host:0"))
print(addressError("host:not-a-port"))
print(addressError("::1:9000"))

print(validTopicName("events.user.login"))
print(validTopicName("events.*"))
print(validTopicPattern("events.*"))
print(validTopicPattern("events.>"))
print(validTopicPattern("events.>.bad"))
print(validTopicPattern("events..bad"))

print(topicMatches("events.*", "events.user"))
print(topicMatches("events.*", "events.user.login"))
print(topicMatches("events.>", "events.user.login"))
print(topicMatches("events.>", "events"))
print(topicMatches("events.*.login", "events.user.login"))
print(topicMatches("events.*.login", "events.user.logout"))
print(topicMatches(">", "events"))
print(topicMatches(">", ""))
print(cluster.topicMatches("chat.room1", "chat.room1"))
