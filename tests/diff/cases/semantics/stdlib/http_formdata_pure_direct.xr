// Pure-Xray HTTP multipart/form-data builder.

import http
import { formData } from http
import io

var form = formData()
print(form.boundary.startsWith("----XrayFormBoundary"))
print(form.append("name", "Xray"))
var built = form.build()
print(built.contentType.startsWith("multipart/form-data; boundary=----XrayFormBoundary"))
print(built.body.contains("Content-Disposition: form-data; name=\"name\"\r\n\r\n"))
print(built.body.contains("\r\n\r\nXray\r\n"))
print(built.body.endsWith("--\r\n"))

var dir = io.tempDir()!
var path = dir + "/upload.txt"
print(io.writeFile(path, "file-data"))
var fileForm = http.formData()
print(fileForm.appendFile("upload", path))
var fileBuilt = fileForm.build()
print(fileBuilt.body.contains("name=\"upload\"; filename=\"upload.txt\""))
print(fileBuilt.body.contains("Content-Type: text/plain\r\n\r\n"))
print(fileBuilt.body.contains("\r\n\r\nfile-data\r\n"))

var limited = formData(3, 3)
print(limited.append("field", "abcd"))
print(limited.totalSize)
var unlimited = formData(0, 0)
print(unlimited.append("field", "abcd"))
print(unlimited.totalSize)

var bigPath = dir + "/big.bin"
print(io.writeFile(bigPath, "abcd"))
var fileLimited = formData(0, 3)
print(fileLimited.appendFile("file", bigPath))
print(fileLimited.totalSize)
