// sys.OsCondvar uses a pthread-style external sys.OsMutex. The timed wait keeps
// this differential case deterministic and avoids blocking the test runner.

import sys

var m = sys.OsMutex()
var cv = sys.OsCondvar()

m.lock()
print(cv.waitFor(m, 1000000))
m.unlock()

cv.signal()
cv.broadcast()
print(true)
