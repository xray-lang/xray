// mem.copy/move/set/compare + mem.cacheLineSize. Copy/fill/compare and all
// count validation are Xray-owned; only overlap-tolerant move remains a host
// primitive. MutPtr args flow into Ptr params via mut->const coercion.
import mem
extern "C" {
    fn malloc(n: usize) -> MutPtr<u8>
    fn free(p: MutPtr<u8>)
}

print(mem.cacheLineSize())

var src = unsafe { malloc(8) }
var dst = unsafe { malloc(8) }

// set: fill src with 7
mem.set(src, 7, 8)
unsafe { print(src[0]) }
unsafe { print(src[7]) }

// copy: src -> dst
mem.copy(dst, src, 8)
unsafe { print(dst[0]) }
unsafe { print(dst[5]) }

// compare equal -> 0
print(mem.compare(src, dst, 8))

// diverge dst[0], compare non-zero
unsafe { dst[0] = 9 }
print(mem.compare(src, dst, 8) != 0)

// Non-positive ranges are uniformly empty and never dereference their pointers.
mem.copy(MutPtr<u8>.null(), Ptr<u8>.null(), -1)
mem.move(MutPtr<u8>.null(), Ptr<u8>.null(), 0)
mem.set(MutPtr<u8>.null(), 255, -1)
print(mem.compare(Ptr<u8>.null(), Ptr<u8>.null(), -1))

// move (overlapping): dst = [5,1,1,1,1,1,1,1]; copy [0..4) to [2..6)
mem.set(dst, 1, 8)
unsafe { dst[0] = 5 }
unsafe { dst[1] = 6 }
var mid = unsafe { dst.offset(2) }
mem.move(mid, dst, 4)
unsafe { print(dst[2]) }
unsafe { print(dst[3]) }

unsafe { free(src) }
unsafe { free(dst) }
print("ok")
