// Pure-Xray HTTP/1.1 request text helper.
import http
import { Headers, HttpError, requestText } from http

fn withHeader(name: string, value: string) -> Headers {
    var headers = Headers()
    headers.add(name, value)
    return headers
}

fn line(label: string, value: string?) {
    print(label)
    if (value == null) {
        print("null")
    } else {
        print(value!.replaceAll("\r\n", "|"))
    }
}

var basic = requestText("get", "/api?q=1", withHeader("X-Test", "ok"), "", "example.com")
line("basic", basic)

var body = requestText(
    "post",
    "/submit",
    withHeader("Content-Type", "text/plain"),
    "hello",
    "example.com"
)
line("body", body)

var customHost = requestText("GET", "/", withHeader("Host", "override.test"))
line("custom-host", customHost)

var customEncoding = requestText("GET", "/", withHeader("Accept-Encoding", "identity"), "", "example.com")!
print(customEncoding.contains("Accept-Encoding: identity"))
print(customEncoding.contains("Accept-Encoding: gzip, deflate"))

var emptyHeaders = Headers()
var privateHeaders = Headers()
privateHeaders.add("Authorization", "secret")
privateHeaders.add("Proxy-Authorization", "proxy-secret")
privateHeaders.add("Accept", "application/json")
var stripped = requestText(
    "GET",
    "/private",
    privateHeaders,
    "",
    "api.test",
    true
)
print(stripped!.contains("Authorization"))
print(stripped!.contains("Proxy-Authorization"))
print(stripped!.contains("Accept: application/json"))

print(requestText("GET", "/bad path", emptyHeaders, "", "example.com") == null)
var injectionRejected = false
try {
    var badHeaders = Headers()
    badHeaders.add("X-Bad", "a\r\nInjected: y")
} catch (e: HttpError) {
    injectionRejected = true
}
print(injectionRejected)
print(requestText("GET", "/", emptyHeaders, "", "bad host") == null)
print(http.requestText("GET", "/", emptyHeaders, "", "example.com") != null)
