// Pure-Xray `path` module: VM/AOT parity for every operation, including the
// variadic namespace calls path.join(...) / path.resolve(...) and the typed
// PathInfo returned by path.parse.
import path

print(path.sep)
print(path.delimiter)
print(path.join(path.from("foo"), path.from("bar"), path.from("baz")).toString())
print(path.join(path.from("/usr"), path.from("local"), path.from("bin")).toString())
print(path.join(path.from("foo/"), path.from("bar")).toString())
print(path.dirname(path.from("/usr/local/bin/xray")).toString())
print(path.dirname(path.from("file.txt")).toString())
print(path.basename(path.from("/home/user/file.txt")))
print(path.extname(path.from("archive.tar.gz")))
print(path.extname(path.from(".gitignore")))
print(path.normalize(path.from("/usr/local/../bin/./xray")).toString())
print(path.normalize(path.from("foo/bar/../../baz")).toString())
print(path.isAbsolute(path.from("/abs")))
print(path.isAbsolute(path.from("rel")))
print(path.relative(path.from("/usr/local/bin"), path.from("/usr/local/lib")).toString())
print(path.relative(path.from("/a/b/c"), path.from("/a/x/y")).toString())
print(path.resolve(path.from("/foo"), path.from("/bar"), path.from("baz")).toString())
print(path.resolve(path.from("/tmp"), path.from("../var")).toString())

var p = path.parse(path.from("/home/user/file.txt"))
print(p.root)
print(p.dir.toString())
print(p.base)
print(p.name)
print(p.ext)
print(path.format(p).toString())
