import xml
import { XmlNode, XmlName, XmlAttribute } from xml

fn nodeKind(node: XmlNode) -> string {
    return match (node) {
        XmlNode.Document { children: kids }              -> "document",
        XmlNode.Element { name, attributes: attrs, children: kids }  -> "element",
        XmlNode.Text { content: s }                     -> "text",
        XmlNode.Comment { content: s }                  -> "comment",
        XmlNode.CData { content: s }                    -> "cdata",
        XmlNode.ProcessingInstruction { target: t, data: d } -> "pi"
    }
}

var doc = xml.parse("<?xml version=\"1.0\"?><root xmlns=\"urn:x\" id=\"7\"><item>A&amp;B</item><![CDATA[<raw>]]></root>")
print(xml.tag(doc) ?? "")
print(xml.attr(doc, "id") ?? "")
print(xml.namespace(doc, "") ?? "")
var kids = xml.children(doc)
print(len(kids))
print(xml.textContent(kids[0]))
print(nodeKind(kids[1]))
print(xml.nodeText(kids[1]) ?? "")

var cdataAsText = xml.parse("<root><![CDATA[plain]]></root>",
    { preserveWhitespace: false, preserveComments: false, preserveCData: false, validateEntities: true })
print(nodeKind(xml.children(cdataAsText)[0]))
print(xml.textContent(cdataAsText))

var comments = xml.parse("<root><!-- keep --><leaf/></root>",
    { preserveWhitespace: false, preserveComments: true, preserveCData: true, validateEntities: true })
print(len(xml.children(comments)))
print(nodeKind(xml.children(comments)[0]))

var report = xml.parseReport("<ok/>")
if (report.doc != null) {
    print(xml.tag(report.doc!) ?? "")
}
print(len(report.diagnostics))

var made = xml.element("entry", [XmlAttribute(XmlName("", "id"), "42")], [xml.text("body")])
print(xml.tag(made) ?? "")
print(xml.attr(made, "id") ?? "")
print(xml.textContent(made))
print(xml.qualifiedName(made)!.qualified())

var textNode = xml.text("<hello>&")
print(nodeKind(textNode))
print(xml.nodeText(textNode) ?? "")

var round = xml.stringify(xml.parse("<msg>Hello&lt;World</msg>"),
    { indent: 0, declaration: false, encoding: "UTF-8" })
print(round)
print(xml.stringify(made, { indent: 0, declaration: false, encoding: "UTF-8" }))
