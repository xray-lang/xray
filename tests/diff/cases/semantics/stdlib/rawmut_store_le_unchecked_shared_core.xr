// anchor: rawmut-store-le-unchecked-shared-core
// MutPtr<byte>.storeLE<T> is the write-side pair of
// Ptr<byte>.loadLE<T>: unsafe, unchecked, little-endian, and
// intentionally limited to uint16/uint32/uint64.
fn run() {
    var bytes = Array<byte>(16)
    var view: Slice<byte> = bytes[:]
    unsafe {
        var p = view.mutPtr()
        p.storeLE<uint16>(1, 0x1234)
        p.storeLE<uint32>(4, 0x01020304)
        p.storeLE<uint64>(8, 0x0102030405060708)

        var rp: Ptr<byte> = p
        print(int(rp.loadLE<uint16>(1)))
        print(int(rp.loadLE<uint32>(4)))
        print(int(rp.loadLE<uint64>(8)))
    }

    print(bytes[1])
    print(bytes[2])
    print(bytes[4])
    print(bytes[5])
    print(bytes[6])
    print(bytes[7])
    print(bytes[8])
    print(bytes[15])
}

run()
