// anchor: mem-load-store-shared-core
// mem.load/store<T> are unsafe, unchecked, unaligned raw-memory primitives.
import mem

fn run() {
    var bytes = Array<byte>(16)
    var view: Slice<byte> = bytes[:]
    unsafe {
        var p = view.mutPtr()
        mem.store<uint16>(p, 1, 0x1234, Endian.LE)
        mem.store<uint32>(p, 4, 0x01020304, Endian.LE)
        mem.store<uint64>(p, 8, 0x0102030405060708, Endian.LE)

        var rp: Ptr<byte> = p
        print(int(mem.load<uint16>(rp, 1, Endian.LE)))
        print(int(mem.load<uint32>(rp, 4, Endian.LE)))
        print(int(mem.load<uint64>(rp, 8, Endian.LE)))
    }

    print(bytes[1])
    print(bytes[2])
    print(bytes[4])
    print(bytes[5])
    print(bytes[6])
    print(bytes[7])
    print(bytes[8])
    print(bytes[15])
}

run()
