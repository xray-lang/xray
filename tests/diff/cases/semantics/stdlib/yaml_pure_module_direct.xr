import yaml
import { YamlValue } from yaml

// Matching an ADT value into a scalar (string) is AOT-safe; returning an
// unwrapped enum aggregate from a helper is not, so navigation below uses
// local `var` bindings rather than YamlValue-returning helpers.
fn kindOf(v: YamlValue) -> string {
    return match (v) {
        YamlValue.Null          -> "null",
        YamlValue.Boolean { value: b }    -> "bool",
        YamlValue.Integer { value: n }    -> "int",
        YamlValue.Float { value: f }      -> "float",
        YamlValue.String { value: s }     -> "string",
        YamlValue.Binary { bytes } -> "binary",
        YamlValue.Sequence { items: xs }  -> "seq",
        YamlValue.Mapping { mapping: m }    -> "map",
        YamlValue.Tagged { tagged: t }     -> "tagged",
        YamlValue.Alias { anchor: a }      -> "alias"
    }
}

var doc = yaml.parse("app:\n  name: xray\n  ports: [80, 443]\n  limits: {max: 100, timeout: 30}\nitems:\n  - id: 1\n    status: done\n  - {id: 2, status: pending}\n")
var app = yaml.get(doc, "app")!
print(yaml.asString(yaml.get(app, "name")!) ?? "")
var ports = yaml.get(app, "ports")!
print(yaml.asInt(yaml.at(ports, 1)!) ?? -1)
var limits = yaml.get(app, "limits")!
print(yaml.asInt(yaml.get(limits, "max")!) ?? -1)
var items = yaml.get(doc, "items")!
print(yaml.length(items))
var item0 = yaml.at(items, 0)!
print(yaml.asString(yaml.get(item0, "status")!) ?? "")
var item1 = yaml.at(items, 1)!
print(yaml.asInt(yaml.get(item1, "id")!) ?? -1)
print(kindOf(doc))
print(kindOf(ports))
print(yaml.keys(app).join(","))

var aliases = yaml.parse("anchor: &val hello\nalias: *val")
print(yaml.asString(yaml.get(aliases, "anchor")!) ?? "")
print(yaml.asString(yaml.get(aliases, "alias")!) ?? "")

var block = yaml.parse("text: |-\n  line one\n  line two")
var blockText = yaml.asString(yaml.get(block, "text")!) ?? ""
if (blockText.contains("line one")) { print("has-line") } else { print("missing-line") }
if (blockText.endsWith("\n")) { print("has-newline") } else { print("no-newline") }

var docs = yaml.parseAll("---\na: 1\n...\nb: 2")
print(len(docs))
print(yaml.asInt(yaml.get(docs[0], "a")!) ?? -1)
print(yaml.asInt(yaml.get(docs[1], "b")!) ?? -1)

var strict = yaml.parseStrict("name: Alice\nage: 30")
print(yaml.asString(yaml.get(strict, "name")!) ?? "")

var report = yaml.parseReport("name: Alice\nage: 30")
print(len(report.diagnostics))
print(report.anchors)

var root = yaml.newMapping()
yaml.mappingSet(ref root, "name", yaml.stringValue("xray"))
yaml.mappingSet(ref root, "version", yaml.intValue(1))
yaml.mappingSet(ref root, "debug", yaml.boolValue(false))
var out = yaml.stringify(yaml.mappingValue(root))
var reparsed = yaml.parse(out)
print(yaml.asString(yaml.get(reparsed, "name")!) ?? "")
print(yaml.asInt(yaml.get(reparsed, "version")!) ?? -1)
if (yaml.asBool(yaml.get(reparsed, "debug")!) ?? true) { print("debug-on") } else { print("debug-off") }
