import yaml

var doc = yaml.parse("app:\n  name: xray\n  ports: [80, 443]\n  limits: {max: 100, timeout: 30}\nitems:\n  - id: 1\n    status: done\n  - {id: 2, status: pending}\n")
print(doc["app"]["name"])
print(doc["app"]["ports"][1])
print(doc["app"]["limits"]["max"])
print(len(doc["items"]))
print(doc["items"][0]["status"])
print(doc["items"][1]["id"])

var aliases = yaml.parse("anchor: &val hello\nalias: *val")
print(aliases["anchor"])
print(aliases["alias"])

var block = yaml.parse("text: |-\n  line one\n  line two")
var blockText = string(block["text"])
if (blockText.contains("line one")) {
    print("has-line")
} else {
    print("missing-line")
}
if (blockText.endsWith("\n")) {
    print("has-newline")
} else {
    print("no-newline")
}

var docs = yaml.parseAll("---\na: 1\n...\nb: 2")
print(len(docs))
print(docs[0]["a"])
print(docs[1]["b"])

var strict = yaml.parseStrict("name: Alice\nage: 30")
print(strict["data"]["name"])
print(len(strict["errors"]))
print(strict["meta"]["anchors"])

var out = yaml.stringify({name: "xray", version: 1, debug: false})
var reparsed = yaml.parse(out)
print(reparsed["name"])
print(reparsed["version"])
if (reparsed["debug"] == true) {
    print("debug-on")
} else {
    print("debug-off")
}
