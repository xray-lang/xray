// anchor: io-touch-shared-core
import io
import path

var root = io.tempDir()!
var file = path.join(root, path.from("touch.txt"))

print(io.touch(file))
print(io.exists(file))
print(io.fileSize(file))

print(io.writeFile(file, "payload"))
var before = io.stat(file)
print(before != null)
print(io.touch(file))
var after = io.stat(file)
print(after != null)
print(io.readFile(file) == "payload")
if (before != null && after != null) {
    print(after.mtime >= before.mtime)
} else {
    print(false)
}

print(io.removeAll(root))
