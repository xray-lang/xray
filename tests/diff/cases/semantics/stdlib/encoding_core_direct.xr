// AOT direct-call encoding predicates/counts must match VM tagged dispatch.
import encoding
import { HexError, Utf16DecodeOptions, Utf16EncodeOptions, Utf16Error } from encoding

fn hexEncodeText(data: string) -> string {
    var view: Slice<u8> = data.bytes()
    return encoding.hexEncode(view)
}

fn hexDecodeText(hex: string) -> string {
    var bytes = encoding.hexDecode(hex)
    return string.fromUtf8(bytes[:])!
}

fn hexDecodeFails(hex: string) -> bool {
    try {
        var bytes = encoding.hexDecode(hex)
        return len(bytes) < 0
    } catch (e: HexError) {
        return true
    }
}

fn utf8ValidText(data: string) -> bool {
    var view: Slice<u8> = data.bytes()
    return encoding.utf8Valid(view)
}

fn utf16EncodeOptions(order: Endian) -> Utf16EncodeOptions {
    var options = Utf16EncodeOptions()
    options.order = order
    return options
}

fn utf16Options(order: Endian, consumeBom: bool = true) -> Utf16DecodeOptions {
    var options = Utf16DecodeOptions()
    options.order = order
    options.consumeBom = consumeBom
    return options
}

fn utf16DecodeFails(data: Slice<u8>) -> bool {
    try {
        var decoded = encoding.utf16Decode(data)
        return len(decoded) < 0
    } catch (e: Utf16Error) {
        return true
    }
}

print(hexEncodeText("Hello"))
print(hexEncodeText("\t"))
var bytes = encoding.hexDecode("48656c6c6f")
print(len(bytes))
print(bytes[0])
print(bytes[1])
print(bytes[2])
print(bytes[3])
print(bytes[4])
print(hexDecodeText("48656C6C6F"))
print(hexDecodeFails("gg"))
print(hexDecodeFails("abc"))
var emptyBytes = encoding.hexDecode("")
print(len(emptyBytes))

print(encoding.hexValid("48656c6c6f"))
print(encoding.hexValid("ABCDEF"))
print(encoding.hexValid("abc"))
print(encoding.hexValid("gg"))
print(encoding.hexValid(""))

print(utf8ValidText("Hello"))
print(utf8ValidText("你好"))
print(utf8ValidText(""))
var invalidUtf8 = Array<u8>(4)
invalidUtf8[0] = 0xF4
invalidUtf8[1] = 0x90
invalidUtf8[2] = 0x80
invalidUtf8[3] = 0x80
print(encoding.utf8Valid(invalidUtf8[:]))
print(Endian.LE == Endian.LE)
print(Endian.BE == Endian.BE)

var u16le = encoding.utf16Encode("AB")
print(len(u16le))
print(u16le[0])
print(u16le[1])
print(u16le[2])
print(u16le[3])
print(encoding.utf16Decode(u16le[:]))

var u16be = encoding.utf16Encode("AB", utf16EncodeOptions(Endian.BE))
print(len(u16be))
print(u16be[0])
print(u16be[1])
print(u16be[2])
print(u16be[3])
print(encoding.utf16Decode(u16be[:], utf16Options(Endian.BE)))
print(encoding.utf16Decode(u16be[:], utf16Options(Endian.BE, false)))

var bom = Array<u8>(4)
bom[0] = 254
bom[1] = 255
bom[2] = 0
bom[3] = 65
print(encoding.utf16Decode(bom[:]))
print(encoding.utf16Decode(bom[:], utf16Options(Endian.BE, false)) == "A")
var odd = Array<u8>(1)
print(utf16DecodeFails(odd[:]))
