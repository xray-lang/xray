// Legacy task-200 oracle: truncated compressed payloads must report
// decompression failure through the converged typed native error channel.
//
// The coder speaks bytes end to end, so truncation is a byte-level cut on the
// Array<u8> payload rather than a rune-level cut on a string.
import compress

fn compressionInvalidData(body: fn()) -> bool {
    try {
        body()
        return false
    } catch (e: CompressionError) {
        return match (e) {
            CompressionError.InvalidData -> true
        }
    }
}

var text = "Task 200 compress truncated input contract. Task 200 compress truncated input contract."

var gz = compress.gzip(text.bytes())
print(len(gz) > 1)
print(compressionInvalidData(fn() { compress.gunzip(gz[0:1]) }))

var deflated = compress.deflate(text.bytes())
print(len(deflated) > 1)
print(compressionInvalidData(fn() { compress.inflate(deflated[0:1]) }))

var zlibbed = compress.zlibCompress(text.bytes())
print(len(zlibbed) > 1)
print(compressionInvalidData(fn() { compress.zlibDecompress(zlibbed[0:1]) }))
