// Legacy task-200 oracle: truncated compressed payloads must report
// decompression failure through the converged typed native error channel.
import compress

fn compressionInvalidData(body: () -> ()) -> bool {
    try {
        body()
        return false
    } catch (e: CompressionError) {
        return match (e) {
            CompressionError.InvalidData -> true
        }
    }
}

fn truncatePayload(value: string) -> string {
    if (len(value) <= 1) { return "" }
    return value.slice(0, 1)
}

var text = "Task 200 compress truncated input contract. Task 200 compress truncated input contract."

var gz = compress.gzip(text) ?? ""
print(len(gz) > 1)
print(compressionInvalidData(fn() { compress.gunzip(truncatePayload(gz)) }))

var deflated = compress.deflate(text) ?? ""
print(len(deflated) > 1)
print(compressionInvalidData(fn() { compress.inflate(truncatePayload(deflated)) }))

var zlibbed = compress.zlibCompress(text) ?? ""
print(len(zlibbed) > 1)
print(compressionInvalidData(fn() { compress.zlibDecompress(truncatePayload(zlibbed)) }))
