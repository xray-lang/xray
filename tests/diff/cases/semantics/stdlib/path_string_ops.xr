// AOT direct-call string-returning path ops must match VM tagged dispatch.
import path

print(path.dirname("/usr/local/bin"))
print(path.dirname("foo/bar.txt"))
print(path.dirname("/"))
print(path.dirname("noslash"))
print(path.dirname("/a/b/"))

print(path.basename("/usr/local/bin"))
print(path.basename("foo/bar.txt"))
print(path.basename("/a/b/"))
print(path.basename("solo"))

print(path.extname("foo/bar.txt"))
print(path.extname("archive.tar.gz"))
print(path.extname("noext"))
print(path.extname(".gitignore"))

print(path.normalize("/usr/local/../bin/./xray"))
print(path.normalize("/usr//local///bin"))
print(path.normalize("foo/bar/../../baz"))
print(path.normalize("/../foo"))
print(path.normalize("."))
print(path.normalize(""))

print(path.relative("/usr/local/bin", "/usr/local/lib"))
print(path.relative("/usr/local", "/usr/local"))
print(path.relative("/foo", "/foobar"))
print(path.relative("/usr/local", "/usr/local/bin"))
print(path.relative("/usr/local/bin", "/usr/local"))
print(path.relative("/a/b/c", "/a/x/y"))
print(path.relative("foo/bar/../baz", "foo/qux/./zap"))

let f = "/srv/data/report.csv"
print(path.dirname(f))
print(path.basename(f))
print(path.extname(f))
print(path.normalize(f))
print(path.relative("/srv/data", f))
