import parallel
import { Options, Plan } from parallel

var seen = 0
parallel.forEach(0..5, (i) -> {
    seen = seen + i
}, Options(2))
print(seen)

var mapped = parallel.map(0..4, (i) -> i * i, Options(0))
print(len(mapped))
print(mapped[0])
print(mapped[3])

var out: Array<int> = [99]
var same = parallel.mapInto(1..4, out, (i) -> i + 10)
print(len(same))
print(same[0])
print(out[2])

var total = parallel.reduce(0..5, 10, (i) -> i, (a, b) -> a + b, Options(1))
print(total)

var plan = Plan<int>(Options(3), 100)
var planSum = plan.reduce(0..4, 0, (state, i) -> state + i, (a, b) -> a + b)
print(planSum)

var planValues = plan.map(0..3, (state, i) -> state - i)
print(planValues[0])
print(planValues[2])

plan.close()
