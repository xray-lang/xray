// anchor: sys-threadlocal-recursive-init
// Recursive lazy initialization on the same OS thread is a programmer error,
// but it must fail deterministically instead of recursing until stack overflow.

import sys

const local = sys.ThreadLocal<i64, sys.ThreadLocalError>(fn() throws(sys.ThreadLocalError) -> i64 {
    return try local.get()
})

try {
    print(try local.get())
} catch (e) {
    print("recursive")
}

var recovered = sys.ThreadLocal<i64, Never>(fn() -> i64 { return 0 })
recovered.set(7)
print(try! recovered.get())
