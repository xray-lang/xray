// anchor: sys-threadlocal-recursive-init
// Recursive lazy initialization on the same OS thread is a programmer error,
// but it must fail deterministically instead of recursing until stack overflow.

import sys

const local = sys.ThreadLocal<i64>(fn() -> i64 {
    return local.get()
})

try {
    print(local.get())
} catch (e) {
    print("recursive")
}

var recovered = sys.ThreadLocal<i64>(fn() -> i64 { return 0 })
recovered.set(7)
print(recovered.get())
