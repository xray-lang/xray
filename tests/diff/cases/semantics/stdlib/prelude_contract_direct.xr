// task-221 阶段B: prelude contract backend-diff coverage.
// Exercises the implicit prelude core value types (Array/Map/string) so VM and
// AOT agree on the permanent L1 container/string semantics.
import text

var a: Array<int> = [3, 1, 2]
a.sort()
print(a[0])
print(a[2])
print(len(a))

var m: Map<string, int> = #{}
m["x"] = 1
m["y"] = 2
print(m["x"] ?? 0)
print(len(m))

var s = "hi"
print(len(s))
print(s + "!")
print(s.slice(0, 1))
print(text.upper(s))
