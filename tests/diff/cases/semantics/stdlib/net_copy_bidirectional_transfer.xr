import net
import { CopyBidirectionalResult } from net

// Both peer connections are accepted in the parent and moved into the bridge
// coroutine, the AOT-supported way to hand fresh handles to a child task.
fn bridgeOnce(a: move NetConn, b: move NetConn) -> CopyBidirectionalResult {
    var result = net.copyBidirectional(a, b)
    net.close(a)
    net.close(b)
    return result
}

fn main() {
    var listener = net.listen(0, 2)
    const port = listener.port()
    var left = net.dial("127.0.0.1", port)
    var acceptedA = net.accept(listener)!
    var right = net.dial("127.0.0.1", port)
    var acceptedB = net.accept(listener)!
    var bridge = go bridgeOnce(move acceptedA, move acceptedB)

    print(net.writeBytes(left, Array<u8>([108, 101, 102, 116])))
    print(net.writeBytes(right, Array<u8>([114, 105, 103, 104, 116])))
    net.shutdownWrite(left)
    net.shutdownWrite(right)

    var fromRight = Array<u8>(8)
    print(net.readInto(left, ref fromRight, 8))
    print(fromRight[0])
    var fromLeft = Array<u8>(8)
    print(net.readInto(right, ref fromLeft, 8))
    print(fromLeft[0])

    var result = await bridge
    print(result.aToB)
    print(result.bToA)

    net.close(left)
    net.close(right)
    net.close(listener)
}

main()
