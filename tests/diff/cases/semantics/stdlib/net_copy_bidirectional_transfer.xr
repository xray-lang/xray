import net
import { CopyBidirectionalResult } from net

fn bridgeOnce(listener: move NetListener) -> CopyBidirectionalResult {
    var a = net.accept(listener)!
    var b = net.accept(listener)!
    var result = net.copyBidirectional(a, b)
    net.close(a)
    net.close(b)
    net.close(listener)
    return result
}

var listener = net.listen(0, 2)!
const port = listener.port()
var bridge = go bridgeOnce(move listener)
var left = net.dial("127.0.0.1", port, 1000)!
var right = net.dial("127.0.0.1", port, 1000)!

net.write(left, "left")
net.write(right, "right")
net.shutdownWrite(left)
net.shutdownWrite(right)

print(net.read(left)!)
print(net.read(right)!)

var result = await bridge
print(result.aToB)
print(result.bToA)

net.close(left)
net.close(right)
