// Typed sys.Process lifecycle handle. This keeps process management separate
// from os.exec/os.spawn convenience capture helpers and does not introduce
// parallel process APIs.
import sys
import { ProcessOptions, Signal } from sys

var noArgs = sys.Process.spawn("true")
print(noArgs != null)
if (noArgs != null) {
    print(noArgs!.wait())
}

var p = sys.Process.spawn("sh", ["-c", "exit 7"])
print(p != null)
if (p != null) {
    print(p!.id > 0)
    print(p!.wait())
    print(p!.wait())
}

var poll = sys.Process.spawn("sh", ["-c", "sleep 1; exit 5"])
print(poll != null)
if (poll != null) {
    print(poll!.tryWait() == null)
    print(poll!.wait())
}

var done = sys.Process.spawn("sh", ["-c", "exit 3"])
print(done != null)
if (done != null) {
    var code: int? = null
    var spins = 0
    while (code == null && spins < 100) {
        code = done!.tryWait()
        spins = spins + 1
    }
    print(code)
    print(done!.wait())
}

var q = sys.Process.spawn("sh", ["-c", "sleep 5"])
print(q != null)
if (q != null) {
    print(q!.kill(Signal.KILL))
    print(q!.wait())
}

var detached = sys.Process.spawn("sh", ["-c", "exit 0"],
    ProcessOptions(null, null, null, null, null, true))
print(detached != null)
if (detached != null) {
    print(detached!.id > 0)
    print(detached!.wait())
    print(detached!.tryWait())
    print(detached!.kill())
}

var missing = sys.Process.spawn("", [])
if (missing != null) {
    print(false)
    print(missing!.wait())
} else {
    print(true)
}
print(Signal.TERM != Signal.KILL)

var cwdProc = sys.Process.spawn("sh", ["-c", "test -f sys_process_direct.xr"],
    ProcessOptions("tests/diff/cases/semantics/stdlib"))
print(cwdProc != null)
if (cwdProc != null) {
    print(cwdProc!.wait())
}

var envProc = sys.Process.spawn("sh", ["-c", "test \"$XRAY_SYS_TEST_ENV\" = hello"],
    ProcessOptions(null, #{"XRAY_SYS_TEST_ENV": "hello"}))
print(envProc != null)
if (envProc != null) {
    print(envProc!.wait())
}

var cwdEnvProc = sys.Process.spawn("sh", ["-c", "test -f sys_process_direct.xr && test \"$XRAY_SYS_TEST_ENV\" = cwd"],
    ProcessOptions("tests/diff/cases/semantics/stdlib", #{"XRAY_SYS_TEST_ENV": "cwd"}))
print(cwdEnvProc != null)
if (cwdEnvProc != null) {
    print(cwdEnvProc!.wait())
}

var invalidEnv = sys.Process.spawn("sh", ["-c", "exit 0"],
    ProcessOptions(null, #{"BAD=KEY": "x"}))
if (invalidEnv != null) {
    print(false)
    print(invalidEnv!.wait())
} else {
    print(true)
}

var pipe = sys.Pipe.open()
print(pipe != null)
if (pipe != null) {
    var payload = "pipe-ok".toBytes()
    print(pipe!.write(payload))
    var chunk = pipe!.read(32)
    print(chunk != null)
    if (chunk != null) {
        print(chunk!.length)
        print(chunk!.toString())
    }
    print(pipe!.closeWrite())
    var eof = pipe!.read(32)
    print(eof != null)
    if (eof != null) {
        print(eof!.length)
    }
    print(pipe!.close())
}

var stdinPipe = sys.Pipe.open()
print(stdinPipe != null)
if (stdinPipe != null) {
    var stdinProc = sys.Process.spawn("sh", ["-c", "read line; test \"$line\" = input-ok"],
        ProcessOptions(null, null, stdinPipe!.readEnd()))
    print(stdinProc != null)
    if (stdinProc != null) {
        print(stdinPipe!.closeRead())
        print(stdinPipe!.write("input-ok\n".toBytes()))
        print(stdinPipe!.closeWrite())
        print(stdinProc!.wait())
    }
    print(stdinPipe!.close())
}

var stdoutPipe = sys.Pipe.open()
print(stdoutPipe != null)
if (stdoutPipe != null) {
    var stdoutProc = sys.Process.spawn("sh", ["-c", "printf captured-out"],
        ProcessOptions(null, null, null, stdoutPipe!.writeEnd()))
    print(stdoutProc != null)
    if (stdoutProc != null) {
        print(stdoutProc!.wait())
        print(stdoutPipe!.closeWrite())
        var capturedOut = stdoutPipe!.read(64)
        print(capturedOut != null)
        if (capturedOut != null) {
            print(capturedOut!.toString())
        }
    }
    print(stdoutPipe!.close())
}

var stderrPipe = sys.Pipe.open()
print(stderrPipe != null)
if (stderrPipe != null) {
    var stderrProc = sys.Process.spawn("sh", ["-c", "printf captured-err >&2"],
        ProcessOptions(null, null, null, null, stderrPipe!.writeEnd()))
    print(stderrProc != null)
    if (stderrProc != null) {
        print(stderrProc!.wait())
        print(stderrPipe!.closeWrite())
        var capturedErr = stderrPipe!.read(64)
        print(capturedErr != null)
        if (capturedErr != null) {
            print(capturedErr!.toString())
        }
    }
    print(stderrPipe!.close())
}
