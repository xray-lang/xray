// Typed sys.Process lifecycle handle. This keeps process management separate
// from os.exec/os.spawn convenience capture helpers and does not introduce
// parallel process APIs.
import sys
import { ProcessOptions } from sys

var p = sys.Process.spawn("sh", ["-c", "exit 7"])
print(p != null)
if (p != null) {
    print(p!.id > 0)
    print(p!.wait())
    print(p!.wait())
}

var poll = sys.Process.spawn("sh", ["-c", "sleep 1; exit 5"])
print(poll != null)
if (poll != null) {
    print(poll!.tryWait() == null)
    print(poll!.wait())
}

var done = sys.Process.spawn("sh", ["-c", "exit 3"])
print(done != null)
if (done != null) {
    var code: int? = null
    var spins = 0
    while (code == null && spins < 100) {
        code = done!.tryWait()
        spins = spins + 1
    }
    print(code)
    print(done!.wait())
}

var q = sys.Process.spawn("sh", ["-c", "sleep 5"])
print(q != null)
if (q != null) {
    print(q!.kill(sys.Signal.KILL))
    print(q!.wait())
}

var missing = sys.Process.spawn("", [])
if (missing != null) {
    print(false)
    print(missing!.wait())
} else {
    print(true)
}
print(sys.Signal.TERM != sys.Signal.KILL)

var cwdProc = sys.Process.spawn("sh", ["-c", "test -f sys_process_direct.xr"], ProcessOptions{
    cwd: "tests/diff/cases/semantics/stdlib"
})
print(cwdProc != null)
if (cwdProc != null) {
    print(cwdProc!.wait())
}

var pipe = sys.Pipe.open()
print(pipe != null)
if (pipe != null) {
    var payload = "pipe-ok".toBytes()
    print(pipe!.write(payload))
    var chunk = pipe!.read(32)
    print(chunk != null)
    if (chunk != null) {
        print(chunk!.length)
        print(chunk!.toString())
    }
    print(pipe!.closeWrite())
    var eof = pipe!.read(32)
    print(eof != null)
    if (eof != null) {
        print(eof!.length)
    }
    print(pipe!.close())
}
