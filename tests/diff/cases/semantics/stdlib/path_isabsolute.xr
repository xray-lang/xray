// AOT path.isAbsolute direct-call must match the VM tagged dispatch.
import path

print(path.isAbsolute(path.from("/usr/local")))
print(path.isAbsolute(path.from("relative/dir")))
print(path.isAbsolute(path.from("/")))
print(path.isAbsolute(path.from("")))

var p = path.from("/etc/hosts")
if (path.isAbsolute(p)) {
    print("abs")
} else {
    print("rel")
}

var q = path.from("./local")
if (path.isAbsolute(q)) {
    print("abs")
} else {
    print("rel")
}
