// AOT direct-call crypto core helpers must match VM tagged dispatch.
import crypto

print(crypto.timingSafeEqual("abc", "abc"))
print(crypto.timingSafeEqual("abc", "abd"))
print(crypto.timingSafeEqual("abc", "ab"))
print(crypto.timingSafeEqual("", ""))
print(crypto.timingSafeEqual("same length", "same length"))
print(crypto.timingSafeEqual("same length", "same lengtz"))
print(crypto.timingSafeEqual("prefix", "prefix suffix"))

var cipher = crypto.encrypt("secret", "hello world")
print(len(cipher) == 64)
print(crypto.decrypt("secret", cipher) == "hello world")
var emptyCipher = crypto.encrypt("secret", "")
print(len(emptyCipher) == 64)
print(crypto.decrypt("secret", emptyCipher) == "")
print(crypto.decrypt("wrong-key", cipher) == null)

print(crypto.md5("abc"))
print(crypto.sha1("abc"))
print(crypto.sha256("abc"))
print(crypto.sha512("abc"))
print(crypto.hmac("md5", "key", "data"))
print(crypto.hmac("sha1", "key", "data"))
print(crypto.hmac("sha256", "key", "data"))
print(crypto.hmac("sha512", "key", "data"))
print(crypto.hmac("sha256", "Jefe", "what do ya want for nothing?"))
print(crypto.hmac("sha224", "key", "data") == null)
