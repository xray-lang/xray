import { CopyBidirectionalResult, NetConn, NetError, copyBidirectional } from net

fn counts(result: CopyBidirectionalResult) -> i64 {
    return result.aToB + result.bToA
}

fn accepts(
    copier: fn(NetConn, NetConn) -> CopyBidirectionalResult,
) -> bool {
    return true
}

print(accepts(copyBidirectional))
print(typeName(NetError.Timeout))
print(typeName(NetError.Cancelled))
