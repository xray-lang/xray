// anchor: io-write-shared-core
import io
import path

var root = io.tempDir()!
var textFile = path.join(root, path.from("write.txt"))

print(io.writeFile(textFile, ""))
print(io.fileSize(textFile))
print(io.appendFile(textFile, "alpha"))
print(io.appendFile(textFile, ""))
print(io.appendFile(textFile, "\nomega"))
print(io.readFile(textFile) == "alpha\nomega")

var bytesFile = path.join(root, path.from("bytes.bin"))
var bytes = Array<u8>(4)
bytes[0] = 65
bytes[1] = 0
bytes[2] = 10
bytes[3] = 255
print(io.writeFileBytes(bytesFile, bytes))

var readBytes = io.readFileBytes(bytesFile)
if (readBytes != null) {
    print(len(readBytes))
    print(readBytes[0])
    print(readBytes[1])
    print(readBytes[2])
    print(readBytes[3])
} else {
    print(0)
    print(0)
    print(0)
    print(0)
    print(0)
}

print(io.removeAll(root))
