// anchor: sys-mutex-direct
// OS-domain sys.OsMutex is a non-generic native handle. This single-thread case
// pins constructor + lock/unlock/tryLock in both VM and standalone AOT.

import sys

let m = sys.OsMutex()
print(m.tryLock())
m.unlock()

m.lock()
print(true)
m.unlock()

print(m.tryLock())
m.unlock()
