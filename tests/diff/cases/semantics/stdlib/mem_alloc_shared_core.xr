// mem.alloc / allocAligned / allocZeroed return managed Buffer handles.
// Raw pointer access is only available through unsafe Buffer.borrowPtr().
import mem

fn run() {
    var p = mem.alloc(16)
    print(len(p))
    var pp = unsafe {
        p.borrowPtr()
    }
    unsafe {
        pp[0] = 42
    }
    unsafe {
        pp[15] = 99
    }
    unsafe {
        print(pp[0])
    }
    unsafe {
        print(pp[15])
    }
{
        var ro: const Slice<u8> = p.asBytes()
        print(len(ro))
        print(ro[0])
    }
{
        unsafe {
            mem.withSliceMut<u8>(p.borrowPtr(), len(p), ref p,
                fn(rw: ref Slice<u8>) {
                    rw[0] = 43
                    print(rw[0])
                })
            print(pp[0])
        }
    }
    // aligned allocation
    var q = mem.allocAligned(128, 64)
    print(len(q))
    var qp = unsafe {
        q.borrowPtr()
    }
    mem.set(qp, 5, 128)
    unsafe {
        print(qp[0])
    }
    unsafe {
        print(qp[127])
    }
    // zeroed allocation
    var z = mem.allocZeroed(8)
    print(len(z))
    var zp = unsafe {
        z.borrowPtr()
    }
    unsafe {
        print(zp[0])
    }
    unsafe {
        print(zp[7])
    }
    unsafe {
        zp[3] = 11
    }
    unsafe {
        print(zp[3])
    }
    // resize keeps existing bytes and updates the Buffer length.
    print(p.resize(64))
    print(len(p))
    var rp = unsafe {
        p.borrowPtr()
    }
    unsafe {
        print(rp[0])
    }
    unsafe {
        print(rp[15])
    }
    print("ok")
}

run()
