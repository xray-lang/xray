// mem.alloc / allocAligned / allocZeroed return managed Buffer handles.
// Raw pointer access is only available through unsafe Buffer.ptr().
import mem

var p = mem.alloc(16)
print(len(p))

var pp = unsafe { p.ptr() }
unsafe { pp[0] = 42 }
unsafe { pp[15] = 99 }
unsafe { print(pp[0]) }
unsafe { print(pp[15]) }

{
    var ps: Slice<byte> = p.asSpan()
    print(len(ps))
    ps[0] = 43
    print(ps[0])
    unsafe { print(pp[0]) }
}

// aligned allocation
var q = mem.allocAligned(128, 64)
print(len(q))
var qp = unsafe { q.ptr() }
mem.set(qp, 5, 128)
unsafe { print(qp[0]) }
unsafe { print(qp[127]) }
print(mem.addressOf(qp) % 64)

// zeroed allocation
var z = mem.allocZeroed(8)
print(len(z))
var zp = unsafe { z.ptr() }
unsafe { print(zp[0]) }
unsafe { print(zp[7]) }
unsafe { zp[3] = 11 }
unsafe { print(zp[3]) }

// resize keeps existing bytes and updates the Buffer length.
print(p.resize(64))
print(len(p))
var rp = unsafe { p.ptr() }
unsafe { print(rp[0]) }
unsafe { print(rp[15]) }

print("ok")
