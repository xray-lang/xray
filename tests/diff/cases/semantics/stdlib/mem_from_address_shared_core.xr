// mem.fromAddress / mem.addressOf (task 147 §7.2, MMIO address bridge).
// Addresses are non-deterministic, so assertions only observe data behind
// pointers, null-ness, alignment remainders, and address equality — never a
// raw address value. VM represents raw pointers as address ints (identity
// bridge); AOT casts between int64 and the native .ptr slot.
import mem

// Null round-trip: address 0 is the null pointer.
var z = mem.fromAddress(0)
print(z.isNull())
print(mem.addressOf(z))

// Data round-trip: rebuild a pointer from its numeric address and observe
// the same bytes through both the original and the rebuilt pointer.
var b = mem.alloc(16)
var p = unsafe { b.ptrUnchecked() }
unsafe { p[0] = 42 }
unsafe { p[15] = 99 }
var addr = mem.addressOf(p)
var q = mem.fromAddress(addr)
print(q.isNull())
unsafe { print(q[0]) }
unsafe { print(q[15]) }

// Manual pointer arithmetic through the address domain: fromAddress(addr + i)
// must see byte i of the original buffer.
var q15 = mem.fromAddress(addr + 15)
unsafe { print(q15[0]) }

// addressOf is stable: same pointer, same address.
print(mem.addressOf(q) == addr)

// addressOf is pointee-type agnostic: C pointer comparisons/differences often
// start from typed pointers, not only byte pointers.
var typed_null = RawPtr<uint32>.null()
var typed_mut_null = RawMut<uint64>.null()
print(mem.addressOf(typed_null))
print(mem.addressOf(typed_mut_null))

// Alignment observation: an allocAligned(_, 64) buffer's address is 64-aligned.
var ab = mem.allocAligned(128, 64)
var a = unsafe { ab.ptrUnchecked() }
print(mem.addressOf(a) % 64)

// MMIO access pattern: volatile store/load through an address-constructed
// pointer (the real driver-code shape fromAddress exists for).
var reg = mem.fromAddress(mem.addressOf(a) + 8)
mem.volatileStore(reg, 305419896, 4)
print(mem.volatileLoad(reg, 4))

print("ok")
