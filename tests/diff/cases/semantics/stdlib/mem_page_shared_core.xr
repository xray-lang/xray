// mem.pageAlloc / pageProtect / pageFree (task 147 §7.3).
// Anonymous pages are zero-filled by mmap/VirtualAlloc. Addresses are
// nondeterministic, so assertions observe only data and boolean success.
import mem

let rw = mem.PROT_READ | mem.PROT_WRITE
print(mem.PROT_NONE)
print(mem.PROT_READ)
print(mem.PROT_WRITE)
print(mem.PROT_EXEC)
print(rw)

let p = mem.pageAlloc(4096, rw)
print(p.isNull())
unsafe { print(p[0]) }
unsafe { p[0] = 17 }
unsafe { p[4095] = 23 }
unsafe { print(p[0]) }
unsafe { print(p[4095]) }
print(mem.pageProtect(p, 4096, rw))
print(mem.pageFree(p, 4096))

let q = mem.pageAlloc(4096)
print(q.isNull())
unsafe { q[1] = 31 }
unsafe { print(q[1]) }
print(mem.pageFree(q, 4096))
print("ok")
