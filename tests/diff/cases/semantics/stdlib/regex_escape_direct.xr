// AOT direct-call regex.escape must match VM tagged dispatch.
import regex

print(regex.escape("a.b*c?"))
print(regex.escape("[x](y){z}|^$\\"))
print(regex.escape("plain"))
print(regex.escape(""))
print(regex.escape("x+y"))
print(regex.escape("hello/world"))
print(regex.isValid("\\d+"))
print(regex.isValid("["))
print(regex.isValid("(?i)hello"))
let digits = regex.compile("\\d+")
print(regex.test(digits, "abc123"))
print(regex.test(digits, "abc"))
print(regex.count(digits, "a1 b22 c333"))
print(regex.findText(digits, "a1 b22 c333"))
let hello = regex.compile("hello", "i")
print(regex.test(hello, "HELLO"))
print(regex.count(hello, "hello HELLO nope"))
let wordnum = regex.compile("([a-z]+)(\\d+)")
print(regex.findText(wordnum, "abc123 xyz"))
print(regex.findGroup(wordnum, "abc123 xyz", 1))
print(regex.findGroup(wordnum, "abc123 xyz", 2))
print(regex.findGroup(wordnum, "abc123 xyz", 3) == null)
let first = regex.find(wordnum, "abc123 xyz")
if (first != null) {
    print(first.text)
    print(first.start)
    print(first.end)
    print(first.groups.length)
    print(first.groups[0])
    print(first.groups[1])
    print(first.groups[2])
}
print(regex.find(wordnum, "abc123 xyz", 4) == null)
let exact = regex.fullFind(wordnum, "abc123")
if (exact != null) {
    print(exact.text)
    print(exact.start)
    print(exact.end)
    print(exact.groups[1])
}
print(regex.fullFind(wordnum, "abc123 xyz") == null)
print(regex.replace(digits, "a1 b22 c333", "N"))
print(regex.replaceAll(digits, "a1 b22 c333", "N"))
print(regex.replace(wordnum, "abc123 xyz", "$2-$1"))
print(regex.replace(digits, "abc", "N"))
let comma = regex.compile(",\\s*")
let parts = regex.split(comma, "a, b, c")
print(parts.length)
print(parts[0])
print(parts[1])
print(parts[2])
let limited = regex.split(comma, "a, b, c", 2)
print(limited.length)
print(limited[0])
print(limited[1])
