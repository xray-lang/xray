import toml
import { TomlValue, TomlErrorKind, TomlDiagnostic } from toml

fn field(value: TomlValue, key: string) -> TomlValue {
    return toml.get(value, key)!
}

fn item(value: TomlValue, index: i64) -> TomlValue {
    return toml.at(value, index)!
}

fn asString(value: TomlValue) -> string {
    return toml.asString(value)!
}

fn asInt(value: TomlValue) -> i64 {
    return toml.asInt(value)!
}

fn asBool(value: TomlValue) -> bool {
    return toml.asBool(value)!
}

fn arrayLen(value: TomlValue) -> i64 {
    return toml.length(value)
}

var basic = toml.parse("name = \"xray\"\nversion = 2\nactive = true")
print(asString(field(basic, "name")))
print(asInt(field(basic, "version")))
print(asBool(field(basic, "active")))

var nested = toml.parse("fruit.name = \"apple\"\nfruit.color = \"red\"")
var fruit = field(nested, "fruit")
print(asString(field(fruit, "name")))
print(asString(field(fruit, "color")))

var products = toml.parse("[[products]]\nname = \"Hammer\"\n\n[[products]]\nname = \"Nail\"")
var productList = field(products, "products")
print(arrayLen(productList))
print(asString(field(item(productList, 1), "name")))

var report = toml.parseReport("name = \"Alice\"\nname = \"Bob\"")
print(len(report.errors) > 0)
var diag: TomlDiagnostic = report.errors[0]
print(typeName(diag))
print(diag.kind == TomlErrorKind.DuplicateKey)
print(diag.line)
print(diag.message)
print(asString(field(report.data, "name")))

var syntaxReport = toml.parseReport("x = [1, 2")
print(syntaxReport.errors[0].kind == TomlErrorKind.SyntaxError)

var cleanReport = toml.parseReport("name = \"Alice\"\nage = 30")
print(len(cleanReport.errors))
print(cleanReport.lines > 0)

var config = toml.newTable()
toml.tableSet(ref config, "name", toml.stringValue("xray"))
toml.tableSet(ref config, "version", toml.intValue(1))
toml.tableSet(ref config, "enabled", toml.boolValue(true))
var out = toml.stringify(toml.tableValue(config))
print(out.contains("name = \"xray\""))
print(out.contains("version = 1"))
print(asBool(field(toml.parse(out), "enabled")))
