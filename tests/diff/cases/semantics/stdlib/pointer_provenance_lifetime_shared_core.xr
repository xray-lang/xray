// Static/module pointers may escape, while owner/stack borrows may cross only
// direct noescape calls within their verified call-bound lifetime.
const MODULE_BYTES = c"AZ"
const MODULE_PTR = unsafe { MODULE_BYTES.ptr() }

fn modulePtr() -> const Ptr<u8> {
    return MODULE_PTR
}

fn literalPtr() -> const Ptr<u8> {
    return unsafe { c"ok".ptr() }
}

fn read(ptr: const Ptr<u8>) -> u8 {
    return unsafe { ptr.deref() }
}

fn readLocal() -> u8 {
    const local = c"Q"
    return read(unsafe { local.ptr() })
}

print((read(modulePtr()) as i64))
print((read(literalPtr()) as i64))
print((readLocal() as i64))
