import io

var root = io.tempDir() ?? ""
print(root.length > 0)

var dir = root + "/paths"
print(io.mkdirp(dir))

var file = dir + "/target.txt"
print(io.writeFile(file, "target"))

var missing = dir + "/missing.txt"
print(io.realpath(missing) == null)
print(io.readlink(missing) == null)

var resolvedDir = io.realpath(dir) ?? ""
var resolvedFile = io.realpath(file) ?? ""
print(resolvedDir.length > 0)
print(resolvedFile.length > 0)

var oldCwd = io.cwd()
print(io.chdir(dir))
print((io.realpath(".") ?? "") == resolvedDir)
print(io.chdir(oldCwd))

var link = root + "/target-link.txt"
var linkOk = io.symlink(file, link)
if (linkOk) {
    var target = io.readlink(link) ?? ""
    print(target.length > 0)
    print((io.realpath(target) ?? "") == resolvedFile)
} else {
    print(true)
    print(true)
}

print(io.removeAll(root))
print(!io.exists(root))
