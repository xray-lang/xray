import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Namespace import of the pure-Xray generic `sync` stdlib module. The generic
// classes (Mutex<T>/RwLock<T>) and their generic closure-taking methods must
// monomorphize through `sync.Type<T>(...)` namespace access in AOT (not fall to
// null-returning dynamic dispatch), matching VM byte-for-byte. Complements the
// named-import case in sync_module_import.xr; regression for task 147 §0.13.
import sync

const counter = sync.Mutex<i64>(0)
print(counter.lock((v) -> v + 100))
print(counter.lock((v) -> v))

var gate = sync.RwLock<i64>(7)
print(gate.read((v) -> v))
print(gate.write((v) -> v + 1))

// Cross-coroutine mutation through a namespace-imported Mutex.
const latch = CountdownLatch(1)
go fn() {
    counter.replace((v) -> v + 42)
    latch.done()
}()
latch.wait()
print(counter.lock((v) -> v))
