// Pure-Xray encoding module: VM/AOT parity across hex, UTF-8 validation, and
// UTF-16 encode/decode (endianness, CJK surrogate-free BMP, empty input).
import encoding
import { HexError, Utf16DecodeOptions, Utf16EncodeOptions, Utf16Error } from encoding

fn hexEncodeText(data: string) -> string {
    var view: Slice<byte> = data.bytes()
    return encoding.hexEncode(view)
}

fn hexDecodeText(hex: string) -> string {
    var bytes = encoding.hexDecode(hex)
    return string.fromUtf8(bytes[:])!
}

fn hexDecodeFails(hex: string) -> bool {
    try {
        var bytes = encoding.hexDecode(hex)
        return len(bytes) < 0
    } catch (e: HexError) {
        return true
    }
}

fn utf8ValidText(data: string) -> bool {
    var view: Slice<byte> = data.bytes()
    return encoding.utf8Valid(view)
}

fn utf16EncodeOptions(order: Endian) -> Utf16EncodeOptions {
    var options = Utf16EncodeOptions()
    options.order = order
    return options
}

fn utf16Options(order: Endian, consumeBom: bool = true) -> Utf16DecodeOptions {
    var options = Utf16DecodeOptions()
    options.order = order
    options.consumeBom = consumeBom
    return options
}

fn utf16DecodeFails(data: Slice<byte>) -> bool {
    try {
        var decoded = encoding.utf16Decode(data)
        return len(decoded) < 0
    } catch (e: Utf16Error) {
        return true
    }
}

print(hexEncodeText("Hello"))
print(hexDecodeText("48656c6c6f"))
print(encoding.hexValid("48656c6c6f"))
print(encoding.hexValid("gg"))
print(encoding.hexValid("abc"))
print(hexDecodeFails("gg"))

var hb = encoding.hexDecode("48656c6c6f")
print(len(hb))
print(hb[0])
print(hb[4])

print(utf8ValidText("你好"))
var invalidUtf8 = Array<byte>(2)
invalidUtf8[0] = 0xC0
invalidUtf8[1] = 0x80
print(encoding.utf8Valid(invalidUtf8[:]))
print(Endian.LE == Endian.LE)
print(Endian.BE == Endian.BE)

var u = encoding.utf16Encode("AB")
print(len(u))
print(u[0])
print(u[1])
print(encoding.utf16Decode(u[:]))

var ub = encoding.utf16Encode("AB", utf16EncodeOptions(Endian.BE))
print(ub[0])
print(ub[1])
print(encoding.utf16Decode(ub[:], utf16Options(Endian.BE)))

var cjk = encoding.utf16Encode("你好世界")
var empty = encoding.utf16Encode("")
print(encoding.utf16Decode(cjk[:]))
print(encoding.utf16Decode(empty[:]))
var odd = Array<byte>(1)
print(utf16DecodeFails(odd[:]))
