// Pure-Xray encoding module: VM/AOT parity across hex, UTF-8 metrics, and
// UTF-16 encode/decode (endianness, CJK surrogate-free BMP, empty input).
import encoding
import { HexError } from encoding

fn hexEncodeText(data: string) -> string {
    var view: Slice<byte> = data.bytes()
    return encoding.hexEncode(view)
}

fn hexDecodeText(hex: string) -> string {
    var bytes = encoding.hexDecode(hex)
    return string.fromUtf8(bytes[:])!
}

fn hexDecodeFails(hex: string) -> bool {
    try {
        var bytes = encoding.hexDecode(hex)
        return len(bytes) < 0
    } catch (e: HexError) {
        return true
    }
}

print(hexEncodeText("Hello"))
print(hexDecodeText("48656c6c6f"))
print(encoding.hexValid("48656c6c6f"))
print(encoding.hexValid("gg"))
print(encoding.hexValid("abc"))
print(hexDecodeFails("gg"))

var hb = encoding.hexDecode("48656c6c6f")
print(len(hb))
print(hb[0])
print(hb[4])

print(encoding.utf8ByteLength("Hello"))
print(encoding.utf8ByteLength("你好"))
print(encoding.utf8Count("你好"))
print(encoding.utf8Valid("你好"))
print(encoding.LE)
print(encoding.BE)

var u = encoding.utf16Encode("AB")
print(len(u))
print(u[0])
print(u[1])
print(encoding.utf16Decode(u))

var ub = encoding.utf16Encode("AB", encoding.BE)
print(ub[0])
print(ub[1])
print(encoding.utf16Decode(ub, encoding.BE))

print(encoding.utf16Decode(encoding.utf16Encode("你好世界")))
print(encoding.utf16Decode(encoding.utf16Encode("")))
