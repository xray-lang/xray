// Pure-Xray WebSocket protocol helpers.

import ws
import { acceptKey, maskPayload, frame, parseFrame } from ws

var key = "dGhlIHNhbXBsZSBub25jZQ=="
print(acceptKey(key))
print(ws.upgradeResponse(key).includes("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"))

var headers = "GET /chat HTTP/1.1\r\n" +
    "Host: example.com\r\n" +
    "Upgrade: websocket\r\n" +
    "Connection: keep-alive, Upgrade\r\n" +
    "Sec-WebSocket-Key: key\r\n" +
    "Sec-WebSocket-Version: 13\r\n" +
    "Sec-WebSocket-Protocol: superchat, chat\r\n\r\n"
print(ws.isUpgradeRequest(headers))
print(ws.pickSubprotocol(headers, ["chat", "superchat"])!)

var masked = maskPayload(Bytes([1, 2, 3, 4, 5]), Bytes([1, 1, 1, 1]))
print(masked[0])
print(masked[1])
print(masked[2])
print(masked[3])
print(masked[4])

var f = frame("Hi".toBytes(), 1, false)
print(f.length)
print(f[0])
print(f[1])
print(f[2])
print(f[3])

var payload = Bytes(126)
var ext = ws.frame(payload, 2, false)
print(ext[0])
print(ext[1])
print(ext[2])
print(ext[3])

var parsed = parseFrame(f, false)!
print(parsed.fin)
print(parsed.rsv1)
print(parsed.opcode)
print(parsed.masked)
print(parsed.payload.toString())
print(parsed.consumedBytes)

var maskedFrame = Bytes([129, 130, 1, 2, 3, 4, 73, 107])
var parsedMasked = parseFrame(maskedFrame, true)!
print(parsedMasked.masked)
print(parsedMasked.payload.toString())

var withTail = Bytes([129, 1, 65, 66])
var parsedTail = parseFrame(withTail, false)!
print(parsedTail.payload.toString())
print(parsedTail.consumedBytes)

var rsv = parseFrame(Bytes([193, 0]), false, false, true)!
print(rsv.rsv1)
print(parseFrame(Bytes([193, 0]), false) == null)

print(parseFrame(Bytes([131, 0]), false) == null)
print(parseFrame(Bytes([9, 0]), false) == null)
print(parseFrame(Bytes([137, 126, 0, 126]), false) == null)
print(parseFrame(Bytes([129, 126, 0, 1, 65]), false) == null)
print(parseFrame(Bytes([129, 127, 128, 0, 0, 0, 0, 0, 0, 1, 65]), false) == null)
print(parseFrame(Bytes([129, 2, 65]), false) == null)
print(parseFrame(maskedFrame, false, true) == null)
