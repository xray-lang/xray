// Pure-Xray complete HTTP response text parser.
import http
import { parseResponseText } from http

var fixed = parseResponseText(
    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nX-Trace: one\r\n\r\nhelloextra"
)!
print(fixed.head.status)
print(fixed.body)
print(fixed.consumedBytes)
print(fixed.getHeader("x-trace")!)
print(len(fixed.trailerPairs))
print("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nX-Trace: one\r\n\r\nhelloextra".slice(fixed.consumedBytes))

var chunked = parseResponseText(
    "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" +
    "4\r\nWiki\r\n5\r\npedia\r\n0\r\nChecksum: ok\r\nChecksum: newer\r\n\r\nleft"
)!
print(chunked.body)
print(chunked.head.chunked)
print(chunked.getTrailer("checksum")!)
print(chunked.getTrailers("checksum").join("|"))
print(chunked.consumedBytes)

var closeBody = parseResponseText("HTTP/1.0 200 OK\r\n\r\nuntil-close")!
print(closeBody.body)
print(closeBody.consumedBytes)

var unicodeBody = parseResponseText("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\néxtrail")!
print(unicodeBody.body)
print(len(unicodeBody.body.bytes()))
print(unicodeBody.consumedBytes)

var unicodeChunk = parseResponseText(
    "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" +
    "2\r\né\r\n0\r\n\r\n"
)!
print(unicodeChunk.body)
print(len(unicodeChunk.body.bytes()))

var noBody = parseResponseText("HTTP/1.1 204 No Content\r\n\r\nleft")!
print(noBody.body == "")
print(noBody.consumedBytes)

print(parseResponseText("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabc") == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", 3) == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nabc\r\n0\r\n\r\n") == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n") == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n0\r\n\r\n") == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked, gzip\r\n\r\nhello") == null)
print(parseResponseText("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\né\r\n0\r\n\r\n") == null)
print(http.parseResponseText("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n")!.body == "")
