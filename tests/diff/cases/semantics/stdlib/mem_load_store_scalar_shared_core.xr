// anchor: mem-load-store-scalar-raw-core
import mem

fn run() {
    var buffer = mem.allocZeroed(96)
    var p = unsafe {
        buffer.borrowPtr()
    }
    unsafe {
        mem.store<i8>(p, 0, -2)
        mem.store<u8>(p, 1, 250)
        mem.store<i16>(p, 2, -1234, Endian.LE)
        mem.store<u16>(p, 4, 4660, Endian.BE)
        mem.store<i32>(p, 8, -12345678, Endian.LE)
        mem.store<u32>(p, 12, 16909060, Endian.BE)
        mem.store<i64>(p, 16, -5, Endian.LE)
        mem.store<u64>(p, 24, 72623859790382856, Endian.BE)
        mem.store<f32>(p, 32, 1.5, Endian.LE)
        mem.store<f64>(p, 40, -2.25, Endian.BE)
        print(int(mem.load<i8>(p)))
        print(int(mem.load<u8>(p, 1)))
        print(int(mem.load<i16>(p, 2, Endian.LE)))
        print(int(mem.load<u16>(p, 4, Endian.BE)))
        print(int(mem.load<i32>(p, 8, Endian.LE)))
        print(int(mem.load<u32>(p, 12, Endian.BE)))
        print(mem.load<i64>(p, 16, Endian.LE))
        print(int(mem.load<u64>(p, 24, Endian.BE)))
        print(mem.load<f32>(p, 32, Endian.LE))
        print(mem.load<f64>(p, 40, Endian.BE))
        var q: Ptr<u8> = p
        mem.store<Ptr<u8>>(p, 56, q)
        var loaded: Ptr<u8> = mem.load<Ptr<u8>>(p, 56)
        print(loaded == q)
        mem.store<MutPtr<u8>>(p, 64, p)
        var loadedMut: MutPtr<u8> = mem.load<MutPtr<u8>>(p, 64)
        print(loadedMut == p)
    }
    unsafe {
        mem.store<u32>(p, 72, 270544960, Endian.LE)
        print(int(mem.load<u32>(p, 72, Endian.LE)))
        mem.store<u32>(p, 76, 270544960, Endian.BE)
        print(int(mem.load<u32>(p, 76, Endian.BE)))
    }
}

run()
