import io

var root = io.tempDir() ?? ""
print(len(root) > 0)

var nested = root + "/a/b"
print(io.mkdirp(nested))
print(io.writeFile(root + "/top.txt", "top"))
print(io.writeFile(nested + "/deep.txt", "deep"))

var entries = io.readDir(root) ?? []
print(entries.contains("top.txt"))
print(entries.contains("a"))
print(!entries.contains("."))
print(!entries.contains(".."))

var recursive = io.readDirRecursive(root) ?? []
print(recursive.contains("top.txt"))
print(recursive.contains("a"))
print(recursive.contains("a/b"))
print(recursive.contains("a/b/deep.txt"))

var missing = io.readDirRecursive(root + "/missing") ?? []
print(len(missing))

print(io.removeAll(root))
