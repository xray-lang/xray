import io
import path

var root = io.tempDir()!
print(len(root.toString()) > 0)

var nested = path.join(root, path.from("a/b"))
print(io.mkdirp(nested))
print(io.writeFile(path.join(root, path.from("top.txt")), "top"))
print(io.writeFile(path.join(nested, path.from("deep.txt")), "deep"))

var entries = io.readDir(root)!
var hasTop = false
var hasA = false
var hasDot = false
var hasDotDot = false
for (var i = 0; i < len(entries); i++) {
    var raw = entries[i].toString()
    if (raw == "top.txt") { hasTop = true }
    if (raw == "a") { hasA = true }
    if (raw == ".") { hasDot = true }
    if (raw == "..") { hasDotDot = true }
}
print(hasTop)
print(hasA)
print(!hasDot)
print(!hasDotDot)

var recursive = io.readDirRecursive(root)!
var hasRecursiveTop = false
var hasRecursiveA = false
var hasRecursiveAB = false
var hasRecursiveDeep = false
for (var i = 0; i < len(recursive); i++) {
    var raw = recursive[i].toString()
    if (raw == "top.txt") { hasRecursiveTop = true }
    if (raw == "a") { hasRecursiveA = true }
    if (raw == "a/b") { hasRecursiveAB = true }
    if (raw == "a/b/deep.txt") { hasRecursiveDeep = true }
}
print(hasRecursiveTop)
print(hasRecursiveA)
print(hasRecursiveAB)
print(hasRecursiveDeep)

var missing = io.readDirRecursive(path.join(root, path.from("missing")))
print(missing == null ? 0 : len(missing!))

print(io.removeAll(root))
