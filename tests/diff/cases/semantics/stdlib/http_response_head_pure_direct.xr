// Pure-Xray HTTP response head and redirect control-plane helpers.
import http
import { parseResponseHead, redirectDecision, redirectTarget, isRedirectStatus } from http

var raw = "HTTP/1.1 302 Found\r\n" +
    "Location: /next?q=1\r\n" +
    "Content-Length: 5\r\n" +
    "Connection: close\r\n" +
    "Set-Cookie: a=1\r\n" +
    "Set-Cookie: b=2\r\n\r\nhello"

var head = parseResponseHead(raw)!
print(head.version)
print(head.status)
print(head.reason)
print(head.contentLength)
print(head.chunked)
print(head.keepAlive)
print(head.getHeader("location")!)
print(head.getHeaders("set-cookie").join("|"))
print(head.headers.get("Content-Length")!)

var chunked = parseResponseHead("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n")!
print(chunked.status)
print(chunked.contentLength)
print(chunked.chunked)
print(chunked.keepAlive)

var old = parseResponseHead("HTTP/1.0 200 OK\r\nConnection: keep-alive\r\n\r\n")!
print(old.keepAlive)

print(parseResponseHead("HTTP/1.1 200 OK\r\nBad Name: x\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nContent-Length: five\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\n folded: nope\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked, gzip\r\n\r\n") == null)
print(parseResponseHead("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n", 10) == null)

print(isRedirectStatus(308))
print(!isRedirectStatus(304))
print(redirectTarget("https://a.test/dir/page?q=1", "../next")!)

var d303 = redirectDecision(303, "https://a.test/form", "/done", "POST")!
print(d303.url)
print(d303.method)
print(d303.stripSensitiveHeaders)
print(d303.dropBody)

var d302 = redirectDecision(302, "http://a.test:80/start", "https://b.test/next", "POST")!
print(d302.url)
print(d302.method)
print(d302.stripSensitiveHeaders)
print(d302.dropBody)

var same = redirectDecision(302, "http://a.test/start", "http://a.test:80/next", "GET")!
print(same.stripSensitiveHeaders)
print(http.redirectDecision(200, "http://a.test", "/next") == null)
