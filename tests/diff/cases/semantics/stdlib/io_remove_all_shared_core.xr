import io
import path

var root = io.tempDir()!
print(len(root.toString()) > 0)

var nested = path.join(root, path.from("x/y"))
var file = path.join(nested, path.from("a.txt"))
var top = path.join(root, path.from("top.txt"))
print(io.mkdirp(nested))
print(io.writeFile(file, "a"))
print(io.writeFile(top, "b"))

print(io.removeAll(file))
print(!io.exists(file))
print(io.writeFile(file, "again"))

print(io.removeAll(root))
print(!io.exists(root))
print(!io.removeAll(root))
