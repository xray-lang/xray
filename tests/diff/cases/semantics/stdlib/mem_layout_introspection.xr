import mem

struct Header {
    magic: byte
    version: u16
    flags: byte
    length: u32
}

packed struct PackedHeader {
    magic: byte
    length: u32
    flags: u16
}

struct Inner {
    code: u16
    tag: byte
}

struct Outer {
    header: Header
    inner: Inner
    tail: byte
}

print(mem.sizeOf<byte>())
print(mem.alignOf<byte>())
print(mem.sizeOf<u16>())
print(mem.alignOf<u16>())
print(mem.sizeOf<u32>())
print(mem.alignOf<u32>())
print(mem.sizeOf<u64>())
print(mem.alignOf<u64>())
print(mem.sizeOf<f32>())
print(mem.alignOf<f32>())
print(mem.sizeOf<f64>())
print(mem.alignOf<f64>())
print(mem.sizeOf<Ptr<byte>>())
print(mem.alignOf<Ptr<byte>>())
print(mem.sizeOf<[u16; 3]>())
print(mem.alignOf<[u16; 3]>())

print(mem.sizeOf<Header>())
print(mem.alignOf<Header>())
print(mem.offsetOf<Header>("magic"))
print(mem.offsetOf<Header>("version"))
print(mem.offsetOf<Header>("flags"))
print(mem.offsetOf<Header>("length"))

print(mem.sizeOf<PackedHeader>())
print(mem.alignOf<PackedHeader>())
print(mem.offsetOf<PackedHeader>("magic"))
print(mem.offsetOf<PackedHeader>("length"))
print(mem.offsetOf<PackedHeader>("flags"))

print(mem.sizeOf<Inner>())
print(mem.alignOf<Inner>())
print(mem.sizeOf<Outer>())
print(mem.alignOf<Outer>())
print(mem.offsetOf<Outer>("header"))
print(mem.offsetOf<Outer>("inner"))
print(mem.offsetOf<Outer>("tail"))
