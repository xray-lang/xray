import os

var r = os.exec("printf 'abc'")
print(r != null)
print(r!.stdout.toString())
print(len(r!.stderr) == 0)
print(r!.exitCode)
print(!r!.stdoutTruncated)
print(!r!.stderrTruncated)

var e = os.exec("sh -c 'printf err >&2; exit 7'")
print(e != null)
print(len(e!.stdout) == 0)
print(e!.stderr.toString())
print(e!.exitCode)

var big = os.exec("awk 'BEGIN { for (i = 0; i < 200000; i++) printf \"x\" > \"/dev/stderr\" }'")
print(big != null)
print(big!.exitCode)
print(len(big!.stderr))
print(big!.stderrTruncated)

var bounded = os.exec("printf 123456789", 4, 0)
print(bounded != null)
print(bounded!.stdout.toString())
print(bounded!.stdoutTruncated)
print(len(bounded!.stderr))
print(!bounded!.stderrTruncated)
