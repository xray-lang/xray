// Typed CSV document, diagnostics, limits, and error channel must agree in VM/AOT.

import csv
import {
    CsvDelimiter,
    CsvDocument,
    CsvError,
    CsvErrorKind,
    CsvHeader
} from csv

var doc = try csv.parse("name,age\nAlice,30\nBob,25", header: CsvHeader.FirstRow)
print(len(doc.headers))
print(doc.headers[0])
print(len(doc.rows))
print(doc.rows[0][0])
print(doc.rows[1][1])

var report = try csv.parseReport("a,b\n1,2\n3")
print(len(report.document.rows))
print(len(report.diagnostics))
print(report.diagnostics[0].kind == CsvErrorKind.FieldCountMismatch)
print(report.diagnostics[0].line)
print(report.diagnostics[0].record)
print(report.diagnostics[0].column)

try {
    try csv.parse("a,b\n1")
} catch (e: CsvError) {
    print(match (e) {
        CsvError.FieldCountMismatch { byteOffset: offset, line, record, column, message } => record == 1,
        _ => false,
    })
}

var auto = try csv.parse("a;b;c\n1;2;3", delimiter: CsvDelimiter.Auto)
print(auto.rows[1][2])

var tsv = try csv.parse("x\ty\n4\t5", delimiter: CsvDelimiter.Exact { delimiter: '\t' })
print(tsv.rows[1][1])

var serial = CsvDocument()
serial.headers.push("name")
serial.headers.push("note")
serial.rows.push(["Alice", "hello, world"])
serial.rows.push(["Bob", "quote \" me"])
var out = try csv.stringify(serial)
print(out.contains("\"hello, world\""))
print(out.contains("\"quote \"\" me\""))
var roundtrip = try csv.parse(out, header: CsvHeader.FirstRow)
print(roundtrip.rows[1][1])

var comments = try csv.parse("\"# value\",x\n# ignored\ny,z", commentPrefix: "#")
print(len(comments.rows))
print(comments.rows[0][0])

try {
    try csv.parse("a,b", maxColumns: 1)
} catch (e: CsvError) {
    print(match (e) {
        CsvError.ColumnLimitExceeded { limit } => limit == 1,
        _                                   => false,
    })
}
