const STATIC_VALUES: [int32; 3] = [11, 22, 33]

fn readLocal() -> int {
    var values: [int32; 3] = [4, 5, 6]
    var p = unsafe { values.ptr() }
    return unsafe { p[1] }
}

fn readStatic() -> int {
    var p = unsafe { STATIC_VALUES.ptr() }
    return unsafe { p[2] }
}

fn readBytes() -> int {
    var p = unsafe { c"ok".ptr() }
    return unsafe { int(p[0]) + int(p[1]) + int(p[2]) }
}

print(readLocal())
print(readStatic())
print(readBytes())
