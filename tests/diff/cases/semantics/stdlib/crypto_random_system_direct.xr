import crypto

var r8 = crypto.randomBytes(8)
var r16 = crypto.randomBytes(16)
var uuid = crypto.uuid()
var parts = uuid.split("-")
var variant = uuid.charAt(19)

print(len(r8) == 16)
print(len(r16) == 32)
print(len(uuid) == 36)
print(len(parts) == 5)
print(len(parts[0]) == 8)
print(len(parts[1]) == 4)
print(len(parts[2]) == 4)
print(len(parts[3]) == 4)
print(len(parts[4]) == 12)
print(uuid.charAt(14) == "4")
print(variant == "8" || variant == "9" || variant == "a" || variant == "b")
