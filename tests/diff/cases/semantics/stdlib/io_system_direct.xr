// AOT direct-call filesystem helpers must match VM stdlib dispatch without
// pulling in the runtime-backed io module.
import io
import path

var root = io.tempDir()!
print(len(root.toString()) > 0)

var dir = path.join(root, path.from("a/b"))
print(io.mkdirp(dir))
print(io.isDir(dir))
print(io.mkdirp(dir))
print(io.mkdirp(path.from(dir.toString() + "///")))
print(io.isDir(dir))

var file = path.join(dir, path.from("sample.txt"))
print(io.writeFile(file, "hello"))
print(io.exists(file))
print(io.isFile(file))
print(!io.isDir(file))
print(io.fileSize(file))
print(io.readFile(file) == "hello")
print(io.appendFile(file, "\nworld"))

var lines = io.readLines(file)
print(len(lines))
print(lines[0])
print(lines[1])

var trailingFile = path.join(dir, path.from("trailing.txt"))
print(io.writeFile(trailingFile, "alpha\n"))
var trailingLines = io.readLines(trailingFile)
print(len(trailingLines))
print(trailingLines[0])

var crlfFile = path.join(dir, path.from("crlf.txt"))
print(io.writeFile(crlfFile, "a\r\n\r\nb\r\n"))
var crlfLines = io.readLines(crlfFile)
print(len(crlfLines))
print(crlfLines[0])
print(crlfLines[1] == "")
print(crlfLines[2])

var bytesFile = path.join(dir, path.from("bytes.bin"))
var bytes = Array<u8>(3)
bytes[0] = 65
bytes[1] = 0
bytes[2] = 255
print(io.writeFileBytes(bytesFile, bytes))
var readBytes = io.readFileBytes(bytesFile)
if (readBytes != null) {
    print(len(readBytes))
    print(readBytes[0])
    print(readBytes[1])
    print(readBytes[2])
} else {
    print(0)
    print(0)
    print(0)
    print(0)
}

var copied = path.join(root, path.from("copy.txt"))
print(io.copyFile(file, copied))
print(io.readFile(copied) == "hello\nworld")
var moved = path.join(root, path.from("moved.txt"))
print(io.rename(copied, moved))
print(!io.exists(copied))
print(io.exists(moved))

var stat = io.stat(file)
print(stat != null)
print(stat!.size == 11)
print(stat!.mode >= 0)
print(stat!.mtime >= 0)
print(stat!.atime >= 0)
print(stat!.ctime >= 0)
print(stat!.uid >= 0)
print(stat!.gid >= 0)
print(stat!.isFile)
print(!stat!.isDir)
print(!stat!.isSymlink)

var touched = path.join(root, path.from("touched.txt"))
print(io.touch(touched))
print(io.chmod(file, 420))

var entries = io.readDir(dir)!
print(len(entries) >= 2)
var recursive = io.readDirRecursive(root)!
print(len(recursive) >= 4)

var resolvedDir = io.realpath(dir)!
var oldCwd = io.cwd()
print(len(oldCwd.toString()) > 0)
print(len(resolvedDir.toString()) > 0)
print(io.chdir(dir))
print(io.cwd().toString() == resolvedDir.toString())
print(io.chdir(oldCwd))

var link = path.join(root, path.from("sample-link.txt"))
var linkOk = io.symlink(file, link)
if (linkOk) {
    print(io.isSymlink(link))
    print(io.readlink(link) != null)
} else {
    print(true)
    print(true)
}

var tmpFile = io.tempFile()!
print(len(tmpFile.toString()) > 0)
print(io.exists(tmpFile))
print(io.remove(tmpFile))

print(io.removeAll(root))
print(!io.exists(root))
