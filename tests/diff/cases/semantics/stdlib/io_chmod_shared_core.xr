import io
import os

var root = io.tempDir() ?? ""
print(root.length > 0)

var file = root + "/mode.txt"
print(io.writeFile(file, "mode"))

print(io.chmod(file, 420))
var st = io.stat(file)
if (os.platform == "windows") {
    print(st != null)
} else {
    print(st != null && st.mode == 420)
}

print(io.chmod(file, 0))
var st2 = io.stat(file)
if (os.platform == "windows") {
    print(st2 != null)
} else {
    print(st2 != null && st2.mode == 0)
}

print(io.removeAll(root))
print(!io.exists(root))
