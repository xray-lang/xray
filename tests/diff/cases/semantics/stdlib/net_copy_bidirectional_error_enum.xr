import net
import { NetError } from net

fn acceptOnce(listener: move NetListener) {
    var peer = net.accept(listener)
    if (peer != null) {
        net.close(peer!)
    }
    net.close(listener)
}

var listener = net.listen(0, 1)!
const port = listener.port()
var acceptTask = go acceptOnce(move listener)
var conn = net.dial("127.0.0.1", port, 1000)!
net.close(conn)
await acceptTask

try {
    net.copyBidirectional(conn, conn)
} catch (error: NetError) {
    print(error.name)
    print(error == NetError.Closed)
}
