import net
import { NetError } from net

// Two datagram sockets stand in for closed streams: copyBidirectional rejects
// any closed connection with a typed NetError.Closed before touching the
// socket, so no live TCP peer or coroutine is needed to exercise the guard.
fn main() {
    var a = net.udpBind(0, "")
    var b = net.udpBind(0, "")
    net.close(a)
    net.close(b)

    try {
        net.copyBidirectional(a, b)
    } catch (error: NetError) {
        print(error.name)
        print(error == NetError.Closed)
    }
}

main()
