// External raw DEFLATE, gzip and zlib streams generated by Python zlib 1.3.1.
// All decoded bytes, including NUL and 0xff, are compared without text decoding.
import compress

fn sameBytes(a: Array<u8>, b: Array<u8>) -> bool {
    if (len(a) != len(b)) { return false }
    for (var i = 0; i < len(a); i++) {
        if (a[i] != b[i]) { return false }
    }
    return true
}

fn compressionInvalidData(body: fn() throws(CompressionError)) -> bool {
    try {
        body()
        return false
    } catch (e: CompressionError) {
        return match (e) {
            CompressionError.InvalidData -> true
        }
    }
}

