assert(externalPayload[51] == 0x00)
assert(externalPayload[52] == 0xff)
var emptyPayload: Array<u8> = []

var decoded_dynamic_raw = try compress.inflate(dynamic_raw[:])
print(sameBytes(decoded_dynamic_raw, externalPayload))
var decoded_dynamic_gzip = try compress.gunzip(dynamic_gzip[:])
