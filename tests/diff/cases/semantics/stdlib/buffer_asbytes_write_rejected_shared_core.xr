import mem

fn main() {
    var writable = mem.allocZeroed(1)
    unsafe {
        mem.withSliceMut<u8>(writable.borrowPtr(), len(writable), ref writable,
            fn(bytes: ref Slice<u8>) {
                bytes[0] = 7
            })
    }
    var readonlyBuffer = mem.allocZeroed(1)
    var readonly: const Slice<u8> = readonlyBuffer.asBytes()
    readonly[0] = 9
    print("unreachable")
}

main()
