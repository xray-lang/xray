// anchor: semantics-final-class-instance-method-call
// VM/AOT differential coverage for calling an instance method on a final
// class. The receiver is the callee's first parameter, so the call's operands
// line up with the parameter list one to one -- unlike a plain call, whose
// operand 0 is the callee and fills no parameter at all. The receiver crosses
// the boundary as a borrow: the caller keeps the allocation and answers for
// it, while the method reads through the same instance.
//
// Before the direct-local call family bound this shape, the semantic layer
// proved the target and each layer below refused it in turn -- no adapter
// consumed the kind, no collector built an intent, and no boundary described
// the owning-to-borrowing hand-over.
//
// Both construction paths are covered. A declared constructor lets the emitter
// inline it and keep the object in a C local as a bare pointer; a class with
// none is allocated and boxed. The call site has to spell the receiver the way
// the emitter actually built it, not the way the plan names its storage.

final class Counter {
    n: i64

    constructor(n: i64) {
        this.n = n
    }

    value() -> i64 {
        return this.n
    }

    twice() -> i64 {
        return this.n + this.n
    }

    plus(k: i64) -> i64 {
        return this.n + k
    }

    scaled(a: i64, b: i64) -> i64 {
        return this.n * a + b
    }

    relay() -> i64 {
        return this.twice()
    }
}

final class Boxed {
    m: i64 = 4

    value() -> i64 {
        return this.m
    }

    plus(k: i64) -> i64 {
        return this.m + k
    }
}

fn main() {
    var c = Counter(7)
    print(c.value())
    print(c.twice())
    print(c.plus(5))
    print(c.scaled(3, 2))
    print(c.relay())
    print(c.value() + c.plus(1))

    var b = Boxed()
    print(b.value())
    print(b.plus(6))
}

main()
