import { Mutex, CountdownLatch } from sync
// The canonical pure-Xray Mutex<T> shared across coroutines: the guarded
// value must be genuinely shared by reference (not copied per coroutine), and
// mutation under the lock in a spawned coroutine must be visible to the parent
// after synchronisation. Confirms the composition provides real cross-coroutine
// mutual exclusion in both VM and AOT, not just single-coroutine behaviour.

const m = Mutex<int>(0)
const done = CountdownLatch(1)

go fn() {
    m.replace((v) -> v + 100)
    done.done()
}()

done.wait()
print(m.lock((v) -> v))   // 100 — mutation from the spawned coroutine is visible
