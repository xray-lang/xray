import { Condvar, CountdownLatch } from sync
// Exercise the canonical pure-Xray Condvar composition. Only declarations
// owned by the sync module receive the compiler's audited sync-shareable
// capability; a user class with the same spelling must not bypass go-capture
// or deep-readonly checks.

// --- Scenario 1: single-producer / single-consumer via signal ----------------
// The consumer parks on the condvar until the producer publishes a value under
// the same monitor lock and signals. Output is deterministic regardless of which
// coroutine is scheduled first, because the consumer checks the predicate first.

const cv = Condvar()
const box = Atomic<i64>(-1)   // -1 = empty; guarded by cv's monitor lock
const consumed = CountdownLatch(1)

go fn() {
    cv.lock()
    while (box.load() < 0) { cv.wait() }
    var v = box.load()
    cv.unlock()
    print(v)              // 42
    consumed.done()
}()

cv.lock()
box.store(42)
cv.signal()
cv.unlock()

consumed.wait()

// --- Scenario 2: broadcast wakes every parked waiter -------------------------
// Three consumers park until a flag flips; one broadcast must release all of
// them. The observable result (count of woken consumers) is order-independent.

const cv2 = Condvar()
const ready = Atomic<bool>(false)
const woke = Atomic<i64>(0)
const all = CountdownLatch(3)

for (i in 0..3) {
    go fn() {
        cv2.lock()
        while (!ready.load()) { cv2.wait() }
        cv2.unlock()
        woke.fetchAdd(1)
        all.done()
    }()
}

cv2.lock()
ready.store(true)
cv2.broadcast()
cv2.unlock()

all.wait()
print(woke.load())       // 3 — every parked waiter was released by one broadcast
print("done")
