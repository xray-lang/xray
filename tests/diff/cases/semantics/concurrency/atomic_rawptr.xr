// Atomic<RawPtr<T>> / Atomic<RawMut<T>> (task 147 §6.1): the generic Atomic
// primitive erases T to a tagged value, so pointer payloads flow through
// load/store/swap/compareExchange with no per-type code. VM and AOT must agree.
// Pointer bit-values are non-deterministic, so every assertion observes the
// DATA behind the pointer (deterministic) or the CAS success flag.
@extern("C") fn malloc(n: uintsize) -> RawMut<uint8>
@extern("C") fn free(p: RawMut<uint8>)

let p1 = unsafe { malloc(4) }
let p2 = unsafe { malloc(4) }
unsafe { p1[0] = 11 }
unsafe { p2[0] = 22 }

shared const a = Atomic<RawMut<uint8>>(p1)

// load: read data behind the stored pointer
unsafe { print(a.load()[0]) }        // 11
print(a.load().isNull())             // false

// store: swap in p2, observe its data
a.store(p2)
unsafe { print(a.load()[0]) }        // 22

// swap: returns previous (p2), installs p1
let old = a.swap(p1)
unsafe { print(old[0]) }             // 22 (was p2)
unsafe { print(a.load()[0]) }        // 11 (now p1)

// compareExchange success: expected == current (p1) -> installs p2
let (prev, ok) = a.compareExchange(a.load(), p2)
print(ok)                            // true
unsafe { print(a.load()[0]) }        // 22 (now p2)

// compareExchange failure: expected p1 but current is p2 -> no change
let (prev2, ok2) = a.compareExchange(p1, p1)
print(ok2)                           // false
unsafe { print(a.load()[0]) }        // 22 (unchanged)

unsafe { free(p1) }
unsafe { free(p2) }
print("ok")
