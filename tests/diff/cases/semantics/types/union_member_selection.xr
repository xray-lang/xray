// anchor: union-member-selection
// A union value carries the member selected at the assignment point. Exact type
// matches win over implicit conversion, so the selection never depends on the
// order the members were written, and `is` tests are mutually exclusive.
var a: i64 | f64 = 1
print("a=${a} is i64=${a is i64} is f64=${a is f64}")

var b: i64 | f64 = 1.0
print("b=${b} is i64=${b is i64} is f64=${b is f64}")

var c: i32 | string = 7
print("c=${c} is i32=${c is i32} is string=${c is string}")

var d: f32 | string = 1.5
print("d=${d} is f32=${d is f32} is string=${d is string}")

var e: i32 | string = "s"
print("e=${e} is i32=${e is i32} is string=${e is string}")

var narrow: i16 = 3
var widened: i32 | string = narrow
print("widened=${widened} is i32=${widened is i32} is string=${widened is string}")

// Reassignment reselects the member.
var switched: i64 | f64 = 1
switched = 2.5
print("switched=${switched} is i64=${switched is i64} is f64=${switched is f64}")

// Arm order does not affect which arm matches.
var m1: i64 | f64 = 3
match (m1) {
    is f64 -> print("m1 f64"),
    is i64 -> print("m1 i64"),
}
var m2: i64 | f64 = 3.5
match (m2) {
    is i64 -> print("m2 i64"),
    is f64 -> print("m2 f64"),
}
