// Unknown JSON is decoded through an explicit schema boundary. Structural
// object unions continue to use `is` and `as` for ordinary static narrowing.
type User = { name: string, age: int }
type Tagged = { kind: string, n: int }

var ok: JSON.Value = JSON.parseValue("{\"name\":\"Alice\",\"age\":30}")
var missingField: JSON.Value = JSON.parseValue("{\"name\":\"Bob\"}")
var extraField: JSON.Value = JSON.parseValue("{\"name\":\"Carol\",\"age\":7,\"extra\":true}")
var wrongKind: JSON.Value = JSON.parseValue("{\"name\":\"Dan\",\"age\":\"not an int\"}")

print("ok decodes User=" + (JSON.decode<User>(ok) != null).toString())
print("missing decodes User=" + (JSON.decode<User>(missingField) != null).toString())
print("extra rejects by default=" + (JSON.decode<User>(extraField) == null).toString())
print("extra ignores explicitly=" +
      (JSON.decode<User>(extraField, JSON.UnknownFields.Ignore) != null).toString())
print("wrongKind decodes User=" + (JSON.decode<User>(wrongKind) != null).toString())

var narrowed = JSON.decode<User>(ok)!
print("narrowed=" + narrowed.name + "/" + narrowed.age.toString())

var scalar: JSON.Value = 42
print("scalar decodes User=" + (JSON.decode<User>(scalar) != null).toString())

// A union of Objects is discriminated by the same check.
fn describe(v: User | Tagged) -> string {
    if (v is Tagged) { return "tagged:" + (v as Tagged).n.toString() }
    if (v is User) { return "user:" + (v as User).name }
    return "neither"
}
var t: User | Tagged = { kind: "t", n: 9 }
var u: User | Tagged = { name: "Eve", age: 1 }
print(describe(t))
print(describe(u))
