enum GenErr {
    Msg(s: string)
}

fn gen() -> Iterator<i64> {
    yield 1
    throw GenErr.Msg("boom")
}

try {
    var it = gen().iterator()
    while (it.hasNext()) {
        var x = it.next()
        print("x " + string(x))
    }
    print("after try")
} catch (e) {
    match (e) {
        GenErr.Msg(s) -> print("caught " + s)
    }
}
