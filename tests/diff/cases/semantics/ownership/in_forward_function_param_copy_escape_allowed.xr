fn wrap(data: in Array<int>, out: ref Array<Array<int>>) {
    stash(copy(data), ref out)
}

fn stash(value: Array<int>, out: ref Array<Array<int>>) {
    out.push(value)
}

var values: Array<int> = [1, 2, 3]
var out: Array<Array<int>> = []
wrap(values, ref out)
values.push(4)
print(len(out[0]))
print(len(values))
