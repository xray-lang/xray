fn sink(value: Array<i64>, out: ref Array<Array<i64>>) {
    out.push(value)
}

fn stash(data: Array<i64>, out: ref Array<Array<i64>>) {
    sink(copy(data), ref out)
}

var values: Array<i64> = [1, 2, 3, 4]
var out: Array<Array<i64>> = []
stash(values, ref out)
values.push(5)
print(len(out[0]))
print(len(values))
