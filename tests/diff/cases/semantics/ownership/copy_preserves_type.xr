// copy(x) preserves the static type of x: the deep copy can be passed to a
// typed parameter and bound to a typed `shared`. Guards the analyzer
// inference for the deep-copy builtin (116 copy / shared-promotion demos).
class Box {
    value: i64

    constructor(v: i64) {
        this.value = v
    }
}

fn readValue(b: Box) -> i64 {
    return b.value
}

var original = Box(42)
var duplicate = copy(original)
print(readValue(duplicate))

const frozen = copy(original)
print(readValue(frozen))

fn total(a: Array<i64>) -> i64 {
    var s = 0
    for (x in a) {
        s = s + x
    }
    return s
}

var xs: Array<i64> = [1, 2, 3]
print(total(copy(xs)))
