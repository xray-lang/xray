class PureCounter {
    value: int

    constructor(v) {
        this.value = v
    }

    push() -> int {
        return this.value + 1
    }

    callPush() -> int {
        return this.push()
    }
}

fn view(counter: PureCounter) -> int {
    return counter.push() + counter.callPush()
}

var counter = PureCounter(10)
print(view(counter))
