// 116 boundary: build a `shared` map, alias the same shared identity, then
// pass it across two goroutines.
fn reader(t: Map<int, int>) -> int {
    return len(t)
}

shared table: Map<int, int> = #{}
table.set(1, 10)
table.set(2, 20)
shared ro = table
var a = go reader(ro)
var b = go reader(ro)
print(await a)
print(await b)
