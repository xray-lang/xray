class Holder {
    items: Array<Array<int>>

    constructor() {
        this.items = []
    }

    outer(value: Array<int>) {
        this.middle(value)
    }

    middle(value: Array<int>) {
        this.store(value)
    }

    store(value: Array<int>) {
        this.items.push(value)
    }
}

fn stash(data: in Array<int>, holder: ref Holder) {
    holder.outer(copy(data))
}

let values: Array<int> = [1, 2, 3]
let holder = Holder()
stash(values, holder)
values.push(4)
print(holder.items[0].length)
print(values.length)
