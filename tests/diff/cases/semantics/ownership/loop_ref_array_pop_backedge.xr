// A dispatch loop pops an operand stack through a ref-Array helper and keeps
// using the same stack on later iterations. The loop-carried array flows through
// a back-edge phi whose incoming value is the ref-reloaded alias of the value it
// replaces. ARC must retain that alias before releasing the replaced owner;
// reversing the order transiently frees the shared array and corrupts the next
// iteration (VM: method-on-unsupported-type; AOT: empty-array index).
fn popValue(stack: ref Array<i64>) -> i64 {
    if (len(stack) == 0) {
        return 0
    }
    return stack.pop()!
}

fn takeResult(stack: ref Array<i64>, n: i64) -> Array<i64> {
    var out = Array<i64>(n, 0)
    for (var i = 0; i < n; i += 1) {
        out[n - 1 - i] = stack.pop()!
    }
    return out
}

fn interp(code: Array<i64>, arg: i64) -> i64 {
    var stack: Array<i64> = []
    var pos = 0
    while (pos < len(code)) {
        var op = code[pos]
        pos += 1
        if (op == 1) {
            stack.push(arg)
        } else if (op >= 10 && op <= 19) {
            var b = popValue(ref stack)
            var a = popValue(ref stack)
            stack.push(a + b)
        } else if (op == 2) {
            var out = takeResult(ref stack, 1)
            return out[0]
        } else {
            return 0 - 1
        }
    }
    return 0 - 2
}

fn main() {
    // push arg, push arg, add, return -> arg + arg
    var addCode: Array<i64> = [1, 1, 10, 2]
    assert(interp(addCode, 7) == 14)
    // push arg three times, add, add, return -> 3 * arg
    var chainCode: Array<i64> = [1, 1, 1, 10, 10, 2]
    assert(interp(chainCode, 5) == 15)
    print(interp(addCode, 7))
}

main()
