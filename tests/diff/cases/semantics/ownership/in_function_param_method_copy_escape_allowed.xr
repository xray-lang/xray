class Holder {
    items: Array<Array<i64>>

    constructor() {
        this.items = []
    }

    store(value: Array<i64>) {
        this.items.push(value)
    }
}

fn wrap(value: Array<i64>, holder: ref Holder) {
    holder.store(value)
}

fn stash(data: Array<i64>, holder: ref Holder) {
    wrap(copy(data), ref holder)
}

var values: Array<i64> = [1, 2, 3]
var holder = Holder()
stash(values, ref holder)
values.push(4)
print(len(holder.items[0]))
print(len(values))
