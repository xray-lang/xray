class Holder {
    items: Array<Array<int>>

    constructor() {
        this.items = []
    }

    store(value: Array<int>) {
        this.items.push(value)
    }
}

fn wrap(value: Array<int>, holder: ref Holder) {
    holder.store(value)
}

fn stash(data: in Array<int>, holder: ref Holder) {
    wrap(copy(data), ref holder)
}

var values: Array<int> = [1, 2, 3]
var holder = Holder()
stash(values, ref holder)
values.push(4)
print(len(holder.items[0]))
print(len(values))
