// Twin module A for xmod_same_name_classes.xr. Its bare class name `Options`
// deliberately collides with the one module B exports. Skipped as a standalone
// diff case because its basename starts with '_'.
export class Options {
    weight: i64
    constructor(weight: i64 = 10) {
        this.weight = weight
    }
}

export fn pick(o: Options) -> i64 {
    return o.weight
}
