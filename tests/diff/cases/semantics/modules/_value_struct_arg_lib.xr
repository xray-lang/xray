export struct Pair {
    a: i64
    b: i64
}

export fn take(p: Pair) -> i64 {
    return p.a + p.b
}

export fn make(x: i64) -> Pair {
    return Pair{a: x, b: x * 2}
}

export fn takeArr(v: [i64; 3]) -> i64 {
    return v[0] + v[1] + v[2]
}

export fn makeArr(x: i64) -> [i64; 3] {
    return [x, x * 2, x * 3]
}
