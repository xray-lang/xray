// Library module owning a full inheritance chain: the importing entry must
// see inherited fields and overridden methods without redeclaring anything.
export class Base {
    b: int
    constructor() { this.b = 1 }
    tag() -> string { return "base" }
}

export class Sub extends Base {
    s: int
    constructor() { super(); this.s = 2 }
    tag() -> string { return "sub" }
    own() -> int { return this.s }
}
