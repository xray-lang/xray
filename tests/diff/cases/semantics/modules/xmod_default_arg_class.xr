// anchor: cross-module-default-arg-class
// A default argument that names a class constructor or an exported helper of the
// declaring module must resolve at any importer, whether the callee is reached
// through a selective function-only import (the referenced class is NOT imported
// into the caller scope) or a namespace import. VM and AOT must agree byte for
// byte.
import { withOpt, withLabel, withCall } from "./_default_arg_class_lib"
import "./_default_arg_class_lib" as lib

print(withOpt())               // selective import; default Opt() is cross-module
print(withLabel())             // default Opt(), field read
print(withCall())              // default calls exported secret()
print(lib.withOpt())           // namespace call; default Opt()
print(lib.withCall())          // namespace call; default secret()
print(lib.withOpt(lib.Opt()))  // explicit lib.Opt() module-qualified construction
