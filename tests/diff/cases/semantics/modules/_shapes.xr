// Library module imported by xmod_static.xr (skipped as a standalone diff case
// because its basename starts with '_').  Exercises cross-module static method
// dispatch: the importer calls static factory methods defined here.
export class Shape {
    side: i64
    constructor(s: i64) {
        this.side = s
    }
    static unit() -> Shape {
        return Shape(1)
    }
    static square(n: i64) -> Shape {
        return Shape(n)
    }
    area() -> i64 {
        return this.side * this.side
    }
}
