// Cross-module class inheritance through AOT separate compilation: a locally
// defined class extends a base class imported from a sibling module, calling
// the base constructor via super, overriding one method, and inheriting another
// method and the base fields.  VM and AOT must agree byte-for-byte.
import { Animal } from "./_animals"

class Dog extends Animal {
    constructor(n: string) {
        super(n, 4)
    }
    override describe() -> string {
        return "dog:" + this.name
    }
}

let d = new Dog("Rex")
print(d.describe())
print(d.leg_count())
print(d.name)
print(d.legs)
