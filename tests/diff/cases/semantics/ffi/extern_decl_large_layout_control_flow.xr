// task-208: Read_utf8/Function_Release-shaped stress case.  A large extern
// layout, pointer loop and release loop must not corrupt the following C body.
import mem

struct Task208Function {
    code: Ptr<byte>
    codeSize: usize
    locals: [u32; 4]
    constants: [u64; 4]
    next: Ptr<Task208Function>
}

extern "C" {
    fn malloc(n: usize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>) -> ()
}

fn readUtf8Like(bytes: Ptr<byte>, length: usize) -> usize {
    var cursor: usize = 0
    var checksum: usize = 0
    while (cursor < length) {
        checksum += unsafe { bytes[cursor] }
        cursor += 1
    }
    return checksum
}

fn functionReleaseLike(count: usize) -> usize {
    var released: usize = 0
    var index: usize = 0
    while (index < count) {
        var block = unsafe { malloc(mem.sizeOf<Task208Function>() as usize) }
        unsafe {
            free(block)
        }
        released += index
        index += 1
    }
    return released
}

const utf8 = b"wasm3"
print(mem.sizeOf<Task208Function>())
print(readUtf8Like(unsafe { utf8.ptr() }, len(utf8) as usize))
print(functionReleaseLike(5))
