// task-208: Read_utf8/Function_Release-shaped stress case.  A large extern
// layout, pointer loop and release loop must not corrupt the following C body.
import mem

extern "C" {
    struct Task208Function {
        code: Ptr<byte>
        codeSize: uintsize
        locals: [uint32; 4]
        constants: [uint64; 4]
        next: Ptr<Task208Function>
    }

    fn malloc(n: uintsize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>) -> ()
}

fn readUtf8Like(bytes: Ptr<byte>, length: uintsize) -> uintsize {
    var cursor: uintsize = 0
    var checksum: uintsize = 0
    while (cursor < length) {
        checksum += unsafe { bytes[cursor] }
        cursor += 1
    }
    return checksum
}

fn functionReleaseLike(count: uintsize) -> uintsize {
    var released: uintsize = 0
    var index: uintsize = 0
    while (index < count) {
        var block = unsafe { malloc(mem.sizeOf<Task208Function>()) }
        unsafe {
            free(block)
        }
        released += index
        index += 1
    }
    return released
}

const utf8 = b"wasm3"
print(mem.sizeOf<Task208Function>())
print(readUtf8Like(unsafe { utf8.ptr() }, len(utf8)))
print(functionReleaseLike(5))
