// Direct extern calls are an explicit unsafe boundary and may consume a
// call-bound pointer borrow without extending its Xray lifetime.
extern "C" {
    fn memcmp(left: Ptr<u8>, right: Ptr<u8>, size: usize) -> i32
}

fn compareLocal() -> i32 {
    const local = b"AB"
    return unsafe { memcmp(local.ptr(), b"AB".ptr(), 2) }
}

print(compareLocal())
