// anchor: task-235-with-slice-mut
import mem

extern "C" {
    struct Header {
        length: uint64
        delta: int64
    }

    fn malloc(n: uintsize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>)
}

fn main() {
    var raw = unsafe { malloc(mem.sizeOf<Header>()) }
    var result = unsafe {
        mem.withSliceMut<Header>(raw, 1, ref raw, fn(view: ref Slice<Header>) -> int64 {
            view[0].length = 73
            view[0].delta = -73
            return view[0].delta
        })
    }
    print(result)
    unsafe {
        print(mem.load<uint64>(raw, mem.offsetOf<Header>("length"), Endian.Native))
        print(mem.load<int64>(raw, mem.offsetOf<Header>("delta"), Endian.Native))
        free(raw)
    }
}

main()
