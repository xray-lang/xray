import mem

struct Child {
    code: u32
}

struct Header {
    tag: u8
    count: u32
    next: Ptr<Child>
    child: Child
}

extern "C" {
    fn malloc(n: usize) -> MutPtr<u8>
    fn free(p: MutPtr<u8>)
}

fn main() {
    var raw = unsafe { malloc(mem.sizeOf<Header>() as usize) }
    unsafe {
        mem.withSliceMut<Header>(raw, 1, ref raw, fn(headers: ref Slice<Header>) {
            headers[0].tag = 7
            headers[0].count = 4099
            headers[0].count += 1
            headers[0].child.code = 91
            print(headers[0].tag)
            print(headers[0].count)
            print(headers[0].child.code)
            print(headers[0].child.code)
        })
        free(raw)
    }
}

main()
