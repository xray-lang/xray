// FFI: scalar descriptor matrix cases must round-trip through the same
// compact extern ABI metadata in the VM and AOT backends.
extern "C" {
    fn strlen(s: Ptr<u8>) -> usize
    fn memcmp(left: Ptr<u8>, right: Ptr<u8>, n: usize) -> i32
    fn llabs(x: i64) -> i64
    fn labs(x: isize) -> isize
}

extern "C" {
    fn fminf(x: f32, y: f32) -> f32
    fn fmax(x: f64, y: f64) -> f64
}

// `left` is passed to C strlen, which reads until a NUL terminator. Byte
// literals are exactly-N-byte arrays (no implicit terminator), so the input
// must carry its own NUL to make the FFI call well-formed; otherwise strlen
// runs off the end of the 3-byte array (an out-of-bounds read by construction).
const left = b"ABC\0"
const right = b"ABD"

print(unsafe { strlen(left.ptr()) })
print(unsafe { memcmp(left.ptr(), right.ptr(), 3) < 0 })
print(unsafe { llabs(-1234567890123) })
print(unsafe { labs(-23) })
print(unsafe { fminf(2.5, -1.5) == -1.5 })
print(unsafe { fmax(2.5, -1.5) == 2.5 })
