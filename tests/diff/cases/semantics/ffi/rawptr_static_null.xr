// Ptr<T>.null() / MutPtr<T>.null() are typed raw-pointer constants.
// The VM stores raw pointers as address ints; AOT stores them as native pointers.
import mem

var p = Ptr<byte>.null()
var q = MutPtr<byte>.null()
var r: Ptr<byte> = q

print(p.isNull())
print(q.isNull())
print(r.isNull())
print(mem.addressOf(p))
print(mem.addressOf(q))
print(mem.addressOf(r))
print("ok")
