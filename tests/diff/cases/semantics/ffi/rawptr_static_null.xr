// RawPtr<T>.null() / RawMut<T>.null() are typed raw-pointer constants.
// The VM stores raw pointers as address ints; AOT stores them as native pointers.
import mem

var p = RawPtr<byte>.null()
var q = RawMut<byte>.null()
var r: RawPtr<byte> = q

print(p.isNull())
print(q.isNull())
print(r.isNull())
print(mem.addressOf(p))
print(mem.addressOf(q))
print(mem.addressOf(r))
print("ok")
