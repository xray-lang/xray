// Ptr<T>.null() / MutPtr<T>.null() are typed raw-pointer constants.
// The VM stores raw pointers as address ints; AOT stores them as native pointers.
import mem

var p = Ptr<u8>.null()
var q = MutPtr<u8>.null()
var r: Ptr<u8> = q

print(p.isNull())
print(q.isNull())
print(r.isNull())
print(mem.addr(p))
print(mem.addr(q))
print(mem.addr(r))
print("ok")
