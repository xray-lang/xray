// FFI: raw pointer memory through malloc / memcpy / free.
// Exercises Ptr/MutPtr subscript read+write, deref(), offset(), isNull(),
// and a multi-statement unsafe block. The VM (libffi + OP_PTR_LOAD/STORE) and
// AOT (direct C call + inline *(T*)) backends must produce identical output.
extern "C" {
    fn malloc(n: uintsize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>)
    fn memcpy(dst: MutPtr<byte>, src: Ptr<byte>, n: uintsize) -> MutPtr<byte>
}

var src = unsafe { malloc(4) }
var dst = unsafe { malloc(4) }

unsafe {
    src[0] = 10
    src[1] = 20
    src[2] = 30
    src[3] = 40
    memcpy(dst, src, 4)
    print(dst[0])
    print(dst[1])
    print(dst[2])
    print(dst[3])
    var mid = dst.offset(2)
    print(mid.deref())
}

print(src.isNull())
print(dst.isNull())

unsafe { free(src) }
unsafe { free(dst) }
