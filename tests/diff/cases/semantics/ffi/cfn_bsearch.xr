// FFI: pass a top-level Xray function as a CFn callback to libc bsearch.
// VM uses libffi's callback bridge; AOT emits a no-closure C ABI stub.
@extern("C") fn malloc(n: uintsize) -> RawMut<byte>
@extern("C") fn free(p: RawMut<byte>)
@extern("C") fn bsearch(key: RawPtr<byte>, base: RawPtr<byte>, count: uintsize, size: uintsize, cmp: CFn<(RawPtr<byte>, RawPtr<byte>) -> int32>) -> RawPtr<byte>

fn zeroCmp(a: RawPtr<byte>, b: RawPtr<byte>) -> int32 {
    return 0
}

var p = unsafe { malloc(1) }
unsafe {
    p[0] = 42
    var found = bsearch(p, p, 1, 1, zeroCmp)
    print(found.isNull())
}
unsafe { free(p) }
