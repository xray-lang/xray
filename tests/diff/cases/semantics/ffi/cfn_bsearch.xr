// FFI: pass a top-level Xray function as a CFn callback to libc bsearch.
// VM uses libffi's callback bridge; AOT emits a no-closure C ABI stub.
extern "C" {
    fn malloc(n: usize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>)
    fn bsearch(key: Ptr<byte>, base: Ptr<byte>, count: usize, size: usize, cmp: CFn<(Ptr<byte>, Ptr<byte>) -> i32>) -> Ptr<byte>
}

fn zeroCmp(a: Ptr<byte>, b: Ptr<byte>) -> i32 {
    return 0
}

var p = unsafe { malloc(1) }
unsafe {
    p[0] = 42
    var found = bsearch(p, p, 1, 1, zeroCmp)
    print(found.isNull())
}
unsafe { free(p) }
