// FFI: pass a top-level Xray function as a CFn callback to libc bsearch.
// VM uses libffi's callback bridge; AOT emits a no-closure C ABI stub.
extern "C" {
    fn malloc(n: usize) -> MutPtr<u8>
    fn free(p: MutPtr<u8>)
    fn bsearch(key: Ptr<u8>, base: Ptr<u8>, count: usize, size: usize, cmp: CFn<fn(Ptr<u8>, Ptr<u8>) -> i32>) -> Ptr<u8>
}

fn zeroCmp(a: Ptr<u8>, b: Ptr<u8>) -> i32 {
    return 0
}

var p = unsafe { malloc(1) }
unsafe {
    p[0] = 42
    var found = bsearch(p, p, 1, 1, zeroCmp)
    print(found.isNull())
}
unsafe { free(p) }
