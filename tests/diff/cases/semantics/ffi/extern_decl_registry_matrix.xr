// task-208: every supported extern ABI shape is materialized through one
// canonical prepare registry; two source aliases intentionally share labs.
extern "C" {
    fn strlen(s: Ptr<u8>) -> usize
    fn memchr(s: Ptr<u8>, c: i32, n: usize) -> Ptr<u8>
    fn sinf(x: f32) -> f32
    fn srand(seed: u32) -> ()
    fn bsearch(key: Ptr<u8>, base: Ptr<u8>, count: usize, size: usize, cmp: CFn<fn(Ptr<u8>, Ptr<u8>) -> i32>) -> Ptr<u8>

    fn task208LabsA(x: isize) -> isize

    fn task208LabsB(x: isize) -> isize
}

extern "C" {
    fn task208NeverLinked(x: f64) -> f64
}

fn zeroCompare(left: Ptr<u8>, right: Ptr<u8>) -> i32 {
    return 0
}

fn callNativeSize(f: fn(Ptr<u8>) -> usize, bytes: Ptr<u8>) -> usize {
    return f(bytes)
}

// strlen requires a NUL terminator.  A `b"..."` literal is an Array<byte> of
// exactly its content, and .ptr() carries no terminator contract, so the
// sentinel is explicit here; without it strlen reads past the buffer and the
// answer depends on the adjacent stack byte.
const text = b"registry\0"
var strlenIndirect = strlen
print(unsafe { callNativeSize(strlenIndirect, text.ptr()) })
var found = unsafe { memchr(text.ptr(), 103, 8) }
print(unsafe { found.deref() })
print(unsafe { task208LabsA(-11) + task208LabsB(-31) })
print(unsafe { sinf(0.0) == 0.0 })

unsafe {
    srand(1)
    print(bsearch(text.ptr(), text.ptr(), 1, 1, zeroCompare).isNull())
}
