// anchor: task-208-direct-native-size-memory
// Covers unaligned native-size integer loads/stores and both endian paths.
import mem

fn run() {
    var bytes = Array<byte>(64)
    var view: Slice<byte> = bytes[:]
    unsafe {
        var raw = view.mutPtr()
        var allBits: u64 = 0xffff_ffff_ffff_ffff
        var maxNative: usize = allBits as usize
        var minNative: isize =
            ((1 as usize) << ((mem.sizeOf<usize>() * 8) - 1)) as isize
        mem.store<usize>(raw, 1, 37, Endian.Native)
        mem.store<isize>(raw, 10, -37, Endian.Native)
        mem.store<usize>(raw, 19, 91, Endian.LE)
        mem.store<isize>(raw, 28, -91, Endian.LE)
        mem.store<usize>(raw, 40, maxNative, Endian.LE)
        mem.store<isize>(raw, 49, minNative, Endian.LE)

        print(mem.load<usize>(raw, 1, Endian.Native))
        print(mem.load<isize>(raw, 10, Endian.Native))
        print(mem.load<usize>(raw, 19, Endian.LE))
        print(mem.load<isize>(raw, 28, Endian.LE))
        print(mem.load<usize>(raw, 40, Endian.LE) == maxNative)
        print(mem.load<isize>(raw, 49, Endian.LE) == minNative)
    }
}

run()
