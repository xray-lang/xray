// VM/AOT/generated-C KAT for shared.raw-memory-copy. Source and destination
// allocations are disjoint, and sentinels detect writes outside each count.
fn run_copy(count: i64) -> i64 {
    var src = Array<u8>(40)
    var dst = Array<u8>(40)
    unsafe {
        var i = 0
        while (i < 40) {
            src[i] = (i + 11) as u8
            dst[i] = 205
            i += 1
        }
        dst.mutPtr().copyFromNonOverlapping(src.ptr(), count)
        var checksum = (dst[0] as i64) + (dst[count - 1] as i64) * 257
        if (count < 40) {
            checksum += (dst[count] as i64) * 65537
        }
        return checksum
    }
}

unsafe {
    MutPtr<u8>.null().copyFromNonOverlapping(Ptr<u8>.null(), 0)
    MutPtr<u8>.null().copyFromNonOverlapping(Ptr<u8>.null(), -1)
}
print(1)
print(run_copy(1))
print(run_copy(2))
print(run_copy(7))
print(run_copy(8))
print(run_copy(9))
print(run_copy(16))
print(run_copy(17))
print(run_copy(31))
