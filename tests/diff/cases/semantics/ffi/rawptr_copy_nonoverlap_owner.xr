// VM/AOT/generated-C KAT for shared.raw-memory-copy. Source and destination
// allocations are disjoint, and sentinels detect writes outside each count.
fn run_copy(count: int) -> int {
    var src = Array<byte>(40)
    var dst = Array<byte>(40)
    unsafe {
        var i = 0
        while (i < 40) {
            src[i] = (i + 11) as byte
            dst[i] = 205
            i += 1
        }
        dst.mutPtr().copyFromNonOverlapping(src.ptr(), count)
        var checksum = int(dst[0]) + int(dst[count - 1]) * 257
        if (count < 40) {
            checksum += int(dst[count]) * 65537
        }
        return checksum
    }
}

unsafe {
    MutPtr<byte>.null().copyFromNonOverlapping(Ptr<byte>.null(), 0)
    MutPtr<byte>.null().copyFromNonOverlapping(Ptr<byte>.null(), -1)
}
print(1)
print(run_copy(1))
print(run_copy(2))
print(run_copy(7))
print(run_copy(8))
print(run_copy(9))
print(run_copy(16))
print(run_copy(17))
print(run_copy(31))
