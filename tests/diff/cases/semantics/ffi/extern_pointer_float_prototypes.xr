// FFI: pointer-return externs and float32 C prototypes must stay isolated in
// the ABI descriptor across VM libffi and AOT direct-call lowering.
extern "C" {
    fn memchr(s: Ptr<u8>, c: i32, n: usize) -> Ptr<u8>
    fn sinf(x: f32) -> f32
}

extern "C" {
    fn xrayffi_unused_float(x: f64) -> f64
}

const bytes = b"ABC"
var found = unsafe { memchr(bytes.ptr(), 66, 3) }

print(found.isNull())
print(unsafe { found.deref() })
print(unsafe { sinf(0.0) == 0.0 })
