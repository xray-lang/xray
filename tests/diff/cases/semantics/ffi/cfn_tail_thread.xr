// Tail-threaded CFn op chain: opLoop indirect-tail-calls itself many times via a
// const op table. AOT lowers the tail call to musttail and the VM uses OP_TAILCALL,
// so both run in constant stack (no overflow) and must agree on the result.
extern "C" { fn malloc(n: usize) -> MutPtr<i32> }

type Op = CFn<fn(i64, MutPtr<i32>, i64) -> i64>

fn opLoop(pc: i64, stack: MutPtr<i32>, sp: i64) -> i64 {
    var cursor = stack
    var n = unsafe { cursor[0] }
    if (n <= 0) {
        return OPS[1](pc, stack, sp)
    }
    unsafe { cursor[0] = n - 1 }
    return OPS[0](pc, cursor, sp)
}

fn opReturn(pc: i64, stack: MutPtr<i32>, sp: i64) -> i64 {
    return unsafe { stack[1] }
}

const OPS: Array<Op> = [opLoop, opReturn]

fn main() {
    var stack = unsafe { malloc(64) }
    unsafe { stack[0] = 200000 }
    unsafe { stack[1] = 42 }
    print("result=${OPS[0](0, stack, 0)}")
}

main()
