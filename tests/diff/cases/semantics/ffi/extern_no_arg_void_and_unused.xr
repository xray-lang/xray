// FFI: no-arg extern prototypes must lower as C `fn(void)`, void-return extern
// calls must share the same descriptor in VM/AOT, and unused extern dylibs must
// not pollute the AOT link manifest.
extern "C" {
    fn srand(seed: u32) -> ()
    fn rand() -> i32
}

extern "C" {
    fn xrayffi_unused_float(x: f64) -> f64
}

unsafe { srand(7) }
print(unsafe { rand() })
