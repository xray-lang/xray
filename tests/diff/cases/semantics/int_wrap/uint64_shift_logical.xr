// anchor: uint64-shift-logical
// uint64 (statically unsigned) right shift must be LOGICAL (zero-extending)
// in both backends: VM lowers to OP_SHR_U, AOT to ((uint64_t)x >> n) /
// xrt_i64_shr_u. Regression guard for the xray-ports xxHash port divergence
// (VM used arithmetic shift on top-bit-set uint64 payloads, 2026-07-03).

// 高位置位的 uint64（字面量 > INT64_MAX 会饱和，用拼接构造）
let hi: uint64 = 0x8000_0000
let x: uint64 = hi << 32              // 0x8000000000000000
print(x)                              // 9223372036854775808
print(x >> 1)                         // 4611686018427387904（逻辑移）
print(x >> 63)                        // 1
print(x >> 0)                         // 9223372036854775808

// 非常量移位量（AOT 走 xrt_i64_shr_u 运行时助手路径）
let n1: int = 1
let n63: int = 63
print(x >> n1)                        // 4611686018427387904
print(x >> n63)                       // 1

// 全 1 位型
let ones: uint64 = 0xFFFF_FFFF
let all: uint64 = (ones << 32) | ones
print(all >> 33)                      // 2147483647
print(all >> n63)                     // 1

// xxHash64 avalanche 形状（乘出高位后异或右移）
let p2: uint64 = (0xC2B2_AE3D << 32) | 0x27D4_EB4F
let h: uint64 = (0x27D4_EB2F << 32) | 0x1656_67C5
h ^= h >> 33
h *= p2
h ^= h >> 29
print(h)                              // 13740831969934771102

// 有符号 int 保持算术移（不受影响）
let s: int = -8
print(s >> 1)                         // -4
let sn: int = 1
print(s >> sn)                        // -4

// uint32/uint8 右移（零扩展 payload，语义不变回归）
let u32top: uint32 = 0x8000_0000
print(u32top >> 31)                   // 1
let u8top: uint8 = 128
print(u8top >> 7)                     // 1

// 常量折叠路径（两操作数均编译期常量）
let cfold: uint64 = ((hi << 32) >> 62)
print(cfold)                          // 2
