// anchor: uint64-large-literals
// C-port constants above INT64_MAX must keep their raw 64-bit bit pattern.

var prime: u64 = 0x9E3779B185EBCA87
print(prime)

var maxDec: u64 = 18446744073709551615
print(maxDec)

var highBit: u64 = 9223372036854775808
print(highBit)

print(0xffff_ffff_ffff_ffff as u64)
print(9223372036854775808 as u64)
print((-1) as u64)

var min: i64 = -9223372036854775808
print(min)
