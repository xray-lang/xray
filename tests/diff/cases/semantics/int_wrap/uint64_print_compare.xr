// anchor: uint64-print-compare
// Static uint64 print/format/compare must interpret the stored bits as unsigned.

var max: u64 = 9223372036854775807
var high: u64 = max + 1
var all: u64 = 0 - 1
var zero: u64 = 0
var one: u64 = 1

fn gt_zero(x: u64) -> bool {
    return x > 0
}

fn zero_lt(x: u64) -> bool {
    return 0 < x
}

fn all_gt(x: u64, y: u64) -> bool {
    return x > y
}

fn branch_gt(x: u64) -> string {
    if (x > 0) {
        return "branch-gt"
    }
    return "branch-miss"
}

fn branch_le(x: u64, y: u64) -> string {
    if (x <= y) {
        return "branch-le"
    }
    return "branch-miss"
}

print(high)
print(all)
print(string(high))
print(high as string)
print("concat:" + string(high) + ":" + string(all))
print("tmpl:${high}:${all}")

print(high > zero)
print(zero < high)
print(all > high)
print(high <= all)
print(all >= high)
print(high < zero)
print(high > one)

print(gt_zero(high))
print(zero_lt(high))
print(all_gt(all, high))
print(branch_gt(high))
print(branch_le(high, all))
