var min: int = -9223372036854775807 - 1
var max: int = 9223372036854775807

print(min)
print(max)
print("left=" + min)
print(max + "=right")

var ints = Array<int>(3, 0)
ints[0] = min
ints[1] = max
ints[2] = -42
print(ints.join("|"))
print(ints)

var mixed = ["n", min, null, true, max]
print(mixed.join(":"))
