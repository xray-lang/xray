// anchor: exact-integer-bit-intrinsics
// Every call lowers to XI_BIT_* with the receiver's native width/sign tag.
// Functions keep the operands dynamic so VM bytecode and AOT native shapes
// are both exercised; the assignments below also prove receiver preservation.

fn rotl8(x: byte, n: int) -> byte { return x.rotateLeft(n) }
fn rotr8(x: byte, n: int) -> byte { return x.rotateRight(n) }
fn swap16(x: uint16) -> uint16 { return x.byteswap() }
fn round32(x: int32, n: int) -> int32 { return x.rotateLeft(n).rotateRight(n) }
fn swap64(x: uint64) -> uint64 { return x.byteswap() }

var b: byte = rotl8(129, 1)
var u8: uint8 = b.byteswap()
var i8: int8 = (-128 as int8).rotateLeft(-1)
print(b)                                  // 3
print(u8)                                 // 3 (one-byte swap is identity)
print(i8)                                 // 64 (negative count is Euclidean mod 8)
print(rotr8(1, 1))                        // 128
print(rotl8(1, 9))                        // 2

var i16: int16 = (4660 as int16).byteswap()
var u16: uint16 = swap16(33023)
print(i16)                                // 13330: 0x1234 -> 0x3412
print(u16)                                // 65408: 0x80ff -> 0xff80
print((0 as int16).leadingZeros())        // 16
print((-1 as int16).popcount())           // 16

var i32: int32 = round32(16909060, -37)
var u32: uint32 = (16909060 as uint32).byteswap()
print(i32)                                // round trip preserves 0x01020304
print(u32)                                // 67305985: 0x04030201
print((0 as uint32).trailingZeros())      // 32

var i64: int64 = (1 as int64).rotateRight(1)
var u64: uint64 = swap64(72623859790382856)
print(i64)                                // INT64_MIN bit pattern
print(u64)                                // 0x0807060504030201
print((-1 as uint64).popcount())          // 64

var iz: intsize = (1 as intsize).rotateLeft(-1).rotateRight(-1)
var uz: uintsize = (1 as uintsize).byteswap().byteswap()
print(iz)                                 // pointer-width round trip
print(uz)

// `int` remains the language's signed 64-bit default, through the same Xi op.
var x: int = 12345
var n: int = -65
print(x.rotateLeft(n).rotateRight(n))
print((0).leadingZeros())
