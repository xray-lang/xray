// anchor: eval-order-call
// §3.0 E2: callee (or receiver) before arguments, arguments left to right,
// defaults after every explicit argument.
fn t(tag: string, v: i64) -> i64 { print(tag); return v }
fn three(a: i64, b: i64, c: i64) -> i64 { return a + b + c }
fn add(a: i64, b: i64) -> i64 { return a + b }
fn pick(tag: string) -> fn(i64, i64) -> i64 { print(tag); return add }
fn withDefault(a: i64, b: i64 = 99) -> i64 { return a + b }

class Holder {
    base: i64
    constructor() { this.base = 10 }
    bump(n: i64) -> i64 {
        return this.base + n
    }
}

fn mkHolder(tag: string) -> Holder { print(tag); return Holder() }

fn main() {
    print("-- plain args --")
    print(three(t("a1", 1), t("a2", 2), t("a3", 3)))

    print("-- callee before args --")
    print(pick("callee")(t("a1", 1), t("a2", 2)))

    print("-- receiver before args --")
    print(mkHolder("receiver").bump(t("arg", 5)))

    print("-- nested call args --")
    print(three(t("a1", 1), add(t("n1", 2), t("n2", 3)), t("a3", 4)))

    print("-- default arg --")
    print(withDefault(t("explicit", 1)))
}

main()
