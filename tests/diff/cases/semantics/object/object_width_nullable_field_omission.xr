// anchor: object-width-nullable-omission
// A nullable Object field may be omitted; every other field must match exactly.
type Opt = { name: string, age: int? }

fn main() {
    var full: Opt = { name: "Ann", age: 30 }
    var partial: Opt = { name: "Bo" }
    print(full.name)
    print(full.age!)
    print(partial.name)
    print(partial.age == null)
}

main()
