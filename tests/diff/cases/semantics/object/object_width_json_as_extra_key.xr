// anchor: object-width-json-bridge
// Unknown JSON keys are ignored only when the boundary policy says so.
type Point = { x: i64, y: i64 }

fn main() {
    var p = JSON.parse<Point>(
        "{\"x\":1,\"y\":2,\"z\":3}",
        JSON.UnknownFields.Ignore
    )
    print(p.x)
    print(p.y)
}

main()
