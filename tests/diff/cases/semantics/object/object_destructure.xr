// anchor: object-destructure
// 181: pin Object destructure (direct field extraction) runtime semantics across
// VM/AOT: shorthand + rename bindings, retained nested values, function-return
// sources, non-consumption of the source, and destructure into existing bindings.

struct User {
    name: string
    age: i64
    tags: Array<string>
}

struct InnerValue {
    k: i64
}

struct OuterValue {
    id: i64
    inner: InnerValue
}

struct Point {
    x: i64
    y: i64
}

fn makePoint(a: i64, b: i64) -> Point {
    return Point{ x: a, y: b }
}

var point = makePoint(3, 4)
var x = point.x
var y = point.y
print(x)   // 3
print(y)   // 4

var user = User{ name: "Ada", age: 37, tags: ["a", "b"] }
var who = user.name
var age = user.age
var tags = user.tags
print(who)     // Ada
print(age)     // 37
print(tags[0]) // a
print(tags[1]) // b

// Source object is not consumed by destructure.
print(user.name) // Ada
print(user.age)  // 37

// Destructure into existing bindings.
var px = 0
var py = 0
var reassigned = makePoint(10, 20)
px = reassigned.x
py = reassigned.y
print(px)  // 10
print(py)  // 20

// Nested Object value is kept as-is, then its field is accessed.
var outer = OuterValue{ id: 1, inner: InnerValue{ k: 99 } }
var id = outer.id
var inner = outer.inner
print(id)      // 1
print(inner.k) // 99
