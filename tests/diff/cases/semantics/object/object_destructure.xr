// anchor: object-destructure
// 181: pin Object destructure (direct field extraction) runtime semantics across
// VM/AOT: shorthand + rename bindings, retained nested values, function-return
// sources, non-consumption of the source, and destructure into existing bindings.

type Point = { x: int, y: int }

fn makePoint(a: int, b: int) -> Point {
    return { x: a, y: b }
}

var { x, y } = makePoint(3, 4)
print(x)   // 3
print(y)   // 4

var user = { name: "Ada", age: 37, tags: ["a", "b"] }
var { name: who, age, tags } = user
print(who)     // Ada
print(age)     // 37
print(tags[0]) // a
print(tags[1]) // b

// Source object is not consumed by destructure.
print(user.name) // Ada
print(user.age)  // 37

// Destructure into existing bindings.
var px = 0
var py = 0
{ x: px, y: py } = makePoint(10, 20)
print(px)  // 10
print(py)  // 20

// Nested Object value is kept as-is, then its field is accessed.
var outer = { id: 1, inner: { k: 99 } }
var { id, inner } = outer
print(id)      // 1
print(inner.k) // 99
