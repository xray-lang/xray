// anchor: capturing-self-recursion
// diff-backends: vm,jit
// Self-recursive nested closures that read/mutate a captured upvalue across
// recursion levels.  The JIT self-call must leave jit_ctx->call_closure
// untouched so deeper frames resolve the same closure; routing a self-call
// through CALL_KNOWN/CALL_DIRECT (which overwrites call_closure) would lose
// the upvalues.  This is the closure half of the self-recursion fix.
// AOT excluded: a pre-existing AOT object-ABI gap aborts (SIGABRT) on
// capturing closures that mutate a captured container across recursion.
fn buildCount(n: int) -> int {
    let acc: Array<int> = []
    fn fill(k: int) {
        if (k <= 0) { return }
        acc.push(k * k)
        fill(k - 1)
    }
    fill(n)
    return acc.length
}

fn weighted(n: int) -> int {
    let base = 10
    fn rec(k: int) -> int {
        if (k <= 0) { return 0 }
        return base + rec(k - 1)
    }
    return rec(n)
}

print(buildCount(5))
print(weighted(4))
