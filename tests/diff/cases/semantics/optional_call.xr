// optional_call.xr
// VM/AOT differential coverage for func?.(args).

type IntFn = fn(i64) -> i64
type FloatFn = fn(f64) -> f64

var calls = 0

fn bump(x: i64) -> i64 {
    calls += 1
    return x + 1
}

fn half(x: f64) -> f64 {
    calls += 1
    return x / 2.0
}

fn arg_side_effect() -> i64 {
    calls += 100
    return 41
}

var active: IntFn? = bump
var missing: IntFn? = null
var promoted: FloatFn? = half

print(active?.(41))
print(calls)

print(missing?.(arg_side_effect()) ?? -1)
print(calls)

print(promoted?.(9) ?? 0.0)
print(calls)
