// range_inclusive.xr
// VM/AOT differential coverage for inclusive range `..=`.

var inc = 1..=3
print(inc)
print(len(inc))
print(inc.contains(3))
print(inc.contains(4))
print(inc[0])
print(inc[2])
print(inc.toArray())

var total = 0
for (i in 1..=3) {
    total = total + i
}
print(total)

var half_total = 0
for (i in 1..3) {
    half_total = half_total + i
}
print(half_total)

var max = 9223372036854775807
var min = -9223372036854775807 - 1
print((min..=max).count())

var boundary_count = 0
for (i in max..=max) {
    boundary_count = boundary_count + 1
    continue
}
print(boundary_count)

fn bucket(x: int) -> string {
    return match (x) {
        1..=3 -> "low"
        4..6 -> "mid"
        _ -> "other"
    }
}

print(bucket(3))
print(bucket(5))
print(bucket(6))
