import text
// anchor: string-surface-declared-methods
// Canonical string/rune/byte surface must behave identically on VM and AOT.

var s = "héllo"

// len(string) counts UTF-8 scalars; len(bytes()) counts raw bytes
print(len(s))
print(len(s.bytes()))

// Unicode scalar by explicit rune index
print(s.runes().nth(0).toUInt32())
print(s.runes().nth(1).toUInt32())

// Raw octet through the borrowed byte view
print(s.bytes()[0])

// Explicit rune conversion
print('é'.toUInt32())
print('x'.toUInt32())

// reverse: UTF-8 aware
print(text.reverseRunes("abc"))
print(text.reverseRunes("aé😀"))

// numeric parsing: null on failure
print(i64.tryParse("42"))
print(i64.tryParse(" -7 "))
print(i64.tryParse("x"))
print(f64.tryParse("3.5"))
print(f64.tryParse("nope"))

// emptiness / toString
print(len("") == 0)
print(len("a") == 0)
print("self".toString())

// Binary/text conversion is explicit and validates UTF-8.
var bin: Array<u8> = [104, 105]
print(string.fromUtf8(bin[:]))
var accented: Array<u8> = [104, 195, 169]
print(string.fromUtf8(accented[:]))
var invalid: Array<u8> = [255]
var caught_invalid_utf8 = false
var invalid_utf8_error = ""
try {
    string.fromUtf8(invalid[:])
} catch (e: Utf8Error) {
    caught_invalid_utf8 = true
    invalid_utf8_error = e.toString()
}
print(caught_invalid_utf8)
print(invalid_utf8_error)
print(string.fromUtf8Lossy(invalid[:]))
print(bin.toString())

// Static string constructors and canonical byte-boundary slicing.
print(string.fromRune('é'))
print(string.fromRune('🙂'))
print(string.join(["a", "β", "中"], "|"))
print(string.join(["a", "β", "中"]))

var sample = "Aé中"
print(sample.sliceBytes(0, 1))
print(sample.sliceBytes(1, 3))
print(sample.sliceBytes(3, 6))
var caught_mid_scalar = false
var mid_scalar_error = ""
try {
    sample.sliceBytes(2, 3)
} catch (e: StringSliceError) {
    caught_mid_scalar = true
    mid_scalar_error = e.toString()
}
print(caught_mid_scalar)
print(mid_scalar_error)

// non-U8 arrays keep the formatter rendering
var nums = [1, 2, 3]
print(nums.toString())
