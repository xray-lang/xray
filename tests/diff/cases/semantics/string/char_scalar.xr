// anchor: string-rune-scalar
var a: rune = 'A'
var digit: rune = '7'
var ws: rune = '\n'
var face: rune = '\u{1F600}'

print(a)
print(a.toString())
print(a.ord())
print(a.isLetter())
print(a.isNumber())
print(a.isAlphanumeric())
print(digit.isLetter())
print(digit.isNumber())
print(digit.isAlphanumeric())
print(ws.isWhitespace())
print(face)
print(face.ord())

var s = "aé😀z"
print(len(s))
print(s[0])
print(s[1])
print(s[2])
print(s[-1])

print("-- for value --")
for (ch in s) {
    print(ch)
    print(ch.ord())
}

print("-- for key value --")
for (i, ch in s) {
    print(i)
    print(ch)
}

var e = s.entries()
print(len(e))
print(e[1].0)
print(e[1].1)
