fn parseCase(label: string, text: string) {
    try {
        JSON.parseValue(text)
        print(label + ":unexpected")
    } catch panic (p) {
        print(label + ":" + p.message)
        print(p.code)
    }
}

parseCase("empty", "")
parseCase("syntax", "{broken")

var validNull = JSON.parseValue("null")
print(JSON.isNull(validNull))
