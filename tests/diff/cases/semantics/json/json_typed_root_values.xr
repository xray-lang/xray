// anchor: json-typed-root-values
// Task 260: JsonDecodable(T) applies to root scalars and containers, not only
// fields nested inside an exact structural object.

enum WireKind { Text, Binary }

var parsedInt: int = JSON.parse<int>("7")
var parsedBool: bool = JSON.parse<bool>("true")
var parsedString: string = JSON.parse<string>("\"ok\"")
var parsedArray: Array<int> = JSON.parse<Array<int>>("[1,2,3]")
var parsedMap: Map<string, Array<int>> =
    JSON.parse<Map<string, Array<int>>>("{\"odd\":[1,3],\"even\":[2,4]}")

print(parsedInt)
print(parsedBool)
print(parsedString)
print(len(parsedArray))
print(len(parsedMap))

var decodedInt = JSON.decode<int>(JSON.parseValue("9"))
var decodedArray = JSON.decode<Array<int>>(JSON.parseValue("[4,5]"))
var decodedMap = JSON.decode<Map<string, int>>(JSON.parseValue("{\"a\":1,\"b\":2}"))
print(decodedInt == null)
print(decodedInt!)
print(decodedArray == null)
print(len(decodedArray!))
print(decodedMap == null)
print(len(decodedMap!))
print(JSON.decode<Array<int>>(JSON.parseValue("[1,true]")) == null)
print(JSON.decode<Map<string, int>>(JSON.parseValue("{\"a\":false}")) == null)

var parsedKind: WireKind = JSON.parse<WireKind>("\"Binary\"")
var decodedKind = JSON.decode<WireKind>(JSON.parseValue("\"Binary\""))
var parsedKinds = JSON.parse<Array<WireKind>>("[\"Text\",\"Binary\"]")
var decodedKinds = JSON.decode<Map<string, WireKind>>(
    JSON.parseValue("{\"primary\":\"Binary\"}"))
print(parsedKind == WireKind.Binary)
print(decodedKind == null)
print(decodedKind! == WireKind.Binary)
print(decodedKinds == null)
print(decodedKinds!["primary"] == WireKind.Binary)
print(JSON.stringify(parsedKinds))
print(JSON.decode<WireKind>(JSON.parseValue("\"Missing\"")) == null)

try {
    var bad = JSON.parse<Array<int>>("[1,false]")
    print(len(bad))
} catch panic (p) {
    print(p.message)
    print(p.code)
}
