var user = { name: "Bob", scores: [10, 20], nested: { ok: true } }
var encoded = Json.encode(user)
print(typeof(encoded))
print(encoded.name)
print(encoded.scores[1])
print(encoded.nested.ok)

var m = #{ "a": 1, "b": { tag: "bee" } }
var jm = Json.encode(m)
print(typeof(jm))
print(jm.a)
print(jm.b.tag)

var im = #{ 7: { tag: "seven" } }
var jim = Json.encode(im)
print(jim["7"].tag)

var s: Set<int> = #[1, 2, 3]
var arr = Json.encode(s)
print(arr.length)
print(arr[0])
print(arr[2])
