struct TaggedValue {
    tag: string
}

struct NestedValue {
    ok: bool
}

struct User {
    name: string
    scores: Array<i64>
    nested: NestedValue
}

var user = User{ name: "Bob", scores: [10, 20], nested: NestedValue{ ok: true } }
var encoded = JSON.value(user)
print(typeName(encoded))
print(JSON.require<string>(encoded, ["name"]))
print(JSON.require<i64>(encoded, ["scores", 1]))
print(JSON.require<bool>(encoded, ["nested", "ok"]))

var m: JSON.Object = { "a": 1, "b": JSON.value(TaggedValue{tag: "bee"}) }
var jm = JSON.value(m)
print(typeName(jm))
print(JSON.require<i64>(jm, ["a"]))
print(JSON.require<string>(jm, ["b", "tag"]))

var im = { "7": TaggedValue{ tag: "seven" } }
var jim = JSON.value(im)
print(JSON.require<string>(jim, ["7", "tag"]))

var s: Set<i64> = Set([1, 2, 3])
var arr = JSON.asArray(JSON.value(s))!
print(len(arr))
print(arr[0])
print(arr[2])
