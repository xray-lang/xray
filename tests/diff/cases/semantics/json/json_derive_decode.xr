// Task 260: @derive(JSON) nominal targets are constructed from verified schemas.
// Class constructors are deliberately bypassed by both decode and direct typed parse.

@derive(JSON)
class User {
    name: string
    age: i64

    constructor(name: string, age: i64) {
        print("constructor-ran")
        this.name = name
        this.age = age
    }
}

@derive(JSON)
class Envelope {
    user: User
    tags: Array<string>
    scores: Map<string, i64>

    constructor(user: User, tags: Array<string>, scores: Map<string, i64>) {
        print("envelope-constructor-ran")
        this.user = user
        this.tags = tags
        this.scores = scores
    }
}

@derive(JSON)
struct Point {
    x: i64
    y: i64
}

@derive(JSON)
struct Box {
    point: Point
    label: string
}

enum WireState {
    Ready,
    Done
}

@derive(JSON)
class Packet {
    state: WireState
    note: string?

    constructor(state: WireState, note: string?) {
        print("packet-constructor-ran")
        this.state = state
        this.note = note
    }
}

var parsed: User = JSON.parse<User>("{\"name\":\"Ada\",\"age\":37}")
var parsedJson = JSON.value(parsed)
print(JSON.require<string>(parsedJson, ["name"]))
print(JSON.require<i64>(parsedJson, ["age"]))

var decoded = JSON.decode<User>(JSON.parseValue("{\"name\":\"Grace\",\"age\":42}"))
print(decoded == null)
var decodedJson = JSON.value(decoded!)
print(JSON.require<string>(decodedJson, ["name"]))
print(JSON.require<i64>(decodedJson, ["age"]))

var nested: Envelope = JSON.parse<Envelope>(
    "{\"user\":{\"name\":\"Lin\",\"age\":29},\"tags\":[\"compiler\",\"vm\"],\"scores\":{\"a\":9}}"
)
var nestedJson = JSON.value(nested)
print(JSON.require<string>(nestedJson, ["user", "name"]))
print(JSON.require<string>(nestedJson, ["tags", 1]))
print(JSON.require<i64>(nestedJson, ["scores", "a"]))

print(JSON.decode<User>(JSON.parseValue("{\"name\":\"bad\",\"age\":true}")) == null)

fn exerciseDerivedStructs() {
    var point: Point = JSON.parse<Point>("{\"x\":3,\"y\":4}")
    print(point.x)
    print(point.y)

    var box: Box = JSON.parse<Box>("{\"point\":{\"x\":8,\"y\":9},\"label\":\"nested\"}")
    print(box.point.x)
    print(box.label)
    var boxJson = JSON.value(box)
    print(JSON.require<i64>(boxJson, ["point", "x"]))
    print(JSON.require<string>(boxJson, ["label"]))
    print(JSON.stringify(box))

    var decodedBox = JSON.decode<Box>(
        JSON.parseValue("{\"point\":{\"x\":11,\"y\":12},\"label\":\"decoded\"}")
    )
    print(decodedBox == null)
    var presentBox = decodedBox!
    print(presentBox.point.y)
    print(presentBox.label)
    print(JSON.decode<Box>(JSON.parseValue("{\"point\":{\"x\":1},\"label\":\"bad\"}")) == null)

    var packet: Packet = JSON.parse<Packet>(
        "{\"state\":\"Ready\",\"note\":null}"
    )
    print(packet.state.toString())
    print(packet.note == null)
    var packetJson = JSON.value(packet)
    print(JSON.require<string>(packetJson, ["state"]))
    print(JSON.stringify(packet))
}

exerciseDerivedStructs()
