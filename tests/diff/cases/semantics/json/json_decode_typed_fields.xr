type User = { name: string, age: int, active: bool, score: float }

var valid = Json.decode<User>(
    Json.parse("{\"name\":\"Ada\",\"age\":37,\"active\":true,\"score\":9.5,\"extra\":1}"))
print(valid == null)
print(valid!.name)
print(valid!.age)
print(valid!.active)
print(valid!.score)

print(Json.decode<User>(
          Json.parse("{\"name\":1,\"age\":37,\"active\":true,\"score\":9.5}")) == null)
print(Json.decode<User>(
          Json.parse("{\"name\":\"Ada\",\"age\":37.0,\"active\":true,\"score\":9.5}")) ==
      null)
print(Json.decode<User>(
          Json.parse("{\"name\":\"Ada\",\"age\":37,\"active\":1,\"score\":9.5}")) == null)
print(Json.decode<User>(
          Json.parse("{\"name\":\"Ada\",\"age\":37,\"active\":true,\"score\":9}")) == null)

type Payload = { payload: Json }
var payload = Json.decode<Payload>(Json.parse("{\"payload\":null}"))
print(payload == null)
print(payload!.payload == null)
