type User = { name: string, age: i64, active: bool, score: f64 }

var valid = JSON.decode<User>(
    JSON.parseValue("{\"name\":\"Ada\",\"age\":37,\"active\":true,\"score\":9.5,\"extra\":1}"),
    JSON.UnknownFields.Ignore)
print(valid == null)
print(valid!.name)
print(valid!.age)
print(valid!.active)
print(valid!.score)

print(JSON.decode<User>(
          JSON.parseValue("{\"name\":1,\"age\":37,\"active\":true,\"score\":9.5}")) == null)
print(JSON.decode<User>(
          JSON.parseValue("{\"name\":\"Ada\",\"age\":37.0,\"active\":true,\"score\":9.5}")) ==
      null)
print(JSON.decode<User>(
          JSON.parseValue("{\"name\":\"Ada\",\"age\":37,\"active\":1,\"score\":9.5}")) == null)
print(JSON.decode<User>(
          JSON.parseValue("{\"name\":\"Ada\",\"age\":37,\"active\":true,\"score\":9}")) == null)

type Payload = { payload: JSON.Value }
var payload = JSON.decode<Payload>(JSON.parseValue("{\"payload\":null}"))
print(payload == null)
print(payload!.payload == null)

type Items = { items: Array<JSON.Value> }
var items = JSON.decode<Items>(JSON.parseValue("{\"items\":[1,true,null,{\"x\":2}]}"))
print(items == null)
print(len(items!.items))
print(JSON.decode<Items>(JSON.parseValue("{\"items\":1}")) == null)
