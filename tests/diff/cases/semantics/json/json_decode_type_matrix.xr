// anchor: json-decode-type-matrix
// 177: pin the Json.decode<T> typed-field validation matrix across VM/AOT.
// Covers per-field kind mismatch, missing required fields, extra-field tolerance,
// null vs non-nullable, nested object validation, Array<Json> shape, and the
// permissive Json field. Any backend whose decode validation drifts (accepts a
// wrong kind, over-rejects, or diverges VM vs AOT) fails here.

type Scalars = { i: int, f: float, s: string, b: bool }
type Nested = { id: int, inner: Scalars }
type Items = { items: Array<Json> }
type Opt = { name: string, note: string? }
type AnyF = { v: Json }

fn p(text: string) -> Json {
    return Json.parse(text)
}

// All-correct scalar decode keeps every field value.
var ok = Json.decode<Scalars>(p("{\"i\":1,\"f\":2.5,\"s\":\"hi\",\"b\":true}"))
print(ok == null)   // false
print(ok!.i)        // 1
print(ok!.f)        // 2.5
print(ok!.s)        // hi
print(ok!.b)        // true

// Extra input field is ignored, decode still succeeds.
print(Json.decode<Scalars>(p("{\"i\":1,\"f\":2.5,\"s\":\"hi\",\"b\":true,\"x\":9}")) == null)  // false

// Per-field kind mismatches all reject (int/float are strictly distinct).
print(Json.decode<Scalars>(p("{\"i\":1.5,\"f\":2.5,\"s\":\"hi\",\"b\":true}")) == null)  // true
print(Json.decode<Scalars>(p("{\"i\":1,\"f\":2,\"s\":\"hi\",\"b\":true}")) == null)      // true
print(Json.decode<Scalars>(p("{\"i\":1,\"f\":2.5,\"s\":3,\"b\":true}")) == null)         // true
print(Json.decode<Scalars>(p("{\"i\":1,\"f\":2.5,\"s\":\"hi\",\"b\":1}")) == null)       // true
print(Json.decode<Scalars>(p("{\"i\":true,\"f\":2.5,\"s\":\"hi\",\"b\":true}")) == null) // true

// Missing required field rejects; null for a non-nullable field rejects.
print(Json.decode<Scalars>(p("{\"i\":1,\"f\":2.5,\"s\":\"hi\"}")) == null)               // true
print(Json.decode<Scalars>(p("{\"i\":null,\"f\":2.5,\"s\":\"hi\",\"b\":true}")) == null) // true

// Nested object validated recursively.
var nok = Json.decode<Nested>(p("{\"id\":7,\"inner\":{\"i\":1,\"f\":2.5,\"s\":\"hi\",\"b\":true}}"))
print(nok == null)   // false
print(nok!.inner.i)  // 1
print(Json.decode<Nested>(p("{\"id\":7,\"inner\":{\"i\":1,\"f\":2.5,\"s\":\"hi\"}}")) == null)  // true
print(Json.decode<Nested>(p("{\"id\":7,\"inner\":42}")) == null)                                // true

// Array<Json> accepts any array, rejects non-arrays.
var it = Json.decode<Items>(p("{\"items\":[1,\"a\",null,{\"k\":2}]}"))
print(it == null)     // false
print(len(it!.items)) // 4
print(Json.decode<Items>(p("{\"items\":5}")) == null)  // true

// Nullable field must be present (may be null); missing rejects.
print(Json.decode<Opt>(p("{\"name\":\"x\",\"note\":null}")) == null)  // false
print(Json.decode<Opt>(p("{\"name\":\"x\",\"note\":\"n\"}")) == null)  // false
print(Json.decode<Opt>(p("{\"name\":\"x\"}")) == null)                 // true

// A Json field accepts scalars, arrays, objects, and null.
print(Json.decode<AnyF>(p("{\"v\":null}")) == null)     // false
print(Json.decode<AnyF>(p("{\"v\":[1,2]}")) == null)    // false
print(Json.decode<AnyF>(p("{\"v\":{\"a\":1}}")) == null)// false
print(Json.decode<AnyF>(p("{\"v\":true}")) == null)     // false
