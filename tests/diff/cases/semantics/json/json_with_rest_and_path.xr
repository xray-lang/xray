type Profile = { name: string, age: i64?, nested: { id: i64 }? }

var parts = JSON.parseWithRest<Profile>(
    "{\"name\":\"ada\",\"extra\":7,\"nested\":{\"id\":1,\"ignored\":true}}",
    JSON.UnknownFields.Ignore
)
print(parts.value.name)
print(JSON.stringify(parts.rest))
print(JSON.stringify(JSON.merge(parts)))

var root = JSON.parseValue("{\"user\":{\"profile\":{\"name\":\"ada\"}}}")
var path: JSON.Path = ["user", "profile", "name"]
print(JSON.require<string>(root, path))
print(JSON.containsPath(root, path))
JSON.set(root, path, "bob")
print(JSON.require<string>(root, path))
print(JSON.remove(root, path))
print(JSON.containsPath(root, path))

var nullableRoot = JSON.parseValue("{\"value\":null,\"wrong\":\"x\"}")
var nullableValue: i64? = JSON.require<i64?>(nullableRoot, ["value"])
print(nullableValue == null)
try {
    JSON.require<i64?>(nullableRoot, ["wrong"])
    print("bad-nullable-require")
} catch panic(e) {
    print("caught-nullable-require")
}

var profileRoot = JSON.parseValue("{\"name\":\"lin\"}")
var profile = JSON.get<Profile>(profileRoot, [])
print(profile!.name)
print(JSON.get<i64>(profileRoot, []) == null)
