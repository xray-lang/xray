type Address = { city: string, zip: i64 }
type Profile = { name: string, address: Address? }

var present = JSON.decode<Profile>(
    JSON.parseValue("{\"name\":\"Dana\",\"address\":{\"city\":\"Hangzhou\",\"zip\":310000}}"))
print(present == null)
print(present!.address == null)
print(present!.address!.city)
print(present!.address!.zip)

var nullable = JSON.decode<Profile>(JSON.parseValue("{\"name\":\"Dana\",\"address\":null}"))
print(nullable == null)
print(nullable!.address == null)

print(JSON.decode<Profile>(JSON.parseValue("{\"name\":\"Dana\"}")) == null)
print(JSON.decode<Profile>(JSON.parseValue("{\"name\":\"Dana\",\"address\":42}")) == null)
print(JSON.decode<Profile>(
          JSON.parseValue("{\"name\":\"Dana\",\"address\":{\"city\":\"Hangzhou\",\"zip\":\"bad\"}}")) ==
      null)
