// anchor: object-json-codec-bridge
// 181/177: pin the Object <-> JSON.Value codec bridge across VM/AOT. A Object encodes
// to a shaped JSON.Value through its field table, decodes back through the same bridge
// shape, and survives a full roundtrip including a nested Object.

type Address = { city: string, zip: i64 }
type User = { name: string, age: i64, address: Address }

var user: User = { name: "Ada", age: 37, address: { city: "Hangzhou", zip: 310000 } }

// Object -> JSON.Value field-table encode is observable as a shaped JSON.
var encoded = JSON.value(user)
print(JSON.require<string>(encoded, ["name"]))             // Ada
print(JSON.require<i64>(encoded, ["age"]))                 // 37
print(JSON.require<string>(encoded, ["address", "city"])) // Hangzhou
print(JSON.require<i64>(encoded, ["address", "zip"]))     // 310000

// JSON.Value -> Object decode consumes the same bridge shape.
var decoded = JSON.decode<User>(encoded)
print(decoded == null)       // false
print(decoded!.name)         // Ada
print(decoded!.age)          // 37
print(decoded!.address.city) // Hangzhou
print(decoded!.address.zip)  // 310000

// Full roundtrip re-encode is stable and printable.
print(JSON.stringify(JSON.value(decoded!)))
