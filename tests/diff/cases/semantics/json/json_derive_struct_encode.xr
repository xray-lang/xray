// @derive(JSON) value structs must encode their field values on both
// backends. The VM encoder once read the tagged ownership slots instead of
// the native body, producing all-null values silently.
@derive(JSON)
struct S {
    i: i64
    f: f64
    b: bool
    s: string
}

@derive(JSON)
struct Inner { v: i64 }

@derive(JSON)
struct Outer {
    a: i64
    inner: Inner
}

fn main() {
    print(JSON.stringify(JSON.value(S{i: 42, f: 1.5, b: true, s: "hi"})))
    print(JSON.stringify(JSON.value(Outer{a: 7, inner: Inner{v: 9}})))
    print(JSON.stringify(JSON.value([Inner{v: 1}, Inner{v: 2}])))
}
main()
