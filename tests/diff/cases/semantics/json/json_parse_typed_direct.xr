// Task 260: JSON.parse<T> constructs the exact target directly from tokens.
type Geo = { lat: float, verified: bool }
type Address = { city: string, geo: Geo }
type Item = { id: int, label: string }
type Profile = {
    name: string,
    age: int,
    address: Address,
    tags: Array<JSON.Value>,
    ids: Array<int>,
    items: Array<Item>,
    scores: Map<string, int>,
    buckets: Map<string, Array<int>>
}

var profile: Profile = JSON.parse<Profile>(
    "{\"ignored\":{\"deep\":[1,2,3]},\"buckets\":{\"odd\":[1,3],\"even\":[2,4]},\"scores\":{\"ada\":9},\"items\":[{\"label\":\"a\",\"id\":7}],\"ids\":[4,5,6],\"tags\":[\"ops\",3,null],\"address\":{\"geo\":{\"verified\":true,\"lat\":30.25},\"city\":\"Hangzhou\"},\"age\":37,\"name\":\"Ada\"}"
, JSON.UnknownFields.Ignore)

print(profile.name)
print(profile.age)
print(profile.address.city)
print(profile.address.geo.lat)
print(profile.address.geo.verified)
print(len(profile.tags))
print(len(profile.ids))
print(len(profile.items))
print(len(profile.scores))
print(len(profile.buckets))
