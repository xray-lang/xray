// generic_type_alias.xr
// VM/AOT differential coverage for generic type aliases.

type Pair<T> = { first: T, second: T }
type Mapper<T, U> = (T) -> U
type Vec<T> = Array<T>
type Forward<T> = Box<T>
type Box<T> = { value: T }

fn apply(f: Mapper<int, string>, value: int) -> string {
    return f(value)
}

let p: Pair<int> = { first: 11, second: 31 }
let words: Vec<string> = ["x", "ray"]
let box: Forward<float> = { value: 3.5 }

print(p.first + p.second)
print(words[0] + words[1])
print(apply((n) -> "n=" + string(n), 7))
print(box.value)
