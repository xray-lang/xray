// generic_type_alias.xr
// VM/AOT differential coverage for generic type aliases.

type Pair<T> = { first: T, second: T }
type Mapper<T, U> = fn(T) -> U
type Vec<T> = Array<T>
type Forward<T> = Box<T>
type Box<T> = { value: T }

fn apply(f: Mapper<i64, string>, value: i64) -> string {
    return f(value)
}

var p: Pair<i64> = { first: 11, second: 31 }
var words: Vec<string> = ["x", "ray"]
var box: Forward<f64> = { value: 3.5 }

print(p.first + p.second)
print(words[0] + words[1])
print(apply((n) -> "n=" + string(n), 7))
print(box.value)
