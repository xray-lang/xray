// anchor: parenthesized-function-type
// Task 264 D7. In type position a parenthesised single type is read as a
// 1-tuple, so `(() -> int)` is `(fn(): int,)`. The expression side already has
// the right rule -- a comma makes a tuple, otherwise the parens group -- and
// spec 2.7 states it; only the type side is missing it.
//
// The nullable case is why this matters beyond the spec 7.2 example: without
// grouping there is no way to spell a nullable function type except through an
// alias, because `() -> int?` parses as a function returning `int?`.
fn makeCounter() -> (() -> int) {
    var count = 0
    return fn() -> int { count = count + 1
                         return count }
}

fn takesParen(f: ((int) -> int)) -> int { return f(1) }

fn main() {
    var c = makeCounter()
    print(c())                        // 1
    print(takesParen(x -> x + 41))    // 42

    var nf: (() -> int)? = null
    print(nf == null)                 // true
    nf = c
    print(nf!())                      // 2
}

main()
