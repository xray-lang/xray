// Enum user methods lower to direct calls in both VM and AOT.
// Covers static factory/helper methods, instance methods, typed enum values,
// chained calls, and a function declared before the enum.

fn forwardLabel() -> string {
    return Color.describe(Color.Green)
}

enum Color {
    Red,
    Green,
    Blue

    static fromInt(v: i64) -> Color {
        if (v == 1) {
            return Color.Red
        }
        if (v == 2) {
            return Color.Green
        }
        return Color.Blue
    }

    static describe(c: Color) -> string {
        return c.label()
    }

    label() -> string {
        return this.name
    }
}

enum Code {
    Ok,
    Err

    static ok() -> Code {
        return Code.Ok
    }

    code() -> i64 {
        return match (this) {
            Code.Ok -> 200,
            Code.Err -> 500
        }
    }
}

var c: Color = Color.fromInt(2)
print(c.label())
print(Color.describe(Color.Blue))
print(forwardLabel())
print(Code.ok().code())
