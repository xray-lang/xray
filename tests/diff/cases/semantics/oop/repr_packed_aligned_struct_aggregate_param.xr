import mem

packed struct PackedPair {
    tag: byte
    value: u32
}

struct AlignedWord align(16) {
    value: i32
}

packed struct PackedAligned align(16) {
    tag: byte
    value: u32
}

fn sum_packed(p: PackedPair) -> i32 {
    return (p.tag as i32) + (p.value as i32)
}

fn make_packed(tag: byte, value: u32) -> PackedPair {
    return PackedPair{tag: tag, value: value}
}

fn read_aligned(p: AlignedWord) -> i32 {
    return p.value
}

fn make_aligned(value: i32) -> AlignedWord {
    return AlignedWord{value: value}
}

fn sum_packed_aligned(p: PackedAligned) -> i32 {
    return (p.tag as i32) + (p.value as i32)
}

fn make_packed_aligned(tag: byte, value: u32) -> PackedAligned {
    return PackedAligned{tag: tag, value: value}
}

var packedPair = make_packed(5, 37)
var aligned = make_aligned(42)
var packed_aligned = make_packed_aligned(6, 36)

print(sum_packed(packedPair))
print(read_aligned(aligned))
print(sum_packed_aligned(packed_aligned))
print(mem.sizeOf<PackedPair>())
print(mem.alignOf<PackedPair>())
print(mem.offsetOf<PackedPair>("value"))
print(mem.sizeOf<AlignedWord>())
print(mem.alignOf<AlignedWord>())
print(mem.sizeOf<PackedAligned>())
print(mem.alignOf<PackedAligned>())
print(mem.offsetOf<PackedAligned>("value"))
