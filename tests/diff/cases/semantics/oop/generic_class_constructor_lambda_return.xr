class Box<T> {
    values: Array<T>

    constructor(init: fn(i64) -> T) {
        var states: Array<T> = []
        for (lane in 0..3) {
            states.push(init(lane))
        }
        this.values = states
    }

    get(i: i64) -> T {
        return this.values[i]
    }
}

var seen: Array<i64> = []
var box = Box<i64>((lane) -> {
    seen.push(lane)
    return 100 + lane
})

print(len(seen))
print(seen[0])
print(seen[2])
print(box.get(0))
print(box.get(2))
