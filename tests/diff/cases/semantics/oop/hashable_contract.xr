// anchor: hashable-contract

class Token implements Hashable {
    value: int

    constructor(value: int) {
        this.value = value
    }

    operator==(other: Token) -> bool {
        return this.value == other.value
    }

    hash() -> int {
        return this.value
    }
}

fn passHashable<T: Hashable>(value: move T) -> T {
    return value
}

var token = Token(7)
var values: Map<Token, int> = #{}
values.set(token, 99)
print(values.containsKey(token))
print(values[token])
if (values.containsKey(token)) {
    print(values.get(token))
}

var seen: Set<Token> = #[]
seen.add(token)
print(seen.contains(token))
print(passHashable(move token).value)
