struct Inner {
    x: int32
}

struct Outer {
    inner: Inner
    y: int32
}

struct Buf {
    data: [byte; 4]
    bias: int32
}

fn sum_outer(p: Outer) -> int32 {
    return p.inner.x + p.y
}

fn grow_outer(p: Outer) -> Outer {
    return Outer{inner: Inner{x: p.inner.x + 1}, y: p.y + 2}
}

fn sum_buf(p: Buf) -> int32 {
    return p.data[0] as int32 + p.data[1] as int32 + p.bias
}

fn pick_buf(p: Buf, i: int) -> int32 {
    return p.data[i] as int32 + p.bias
}

fn patch_buf(p: Buf) -> int32 {
    p.data[1] = 9
    return p.data[0] as int32 + p.data[1] as int32 + p.bias
}

var outer = Outer{inner: Inner{x: 35}, y: 7}
var grown = grow_outer(outer)
var buf = Buf{data: [10, 20, 30, 40], bias: 7}

print(sum_outer(outer))
print(sum_outer(grown))
print(sum_buf(buf))
print(pick_buf(buf, 2))
print(patch_buf(buf))
