// Static method dispatch through AOT: a static factory returns a new instance,
// a static method takes arguments, and a static method calls another static.
// VM and AOT must agree byte-for-byte.
class Vec {
    x: i64
    y: i64
    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }
    static origin() -> Vec {
        return Vec(0, 0)
    }
    static of(x: i64, y: i64) -> Vec {
        return Vec(x, y)
    }
    static diagonal(n: i64) -> Vec {
        return Vec.of(n, n)
    }
    sum() -> i64 {
        return this.x + this.y
    }
}

print(Vec.origin().sum())
print(Vec.of(3, 4).sum())
print(Vec.diagonal(5).sum())
