// anchor: enum-value-aot-identity

enum Color {
    Red,
    Green,
    Blue,
}

enum Direction {
    North,
    East

    fn symbol() -> string {
        return match (this) {
            Direction.North -> "N",
            Direction.East -> "E"
        }
    }
}

enum HttpStatus {
    OK,
    NotFound

    fn code() -> i64 {
        return match (this) {
            HttpStatus.OK -> 200,
            HttpStatus.NotFound -> 404
        }
    }
}

var colors = [Color.Red, Color.Green, Color.Blue]
print(colors.join("|"))

print(Color.Red.name)
print(Color.Green.ordinal)
print(Color.Blue.ordinal)
print(Color.Red.toString())

var middle = Color.Green
print(middle == Color.Green)
print(middle.name + ":" + string(middle.ordinal))

print(Direction.North.symbol())
print(Direction.North.toString())
print(HttpStatus.NotFound.code())
