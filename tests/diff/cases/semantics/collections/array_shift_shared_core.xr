var ints: Array<i64> = [1, 2, 3, 4]
print(ints.shift())
for (v in ints) {
    print(v)
}

var flags: Array<bool> = [true, false, true, false]
print(flags.shift())
for (flag in flags) {
    print(flag)
}

var words: Array<string> = ["left", "middle", "right"]
print(words.shift())
for (w in words) {
    print(w)
}

var bytes = Array<u8>(4)
bytes[0] = 10
bytes[1] = 20
bytes[2] = 30
bytes[3] = 40
print(bytes.shift())
for (b in bytes) {
    print(b)
}
