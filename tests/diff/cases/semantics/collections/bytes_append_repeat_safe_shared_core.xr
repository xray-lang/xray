var src = Array<byte>(0)
src.push(65)
src.push(66)
src.push(67)
src.push(68)
src.push(69)

var out = Array<byte>(0)
out.appendFrom(src[1:4])
print(len(out))
print(out.toString())

out.repeatFrom(3, 6)
print(len(out))
print(out.toString())

var alias = Array<byte>(0)
alias.push(88)
alias.push(89)
alias.appendFrom(alias[0:2])
print(len(alias))
print(alias.toString())

try {
    out.repeatFrom(0, 1)
} catch panic (p: PanicInfo) {
    print(p.code)
    print(p.message.contains("range/grow"))
}
