fn keepBytes(bytes: Bytes) -> ByteView {
    var view: ByteView = bytes[1:4]
    return view
}

fn keepInts(values: Array<int>) -> View<int> {
    var view: View<int> = values[1:3]
    return view
}

var bytes = Bytes(0)
bytes.push(1)
bytes.push(2)
bytes.push(3)
bytes.push(4)

var bv: ByteView = bytes[1:4]
print(bv.length)
print(bv[0])
bv[1] = 8
print(bytes[2])
bytes.push(9)
print(bv.length)
print(bv[1])

var keptBytes = keepBytes(bytes)
print(keptBytes.length)
print(keptBytes[0])

var owned: Bytes = copy(bv)
print(owned.length)
print(owned[1])

var values: Array<int> = [10, 20, 30, 40]
var iv: View<int> = values[1:3]
print(iv.length)
print(iv[0])
iv[1] = 300
print(values[2])
values.push(50)
print(iv.length)
print(iv[1])

var keptInts = keepInts(values)
print(keptInts.length)
print(keptInts[1])

var total = 0
for (x in iv) {
    total += x
}
print(total)
