// anchor: bytespan-bulk-ops-shared-core
let dst = Bytes(8)
let src = Bytes(4)

let dstView: ByteSpan = dst[:]
let srcView: ByteSpan = src[:]

dstView.fill(1)
srcView.fill(7)
srcView.store<uint16>(1, 0x0908, Endian.LE)

let copiedWindow: ByteSpan = dstView[2:6]
let copied: ByteSpan = copiedWindow.copyFrom(srcView)
print(dst[0])
print(dst[1])
print(dst[2])
print(dst[3])
print(dst[4])
print(dst[5])
print(dst[6])
print(dst[7])
print(copied.length)

let dstMid: ByteSpan = dstView[2:6]
let dstHead: ByteSpan = dstView[0:4]
print(dstMid.compare(srcView))
print(dstHead.compare(srcView))
print(srcView.compare(dstHead))

let prefix: ByteSpan = dstView[2:5]
print(prefix.compare(srcView))
print(srcView.compare(prefix))

let dstPrefixFull: ByteSpan = dstView[2:6]
let dstPrefixShort: ByteSpan = dstView[2:5]
let dstEmpty: ByteSpan = dstView[0:0]
print(dstPrefixFull.commonPrefix(srcView))
print(dstPrefixShort.commonPrefix(srcView))
print(dstHead.commonPrefix(srcView))
print(dstEmpty.commonPrefix(srcView))

let rep = Bytes(10)
let repView: ByteSpan = rep[:]
repView.store<uint16>(0, 0x4241, Endian.LE)
repView.repeatFrom(2, 2, 6)
print(rep[0])
print(rep[1])
print(rep[2])
print(rep[3])
print(rep[4])
print(rep[5])
print(rep[6])
print(rep[7])
