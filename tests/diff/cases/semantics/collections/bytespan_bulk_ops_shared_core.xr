// anchor: bytespan-bulk-ops-shared-core
fn main() {
    var dst = Array<byte>(8)
    var src = Array<byte>(4)
    var dstView: Slice<byte> = dst[:]
    var srcView: Slice<byte> = src[:]
    dstView.fill(1)
    srcView.fill(7)
    srcView.store<uint16>(1, 2312, Endian.LE)
    var copiedWindow: Slice<byte> = dstView[2:6]
    var copied: Slice<byte> = copiedWindow.copyFrom(srcView)
    print(dst[0])
    print(dst[1])
    print(dst[2])
    print(dst[3])
    print(dst[4])
    print(dst[5])
    print(dst[6])
    print(dst[7])
    print(len(copied))
    var dstMid: Slice<byte> = dstView[2:6]
    var dstHead: Slice<byte> = dstView[0:4]
    print(dstMid.compare(srcView))
    print(dstHead.compare(srcView))
    print(srcView.compare(dstHead))
    var prefix: Slice<byte> = dstView[2:5]
    print(prefix.compare(srcView))
    print(srcView.compare(prefix))
    var dstPrefixFull: Slice<byte> = dstView[2:6]
    var dstPrefixShort: Slice<byte> = dstView[2:5]
    var dstEmpty: Slice<byte> = dstView[0:0]
    print(dstPrefixFull.commonPrefix(srcView))
    print(dstPrefixShort.commonPrefix(srcView))
    print(dstHead.commonPrefix(srcView))
    print(dstEmpty.commonPrefix(srcView))
    var rep = Array<byte>(10)
    var repView: Slice<byte> = rep[:]
    repView.store<uint16>(0, 16961, Endian.LE)
    repView.repeatFrom(2, 2, 6)
    print(rep[0])
    print(rep[1])
    print(rep[2])
    print(rep[3])
    print(rep[4])
    print(rep[5])
    print(rep[6])
    print(rep[7])
}

main()
