// anchor: bytespan-bulk-ops-shared-core
let dst = Bytes(8)
let src = Bytes(4)

let dstView: ByteSpan = dst
let srcView: ByteSpan = src

dstView.fill(1)
srcView.fill(7)
srcView.store<uint16>(1, 0x0908, Endian.LE)

let copied: ByteSpan = dstView[2:6].copyFrom(srcView)
print(dst[0])
print(dst[1])
print(dst[2])
print(dst[3])
print(dst[4])
print(dst[5])
print(dst[6])
print(dst[7])
print(copied.length)

print(dstView[2:6].compare(srcView))
print(dstView[0:4].compare(srcView))
print(srcView.compare(dstView[0:4]))

let prefix: ByteSpan = dstView[2:5]
print(prefix.compare(srcView))
print(srcView.compare(prefix))

print(dstView[2:6].commonPrefix(srcView))
print(dstView[2:5].commonPrefix(srcView))
print(dstView[0:4].commonPrefix(srcView))
print(dstView[0:0].commonPrefix(srcView))

let rep = Bytes(10)
let repView: ByteSpan = rep
repView.store<uint16>(0, 0x4241, Endian.LE)
repView.repeatFrom(2, 2, 6)
print(rep[0])
print(rep[1])
print(rep[2])
print(rep[3])
print(rep[4])
print(rep[5])
print(rep[6])
print(rep[7])
