fn branchAfterLastUse(flag: bool) {
    var bytes = Array<byte>(0)
    bytes.push(1)
    var view: Slice<byte> = bytes[:]
    if (flag) {
        print(len(view))
        bytes.push(2)
        print(len(bytes))
    } else {
        bytes.push(3)
        print(len(bytes))
    }
    print(len(bytes))
}

branchAfterLastUse(true)
branchAfterLastUse(false)
