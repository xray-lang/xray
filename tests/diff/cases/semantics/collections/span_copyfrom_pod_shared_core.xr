// anchor: span-copyfrom-pod-shared-core
fn main() {
    var dst = Array<u32>(4, 0)
    var src = Array<u32>(2, 0)
    src[0] = 17
    src[1] = 42
    var dstSlice: Slice<u32> = dst[:]
    var srcSlice: Slice<u32> = src[:]
    var dstWindow: Slice<u32> = dstSlice[1:3]
    var copied: Slice<u32> = dstWindow.copyFrom(srcSlice)
    print(int(dst[0]))
    print(int(dst[1]))
    print(int(dst[2]))
    print(int(dst[3]))
    print(len(copied))
    var overlap = Array<u16>(4, 0)
    overlap[0] = 1
    overlap[1] = 2
    overlap[2] = 3
    overlap[3] = 4
    var overlapSlice: Slice<u16> = overlap[:]
    var overlapDst: Slice<u16> = overlapSlice[1:4]
    var overlapSrc: Slice<u16> = overlapSlice[0:3]
    overlapDst.copyFrom(overlapSrc)
    print(int(overlap[0]))
    print(int(overlap[1]))
    print(int(overlap[2]))
    print(int(overlap[3]))
    try {
        var tooSmall: Slice<u32> = dstSlice[0:1]
        tooSmall.copyFrom(srcSlice)
        print(999)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

main()
