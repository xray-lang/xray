// anchor: span-copyfrom-pod-shared-core
var dst = Array<uint32>(4, 0)
var src = Array<uint32>(2, 0)
src[0] = 17
src[1] = 42

var dstSpan: Span<uint32> = dst[:]
var srcSpan: Span<uint32> = src[:]
var dstWindow: Span<uint32> = dstSpan[1:3]
var copied: Span<uint32> = dstWindow.copyFrom(srcSpan)

print(int(dst[0]))
print(int(dst[1]))
print(int(dst[2]))
print(int(dst[3]))
print(copied.length)

var overlap = Array<uint16>(4, 0)
overlap[0] = 1
overlap[1] = 2
overlap[2] = 3
overlap[3] = 4
var overlapSpan: Span<uint16> = overlap[:]
var overlapDst: Span<uint16> = overlapSpan[1:4]
var overlapSrc: Span<uint16> = overlapSpan[0:3]
overlapDst.copyFrom(overlapSrc)
print(int(overlap[0]))
print(int(overlap[1]))
print(int(overlap[2]))
print(int(overlap[3]))

try {
    var tooSmall: Span<uint32> = dstSpan[0:1]
    tooSmall.copyFrom(srcSpan)
    print(999)
} catch panic (p) {
    print(p.message)
    print(p.code)
}
