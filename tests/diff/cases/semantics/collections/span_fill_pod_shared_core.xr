// anchor: span-fill-pod-shared-core
let words = Array<uint32>(4, 0)
let wordSpan: Span<uint32> = words[:]
let wordWindow: Span<uint32> = wordSpan[1:3]
let filledWords: Span<uint32> = wordWindow.fill(9)
print(filledWords.length)
print(int(words[0]))
print(int(words[1]))
print(int(words[2]))
print(int(words[3]))

let flags = Array<bool>(3, false)
let flagSpan: Span<bool> = flags[:]
flagSpan.fill(true)
print(flags[0])
print(flags[1])
print(flags[2])

let chars = Array<char>(3, 'a')
let charSpan: Span<char> = chars[:]
charSpan.fill('z')
print(chars[0].toString() + chars[1].toString() + chars[2].toString())

let zeros = Array<uint16>(3, 7)
let zeroSpan: Span<uint16> = zeros[:]
zeroSpan.fill(0)
print(int(zeros[0]) + int(zeros[1]) + int(zeros[2]))
