// anchor: span-fill-pod-shared-core
fn main() {
    var words = Array<u32>(4, 0)
    var wordSlice: Slice<u32> = words[:]
    var wordWindow: Slice<u32> = wordSlice[1:3]
    var filledWords: Slice<u32> = wordWindow.fill(9)
    print(len(filledWords))
    print((words[0] as i64))
    print((words[1] as i64))
    print((words[2] as i64))
    print((words[3] as i64))
    var flags = Array<bool>(3, false)
    var flagSlice: Slice<bool> = flags[:]
    flagSlice.fill(true)
    print(flags[0])
    print(flags[1])
    print(flags[2])
    var chars = Array<rune>(3, 'a')
    var charSlice: Slice<rune> = chars[:]
    charSlice.fill('z')
    print(chars[0].toString() + chars[1].toString() + chars[2].toString())
    var zeros = Array<u16>(3, 7)
    var zeroSlice: Slice<u16> = zeros[:]
    zeroSlice.fill(0)
    print((zeros[0] as i64) + (zeros[1] as i64) + (zeros[2] as i64))
}

main()
