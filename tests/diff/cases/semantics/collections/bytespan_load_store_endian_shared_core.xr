// anchor: bytespan-load-store-endian-shared-core
let bytes = Bytes(12)
let view: ByteSpan = bytes

view.store<uint16>(0, 0x1234, Endian.LE)
view.store<uint16>(2, 0x1234, Endian.BE)
view.store<uint32>(4, 0x01020304, Endian.BE)
view.store<uint16>(8, 0x0a09)

print(bytes[0])
print(bytes[1])
print(bytes[2])
print(bytes[3])
print(bytes[4])
print(bytes[7])
print(int(view.load<uint16>(0, Endian.LE)))
print(int(view.load<uint16>(2, Endian.BE)))
print(int(view.load<uint32>(4, Endian.BE)))
print(int(view.load<uint16>(8)))
