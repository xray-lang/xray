// anchor: byte-slice-signed-load-store-shared-core
fn main() {
    var bytes = Array<u8>(24)
    var view: Slice<u8> = bytes[:]
    view.store<i16>(0, -2, Endian.LE)
    view.store<i16>(2, -3, Endian.BE)
    view.store<i32>(4, -12345678, Endian.LE)
    view.store<i32>(8, -16909060, Endian.BE)
    view.store<i64>(16, -1, Endian.LE)
    print(bytes[0])
    print(bytes[1])
    print(bytes[2])
    print(bytes[3])
    print((view.load<i16>(0, Endian.LE) as i64))
    print((view.load<i16>(2, Endian.BE) as i64))
    print((view.load<i32>(4, Endian.LE) as i64))
    print((view.load<i32>(8, Endian.BE) as i64))
    print((view.load<i64>(16, Endian.LE) as i64))
    print((view.load<u16>(0, Endian.LE) as i64))
}

main()
