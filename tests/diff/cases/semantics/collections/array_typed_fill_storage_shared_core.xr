let ints = Array<int>(5, 1)
print(ints.length)
print(ints[0])
print(ints[4])
ints.fill(7, 1, 4)
print(ints[0])
print(ints[1])
print(ints[3])
ints.resize(7, 9)
print(ints.length)
print(ints[5])
print(ints[6])

let flags = Array<bool>(4, false)
print(flags.length)
print(flags[0])
flags.fill(true, 1, 3)
print(flags[0])
print(flags[1])
print(flags[2])
flags.resize(6, true)
print(flags[4])
print(flags[5])

let bytes = Bytes(4, 3)
print(bytes.length)
print(bytes[0])
print(bytes[3])
bytes.resize(6, 255)
print(bytes[4])
print(bytes[5])
bytes.fill(7, -4, -1)
print(bytes[1])
print(bytes[2])
print(bytes[4])
print(bytes[5])
