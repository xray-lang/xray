let xs = [1, 2, 3]
xs.reserve(-4)
print(xs.length)
xs.resize(5, 9)
print(xs.length)
print(xs[3])
print(xs[4])
xs.resize(-2, 7)
print(xs.length)

let ints = Array<int>(2, 4)
ints.reserve(8)
print(ints.length)
print(ints.capacity >= 8)
ints.resize(4, 11)
print(ints[0])
print(ints[2])
print(ints[3])

// Slices are borrowed views: grow methods (reserve/resize/push) are
// rejected at compile time (see tests/compile_errors/type/span_owner_method),
// so only read semantics are exercised here.
let source = [10, 20, 30, 40, 50]
let view = source[1:4]
print(view.length)
print(view[0])
print(view[2])
print(source.length)

let bytes = Bytes(3, 5)
bytes.resize(-9)
print(bytes.length)
