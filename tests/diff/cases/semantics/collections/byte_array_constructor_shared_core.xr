var ints = Array<i64>(4, 0)
ints[0] = 257
ints[1] = -1
ints[2] = 0
ints[3] = 128
var from_ints = Array<u8>(ints)
print(len(from_ints))
print(from_ints[0])
print(from_ints[1])
print(from_ints[2])
print(from_ints[3])

var flags = Array<bool>(3, false)
flags[0] = true
flags[1] = false
flags[2] = true
var from_flags = Array<u8>(flags)
print(from_flags[0])
print(from_flags[1])
print(from_flags[2])

var floats = Array<f64>(3, 0.0)
floats[0] = 3.8
floats[1] = -2.2
floats[2] = 260.0
var from_floats = Array<u8>(floats)
print(from_floats[0])
print(from_floats[1])
print(from_floats[2])

var mixed = [1, true, "x", 258]
var from_mixed = Array<u8>(mixed)
print(from_mixed[0])
print(from_mixed[1])
print(from_mixed[2])
print(from_mixed[3])

var filled = Array<u8>(4, 257)
print(filled[0])
print(filled[3])
