// Payload enum equality is nominal identity plus payload-wise comparison on
// both backends. The hosted AOT runtime once compared identity only, so equal
// tags with different payloads answered true and Map/Set keys merged.
enum E { A { value: i64 }, B { value: string }, C }
enum K { Id { id: i64 }, Name { name: string } }

fn main() {
    print(E.A { value: 1 } == E.A { value: 1 })
    print(E.A { value: 1 } == E.A { value: 2 })
    print(E.B { value: "x" } == E.B { value: "x" })
    print(E.B { value: "x" } == E.B { value: "y" })
    print(E.A { value: 1 } == E.C)

    var m: Map<K, string> = #{}
    m[K.Id { id: 1 }] = "one"
    m[K.Id { id: 2 }] = "two"
    print(len(m))
    print(m[K.Id { id: 1 }])
    print(m[K.Id { id: 2 }])

    var s: Set<K> = #[]
    s.add(K.Id { id: 1 })
    s.add(K.Id { id: 2 })
    s.add(K.Id { id: 1 })
    print(len(s))
}
main()
