// anchor: byte-slice-bulk-ops-shared-core
fn main() {
    var dst = Array<u8>(8)
    var src = Array<u8>(4)
    var dstView: Slice<u8> = dst[:]
    var srcView: Slice<u8> = src[:]
    dstView.fill(1)
    srcView.fill(7)
    srcView.store<u16>(1, 2312, Endian.LE)
    var copiedWindow: Slice<u8> = dstView[2:6]
    var copied: Slice<u8> = copiedWindow.copyFrom(srcView)
    print(dst[0])
    print(dst[1])
    print(dst[2])
    print(dst[3])
    print(dst[4])
    print(dst[5])
    print(dst[6])
    print(dst[7])
    print(len(copied))
    var dstMid: Slice<u8> = dstView[2:6]
    var dstHead: Slice<u8> = dstView[0:4]
    print(dstMid.compare(srcView))
    print(dstHead.compare(srcView))
    print(srcView.compare(dstHead))
    var prefix: Slice<u8> = dstView[2:5]
    print(prefix.compare(srcView))
    print(srcView.compare(prefix))
    var dstPrefixFull: Slice<u8> = dstView[2:6]
    var dstPrefixShort: Slice<u8> = dstView[2:5]
    var dstEmpty: Slice<u8> = dstView[0:0]
    print(dstPrefixFull.commonPrefix(srcView))
    print(dstPrefixShort.commonPrefix(srcView))
    print(dstHead.commonPrefix(srcView))
    print(dstEmpty.commonPrefix(srcView))
    var rep = Array<u8>(10)
    var repView: Slice<u8> = rep[:]
    repView.store<u16>(0, 16961, Endian.LE)
    repView.repeatFrom(2, 2, 6)
    print(rep[0])
    print(rep[1])
    print(rep[2])
    print(rep[3])
    print(rep[4])
    print(rep[5])
    print(rep[6])
    print(rep[7])
}

main()
