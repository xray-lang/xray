// anchor: bytes-int-arg-shared-core
let dyn: Json = {
    "badOffset": true,
    "badDst": false,
    "badSrc": "src",
    "badCount": null
}

let bytes = Bytes(8, 1)
let src = Bytes(8, 2)
let view: ByteSpan = bytes

fn show_load_u32() {
    try {
        let value: uint32 = view.load<uint32>(dyn.badOffset, Endian.LE)
        print(int(value))
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_load_u64() {
    try {
        let value: uint64 = view.load<uint64>(dyn.badOffset, Endian.LE)
        print(int(value))
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_append_from() {
    try {
        bytes.appendFrom(src[dyn.badOffset:2])
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_repeat_distance() {
    try {
        bytes.repeatFrom(dyn.badDst, 1)
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_repeat_from() {
    try {
        bytes.repeatFrom(1, dyn.badCount)
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

show_load_u32()
show_load_u64()
show_append_from()
show_repeat_distance()
show_repeat_from()
