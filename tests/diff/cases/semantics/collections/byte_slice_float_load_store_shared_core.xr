// anchor: byte-slice-float-load-store-shared-core
fn main() {
    var bytes = Array<u8>(16)
    var view: Slice<u8> = bytes[:]
    view.store<f32>(0, 1.5, Endian.LE)
    view.store<f32>(4, -2.5, Endian.BE)
    view.store<f64>(8, -2.25, Endian.LE)
    print(bytes[0])
    print(bytes[1])
    print(bytes[2])
    print(bytes[3])
    print(bytes[4])
    print(bytes[5])
    print(bytes[6])
    print(bytes[7])
    print(bytes[14])
    print(bytes[15])
    print(view.load<f32>(0, Endian.LE))
    print(view.load<f32>(4, Endian.BE))
    print(view.load<f64>(8, Endian.LE))
}

main()
