fn takes_bool(x: bool) {
    print("fn=" + x.toString())
}

var dyn: JSON.Object = JSON.parseObject(
    "{\"goodBool\":true,\"badBool\":1,\"goodInt\":7,\"badInt\":3.5}"
)
var m: Map<bool, int> = #{}
m.set(JSON.require<bool>(dyn, ["goodBool"]), JSON.require<int>(dyn, ["goodInt"]))
print("map=" + m.get(true)!.toString())

try {
    print(m.containsKey(JSON.require<bool>(dyn, ["badBool"])).toString())
    print("bad-map-key")
} catch panic(e) {
    print("caught-map-key")
}

try {
    m.set(JSON.require<bool>(dyn, ["goodBool"]), JSON.require<int>(dyn, ["badInt"]))
    print("bad-map-value")
} catch panic(e) {
    print("caught-map-value")
}

try {
    takes_bool(JSON.require<bool>(dyn, ["badBool"]))
    print("bad-fn")
} catch panic(e) {
    print("caught-fn")
}

try {
    var x: int = JSON.require<int>(dyn, ["badInt"])
    print("bad-var=" + x.toString())
} catch panic(e) {
    print("caught-var")
}

try {
    print(JSON.require<int>(dyn, ["badInt"]).toString())
    print("bad-return")
} catch panic(e) {
    print("caught-return")
}
