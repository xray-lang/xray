// anchor: array-capacity-panic-shared-core
var dyn: Json = {
    "bad": true
}

try {
    var xs = Array<int>(dyn.bad, 1)
    print(len(xs))
} catch panic (p) {
    print(p.message)
    print(p.code)
}

try {
    var ys = Array.withCapacity(dyn.bad)
    print(len(ys))
} catch panic (p) {
    print(p.message)
    print(p.code)
}
