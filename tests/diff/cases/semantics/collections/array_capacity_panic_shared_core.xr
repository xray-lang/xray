// anchor: array-capacity-panic-shared-core
var dyn: JSON.Object = JSON.parseObject("{\"bad\":true}")

try {
    var xs = Array<i64>(JSON.require<i64>(dyn, ["bad"]), 1)
    print(len(xs))
} catch panic (p) {
    print(p.message)
    print(p.code)
}

try {
    var ys = Array.withCapacity(JSON.require<i64>(dyn, ["bad"]))
    print(len(ys))
} catch panic (p) {
    print(p.message)
    print(p.code)
}
