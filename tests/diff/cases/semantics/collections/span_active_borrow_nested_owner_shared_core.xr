class Box {
    bytes: Array<byte> = Array<byte>(0)
}

fn fieldOwnerAfterLastUse() {
    var box = Box()
    box.bytes.push(7)
    var view: Slice<byte> = box.bytes[:]
    print(len(view))
    print(view[0])
    box.bytes.push(9)
    print(len(box.bytes))
}

fn indexOwnerAfterLastUse() {
    var chunks: Array<Array<byte>> = [Array<byte>(0)]
    chunks[0].push(3)
    var view: Slice<byte> = chunks[0][:]
    print(len(view))
    print(view[0])
    chunks[0].push(4)
    print(len(chunks[0]))
}

fieldOwnerAfterLastUse()
indexOwnerAfterLastUse()
