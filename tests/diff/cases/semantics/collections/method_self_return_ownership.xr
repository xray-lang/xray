// anchor: method-self-return-ownership
// A builtin method that answers with its own receiver hands back a reference
// the caller owns, so an aliasing binding and the original are two independent
// owners of one object, and a statement-position call owns -- and drops -- its
// own result. Both readings have to survive: releasing the alias must not free
// the object out from under the original, and running the call for its side
// effect must not strand the reference it was given.
//
// The AOT side answers these through xrt_method_return_self / the discard
// dispatch (src/aot/xrt_method.h); the VM answers them borrowed. The two must
// still agree on every value printed here.

fn aliased_reverse() {
    var a = [3, 1, 2]
    var b = a.reverse()
    print("b0 " + string(b[0]))
    b[0] = 9
    print("a0 " + string(a[0]))
    a.reverse()
    print("a0-again " + string(a[0]))
}

// StringBuilder answers clear() and toString() through their own lowering
// rather than the symbol dispatchers, so both readings need covering there too:
// clear() aliases the builder, toString() allocates and must not be stranded
// when the call is written as a statement.
fn aliased_clear() {
    var sb = StringBuilder()
    sb.append("hello")
    var same = sb.clear()
    same.append("world")
    print("sb " + sb.toString())
    sb.toString()
    sb.clear()
    print("cleared " + sb.toString())
}

// The string arms answer with the receiver whenever the result would equal the
// input: repeat(1), and a replace whose pattern does not occur.
fn aliased_string_passthrough() {
    var s = "ab" + "cd"
    print("t " + s.replace("zz", "yy"))
    print("u " + s.repeat(1))
    print("v " + s.replaceAll("zz", "yy"))
    s.replace("zz", "yy")
    s.repeat(1)
    s.replaceAll("zz", "yy")
    print("s " + s)
}

// The in-place array mutators answer with the receiver through a helper, so
// they carry the same two readings as reverse() does.
fn aliased_mutators() {
    var a = [3, 1, 2]
    var s = a.sort()
    s[0] = 7
    print("a0 " + string(a[0]))
    a.sort()
    a.reserve(16)
    var f = a.fill(5)
    print("f " + string(f[0]) + " " + string(a[1]))

    var bytes = Array<u8>(4)
    bytes.fill(9)
    var r = bytes.fill(3)
    print("r0 " + string(r[0]))
}

// string.copyBytes() has no method-symbol id and is lowered straight to its
// runtime helper, so it needs the same treatment as the dispatchers.
fn allocating_helper() {
    var s = "hi" + " there"
    s.copyBytes()
    var b = s.copyBytes()
    print("b " + string(b[0]) + " " + string(b[1]))
}

// pop()/shift() move an element out of the receiver, which shortens without
// releasing, so a discarded one owns what it took. map()/filter()/split() and
// friends build fresh objects. Map.get() promotes to an owned reference.
fn discarded_owned_results() {
    var rows = [[1, 2], [3, 4], [5, 6]]
    rows.pop()
    rows.shift()
    rows.filter(fn(row: Array<i64>) -> bool { return len(row) > 0 })
    print("rows " + string(len(rows)))
    print("rows0-after-filter " + string(rows[0][0]))

    var a = [3, 1, 2]
    a.map(fn(x: i64) -> i64 { return x * 2 })
    a.filter(fn(x: i64) -> bool { return x > 1 })

    var s = "a,b,c"
    s.split(",")
    s.slice(0, 2)
    var m = #{"k": [1, 2]}
    m.get("k")
    m.keys()
    m.values()
    (255).toHex()
    print("s " + s + " " + string(len(m)))
    print("map-value " + string(m.get("k")![0]))
}

// Iterator pulls normalize to owned results. A collection slot is retained,
// while a generator yield transfers its owner, so discarding next() is safe
// and does not invalidate the collection's copy.
fn discarded_owned_iterator_result() {
    var rows = [[1, 2], [3, 4]]
    var it = rows.iterator()
    it.next()
    var kept = it.next()
    print("kept " + string(kept[0]))
    print("rows0 " + string(rows[0][0]))
}

// Generator frames release their slots on teardown, which is what turns a
// borrowed self-return into a use-after-free rather than a harmless alias.
fn frames(n: i64) -> Iterator<i64> {
    var a = [1, 2, 3]
    var b = a.reverse()
    for (x in b) {
        yield x * n
    }
    var sorted = a.sort()
    yield sorted[0]
    var filled = a.fill(4)
    yield filled[0]
    var sb = StringBuilder()
    sb.append("done")
    var same = sb.clear()
    same.append("x")
    yield a[0]
}

aliased_reverse()
aliased_clear()
aliased_string_passthrough()
aliased_mutators()
allocating_helper()
discarded_owned_results()
discarded_owned_iterator_result()
for (y in frames(2)) {
    print("y " + string(y))
}
