// anchor: span-reinterpret-asbytes-shared-core
fn main() {
    var words = Array<uint32>(2, 0)
    var wordSpan: Span<uint32> = words[:]
    var wordBytes: ByteSpan = wordSpan.asBytes()
    print(wordBytes.length)
    wordBytes.fill(1)
    print(int(words[0]))
    print(int(words[1]))
    var bytes = Bytes(6)
    var raw: ByteSpan = bytes[:]
    raw.fill(0)
    var pairs: Span<uint16> = raw.reinterpret<uint16>()
    print(pairs.length)
    pairs[1] = 30583
    print(bytes[2])
    print(bytes[3])
    var roundtrip: ByteSpan = pairs.asBytes()
    print(roundtrip.length)
    roundtrip.fill(9)
    print(int(pairs[0]))
    print(int(pairs[2]))
    try {
        var badRaw: ByteSpan = raw[0:5]
        var bad: Span<uint32> = badRaw.reinterpret<uint32>()
        print(bad.length)
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

main()
