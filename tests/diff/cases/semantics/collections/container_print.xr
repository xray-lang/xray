// anchor: container-print
// print() of arrays and tuples must format byte-identically on VM and AOT:
// recursive, "[", "]" / "(", ")", ", "-separated, with nested strings quoted,
// matching the VM value formatter.
print([1, 2, 3])
print([1.5, 0.1, 100.0])
print(["a", "b", "c"])
print([[1, 2], [3, 4]])
print([true, false, true])
print((1, "x", 2.5))
print((42,))
let xs = [10, 20, 30]
print(xs)
let nested = [["x"], ["y", "z"]]
print(nested)
