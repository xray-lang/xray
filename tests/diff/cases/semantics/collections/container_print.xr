// anchor: container-print
// print() of arrays, tuples, maps and sets must format byte-identically on VM
// and AOT: recursive, "[" "]" / "(" ")" / "#{" "}" / "#[" "]", ", "-separated,
// nested strings quoted, insertion-ordered, matching the VM value formatter.
print([1, 2, 3])
print([1.5, 0.1, 100.0])
print(["a", "b", "c"])
print([[1, 2], [3, 4]])
print([true, false, true])
print((1, "x", 2.5))
print((42,))
let xs = [10, 20, 30]
print(xs)
let nested = [["x"], ["y", "z"]]
print(nested)
let m: Map<int, int> = #{1: 10, 2: 20, 3: 30}
print(m)
let st: Set<int> = #[1, 2, 3]
print(st)
let sm: Map<string, int> = #{"a": 1, "b": 2}
print(sm)
let nm: Map<int, Array<int>> = #{1: [1, 2], 2: [3, 4]}
print(nm)
let em: Map<int, int> = #{}
print(em)
let ss: Set<string> = #["x", "y"]
print(ss)
