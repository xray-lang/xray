// anchor: container-print
// print() of arrays, tuples, maps and sets must format byte-identically on VM
// and AOT: recursive, "[" "]" / "(" ")" / "#{" "}" / "#[" "]", ", "-separated,
// nested strings quoted, insertion-ordered, matching the VM value formatter.
print([1, 2, 3])
print([1.5, 0.1, 100.0])
print(["a", "b", "c"])
print([[1, 2], [3, 4]])
print([true, false, true])
print((1, "x", 2.5))
print((42,))
var xs = [10, 20, 30]
print(xs)
var nested = [["x"], ["y", "z"]]
print(nested)
var m: Map<i64, i64> = #{1: 10, 2: 20, 3: 30}
print(m)
var st: Set<i64> = #[1, 2, 3]
print(st)
var sm: Map<string, i64> = #{"a": 1, "b": 2}
print(sm)
var nm: Map<i64, Array<i64>> = #{1: [1, 2], 2: [3, 4]}
print(nm)
var em: Map<i64, i64> = #{}
print(em)
var ss: Set<string> = #["x", "y"]
print(ss)
