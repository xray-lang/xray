fn show(label: string, value: bool) {
    print(label + "=" + value.toString())
}

if (null) { show("null", true) } else { show("null", false) }
if (false) { show("false", true) } else { show("false", false) }
if (0) { show("zero-int", true) } else { show("zero-int", false) }
if (0.0) { show("zero-float", true) } else { show("zero-float", false) }
if (-1) { show("nonzero-int", true) } else { show("nonzero-int", false) }
if (0.25) { show("nonzero-float", true) } else { show("nonzero-float", false) }
if ("") { show("empty-string", true) } else { show("empty-string", false) }
if ("x") { show("nonempty-string", true) } else { show("nonempty-string", false) }

let emptyArray: Array<int> = []
let fullArray: Array<int> = [1]
if (emptyArray) { show("empty-array", true) } else { show("empty-array", false) }
if (fullArray) { show("full-array", true) } else { show("full-array", false) }

let emptyMap: Map<string, int> = #{}
let fullMap: Map<string, int> = #{"x": 1}
if (emptyMap) { show("empty-map", true) } else { show("empty-map", false) }
if (fullMap) { show("full-map", true) } else { show("full-map", false) }

let emptyBoolMap: Map<bool, int> = #{}
let fullBoolMap: Map<bool, int> = #{true: 1}
if (emptyBoolMap) { show("empty-boolmap", true) } else { show("empty-boolmap", false) }
if (fullBoolMap) { show("full-boolmap", true) } else { show("full-boolmap", false) }

let emptySet: Set<string> = #[]
let fullSet: Set<string> = #["x"]
if (emptySet) { show("empty-set", true) } else { show("empty-set", false) }
if (fullSet) { show("full-set", true) } else { show("full-set", false) }

let emptyTypedSet: Set<uint8> = #[]
let fullTypedSet: Set<uint8> = #[7]
if (emptyTypedSet) { show("empty-typed-set", true) } else { show("empty-typed-set", false) }
if (fullTypedSet) { show("full-typed-set", true) } else { show("full-typed-set", false) }
