var ints = Array<int>(4, 0)
ints[0] = 12
ints[1] = -3
ints[2] = 0
ints[3] = 99
print(ints.join("|"))

var flags = Array<bool>(3, false)
flags[1] = true
print(flags.join("/"))

var floats = Array<float>(3, 0.0)
floats[0] = 1.5
floats[1] = -0.0
floats[2] = 2.25
print(floats.join(","))

var bytes = Bytes(3, 0)
bytes[0] = 65
bytes[1] = 0
bytes[2] = 255
print(bytes.join("-"))

var values = ["a", null, true, 42, 2.5]
print(values.join(":"))

var empty = Array<int>(0, 0)
print("empty=" + empty.join(","))
