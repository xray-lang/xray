// anchor: bytes-int-arg-shared-core
var dyn: JSON.Object = JSON.parseObject(
    "{\"badOffset\":true,\"badDst\":false,\"badSrc\":\"src\",\"badCount\":null}"
)

var bytes = Array<byte>(8, 1)
var src = Array<byte>(8, 2)

fn show_load_u32() {
    var loadBytes = Array<byte>(8, 1)
    var view: Slice<byte> = loadBytes[:]
    try {
        var value: u32 = view.load<u32>(JSON.require<int>(dyn, ["badOffset"]), Endian.LE)
        print(int(value))
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_load_u64() {
    var loadBytes = Array<byte>(8, 1)
    var view: Slice<byte> = loadBytes[:]
    try {
        var value: u64 = view.load<u64>(JSON.require<int>(dyn, ["badOffset"]), Endian.LE)
        print(int(value))
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_append_from() {
    try {
        bytes.appendFrom(src[JSON.require<int>(dyn, ["badOffset"]):2])
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_repeat_distance() {
    try {
        bytes.repeatFrom(JSON.require<int>(dyn, ["badDst"]), 1)
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

fn show_repeat_from() {
    try {
        bytes.repeatFrom(1, JSON.require<int>(dyn, ["badCount"]))
        print(bytes[0])
    } catch panic (p) {
        print(p.message)
        print(p.code)
    }
}

show_load_u32()
show_load_u64()
show_append_from()
show_repeat_distance()
show_repeat_from()
