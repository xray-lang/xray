// Bool values derived from Array<byte> reads must remain live after short-circuit
// nullable-bool comparisons.

fn check(raw: Array<u8>, expectMasked: bool? = null) {
    var second = raw[1]
    var masked = (second & 128) != 0
    if (expectMasked != null && masked != expectMasked!) {
        print("expect mismatch")
    }
    if (masked) {
        print("masked")
    } else {
        print("unmasked")
    }
}

check(Array<u8>([129, 2, 72, 105]), false)
check(Array<u8>([129, 130, 1, 2, 3, 4, 73, 107]), true)
