// anchor: array-rune-compact
var chars: Array<rune> = ['b', '中', '\u{1F600}']
print(len(chars))
print(typeName(chars[0]))
print(chars[0])
print(chars[1].ord())
print(chars[2].ord())

chars[0] = 'a'
chars.push('z')
print(chars.join("|"))

chars.fill('x', 1, 3)
print(chars.join(""))
print(chars.indexOf('x'))
print(chars.indexOf('中'))

chars.resize(6, 'q')
print(len(chars))
print(chars[4])
print(chars[5])

chars.sort()
print(chars.join(""))
print(chars[0].ord())

var made = Array<rune>(3, 'k')
print(len(made))
print(made.join(""))

var from_string: Array<rune> = []
for (ch in "A中\u{1F600}") {
    from_string.push(ch)
}
print(from_string.join("-"))
print(typeName(from_string[2]))
