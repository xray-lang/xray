class Pair {
    left: Array<byte> = Array<byte>(0)
    right: Array<byte> = Array<byte>(0)
}

fn disjointField() {
    var box = Pair()
    box.left.push(1)
    box.right.push(9)
    var view: Slice<byte> = box.left[:]
    box.right = Array<byte>(0)
    box.right.push(10)
    print(len(view))
    print(view[0])
    print(len(box.right))
    print(box.right[0])
}

fn disjointIndex() {
    var chunks: Array<Array<byte>> = [Array<byte>(0), Array<byte>(0)]
    chunks[0].push(3)
    chunks[1].push(7)
    var view: Slice<byte> = chunks[0][:]
    chunks[1] = Array<byte>(0)
    chunks[1].push(8)
    print(len(view))
    print(view[0])
    print(len(chunks[1]))
    print(chunks[1][0])
}

disjointField()
disjointIndex()
