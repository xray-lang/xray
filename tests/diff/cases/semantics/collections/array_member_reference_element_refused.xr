// anchor: array-member-reference-element-refused
// Both backends run this program and print the same bytes: searching a string
// array compares elements by content, and fill/push keep the elements intact.
fn main() {
    var names = ["a", "b", "c"]
    names.fill("z")
    print(names[0])
    names.push("w")
    print(names[3])
    print(names.indexOf("z"))
    print(names.contains("w"))
}

main()
