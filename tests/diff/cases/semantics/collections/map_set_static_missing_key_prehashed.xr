// anchor: map-set-static-missing-key-prehashed
// Top-level const Map/Set literals are AOT readonly static/prehashed candidates;
// strict Map indexing must still preserve the E0431 missing-key panic.

const SCORES: Map<string, i64> = #{"ada": 7, "lin": 9}
const SEEN: Set<string> = #["ada", "lin"]

print(SCORES.get("missing") == null)
print(SEEN.contains("missing"))
print(SCORES["ada"])
print(SEEN.contains("lin"))

try {
    print(SCORES["missing"])
    print("bad-index")
} catch panic (p) {
    print(p.code)
    print(p.message)
}
