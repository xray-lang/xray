var values: Array<i64> = []
values.push(1)
values.push(2)
values.push(3)
values.push(4)

var mapped = values.map(fn(x: i64) -> i64 { return x * 3 })
print(len(mapped))
print(mapped[0])
print(mapped[3])

var kept = values.filter(fn(x: i64) -> bool { return x % 2 == 1 })
print(len(kept))
print(kept[0])
print(kept[1])

var total = values.reduce(fn(acc: i64, x: i64) -> i64 { return acc * 10 + x }, 0)
print(total)

var each_total = 0
values.forEach(fn(x: i64) {
    each_total = each_total + x
})
print(each_total)

var found = values.find(fn(x: i64) -> bool { return x > 2 })
print(found)

var missing = values.find(fn(x: i64) -> bool { return x > 10 })
print(missing)

var found_index = values.findIndex(fn(x: i64) -> bool { return x == 3 })
print(found_index)

var missing_index = values.findIndex(fn(x: i64) -> bool { return x > 10 })
print(missing_index)

print(values.every(fn(x: i64) -> bool { return x > 0 }))
print(values.every(fn(x: i64) -> bool { return x < 4 }))
print(values.some(fn(x: i64) -> bool { return x == 4 }))
print(values.some(fn(x: i64) -> bool { return x > 10 }))

var chained = values
    .map(fn(x: i64) -> i64 { return x + 1 })
    .filter(fn(x: i64) -> bool { return x > 2 })
    .reduce(fn(acc: i64, x: i64) -> i64 { return acc + x }, 0)
print(chained)

var bytes: Array<u8> = []
bytes.push(1)
bytes.push(2)
bytes.push(3)

var byte_mapped = bytes.map(fn(x: u8) -> i64 { return (x as i64) + 10 })
print(len(byte_mapped))
print(byte_mapped[0])
print(byte_mapped[2])

var byte_kept = bytes.filter(fn(x: u8) -> bool { return x > 1 })
print(len(byte_kept))
print(byte_kept[0])
print(byte_kept[1])
