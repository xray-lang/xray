let values: Array<int> = []
values.push(1)
values.push(2)
values.push(3)
values.push(4)

let mapped = values.map(fn(x: int) -> int { return x * 3 })
print(mapped.length)
print(mapped[0])
print(mapped[3])

let kept = values.filter(fn(x: int) -> bool { return x % 2 == 1 })
print(kept.length)
print(kept[0])
print(kept[1])

let total = values.reduce(fn(acc: int, x: int) -> int { return acc * 10 + x }, 0)
print(total)

let each_total = 0
values.forEach(fn(x: int) {
    each_total = each_total + x
})
print(each_total)

let found = values.find(fn(x: int) -> bool { return x > 2 })
print(found)

let missing = values.find(fn(x: int) -> bool { return x > 10 })
print(missing)

let found_index = values.findIndex(fn(x: int) -> bool { return x == 3 })
print(found_index)

let missing_index = values.findIndex(fn(x: int) -> bool { return x > 10 })
print(missing_index)

print(values.every(fn(x: int) -> bool { return x > 0 }))
print(values.every(fn(x: int) -> bool { return x < 4 }))
print(values.some(fn(x: int) -> bool { return x == 4 }))
print(values.some(fn(x: int) -> bool { return x > 10 }))

let chained = values
    .map(fn(x: int) -> int { return x + 1 })
    .filter(fn(x: int) -> bool { return x > 2 })
    .reduce(fn(acc: int, x: int) -> int { return acc + x }, 0)
print(chained)

let bytes: Array<uint8> = []
bytes.push(1)
bytes.push(2)
bytes.push(3)

let byte_mapped = bytes.map(fn(x: uint8) -> int { return x + 10 })
print(byte_mapped.length)
print(byte_mapped[0])
print(byte_mapped[2])

let byte_kept = bytes.filter(fn(x: uint8) -> bool { return x > 1 })
print(byte_kept.length)
print(byte_kept[0])
print(byte_kept[1])
