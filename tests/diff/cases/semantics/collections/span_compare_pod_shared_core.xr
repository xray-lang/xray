// anchor: span-compare-pod-shared-core
let left = Array<uint32>(2, 0)
left[0] = 1
left[1] = 2

let same = Array<uint32>(2, 0)
same[0] = 1
same[1] = 2

let higher = Array<uint32>(2, 0)
higher[0] = 1
higher[1] = 3

let prefix = Array<uint32>(1, 0)
prefix[0] = 1

let leftSpan: Span<uint32> = left[:]
let sameSpan: Span<uint32> = same[:]
let higherSpan: Span<uint32> = higher[:]
let prefixSpan: Span<uint32> = prefix[:]

print(leftSpan.compare(sameSpan))
print(leftSpan.compare(higherSpan))
print(higherSpan.compare(leftSpan))
print(leftSpan.compare(prefixSpan))
print(prefixSpan.compare(leftSpan))

let windowed = Array<uint16>(4, 0)
windowed[0] = 9
windowed[1] = 7
windowed[2] = 8
windowed[3] = 6
let winSpan: Span<uint16> = windowed[:]
let first: Span<uint16> = winSpan[1:3]
let second: Span<uint16> = winSpan[2:4]
print(first.compare(second))
