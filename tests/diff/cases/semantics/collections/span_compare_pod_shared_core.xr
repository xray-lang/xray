// anchor: span-compare-pod-shared-core
fn main() {
    var left = Array<uint32>(2, 0)
    left[0] = 1
    left[1] = 2
    var same = Array<uint32>(2, 0)
    same[0] = 1
    same[1] = 2
    var higher = Array<uint32>(2, 0)
    higher[0] = 1
    higher[1] = 3
    var prefix = Array<uint32>(1, 0)
    prefix[0] = 1
    var leftSlice: Slice<uint32> = left[:]
    var sameSlice: Slice<uint32> = same[:]
    var higherSlice: Slice<uint32> = higher[:]
    var prefixSlice: Slice<uint32> = prefix[:]
    print(leftSlice.compare(sameSlice))
    print(leftSlice.compare(higherSlice))
    print(higherSlice.compare(leftSlice))
    print(leftSlice.compare(prefixSlice))
    print(prefixSlice.compare(leftSlice))
    var windowed = Array<uint16>(4, 0)
    windowed[0] = 9
    windowed[1] = 7
    windowed[2] = 8
    windowed[3] = 6
    var winSlice: Slice<uint16> = windowed[:]
    var first: Slice<uint16> = winSlice[1:3]
    var second: Slice<uint16> = winSlice[2:4]
    print(first.compare(second))
}

main()
