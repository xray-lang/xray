// anchor: slice-string-bytes-view
fn main() {
    var text = "ABCD"
    var bytes: Slice<u8> = text.bytes()
    print(len(bytes))
    print(bytes[0])
    print(bytes[1])
    var mid: Slice<u8> = bytes[1:3]
    print(len(mid))
    print(mid[0])
    print(mid[1])
    var snapshot = copy(mid)
    print(snapshot[0])
}

main()
