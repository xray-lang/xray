// anchor: slice-string-bytes-view
fn main() {
    var text = "ABCD"
    var bytes: ByteSpan = text.bytes()
    print(bytes.length)
    print(bytes[0])
    print(bytes[1])
    var mid: ByteSpan = bytes[1:3]
    print(mid.length)
    print(mid[0])
    print(mid[1])
    var owned = copy(mid)
    print(owned[0])
}

main()
