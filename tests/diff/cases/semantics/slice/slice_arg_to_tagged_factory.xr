// anchor: slice-arg-to-tagged-factory
class Snapshot {
    size: i64
    first: u8
    owned: Array<u8>

    constructor(size: i64, first: u8) {
        this.size = size
        this.first = first
        this.owned = Array<u8>(1)
        this.owned[0] = first
    }
}

fn snapshot(data: Slice<u8>) -> Snapshot {
    return Snapshot(len(data), data[0])
}

var bytes: [u8; 3] = [17, 23, 41]
var result = snapshot(bytes[:])
print("size=${result.size} first=${result.first}")
