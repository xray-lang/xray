fn tail(data: Slice<u8>) -> Slice<u8> {
    return data[1:]
}

fn throughValue(transform: fn(Slice<u8>) -> Slice<u8>, data: Slice<u8>) -> Slice<u8> {
    return transform(data)
}

interface TailView {
    tail(data: Slice<u8>) -> Slice<u8>
}

class TailImpl implements TailView {
    tail(data: Slice<u8>) -> Slice<u8> {
        return data[2:]
    }
}

fn throughInterface(provider: TailView, data: Slice<u8>) -> Slice<u8> {
    return provider.tail(data)
}

fn run() {
    var owner: Array<u8> = [10, 20, 30, 40]
    var source: Slice<u8> = owner[:]
    var viaValue = throughValue(tail, source)
    print(viaValue[0])
    var provider = TailImpl()
    var viaInterface = throughInterface(provider, source)
    print(viaInterface[0])
}

run()
