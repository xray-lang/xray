fn tail(data: Slice<u8>, start: i64) -> const Slice<u8> {
    return data[start:]
}

fn forward(data: Slice<u8>, start: i64) -> const Slice<u8> {
    return tail(data, start)
}

class Window {
    bytes: Array<u8>
    start: i64

    constructor(bytes: Array<u8>, start: i64) {
        this.bytes = bytes
        this.start = start
    }

    tail() -> const Slice<u8> {
        return this.bytes[this.start:]
    }
}

fn main() {
    var bytes: Array<u8> = [10, 20, 30, 40]
    var source: Slice<u8> = bytes[:]
    var result: const Slice<u8> = forward(source, 2)
    print(len(result))
    print(result[0])
    print(result[1])
    var window = Window(bytes, 1)
    var receiverResult: const Slice<u8> = window.tail()
    print(receiverResult[0])
}

main()
