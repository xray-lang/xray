// anchor: nullable-presence-condition
var s: string? = null
if (s != null) {
    print("present")
} else {
    print("absent")
}

var empty: string? = ""
if (empty != null) {
    print("empty-but-present")
} else {
    print("absent2")
}

var n: i64? = 0
if (n != null) {
    print("zero-but-present")
} else {
    print("absent3")
}

var absent: i64? = null
if (absent != null) {
    print("bad")
} else {
    print("absent4")
}
