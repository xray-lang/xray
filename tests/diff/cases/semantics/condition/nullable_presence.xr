// anchor: nullable-presence-condition
var s: string? = null
if (s) {
    print("present")
} else {
    print("absent")
}

var empty: string? = ""
if (empty) {
    print("empty-but-present")
} else {
    print("absent2")
}

var n: int? = 0
if (n) {
    print("zero-but-present")
} else {
    print("absent3")
}

var absent: int? = null
if (absent) {
    print("bad")
} else {
    print("absent4")
}
