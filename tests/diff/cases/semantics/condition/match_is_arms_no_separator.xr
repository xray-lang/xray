// Consecutive `is` type-pattern arms with expression bodies and no comma:
// the spec's §6.4 spelling. A leading `is` on a new line ends the previous
// arm body instead of gluing on as an infix type test.
type V = i64 | string

fn f(v: V) -> string {
    return match (v) {
        is i64 n -> "int: ${n}"
        is string -> "a string"
        _ -> "?"
    }
}

fn g(v: V) -> string {
    return match (v) {
        is i64 n -> "i${n}"
        is string s -> "s${s}"
        _ -> "?"
    }
}

fn main() {
    print(f(42))
    print(f("hello"))
    print(g(7))
    print(g("x"))
}
main()
