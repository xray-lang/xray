// anchor: defer-loop-block-scope
// D22: `defer` is owned by the nearest real `{}` block. A defer registered in a
// loop body runs at that iteration's block exit instead of accumulating until
// function return. Both block-form and call-form defer must use the loop body as
// the owner; the parser's synthetic capture block for `defer f(args)` is not a
// semantic defer scope.
fn loop_block() {
    for (i in 0..4) {
        defer { print("blk " + string(i)) }
        print("iter " + string(i))
    }
    print("loop-block-end")
}

fn loop_call() {
    for (i in 0..3) {
        defer log(i)
        print("call-iter " + string(i))
    }
    print("loop-call-end")
}

fn log(n: int) { print("call " + string(n)) }

loop_block()
loop_call()
print("done")
