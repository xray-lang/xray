// Reassigning an outer binding changes the receiver observed by its cleanup.
class Conn {
    id: i64 = 0
    constructor(id: i64) { this.id = id }
    close() { print("closing conn", this.id) }
}

fn receiver_late_binding() {
    var conn = Conn(1)
    defer { conn.close() }
    conn = Conn(2)
    print("body done")
}

receiver_late_binding()
