// A cleanup block reads outer bindings when the block executes. Programs that
// need a registration-time value must create an explicit copy first.
fn show(label: string, n: i64) { print(label + "=" + string(n)) }

fn late_binding() {
    var x = 1
    defer { show("late", x) }
    const saved = copy(x)
    defer { show("saved", saved) }
    x = 99
    print("body x=" + string(x))
}

late_binding()
print("done")
