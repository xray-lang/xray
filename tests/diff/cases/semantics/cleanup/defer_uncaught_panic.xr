// anchor: defer-uncaught-panic-runs-active-frontiers
// An uncaught panic executes every active cleanup frontier before the process
// reports the panic. Both backends must print inner-defer, then outer-defer,
// and exit with the same non-zero status; unreachable code must stay silent.
fn inner() {
    defer { print("inner-defer") }
    var z = 0
    var q = 10 / z
    print(q)
}
fn outer() {
    defer { print("outer-defer") }
    inner()
    print("unreachable-outer")
}
outer()
print("unreachable-main")
