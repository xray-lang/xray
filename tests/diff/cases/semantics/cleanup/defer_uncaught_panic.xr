// anchor: defer-uncaught-panic-no-run
// On an UNCAUGHT panic the program aborts WITHOUT running defers (only a caught
// panic unwinds through them). Both backends must agree: no deferred output on
// stdout and a clean non-zero exit. (Caught-panic defer ordering is also
// correct in the runtime but cannot be diffed yet — AOT `catch panic` codegen
// is a separate known limitation; see docs/known_bugs.md.)
fn inner() {
    defer print("inner-defer")
    let z = 0
    let q = 10 / z
    print(q)
}
fn outer() {
    defer print("outer-defer")
    inner()
    print("unreachable-outer")
}
outer()
print("unreachable-main")
