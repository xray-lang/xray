// anchor: defer-builtin-method-freefn-mix
// Cleanup blocks containing builtin, method, and free-function calls must run
// LIFO across backends without hidden closure capture.
class Box {
    tag: string
    constructor(tag: string) { this.tag = tag }
    drop() { print("drop " + this.tag) }
}

fn cleanup(msg: string) { print("fn " + msg) }

fn mix() {
    var box = Box("B")
    defer { print("builtin") }
    defer { cleanup("free") }
    defer { box.drop() }
    defer { print("block") }
    print("body")
    // LIFO: block, drop B, fn free, builtin
}

mix()
print("done")
