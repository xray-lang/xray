// anchor: defer-in-suspendable-coroutine
// Static cleanup regions in an await-containing coroutine keep their active
// frontier in the coroutine frame. Registrations before and after an await
// survive suspension and run LIFO. The cleanup-live place for `c` also keeps
// its native-class instance alive through the await.
class Conn {
    id: int
    constructor(id: int) { this.id = id }
    close() { print("close conn " + string(this.id)) }
}

fn leaf(n: int) -> int { return n + 1 }

fn worker(id: int) -> int {
    var c = Conn(id)
    defer { c.close() }                           // method-call defer, held across await
    defer { print("defer-builtin " + string(id)) }
    print("before-await " + string(id))
    var r = await go leaf(id)
    defer { print("defer-after " + string(r)) }   // registered AFTER suspension
    print("after-await " + string(r))
    return r * 10
    // LIFO at exit: defer-after, defer-builtin, close conn
}

var t = go worker(7)
print(await t)
print("done")
