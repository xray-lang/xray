fn main() {
    var scores = #{"alice": 95, "bob": 88}
    scores.set("carol", 77)
    print(scores.get("alice") ?? 0)   // prints 95
    print(len(scores))                 // prints 3

    var seen = Set<i64>()
    seen.add(1)
    seen.add(2)
    seen.add(2)
    print(len(seen))          // prints 2
    print(seen.contains(1))   // prints true
}

main()
