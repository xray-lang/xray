var x = 1               // x: i64
var y = 1.5             // y: f64
var z = "hello"         // z: string
var a = [1, 2, 3]       // a: Array<i64>
var m = #{"a": 1}    // m: Map<string, i64>
var p = { name: "A" }   // p: { name: string } — structured object type
var f = (x: i64) => x   // f: fn(i64) -> i64 — explicit parameter, inferred return
