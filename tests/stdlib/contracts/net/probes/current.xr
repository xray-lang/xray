import net

fn emit(name: string, ok: bool) {
    print("{\"case\":\"" + name + "\",\"outcome\":\"value\",\"value\":" + string(ok) + ",\"error\":null,\"effects\":{\"transport\":\"loopback\"}}")
}

fn highServer(listener: NetListener) -> bool {
    var conn = net.accept(listener)!
    var buffer = Array<u8>(16)
    var n = net.readInto(conn, ref buffer, 16)
    var written = net.writeBytes(conn, buffer)
    net.close(conn)
    return n == 5 && written == 5
}

fn highClient(port: i64) -> bool {
    var conn = net.dial("127.0.0.1", port)
    net.writeBytes(conn, Array<u8>([195, 169, 226, 130, 172]))
    var buffer = Array<u8>(16)
    var n = net.readInto(conn, ref buffer, 16)
    net.close(conn)
    return n == 5 && buffer[0] == 195 && buffer[4] == 172
}

fn copyServer(listener: NetListener) -> bool {
    var conn = net.accept(listener)!
    var copied = net.copy(conn, conn)
    net.close(conn)
    return copied == 6
}

fn copyClient(port: i64) -> bool {
    var conn = net.dial("127.0.0.1", port)
    net.writeBytes(conn, Array<u8>([110, 97, 116, 105, 118, 101]))
    net.shutdownWrite(conn)
    var buffer = Array<u8>(16)
    var n = net.readInto(conn, ref buffer, 16)
    var ok = n == 6 && buffer[0] == 110 && buffer[5] == 101
    net.close(conn)
    return ok
}

fn run() {
    var highListener = net.listen(0, 8)
    var highServerTask = go highServer(highListener)
    var highClientTask = go highClient(highListener.port())
    var highOk = await highClientTask
    highOk = (await highServerTask) && highOk
    net.close(highListener)
    emit("high-byte-loopback", highOk)

    var copyListener = net.listen(0, 8)
    var copyServerTask = go copyServer(copyListener)
    var copyClientTask = go copyClient(copyListener.port())
    var copyOk = await copyClientTask
    copyOk = (await copyServerTask) && copyOk
    net.close(copyListener)
    emit("native-copy-byte-boundary", copyOk)
}

run()
