import regex

print(regex.findText((try regex.compile("\\p{Han}+")), "Hello你好World世界"))
print(regex.findText((try regex.compile("\\p{L}+")), "123abc"))
print(regex.findText((try regex.compile("\\p{N}+")), "abc123def"))
print(regex.findText((try regex.compile("\\p{Latin}+")), "你好HelloWorld"))
print(regex.findText((try regex.compile("\\P{Han}+")), "你好World"))
print(regex.findText((try regex.compile("\\p{ASCII}+")), "Hello世界"))
print(regex.findText((try regex.compile("\\p{Hiragana}+")), "Helloひらがな世界"))
print(regex.findText((try regex.compile("\\p{Katakana}+")), "Helloカタカナ世界"))
print(regex.findText((try regex.compile("\\p{Letter}+")), "123abc你好"))
print(regex.findText((try regex.compile("\\p{han}+")), "A中文B"))
print(regex.test((try regex.compile("^.$")), "中"))
print(regex.test((try regex.compile("é", "i")), "É"))
