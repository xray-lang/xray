import runtime

let reset = 0
while (reset < 255) {
    runtime.enableCycleCollection()
    reset = reset + 1
}
assert(runtime.isCycleCollectionEnabled())
runtime.disableCycleCollection()
assert(!runtime.isCycleCollectionEnabled())
runtime.enableCycleCollection()
assert(runtime.isCycleCollectionEnabled())
print("{\"case\":\"cycle-collector-toggle\",\"outcome\":\"value\",\"value\":true,\"error\":null,\"effects\":{\"states\":[true,false,true]}}")

assert(runtime.liveBytes() >= 0)
assert(runtime.liveObjects() >= 0)
assert(runtime.collectCycles() >= 0)
let info = runtime.info()
assert(info["liveBytes"] >= 0)
assert(info["liveObjects"] >= 0)
assert(info["cycleCollections"] >= 0)
print("{\"case\":\"heap-counters\",\"outcome\":\"value\",\"value\":true,\"error\":null,\"effects\":{}}")
