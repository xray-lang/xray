import test_yield

assert(test_yield.sync() == 100)
print("{\"case\":\"sync-baseline\",\"outcome\":\"value\",\"value\":100,\"error\":null,\"effects\":{}}")

assert(test_yield.simple() == 42)
assert(test_yield.add(19, 23) == 42)
print("{\"case\":\"yield-resume\",\"outcome\":\"value\",\"value\":42,\"error\":null,\"effects\":{\"resumes\":2}}")

test_yield.counter_reset()
assert(test_yield.counter_get() == 0)
assert(test_yield.counter_inc() == 1)
assert(test_yield.counter_inc() == 2)
assert(test_yield.counter_get() == 2)
print("{\"case\":\"atomic-counter\",\"outcome\":\"value\",\"value\":2,\"error\":null,\"effects\":{\"sequence\":[0,1,2,2]}}")
