import test_yield

let syncValue = test_yield.sync()
print("{\"case\":\"sync-baseline\",\"outcome\":\"value\",\"value\":" + string(syncValue) + ",\"error\":null,\"effects\":{}}")

let simpleValue = test_yield.simple()
let addValue = test_yield.add(19, 23)
print("{\"case\":\"yield-resume\",\"outcome\":\"value\",\"value\":[" + string(simpleValue) + "," + string(addValue) + "],\"error\":null,\"effects\":{\"resumes\":2}}")

test_yield.counter_reset()
let counter0 = test_yield.counter_get()
let counter1 = test_yield.counter_inc()
let counter2 = test_yield.counter_inc()
let counterFinal = test_yield.counter_get()
print("{\"case\":\"atomic-counter\",\"outcome\":\"value\",\"value\":[" + string(counter0) + "," + string(counter1) + "," + string(counter2) + "," + string(counterFinal) + "],\"error\":null,\"effects\":{}}")
