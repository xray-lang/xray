import {
    probeSeed,
    probeAdd,
    probeSum,
    probeDeferValue,
    probeMakeAdder,
    probeApply,
    ProbeBox,
    probeMakeBox,
    probeReadBox,
    ProbeCell,
    probeMakeBag
} from _probe
import _probe

assert(probeSeed == 148)
assert(probeSum() == 0)
assert(probeSum(1, 2, 3) == 6)
assert(probeDeferValue(5) == 13)
assert(probeMakeAdder(10)(5) == 15)
assert(probeApply(7, (v) -> v * 3) == 21)
assert(probeReadBox(probeMakeBox("n", 5)) == "n:5")
assert(ProbeBox.tagged("s", 3).describe() == "tag:s:3")
assert(ProbeCell<int>(21).map((v) -> v * 2) == 42)
assert(probeMakeBag().labels() == "a:1|tag:b:2")
print("{\"case\":\"shape-matrix\",\"outcome\":\"value\",\"value\":true,\"error\":null,\"effects\":{}}")

assert(probeAdd(3, 4) == 7)
assert(_probe.probeAdd(20, 22) == 42)
assert(_probe.probeSum(10, 20, 30) == 60)
print("{\"case\":\"aot-direct-call\",\"outcome\":\"value\",\"value\":true,\"error\":null,\"effects\":{}}")
