/*
** 04_mixed_workload.xr - 混合负载测试
** 作者：xingleixu@gmail.com
**
** 测试目的：验证工作窃取在混合负载下的表现
** 测试方法：同时运行计算密集型和 IO 密集型协程
*/
import time

enum WsErr { Failed(string) }

print("========== 测试4：混合负载测试 ==========")
/* 测试参数 */
const CPU_COROS = 20
const IO_COROS = 20
const CPU_WORK = 2000
const IO_SLEEP_MS = 10

/* 计算密集型协程 */
fn cpu_intensive(id: i64) -> i64 {
    var sum = 0
    for (var i = 0; i < CPU_WORK; i++) {
        sum = sum + i * id
    }
    return sum
}

/* IO 密集型协程（模拟 IO 等待）*/
fn io_intensive(id: i64) -> i64 {
    time.sleep(IO_SLEEP_MS)
    return id * 100
}

/* 启动混合协程 */
print("启动 " + string(CPU_COROS) + " 个 CPU 密集型 + " + string(IO_COROS) + " 个 IO 密集型协程...")
var start_time = time.monotonic()
var cpu_tasks: Array<Task> = []
var io_tasks: Array<Task> = []
/* CPU 密集型 */
for (var i = 0; i < CPU_COROS; i++) {
    var id = i
    var task = go cpu_intensive(id)
    cpu_tasks.push(task)
}
/* IO 密集型 */
for (var i = 0; i < IO_COROS; i++) {
    var id = i + CPU_COROS
    var task = go io_intensive(id)
    io_tasks.push(task)
}
/* 等待所有完成 */
print("等待所有协程完成...")
var cpu_completed = 0
var io_completed = 0
for (var i = 0; i < len(cpu_tasks); i++) {
    var result: i64 = await cpu_tasks[i]
    if (result >= 0) {
        cpu_completed = cpu_completed + 1
    }
}
for (var i = 0; i < len(io_tasks); i++) {
    var result: i64 = await io_tasks[i]
    if (result >= 0) {
        io_completed = io_completed + 1
    }
}
var total_time = time.monotonic() - start_time
/* 结果 */
print("\n结果:")
print("  CPU 密集型完成: " + string(cpu_completed))
print("  IO 密集型完成: " + string(io_completed))
print("  总耗时: " + string(total_time) + " ms")
/* 验证 */
if (cpu_completed == CPU_COROS && io_completed == IO_COROS) {
    print("\n✓ 混合负载测试通过")
} else {
    print("\n✗ 测试失败")
    throw WsErr.Failed("混合负载测试失败")
}
/* 性能分析：总时间应该接近 IO 等待时间，而不是 CPU + IO */
var expected_sequential = (CPU_COROS * 10) + (IO_COROS * IO_SLEEP_MS)
print("  串行预估耗时: ~" + string(expected_sequential) + " ms")
print("  实际耗时: " + string(total_time) + " ms")
if (total_time < expected_sequential) {
    var speedup = (expected_sequential as f64) / (total_time as f64)
    print("  并行加速比: " + string(speedup) + "x")
    print("✓ 并行执行有效")
}
print("========== 测试4 完成 ==========")
