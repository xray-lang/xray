/*
** 01_basic_stealing.xr - 基础工作窃取测试
** 作者：xingleixu@gmail.com
**
** 测试目的：验证工作窃取的基本功能正确性
** 测试方法：创建多个协程，验证所有协程都能执行完成
*/
import time

enum WsErr { Failed(string) }

print("========== 测试1：基础工作窃取 ==========")
/* 测试参数 */
const CORO_COUNT = 100
const WORK_PER_CORO = 1000
let completed = 0
let all_correct = true

/* 计算密集型工作函数 */
fn compute_work(id: int, iterations: int) -> int {
    let sum = 0
    for (let i = 0; i < iterations; i++) {
        sum = sum + i * id
    }
    return sum
}

/* 启动多个协程 */
print("启动 " + string(CORO_COUNT) + " 个协程...")
let start_time = time.monotonic()
let tasks: Array<Task> = []
for (let i = 0; i < CORO_COUNT; i++) {
    let task = go compute_work(i, WORK_PER_CORO)
    tasks.push(task)
}
/* 等待所有协程完成 */
print("等待所有协程完成...")
for (let i = 0; i < tasks.length; i++) {
    let result: int = await tasks[i]
    let expected = compute_work(i, WORK_PER_CORO)
    if (result != expected) {
        print("✗ 协程 " + string(i) + " 结果错误")
        all_correct = false
    }
    completed = completed + 1
}
let end_time = time.monotonic()
let elapsed = end_time - start_time
/* 验证结果 */
print("完成协程数: " + string(completed))
print("耗时: " + string(elapsed) + " ms")
/* 检查所有协程都完成了 */
if (completed == CORO_COUNT) {
    print("✓ 基础工作窃取测试通过：所有协程都完成了")
} else {
    print("✗ 测试失败：有协程未完成")
    throw WsErr.Failed("基础工作窃取测试失败")
}
if (all_correct) {
    print("✓ 所有协程计算结果正确")
} else {
    throw WsErr.Failed("计算结果验证失败")
}
print("========== 测试1 完成 ==========")
