// detector_closure_cycle.xr — 闭包环必须被检出，并给出 defer 建议
//
// 这是 247 §2.4 裁决能成立的前提：不引入 `[weak self]`，因为最常见的形态
// 编译期就报（A.6）；剩下的间接形态由检测器兜底，而 `weak` 是字段修饰符，
// 管不到捕获边——所以对全闭包边构成的环，检测器只能建议 defer。
//
// 用的是 A.6 明确**不报**的一级间接形态（`o.holder.handler = ...`），
// 直接形态在 tests/compile_errors/cycles/247_closure_cycle_direct.xr。

class Holder {
    handler: fn() -> i64
    constructor() { this.handler = fn() -> i64 { return 0 } }
}

class Owner {
    holder: Holder
    value: i64
    constructor() { this.holder = Holder(); this.value = 0 }
    bump() -> i64 { this.value = this.value + 1; return this.value }
}

fn indirect_closure_cycle() {
    var o = Owner()
    o.holder.handler = fn() -> i64 { return o.bump() }
}

indirect_closure_cycle()
print("closure cycle built")
