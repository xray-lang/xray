// detector_shapes.xr — 环检测器的形态覆盖（任务 247 阶段 D §6.6）
//
// 用 XR_ENABLE_CYCLE_DETECTOR=ON 的构建跑，由 run_detector_probes.sh 驱动。
// 断言在脚本里（比对检测器的机器可读输出），不在这里——检测器**不提供**
// 任何 stdlib 入口（§0.3：不得制造第二个空钩子），所以 .xr 侧看不见它。
//
// 阶段 E 移除 ORC 之后，运行时不再回收任何环，所以这里不需要（也无法）关掉
// 收集器：环一定还在，检测器该看见的就是它们。

// L0 的 Map 值边（G1）——修复前这类环根本不被标为候选
class MapNode {
    peers: Map<string, MapNode>
    constructor() { this.peers = #{} }
}

// 直接字段环
class Plain {
    peer: Plain?
    tag: i64
    constructor(tag) { this.peer = null; this.tag = tag }
}

// union 成员中的类（G3：修复前只取首个命中成员）
class UnionNode {
    peer: i64 | string | UnionNode | null
    constructor() { this.peer = null }
}

// 大对象参与：元素缓冲超过 XR_LARGE_OBJECT_THRESHOLD，走 large_set 而非块内
class BigNode {
    pad: Array<i64>
    peer: BigNode?
    constructor() { this.pad = Array<i64>(2000, 0); this.peer = null }
}

fn map_cycle() { var a = MapNode(); var b = MapNode(); a.peers["n"] = b; b.peers["n"] = a }
fn plain_cycle() { var a = Plain(1); var b = Plain(2); a.peer = b; b.peer = a }
fn union_cycle() { var a = UnionNode(); var b = UnionNode(); a.peer = b; b.peer = a }
fn big_cycle() { var a = BigNode(); var b = BigNode(); a.peer = b; b.peer = a }

// 自环：一个对象指向自己
fn self_cycle() { var a = Plain(3); a.peer = a }

// 三元环：确认分组不把长度写死成 2
fn triangle() {
    var a = Plain(4)
    var b = Plain(5)
    var c = Plain(6)
    a.peer = b
    b.peer = c
    c.peer = a
}

// 在协程里构造，而不是顶层。
//
// 顶层的容器字面量（`#{}` / `[]`）会落到 fixed_heap 上并被打上 XR_OBJ_MANAGED，
// 而图遍历的 child_eligible 会跳过 MANAGED 对象 —— 于是环里凡是经过一个容器
// 的边都断在那里，Map 值边的形态整个看不见。协程堆上的容器没有这个标记。
//
// 这也更贴近检测器要服务的场景：它扫的就是协程堆，L2 边界也是按协程算的。
fn build_all() {
    map_cycle()
    plain_cycle()
    union_cycle()
    big_cycle()
    self_cycle()
    triangle()
}

var t = go build_all()
await t
print("shapes built")
