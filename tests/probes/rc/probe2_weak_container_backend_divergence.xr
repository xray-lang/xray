// probe2 — 弱容器在 VM 与 AOT 上语义相反（任务 247 的 §1.1）
//
// 247 §1.1 的静态结论：
//
//   行为                 VM                          AOT
//   key 的强引用         插入后立即 release（真弱）   从不 release（永久持有）
//   对象死亡钩子         rc_destroy_one 调 purge     不存在
//   delete / 覆写 / 销毁 正常释放                    三处均跳过
//
//   ⇒ AOT 的 WeakMap 是一个只进不出的强 Map：key 永远不死，
//     containsKey(k) 永远 true，每次 delete/覆写/销毁都泄漏一份 key+value。
//
// 247 §1.2 记录：该差异**零测试覆盖**——三个现有用例中 key 全程存活，
// "key 失去最后一个强引用之后"这一弱容器唯一有意义的场景，两条后端一个
// 用例都没有。本探针就是补上那个场景。
//
// 用法：由 run_probes.sh 在 VM 与 AOT 上并排运行并比对输出。单跑一条后端
// 无法暴露分歧——这正是它当年没被发现的原因。
//
// 归宿：247 阶段 B 原子删除 WeakMap / WeakSet 后，本探针连同它们一起退休；
// 届时应被 tests/compile_errors/ 中的"未知类型"负例取代。

import runtime

class Key {
    id: int

    constructor(id) {
        this.id = id
    }
}

// 弱容器唯一有意义的场景：key 失去最后一个强引用之后会怎样。
@test
fn test_weak_map_after_key_loses_its_last_strong_reference() {
    var wm: WeakMap<Key, string> = WeakMap()

    var live: Array<Key> = []
    for (var i = 0; i < 1000; i++) {
        var k = Key(i)
        wm.set(k, "v" + string(i))
        // 前 500 个保活，后 500 个立即失去最后一个强引用
        if (i < 500) {
            live.push(k)
        }
    }

    var before = runtime.liveObjects()
    // 保活的 key 必须仍在
    assert(len(live) == 500)
    assert(wm.containsKey(live[0]))

    var after = runtime.liveObjects()
    print("probe2 weakmap live_objects_delta=" + string(after - before))
    print("probe2 weakmap retained_key_present=" + string(wm.containsKey(live[0])))
}

@test
fn test_weak_set_after_element_loses_its_last_strong_reference() {
    var ws: WeakSet<Key> = WeakSet()

    var live: Array<Key> = []
    for (var i = 0; i < 1000; i++) {
        var k = Key(i)
        ws.add(k)
        if (i < 500) {
            live.push(k)
        }
    }

    assert(len(live) == 500)
    assert(ws.contains(live[0]))
    print("probe2 weakset retained_element_present=" + string(ws.contains(live[0])))
}

// delete / 覆写路径：AOT 侧这三处都跳过 release，每次操作泄漏一份 key+value。
@test
fn test_weak_map_delete_and_overwrite_paths() {
    var wm: WeakMap<Key, string> = WeakMap()
    var k = Key(1)

    wm.set(k, "first")
    wm.set(k, "second") // 覆写
    assert(wm.get(k) == "second")

    var before = runtime.liveBytes()
    for (var i = 0; i < 20000; i++) {
        var tmp = Key(i)
        wm.set(tmp, "x")
        wm.delete(tmp)
    }
    var after = runtime.liveBytes()
    print("probe2 weakmap churn_live_bytes_delta=" + string(after - before))
}
