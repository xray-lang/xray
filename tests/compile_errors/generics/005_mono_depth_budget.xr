// A chain of 132 generic classes, each specialising the next, exceeds the
// XR_MONO_MAX_DEPTH nesting budget. Depth is the only guard that can catch a
// diverging expansion, because every round mints a genuinely new type tuple.

class C0<T> {
    v: T
    constructor(v: T) { this.v = v }
    get() -> T {
        var n = C1<T>(this.v)
        return n.get()
    }
}
