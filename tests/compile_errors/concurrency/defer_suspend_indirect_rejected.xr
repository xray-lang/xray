// The rule is an effect rule, so it also catches a defer body that calls a
// function which suspends.
fn drain(ch: Channel<i64>) -> i64 {
    match (ch.recv()) {
        Recv.Value { value: v } -> { return v }
        _ -> { return -1 }
    }
}

fn body(ch: Channel<i64>) -> i64 {
    defer { print(drain(ch)) }
    return 1
}

const ch = Channel<i64>(1)
ch.send(7)
var t = go body(ch)
match (t.awaitResult()) {
    TaskResult.Success { value: v } -> print(v)
    _ -> print("other")
}
ch.close()
