// The rule is an effect, not a syntax check: a called function that suspends is
// rejected exactly like an inline `await`.
fn work() -> i64 { return 7 }

fn helper() -> i64 {
    var t = go work()
    return await t
}

fn gen() -> Iterator<i64> {
    yield helper()
}

for (x in gen()) { print(x) }
