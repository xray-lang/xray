// for-in consumes the collection whole, so a still-nullable one must be
// narrowed or asserted first — the same rule as `x.f` / `x[i]`. Without the
// check this reached lowering and panicked at runtime with
// "value does not implement Lengthable".
fn main() {
    var a: Array<i64>? = [1, 2, 3]
    for (i in a) {
        print(i)
    }
}
main()
