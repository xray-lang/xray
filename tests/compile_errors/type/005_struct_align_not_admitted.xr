// An alignment beyond the portable maximum is refused at the declaration.
//
// `align(N)` is carried through the value plan up to one portable allocation
// alignment; a larger promise cannot be kept on every supported platform, so
// the declaration is rejected instead of silently running at the natural
// alignment. Positive coverage for the admitted range lives in the alignment
// lowering fixture, so opening this gate further needs that range raised first.
struct Aligned16 align(16) {
    value: i64
}
print(1)
