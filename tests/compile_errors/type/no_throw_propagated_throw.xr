// @no_throw must account for transitively propagated errors: calling a
// throwing helper makes the caller may-throw, so the assertion fails
// (task 216, propagation).
enum ParseErr { Bad }

fn parse() -> int {
    throw ParseErr.Bad
}

@no_throw
fn wrapper() -> int {
    return parse()
}

fn main() {
    try {
        print(wrapper())
    } catch (e: ParseErr) {
    }
}
