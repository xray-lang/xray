// Same rule as 143, but through the explicit type-argument path: writing
// innerShape<T>(...) must not smuggle T past a constraint it does not carry.
// T is bounded by Animal; U demands the unrelated interface Shape.
//
// Positive coverage: tests/regression/12_type_checking/1251_generic_constraint_forwarding.xr

interface Shape {
    area() -> float
}

class Animal {
    name: string

    constructor(name) {
        this.name = name
    }
}

fn innerShape<U: Shape>(y: U) -> float {
    return y.area()
}

fn outerAnimal<T: Animal>(x: T) -> float {
    return innerShape<T>(x)
}

print(outerAnimal(Animal("rex")))
