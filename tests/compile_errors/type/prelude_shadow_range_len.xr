// A user-declared `class Range` is not Lengthable — it neither implements
// the interface nor is it the builtin Range — so len() must be rejected at
// compile time instead of panicking with 404 at runtime.

class Range {
    v: int
    constructor(v: int) { this.v = v }
}

fn main() {
    var r = Range(3)
    print(len(r))
}

main()
