// A `@no_suspend (...) -> R` callback parameter rejects a suspending argument
// at the call site (task 217, function-type-position constraint).
fn worker() -> int {
    return 1
}

fn suspends() {
    var t = go worker()
    await t
}

fn onEnter(cb: @no_suspend () -> ()) {
    cb()
}

fn main() {
    onEnter(suspends)
}
