// `?.` covers exactly one access. The result is nullable, so the next link in
// the chain must be written `?.` as well; a bare `.` is a possibly-null access.
class Leaf {
    c: int
    constructor() { this.c = 7 }
}

class Mid {
    b: Leaf
    constructor() { this.b = Leaf() }
}

class Root {
    a: Mid?
    constructor() { this.a = null }
}

var r = Root()
print("${r.a?.b.c}")
