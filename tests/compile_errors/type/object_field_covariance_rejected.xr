// Object fields are invariant. Accepting a narrower field type in the widening
// direction would let the wider view store a value the narrower view still
// promises to hold at its own type, and object shapes are reference values with
// mutable fields, so both views observe the same storage.
class Animal { name: string  constructor(n: string) { this.name = n } }
class Dog extends Animal {
    constructor(n: string) { super(n) }
    bark() -> string { return "woof" }
}

type HasAnimal = { p: Animal }
type HasDog = { p: Dog }

var d: HasDog = { p: Dog("rex") }
var a: HasAnimal = d
a.p = Animal("generic")
print(d.p.bark())
