// 049_fixed_width_checked_unsupported.xr
// Expected: Compile error - checked/saturating/overflows families on
// fixed-width int receivers are rejected (R2-2 stopgap): the runtime would
// compute them at int64 width and silently use the wrong overflow boundary.
fn main() {
    var a: int32 = 2147483647
    print(a.checkedAdd(1))
}
main()
