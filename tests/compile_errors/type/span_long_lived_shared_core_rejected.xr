fn keepBytes(bytes: Array<u8>) -> Slice<u8> {
    var view: Slice<u8> = bytes[1:4]
    return view
}

fn keepInts(values: Array<i64>) -> Slice<i64> {
    var view: Slice<i64> = values[1:3]
    return view
}

var bytes = Array<u8>(0)
bytes.push(1)
bytes.push(2)
bytes.push(3)
bytes.push(4)

var bv: Slice<u8> = bytes[1:4]
print(len(bv))
print(bv[0])
bv[1] = 8
print(bytes[2])
bytes.push(9)
print(len(bv))
print(bv[1])

var keptBytes = keepBytes(bytes)
print(len(keptBytes))
print(keptBytes[0])

var snapshot: Array<u8> = copy(bv)
print(len(snapshot))
print(snapshot[1])

var values: Array<i64> = [10, 20, 30, 40]
var iv: Slice<i64> = values[1:3]
print(len(iv))
print(iv[0])
iv[1] = 300
print(values[2])
values.push(50)
print(len(iv))
print(iv[1])

var keptInts = keepInts(values)
print(len(keptInts))
print(keptInts[1])

var total = 0
for (x in iv) {
    total += x
}
print(total)
