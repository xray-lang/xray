fn check(values: Array<i64>) -> i64 {
    var view: Slice<i64> = values[:]
    return (view.load<u16>(0, Endian.LE) as i64)
}

fn checkStore(values: Array<i64>) {
    var view: Slice<i64> = values[:]
    view.store<u16>(0, 1, Endian.LE)
}

fn checkCommonPrefix(left: Array<i64>, right: Array<i64>) -> i64 {
    var leftView: Slice<i64> = left[:]
    var rightView: Slice<i64> = right[:]
    return leftView.commonPrefix(rightView)
}

fn checkRepeat(values: Array<i64>) {
    var view: Slice<i64> = values[:]
    view.repeatFrom(0, 1, 2)
}
