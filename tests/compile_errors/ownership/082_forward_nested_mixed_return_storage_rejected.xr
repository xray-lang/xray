fn main() {
    var value = wrap(true)
    print(len(value))
}

fn wrap(flag: bool) -> Array<u8> {
    return choose(flag)
}

fn choose(flag: bool) -> Array<u8> {
    var ownedBuf = Array<u8>(1, 1)
    const sharedBuf = copy(ownedBuf)
    if (flag) {
        return ownedBuf
    }
    return sharedBuf
}

main()
