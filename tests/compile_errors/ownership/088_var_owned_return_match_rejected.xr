fn makeA() -> Array<u8> {
    var a = Array<u8>(1, 0)
    return move a
}

fn makeB() -> Array<u8> {
    var b = Array<u8>(2, 0)
    return move b
}

fn choose(tag: i64) -> Array<u8> {
    return match (tag) {
        0 -> makeA(),
        _ -> makeB()
    }
}

fn main() {
    var local = choose(0)
    print(len(local))
}

main()
