fn makeA() -> Array<byte> {
    owned a = Array<byte>(1, 0)
    return move a
}

fn makeB() -> Array<byte> {
    owned b = Array<byte>(2, 0)
    return move b
}

fn choose(tag: int) -> Array<byte> {
    return match (tag) {
        0 -> makeA(),
        _ -> makeB()
    }
}

fn main() {
    var local = choose(0)
    print(len(local))
}

main()
