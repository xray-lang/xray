fn makeOwned() -> Array<byte> {
    var a = Array<byte>(1, 0)
    return move a
}

fn makeShared() -> Array<byte> {
    var b = Array<byte>(2, 0)
    const frozen = move b
    return frozen
}

fn choose(flag: bool) -> Array<byte> {
    return flag ? makeOwned() : makeShared()
}

fn main() {
    var local = choose(true)
    print(len(local))
}

main()
