struct NestedMissingLeaf {
    x: int
    y: int
}

struct NestedMissingPair {
    left: NestedMissingLeaf
    right: int
}

fn fill(value: out int) {
    value = 1
}

fn bad(pair: out NestedMissingPair) {
    fill(out pair.left.x)
    pair.right = 2
    var whole = pair
    pair = NestedMissingPair{left: whole.left, right: whole.right}
}
