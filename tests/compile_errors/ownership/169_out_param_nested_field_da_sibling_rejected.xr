struct NestedSiblingLeaf {
    x: int
    y: int
}

struct NestedSiblingPair {
    left: NestedSiblingLeaf
    right: int
}

fn fill(value: out int) {
    value = 1
}

fn bad(pair: out NestedSiblingPair) {
    fill(out pair.left.x)
    var sibling = pair.left.y
    pair = NestedSiblingPair{left: NestedSiblingLeaf{x: 1, y: sibling}, right: 2}
}
