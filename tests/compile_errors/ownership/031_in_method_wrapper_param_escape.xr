class Holder {
    items: Array<Array<int>>

    constructor() {
        this.items = []
    }

    outer(value: Array<int>) {
        this.middle(value)
    }

    middle(value: Array<int>) {
        this.store(value)
    }

    store(value: Array<int>) {
        this.items.push(value)
    }
}

fn stash(data: in Array<int>, holder: ref Holder) {
    holder.outer(data)
}

var values: Array<int> = [1, 2]
var holder = Holder()
stash(values, ref holder)
