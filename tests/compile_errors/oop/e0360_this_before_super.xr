// super() 之前实例还没被父类初始化，读 this.name 读到的是未定义的存储。
class Animal {
    name: string
    constructor(name: string) { this.name = name }
}
class Dog extends Animal {
    label: string
    constructor(name: string) {
        var shown = this.name
        super(name)
        this.label = shown
    }
}
var d = Dog("rex")
print(d.label)
