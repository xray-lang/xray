// A user class whose name matches a builtin native handle type (core.def
// `handle`, here os.ExecResult) must be rejected: the handle would silently
// shadow the class and AOT lowers field access through the handle/Json path
// against a class-instance layout — a guaranteed crash (known_bugs 2026-07-02
// gap C'). Until handle names become module-scoped, the analyzer rejects the
// collision outright.
class ExecResult {
    out: string
    code: int

    constructor(out: string, code: int) {
        this.out = out
        this.code = code
    }
}

let r = ExecResult("hi", 0)
print(r.out)
