// 父类构造函数必须在派生类碰任何东西之前跑完，所以 super() 只能排在第一条。
class Animal {
    name: string
    constructor(name: string) { this.name = name }
}
class Dog extends Animal {
    breed: string
    constructor(name: string, breed: string) {
        var tag = breed
        super(name)
        this.breed = tag
    }
}
var d = Dog("rex", "husky")
print(d.name)
