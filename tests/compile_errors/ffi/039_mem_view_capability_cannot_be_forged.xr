import mem

extern "C" {
    struct Header {
        value: uint32
    }
}

fn leak() -> Slice<Header> {
    var guard = Array<uint8>(4)
    var p = mem.mutPtr<Header>(0)
    return unsafe {
        mem.withSliceMut<Header>(p, 1, ref guard,
            fn(view: ref Slice<Header>) -> Slice<Header> { return view })
    }
}

print(len(leak()))
