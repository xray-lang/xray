// Task 264 D4. A callback may declare fewer parameters than the function type
// it is passed as: xr_type_assignable checks only an upper bound on parameter
// count, so nothing rejects the short form. Builtin HOFs tolerate it because
// their contract over-declares an index parameter the runtime never passes;
// a user-declared HOF has nothing that accommodates it and calls with the
// arity it wrote, so the closure traps.
//
// A two-parameter lambda compiles and runs to completion; the one-parameter
// short form is now rejected at compile time by the parameter-count lower
// bound in xr_type_assignable, so this file expects a compile error.
fn userHof(f: fn(i64, i64) -> i64) -> i64 { return f(10, 5) }

fn main() {
    print(userHof((a) -> a * 100))
}

main()
