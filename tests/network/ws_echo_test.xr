/*
 * ws_echo_test.xr - WebSocket echo test
 */

import ws

print("=== WebSocket Echo Test ===")

const TEST_URL = "wss://ws.postman-echo.com/raw"

print("Connecting to: " + TEST_URL)
var conn = ws.connect(TEST_URL, null)

if (conn.error != null) {
    print("Connection error: " + conn.error!)
} else {
    print("Connected!")
    print("Open: " + string(conn.isOpen()))

    // Send message
    print("Sending message...")
    var sent = conn.sendText("Hello WebSocket!")
    if (sent) {
        print("Message sent!")
    } else {
        print("Send failed")
    }

    // Receive echo
    print("Waiting for echo...")
    var msg = conn.recv(5000)
    if (msg == null) {
        print("recv returned null (timeout)")
    } else if (msg!.error != null) {
        print("Recv error: " + msg!.error!)
    } else {
        var text = msg!.text()
        if (text != null) {
            print("Received: " + text!)
        } else {
            print("No data in message")
        }
    }

    // Close
    print("Closing...")
    conn.close()
    print("Closed!")
}

print("Test complete!")
