// HTTP 错误处理测试
import http
import { HttpError } from http

fn test_empty_url() {
    var rejected = false
    try {
        http.request({url: ""})
    } catch (e: HttpError) {
        rejected = true
    }
    assert(rejected)
}

fn test_invalid_domain() {
    var rejected = false
    try {
        http.request({url: "http://invalid.nonexistent.domain.xray/"})
    } catch (e: HttpError) {
        rejected = true
    }
    assert(rejected)
}

fn test_status_500() {
    var resp = http.request({url: "http://httpbin.org/status/500"})
    assertEqual(resp.status, 500)
    assertEqual(resp.isSuccess(), false)
}
