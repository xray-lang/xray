/*
 * ws_simple_test.xr - simple WebSocket smoke test
 */

import ws

print("WebSocket module loaded!")
print("")
print("=== Testing different WebSocket servers ===")

// Test servers
var servers = [
    "wss://ws.postman-echo.com/raw",
    "wss://echo.websocket.org",
    "wss://socketsbay.com/wss/v2/1/demo/"
]

for (server in servers) {
    print("")
    print("Trying: " + server)
    var conn = ws.connect(server, null)

    if (conn.error != null) {
        print("  Error: " + conn.error!)
    } else {
        print("  Connected!")
        print("  Open: " + string(conn.isOpen()))
        conn.close()
        print("  Closed")
    }
}

print("")
print("Test complete!")
