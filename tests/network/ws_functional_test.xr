/*
 * ws_functional_test.xr - WebSocket 功能测试
 *
 * 测试 ws 模块的基本功能
 */

import ws
import time

print("=== WebSocket 功能测试 ===")
print("")

// 测试服务器 - 使用 postman echo 服务
const TEST_URL = "wss://ws.postman-echo.com/raw"

/* 测试 1: 基本连接 */
fn test_connect() -> bool {
    print("[测试 1] 基本连接...")

    var conn = ws.connect(TEST_URL, null)

    if (conn.error != null) {
        print("  连接失败: " + conn.error!)
        return false
    }

    print("  连接成功")
    print("  URL: " + conn.url)
    print("  Open: " + string(conn.isOpen()))

    conn.close()
    print("  连接已关闭")
    return true
}

/* 测试 2: 发送和接收消息 */
fn test_send_recv() -> bool {
    print("")
    print("[测试 2] 发送和接收消息...")

    var conn = ws.connect(TEST_URL, null)
    if (conn.error != null) {
        print("  连接失败: " + conn.error!)
        return false
    }

    // 发送消息
    var testMsg = "Hello from xray WebSocket!"
    var sent = conn.sendText(testMsg)
    if (!sent) {
        print("  发送失败")
        conn.close()
        return false
    }
    print("  已发送: " + testMsg)

    // 接收回显
    var msg = conn.recv(5000)
    if (msg == null || msg!.error != null) {
        print("  接收失败")
        conn.close()
        return false
    }

    var text = msg!.text()
    if (text == null) {
        print("  接收到空消息")
        conn.close()
        return false
    }
    print("  已接收: " + text!)

    // 验证回显
    var ok = text! == testMsg
    if (ok) {
        print("  回显验证通过")
    } else {
        print("  回显不匹配")
    }

    conn.close()
    return ok
}

/* 测试 3: 多条消息 */
fn test_multiple_messages() -> bool {
    print("")
    print("[测试 3] 多条消息...")

    var conn = ws.connect(TEST_URL, null)
    if (conn.error != null) {
        print("  连接失败: " + conn.error!)
        return false
    }

    var messages = ["消息1", "消息2", "消息3", "Hello", "World"]
    var success = 0

    for (m in messages) {
        conn.sendText(m)
        var resp = conn.recv(5000)
        if (resp != null && resp!.error == null) {
            var t = resp!.text()
            if (t != null && t! == m) {
                success = success + 1
            }
        }
    }

    print("  发送/接收: " + success.toString() + "/" + len(messages).toString())

    conn.close()

    if (success == len(messages)) {
        print("  所有消息验证通过")
        return true
    } else {
        print("  部分消息失败")
        return false
    }
}

/* 测试 4: 连接结果状态字段 */
fn test_state() -> bool {
    print("")
    print("[测试 4] 连接结果状态字段...")

    var conn = ws.connect(TEST_URL, null)
    if (conn.error != null) {
        print("  连接失败: " + conn.error!)
        return false
    }

    // 检查打开状态
    if (conn.isOpen()) {
        print("  isOpen() = true (连接已打开)")
    } else {
        print("  isOpen() 应该为 true")
        conn.close()
        return false
    }

    // 检查错误字段
    if (conn.error == null) {
        print("  error = null (无错误)")
    } else {
        print("  error 应该为 null")
        conn.close()
        return false
    }

    // 关闭后检查状态
    conn.close()
    print("  关闭后 isOpen(): " + string(conn.isOpen()))

    return true
}

/* 测试 5: Ping 保活 */
fn test_ping() -> bool {
    print("")
    print("[测试 5] Ping 保活...")

    var conn = ws.connect(TEST_URL, null)
    if (conn.error != null) {
        print("  连接失败: " + conn.error!)
        return false
    }

    var pingOk = conn.ping()
    if (pingOk) {
        print("  Ping 发送成功")
    } else {
        print("  Ping 发送失败")
        conn.close()
        return false
    }

    conn.close()
    return true
}

/* 测试 6: 连接失败处理 */
fn test_connection_failure() -> bool {
    print("")
    print("[测试 6] 连接失败处理...")

    var conn = ws.connect("ws://invalid.nonexistent.domain.xyz/ws", null)

    if (conn.error != null) {
        print("  正确处理连接失败")
        print("  错误信息: " + conn.error!)
        return true
    } else {
        print("  应该返回错误")
        conn.close()
        return false
    }
}

/* 运行所有测试 */
fn main() {
    var passed = 0
    var total = 6

    if (test_connect()) { passed = passed + 1 }
    if (test_send_recv()) { passed = passed + 1 }
    if (test_multiple_messages()) { passed = passed + 1 }
    if (test_state()) { passed = passed + 1 }
    if (test_ping()) { passed = passed + 1 }
    if (test_connection_failure()) { passed = passed + 1 }

    print("")
    print("=== 测试结果 ===")
    print("通过: " + passed.toString() + "/" + total.toString())

    if (passed == total) {
        print("所有测试通过!")
    } else {
        print("有测试失败")
    }
}

main()
