/*
 * xray_echo_server.xr - WebSocket echo server for functional testing
 *
 * Echoes back any message received (text or binary).
 * Default port: 9100
 */

import ws
import { WsConn } from ws

var port = 9100
if (len(process.args) > 0) {
    // int(s) throws on a non-decimal argument (spec 13.2) rather than
    // yielding a null to fall back from.
    port = int(process.args[0])
}

print("=== WebSocket Echo Server (Pure Benchmark) ===")
print("Port: " + port.toString())
print("Mode: pure echo (zero-copy)")
print("")

// serve runs one coroutine per accepted connection until `running` clears.
const running = Atomic(true)

ws.serve(port, fn(conn: ref WsConn) {
    while (true) {
        var msg = conn.recv()
        if (msg == null || msg!.error != null) {
            break
        }
        var data = msg!.data
        if (data != null) {
            conn.sendBytes(data!, msg!.binary)
        }
    }
}, running)
