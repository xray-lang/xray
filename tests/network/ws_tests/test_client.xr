/*
 * test_client.xr - Test xray as WebSocket client against Python echo server
 *
 * Expects Python echo server running on ws://127.0.0.1:9101
 */

import ws
import time

var URL = "ws://127.0.0.1:9101"
var passed = 0
var failed = 0

fn report(name, ok, detail) {
    if (ok) {
        passed = passed + 1
        print("  PASS  " + name)
    } else {
        failed = failed + 1
        print("  FAIL  " + name + " -- " + (detail ?? ""))
    }
}

// C1: Basic ws:// connect
fn test_connect() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C1 connect", false, conn!.error)
        return
    }
    var open = conn.state == "open"
    ws.close(conn, null, null)
    report("C1 connect", open, null)
}

// C2: Text echo
fn test_text_echo() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C2 text echo", false, conn!.error)
        return
    }
    var msg = "Hello from xray client!"
    ws.send(conn, msg, null)
    var resp = ws.recv(conn, null)
    var ok = resp != null && resp.data == msg
    ws.close(conn, null, null)
    report("C2 text echo", ok, ok ? null : "mismatch")
}

// C3: Multiple messages
fn test_multiple_messages() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C3 multiple messages", false, conn!.error)
        return
    }
    var count = 10
    var success = 0
    for (var i = 0; i < count; i = i + 1) {
        var msg = "msg-" + i.toString()
        ws.send(conn, msg, null)
        var resp = ws.recv(conn, null)
        if (resp != null && resp.data == msg) {
            success = success + 1
        }
    }
    ws.close(conn, null, null)
    report("C3 multiple messages", success == count,
           success.toString() + "/" + count.toString())
}

// C4: Connection result state field
fn test_connection_state_field() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C4 state field", false, conn!.error)
        return
    }
    var s1 = conn.state == "open"
    var s2 = conn.error == null
    ws.close(conn, null, null)
    var ok = s1 && s2
    report("C4 state field", ok, null)
}

// C5: Close changes connection field state
fn test_close_state() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C5 close state", false, conn!.error)
        return
    }
    ws.close(conn, null, null)
    var s = conn.state
    var ok = s == "closed"
    report("C5 close state", ok, "state=" + s)
}

// C6: Connection failure
fn test_connection_failure() {
    var conn = ws.connect("ws://127.0.0.1:19999", null)
    var ok = conn!.error != null
    report("C6 connection failure", ok, ok ? null : "should have error")
}

// C7: Ping
fn test_ping() {
    var conn = ws.connect(URL, null)
    if (conn!.error) {
        report("C7 ping", false, conn!.error)
        return
    }
    var ok = ws.ping(conn)
    // Verify echo still works after ping
    ws.send(conn, "after-ping", null)
    var resp = ws.recv(conn, null)
    var echo_ok = resp != null && resp.data == "after-ping"
    ws.close(conn, null, null)
    report("C7 ping", ok && echo_ok, null)
}

print("=== Testing xray WebSocket Client ===")
print("Target: " + URL)
print("")

test_connect()
test_text_echo()
test_multiple_messages()
test_connection_state_field()
test_close_state()
test_connection_failure()
test_ping()

print("")
print("=== Results: " + passed.toString() + " passed, " + failed.toString() + " failed ===")
