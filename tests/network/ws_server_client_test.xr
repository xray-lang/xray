/*
 * ws_server_client_test.xr - WebSocket server + client integration test
 *
 * Tests the coroutine-per-connection model:
 * 1. Start server in one coroutine
 * 2. Connect client in another coroutine
 * 3. Exchange messages
 * 4. Verify echo response
 */

import ws
import time
import { WsConn } from ws

print("=== WebSocket Server/Client Integration Test ===")

// Shared, coroutine-safe flags: `running` stops the server accept loop and
// `testPassed` reports the client verdict back to the main coroutine.
const running = Atomic(true)
const testPassed = Atomic(false)

// Server coroutine
go fn() {
    print("[Server] Starting on port 8766...")

    ws.serve(8766, fn(conn: ref WsConn) {
        print("[Server] Client connected")

        while (true) {
            var msg = conn.recv()
            if (msg == null || msg!.error != null) {
                break
            }
            var text = msg!.text()
            if (text != null) {
                print("[Server] Received: " + text!)
                conn.sendText("Echo: " + text!)
            }
        }

        print("[Server] Client disconnected")
    }, running)
}()

// Wait for server to start
time.sleep(100)

// Client coroutine
go fn() {
    print("[Client] Connecting to ws://localhost:8766...")

    var conn = ws.connect("ws://localhost:8766", null)
    if (conn.error != null) {
        print("[Client] Connection error: " + conn.error!)
        running.store(false)
        return
    }

    print("[Client] Connected!")

    // Send test message
    print("[Client] Sending: Hello Server!")
    conn.sendText("Hello Server!")

    // Receive echo
    var msg = conn.recv(5000)
    if (msg != null && msg!.error == null) {
        var text = msg!.text()
        if (text != null) {
            print("[Client] Received: " + text!)
            if (text! == "Echo: Hello Server!") {
                print("[Client] Test PASSED!")
                testPassed.store(true)
            } else {
                print("[Client] Test FAILED - unexpected response")
            }
        } else {
            print("[Client] Test FAILED - no response")
        }
    } else {
        print("[Client] Test FAILED - no response")
    }

    // Close connection
    conn.close()
    print("[Client] Disconnected")

    // Stop server
    running.store(false)
}()

// Wait for test to complete
time.sleep(2000)

if (testPassed.load()) {
    print("\n=== ALL TESTS PASSED ===")
} else {
    print("\n=== TESTS FAILED ===")
}
