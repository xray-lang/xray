// EXPECTED: 9
// EXPECTED: 12
// EXPECTED: 12
// EXPECTED: 14
// Test: Tuple construction, projection, and destructuring in JIT

fn tuple_main() {
    let checksum = 0
    let i = 0
    while (i < 200) {
        let t = (i + 1, i + 2, i + 3)
        let (a, b, c) = t
        checksum = checksum + a + t.1 + c
        i = i + 1
    }

    let p = (9, 12)
    print(p.0)
    print(p.1)

    let q = (2, 4)
    let (x, y) = q
    print(q.0 + q.1 + x + y)

    let r = (3, 4, 7)
    print(r.0 + r.1 + r.2)
}

tuple_main()
