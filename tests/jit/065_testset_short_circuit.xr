// EXPECTED: true
// EXPECTED: false
// EXPECTED: false
// EXPECTED: true
// Test: Short-circuit evaluation (TESTSET) and logical operators in JIT.
// Per language spec 3.3.4, && / || take bool operands and yield bool
// (they do not return an operand like JS); short-circuit still drives the
// JIT TESTSET path.

fn or_test(a: bool, b: bool) -> bool {
    return a || b
}

fn and_test(a: bool, b: bool) -> bool {
    return a && b
}

let i = 0
while (i < 200) {
    or_test(false, true)
    or_test(true, false)
    and_test(true, true)
    and_test(false, true)
    i = i + 1
}

print(or_test(false, true))   // true
print(and_test(true, false))  // false
print(or_test(false, false))  // false
print(and_test(true, true))   // true
