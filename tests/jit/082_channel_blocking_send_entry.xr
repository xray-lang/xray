// EXPECTED: Recv.Value(11)
// Test: JIT coroutine entry blocks in Channel.send() and resumes after recv.

shared const ch: Channel<int> = new Channel()

fn blocking_sender() {
    ch.send(11)
}

fn receiver() {
    print(ch.recv())
}

let t1 = go blocking_sender()
let t2 = go receiver()
await t1
await t2
ch.close()
