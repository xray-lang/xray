// EXPECTED: error: bad value
// EXPECTED: cleanup ran
// Test: throw (value-return error channel) + defer cleanup in JIT

enum AppErr { Bad(msg: string) }

fn validate(x: int) {
    if (x < 0) {
        throw AppErr.Bad("bad value")
    }
}

fn run() {
    defer { print("cleanup ran") }
    try {
        validate(-1)
    } catch (e) {
        match (e) { AppErr.Bad(m) -> { print("error: " + m) } }
    }
}

run()
