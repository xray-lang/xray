// EXPECTED: 3
// EXPECTED: 3.0
// EXPECTED: ab
// EXPECTED: null
// Test: Deopt at different code positions within same function
// (`process` is a reserved builtin global, so the helper is named `classify`.)

fn classify(x: int | float | string | null) -> int | float | string | null {
    if (x == null) {
        return null
    }
    if (typeof(x) == "string") {
        return x + x.substring(1, 2)
    }
    if (typeof(x) == "float") {
        return x + x
    }
    return x + x - x
}

// Warm up with int
let i = 0
while (i < 200) {
    classify(i)
    i = i + 1
}

print(classify(3))
print(classify(1.5))
print(classify("a"))
print(classify(null))
