// EXPECTED: Recv.Value(22)
// Test: JIT coroutine entry blocks in Channel.recv() and resumes after send.

shared const ch: Channel<int> = new Channel()

fn blocking_receiver() {
    print(ch.recv())
}

fn sender() {
    ch.send(22)
}

let t1 = go blocking_receiver()
let t2 = go sender()
await t1
await t2
ch.close()
