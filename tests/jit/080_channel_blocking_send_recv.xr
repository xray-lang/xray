// EXPECTED: Recv.Value(11)
// EXPECTED: Recv.Value(22)
// Test: source-level Channel.send()/recv() JIT suspend/resume on unbuffered channels.

shared const send_first: Channel<int> = new Channel()
shared const recv_first: Channel<int> = new Channel()

fn blocking_sender() {
    send_first.send(11)
}

fn recv_from_sender() {
    print(send_first.recv())
}

fn blocking_receiver() {
    print(recv_first.recv())
}

fn send_to_receiver() {
    recv_first.send(22)
}

let t1 = go blocking_sender()
let t2 = go recv_from_sender()
await t1
await t2

let t3 = go blocking_receiver()
let t4 = go send_to_receiver()
await t3
await t4

send_first.close()
recv_first.close()
