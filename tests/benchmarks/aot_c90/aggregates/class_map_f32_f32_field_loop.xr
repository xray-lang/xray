class FloatMapBag {
    values: Map<f32, f32>

    constructor() {
        var values: Map<f32, f32> = #{}
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.set((i as f32) + 0.5, (i as f32) * 0.25 + 1.0)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: int, rounds: int) -> float {
        var r = 0
        var sum = 0.0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                var key: f32 = (i as f32) + 0.5
                if (this.values.containsKey(key)) {
                    sum = sum + this.values.get(key)!
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_f32_f32_field_loop_run(n: int, rounds: int) -> float {
    var bag = FloatMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + (count as float)
}

print(class_map_f32_f32_field_loop_run(64, 5000))
