struct Point {
    x: i64
    y: i64
    step: i64
}

struct Box {
    point: Point
    bias: i64
}

var box = Box{point: Point{x: 1, y: 2, step: 3}, bias: 5}

fn run(n: i64) -> i64 {
    var i = 0
    var sum = 0
    while (i < n) {
        box.point.x = box.point.x + i
        box.point.y = box.point.y + box.point.step
        sum = sum + box.point.x - box.point.y + box.bias
        i = i + 1
    }
    return sum + box.point.x + box.point.y + box.bias
}

print(run(2000000))
