struct Cell {
    a: i64
    b: i64
    step: i64
}

var cell = Cell{a: 1, b: 2, step: 3}

fn run(n: i64) -> i64 {
    var p = cell
    var i = 0
    var sum = 0
    while (i < n) {
        p.a = p.a + i
        p.b = p.b + p.step
        sum = sum + p.a - p.b
        i = i + 1
    }
    return sum + p.a + p.b
}

print(run(2000000))
