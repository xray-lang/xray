class Counter {
    value: i64
    step: i64

    constructor(init: i64, step: i64) {
        this.value = init
        this.step = step
    }

    bump(n: i64) -> i64 {
        var i = 0
        var sum = 0
        while (i < n) {
            this.value = this.value + this.step
            sum = sum + this.value
            i = i + 1
        }
        return sum + this.value
    }
}

fn run(n: i64) -> i64 {
    var c = Counter(1, 3)
    return c.bump(n)
}

print(run(2000000))
