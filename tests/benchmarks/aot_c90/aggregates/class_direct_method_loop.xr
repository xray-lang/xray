class Counter {
    value: int
    step: int

    constructor(init: int, step: int) {
        this.value = init
        this.step = step
    }

    bump(n: int) -> int {
        var i = 0
        var sum = 0
        while (i < n) {
            this.value = this.value + this.step
            sum = sum + this.value
            i = i + 1
        }
        return sum + this.value
    }
}

fn run(n: int) -> int {
    var c = Counter(1, 3)
    return c.bump(n)
}

print(run(2000000))
