class BoolIntMapBag {
    values: Map<bool, int>

    constructor() {
        let values: Map<bool, int> = #{}
        this.values = values
    }

    fill() -> int {
        this.values.set(true, 21)
        this.values.set(false, 34)
        return this.values.size
    }

    scan(rounds: int) -> int {
        let r = 0
        let sum = 0
        while (r < rounds) {
            if (this.values.has(true)) {
                sum = sum + this.values.get(true)
            }
            if (this.values.has(false)) {
                sum = sum + this.values.get(false)
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_bool_i64_field_loop_run(rounds: int) -> int {
    let bag = BoolIntMapBag()
    let count = bag.fill()
    return bag.scan(rounds) + count
}

print(class_map_bool_i64_field_loop_run(400000))
