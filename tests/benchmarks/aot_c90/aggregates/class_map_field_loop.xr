class IntMapBag {
    values: Map<i64, i64>

    constructor() {
        var values: Map<i64, i64> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set(i, i * 3 + 1)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64, rounds: i64) -> i64 {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.containsKey(i)) {
                    sum = sum + this.values.get(i)!
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_field_loop_run(n: i64, rounds: i64) -> i64 {
    var bag = IntMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_field_loop_run(64, 5000))
