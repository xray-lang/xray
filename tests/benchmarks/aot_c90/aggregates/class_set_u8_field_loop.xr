class ByteSetBag {
    values: Set<byte>

    constructor() {
        var values: Set<byte> = #[]
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.add(i as byte)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: int, rounds: int) -> int {
        var r = 0
        var hits = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.contains(i as byte)) {
                    hits = hits + i
                }
                i = i + 1
            }
            r = r + 1
        }
        return hits
    }

    prune(n: int) -> int {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i as byte)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }
}

fn class_set_u8_field_loop_run(n: int, rounds: int) -> int {
    var bag = ByteSetBag()
    var count = bag.fill(n)
    var sum = bag.scan(n, rounds)
    return sum + count + bag.prune(n)
}

print(class_set_u8_field_loop_run(64, 5000))
