class IntBoolMapBag {
    values: Map<int, bool>

    constructor() {
        var values: Map<int, bool> = #{}
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.set(i, i % 3 == 0)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: int, rounds: int) -> int {
        var r = 0
        var total = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.containsKey(i)) {
                    if (this.values.get(i) == true) {
                        total = total + 1
                    }
                }
                i = i + 1
            }
            r = r + 1
        }
        return total
    }
}

fn class_map_i64_bool_field_loop_run(n: int, rounds: int) -> int {
    var bag = IntBoolMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_i64_bool_field_loop_run(64, 5000))
