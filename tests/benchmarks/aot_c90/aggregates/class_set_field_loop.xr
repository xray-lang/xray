class IntSetBag {
    values: Set<int>

    constructor() {
        var values: Set<int> = #[]
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.add(i)
            i = i + 1
        }
        return this.values.length + this.values.size
    }

    scan(n: int, rounds: int) -> int {
        var r = 0
        var hits = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.has(i)) {
                    hits = hits + i
                }
                i = i + 1
            }
            r = r + 1
        }
        return hits
    }

    prune(n: int) -> int {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + this.values.length
    }
}

fn class_set_field_loop_run(n: int, rounds: int) -> int {
    var bag = IntSetBag()
    var count = bag.fill(n)
    var sum = bag.scan(n, rounds)
    return sum + count + bag.prune(n)
}

print(class_set_field_loop_run(64, 5000))
