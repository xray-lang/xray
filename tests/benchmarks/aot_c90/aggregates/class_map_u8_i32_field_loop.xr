class ByteMapBag {
    values: Map<byte, int32>

    constructor() {
        var values: Map<byte, int32> = #{}
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.set(i, i * 5 + 7)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: int, rounds: int) -> int {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.containsKey(i)) {
                    sum = sum + this.values.get(i)
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_u8_i32_field_loop_run(n: int, rounds: int) -> int {
    var bag = ByteMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_u8_i32_field_loop_run(128, 5000))
