class ByteMapBag {
    values: Map<u8, i32>

    constructor() {
        var values: Map<u8, i32> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set(i as u8, (i * 5 + 7) as i32)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64, rounds: i64) -> i64 {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                if (this.values.containsKey(i as u8)) {
                    sum = sum + this.values.get(i as u8)!
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_u8_i32_field_loop_run(n: i64, rounds: i64) -> i64 {
    var bag = ByteMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_u8_i32_field_loop_run(128, 5000))
