class Shape {
    kind: i64

    constructor(kind: i64) {
        this.kind = kind
    }
}

class Rect extends Shape {
    w: i64
    h: i64

    constructor(w: i64, h: i64) {
        super(7)
        this.w = w
        this.h = h
    }

    area() -> i64 {
        return this.w * this.h
    }

    ref score(n: i64) -> i64 {
        var i = 0
        var sum = 0
        while (i < n) {
            this.w = this.w + (sum % 3)
            sum = sum + this.area() + this.kind
            i = i + 1
        }
        return sum
    }
}

fn run(n: i64) -> i64 {
    var r = Rect(3, 4)
    return r.score(n)
}

print(run(2000000))
