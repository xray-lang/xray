class IntBag {
    values: Array<int>

    constructor(values: Array<int>) {
        this.values = values
    }

    scan(rounds: int) -> int {
        let r = 0
        let sum = 0
        while (r < rounds) {
            let i = 0
            while (i < this.values.length) {
                sum = sum + this.values[i]
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn make_values(n: int) -> Array<int> {
    let values: Array<int> = []
    let i = 0
    while (i < n) {
        values.push(i * 3 + 1)
        i = i + 1
    }
    return values
}

fn class_array_field_loop_run(rounds: int) -> int {
    let bag = IntBag(make_values(256))
    return bag.scan(rounds)
}

print(class_array_field_loop_run(20000))
