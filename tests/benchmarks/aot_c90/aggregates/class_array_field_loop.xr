class IntBag {
    values: Array<int>

    constructor(values: Array<int>) {
        this.values = values
    }

    scan(rounds: int) -> int {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < len(this.values)) {
                sum = sum + this.values[i]
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn make_values(n: int) -> Array<int> {
    var values: Array<int> = []
    var i = 0
    while (i < n) {
        values.push(i * 3 + 1)
        i = i + 1
    }
    return values
}

fn class_array_field_loop_run(rounds: int) -> int {
    var bag = IntBag(make_values(256))
    return bag.scan(rounds)
}

print(class_array_field_loop_run(20000))
