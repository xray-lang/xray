class BoolFloatMapBag {
    values: Map<bool, float32>

    constructor() {
        let values: Map<bool, float32> = #{}
        this.values = values
    }

    fill() -> int {
        this.values.set(true, 1.5)
        this.values.set(false, 2.25)
        return this.values.size
    }

    scan(rounds: int) -> float {
        let r = 0
        let sum = 0.0
        while (r < rounds) {
            if (this.values.has(true)) {
                sum = sum + this.values.get(true)
            }
            if (this.values.has(false)) {
                sum = sum + this.values.get(false)
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_bool_f32_field_loop_run(rounds: int) -> float {
    let bag = BoolFloatMapBag()
    let count = bag.fill()
    return bag.scan(rounds) + count
}

print(class_map_bool_f32_field_loop_run(400000))
