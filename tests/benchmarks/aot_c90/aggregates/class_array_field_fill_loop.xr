class FillBag {
    values: Array<int>

    constructor() {
        var values: Array<int> = []
        this.values = values
    }

    fill(n: int, rounds: int) -> int {
        var values: Array<int> = []
        this.values = values

        var i = 0
        while (i < n) {
            this.values.push(i * 3 + 1)
            i = i + 1
        }

        var r = 0
        var sum = 0
        while (r < rounds) {
            var j = 0
            while (j < len(this.values)) {
                sum = sum + this.values[j]
                j = j + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_array_field_fill_loop_run(rounds: int) -> int {
    var bag = FillBag()
    return bag.fill(256, rounds)
}

print(class_array_field_fill_loop_run(20000))
