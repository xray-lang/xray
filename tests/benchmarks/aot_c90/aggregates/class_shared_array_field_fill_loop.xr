class SharedFillBag {
    values: Array<int>

    constructor() {
        let values: Array<int> = []
        this.values = values
    }

    fill(n: int, rounds: int) -> int {
        let values: Array<int> = []
        this.values = values

        let i = 0
        while (i < n) {
            this.values.push(i * 3 + 1)
            i = i + 1
        }

        let r = 0
        let sum = 0
        while (r < rounds) {
            let j = 0
            while (j < this.values.length) {
                sum = sum + this.values[j]
                j = j + 1
            }
            r = r + 1
        }
        return sum
    }
}

let shared_bag = SharedFillBag()

fn class_shared_array_field_fill_loop_run(rounds: int) -> int {
    return shared_bag.fill(256, rounds)
}

print(class_shared_array_field_fill_loop_run(20000))
