class FloatIntMapBag {
    values: Map<float32, int>

    constructor() {
        var values: Map<float32, int> = #{}
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.set(i + 0.5, i * 3 + 1)
            i = i + 1
        }
        return this.values.size
    }

    scan(n: int, rounds: int) -> int {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                var key = i + 0.5
                if (this.values.has(key)) {
                    sum = sum + this.values.get(key)
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_f32_i64_field_loop_run(n: int, rounds: int) -> int {
    var bag = FloatIntMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_f32_i64_field_loop_run(64, 5000))
