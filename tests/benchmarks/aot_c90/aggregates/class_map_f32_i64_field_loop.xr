class FloatIntMapBag {
    values: Map<f32, i64>

    constructor() {
        var values: Map<f32, i64> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set((i as f32) + 0.5, i * 3 + 1)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64, rounds: i64) -> i64 {
        var r = 0
        var sum = 0
        while (r < rounds) {
            var i = 0
            while (i < n) {
                var key: f32 = (i as f32) + 0.5
                if (this.values.containsKey(key)) {
                    sum = sum + this.values.get(key)!
                }
                i = i + 1
            }
            r = r + 1
        }
        return sum
    }
}

fn class_map_f32_i64_field_loop_run(n: i64, rounds: i64) -> i64 {
    var bag = FloatIntMapBag()
    var count = bag.fill(n)
    return bag.scan(n, rounds) + count
}

print(class_map_f32_i64_field_loop_run(64, 5000))
