struct Pair {
    a: i64
    b: i64
    scale: i64
}

fn run(n: i64) -> i64 {
    var p = Pair{a: 1, b: 2, scale: 3}
    var i = 0
    var sum = 0
    while (i < n) {
        p.a = p.a + i
        p.b = p.b + p.scale
        sum = sum + p.a - p.b
        i = i + 1
    }
    return sum + p.a + p.b
}

print(run(2000000))
