fn run(n: i64) -> i64 {
    var values: Array<i64> = []
    var i = 0
    while (i < n) {
        values.push((i * 17) % 251)
        i = i + 1
    }

    var mapped = values.map(fn(x: i64) -> i64 { return x * 3 + 5 })

    var sum = 0
    i = 0
    while (i < len(mapped)) {
        sum = sum + mapped[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
