fn run(n: int) -> int {
    var values: Array<int> = []
    var i = 0
    while (i < n) {
        values.push((i * 17) % 251)
        i = i + 1
    }

    var mapped = values.map(fn(x: int) -> int { return x * 3 + 5 })

    var sum = 0
    i = 0
    while (i < mapped.length) {
        sum = sum + mapped[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
