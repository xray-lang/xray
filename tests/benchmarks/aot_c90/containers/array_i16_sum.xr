fn run(n: int) -> int {
    let vals: Array<int16> = []
    let i = 0
    while (i < n) {
        vals.push((i % 65536) - 32768)
        i = i + 1
    }

    let sum = 0
    i = 0
    while (i < vals.length) {
        sum = sum + vals[i] * ((i % 5) + 1)
        i = i + 1
    }
    return sum
}

print(run(200000))
