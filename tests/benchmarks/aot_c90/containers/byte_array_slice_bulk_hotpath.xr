fn run(n: i64, rounds: i64) -> i64 {
    var seed = Array<u8>(n)
    var i = 0
    while (i < n) {
        seed[i] = (i * 17 + 3) as u8
        i = i + 1
    }

    var out: Array<u8> = Array.withCapacity(n * 2)
    out.appendFrom(seed[:])
    out.repeatFrom(n, n)

    var copy = Array<u8>(n * 2, 0)
    var outView: Slice<u8> = out[:]
    var copyView: Slice<u8> = copy[:]
    var total = 0
    var r = 0
    while (r < rounds) {
        var copied: Slice<u8> = copyView.copyFrom(outView)
        total = total + len(copied)

        var p = 0
        while (p < n * 2) {
            var word: u16 = copyView.load<u16>(p, Endian.LE)
            copyView.store<u16>(p, word + 1, Endian.LE)
            p = p + 64
        }

        total = total + copyView.commonPrefix(outView)
        total = total + copyView.compare(outView)
        r = r + 1
    }
    return total + (copy[0] as i64) + (copy[n] as i64) + len(out)
}

print(run(4096, 8000))
