fn run(n: int) -> int {
    let vals: Array<uint32> = []
    let i = 0
    while (i < n) {
        vals.push(2147483648 + (i % 4096))
        i = i + 1
    }

    let sum = 0
    i = 0
    while (i < vals.length) {
        sum = sum + vals[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
