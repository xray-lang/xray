fn run(n: i64) -> i64 {
    var vals: Array<u32> = []
    var i = 0
    while (i < n) {
        vals.push((2147483648 + (i % 4096)) as u32)
        i = i + 1
    }

    var sum = 0
    i = 0
    while (i < len(vals)) {
        sum = sum + (vals[i] as i64)
        i = i + 1
    }
    return sum
}

print(run(200000))
