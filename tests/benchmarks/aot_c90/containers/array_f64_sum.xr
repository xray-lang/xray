fn run(n: i64) -> f64 {
    var values: Array<f64> = []
    var i = 0
    var x = 1.0
    while (i < n) {
        values.push(x)
        x = x + 0.25
        if (x > 17.0) {
            x = 1.0
        }
        i = i + 1
    }

    var sum = 0.0
    i = 0
    while (i < len(values)) {
        sum = sum + values[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
