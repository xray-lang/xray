fn run(n: int) -> int {
    var values: Array<int> = []
    var i = 0
    while (i < n) {
        values.push((i * 17) % 251)
        i = i + 1
    }

    var kept = values.filter(fn(x: int) -> bool { return (x % 3) == 1 })

    var sum = 0
    i = 0
    while (i < kept.length) {
        sum = sum + kept[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
