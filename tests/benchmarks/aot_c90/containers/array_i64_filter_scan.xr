fn run(n: i64) -> i64 {
    var values: Array<i64> = []
    var i = 0
    while (i < n) {
        values.push((i * 17) % 251)
        i = i + 1
    }

    var kept = values.filter(fn(x: i64) -> bool { return (x % 3) == 1 })

    var sum = 0
    i = 0
    while (i < len(kept)) {
        sum = sum + kept[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
