fn run(n: int) -> int {
    var vals: Array<i32> = []
    var i = 0
    while (i < n) {
        vals.push(((i % 65536) - 32768) as i32)
        i = i + 1
    }

    var sum = 0
    i = 0
    while (i < len(vals)) {
        sum = sum + vals[i] * ((i % 3) + 1)
        i = i + 1
    }
    return sum
}

print(run(200000))
