fn run(n: int, rounds: int) -> int {
    var bytes = Array<byte>(n)

    var i = 0
    while (i < len(bytes)) {
        bytes[i] = i * 3 + 1
        i = i + 1
    }

    var r = 0
    var sum = 0
    while (r < rounds) {
        var j = 0
        while (j < len(bytes)) {
            sum = sum + bytes[j]
            j = j + 1
        }
        r = r + 1
    }
    return sum
}

print(run(256, 20000))
