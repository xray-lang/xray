fn run(n: int, rounds: int) -> int {
    let bytes = Bytes(n)

    let i = 0
    while (i < bytes.length) {
        bytes[i] = i * 3 + 1
        i = i + 1
    }

    let r = 0
    let sum = 0
    while (r < rounds) {
        let j = 0
        while (j < bytes.length) {
            sum = sum + bytes[j]
            j = j + 1
        }
        r = r + 1
    }
    return sum
}

print(run(256, 20000))
