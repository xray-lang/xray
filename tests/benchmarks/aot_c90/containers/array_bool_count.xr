fn run(n: i64) -> i64 {
    var flags: Array<bool> = []
    var i = 0
    while (i < n) {
        flags.push((i % 5) == 0)
        i = i + 1
    }

    var count = 0
    i = 0
    while (i < len(flags)) {
        if (flags[i]) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

print(run(200000))
