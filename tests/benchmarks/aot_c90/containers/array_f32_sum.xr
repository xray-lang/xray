fn run(n: int) -> float {
    let values: Array<float32> = []
    let i = 0
    let x = 1.0
    while (i < n) {
        values.push(x)
        x = x + 0.25
        if (x > 17.0) {
            x = 1.0
        }
        i = i + 1
    }

    let sum = 0.0
    i = 0
    while (i < values.length) {
        sum = sum + values[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
