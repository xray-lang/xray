fn run(n: i64, rounds: i64) -> i64 {
    var bytes = Array<u8>(n)
    var limit = len(bytes)

    var i = 0
    while (i < limit) {
        bytes[i] = (i * 3 + 1) as u8
        i = i + 1
    }

    var r = 0
    var sum = 0
    while (r < rounds) {
        var j = 0
        while (j < limit) {
            sum = sum + (bytes[j] as i64)
            j = j + 1
        }
        r = r + 1
    }
    return sum
}

print(run(256, 200000))
