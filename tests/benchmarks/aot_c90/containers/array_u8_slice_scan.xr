fn run(n: int) -> int {
    var bytes: Array<byte> = []
    var i = 0
    while (i < n) {
        bytes.push(i as byte)
        i = i + 1
    }

    var mid: Slice<byte> = bytes[17:n - 17]
    var sum = 0
    i = 0
    while (i < len(mid)) {
        sum = sum + (mid[i] as int)
        i = i + 1
    }
    return sum
}

print(run(200000))
