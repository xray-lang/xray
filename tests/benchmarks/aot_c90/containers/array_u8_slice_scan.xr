fn run(n: int) -> int {
    let bytes: Array<uint8> = []
    let i = 0
    while (i < n) {
        bytes.push(i)
        i = i + 1
    }

    let mid = bytes[17:n - 17]
    let sum = 0
    i = 0
    while (i < mid.length) {
        sum = sum + mid[i]
        i = i + 1
    }
    return sum
}

print(run(200000))
