fn run(n: i64) -> i64 {
    var values: Array<i64> = []
    var seed = 123456789
    var i = 0
    while (i < n) {
        seed = (seed * 1103515245 + 12345) % 2147483648
        values.push(seed)
        i = i + 1
    }

    values.sort()

    var checksum = values[0] + values[n / 2] + values[n - 1]
    i = 0
    while (i < n) {
        checksum = checksum + values[i] % 7
        i = i + 7919
    }
    return checksum
}

print(run(1000000))
