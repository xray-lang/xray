fn run(n: int) -> int {
    var m: Map<string, int> = #{}

    var i = 0
    while (i < n) {
        var key = "user:" + ((i * 7) % n).toString()
        m.set(key, i)
        i = i + 1
    }

    var sum = 0
    i = 0
    while (i < n) {
        var key = "user:" + i.toString()
        if (m.has(key)) {
            sum = sum + m.get(key)
        }
        i = i + 1
    }

    return sum + m.size
}

print(run(60000))
