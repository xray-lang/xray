fn run(n: i64) -> i64 {
    var values: Array<string> = []
    var i = 0
    while (i < n) {
        values.push("item-" + ((i * 37) % 5000).toString() + "-tail")
        i = i + 1
    }

    values.sort()

    var checksum = len(values[0]) + len(values[n / 2]) + len(values[n - 1])
    i = 0
    while (i < n) {
        checksum = checksum + len(values[i])
        i = i + 997
    }
    return checksum
}

print(run(100000))
