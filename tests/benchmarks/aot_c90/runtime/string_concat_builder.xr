fn run(rounds: int, parts: int) -> int {
    let total = 0
    let r = 0
    while (r < rounds) {
        let s = ""
        let i = 0
        while (i < parts) {
            s = s + "part-" + (i % 10).toString() + ";"
            i = i + 1
        }
        total = total + s.length
        r = r + 1
    }
    return total
}

print(run(4000, 40))
