fn run(rounds: i64, parts: i64) -> i64 {
    var total = 0
    var r = 0
    while (r < rounds) {
        var s = ""
        var i = 0
        while (i < parts) {
            s = s + "part-" + (i % 10).toString() + ";"
            i = i + 1
        }
        total = total + len(s)
        r = r + 1
    }
    return total
}

print(run(4000, 40))
