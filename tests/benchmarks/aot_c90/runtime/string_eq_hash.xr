fn run(n: int) -> int {
    let keys: Array<string> = []
    let i = 0
    while (i < n) {
        keys.push("key-" + ((i * 31) % 1000).toString())
        i = i + 1
    }

    let counts: Map<string, int> = #{}
    i = 0
    while (i < n) {
        let k = keys[i]
        if (counts.has(k)) {
            counts.set(k, counts.get(k) + 1)
        } else {
            counts.set(k, 1)
        }
        i = i + 1
    }

    let eq = 0
    i = 0
    while (i < n - 1) {
        if (keys[i] == keys[i + 1]) {
            eq = eq + 1
        }
        i = i + 1
    }

    return counts.size + eq + counts.get("key-0")
}

print(run(400000))
