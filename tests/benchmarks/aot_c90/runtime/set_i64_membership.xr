fn run(n: int, rounds: int) -> int {
    let s: Set<int> = #[]

    let i = 0
    while (i < n) {
        s.add(i * 2)
        i = i + 1
    }

    let hits = 0
    let r = 0
    while (r < rounds) {
        i = 0
        while (i < n * 2) {
            if (s.has(i)) {
                hits = hits + 1
            }
            i = i + 1
        }
        r = r + 1
    }

    return hits + s.size
}

print(run(150000, 4))
