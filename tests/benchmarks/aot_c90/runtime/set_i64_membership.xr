fn run(n: i64, rounds: i64) -> i64 {
    var s: Set<i64> = #[]

    var i = 0
    while (i < n) {
        s.add(i * 2)
        i = i + 1
    }

    var hits = 0
    var r = 0
    while (r < rounds) {
        i = 0
        while (i < n * 2) {
            if (s.contains(i)) {
                hits = hits + 1
            }
            i = i + 1
        }
        r = r + 1
    }

    return hits + len(s)
}

print(run(150000, 4))
