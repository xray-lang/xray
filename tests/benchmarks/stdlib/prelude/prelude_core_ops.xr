// Deterministic prelude micro-benchmark.
//
// The prelude is installed implicitly (public = false, no import), so this
// workload exercises the bootstrap integer arithmetic / operator surface it
// provides. The checksum is pure integer math, so the output is identical
// across VM and AOT and stable across runs.
fn run(n: int) -> int {
    var acc = 0
    var i = 0
    while (i < n) {
        acc = (acc + ((i * 2654435761) % 1000000007)) % 1000000007
        i = i + 1
    }
    return acc
}

print(run(200000))
