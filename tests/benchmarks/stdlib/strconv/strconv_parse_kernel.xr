// Deterministic strconv CPU kernel.
//
// Parses a fixed set of valid and invalid integer literals many times and folds
// the results (including the null/failure path) into an integer checksum. Pure
// CPU, no I/O; identical across VM and AOT and stable across runs.
import strconv

fn run(n: int) -> int {
    var acc = 0
    var i = 0
    while (i < n) {
        var a = strconv.parseInt("12345") ?? 0
        var b = strconv.parseInt("-6789") ?? 0
        var c = strconv.parseInt("not_a_number") ?? -1
        acc = (acc + a + b + c) % 1000000007
        i = i + 1
    }
    return acc
}

print(run(100000))
