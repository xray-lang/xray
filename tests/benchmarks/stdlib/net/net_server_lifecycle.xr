// Deterministic local server benchmark. The runner owns the client peer.
import net
import os
import strconv

var port = strconv.parseInt(os.getenv("XRAY_BENCH_PORT")!)!
var listener = net.listen(port, 8)
var conn = net.accept(listener)!
var buf = Array<byte>(4)
var iterations = 64
var completed = 0
while (completed < iterations) {
    var n = net.readInto(conn, ref buf, 4)
    if (n <= 0) { break }
    net.writeBytes(conn, buf)
    if (n == 4 && string.fromUtf8(buf[:])! == "ping") { completed = completed + 1 }
}
net.close(conn)
net.close(listener)
print(completed)
