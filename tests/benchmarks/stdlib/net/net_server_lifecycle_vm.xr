import net
import os
@test
fn benchmark_server_lifecycle() {
    var port = i64.tryParse(os.getenv("XRAY_BENCH_PORT")!)!
    var listener = net.listen(port, 8)
    var conn = net.accept(listener)!
    var buf = Array<u8>(4)
    var completed = 0
    while (completed < 64) {
        var n = net.readInto(conn, ref buf, 4)
        if (n <= 0) { break }
        net.writeBytes(conn, buf)
        if (n == 4 && string.fromUtf8(buf[:])! == "ping") { completed = completed + 1 }
    }
    net.close(conn)
    net.close(listener)
    assertEqual(completed, 64)
}
