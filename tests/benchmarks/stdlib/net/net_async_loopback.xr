// Deterministic local client-I/O benchmark. The runner owns the echo peer.
import net
import { DialOptions } from net
import os
var port = i64.tryParse(os.getenv("XRAY_BENCH_PORT")!)!
var conn = net.dial("127.0.0.1", port, DialOptions(5000))
var ping = "ping".copyBytes()
var buf = Array<u8>(4)
var attempts = 64
var completed = 0
while (completed < attempts) {
    net.writeBytes(conn, ping)
    var n = net.readInto(conn, ref buf, 4)
    if (n == 4 && string.fromUtf8(buf[:])! == "ping") { completed = completed + 1 }
}
net.close(conn)
print(completed)
