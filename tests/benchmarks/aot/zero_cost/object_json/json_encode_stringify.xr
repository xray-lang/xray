fn run(n: int) -> int {
    var user = { name: "Ada", age: 37, active: true }
    var i = 0
    var total = 0
    while (i < n) {
        var text = Json.stringify(Json.encode(user))
        total = total + len(text)
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = int(process.args[0]) ?? iterations
}
print(run(iterations))
