fn run(n: i64) -> i64 {
    var user = { name: "Ada", age: 37, active: true }
    var i = 0
    var total = 0
    while (i < n) {
        var text = JSON.stringify(user)
        total = total + len(text)
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
