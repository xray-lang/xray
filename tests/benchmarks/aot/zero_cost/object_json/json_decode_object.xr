type Profile = { id: i64, active: bool }

fn run(n: i64) -> i64 {
    var object = JSON.parseObject("{\"id\":7,\"active\":true}")
    var i = 0
    var total = 0
    while (i < n) {
        var profile = JSON.decodeObject<Profile>(object)!
        total = total + profile.id
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
