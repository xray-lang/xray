fn run(n: i64) -> i64 {
    var object = JSON.parseObject("{\"value\":0}")
    var root = JSON.parseValue("{\"items\":[0]}")
    var i = 0
    var total = 0
    while (i < n) {
        JSON.set(object, ["value"], i)
        if (JSON.require<i64>(object, ["value"]) == i) {
            total = total + 1
        }
        JSON.set(root, ["items", 0], i)
        if (JSON.get<i64>(root, ["items", 0]) == i) {
            total = total + 1
        }
        JSON.set(object, ["temporary"], i)
        if (JSON.remove(object, ["temporary"])) {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
