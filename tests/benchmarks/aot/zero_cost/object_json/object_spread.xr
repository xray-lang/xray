fn run(n: i64) -> i64 {
    var i = 0
    var total = 0
    while (i < n) {
        var base = { x: i, y: i + 1 }
        var expanded = { ...base, z: i + 2 }
        total = total + expanded.z - expanded.x
        i = i + 1
    }
    return total
}

var iterations = 200000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
