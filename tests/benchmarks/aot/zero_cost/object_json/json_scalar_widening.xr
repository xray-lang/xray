fn isJsonInt(value: JSON.Value) -> int {
    return JSON.isInt(value) ? 1 : 0
}

fn run(n: int) -> int {
    var i = 0
    var total = 0
    while (i < n) {
        total = total + isJsonInt(i)
        i = i + 1
    }
    return total
}

var iterations = 200000
if (len(process.args) > 0) {
    iterations = int(process.args[0]) ?? iterations
}
print(run(iterations))
