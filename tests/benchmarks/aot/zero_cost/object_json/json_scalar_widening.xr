import codegen

fn isJsonInt(value: JSON.Value) -> i64 {
    return JSON.isInt(value) ? 1 : 0
}

fn run(n: i64) -> i64 {
    var i = 0
    var total = 0
    while (i < n) {
        total = total + isJsonInt(codegen.opaque(i))
        i = i + 1
    }
    return total
}

var iterations = 200000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
