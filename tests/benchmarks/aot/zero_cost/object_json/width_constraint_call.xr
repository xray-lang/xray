fn nameWidth<T: { name: string }>(value: T) -> i64 {
    return len(value.name)
}

fn run(n: i64) -> i64 {
    var ada = { name: "Ada", age: 37 }
    var bob = { name: "Bob", active: true }
    var i = 0
    var total = 0
    while (i < n) {
        total = total + nameWidth(ada) + nameWidth(bob)
        i = i + 1
    }
    return total
}

var iterations = 2000000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
