fn run(n: i64) -> i64 {
    var i = 0
    var sum = 0
    while (i < n) {
        var point = { x: i, y: i + 1 }
        sum = sum + point.y - point.x
        i = i + 1
    }
    return sum
}

var iterations = 200000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
