type Profile = { id: i64, active: bool }

fn run(n: i64) -> i64 {
    var parts = JSON.parseWithRest<Profile>(
        "{\"id\":7,\"active\":true,\"future\":9}",
        JSON.UnknownFields.Ignore
    )
    var i = 0
    var total = 0
    while (i < n) {
        total = total + len(JSON.stringify(JSON.merge(parts)))
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
