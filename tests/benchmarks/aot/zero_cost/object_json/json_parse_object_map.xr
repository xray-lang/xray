fn run(n: int) -> int {
    var i = 0
    var total = 0
    while (i < n) {
        var object = JSON.parseObject("{\"id\":7,\"name\":\"Ada\"}")
        if (JSON.isObject(JSON.value(object))) {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = int(process.args[0]) ?? iterations
}
print(run(iterations))
