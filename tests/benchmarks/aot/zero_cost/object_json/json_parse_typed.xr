type Profile = { id: i64, active: bool }

fn run(n: i64) -> i64 {
    var i = 0
    var sum = 0
    while (i < n) {
        var profile: Profile = JSON.parse<Profile>("{\"id\":7,\"active\":true}")
        sum = sum + profile.id
        i = i + 1
    }
    return sum
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = i64.tryParse(process.args[0]) ?? iterations
}
print(run(iterations))
