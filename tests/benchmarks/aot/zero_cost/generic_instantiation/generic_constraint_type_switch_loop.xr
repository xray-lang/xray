interface Shape {
    area() -> i64
}

class Circle implements Shape {
    r: i64

    constructor(r: i64) {
        this.r = r
    }

    area() -> i64 {
        return this.r * this.r
    }
}

class Square implements Shape {
    side: i64

    constructor(side: i64) {
        this.side = side
    }

    area() -> i64 {
        return this.side * this.side
    }
}

fn score<T: Shape>(shape: T) -> i64 {
    return shape.area()
}

fn run(n: i64) -> i64 {
    var circle: Shape = Circle(2)
    var square: Shape = Square(3)
    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + score<Shape>(circle)
        sum = sum + score<Shape>(square)
        i = i + 1
    }
    return sum
}

print(run(20000))
