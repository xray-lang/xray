interface Shape {
    area() -> int
}

class Circle implements Shape {
    r: int

    constructor(r: int) {
        this.r = r
    }

    area() -> int {
        return this.r * this.r
    }
}

fn score<T: Shape>(shape: T) -> int {
    return shape.area()
}

fn run(n: int) -> int {
    var circle = Circle(7)
    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + score<Circle>(circle)
        i = i + 1
    }
    return sum
}

print(run(20000))
