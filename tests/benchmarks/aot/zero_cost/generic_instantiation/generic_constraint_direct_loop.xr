interface Shape {
    area() -> i64
}

class Circle implements Shape {
    r: i64

    constructor(r: i64) {
        this.r = r
    }

    area() -> i64 {
        return this.r * this.r
    }
}

fn score<T: Shape>(shape: T) -> i64 {
    return shape.area()
}

fn run(n: i64) -> i64 {
    var circle = Circle(7)
    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + score<Circle>(circle)
        i = i + 1
    }
    return sum
}

print(run(20000))
