struct Pair {
    left: i64
    right: i64
}

fn run(n: i64) -> i64 {
    const pair = comptime Pair{left: 3, right: 4}
    const bias = comptime 7
    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + pair.left + pair.right + bias + (i % 3)
        i = i + 1
    }
    return sum
}

print(run(10000))
