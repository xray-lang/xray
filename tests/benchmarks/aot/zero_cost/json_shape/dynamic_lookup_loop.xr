fn readAge(j: Json) -> Json {
    return j.age
}

fn run(n: int) -> Json {
    var j: Json = { name: "ada", age: 1 }
    var i = 0
    var v: Json = 0
    while (i < n) {
        v = readAge(j)
        i = i + 1
    }
    return v
}

var iterations = 20000
if (len(process.args) > 0) {
    iterations = int(process.args[0]) ?? iterations
}
print(run(iterations))
