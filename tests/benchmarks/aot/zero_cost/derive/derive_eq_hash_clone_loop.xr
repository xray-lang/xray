@derive(Eq, Hash)
class Key {
    id: i64
    name: string

    constructor(id: i64, name: string) {
        this.id = id
        this.name = name
    }
}

@derive(Clone)
class Snapshot {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

fn run(n: i64) -> i64 {
    var values: Map<Key, i64> = #{}
    var keys: Set<Key> = #[]
    var inserted = Key(7, "alpha")
    var snapshot = Snapshot(5)
    values.set(inserted, 41)
    keys.add(inserted)

    var i = 0
    var sum = 0
    while (i < n) {
        var equal = Key(7, "alpha")
        if (values.containsKey(equal)) {
            sum = sum + values.get(equal)!
        }
        if (keys.contains(equal)) {
            sum = sum + 1
        }
        var cloned = copy(snapshot)
        sum = sum + cloned.value
        i = i + 1
    }
    return sum
}

print(run(20000))
