fn run(n: int) -> int {
    var scores: Map<string, int> = #{}
    scores.set("ada", 1)
    var key = "ada"

    var i = 0
    var sum = 0
    while (i < n) {
        if (scores.has(key)) {
            sum = sum + scores.get(key)
        }
        i = i + 1
    }
    return sum
}

print(run(20000))
