fn run(n: i64) -> i64 {
    var scores: Map<string, i64> = #{}
    scores.set("ada", 1)
    var key = "ada"

    var i = 0
    var sum = 0
    while (i < n) {
        if (scores.containsKey(key)) {
            sum = sum + scores.get(key)!
        }
        i = i + 1
    }
    return sum
}

print(run(20000))
