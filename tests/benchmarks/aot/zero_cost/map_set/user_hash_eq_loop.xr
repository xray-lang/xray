class Token implements Hashable {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    operator==(other: Token) -> bool {
        return this.value == other.value
    }

    hash() -> i64 {
        return this.value
    }
}

fn run(n: i64) -> i64 {
    var token = Token(7)
    var values: Map<Token, i64> = #{}
    values.set(token, 99)
    var seen: Set<Token> = #[]
    seen.add(token)

    var i = 0
    var sum = 0
    while (i < n) {
        if (values.containsKey(token)) {
            if (seen.contains(token)) {
                sum = sum + values.get(token)!
            }
        }
        i = i + 1
    }
    return sum
}

print(run(20000))
