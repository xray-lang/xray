fn run(n: i64) -> i64 {
    var scores = #{0: 10, 1: 11, 2: 12, 3: 13, 4: 14}
    var seen: Set<i64> = #[0, 1, 2, 3, 4]

    var i = 0
    var sum = 0
    while (i < n) {
        if (scores.containsKey(3)) {
            if (seen.contains(1)) {
                sum = sum + scores.get(4)! + scores[2]
            }
        }
        i = i + 1
    }
    return sum
}

print(run(20000))
