fn buildRow() -> string {
    var sb = StringBuilder()
    sb.append("row=[")
    sb.append(true)
    sb.append("|")
    sb.append('中')
    sb.append("|")
    sb.append(false)
    sb.append("|")
    sb.append(null)
    sb.append("]")
    return sb.toString()
}

fn run(n: i64) -> i64 {
    var total = 0
    var i = 0
    while (i < n) {
        total = total + len(buildRow())
        i = i + 1
    }
    return total
}

print(run(20000))
