fn makeText(seed: string) -> string {
    return seed + "-managed"
}

fn run(n: int) -> int {
    var values: Array<string> = [makeText("old-a"), makeText("old-b"), makeText("old-c"), makeText("old-d")]
    var evenValue = makeText("even")
    var oddValue = makeText("twin")
    var total = 0
    var i = 0
    while (i < n) {
        if ((i % 2) == 0) {
            values.fill(evenValue)
        } else {
            values.fill(oddValue)
        }
        total = total + len(values[0]) + len(values[3])
        i = i + 1
    }
    return total + len(values[1])
}

print(run(20000))
