fn run(n: int) -> int {
    var xs: Array<int> = []
    var bytes: Array<byte> = Array<byte>(16, 0)
    var sourceBytes: Array<byte> = Array<byte>(8, 3)
    var window: Slice<byte> = bytes[0:8]
    var source: Slice<byte> = sourceBytes[:]
    var out: Array<byte> = Array.withCapacity(0)
    var valid: Array<byte> = Array<byte>(5, 0)
    valid[0] = 104
    valid[1] = 101
    valid[2] = 108
    valid[3] = 108
    valid[4] = 111

    var i = 0
    var total = 0
    while (i < n) {
        xs.push(i % 251)
        window.copyFrom(source)
        out.appendFrom(source)
        var text = string.fromUtf8(valid[:])!
        total = total + len(xs) + int(window[0]) + len(text)
        i = i + 1
    }
    return total + len(out)
}

print(run(20000))
