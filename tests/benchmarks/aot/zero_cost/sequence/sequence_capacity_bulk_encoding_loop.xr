fn run(n: i64) -> i64 {
    var xs: Array<i64> = []
    var bytes: Array<u8> = Array<u8>(16, 0)
    var sourceBytes: Array<u8> = Array<u8>(8, 3)
    var window: Slice<u8> = bytes[0:8]
    var source: Slice<u8> = sourceBytes[:]
    var out: Array<u8> = Array.withCapacity(0)
    var valid: Array<u8> = Array<u8>(5, 0)
    valid[0] = 104
    valid[1] = 101
    valid[2] = 108
    valid[3] = 108
    valid[4] = 111

    var i = 0
    var total = 0
    while (i < n) {
        xs.push(i % 251)
        window.copyFrom(source)
        out.appendFrom(source)
        var text = string.fromUtf8(valid[:])!
        total = total + len(xs) + (window[0] as i64) + len(text)
        i = i + 1
    }
    return total + len(out)
}

print(run(20000))
