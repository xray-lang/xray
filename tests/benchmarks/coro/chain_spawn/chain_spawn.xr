// 链式递归创建测试 (Chain Spawn)
// 协程 A spawn B, B spawn C, ... 形成深度链
// 测试递归创建深度 + 调度器栈管理
import time

var DEPTH = 100000  // 链深度
if (len(process.args) > 0) {
    DEPTH = i64.tryParse(process.args[0]) ?? DEPTH
}

print("=== Chain Spawn 测试 ===")
print("链深度:", DEPTH)

// 链式协程：创建下一级并等待结果
fn chain(depth: i64) -> i64 {
    if (depth <= 0) {
        return 0
    }
    var child = go chain_child(depth - 1)
    var result = await child
    return result + 1
}

fn chain_child(depth: i64) -> i64 {
    return chain(depth)
}

var start = time.monotonic()
var result = await go chain_child(DEPTH)
var elapsed = time.monotonic() - start

print("结果:", result)
print("正确:", result == DEPTH)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("速度:", (DEPTH * 1000 / elapsed as i64), "spawns/sec")
} else {
    print("速度: 太快无法测量")
}
