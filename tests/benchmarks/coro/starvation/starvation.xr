// 公平调度测试 (Starvation Test)
// 1 个 CPU 密集型协程（死循环计算）+ N 个短任务协程
// 测试调度器能否公平调度，不让长任务饿死短任务
// DURATION_MS 是安全上限；短任务完成后会停止 CPU hog。
import time

var SHORT_TASKS = 100    // 短任务数量
var DURATION_MS = 2000   // 最长持续时间(ms)
if (len(process.args) > 0) {
    SHORT_TASKS = i64.tryParse(process.args[0]) ?? SHORT_TASKS
}
if (len(process.args) > 1) {
    DURATION_MS = i64.tryParse(process.args[1]) ?? DURATION_MS
}

print("=== Starvation 测试 ===")
print("短任务数:", SHORT_TASKS)
print("最长持续时间:", DURATION_MS, "ms")

const result_ch = Channel(SHORT_TASKS)

fn recv_int(ch: Channel<i64>, fallback: i64) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

// CPU 密集型长任务：持续计算直到被取消
fn cpu_hog() -> i64 {
    var count = 0
    var deadline = time.monotonic() + DURATION_MS
    while (time.monotonic() < deadline) {
        // 纯计算循环，没有任何 yield 点
        // 只有 safepoint (guard page) 能让出 CPU
        for (var i = 0; i < 10000; i++) {
            count = count + 1
        }
    }
    return count
}

// 短任务：简单计算后立即返回
fn short_task(id: i64) -> i64 {
    var start = time.monotonic()
    // 少量计算
    var sum = 0
    for (var i = 0; i < 100; i++) {
        sum = sum + i
    }
    var latency = time.monotonic() - start
    result_ch.send(latency)
    return sum
}

var start = time.monotonic()

// 启动 CPU hog（长任务）
var hog = go cpu_hog()

// 等待一小段时间让 hog 开始运行
time.sleep(10)

// 分批启动短任务，间隔 10ms
var short_tasks: Array<Task> = []
var batch_size = SHORT_TASKS / 10
if (batch_size < 1) { batch_size = 1 }

var launched = 0
while (launched < SHORT_TASKS) {
    var remaining = SHORT_TASKS - launched
    var current_batch = batch_size
    if (current_batch > remaining) {
        current_batch = remaining
    }
    for (var i = 0; i < current_batch; i++) {
        short_tasks.push(go short_task(launched + i))
    }
    launched = launched + current_batch
    time.sleep(10)
}

// 等待所有短任务完成。完成数以 await 为准；result_ch 只用于延迟统计，
// 对齐 Go 版 WaitGroup 再 drain results 的语义。
var completed = 0
var total_latency = 0
var max_latency = 0

for (task in short_tasks) {
    var sum = await task
    if ((i64.tryParse(sum) ?? -1) == 4950) {
        completed++
    }
}

for (var i = 0; i < completed; i++) {
    var lat = recv_int(result_ch, 0)
    total_latency = total_latency + lat
    if (lat > max_latency) {
        max_latency = lat
    }
}

for (task in short_tasks) {
    await task
}
hog.cancel()
result_ch.close()

var elapsed = time.monotonic() - start

print("短任务完成:", completed, "/", SHORT_TASKS)
print("总时间:", elapsed, "ms")
if (completed > 0) {
    print("平均延迟:", (total_latency as f64) / (completed as f64), "ms")
    print("最大延迟:", max_latency, "ms")
}
print("公平调度:", completed == SHORT_TASKS)
if (completed == SHORT_TASKS) {
    print("结果: PASS - safepoint 抢占正常工作")
} else {
    print("结果: FAIL - 短任务被饿死，safepoint 可能有问题")
}
