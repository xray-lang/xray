import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Native WorkQueue benchmark using ResultGroup for batched result aggregation.

import time

var WORKERS = 8
var TASKS = 100000
var BATCH = 64
if (len(process.args) > 0) {
    WORKERS = i64.tryParse(process.args[0]) ?? WORKERS
}
if (len(process.args) > 1) {
    TASKS = i64.tryParse(process.args[1]) ?? TASKS
}
if (len(process.args) > 2) {
    BATCH = i64.tryParse(process.args[2]) ?? BATCH
}
if (WORKERS < 1) {
    WORKERS = 1
}
if (TASKS < 0) {
    TASKS = 0
}
if (BATCH < 1) {
    BATCH = 1
}

const work_queue: WorkQueue<i64> = WorkQueue<i64>(WORKERS, 1024)
const result_group: ResultGroup = ResultGroup(BATCH)

print("=== Work Queue Pool ResultGroup 测试 ===")
print("Worker数:", WORKERS)
print("任务总数:", TASKS)
print("Result batch:", BATCH)

fn fib(n: i64) -> i64 {
    if (n <= 1) { return n }
    var a = 0
    var b = 1
    for (var i = 2; i <= n; i++) {
        var t = a + b
        a = b
        b = t
    }
    return b
}

fn expected_total(count: i64) -> i64 {
    var total = 0
    for (var i = 0; i < count; i++) {
        total = total + fib(i % 20)
    }
    return total
}

fn worker(id: i64) -> i64 {
    var processed = 0
    while (true) {
        var task = work_queue.pop(id)
        if (task == null) {
            break
        }
        var task_id = task ?? 0
        result_group.add(fib(task_id % 20))
        processed++
    }
    return processed
}

fn submit_tasks(count: i64) {
    for (var i = 0; i < count; i++) {
        assert(work_queue.push(i, i))
    }
    work_queue.close()
}

fn reduce_results() -> i64 {
    var total = 0
    while (true) {
        var value = result_group.recv()
        if (value == null) {
            break
        }
        total = total + (value ?? 0)
    }
    return total
}

var start = time.monotonic()

var reducer = go reduce_results()
var workers: Array<Task> = []
for (var i = 0; i < WORKERS; i++) {
    workers.push(go worker(i))
}

var submitter = go submit_tasks(TASKS)
await submitter

var worker_loads: Array<i64> = []
for (w in workers) {
    var processed = await w
    worker_loads.push(processed)
}
result_group.close()
var total = await reducer

var elapsed = time.monotonic() - start
var expected = expected_total(TASKS)
var result_events = ((TASKS + BATCH - 1) / BATCH as i64)

print("结果校验和:", total)
print("预期:", expected)
print("正确:", total == expected)
print("结果事件数:", result_events)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", (TASKS * 1000 / elapsed as i64), "tasks/sec")
} else {
    print("吞吐量: 太快无法测量")
}

var min_load = TASKS
var max_load = 0
for (load in worker_loads) {
    if (load < min_load) { min_load = load }
    if (load > max_load) { max_load = load }
}
print("负载均衡: min=", min_load, "max=", max_load, "ratio=", (max_load as f64) / (min_load + 1 as f64))
