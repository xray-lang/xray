import time

var COUNT = 1000
var TIMEOUT_MS = 10

if (len(process.args) > 0) {
    COUNT = i64.tryParse(process.args[0]) ?? COUNT
}
if (len(process.args) > 1) {
    TIMEOUT_MS = i64.tryParse(process.args[1]) ?? TIMEOUT_MS
}

fn recv_timeout_worker(ch: Channel<i64>, timeout_ms: i64) -> bool {
    return match (ch.recvTimeout(timeout_ms)) {
        Recv.Timeout -> true
        Recv.Value { value: _ } -> false
        _ -> true
    }
}

fn send_timeout_worker(ch: Channel<i64>, timeout_ms: i64, value: i64) -> bool {
    return match (ch.sendTimeout(value, timeout_ms)) {
        SendResult.Sent -> false
        _ -> true
    }
}

fn run_recv_storm(count: i64, timeout_ms: i64) -> i64 {
    const ch = Channel(1)
    var tasks: Array<Task> = []
    for (var i = 0; i < count; i++) {
        tasks.push(go recv_timeout_worker(ch, timeout_ms))
    }

    var timeouts = 0
    for (task in tasks) {
        if (await task) {
            timeouts++
        }
    }
    ch.close()
    return timeouts
}

fn run_send_storm(count: i64, timeout_ms: i64) -> i64 {
    const ch = Channel(1)
    ch.send(1)

    var tasks: Array<Task> = []
    for (var i = 0; i < count; i++) {
        tasks.push(go send_timeout_worker(ch, timeout_ms, i + 2))
    }

    var timeouts = 0
    for (task in tasks) {
        if (await task) {
            timeouts++
        }
    }
    var _drain = match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
    ch.close()
    return timeouts
}

print("=== Timeout Storm Benchmark ===")
print("coroutines:", COUNT)
print("timeout:", TIMEOUT_MS, "ms")

var start_total = time.monotonic()

var start_recv = time.monotonic()
var recv_timeouts = run_recv_storm(COUNT, TIMEOUT_MS)
var recv_elapsed = time.monotonic() - start_recv

var start_send = time.monotonic()
var send_timeouts = run_send_storm(COUNT, TIMEOUT_MS)
var send_elapsed = time.monotonic() - start_send

var total_elapsed = time.monotonic() - start_total
var completed = COUNT * 2
var expected = COUNT * 2
var timed_out = recv_timeouts + send_timeouts

print("recv completed:", COUNT)
print("recv timeouts:", recv_timeouts)
print("recv wall:", recv_elapsed, "ms")
print("send completed:", COUNT)
print("send timeouts:", send_timeouts)
print("send wall:", send_elapsed, "ms")
print("completed_ops:", completed)
print("expected_ops:", expected)
print("checksum:", timed_out)
print("correctness:", timed_out == expected)
print("reported_time_ms:", total_elapsed)
