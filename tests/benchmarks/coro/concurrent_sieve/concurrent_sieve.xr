// 并发素数筛 (Concurrent Sieve of Eratosthenes)
// 经典 CSP 管道模式：每个素数一个协程做过滤器
// 测试管道吞吐量 + 大量协程级联通信
import time

var N = 10000  // 找到前 N 个素数
if (len(process.args) > 0) {
    N = int(process.args[0]) ?? N
}

print("=== 并发素数筛测试 ===")
print("目标素数数量:", N)

fn recv_int(ch: Channel<int>, fallback: int) -> int {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

// 数字生成器：向 channel 发送 2, 3, 4, ...
fn generate(ch: Channel<int>, limit: int) {
    for (var i = 2; i <= limit; i++) {
        ch.send(i)
    }
    ch.close()
}

// 过滤器：过滤掉能被 prime 整除的数
fn filter(in_ch: Channel<int>, out_ch: Channel<int>, prime: int) {
    while (true) {
        var n = recv_int(in_ch, -1)
        if (n < 0) {
            break
        }
        if (n % prime != 0) {
            out_ch.send(n)
        }
    }
    out_ch.close()
}

// 估算上界：找前 N 个素数需要检查到大约 N * ln(N) + N * ln(ln(N))
fn estimate_limit(n: int) -> int {
    if (n < 10) { return 30 }
    // 粗略上界: n * 15 对于 n <= 100000 足够
    return n * 15
}

var limit = estimate_limit(N)
var start = time.monotonic()

const channels: Array<Channel<int>> = [Channel(100)]
var tasks: Array<Task> = []
tasks.push(go generate(channels[0], limit))

var primes: Array<int> = []
var count = 0
var cur = 0  // index into channels array

while (count < N) {
    var prime = recv_int(channels[cur], -1)
    if (prime < 0) {
        break
    }
    primes.push(prime)
    count++

    if (count < N) {
        channels.push(Channel(100))
        var next_idx = len(channels) - 1
        tasks.push(go filter(channels[cur], channels[next_idx], prime))
        cur = next_idx
    }
}

if (count >= N) {
    while (true) {
        var ignored = recv_int(channels[cur], -1)
        if (ignored < 0) {
            break
        }
    }
}
for (task in tasks) {
    await task
}
var elapsed = time.monotonic() - start

print("找到素数:", count)
print("最大素数:", primes[len(primes) - 1])
print("管道级数:", count)
print("预期:", N)
print("正确:", count == N)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("速度:", int(count * 1000 / elapsed), "primes/sec")
} else {
    print("速度: 太快无法测量")
}
