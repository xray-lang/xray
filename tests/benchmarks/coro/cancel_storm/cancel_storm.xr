// 大量取消测试 (Cancel Storm)
// 创建 N 个协程后立即取消，测试 cancel 路径效率
import time

var N = 100000  // 协程数量
if (len(process.args) > 0) {
    N = i64.tryParse(process.args[0]) ?? N
}

print("=== Cancel Storm 测试 ===")
print("协程数量:", N)

// 长期等待任务：sleep 很久，期望被 cancel
fn long_wait(id: i64) -> i64 {
    time.sleep(60000)  // 60 秒，正常不会完成
    return id
}

var start = time.monotonic()

// 创建所有协程
var tasks: Array<Task> = []
for (var i = 0; i < N; i++) {
    tasks.push(go long_wait(i))
}

var spawn_time = time.monotonic() - start
print("创建时间:", spawn_time, "ms")

// 立即取消所有协程
var cancel_start = time.monotonic()
for (t in tasks) {
    t.cancel()
}
var cancel_time = time.monotonic() - cancel_start
print("取消时间:", cancel_time, "ms")

// 等待所有协程完成（取消后应立即返回）
var await_start = time.monotonic()
var cancelled = 0
for (t in tasks) {
    match (t.awaitResult()) {
        TaskResult.Cancelled -> {
            cancelled++
        }
        _ -> {}
    }
}
var await_time = time.monotonic() - await_start

var elapsed = time.monotonic() - start
print("等待时间:", await_time, "ms")
print("总时间:", elapsed, "ms")
print("成功取消:", cancelled, "/", N)
print("completed_ops:", cancelled)
print("expected_ops:", N)
print("checksum:", cancelled)
print("correctness:", cancelled == N)
print("reported_time_ms:", elapsed)
if (elapsed > 0) {
    print("速度:", (N * 1000 / elapsed as i64), "cancels/sec")
} else {
    print("速度: 太快无法测量")
}
