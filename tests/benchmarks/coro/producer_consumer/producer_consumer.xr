// 生产者消费者测试
// M 个生产者生产数据，N 个消费者消费数据
import time
var PRODUCERS = 10
// 生产者数量
var CONSUMERS = 10
// 消费者数量
var ITEMS = 100000
// 总生产数量
if (len(process.args) > 0) {
    PRODUCERS = i64.tryParse(process.args[0]) ?? PRODUCERS
}
if (len(process.args) > 1) {
    CONSUMERS = i64.tryParse(process.args[1]) ?? CONSUMERS
}
if (len(process.args) > 2) {
    ITEMS = i64.tryParse(process.args[2]) ?? ITEMS
}
print("=== 生产者消费者测试 ===")
print("生产者:", PRODUCERS)
print("消费者:", CONSUMERS)
print("总数量:", ITEMS)
const queue = Channel(100)
const done_ch = Channel(CONSUMERS)

fn recv_int(ch: Channel<i64>, fallback: i64) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

// 生产者
fn producer(id: i64, count: i64) {
    for (var i = 0; i < count; i++) {
        queue.send(id * 1000000 + i)
    }
}

// 消费者
fn consumer(id: i64) {
    var consumed = 0
    while (true) {
        var item = recv_int(queue, -1)
        if (item < 0) {
            break
        }
        // 模拟处理
        var result = item * 2
        consumed++
    }
    done_ch.send(consumed)
}

var items_per_producer = ITEMS / PRODUCERS
var remaining_items = ITEMS % PRODUCERS
var start = time.monotonic()
// 同时启动生产者和消费者（避免 Channel 阻塞）
var producers: Array<Task> = []
for (var i = 0; i < PRODUCERS; i++) {
    var count = items_per_producer
    if (i < remaining_items) {
        count = count + 1
    }
    producers.push(go producer(i, count))
}
var consumers: Array<Task> = []
for (var i = 0; i < CONSUMERS; i++) {
    consumers.push(go consumer(i))
}
// 等待所有生产者完成
for (p in producers) {
    await p
}
// 关闭队列通知消费者退出
queue.close()
// 等待所有消费者完成并统计
var total_consumed = 0
for (var i = 0; i < CONSUMERS; i++) {
    total_consumed = total_consumed + recv_int(done_ch, 0)
}
var elapsed = time.monotonic() - start
done_ch.close()
var expected = ITEMS
print("消费总数:", total_consumed)
print("预期:", expected)
print("正确:", total_consumed == expected)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", (total_consumed * 1000 / elapsed as i64), "items/sec")
} else {
    print("吞吐量: 太快无法测量")
}
