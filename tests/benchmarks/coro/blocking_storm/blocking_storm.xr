// Blocking storm benchmark for handoff M budget diagnostics.
// Requires XR_BUILD_TEST_MODULES=ON because it uses test_yield.blocking_sleep.

import time
import test_yield

var TASKS = 32
var BLOCK_MS = 25
if (len(process.args) > 0) {
    TASKS = i64.tryParse(process.args[0]) ?? TASKS
}
if (len(process.args) > 1) {
    BLOCK_MS = i64.tryParse(process.args[1]) ?? BLOCK_MS
}

fn blocking_task(id: i64) -> i64 {
    var slept = test_yield.blocking_sleep(BLOCK_MS)
    return id + slept
}

fn cpu_task(rounds: i64) -> i64 {
    var sum = 0
    for (var i = 0; i < rounds; i++) {
        sum = sum + (i % 17)
        if (i % 256 == 0) {
            Coro.yield()
        }
    }
    return sum
}

print("=== Blocking Storm Benchmark ===")
print("tasks:", TASKS)
print("block_ms:", BLOCK_MS)

var start = time.monotonic()
var tasks: Array<Task> = []
for (var i = 0; i < TASKS; i++) {
    tasks.push(go blocking_task(i))
}

var cpu = go cpu_task(TASKS * 1024)
var cpu_result = await cpu

var total = 0
for (t in tasks) {
    total = total + await t
}

var elapsed = time.monotonic() - start
print("cpu_result:", cpu_result)
print("total:", total)
print("elapsed:", elapsed, "ms")
