// 哲学家就餐测试 (Dining Philosophers)
// N 个哲学家围坐圆桌，用 channel 模拟叉子的获取和释放
// 测试通道方案解决经典同步问题的效率
import time

var N = 5            // 哲学家数量
var MEALS = 100000   // 每人进餐次数
if (len(process.args) > 0) {
    N = i64.tryParse(process.args[0]) ?? N
}
if (len(process.args) > 1) {
    MEALS = i64.tryParse(process.args[1]) ?? MEALS
}

print("=== Dining Philosophers 测试 ===")
print("哲学家数:", N)
print("每人进餐:", MEALS)

// Fork = buffered channel(1) used as mutex: value present = available
const forks: Array<Channel<i64>> = []
for (var i = 0; i < N; i++) {
    forks.push(Channel(1))
}
for (var i = 0; i < N; i++) {
    forks[i].send(1)
}

const result_ch: Channel<i64> = Channel(100)

fn recv_int(ch: Channel<i64>, fallback: i64) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value } -> value
        _ -> fallback
    }
}

// Philosopher: alternates thinking and eating
// Deadlock avoidance: last philosopher reverses fork order (break circular wait)
fn philosopher(id: i64, meals: i64, first: Channel<i64>, second: Channel<i64>, out: Channel<i64>) {
    for (var i = 0; i < meals; i++) {
        first.recv()
        second.recv()
        second.send(1)
        first.send(1)
    }
    out.send(meals)
}

var start = time.monotonic()

// Launch all philosophers (extract channels to local vars before go)
var tasks: Array<Task> = []
for (var i = 0; i < N; i++) {
    var left = forks[i]
    var right = forks[(i + 1) % N]
    // Last philosopher reverses order (break circular wait)
    if (i == N - 1) {
        tasks.push(go philosopher(i, MEALS, right, left, result_ch))
    } else {
        tasks.push(go philosopher(i, MEALS, left, right, result_ch))
    }
}

// 收集结果
var total_meals = 0
for (var i = 0; i < N; i++) {
    total_meals = total_meals + recv_int(result_ch, 0)
}

for (t in tasks) {
    await t
}

var elapsed = time.monotonic() - start
result_ch.close()
for (fork in forks) {
    fork.close()
}

print("总进餐次数:", total_meals)
print("预期:", N * MEALS)
print("正确:", total_meals == N * MEALS)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", (total_meals * 1000 / elapsed as i64), "meals/sec")
} else {
    print("吞吐量: 太快无法测量")
}
