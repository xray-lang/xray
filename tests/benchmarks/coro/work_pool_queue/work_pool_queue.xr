// Sharded work queue benchmark.
// This benchmark compares sharded task queues against a single shared Channel
// used as a task queue.

import time

let WORKERS = 8
let TASKS = 100000
if (process.args.length > 0) {
    WORKERS = int(process.args[0]) ?? WORKERS
}
if (process.args.length > 1) {
    TASKS = int(process.args[1]) ?? TASKS
}

class WorkQueue<T> {
    shards: Array<Channel<T>>
    worker_count: int

    constructor(count: int, capacity: int) {
        this.worker_count = count
        this.shards = []
        for (let i = 0; i < count; i++) {
            let ch: Channel<T> = Channel(capacity)
            this.shards.push(ch)
        }
    }

    push(value: T, shard: int) {
        let idx = shard % this.worker_count
        this.shards[idx].send(value)
    }

    pop(worker_id: int) -> T? {
        for (let i = 0; i < this.worker_count; i++) {
            let idx = (worker_id + i) % this.worker_count
            let (value, ok) = this.shards[idx].tryRecv()
            if (ok) {
                return value
            }
        }
        let own = worker_id % this.worker_count
        return this.shards[own].recv()
    }

    close() {
        for (ch in this.shards) {
            ch.close()
        }
    }
}

shared const work_queue = new WorkQueue<int>(WORKERS, 1024)

print("=== Work Queue Pool 测试 ===")
print("Worker数:", WORKERS)
print("任务总数:", TASKS)

shared const result_ch = Channel(1000)

fn fib(n: int) -> int {
    if (n <= 1) { return n }
    let a = 0
    let b = 1
    for (let i = 2; i <= n; i++) {
        let t = a + b
        a = b
        b = t
    }
    return b
}

fn expected_total(count: int) -> int {
    let total = 0
    for (let i = 0; i < count; i++) {
        total = total + fib(i % 20)
    }
    return total
}

fn worker(id: int) -> int {
    let processed = 0
    while (true) {
        let task = work_queue.pop(id)
        if (task == null) { break }
        result_ch.send(fib(task % 20))
        processed++
    }
    return processed
}

fn submit_tasks(count: int) {
    for (let i = 0; i < count; i++) {
        work_queue.push(i, i)
    }
    work_queue.close()
}

let start = time.monotonic()

let workers: Array<Task> = []
for (let i = 0; i < WORKERS; i++) {
    workers.push(go worker(i))
}

let submitter = go submit_tasks(TASKS)

let total = 0
for (let i = 0; i < TASKS; i++) {
    total = total + result_ch.recv()
}
await submitter

let worker_loads: Array<int> = []
for (w in workers) {
    let processed = await w
    worker_loads.push(processed)
}

let elapsed = time.monotonic() - start
result_ch.close()
let expected = expected_total(TASKS)

print("结果校验和:", total)
print("预期:", expected)
print("正确:", total == expected)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", int(TASKS * 1000 / elapsed), "tasks/sec")
} else {
    print("吞吐量: 太快无法测量")
}

let min_load = TASKS
let max_load = 0
for (load in worker_loads) {
    if (load < min_load) { min_load = load }
    if (load > max_load) { max_load = load }
}
print("负载均衡: min=", min_load, "max=", max_load, "ratio=", float(max_load) / float(min_load + 1))
