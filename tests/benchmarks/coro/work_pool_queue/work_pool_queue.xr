import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Native sharded work queue benchmark.

import time

var WORKERS = 8
var TASKS = 100000
if (len(process.args) > 0) {
    WORKERS = int(process.args[0]) ?? WORKERS
}
if (len(process.args) > 1) {
    TASKS = int(process.args[1]) ?? TASKS
}
if (WORKERS < 1) {
    WORKERS = 1
}
if (TASKS < 0) {
    TASKS = 0
}

const work_queue: WorkQueue<int> = WorkQueue<int>(WORKERS, 1024)

print("=== Work Queue Pool 测试 ===")
print("Worker数:", WORKERS)
print("任务总数:", TASKS)

const result_ch = Channel(1000)

fn recv_int(ch: Channel<int>, fallback: int) -> int {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

fn fib(n: int) -> int {
    if (n <= 1) { return n }
    var a = 0
    var b = 1
    for (var i = 2; i <= n; i++) {
        var t = a + b
        a = b
        b = t
    }
    return b
}

fn expected_total(count: int) -> int {
    var total = 0
    for (var i = 0; i < count; i++) {
        total = total + fib(i % 20)
    }
    return total
}

fn worker(id: int) -> int {
    var processed = 0
    while (true) {
        var task = work_queue.pop(id)
        if (task == null) {
            break
        }
        var task_id = task ?? 0
        result_ch.send(fib(task_id % 20))
        processed++
    }
    return processed
}

fn submit_tasks(count: int) {
    for (var i = 0; i < count; i++) {
        assert_true(work_queue.push(i, i))
    }
    work_queue.close()
}

var start = time.monotonic()

var workers: Array<Task> = []
for (var i = 0; i < WORKERS; i++) {
    workers.push(go worker(i))
}

var submitter = go submit_tasks(TASKS)

var total = 0
for (var i = 0; i < TASKS; i++) {
    total = total + recv_int(result_ch, 0)
}
await submitter

var worker_loads: Array<int> = []
for (w in workers) {
    var processed = await w
    worker_loads.push(processed)
}

var elapsed = time.monotonic() - start
result_ch.close()
var expected = expected_total(TASKS)

print("结果校验和:", total)
print("预期:", expected)
print("正确:", total == expected)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", int(TASKS * 1000 / elapsed), "tasks/sec")
} else {
    print("吞吐量: 太快无法测量")
}

var min_load = TASKS
var max_load = 0
for (load in worker_loads) {
    if (load < min_load) { min_load = load }
    if (load > max_load) { max_load = load }
}
print("负载均衡: min=", min_load, "max=", max_load, "ratio=", float(max_load) / float(min_load + 1))
