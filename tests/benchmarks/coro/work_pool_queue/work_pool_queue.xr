// Native sharded work queue benchmark.
// WorkQueue stores tasks; wake_ch only wakes sleepers until WorkQueue gains a
// yieldable blocking pop operation.

import time

let WORKERS = 8
let TASKS = 100000
if (process.args.length > 0) {
    WORKERS = int(process.args[0]) ?? WORKERS
}
if (process.args.length > 1) {
    TASKS = int(process.args[1]) ?? TASKS
}
if (WORKERS < 1) {
    WORKERS = 1
}
if (TASKS < 0) {
    TASKS = 0
}

shared const work_queue: WorkQueue<int> = WorkQueue<int>(WORKERS, 1024)
shared const wake_ch = Channel(1024)

print("=== Work Queue Pool 测试 ===")
print("Worker数:", WORKERS)
print("任务总数:", TASKS)

shared const result_ch = Channel(1000)

fn fib(n: int) -> int {
    if (n <= 1) { return n }
    let a = 0
    let b = 1
    for (let i = 2; i <= n; i++) {
        let t = a + b
        a = b
        b = t
    }
    return b
}

fn expected_total(count: int) -> int {
    let total = 0
    for (let i = 0; i < count; i++) {
        total = total + fib(i % 20)
    }
    return total
}

fn worker(id: int) -> int {
    let processed = 0
    while (true) {
        let (task, ok) = work_queue.tryPop(id)
        if (ok) {
            let task_id = task ?? 0
            result_ch.send(fib(task_id % 20))
            processed++
        } else if (work_queue.isClosed) {
            break
        } else {
            wake_ch.recv()
        }
    }
    return processed
}

fn submit_tasks(count: int) {
    for (let i = 0; i < count; i++) {
        assert_true(work_queue.push(i, i))
        wake_ch.send(1)
    }
    work_queue.close()
    for (let i = 0; i < WORKERS; i++) {
        wake_ch.send(1)
    }
    wake_ch.close()
}

let start = time.monotonic()

let workers: Array<Task> = []
for (let i = 0; i < WORKERS; i++) {
    workers.push(go worker(i))
}

let submitter = go submit_tasks(TASKS)

let total = 0
for (let i = 0; i < TASKS; i++) {
    total = total + result_ch.recv()
}
await submitter

let worker_loads: Array<int> = []
for (w in workers) {
    let processed = await w
    worker_loads.push(processed)
}

let elapsed = time.monotonic() - start
result_ch.close()
let expected = expected_total(TASKS)

print("结果校验和:", total)
print("预期:", expected)
print("正确:", total == expected)
print("时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", int(TASKS * 1000 / elapsed), "tasks/sec")
} else {
    print("吞吐量: 太快无法测量")
}

let min_load = TASKS
let max_load = 0
for (load in worker_loads) {
    if (load < min_load) { min_load = load }
    if (load > max_load) { max_load = load }
}
print("负载均衡: min=", min_load, "max=", max_load, "ratio=", float(max_load) / float(min_load + 1))
