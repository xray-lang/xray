// 环形消息传递测试
// N 个协程组成环，消息在环中传递 M 轮
import time
var N = 1000
// 协程数量
var M = 1000
// 消息轮数
if (len(process.args) > 0) {
    N = i64.tryParse(process.args[0]) ?? N
}
if (len(process.args) > 1) {
    M = i64.tryParse(process.args[1]) ?? M
}
print("=== Ring 测试 ===")
print("协程数量:", N)
print("消息轮数:", M)

fn recv_int(ch: Channel<i64>, fallback: i64) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

// 创建 N 个 channel（存入数组自动共享）
var channels: Array<Channel<i64>> = []
for (var i = 0; i < N; i++) {
    channels.push(Channel(1))
}

// 创建 N 个协程，每个协程从自己的 channel 接收，发送到下一个
fn ring_node(in_ch: Channel<i64>, out_ch: Channel<i64>, rounds: i64) -> i64 {
    for (var r = 0; r < rounds; r++) {
        var msg = recv_int(in_ch, 0)
        out_ch.send(msg + 1)
    }
    return rounds
}

var start = time.monotonic()
// 启动所有协程
var tasks: Array<Task<i64>> = []
for (var i = 0; i < N; i++) {
    var in_ch = channels[i]
    var out_ch = channels[(i + 1) % N]
    tasks.push(go ring_node(in_ch, out_ch, M))
}
// 向第一个 channel 注入初始消息
channels[0].send(0)
// 等待所有协程完成
for (task in tasks) {
    await task
}
// 读取最后的结果
var result = recv_int(channels[0], 0)
var elapsed = time.monotonic() - start
for (ch in channels) {
    ch.close()
}
var total_messages = N * M
var expected = N * M
print("最终结果:", result)
print("预期:", expected)
print("正确:", result == expected)
print("总消息数:", total_messages)
print("总时间:", elapsed, "ms")
if (elapsed > 0) {
    print("吞吐量:", (total_messages * 1000 / elapsed as i64), "msg/sec")
} else {
    print("吞吐量: 太快无法测量")
}
