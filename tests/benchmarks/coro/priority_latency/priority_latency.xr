// Priority latency benchmark for scheduler tuning.

import time

let LOW_TASKS = 1000
let PROBES = 100
let LOW_ROUNDS = 80

if (process.args.length > 0) {
    LOW_TASKS = int(process.args[0]) ?? LOW_TASKS
}
if (process.args.length > 1) {
    PROBES = int(process.args[1]) ?? PROBES
}
if (process.args.length > 2) {
    LOW_ROUNDS = int(process.args[2]) ?? LOW_ROUNDS
}

fn low_work(rounds: int) -> int {
    let acc = 0
    for (let i = 0; i < rounds; i++) {
        acc = acc + i
        if (i % 8 == 0) {
            yield
        }
    }
    return acc
}

fn probe_work(kind: int, ch: Channel<int>) -> int {
    yield
    ch.send(kind)
    return kind
}

print("=== Priority Latency Benchmark ===")
print("low_tasks:", LOW_TASKS)
print("probes_per_priority:", PROBES)
print("low_rounds:", LOW_ROUNDS)

let started = time.monotonic()
const ch = new Channel<int>(PROBES * 2)

scope {
    for (let i = 0; i < LOW_TASKS; i++) {
        go(priority: Coro.LOW) low_work(LOW_ROUNDS)
    }

    for (let i = 0; i < PROBES; i++) {
        go(priority: Coro.NORMAL) probe_work(1, ch)
    }
    for (let i = 0; i < PROBES; i++) {
        go(priority: Coro.HIGH) probe_work(2, ch)
    }

    let normal_rank_sum = 0
    let high_rank_sum = 0
    let normal_count = 0
    let high_count = 0
    for (let i = 0; i < PROBES * 2; i++) {
        let kind = ch.recv()
        if (kind == 2) {
            high_rank_sum = high_rank_sum + i
            high_count = high_count + 1
        } else {
            normal_rank_sum = normal_rank_sum + i
            normal_count = normal_count + 1
        }
    }
    let normal_avg_rank = 0
    let high_avg_rank = 0
    if (normal_count > 0) {
        normal_avg_rank = normal_rank_sum / normal_count
    }
    if (high_count > 0) {
        high_avg_rank = high_rank_sum / high_count
    }
    print("normal_avg_rank:", normal_avg_rank)
    print("high_avg_rank:", high_avg_rank)
    print("high_before_normal:", high_avg_rank < normal_avg_rank)
}

ch.close()
let elapsed = time.monotonic() - started
print("elapsed_ms:", elapsed)
