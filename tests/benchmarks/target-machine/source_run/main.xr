import { baselineValue } from "./helper"
import "./helper" as helper

fn workload(iterations: i64) -> i64 {
    var result = 0
    var index = 0
    while (index < iterations) {
        result = result + 1
        index = index + 1
    }
    return result
}

print(baselineValue(workload(1000000)))

var shared = ["alpha", "beta"]
print(helper.sharedLengths(shared, shared))
print(len(shared))
