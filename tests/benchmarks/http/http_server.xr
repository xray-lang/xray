/*
 * http_server.xr - xray HTTP server for benchmarking
 *
 * Minimal overhead: static/dynamic routes, no logging in the hot path.
 *
 * Endpoints:
 *   GET /plaintext  - Static "Hello, World!" response
 *   GET /json       - JSON response
 *   POST /echo      - Echo request body
 *
 * Usage:
 *   ./build/xray tests/benchmarks/http/http_server.xr [-- port]
 */

import http
import { Headers, HttpRequest, HttpResponse, HttpVersion } from http

var port = 8080
if (len(process.args) > 0) {
    port = int(process.args[0]) ?? 8080
}

var server = http.Server()

// Static plaintext route (pre-built response, zero overhead)
server.route("GET", "/plaintext", "Hello, World!")

// Static JSON route (the generic static route serializer owns this value).
server.route("GET", "/json", { message: "Hello, World!" })

server.routeHandler("POST", "/echo", fn(req: HttpRequest) -> HttpResponse {
    return HttpResponse(HttpVersion.Http1, 200, "OK", Headers(), req.body)
})

print("xray HTTP Server on port " + string(port))
const serverRunning = Atomic(true)
server.listen(port, serverRunning)
