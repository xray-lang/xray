import http
import { HttpRequest, HttpResponse } from http

var server = http.Server()
server.routeHandler("GET", "/", fn(req: HttpRequest) -> HttpResponse {
    return http.textResponse("Hello, World!")
})

server.routeHandler("GET", "/json", fn(req: HttpRequest) -> HttpResponse {
    return http.jsonResponse({message: "Hello, World!"})
})

const serverRunning = Atomic(true)
server.listen(8080, serverRunning)
