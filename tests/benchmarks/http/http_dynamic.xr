/*
 * http_dynamic.xr - Dynamic handler benchmark
 *
 * All routes use fn(req) callbacks (NOT prebuilt), so every request
 * goes through the VM path: C fast loop → return to VM → invoke handler.
 *
 * Endpoints:
 *   GET /plaintext    - fn returns plain string
 *   GET /json         - fn returns a typed JSON HttpResponse
 *   GET /users/:id    - fn with path params + string concat
 *
 * Usage:
 *   ./build-release/xray tests/benchmarks/http/http_dynamic.xr [-- port]
 */

import http
import { HttpRequest, HttpResponse } from http

var port = 8080
if (len(process.args) > 0) {
    port = i64.tryParse(process.args[0]) ?? 8080
}
var server = http.Server()

// Dynamic plaintext (fn callback, NOT prebuilt)
server.routeHandler("GET", "/plaintext", fn(req: HttpRequest) -> HttpResponse {
    return http.textResponse("Hello, World!")
})

// Dynamic JSON response
server.routeHandler("GET", "/json", fn(req: HttpRequest) -> HttpResponse {
    return http.jsonResponse({ message: "Hello, World!" })
})

// Path params + string concatenation
server.routeHandler("GET", "/users/:id", fn(req: HttpRequest) -> HttpResponse {
    return http.textResponse("User: " + (req.params.get("id") ?? ""))
})

print("xray Dynamic Handler Benchmark on port " + string(port))
const serverRunning = Atomic(true)
server.listen(port, serverRunning)
