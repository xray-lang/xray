// pidigits - Exact translation from Lua version
// Signed BigInt: {sign: 1|-1, digits: [low..high]}
struct BigInt {
    sign: i64
    digits: Array<i64>
}

fn bigint(n: i64) -> BigInt {
    var remaining = n
    var sign = 1
    var digits: Array<i64> = []
    if (remaining < 0) {
        sign = -1
        remaining = 0 - remaining
    }
    if (remaining == 0) {
        digits.push(0)
    } else {
        while (remaining > 0) {
            digits.push(remaining % 10)
            remaining = remaining / 10
        }
    }
    return BigInt{ sign: sign, digits: digits }
}

fn bigint_clone(a: BigInt) -> BigInt {
    var nd: Array<i64> = []
    for (i in 0..len(a.digits)) {
        nd.push(a.digits[i])
    }
    return BigInt{ sign: a.sign, digits: nd }
}

fn normalize(a: BigInt) -> BigInt {
    var result = a
    var d = result.digits
    while (len(d) > 1 && d[len(d) - 1] == 0) {
        d.pop()
    }
    if (len(d) == 1 && d[0] == 0) {
        result.sign = 1
    }
    result.digits = d
    return result
}

fn compare_abs(a: BigInt, b: BigInt) -> i64 {
    var da = a.digits
    var db = b.digits
    if (len(da) > len(db)) {
        return 1
    }
    if (len(da) < len(db)) {
        return -1
    }
    var i = len(da) - 1
    while (i >= 0) {
        if (da[i] > db[i]) {
            return 1
        }
        if (da[i] < db[i]) {
            return -1
        }
        i--
    }
    return 0
}

fn add_abs(a: BigInt, b: BigInt) -> BigInt {
    var da = a.digits
    var db = b.digits
    var rd: Array<i64> = []
    var carry = 0
    var count = len(da)
    if (len(db) > count) {
        count = len(db)
    }
    for (i in 0..count) {
        var va = 0
        var vb = 0
        if (i < len(da)) {
            va = da[i]
        }
        if (i < len(db)) {
            vb = db[i]
        }
        var sum = va + vb + carry
        rd.push(sum % 10)
        carry = sum / 10
    }
    if (carry > 0) {
        rd.push(carry)
    }
    return BigInt{ sign: 1, digits: rd }
}

fn sub_abs(a: BigInt, b: BigInt) -> BigInt {
    var da = a.digits
    var db = b.digits
    var rd: Array<i64> = []
    var borrow = 0
    for (i in 0..len(da)) {
        var vb = 0
        if (i < len(db)) {
            vb = db[i]
        }
        var diff = da[i] - vb - borrow
        if (diff < 0) {
            diff = diff + 10
            borrow = 1
        } else {
            borrow = 0
        }
        rd.push(diff)
    }
    return normalize(BigInt{ sign: 1, digits: rd })
}

fn bigint_add(a: BigInt, b: BigInt) -> BigInt {
    if (a.sign == b.sign) {
        var r = add_abs(a, b)
        r.sign = a.sign
        return r
    }
    var cmp = compare_abs(a, b)
    if (cmp == 0) {
        return bigint(0)
    }
    if (cmp > 0) {
        var r = sub_abs(a, b)
        r.sign = a.sign
        return r
    } else {
        var r = sub_abs(b, a)
        r.sign = b.sign
        return r
    }
}

fn bigint_sub(a: BigInt, b: BigInt) -> BigInt {
    var nb = bigint_clone(b)
    if (len(b.digits) == 1 && b.digits[0] == 0) {
        nb.sign = 1
    } else {
        nb.sign = 0 - b.sign
    }
    return bigint_add(a, nb)
}

fn bigint_mul_int(a: BigInt, n: i64) -> BigInt {
    var factor = n
    if (factor == 0) {
        return bigint(0)
    }
    var rs = a.sign
    if (factor < 0) {
        rs = 0 - rs
        factor = 0 - factor
    }
    var da = a.digits
    var rd: Array<i64> = []
    var carry = 0
    for (i in 0..len(da)) {
        var prod = da[i] * factor + carry
        rd.push(prod % 10)
        carry = prod / 10
    }
    while (carry > 0) {
        rd.push(carry % 10)
        carry = carry / 10
    }
    return normalize(BigInt{ sign: rs, digits: rd })
}

fn bigint_div(a: BigInt, b: BigInt) -> BigInt {
    var rs = a.sign * b.sign
    if (compare_abs(a, b) < 0) {
        return bigint(0)
    }
    var da = a.digits
    var qd: Array<i64> = []
    for (i in 0..len(da)) {
        qd.push(0)
    }
    var rem = BigInt{ sign: 1, digits: [] }
    for (pos in 0..len(da)) {
        var idx = len(da) - 1 - pos
        var nrd = [da[idx]]
        for (j in 0..len(rem.digits)) {
            nrd.push(rem.digits[j])
        }
        rem = normalize(BigInt{ sign: 1, digits: nrd })
        var q = 0
        while (compare_abs(rem, b) >= 0) {
            rem = sub_abs(rem, b)
            q++
        }
        qd[idx] = q
    }
    return normalize(BigInt{ sign: rs, digits: qd })
}

fn bigint_to_int(a: BigInt) -> i64 {
    var d = a.digits
    var r = 0
    var base = 1
    for (i in 0..len(d)) {
        r = r + d[i] * base
        base = base * 10
    }
    return r * a.sign
}

// LFT algorithm state
var lft_q = bigint(1)
var lft_r = bigint(0)
var lft_s = bigint(0)
var lft_t = bigint(1)

fn extract(x: i64) -> i64 {
    var num = bigint_add(bigint_mul_int(lft_q, x), lft_r)
    var den = bigint_add(bigint_mul_int(lft_s, x), lft_t)
    var quot = bigint_div(num, den)
    return bigint_to_int(quot)
}

fn is_safe(digit: i64) -> bool {
    return extract(4) == digit
}

fn produce(digit: i64) {
    lft_r = bigint_mul_int(bigint_sub(lft_r, bigint_mul_int(lft_t, digit)), 10)
    lft_q = bigint_mul_int(lft_q, 10)
}

fn consume(k: i64) {
    var k2 = 2 * k + 1
    var k4 = 4 * k + 2
    var nr = bigint_add(bigint_mul_int(lft_q, k4), bigint_mul_int(lft_r, k2))
    var nt = bigint_add(bigint_mul_int(lft_s, k4), bigint_mul_int(lft_t, k2))
    lft_q = bigint_mul_int(lft_q, k)
    lft_s = bigint_mul_int(lft_s, k)
    lft_r = nr
    lft_t = nt
}

fn pidigits(n: i64) {
    lft_q = bigint(1)
    lft_r = bigint(0)
    lft_s = bigint(0)
    lft_t = bigint(1)
    var count = 0
    var k = 0
    var output = ""
    while (count < n) {
        k++
        consume(k)
        var digit = extract(3)
        if (is_safe(digit)) {
            output = output + digit
            count++
            if (count % 10 == 0) {
                print(output + "	:" + count)
                output = ""
            }
            produce(digit)
        }
    }
    if (len(output) > 0) {
        var pad = 10 - len(output)
        while (pad > 0) {
            output = output + " "
            pad--
        }
        print(output + "	:" + n)
    }
}

var n = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 30 : 30
pidigits(n)
