// Binary Trees Benchmark - Compact mode version
// Uses type annotation to trigger compact shape (8B per field instead of 16B)
type Tree = { left: Tree?, right: Tree? }

fn makeTree(depth: i64): Tree {
    if (depth > 0) {
        return { "left": makeTree(depth - 1), "right": makeTree(depth - 1) }
    } else {
        return { "left": null, "right": null }
    }
}

fn checksum(node: Tree?): i64 {
    if (node == null) {
        return 0
    }
    if (node.left == null) {
        return 1
    }
    return checksum(node.left) + checksum(node.right) + 1
}

fn run(maxDepth: i64) {
    var minDepth = 4
    // Stretch tree
    var stretchDepth = maxDepth + 1
    var stretchTree = makeTree(stretchDepth)
    print("stretch tree of depth " + stretchDepth + "\t check: " + checksum(stretchTree))
    // Long-lived tree
    var longLivedTree = makeTree(maxDepth)
    // Iterations
    var depth = minDepth
    while (depth <= maxDepth) {
        var iterations = 1
        var j = 0
        while (j < maxDepth - depth + minDepth) {
            iterations = iterations * 2
            j = j + 1
        }
        var check = 0
        var i = 1
        while (i <= iterations) {
            var tree = makeTree(depth)
            check = check + checksum(tree)
            i = i + 1
        }
        print(iterations + "\t trees of depth " + depth + "\t check: " + check)
        depth = depth + 2
    }
    print("long lived tree of depth " + maxDepth + "\t check: " + checksum(longLivedTree))
}

// Read depth from command line, default 16
var maxDepth = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 16 : 16
run(maxDepth)
