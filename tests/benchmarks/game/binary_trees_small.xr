// Binary Trees Benchmark - Xray typed class version（小规模测试）
// 用于性能对比测试

class Tree {
    left: Tree?
    right: Tree?

    constructor(left: Tree?, right: Tree?) {
        this.left = left
        this.right = right
    }
}

fn makeTree(depth: int) -> Tree {
    if (depth > 0) {
        return Tree(makeTree(depth - 1), makeTree(depth - 1))
    } else {
        return Tree(null, null)
    }
}

fn checksum(node: Tree?) -> int {
    if (node == null) {
        return 0
    }
    if (node.left == null) {
        return 1
    }
    return checksum(node.left) + checksum(node.right) + 1
}

fn run(maxDepth: int) {
    var minDepth = 4
    // Stretch tree
    var stretchDepth = maxDepth + 1
    var stretchTree = makeTree(stretchDepth)
    print("stretch tree of depth ${stretchDepth}\t check: ${checksum(stretchTree)}")
    // Long-lived tree
    var longLivedTree = makeTree(maxDepth)
    // Iterations
    var depth = minDepth
    while (depth <= maxDepth) {
        var iterations = 1
        var j = 0
        while (j < maxDepth - depth + minDepth) {
            iterations = iterations * 2
            j = j + 1
        }
        var check = 0
        var i = 1
        while (i <= iterations) {
            var tree = makeTree(depth)
            check = check + checksum(tree)
            i = i + 1
        }
        print("${iterations}\t trees of depth ${depth}\t check: ${check}")
        depth = depth + 2
    }
    print("long lived tree of depth ${maxDepth}\t check: ${checksum(longLivedTree)}")
}

// 小规模测试，深度 10
var maxDepth = 10
run(maxDepth)
