// GC Stress Test: Linked List Churn
// Tests short-lived object allocation throughput.
// Creates and immediately discards linked lists of various lengths,
// forcing the GC to handle massive ephemeral allocation.
//
// Usage: xray gc_linkedlist_churn.xr -- [iterations]

final class ListNode {
    value: i64
    next: ListNode?

    init(value: i64, next: ListNode?) {
        this.value = value
        this.next = next
    }
}

fn makeList(length: i64) -> ListNode? {
    var node: ListNode? = null
    var i = 0
    while (i < length) {
        node = ListNode(i, node)
        i = i + 1
    }
    return node
}

fn sumList(node: ListNode?) -> i64 {
    var cursor = node
    var sum = 0
    while (cursor != null) {
        sum = sum + cursor!.value
        cursor = cursor!.next
    }
    return sum
}

fn run(n: i64) {
    var total = 0

    // Phase 1: Many short lists (high churn, young gen pressure)
    var i = 0
    while (i < n * 100) {
        var list = makeList(10)
        total = total + sumList(list)
        i = i + 1
    }
    print("Phase 1 (short lists x" + (n * 100) + "): sum=" + total)

    // Phase 2: Fewer medium lists (mixed lifetime)
    total = 0
    i = 0
    while (i < n * 10) {
        var list = makeList(100)
        total = total + sumList(list)
        i = i + 1
    }
    print("Phase 2 (medium lists x" + (n * 10) + "): sum=" + total)

    // Phase 3: Few long lists (promotion pressure)
    total = 0
    i = 0
    while (i < n) {
        var list = makeList(1000)
        total = total + sumList(list)
        i = i + 1
    }
    print("Phase 3 (long lists x" + n + "): sum=" + total)
}

var n = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 1000 : 1000
run(n)
