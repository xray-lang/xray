// Binary Trees Benchmark - Xray AOT version
// All functions fully typed for AOT compilation

class Tree {
    left: Tree?
    right: Tree?

    constructor(left: Tree?, right: Tree?) {
        this.left = left
        this.right = right
    }
}

fn makeTree(depth: i64) -> Tree {
    if (depth > 0) {
        return Tree(makeTree(depth - 1), makeTree(depth - 1))
    } else {
        return Tree(null, null)
    }
}

fn checksum(node: Tree?) -> i64 {
    if (node == null) {
        return 0
    }
    if (node.left == null) {
        return 1
    }
    return checksum(node.left) + checksum(node.right) + 1
}

fn run(maxDepth: i64) {
    var minDepth = 4
    var stretchDepth = maxDepth + 1
    var stretchTree = makeTree(stretchDepth)
    print("stretch tree of depth " + stretchDepth.toString() + "\t check: " +
          checksum(stretchTree).toString())
    var longLivedTree = makeTree(maxDepth)
    var depth = minDepth
    while (depth <= maxDepth) {
        var iterations = 1
        var j = 0
        while (j < maxDepth - depth + minDepth) {
            iterations = iterations * 2
            j = j + 1
        }
        var check = 0
        var i = 1
        while (i <= iterations) {
            var tree = makeTree(depth)
            check = check + checksum(tree)
            i = i + 1
        }
        print(iterations.toString() + "\t trees of depth " + depth.toString() + "\t check: " +
              check.toString())
        depth = depth + 2
    }
    print("long lived tree of depth " + maxDepth.toString() + "\t check: " +
          checksum(longLivedTree).toString())
}

var maxDepth = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 16 : 16
run(maxDepth)
