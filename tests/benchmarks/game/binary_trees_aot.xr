// Binary Trees Benchmark - Xray AOT version
// All functions fully typed for AOT compilation

fn makeTree(depth: int) : Json {
    if (depth > 0) {
        return { "left": makeTree(depth - 1), "right": makeTree(depth - 1) }
    } else {
        return { "left": null, "right": null }
    }
}

fn checksum(node: Json): int {
    if (node == null) {
        return 0
    }
    if (node.left == null) {
        return 1
    }
    return checksum(node.left) + checksum(node.right) + 1
}

fn run(maxDepth: int) {
    var minDepth = 4
    var stretchDepth = maxDepth + 1
    var stretchTree = makeTree(stretchDepth)
    print("stretch tree of depth " + stretchDepth + "\t check: " + checksum(stretchTree))
    var longLivedTree = makeTree(maxDepth)
    var depth = minDepth
    while (depth <= maxDepth) {
        var iterations = 1
        var j = 0
        while (j < maxDepth - depth + minDepth) {
            iterations = iterations * 2
            j = j + 1
        }
        var check = 0
        var i = 1
        while (i <= iterations) {
            var tree = makeTree(depth)
            check = check + checksum(tree)
            i = i + 1
        }
        print(iterations + "\t trees of depth " + depth + "\t check: " + check)
        depth = depth + 2
    }
    print("long lived tree of depth " + maxDepth + "\t check: " + checksum(longLivedTree))
}

var maxDepth = process.args.length > 0 ? int(process.args[0]) ?? 16 : 16
run(maxDepth)
