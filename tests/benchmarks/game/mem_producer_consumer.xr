// GC Stress Test: Producer-Consumer
// Tests cross-generational references and write barrier overhead.
// A long-lived queue (old gen) constantly receives new objects (young gen)
// and old objects are dequeued and discarded.
// This creates a steady stream of old→young references.
//
// Usage: xray gc_producer_consumer.xr -- [iterations]

// A queue has shared mutable identity; its elements keep their declared value type.
final class Queue<T> {
    data: Array<T?>
    head: i64
    tail: i64
    size: i64
    capacity: i64

    init(capacity: i64) {
        this.data = Array<T?>(capacity, null)
        this.head = 0
        this.tail = 0
        this.size = 0
        this.capacity = capacity
    }
}

struct PayloadItem {
    id: i64
    payload: string
}

struct ValueItem {
    v: i64
}

final class PartnerItem {
    id: i64
    partner: PartnerItem?

    init(id: i64, partner: PartnerItem? = null) {
        this.id = id
        this.partner = partner
    }
}

fn enqueue<T>(q: Queue<T>, item: T) {
    q.data[q.tail] = item
    q.tail = (q.tail + 1) % q.capacity
    q.size = q.size + 1
}

fn dequeue<T>(q: Queue<T>) -> T {
    var item = q.data[q.head]!
    q.data[q.head] = null
    q.head = (q.head + 1) % q.capacity
    q.size = q.size - 1
    return item
}

fn run(n: i64) {
    var queueSize = 1000

    // Phase 1: Steady-state producer-consumer
    // Queue is old, items are young → write barrier on every enqueue
    var q = Queue<PayloadItem>(queueSize)

    // Fill queue initially
    var i = 0
    while (i < queueSize) {
        enqueue(q, PayloadItem{id: i, payload: "data_" + i})
        i = i + 1
    }
    print("Queue initialized: size=" + q.size)

    // Steady-state: produce and consume at same rate
    var checksum = 0
    i = 0
    while (i < n * 1000) {
        var old = dequeue(q)
        checksum = checksum + old.id
        enqueue(q, PayloadItem{id: i, payload: "new_" + (i % 100)})
        i = i + 1
    }
    print("Phase 1 (steady state x" + (n * 1000) + "): checksum=" + checksum)

    // Phase 2: Burst producer (queue grows then shrinks)
    // Creates temporary spikes of young objects referenced by old queue
    var burstQ = Queue<ValueItem>(5000)
    var total = 0
    var round = 0
    while (round < n) {
        // Burst: produce 100 items
        i = 0
        while (i < 100) {
            enqueue(burstQ, ValueItem{v: round * 100 + i})
            i = i + 1
        }
        // Consume all
        while (burstQ.size > 0) {
            var item = dequeue(burstQ)
            total = total + item.v
        }
        round = round + 1
    }
    print("Phase 2 (burst x" + n + "): total=" + total)

    // Phase 3: Multiple queues with cross-references
    // Items in one queue point to items from another → complex reference graph
    var q1 = Queue<PartnerItem>(500)
    var q2 = Queue<PartnerItem>(500)
    i = 0
    while (i < 500) {
        var item1 = PartnerItem(i)
        var item2 = PartnerItem(i + 10000, item1)
        item1.partner = item2
        enqueue(q1, item1)
        enqueue(q2, item2)
        i = i + 1
    }
    // Churn with cross-references
    checksum = 0
    i = 0
    while (i < n * 100) {
        var old1 = dequeue(q1)
        var old2 = dequeue(q2)
        checksum = checksum + old1.id + old2.partner!.id
        var new1 = PartnerItem(i)
        var new2 = PartnerItem(i + 10000, new1)
        new1.partner = new2
        enqueue(q1, new1)
        enqueue(q2, new2)
        i = i + 1
    }
    print("Phase 3 (cross-ref x" + (n * 100) + "): checksum=" + checksum)
}

var n = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 500 : 500
run(n)
