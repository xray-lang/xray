// GC Stress Test: Fragmentation
// Tests memory fragmentation and reclamation efficiency.
// Allocates objects of varying sizes in interleaved patterns,
// then selectively frees some to create "holes" in memory.
// Good GC/allocators (like Immix) should handle this efficiently.
//
// Usage: xray gc_fragmentation.xr -- [iterations]

struct SmallItem {
    kind: string
    id: i64
}

struct MediumItem {
    kind: string
    id: i64
    a: i64
    b: i64
    c: i64
    d: i64
}

struct LargeItem {
    kind: string
    id: i64
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
    f: i64
    g: i64
    h: i64
}

struct FillItem {
    round: i64
    idx: i64
    data: i64
}

struct ParentItem {
    id: i64
    children: Array<ChildItem>
}

struct ChildItem {
    parent: i64
    gen: i64
    val: i64
}

struct TinyItem {
    x: i64
}

struct Point3 {
    x: i64
    y: i64
    z: i64
}

struct WideItem {
    x: i64
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
}

fn run(n: i64) {
    // Phase 1: Swiss cheese pattern
    // Allocate array of objects, then nil-out every other one
    // This creates maximum fragmentation for line-based allocators
    var objects: Array<SmallItem | MediumItem | LargeItem | FillItem | null> = []
    var i = 0
    while (i < 2000) {
        // Varying sizes: small and medium objects interleaved
        if (i % 3 == 0) {
            objects.push(SmallItem{ kind: "small", id: i })
        } else if (i % 3 == 1) {
            objects.push(MediumItem{ kind: "medium", id: i, a: 1, b: 2, c: 3, d: 4 })
        } else {
            objects.push(LargeItem{ kind: "large", id: i, a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })
        }
        i = i + 1
    }
    print("Phase 1: allocated 2000 objects")

    // Punch holes: remove every other object
    var checksum = 0
    var round = 0
    while (round < n) {
        i = 0
        while (i < 2000) {
            if (i % 2 == round % 2) {
                objects[i] = null
            }
            i = i + 1
        }

        // Allocate new objects into the holes
        i = 0
        while (i < 2000) {
            if (objects[i] == null) {
                var fill = FillItem{round: round, idx: i, data: round * 2000 + i}
                objects[i] = fill
                checksum = checksum + fill.data
            }
            i = i + 1
        }
        round = round + 1
    }
    print("Phase 1 done (" + n + " rounds): checksum=" + checksum)

    // Phase 2: Generational fragmentation
    // Keep some objects alive across many GC cycles (old gen)
    // while rapidly churning others (young gen)
    var permanent: Array<ParentItem> = []
    i = 0
    while (i < 200) {
        permanent.push(ParentItem{ id: i, children: [] })
        i = i + 1
    }

    var total = 0
    round = 0
    while (round < n) {
        // Add temporary children to permanent objects (old→young refs)
        i = 0
        while (i < 200) {
            // Replace children each round
            var kids: Array<ChildItem> = []
            var j = 0
            while (j < 5) {
                kids.push(ChildItem{ parent: i, gen: round, val: round * 5 + j })
                j = j + 1
            }
            permanent[i].children = kids
            i = i + 1
        }
        // Read some data to prevent optimization
        total = total + permanent[round % 200].children[round % 5].val
        round = round + 1
    }
    print("Phase 2 (generational frag x" + n + "): total=" + total)

    // Phase 3: Reallocate with different sizes
    // After fragmentation, allocate objects of different sizes
    // Tests whether the allocator can reuse fragmented space
    var mixed: Array<TinyItem | Point3 | WideItem | string> = []
    round = 0
    while (round < n) {
        mixed = []
        i = 0
        while (i < 500) {
            // Alternate between tiny and larger objects
            if (i % 4 == 0) {
                mixed.push(TinyItem{ x: i })
            } else if (i % 4 == 1) {
                mixed.push(Point3{ x: i, y: i * 2, z: i * 3 })
            } else if (i % 4 == 2) {
                mixed.push(WideItem{ x: i, a: 1, b: 2, c: 3, d: 4, e: 5 })
            } else {
                mixed.push("str_" + i + "_round_" + round)
            }
            i = i + 1
        }
        round = round + 1
    }
    var lastLen = len(mixed)
    print("Phase 3 (size mixing x" + n + "): final array length=" + lastLen)
}

var n = len(process.args) > 0 ? i64.tryParse(process.args[0]) ?? 500 : 500
run(n)
