// Binary Trees Benchmark - Map-backed node version.

class MapTree {
    children: Map<string, MapTree?>

    constructor(left: MapTree?, right: MapTree?) {
        this.children = Map()
        this.children.set("left", left)
        this.children.set("right", right)
    }
}

fn makeTree(depth: int) -> MapTree {
    if (depth > 0) {
        return MapTree(makeTree(depth - 1), makeTree(depth - 1))
    }
    return MapTree(null, null)
}

fn checksum(node: MapTree?) -> int {
    if (node == null) { return 0 }
    var left = node!.children.get("left")
    if (left == null) { return 1 }
    return checksum(left) + checksum(node!.children.get("right")) + 1
}

fn run(maxDepth: int) {
    var minDepth = 4
    var stretchDepth = maxDepth + 1
    var stretchTree = makeTree(stretchDepth)
    print("stretch tree of depth ${stretchDepth}\t check: ${checksum(stretchTree)}")
    var longLivedTree = makeTree(maxDepth)
    var depth = minDepth
    while (depth <= maxDepth) {
        var iterations = 1
        var j = 0
        while (j < maxDepth - depth + minDepth) {
            iterations *= 2
            j++
        }
        var check = 0
        for (var i = 1; i <= iterations; i++) {
            check += checksum(makeTree(depth))
        }
        print("${iterations}\t trees of depth ${depth}\t check: ${check}")
        depth += 2
    }
    print("long lived tree of depth ${maxDepth}\t check: ${checksum(longLivedTree)}")
}

var maxDepth = len(process.args) > 0 ? int(process.args[0]) ?? 16 : 16
run(maxDepth)
