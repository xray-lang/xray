// TCP benchmark server for xray
// Usage: xray echo_server.xr [-- port mode extra]

import net
import time

fn serveStream(conn: NetConn) {
    defer { net.close(conn) }
    net.copy(conn, conn, 65536)
}

fn serveMessage(conn: NetConn) {
    defer { net.close(conn) }
    var buf = Array<u8>(65536)
    while (true) {
        var n = net.readInto(conn, ref buf, 65536)
        if (n <= 0) {
            break
        }
        var written = net.writeBytes(conn, buf)
        if (written <= 0) {
            break
        }
    }
}

fn serveBytes(conn: NetConn) {
    defer { net.close(conn) }
    var buf = Array<u8>(65536)
    while (true) {
        var n = net.readInto(conn, ref buf)
        if (n <= 0) {
            break
        }
        var written = net.writeBytes(conn, buf)
        if (written <= 0) {
            break
        }
    }
}

fn serveDiscard(conn: NetConn) {
    defer { net.close(conn) }
    var buf = Array<u8>(65536)
    while (true) {
        var n = net.readInto(conn, ref buf, 65536)
        if (n <= 0) {
            break
        }
    }
    net.writeBytes(conn, "OK".copyBytes())
}

fn serveSlowDiscard(conn: NetConn, delayMs: i64) {
    defer { net.close(conn) }
    var buf = Array<u8>(4096)
    while (true) {
        var n = net.readInto(conn, ref buf, 4096)
        if (n <= 0) {
            break
        }
        if (delayMs > 0) {
            time.sleep(delayMs)
        }
    }
    net.writeBytes(conn, "OK".copyBytes())
}

fn serveSource(conn: NetConn, totalBytes: i64) {
    defer { net.close(conn) }
    var chunk = "S".repeat(65536).copyBytes()
    var remaining = totalBytes
    while (remaining > 0) {
        var data = chunk
        if (remaining < 65536) {
            data = "S".repeat(remaining).copyBytes()
        }
        var n = net.writeBytes(conn, data)
        if (n <= 0) {
            break
        }
        remaining = remaining - n
    }
}

fn tryDial(port: i64) -> NetConn? {
    try {
        return net.dial("127.0.0.1", port)
    } catch (e) {
        return null
    }
}

fn serveProxy(client: NetConn, upstreamPort: i64) {
    var upstream = tryDial(upstreamPort)
    if (upstream == null) {
        net.close(client)
        return
    }

    net.copyBidirectional(client, upstream!)
    net.close(client)
    net.close(upstream!)
}

fn handleConn(conn: NetConn, mode: string, extra: i64) {
    if (mode == "stream") {
        serveStream(conn)
    } else if (mode == "message" || mode == "idle") {
        serveMessage(conn)
    } else if (mode == "bytes") {
        serveBytes(conn)
    } else if (mode == "discard") {
        serveDiscard(conn)
    } else if (mode == "slow_discard") {
        serveSlowDiscard(conn, extra)
    } else if (mode == "source") {
        serveSource(conn, extra)
    } else if (mode == "proxy") {
        serveProxy(conn, extra)
    } else {
        serveStream(conn)
    }
}

var port = 9001
if (len(process.args) > 0) {
    port = i64.tryParse(process.args[0]) ?? 9001
}

var mode = "stream"
if (len(process.args) > 1) {
    mode = process.args[1]
}

var extra = 67108864
if (len(process.args) > 2) {
    extra = i64.tryParse(process.args[2]) ?? extra
}

var listener = net.listen(port, 1024)
print("xray TCP benchmark server listening on port " + string(port) + " mode=" + mode)

while (true) {
    var conn = net.accept(listener)
    if (conn == null) {
        continue
    }
    go handleConn(conn, mode, extra)
}
