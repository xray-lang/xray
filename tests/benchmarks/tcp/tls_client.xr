// Xray TLS benchmark client.
// Called by tls_bench.py; prints RESULT lines parsed by the Python harness.

import net
import { DialOptions, NetConn } from net
import time

fn readFull(conn: NetConn, buf: ref Array<u8>, size: i64) -> bool {
    var received = 0
    while (received < size) {
        var n = net.readInto(conn, ref buf, size - received)
        if (n <= 0) {
            return false
        }
        received = received + n
    }
    return true
}

fn tryDialTLS(host: string, port: i64) -> NetConn? {
    try {
        return net.dial(host, port, DialOptions(30000, true))
    } catch (e) {
        return null
    }
}

fn echoOnce(conn: NetConn, payload: Array<u8>, scratch: ref Array<u8>) -> bool {
    var n = net.writeBytes(conn, payload)
    if (n != len(payload)) {
        return false
    }
    return readFull(conn, ref scratch, len(payload))
}

fn printResult(name: string, fields: string) {
    print("RESULT " + name + " " + fields)
}

fn benchHandshake(host: string, port: i64, count: i64) {
    var ok = 0
    var start = time.micros()
    for (var i = 0; i < count; i++) {
        var conn = tryDialTLS(host, port)
        if (conn != null) {
            ok++
            net.close(conn!)
        }
    }
    var elapsed_us = time.micros() - start
    var elapsed_sec = (elapsed_us as f64) / 1000000.0
    var rate = (ok as f64) / elapsed_sec
    printResult("tls_handshake_rate",
        "handshakes=" + string(ok)
        + " elapsed_sec=" + string(elapsed_sec)
        + " handshakes_per_sec=" + string(rate)
        + " complete=" + string(ok == count))
}

fn benchLatency(host: string, port: i64, iterations: i64) {
    var conn = tryDialTLS(host, port)
    if (conn == null) {
        printResult("tls_latency", "complete=false error=dial")
        return
    }

    var payload = "L".repeat(64).copyBytes()
    var scratch = Array<u8>(65536)
    for (var i = 0; i < 20; i++) {
        if (!echoOnce(conn!, payload, ref scratch)) {
            printResult("tls_latency", "complete=false error=warmup")
            net.close(conn!)
            return
        }
    }

    var latencies: Array<i64> = []
    var total = 0
    for (var i = 0; i < iterations; i++) {
        var start = time.micros()
        if (!echoOnce(conn!, payload, ref scratch)) {
            printResult("tls_latency", "complete=false error=echo")
            net.close(conn!)
            return
        }
        var elapsed = time.micros() - start
        total = total + elapsed
        latencies.push(elapsed)
    }
    latencies.sort()
    net.close(conn!)

    var p95_idx = (len(latencies) * 95) / 100
    var p99_idx = (len(latencies) * 99) / 100
    printResult("tls_latency",
        "iterations=" + string(iterations)
        + " avg=" + string(total / iterations)
        + " median=" + string(latencies[len(latencies) / 2])
        + " p95=" + string(latencies[p95_idx])
        + " p99=" + string(latencies[p99_idx])
        + " complete=true")
}

fn benchThroughput(host: string, port: i64, iterations: i64, msgSize: i64) {
    var conn = tryDialTLS(host, port)
    if (conn == null) {
        printResult("tls_throughput", "complete=false error=dial")
        return
    }

    var payload = "T".repeat(msgSize).copyBytes()
    var scratch = Array<u8>(65536)
    for (var i = 0; i < 50; i++) {
        if (!echoOnce(conn!, payload, ref scratch)) {
            printResult("tls_throughput", "complete=false error=warmup")
            net.close(conn!)
            return
        }
    }

    var start = time.micros()
    for (var i = 0; i < iterations; i++) {
        if (!echoOnce(conn!, payload, ref scratch)) {
            printResult("tls_throughput", "complete=false error=echo")
            net.close(conn!)
            return
        }
    }
    var elapsed_us = time.micros() - start
    net.close(conn!)

    var elapsed_sec = (elapsed_us as f64) / 1000000.0
    var msg_per_sec = (iterations as f64) / elapsed_sec
    var mb_per_sec = ((msgSize as f64) * (iterations as f64) * 2.0 / elapsed_sec) / (1024.0 * 1024.0)
    printResult("tls_throughput",
        "msg_size=" + string(msgSize)
        + " iterations=" + string(iterations)
        + " elapsed_sec=" + string(elapsed_sec)
        + " msg_per_sec=" + string(msg_per_sec)
        + " mb_per_sec=" + string(mb_per_sec)
        + " complete=true")
}

fn benchLarge(host: string, port: i64, sizeMb: i64) {
    var conn = tryDialTLS(host, port)
    if (conn == null) {
        printResult("tls_large", "complete=false error=dial")
        return
    }

    var size = sizeMb * 1024 * 1024
    var payload = "G".repeat(size).copyBytes()
    var scratch = Array<u8>(65536)
    var start = time.micros()
    var ok = echoOnce(conn!, payload, ref scratch)
    var elapsed_us = time.micros() - start
    net.close(conn!)

    var elapsed_sec = (elapsed_us as f64) / 1000000.0
    var mb_per_sec = ((size as f64) * 2.0 / elapsed_sec) / (1024.0 * 1024.0)
    printResult("tls_large",
        "size_mb=" + string(sizeMb)
        + " elapsed_sec=" + string(elapsed_sec)
        + " mb_per_sec=" + string(mb_per_sec)
        + " complete=" + string(ok))
}

var host = "localhost"
if (len(process.args) > 0) {
    host = process.args[0]
}

var port = 9443
if (len(process.args) > 1) {
    port = i64.tryParse(process.args[1]) ?? 9443
}

var mode = "all"
if (len(process.args) > 2) {
    mode = process.args[2]
}

if (!net.hasTLS()) {
    printResult("tls_unavailable", "complete=false")
} else if (mode == "handshake") {
    benchHandshake(host, port, 50)
} else if (mode == "latency") {
    benchLatency(host, port, 300)
} else if (mode == "throughput") {
    benchThroughput(host, port, 1000, 1024)
} else if (mode == "large") {
    benchLarge(host, port, 1)
} else {
    benchHandshake(host, port, 50)
    benchLatency(host, port, 300)
    benchThroughput(host, port, 1000, 1024)
    benchLarge(host, port, 1)
}
