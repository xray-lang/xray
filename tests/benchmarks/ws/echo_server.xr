/*
 * echo_server.xr - xray WebSocket echo server for benchmarking
 *
 * Minimal overhead: pure echo, no logging in the hot path.
 *
 * Usage:
 *   ./build/xray tests/ws_benchmark/echo_server.xr [-- port]
 */

import ws
import { WsConn } from ws

var port = 9001
if (len(process.args) > 0) {
    port = i64.tryParse(process.args[0]) ?? 9001
}

print("xray WebSocket Echo Server on port " + string(port))

// serve runs one coroutine per accepted connection until `running` clears.
const running = Atomic(true)

ws.serve(port, fn(conn: ref WsConn) {
    while (true) {
        var msg = conn.recv()
        if (msg == null || msg!.error != null) {
            break
        }
        var data = msg!.data
        if (data != null) {
            conn.sendBytes(data!, msg!.binary)
        }
    }
}, running)
