/*
 * bench_client.xr - xray WebSocket benchmark client
 *
 * Tests xray as a WS client against any echo server.
 * Complements ws_bench.py (which tests servers from Python's perspective).
 *
 * Usage:
 *   ./build/xray tests/ws_benchmark/bench_client.xr [-- url]
 *   Default URL: ws://127.0.0.1:9001
 */

import ws
import time

var url = "ws://127.0.0.1:9001"
if (len(process.args) > 0) {
    url = process.args[0]
}

fn make_text(size) {
    var s = "X"
    while (len(s) < size) {
        s = s + s
    }
    return s.slice(0, size)
}

fn bench_echo(label, payload, is_binary, count) {
    var conn = ws.connect(url)
    if (conn == null) {
        print("  " + label + "  ERROR: connect failed")
        return
    }

    // warmup
    var warmup = 20
    if (warmup > count) { warmup = count }
    for (var i = 0; i < warmup; i++) {
        ws.send(conn, payload, is_binary)
        ws.recv(conn, null)
    }

    var t0 = time.monotonic()
    for (var i = 0; i < count; i++) {
        ws.send(conn, payload, is_binary)
        var r = ws.recv(conn, null)
        if (r == null || r.error) {
            print("  " + label + "  ERROR at msg " + string(i))
            ws.close(conn)
            return
        }
    }
    var elapsed_ms = time.monotonic() - t0
    ws.close(conn)

    var size = len(payload)
    var elapsed_sec = (elapsed_ms as f64) / 1000.0
    var msg_per_sec = (count as f64) / elapsed_sec
    var mb_per_sec = ((size as f64) * (count as f64) * 2.0 / elapsed_sec) / (1024.0 * 1024.0)
    var avg_rtt = elapsed_ms / (count as f64)

    print("  " + label + "  " + string((msg_per_sec as i64)) + " msg/s  "
        + string(((mb_per_sec * 100.0 as i64) as f64) / 100.0) + " MB/s  rtt="
        + string(((avg_rtt * 1000.0 as i64) as f64) / 1000.0) + "ms")
}

print("╔══════════════════════════════════════════════╗")
print("║  xray WebSocket Client Benchmark             ║")
print("║  Server: " + url)
print("╚══════════════════════════════════════════════╝")
print("")

// text payloads
var sizes = [64, 256, 1024, 4096]
var counts = [3000, 3000, 2000, 1000]

print("━━━ Text Echo ━━━")
for (var i = 0; i < len(sizes); i++) {
    var payload = make_text(sizes[i])
    bench_echo(string(sizes[i]) + "B text", payload, false, counts[i])
    time.sleep(200)
}
print("")

// binary payloads
print("━━━ Binary Echo ━━━")
var bin_sizes = [65536, 262144, 1048576]
var bin_counts = [300, 100, 30]

for (var i = 0; i < len(bin_sizes); i++) {
    var payload = Array<u8>(bin_sizes[i], 0xAB)
    var label = string(bin_sizes[i] / 1024) + "KB bin"
    bench_echo(label, payload, true, bin_counts[i])
    time.sleep(200)
}
print("")
print("━━━ Done ━━━")
