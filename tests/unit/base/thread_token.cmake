add_executable(test_os_thread_token "${CMAKE_CURRENT_LIST_DIR}/test_thread_token.c")
target_include_directories(test_os_thread_token PRIVATE "${PROJECT_SOURCE_DIR}/src")
set_target_properties(test_os_thread_token PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(MSVC)
    target_compile_options(test_os_thread_token PRIVATE /W4 /WX /utf-8)
    if(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(test_os_thread_token PRIVATE /experimental:c11atomics)
    endif()
else()
    target_compile_options(test_os_thread_token PRIVATE -Wall -Wextra -Werror -pedantic)
endif()
if(NOT WIN32)
    find_package(Threads REQUIRED)
    target_link_libraries(test_os_thread_token PRIVATE Threads::Threads)
    target_compile_definitions(test_os_thread_token PRIVATE _POSIX_C_SOURCE=200809L)
endif()
add_test(NAME os_thread_token COMMAND test_os_thread_token)
set_tests_properties(os_thread_token PROPERTIES RUN_SERIAL TRUE TIMEOUT 60 LABELS "unit;ownership;os;thread")
