# Shared registration for the production build and isolated allocator tests.
get_filename_component(XR_RESOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(compile_resources_production OBJECT "${XR_RESOURCE_ROOT}/src/base/xcompile_resources.c")

foreach(resource_target compile_resources_production   )
    target_include_directories(${resource_target} PRIVATE "${XR_RESOURCE_ROOT}/src")
    target_compile_features(${resource_target} PRIVATE c_std_11)
    if(MSVC)
        target_compile_definitions(${resource_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
        target_compile_options(${resource_target} PRIVATE /W4 /WX /utf-8)
        if(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
            target_compile_options(${resource_target} PRIVATE /experimental:c11atomics)
        endif()
    else()
        target_compile_options(${resource_target} PRIVATE -Wall -Wextra -Werror -pedantic)
    endif()
endforeach()
if(NOT WIN32)
    find_package(Threads REQUIRED)

endif()
