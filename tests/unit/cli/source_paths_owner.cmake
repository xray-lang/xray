if(NOT WIN32)
    return()
endif()
# The package mode compiles the selector without the checkout stdlib that an
# uninstalled build injects, which is how a release package is configured.
foreach(mode injected production package)
    set(target test_source_paths_${mode})
    add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/source_paths_owner/test_source_paths.c")
    target_link_libraries(${target} PRIVATE xray_source_compile)
    if(mode STREQUAL "production" OR mode STREQUAL "package")
        target_compile_definitions(${target} PRIVATE SOURCE_PATHS_PRODUCTION)
    endif()
    if(mode STREQUAL "package")
        target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/api/xsource_paths.c")
    endif()
    target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/include")
    target_compile_definitions(${target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _CRT_SECURE_NO_WARNINGS)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic)
    endif()
    if(CMAKE_C_COMPILER_ID STREQUAL "MSVC")
        target_compile_options(${target} PRIVATE /experimental:c11atomics)
    endif()
    set(source_tree "")
    if(XRAY_SOURCE_TREE_STDLIB AND NOT mode STREQUAL "package")
        set(source_tree "${PROJECT_SOURCE_DIR}/stdlib")
    endif()
    add_test(NAME source_paths_${mode} COMMAND ${XRAY_PYTHON} -X utf8
        "${CMAKE_CURRENT_LIST_DIR}/source_paths_owner/test_source_paths.py" $<TARGET_FILE:${target}>
        ${source_tree})
    set_tests_properties(source_paths_${mode} PROPERTIES
        TIMEOUT 120 RUN_SERIAL TRUE LABELS "unit;cli;ownership;budget")
endforeach()
