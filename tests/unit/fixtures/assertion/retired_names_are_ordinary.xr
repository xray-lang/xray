fn assert_true(value: i64) -> i64 { return value + 1 }
fn assert_false(value: i64) -> i64 { return value + 2 }
fn assert_eq(value: i64) -> i64 { return value + 3 }
fn assert_ne(value: i64) -> i64 { return value + 4 }
fn assert_throws(value: i64) -> i64 { return value + 5 }

assertEqual(assert_true(1), 2)
assertEqual(assert_false(1), 3)
assertEqual(assert_eq(1), 4)
assertEqual(assert_ne(1), 5)
assertEqual(assert_throws(1), 6)
