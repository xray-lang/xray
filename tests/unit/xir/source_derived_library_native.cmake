foreach(cold_scope RANGE 0 1)
    if(cold_scope EQUAL 0)
        set(cold_producer test_xir_source_derived_library)
    else()
        set(cold_producer test_xir_source_derived_library_resources_1)
    endif()
    set(cold_c "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_cold_library_${cold_scope}.c")
    set(cold_packet "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_cold_library_${cold_scope}.chk")
    add_custom_command(OUTPUT ${cold_c} ${cold_packet}
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
        COMMAND $<TARGET_FILE:${cold_producer}> --emit-native ${cold_c} ${cold_packet}
        DEPENDS ${cold_producer} VERBATIM)
    foreach(cold_engine IN ITEMS native mixed)
        set(cold_target "test_xir_source_derived_library_${cold_engine}_${cold_scope}")
        add_executable(${cold_target} "${CMAKE_CURRENT_LIST_DIR}/test_xir_source_derived_library_${cold_engine}.c" ${cold_c})
        if(cold_engine STREQUAL "native")
            target_link_libraries(${cold_target} PRIVATE xray_xir_scalar)
        else()
            target_link_libraries(${cold_target} PRIVATE xray_xir_vm)
            target_compile_definitions(${cold_target} PRIVATE XR_DERIVED_LIBRARY_PACKET="${cold_packet}")
        endif()
        set_target_properties(${cold_target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(MSVC)
            target_compile_options(${cold_target} PRIVATE /utf-8 /W4 /WX)
        else()
            target_compile_options(${cold_target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${cold_target} COMMAND ${cold_target})
        set_tests_properties(${cold_target} PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE
            LABELS "unit;xir;source;ctfe;generated;library;ownership;execution;abi")
    endforeach()
endforeach()
