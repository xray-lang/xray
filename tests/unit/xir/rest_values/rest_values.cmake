add_executable(test_xir_rest_values "${CMAKE_CURRENT_LIST_DIR}/test_rest_values.c" "${CMAKE_CURRENT_LIST_DIR}/rest_producer_controls.c")
target_link_libraries(test_xir_rest_values PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
target_compile_definitions(test_xir_rest_values PRIVATE XR_REST_VALUES="${CMAKE_CURRENT_LIST_DIR}/values.xr")
set(rest_work "${CMAKE_CURRENT_BINARY_DIR}/rest-library-work")
file(MAKE_DIRECTORY "${rest_work}")
target_compile_definitions(test_xir_rest_values PRIVATE XR_REST_WORK="${rest_work}")
set(rest_generated "${CMAKE_CURRENT_BINARY_DIR}/rest_values_generated.c")
add_custom_command(OUTPUT "${rest_generated}"
    COMMAND $<TARGET_FILE:test_xir_rest_values> "${rest_generated}"
    DEPENDS test_xir_rest_values "${CMAKE_CURRENT_LIST_DIR}/values.xr" VERBATIM)
add_executable(test_xir_rest_values_native "${CMAKE_CURRENT_LIST_DIR}/test_rest_native.c" "${rest_generated}")
target_link_libraries(test_xir_rest_values_native PRIVATE xray_xir_vm)
set(rest_cold_generated "${CMAKE_CURRENT_BINARY_DIR}/rest_cold_generated.c")
add_custom_command(OUTPUT "${rest_cold_generated}"
    COMMAND $<TARGET_FILE:test_xir_rest_values> --cold "${rest_cold_generated}"
    DEPENDS test_xir_rest_values "${CMAKE_CURRENT_LIST_DIR}/rest_cold.h" VERBATIM)
add_executable(test_xir_rest_values_cold_native "${CMAKE_CURRENT_LIST_DIR}/test_rest_native.c" "${rest_cold_generated}")
target_link_libraries(test_xir_rest_values_cold_native PRIVATE xray_xir_vm)
foreach(target IN ITEMS test_xir_rest_values test_xir_rest_values_native test_xir_rest_values_cold_native)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME ${target} COMMAND ${target})
    set_tests_properties(${target} PROPERTIES TIMEOUT 120 LABELS "unit;xir;source;rest;ownership")
endforeach()
xray_stage_windows_asan_runtime("${CMAKE_CURRENT_BINARY_DIR}")
xray_prepend_windows_asan_runtime_to_directory_tests()
