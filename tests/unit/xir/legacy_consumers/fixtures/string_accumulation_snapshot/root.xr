// Immutable owned text preserves the complete retired accumulator duties.
fn answer() -> i64 {
    var text = ""
    assert(text == "")
    text += "A"
    text += "${42}"
    text += "${true}"
    text += "${1.5}"
    const saved = text
    assert(saved == "A42true1.5")
    text = ""
    text += "new"
    assert(text == "new")
    assert(saved == "A42true1.5")
    text = ""
    for (i in 0..3) { text += "x" }
    assert(text == "xxx")
    assert(make() == "owned")
    assert(make() == "owned")
    return 42
}

fn make() -> string {
    var text = ""
    text += "owned"
    return text
}
