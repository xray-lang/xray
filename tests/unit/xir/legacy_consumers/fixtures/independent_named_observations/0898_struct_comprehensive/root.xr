// Preserve the complete original struct body and expose each scalar field/method result at its original assertion boundary.
// Test: comprehensive struct scenarios
// Expected: struct creation, methods, arrays, return values

struct Point {
    x: f64
    y: f64
}
fn make_point(x: f64, y: f64) -> Point {
    return Point{x: x, y: y}
}
fn origin() -> Point {
    return Point{x: 0.0, y: 0.0}
}
struct Rect {
    x: f64
    y: f64
    w: f64
    h: f64

    area() -> f64 {
        return this.w * this.h
    }
}
struct Color {
    r: i64
    g: i64
    b: i64
}

@test
fn test_struct_comprehensive() {

    // === Struct as return value ===

    var p1 = make_point(100.0, 200.0)
    var p19StructValue0 = p1.x
    assert(p19StructValue0 == 100.0)
    print(p19StructValue0)
    var p19StructValue1 = p1.y
    assert(p19StructValue1 == 200.0)
    print(p19StructValue1)

    // === Struct in array ===
    var points = [Point{x: 1.0, y: 2.0}, Point{x: 3.0, y: 4.0}]
    var p19StructValue2 = points[0].x
    assert(p19StructValue2 == 1.0)
    print(p19StructValue2)
    var p19StructValue3 = points[1].y
    assert(p19StructValue3 == 4.0)
    print(p19StructValue3)

    // === Value copy from function return ===

    var o1 = origin()
    var o2 = origin()
    o1.x = 99.0
    var p19StructValue4 = o2.x
    assert(p19StructValue4 == 0.0)
    print(p19StructValue4)

    // === Struct with method ===

    var r = Rect{x: 0.0, y: 0.0, w: 100.0, h: 50.0}
    var p19StructValue5 = r.area()
    assert(p19StructValue5 == 5000.0)
    print(p19StructValue5)

    // === Copy preserves methods ===
    var r2 = r
    r2.w = 200.0
    var p19StructValue6 = r.area()
    assert(p19StructValue6 == 5000.0)
    print(p19StructValue6)
    var p19StructValue7 = r2.area()
    assert(p19StructValue7 == 10000.0)
    print(p19StructValue7)

    // === Struct with int fields ===

    var red = Color{r: 255, g: 0, b: 0}
    var blue = Color{r: 0, g: 0, b: 255}
    var mix = red
    mix.b = blue.b
    var p19StructValue8 = mix.r
    assert(p19StructValue8 == 255)
    print(p19StructValue8)
    var p19StructValue9 = mix.g
    assert(p19StructValue9 == 0)
    print(p19StructValue9)
    var p19StructValue10 = mix.b
    assert(p19StructValue10 == 255)
    print(p19StructValue10)
    var p19StructValue11 = red.b
    assert(p19StructValue11 == 0)
    print(p19StructValue11)

    // === Chain of copies ===
    var base = Point{x: 0.0, y: 0.0}
    var a = base
    var b = a
    var c = b
    c.x = 42.0
    var p19StructValue12 = base.x
    assert(p19StructValue12 == 0.0)
    print(p19StructValue12)
    var p19StructValue13 = a.x
    assert(p19StructValue13 == 0.0)
    print(p19StructValue13)
    var p19StructValue14 = b.x
    assert(p19StructValue14 == 0.0)
    print(p19StructValue14)
    var p19StructValue15 = c.x
    assert(p19StructValue15 == 42.0)
    print(p19StructValue15)

    // === Struct literal reassignment ===
    var p = Point{x: 1.0, y: 2.0}
    p = Point{x: 10.0, y: 20.0}
    var p19StructValue16 = p.x
    assert(p19StructValue16 == 10.0)
    print(p19StructValue16)
    var p19StructValue17 = p.y
    assert(p19StructValue17 == 20.0)
    print(p19StructValue17)

    // === Typename preserved ===
    var p19StructValue18 = typeName(p1)
    assert(p19StructValue18 == "Point")
    print(p19StructValue18)
    var p19StructValue19 = typeName(r)
    assert(p19StructValue19 == "Rect")
    print(p19StructValue19)
    var p19StructValue20 = typeName(red)
    assert(p19StructValue20 == "Color")
    print(p19StructValue20)
}

