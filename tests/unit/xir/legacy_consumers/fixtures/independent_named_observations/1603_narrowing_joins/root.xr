// Retain every original body and observe scalar results, including nested lexical scopes.
// 1603_narrowing_joins.xr
// Conformance: LANGUAGE_SPEC §2.13 N-9 (join points take the union of all
// predecessor paths; unreachable predecessors contribute `never`) and N-10
// (loop headers join the entry edge with every back edge).

// ===== N-9: both paths assign a non-null value =====

@test
fn test_n9_join_of_two_assigned_paths() {
    var a: string? = null
    var flag = true
    if (flag) {
        a = "abc"
    } else {
        a = "de"
    }
    // Both predecessors are non-null, so the join is non-null.
    var p19Observed0 = len(a)
    assertEqual(p19Observed0, 3)
    print(p19Observed0)
}

@test
fn test_n9_join_keeps_null_when_one_path_may_be_null() {
    var a: string? = null
    var flag = false
    if (flag) {
        a = "abc"
    }
    var p19Observed1 = a ?? "fallback"
    assertEqual(p19Observed1, "fallback")
    print(p19Observed1)
}

@test
fn test_n9_unreachable_path_is_absorbed() {
    var a: string? = "abc"
    if (a == null) {
        return
    }
    // The then-path is unreachable past the return, so only the
    // false-condition path reaches here.
    var p19Observed2 = len(a)
    assertEqual(p19Observed2, 3)
    print(p19Observed2)
}

fn n9_pick(flag: bool, x: string?, y: string?) -> i64 {
    if (flag) {
        if (x == null) { return -1 }
        return len(x)
    }
    if (y == null) { return -2 }
    return len(y)
}

@test
fn test_n9_nested_joins() {
    var p19Observed3 = n9_pick(true, "abcd", null)
    assertEqual(p19Observed3, 4)
    print(p19Observed3)
    var p19Observed4 = n9_pick(true, null, "abcd")
    assertEqual(p19Observed4, -1)
    print(p19Observed4)
    var p19Observed5 = n9_pick(false, null, "ab")
    assertEqual(p19Observed5, 2)
    print(p19Observed5)
    var p19Observed6 = n9_pick(false, "ab", null)
    assertEqual(p19Observed6, -2)
    print(p19Observed6)
}

// ===== N-10: loop header joins entry and back edges =====

@test
fn test_n10_narrowing_holds_each_iteration() {
    var cur: string? = "abc"
    var rounds = 0
    while (cur != null) {
        rounds = rounds + 1
        if (rounds > 2) {
            cur = null
        }
    }
    var p19Observed7 = rounds
    assertEqual(p19Observed7, 3)
    print(p19Observed7)
}

@test
fn test_n10_reassignment_in_body_rejoins() {
    var cur: string? = "ab"
    var total = 0
    var i = 0
    while (i < 3) {
        i = i + 1
        if (cur != null) {
            total = total + len(cur)
        }
        cur = "xyz"
    }
    var p19Observed8 = total
    assertEqual(p19Observed8, 8)
    print(p19Observed8)
}

@test
fn test_n10_narrowing_before_loop_survives_read_only_body() {
    var conn: string? = "abc"
    var total = 0
    if (conn != null) {
        // The body never writes `conn`, so the back edge carries the narrowed
        // type and the pre-loop narrowing holds inside the loop.
        for (var i = 0; i < 3; i = i + 1) {
            total = total + len(conn)
        }
    }
    var p19Observed9 = total
    assertEqual(p19Observed9, 9)
    print(p19Observed9)
}

@test
fn test_n10_narrowing_before_while_survives_read_only_body() {
    var conn: string? = "ab"
    var seen = 0
    if (conn != null) {
        var i = 0
        while (i < 2) {
            seen = seen + len(conn)
            i = i + 1
        }
    }
    var p19Observed10 = seen
    assertEqual(p19Observed10, 4)
    print(p19Observed10)
}

@test
fn test_n10_condition_false_fact_after_loop() {
    var cur: string? = "abc"
    while (cur != null) {
        cur = null
    }
    // After the loop the condition is false, so cur is null here.
    assertEqual(cur, null)
    print((cur) == null)
}
