// Preserve the original declared-module type authority and full imported/user-named bodies; observe each actual scalar call once.
// A generic class declared by another module is instantiated here and named
// by its instantiation in annotations: parameters, variables and return
// types spell `Box<i64>` while the clone itself lives in the declaring
// module. The importer reaches it through a compiler-private import, the
// same binding a construction of the same instantiation uses. A generic
// method of the clone is a plain member of that concrete class.

import { Box, boxOf } from "./modules/generic_box_lib"

fn get(b: Box<i64>) -> i64 { return b.get() }

fn rebox(v: i64) -> Box<i64> {
    var b: Box<i64> = Box<i64>(v)
    return b
}

@test fn annotation_names_a_foreign_instantiation() {
    var p19ImportedValue0 = get(Box<i64>(3))
    assertEqual(p19ImportedValue0, 3)
    print(p19ImportedValue0)
    var p19ImportedValue1 = get(rebox(4))
    assertEqual(p19ImportedValue1, 4)
    print(p19ImportedValue1)
    var p19ImportedValue2 = get(boxOf(5))
    assertEqual(p19ImportedValue2, 5)
    print(p19ImportedValue2)
    var p19ImportedValue3 = boxOf(8).get()
    assertEqual(p19ImportedValue3, 8)
    print(p19ImportedValue3)
}

@test fn generic_method_of_a_foreign_instantiation() {
    var b: Box<i64> = boxOf(6)
    var p19ImportedValue4 = b.lock<i64>(fn(v: i64) -> i64 { return v * 2 })
    assertEqual(p19ImportedValue4, 12)
    print(p19ImportedValue4)
    var p19ImportedValue5 = b.lock<string>(fn(v: i64) -> string { return "v${v}" })
    assertEqual(p19ImportedValue5, "v6")
    print(p19ImportedValue5)
}
