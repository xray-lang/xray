// Preserve every original enum/Atomic body and capture each original invocation exactly once.
// Value-return error channel: throw enum + catch

enum MathErr { DivByZero, Overflow }
enum AppErr { NotFound { key: string }, Timeout }
enum IoErr { Closed, Timeout }
enum ParseErr { Invalid }

fn safe_div(a: i64, b: i64) -> i64 {
    if (b == 0) {
        throw MathErr.DivByZero
    }
    return a / b
}

@test fn basic_throw_catch() {
    var result = 0
    try {
        result = safe_div(10, 2)
    } catch (e) {
        result = -1
    }
    var p19Observed0 = result
    assertEqual(p19Observed0, 5)
    print(p19Observed0)
}

@test fn catch_on_error() {
    var result = 0
    try {
        result = safe_div(10, 0)
    } catch (e) {
        result = -1
    }
    var p19Observed1 = result
    assertEqual(p19Observed1, -1)
    print(p19Observed1)
}

@test fn typed_catch() {
    var msg = "ok"
    try {
        safe_div(1, 0)
    } catch (e: MathErr) {
        msg = "math error"
    }
    var p19Observed2 = msg
    assertEqual(p19Observed2, "math error")
    print(p19Observed2)
}

@test fn auto_propagation() {
    fn wrapper() -> i64 {
        var x = safe_div(10, 0)
        return x + 1
    }
    var result = 0
    try {
        result = wrapper()
    } catch (e) {
        result = -99
    }
    var p19Observed3 = result
    assertEqual(p19Observed3, -99)
    print(p19Observed3)
}

@test fn nested_try_catch() {
    var inner_val = 0
    try {
        inner_val = safe_div(1, 0)
    } catch (e) {
        inner_val = 42
    }
    var outer = 0
    try {
        outer = inner_val + safe_div(10, 5)
    } catch (e) {
        outer = -1
    }
    var p19Observed4 = outer
    assertEqual(p19Observed4, 44)
    print(p19Observed4)
}

@test fn catch_preserves_error_value() {
    fn lookup(key: string) -> string {
        if (key == "") {
            throw AppErr.NotFound { key: "empty key" }
        }
        return "value_${key}"
    }
    var msg = ""
    try {
        msg = lookup("")
    } catch (e: AppErr) {
        msg = match (e) {
            AppErr.NotFound { key: s } -> "not found: ${s}",
            AppErr.Timeout -> "timeout",
        }
    }
    var p19Observed5 = msg
    assertEqual(p19Observed5, "not found: empty key")
    print(p19Observed5)
}

@test fn defer_runs_on_throw() {
    var cleaned = false
    var caught = false
    fn work() -> i64 {
        defer { cleaned = true }
        throw MathErr.Overflow
        return 0
    }
    try {
        work()
    } catch (e) {
        caught = true
    }
    var p19Observed6 = caught
    assertEqual(p19Observed6, true)
    print(p19Observed6)
    var p19Observed7 = cleaned
    assertEqual(p19Observed7, true)
    print(p19Observed7)
}

@test fn multi_catch_typed() {
    fn process(input: string) -> i64 {
        if (input == "closed") { throw IoErr.Closed }
        if (input == "bad") { throw ParseErr.Invalid }
        return len(input)
    }

    var r1 = 0
    try {
        r1 = process("closed")
    } catch (e: IoErr) {
        r1 = -1
    } catch (e: ParseErr) {
        r1 = -2
    }
    var p19Observed8 = r1
    assertEqual(p19Observed8, -1)
    print(p19Observed8)

    var r2 = 0
    try {
        r2 = process("bad")
    } catch (e: IoErr) {
        r2 = -1
    } catch (e: ParseErr) {
        r2 = -2
    }
    var p19Observed9 = r2
    assertEqual(p19Observed9, -2)
    print(p19Observed9)

    var r3 = 0
    try {
        r3 = process("hello")
    } catch (e: IoErr) {
        r3 = -1
    } catch (e: ParseErr) {
        r3 = -2
    }
    var p19Observed10 = r3
    assertEqual(p19Observed10, 5)
    print(p19Observed10)
}
