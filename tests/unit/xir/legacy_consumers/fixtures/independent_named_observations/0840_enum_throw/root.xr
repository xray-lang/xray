// Preserve every original enum/Atomic body and capture each original invocation exactly once.
// enum-based throw (value-return error system, M1)
// Verifies that the analyzer accepts throw of enum values
// and that the existing try-catch mechanism handles them.

enum ParseErr {
    Empty,
    InvalidChar
}

enum IoErr {
    NotFound,
    PermissionDenied
}

fn might_fail(s: string) -> i64 {
    if (s == "") {
        throw ParseErr.Empty
    }
    return 42
}

fn openFile(path: string) -> string {
    if (path == "") {
        throw IoErr.NotFound
    }
    return "content"
}

fn readConfig() -> string {
    const content = openFile("config.txt")
    return content
}

@test fn enum_throw_happy_path() {
    var result = 0
    try {
        result = might_fail("hello")
    } catch (e) {
        result = -1
    }
    var p19Observed0 = result
    assertEqual(p19Observed0, 42)
    print(p19Observed0)
}

@test fn enum_throw_caught() {
    var result = ""
    try {
        openFile("")
    } catch (e) {
        result = "caught"
    }
    var p19Observed1 = result
    assertEqual(p19Observed1, "caught")
    print(p19Observed1)
}

@test fn enum_throw_propagation() {
    var result = ""
    try {
        result = readConfig()
    } catch (e) {
        result = "caught"
    }
    var p19Observed2 = result
    assertEqual(p19Observed2, "content")
    print(p19Observed2)
}

@test fn enum_throw_multiple_types() {
    fn riskyOp(mode: i64) -> string {
        if (mode == 0) {
            throw ParseErr.Empty
        }
        if (mode == 1) {
            throw IoErr.PermissionDenied
        }
        return "ok"
    }

    var r1 = ""
    try {
        r1 = riskyOp(2)
    } catch (e) {
        r1 = "error"
    }
    var p19Observed3 = r1
    assertEqual(p19Observed3, "ok")
    print(p19Observed3)

    var r2 = ""
    try {
        r2 = riskyOp(0)
    } catch (e) {
        r2 = "parse_error"
    }
    var p19Observed4 = r2
    assertEqual(p19Observed4, "parse_error")
    print(p19Observed4)
}
