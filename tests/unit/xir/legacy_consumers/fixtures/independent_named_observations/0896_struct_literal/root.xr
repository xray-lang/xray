// Preserve the complete original struct body and expose each scalar field/method result at its original assertion boundary.
// Test: struct literal construction syntax
// Expected: Point{x: 1.0, y: 2.0} creates initialized struct instance

// === Basic struct ===

struct Point {
    x: f64
    y: f64
}
fn distance(pt: Point) -> f64 {
    return pt.x * pt.x + pt.y * pt.y
}
struct Vec2 {
    x: f64
    y: f64

    mag_sq() -> f64 {
        return this.x * this.x + this.y * this.y
    }
}
struct Rect {
    x: f64
    y: f64
    w: f64
    h: f64

    area() -> f64 {
        return this.w * this.h
    }
}
struct Color {
    r: i64
    g: i64
    b: i64
}

@test
fn test_struct_literal() {

    // Struct literal with values
    var p = Point{x: 3.0, y: 4.0}
    var p19StructValue0 = p.x
    assert(p19StructValue0 == 3.0)
    print(p19StructValue0)
    var p19StructValue1 = p.y
    assert(p19StructValue1 == 4.0)
    print(p19StructValue1)

    // Struct literal with expressions
    var a = 10.0
    var p2 = Point{x: a + 1.0, y: a * 2.0}
    var p19StructValue2 = p2.x
    assert(p19StructValue2 == 11.0)
    print(p19StructValue2)
    var p19StructValue3 = p2.y
    assert(p19StructValue3 == 20.0)
    print(p19StructValue3)

    // Struct literal as function argument
    var p19StructValue4 = distance(Point{x: 3.0, y: 4.0})
    assert(p19StructValue4 == 25.0)
    print(p19StructValue4)

    // Struct literal in array
    var points = [Point{x: 1.0, y: 2.0}, Point{x: 3.0, y: 4.0}]
    var p19StructValue5 = points[0].x
    assert(p19StructValue5 == 1.0)
    print(p19StructValue5)
    var p19StructValue6 = points[1].y
    assert(p19StructValue6 == 4.0)
    print(p19StructValue6)

    // Struct with method + literal

    var v = Vec2{x: 3.0, y: 4.0}
    var p19StructValue7 = v.mag_sq()
    assert(p19StructValue7 == 25.0)
    print(p19StructValue7)

    // Struct literal assigned to existing variable
    var p3 = Point{x: 0.0, y: 0.0}
    p3 = Point{x: 5.0, y: 6.0}
    var p19StructValue8 = p3.x
    assert(p19StructValue8 == 5.0)
    print(p19StructValue8)
    var p19StructValue9 = p3.y
    assert(p19StructValue9 == 6.0)
    print(p19StructValue9)

    // Nested struct literal field values

    var r = Rect{x: 0.0, y: 0.0, w: 100.0, h: 50.0}
    var p19StructValue10 = r.area()
    assert(p19StructValue10 == 5000.0)
    print(p19StructValue10)
    var p19StructValue11 = r.x
    assert(p19StructValue11 == 0.0)
    print(p19StructValue11)
    var p19StructValue12 = r.w
    assert(p19StructValue12 == 100.0)
    print(p19StructValue12)

    // Struct literal with int fields

    var red = Color{r: 255, g: 0, b: 0}
    var p19StructValue13 = red.r
    assert(p19StructValue13 == 255)
    print(p19StructValue13)
    var p19StructValue14 = red.g
    assert(p19StructValue14 == 0)
    print(p19StructValue14)

    // Typename preserved
    var p19StructValue15 = typeName(p)
    assert(p19StructValue15 == "Point")
    print(p19StructValue15)
    var p19StructValue16 = typeName(v)
    assert(p19StructValue16 == "Vec2")
    print(p19StructValue16)
    var p19StructValue17 = typeName(r)
    assert(p19StructValue17 == "Rect")
    print(p19StructValue17)
}

