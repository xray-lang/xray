class Box<T> {
    value: T

    init(value: T) {
        this.value = value
    }

    touch(value: ref T) where T: Equal {
        assertEqual(value, this.value)
    }
}

@test
fn test_generic_method_keeps_ref_contract() {
    var box = Box<i64>(7)
    var value = 7
    box.touch(ref value)

    print(value)
    print(box.value)
}
