class Counter {
    value: i64

    init(v: i64) {
        this.value = v
    }

    bump() {
        this.value = this.value + 1
    }

    current() -> i64 {
        return this.value
    }
}

@test
fn test_receiver_mutation_does_not_need_ref_marker() {
    var counter = Counter(1)
    counter.bump()
    var p19SupportedValue1 = counter.current()
    assertEqual(p19SupportedValue1, 2)
    print(p19SupportedValue1)

    var values: Array<i64> = [1, 2]
    values.push(3)
    var p19SupportedValue2 = len(values)
    assertEqual(p19SupportedValue2, 3)
    print(p19SupportedValue2)
    var p19SupportedValue3 = values[2]
    assertEqual(p19SupportedValue3, 3)
    print(p19SupportedValue3)

    print(len(values))
    for (var p19Index = 0; p19Index < len(values); p19Index++) {
        print(values[p19Index])
    }
}
