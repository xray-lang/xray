// Retain every original body and observe scalar results, including nested lexical scopes.
// as operator for numeric type conversion (truncation, widening)

@test
fn test_float_as_int_truncation() {
    var p19Observed0 = 3.14 as i64
    assertEqual(p19Observed0, 3)
    print(p19Observed0)
    var p19Observed1 = 3.99 as i64
    assertEqual(p19Observed1, 3)
    print(p19Observed1)
    var p19Observed2 = -2.7 as i64
    assertEqual(p19Observed2, -2)
    print(p19Observed2)
    var p19Observed3 = 0.0 as i64
    assertEqual(p19Observed3, 0)
    print(p19Observed3)
}

@test
fn test_int_as_float() {
    var p19Observed4 = 42 as f64
    assertEqual(p19Observed4, 42.0)
    print(p19Observed4)
    var p19Observed5 = 0 as f64
    assertEqual(p19Observed5, 0.0)
    print(p19Observed5)
}

@test
fn test_as_string() {
    var p19Observed6 = string(123)
    assertEqual(p19Observed6, "123")
    print(p19Observed6)
    var p19Observed7 = string(3.14)
    assertEqual(p19Observed7, "3.14")
    print(p19Observed7)
}

@test
fn test_as_bool() {
    var p19Observed8 = 1 != 0
    assertEqual(p19Observed8, true)
    print(p19Observed8)
    var p19Observed9 = 0 != 0
    assertEqual(p19Observed9, false)
    print(p19Observed9)
}
