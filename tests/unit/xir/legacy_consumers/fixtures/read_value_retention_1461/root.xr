class Holder {
    items: Array<i64>

    init() {
        this.items = []
    }
}

fn stash(data: Array<i64>, holder: ref Holder) {
    var alias = data
    holder.items = alias
}

var values: Array<i64> = [1, 2]
var holder = Holder()
stash(values, ref holder)

values[0] = 9
print(holder.items[0])
holder.items[1] = 7
print(values[1])
print(len(holder.items))
