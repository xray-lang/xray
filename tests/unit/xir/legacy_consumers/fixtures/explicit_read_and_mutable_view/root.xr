fn main() {
    var arr = [10, 20, 30, 40]
    arr[1] = 21
    var view: Slice<i64> = arr[1:3]
    print(view[0])
    var writable: MutSlice<i64> = arr[1:3]
    writable[1] = 31
    print(arr[2])
    var owned: Array<i64> = copy(arr[1:3])
    arr[1] = 22
    print(owned[0])
    owned[1] = 32
    print(arr[2])
}

main()
