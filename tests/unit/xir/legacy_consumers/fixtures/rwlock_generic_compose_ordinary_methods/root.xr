import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Preserve reader/writer accounting and deferred releases around callbacks.

class RwLock<T> {
    _entry: Semaphore
    _gate: Semaphore
    _rflag: Atomic<bool>
    _readers: i64
    value: T

    init(v: T) {
        this._entry = Semaphore(1)
        this._gate = Semaphore(1)
        this._rflag = Atomic<bool>(false)
        this._readers = 0
        this.value = v
    }

    _lockCounter() {
        while (true) {
            var (_, ok) = this._rflag.compareExchange(false, true, Ordering.AcquireRelease)
            if (ok) { break }
        }
    }

    read<U>(body: fn(T) -> U) -> U {
        this._entry.acquire()
        this._lockCounter()
        this._readers = this._readers + 1
        var first = this._readers == 1
        this._rflag.store(false, Ordering.Release)
        if (first) { this._gate.acquire() }
        this._entry.release()
        defer {
            this._lockCounter()
            this._readers = this._readers - 1
            var last = this._readers == 0
            this._rflag.store(false, Ordering.Release)
            if (last) { this._gate.release() }
        }
        return body(this.value)
    }

    write<U>(body: fn(T) -> U) -> U {
        this._entry.acquire()
        this._gate.acquire()
        this._entry.release()
        defer { this._gate.release() }
        return body(this.value)
    }

    replace(body: fn(T) -> T) -> T {
        this._entry.acquire()
        this._gate.acquire()
        this._entry.release()
        defer { this._gate.release() }
        this.value = body(this.value)
        return this.value
    }
}

var rw = RwLock<i64>(100)
print(rw.read((v) -> v + 1))     // 101 (shared read)
print(rw.replace((v) -> v * 2))  // 200 (exclusive mutate)
print(rw.write((v) -> v - 50))   // 150 (exclusive read via write gate)
print(rw.read((v) -> v))         // 200 (value after replace)
