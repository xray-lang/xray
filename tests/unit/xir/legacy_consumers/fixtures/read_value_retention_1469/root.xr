class Holder {
    items: Array<Array<i64>>

    init() {
        this.items = []
    }

    outer(value: Array<i64>) {
        this.middle(value)
    }

    middle(value: Array<i64>) {
        this.store(value)
    }

    store(value: Array<i64>) {
        this.items.push(value)
    }
}

fn stash(data: Array<i64>, holder: ref Holder) {
    holder.outer(data)
}

var values: Array<i64> = [1, 2]
var holder = Holder()
stash(values, ref holder)

values[0] = 9
print(holder.items[0][0])
holder.items[0][1] = 7
print(values[1])
print(len(holder.items[0]))
