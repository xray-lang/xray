// Typed CSV module contract.

import csv
import {
    CsvDelimiter,
    CsvDocument,
    CsvError,
    CsvErrorKind,
    CsvHeader
} from csv

@test
fn test_parse_basic() throws(CsvError) {
    var doc = try csv.parse("name,age,city\nAlice,30,Beijing\nBob,25,Shanghai")
    assertEqual(len(doc.headers), 0)
    assertEqual(len(doc.rows), 3)
    assertEqual(doc.rows[1][0], "Alice")
    assertEqual(doc.rows[1][1], "30")
}

@test
fn test_header_modes() throws(CsvError) {
    var doc = try csv.parse("name,age\nAlice,30\nBob,25", header: CsvHeader.FirstRow)
    assertEqual(doc.headers[0], "name")
    assertEqual(len(doc.rows), 2)

    var names: Array<string> = ["user", "score"]
    var explicitDoc = try csv.parse("Alice,30\nBob,25", header: CsvHeader.Explicit { names: names })
    assertEqual(explicitDoc.headers[0], "user")
    assertEqual(explicitDoc.rows[1][1], "25")
}

@test
fn test_parse_quoted_and_escaped() throws(CsvError) {
    var doc = try csv.parse("name,desc\n\"John\",\"Hello, World\"\n\"Test\",\"He said \"\"Hello\"\"\"")
    assertEqual(doc.rows[1][1], "Hello, World")
    assertEqual(doc.rows[2][1], "He said \"Hello\"")
}

@test
fn test_parse_report_and_strict_error() throws(CsvError) {
    var report = try csv.parseReport("a,b\n1,2\n3")
    assertEqual(len(report.document.rows), 3)
    assertEqual(len(report.diagnostics), 1)
    assert(report.diagnostics[0].kind == CsvErrorKind.FieldCountMismatch)
    assertEqual(report.diagnostics[0].line, 3)
    assertEqual(report.diagnostics[0].record, 2)

    var rejected = false
    try {
        try csv.parse("a,b\n1")
    } catch (e: CsvError) {
        rejected = match (e) {
            CsvError.FieldCountMismatch { byteOffset: offset, line, record, column, message } => record == 1,
            _ => false,
        }
    }
    assert(rejected)
}

@test
fn test_exact_and_auto_delimiters() throws(CsvError) {
    var tsv = try csv.parse("a\tb\tc\n1\t2\t3", delimiter: CsvDelimiter.Exact { delimiter: '\t' })
    assertEqual(tsv.rows[0][1], "b")

    var auto = try csv.parse("a|b|c\n1|2|3", delimiter: CsvDelimiter.Auto)
    assertEqual(auto.rows[1][1], "2")
}

@test
fn test_parse_options() throws(CsvError) {
    var doc = try csv.parse("skip1\nskip2\n a , b \n 1 , 2 \n3,4", skipRecords: 2, maxRecords: 2, trimFields: true)
    assertEqual(len(doc.rows), 2)
    assertEqual(doc.rows[0][0], "a")
    assertEqual(doc.rows[1][1], "2")
}

@test
fn test_comment_quoting_empty_fields_and_crlf() throws(CsvError) {
    var doc = try csv.parse("\"# value\",x,\r\n# comment\r\n1,,3", commentPrefix: "#")
    assertEqual(len(doc.rows), 2)
    assertEqual(doc.rows[0][0], "# value")
    assertEqual(len(doc.rows[0]), 3)
    assertEqual(len(doc.rows[1]), 3)
    assertEqual(doc.rows[1][1], "")
}

@test
fn test_stringify_roundtrip() throws(CsvError) {
    var doc = CsvDocument()
    doc.headers.push("name")
    doc.headers.push("note")
    doc.rows.push(["Alice", "hello, world"])
    doc.rows.push(["Bob", "quote \" me"])
    var output = try csv.stringify(doc)
    assert(output.contains("\"hello, world\""))
    assert(output.contains("\"quote \"\" me\""))

    var reparsed = try csv.parse(output, header: CsvHeader.FirstRow)
    assertEqual(reparsed.headers[0], "name")
    assertEqual(reparsed.rows[1][1], "quote \" me")
}

@test
fn test_unterminated_quote_preserves_partial_row() throws(CsvError) {
    var report = try csv.parseReport("a,b\n\"unterminated")
    assertEqual(len(report.diagnostics), 2)
    assert(report.diagnostics[0].kind == CsvErrorKind.UnterminatedQuote)
    assertEqual(len(report.document.rows), 2)
    assertEqual(report.document.rows[1][0], "unterminated")
}

@test
fn test_limits() throws(CsvError) {
    var rejected = false
    try {
        try csv.parse("a,b", maxColumns: 1)
    } catch (e: CsvError) {
        rejected = match (e) {
            CsvError.ColumnLimitExceeded { limit } => limit == 1,
            _                                   => false,
        }
    }
    assert(rejected)
}

@test
fn test_mixed_linebreak_metadata() throws(CsvError) {
    var report = try csv.parseReport("a,b\r\n1,2\n3,4\r5,6")
    assertEqual(len(report.document.rows), 4)
    assertEqual(report.linebreak, "mixed")
}

print("All typed CSV tests passed")
