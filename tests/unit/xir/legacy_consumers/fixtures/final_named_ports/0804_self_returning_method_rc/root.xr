// Full retained-result duties with logical Array copies and owned UTF-8 text.
// ===== escaping through a return =====

fn build_reversed() -> Array<i64> {
    var a = [1, 2, 3]
    return a.reverse()
}

@test
fn test_reverse_escapes_receiver_death() {
    var r = build_reversed()
    assertEqual(len(r), 3)
    assertEqual(r[0], 3)
    assertEqual(r[1], 2)
    assertEqual(r[2], 1)
}

fn build_sorted() -> Array<i64> {
    var a = [3, 1, 2]
    return a.sort()
}

@test
fn test_sort_escapes_receiver_death() {
    var r = build_sorted()
    assertEqual(len(r), 3)
    assertEqual(r[0], 1)
    assertEqual(r[2], 3)
}

fn build_filled() -> Array<i64> {
    var a = [0, 0, 0]
    return a.fill(7)
}

@test
fn test_fill_escapes_receiver_death() {
    var r = build_filled()
    assertEqual(len(r), 3)
    assertEqual(r[0], 7)
    assertEqual(r[2], 7)
}

fn build_reserved() -> Array<i64> {
    var a = [4, 5]
    return a.reserve(32)
}

@test
fn test_reserve_escapes_receiver_death() {
    var r = build_reserved()
    assertEqual(len(r), 2)
    assertEqual(r[0], 4)
    assertEqual(r[1], 5)
}

fn build_resized() -> Array<i64> {
    var a = [4, 5]
    return a.resize(4, 9)
}

@test
fn test_resize_escapes_receiver_death() {
    var r = build_resized()
    assertEqual(len(r), 4)
    assertEqual(r[0], 4)
    assertEqual(r[3], 9)
}

fn appendUtf8(output: ref Array<u8>, text: string) {
    var view: Slice<u8> = text.bytes()
    for (octet in view) { output.push(octet) }
}

fn build_appended() -> string {
    var output: Array<u8> = []
    appendUtf8(ref output, "xy")
    return string.fromUtf8(output[:])
}

@test
fn test_stringbuilder_append_escapes_receiver_death() {
    var result = build_appended()
    assertEqual(result, "xy")
    assertEqual(len(result), 2)
}

fn build_cleared() -> string {
    var output: Array<u8> = []
    appendUtf8(ref output, "dropped")
    var beforeClear = string.fromUtf8(output[:])
    output.clear()
    var afterClear = string.fromUtf8(output[:])
    assertEqual(beforeClear, "dropped")
    assertEqual(afterClear, "")
    return afterClear
}

@test
fn test_stringbuilder_clear_escapes_receiver_death() {
    assertEqual(build_cleared(), "")
}

// ===== escaping through an optional-chain merge =====
// Optional results retain their owned value on the branch that called the method.

@test
fn test_optional_chain_merge() {
    var a: Array<i64>? = [1, 2, 3]
    var r = a?.reverse()
    assertEqual(len(r!), 3)
    assert(r![0] == 3)
}

@test
fn test_optional_chain_null_receiver() {
    var a: Array<i64>? = null
    var r: Array<i64>? = a?.reverse()
    assertEqual(r == null, true)
}

// ===== chained self-returns =====
// Each returned Array is a logical copy; ref calls require writable bindings.

fn build_chained() -> Array<i64> {
    var a = [3, 1, 2]
    var sorted = a.sort()
    return sorted.reverse()
}

@test
fn test_chained_self_returns() {
    var r = build_chained()
    assertEqual(len(r), 3)
    assertEqual(r[0], 3)
    assertEqual(r[2], 1)
}

// ===== the result is still usable alongside the receiver =====
// Receiver and returned Array are independent logical values.

@test
fn test_returned_array_is_logically_independent() {
    var a = [1, 2, 3]
    var r = a.reverse()
    a.push(4)
    assertEqual(len(a), 4)
    assertEqual(a[3], 4)
    assertEqual(len(r), 3)
    assertEqual(r, [3, 2, 1])
    r[0] = 9
    assertEqual(a[0], 3)
    assertEqual(r[0], 9)
}

// ===== loop-carried owned results =====

@test
fn test_self_return_in_loop() {
    var total = 0
    var i = 0
    while (i < 20) {
        var a = [1, 2, 3]
        var r = a.reverse()
        total = total + r[0]
        i = i + 1
    }
    assertEqual(total, 60)
}

// ===== Set algebra returns a fresh set, never the receiver =====
// union/difference/symmetricDifference are declared to return a NEW Set<T>;
// mutating the receiver afterwards must not be visible through the result.

@test
fn test_set_union_result_is_independent() {
    var s = Set<i64>()
    s.add(1)
    var other = Set<i64>()
    other.add(2)
    var u = s.union(other)
    s.add(3)
    assertEqual(len(u), 2)
    assertEqual(u.contains(3), false)
}
