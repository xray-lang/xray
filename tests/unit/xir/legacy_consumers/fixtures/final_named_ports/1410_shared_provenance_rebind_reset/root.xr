class Box {
    items: Array<i64> = Array<i64>(1, 0)
}

@test
fn test_shared_provenance_rebind_reset() {
    const box = Box()
    var items = box.items
    items[0] = 3
    assertEqual(box.items[0], 0)
    items = Array<i64>(1, 0)
    items[0] = 7
    assertEqual(items[0], 7)
    assertEqual(box.items[0], 0)
}
