// as operator for numeric type conversion (truncation, widening)

@test
fn test_float_as_int_truncation() {
    assertEqual(3.14 as i64, 3)
    assertEqual(3.99 as i64, 3)
    assertEqual(-2.7 as i64, -2)
    assertEqual(0.0 as i64, 0)
}

@test
fn test_int_as_float() {
    assertEqual(42 as f64, 42.0)
    assertEqual(0 as f64, 0.0)
}

@test
fn test_as_string() {
    assertEqual(string(123), "123")
    assertEqual(string(3.14), "3.14")
}

@test
fn test_as_bool() {
    assertEqual(1 != 0, true)
    assertEqual(0 != 0, false)
}
