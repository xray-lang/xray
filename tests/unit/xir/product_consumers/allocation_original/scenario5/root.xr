type Child = { text:string }
type State = { token:i64, child:Child }
fn answer() -> i64 {
 var child:Child={text:"before"}
 var state:State={child:child,token:7}
 var alias=state
 alias.token=42
 alias.child.text="after"
 if (state.child.text == "after") { return state.token }
 return 0
}
fn exported() -> i64 { return 42 }
@test
fn checkAnswer() { assert(exported() == 42) }
