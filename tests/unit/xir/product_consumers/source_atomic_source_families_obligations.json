    "text": "@test\nfn checkAtomicAnswer() { assert(answer() == 42) }\n"
  },
  "contract": {
    "declarations": "answer remains private zero-argument I64; exported remains private fixed I64(42); original checkAnswer remains private zero-argument Unit TEST; appended checkAtomicAnswer is private zero-argument Unit TEST in the same root module",
    "syntax": "Append an ordinary non-generic top-level @test function; no imports, wrappers, aliases, exports or compatibility path",
    "types": "Atomic<i64>, Atomic<bool>, Atomic<f64> require exact AtomicValue/Number/Boolean bounds; compareExchange is owned Tuple; test calls answer and compares I64 against independent literal42",
    "ownership": "const copied handles preserve synchronization identity; local Atomic/Tuple/String ownership follows the public pipeline; SourceProduct/session drop precedes retained Checked verification and Lowered sealing; two Instances retain caller-dropped Program; taken values reset to canonical zero after drop",
    "effects": "Test role changes neither export nor effect and grants no no_suspend exemption; synchronized interior mutation stays in the ordinary Checked/Lowered pipeline",
    "authority": "Ordinary host start rejects initializer, answer, exported, original test and appended test; start_test rejects answer/exported/initializer; selected root TEST identities alone are executed",
    "oracles": "Root canonical entry returns I64(0), distinct from answer; original test only proves exported42. Appended test must actually RETURN Unit after assert(answer()==42), twice on each of two Instances. Each admission rejection must leave all compiler stats, runtime attempts/live and NEW state unchanged",
    "source2": "Original352B AcquireRelease store is an exact static Checked negative, already diagnosed in both configurations. New345B variant substitutes only Release and is separately qualified; neither relaxes the store contract nor claims five-order RMW completion"
  },
