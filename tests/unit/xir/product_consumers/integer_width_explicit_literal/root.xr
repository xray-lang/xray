fn count() -> i64 { return 65 }
fn left() -> i8 { return -128 }
fn answer() -> i64 {
  var a: u8 = 255
  var b: i16 = -256
  var c: u32 = 4294967295
  var wide: u64 = 1
  var neg: i64 = -2
  assert((left() >> 7) == -1)
  assert((a >> 7) == 1 && (a << count()) == 254)
  assert((b | (42 as i16)) == ((-214) as i16))
  assert((c ^ (42 as u32)) == (4294967253 as u32))
  assert((~(0 as i32)) == ((-1) as i32))
  assert((wide << count()) == 2 && (wide << 64) == 1)
  assert((neg >> -1) == ((-1) as i64) && (neg >> 64) == ((-2) as i64))
  return (a & (42 as u8)) as i64
}
export fn consumerAnswer() -> i64 { return answer() }
