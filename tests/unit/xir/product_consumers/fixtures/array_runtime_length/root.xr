fn length() -> i64 { return 3 }
fn answer() -> i64 {
  var bytes = Array<u8>(length())
  assert(len(bytes) == 3 && bytes[0] == 0 && bytes[2] == 0)
  bytes[1] = 42
  var flags = Array<bool>(length())
  assert(!flags[1])
  var floats = Array<f64>(length())
  assert(floats[1] == 0.0)
  return bytes[1] as i64
}
export fn consumerAnswer() -> i64 { return answer() }
