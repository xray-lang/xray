enum DivisionFailure { Negative }
interface Calculator { calculate(divisor: i64) -> i64 }
struct Divider implements Calculator {
value: i64
calculate(divisor: i64) -> i64 {
if (divisor < 0) { throw DivisionFailure.Negative }
return this.value / divisor
}
}
class Cell {
value: i64
constructor(value: i64) { this.value = value }
}
fn checked(ok: bool) -> i64 {
var first = Cell(20)
var second = Cell(22)
var divisor: i64 = 0
if (ok) { divisor = 2 }
var selected: Calculator = Divider{value: 84}
var result = 0
try { result = selected.calculate(divisor) }
catch (error: DivisionFailure) { result = 7 }
var caughtResult = 0
try { caughtResult = selected.calculate(-1) }
catch (error: DivisionFailure) { caughtResult = 7 }
assert(caughtResult == 7)
return first.value + second.value + result - 42
}
fn answer() -> i64 { return checked(false) }
export fn consumerChecked(ok: bool) -> i64 { return checked(ok) }
