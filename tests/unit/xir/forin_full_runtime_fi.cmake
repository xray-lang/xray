include_guard(GLOBAL)

function(xir_register_forin_runtime_fi_batch batch)
    if(NOT "${batch}" MATCHES "^(0|[1-9][0-9]?[0-9]?)$" OR batch GREATER 438)
        message(FATAL_ERROR "For-in runtime FI batch must be an integer from 0 through 438")
    endif()
    if(NOT TARGET test_xir_mixed_forin_resources)
        message(FATAL_ERROR "The authentic for-in resource consumer must exist before registering allocation ordinals")
    endif()

    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/forin_full_runtime_fi_rows.cmake")
    list(LENGTH xir_forin_runtime_fi_rows row_count)
    if(NOT row_count EQUAL 3507)
        message(FATAL_ERROR "The complete for-in runtime FI census must contain 3507 rows")
    endif()
    math(EXPR first "${batch} * 8")
    math(EXPR last "${first} + 7")
    if(last GREATER 3506)
        set(last 3506)
    endif()
    set(backends 0 1 vm native)
    foreach(row_index RANGE ${first} ${last})
        list(GET xir_forin_runtime_fi_rows ${row_index} row)
        string(REPLACE "," ";" fields "${row}")
        list(GET fields 0 scenario)
        list(GET fields 1 mode)
        list(GET fields 2 prefix)
        list(GET fields 3 sites)
        math(EXPR last_site "${sites} - 1")
        foreach(backend RANGE 0 3)
            list(GET backends ${backend} backend_name)
            foreach(close RANGE 0 1)
                foreach(drop RANGE 0 1)
                    foreach(begin RANGE 0 ${last_site} 16)
                        math(EXPR end "${begin} + 16")
                        if(end GREATER sites)
                            set(end ${sites})
                        endif()
                        math(EXPR shard "${begin} / 16")
                        set(name test_xir_mixed_forin_full_runtime_fi_${scenario}_${mode}_${prefix}_${backend}_${close}_${drop}_${shard})
                        add_test(NAME ${name} COMMAND test_xir_mixed_forin_resources
                            ${backend_name} fi ${scenario} ${mode} ${prefix} ${close} ${drop} ${begin} ${end} ${sites})
                        set_tests_properties(${name} PROPERTIES
                            RUN_SERIAL TRUE PROCESSORS 1 TIMEOUT 120 COST 5
                            LABELS "unit;xir;mixed;ownership;generated-c;lifecycle;generator;iterator;forin;resource;fault-injection")
                    endforeach()
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endfunction()

set(XRAY_XIR_FORIN_FI_BATCH "" CACHE STRING "Complete for-in runtime FI batch (0 through 438); empty disables registration")
if(NOT "${XRAY_XIR_FORIN_FI_BATCH}" STREQUAL "")
    xir_register_forin_runtime_fi_batch("${XRAY_XIR_FORIN_FI_BATCH}")
endif()
