foreach(flavor results errors)
    if(flavor STREQUAL "results")
        set(class_group constructed)
        set(class_fixture_macro XR_TASK_CONSTRUCTED_FIXTURES)
        set(class_runner_source test_xir_task_constructed_results.c)
    else()
        set(class_group closed_error)
        set(class_fixture_macro XR_TASK_CLOSED_ERROR_FIXTURES)
        set(class_runner_source test_xir_task_closed_error_resources.c)
    endif()
    set(class_dir "${CMAKE_CURRENT_BINARY_DIR}/task-class-${flavor}")
    set(class_fixture "${PROJECT_SOURCE_DIR}/tests/fixtures/xir_p08_task_class_${flavor}")
    set(class_c "${class_dir}/task_${class_group}_native.c")
    set(class_header "${class_dir}/task_${class_group}_generated.h")
    set(class_emit test_xir_task_class_${flavor}_emit)
    set(class_runner test_xir_task_class_${flavor})
    add_executable(${class_emit} "${CMAKE_CURRENT_LIST_DIR}/test_xir_task_${class_group}_emit.c")
    target_link_libraries(${class_emit} PRIVATE xray_xir_source xray_xir_cgen xray_xir_vm)
    add_custom_command(OUTPUT "${class_c}" "${class_header}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${class_dir}"
        COMMAND ${class_emit} "${class_c}" "${class_header}"
        DEPENDS ${class_emit} "${class_fixture}/root.xr" VERBATIM)
    add_executable(${class_runner} "${CMAKE_CURRENT_LIST_DIR}/${class_runner_source}" "${class_c}" "${class_header}")
    target_include_directories(${class_runner} PRIVATE "${class_dir}")
    target_link_libraries(${class_runner} PRIVATE xray_xir_source xray_xir_vm)
    set(class_targets ${class_emit} ${class_runner})
    if(flavor STREQUAL "results")
        set(class_control test_xir_task_class_control)
        set(class_control_source test_xir_task_constructed_control.c)
    else()
        set(class_control test_xir_task_class_error_control)
        set(class_control_source test_xir_task_closed_error_control.c)
    endif()
    add_executable(${class_control} "${CMAKE_CURRENT_LIST_DIR}/${class_control_source}"
        "${class_c}" "${class_header}")
    target_include_directories(${class_control} PRIVATE "${class_dir}")
    target_link_libraries(${class_control} PRIVATE xray_xir_source xray_xir_vm)
    list(APPEND class_targets ${class_control})
    foreach(target IN LISTS class_targets)
        target_compile_definitions(${target} PRIVATE XR_TASK_STRUCT_FIXTURE=1 XR_TASK_CLASS_FIXTURE=1 XR_TASK_PARAMETER_FIXTURE=1
            ${class_fixture_macro}="${class_fixture}" XR_SOURCE_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
    endforeach()
    foreach(backend vm native vm-native native-vm)
        string(REPLACE "-" "_" name "${backend}")
        foreach(mode normal fi)
            add_test(NAME test_xir_task_class_${flavor}_${name}_${mode}
                COMMAND ${class_runner} structure ${backend} ${mode})
            set_tests_properties(test_xir_task_class_${flavor}_${name}_${mode} PROPERTIES
                TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;class")
        endforeach()
        add_test(NAME ${class_control}_${name} COMMAND ${class_control} structure ${backend})
        set_tests_properties(${class_control}_${name} PROPERTIES
            TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;class;cancel")
    endforeach()
endforeach()

add_executable(test_xir_task_class_rejects "${CMAKE_CURRENT_LIST_DIR}/test_xir_task_constructed_rejects.c")
target_link_libraries(test_xir_task_class_rejects PRIVATE xray_xir_source xray_xir_vm)
target_compile_definitions(test_xir_task_class_rejects PRIVATE
    XR_TASK_CONSTRUCTED_FIXTURES="${PROJECT_SOURCE_DIR}/tests/fixtures/xir_p08_task_class_results"
    XR_SOURCE_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
if(MSVC)
    target_compile_options(test_xir_task_class_rejects PRIVATE /W4 /WX /utf-8)
else()
    target_compile_options(test_xir_task_class_rejects PRIVATE -Wall -Wextra -Werror)
endif()
foreach(case ordinary unused_bad_field unbounded fake_interface duplicate_marker rebind_method rebind_external
    rebind_array double_initialize early_escape hidden_error)
    set(expected_status)
    if(case STREQUAL "double_initialize")
        set(expected_status bad-value)
    endif()
    add_test(NAME test_xir_task_class_reject_${case} COMMAND test_xir_task_class_rejects ${case} ${expected_status})
    set_tests_properties(test_xir_task_class_reject_${case} PROPERTIES
        TIMEOUT 60 LABELS "unit;xir;task;ownership;source;reject;class")
endforeach()
