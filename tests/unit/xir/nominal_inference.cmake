add_executable(test_xir_nominal_inference xir/test_xir_nominal_inference.c)
target_link_libraries(test_xir_nominal_inference PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
set(nominal_inference_work "${CMAKE_CURRENT_BINARY_DIR}/nominal-inference-work")
file(MAKE_DIRECTORY "${nominal_inference_work}")
target_compile_definitions(test_xir_nominal_inference PRIVATE XR_NOMINAL_WORK="${nominal_inference_work}")
set(nominal_inference_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/nominal_inference.c")
add_custom_command(OUTPUT "${nominal_inference_generated}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
    COMMAND $<TARGET_FILE:test_xir_nominal_inference> "${nominal_inference_generated}"
    DEPENDS test_xir_nominal_inference VERBATIM)
add_executable(test_xir_nominal_inference_native xir/test_xir_nominal_inference_native.c "${nominal_inference_generated}")
target_link_libraries(test_xir_nominal_inference_native PRIVATE xray_xir_scalar)
foreach(target test_xir_nominal_inference test_xir_nominal_inference_native)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic-errors)
    endif()
endforeach()
add_test(NAME xir_nominal_inference COMMAND test_xir_nominal_inference)
add_test(NAME xir_nominal_inference_native COMMAND test_xir_nominal_inference_native)
set_tests_properties(xir_nominal_inference xir_nominal_inference_native PROPERTIES TIMEOUT 120 LABELS "unit;xir;source;ownership;generated-c")
