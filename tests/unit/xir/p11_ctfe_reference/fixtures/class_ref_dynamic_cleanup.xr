class Box{items:Array<(i64,i64)>;constructor(items:Array<(i64,i64)>){this.items=items}}
fn add(xs:ref Array<(i64,i64)>){defer{xs.push((1,1))};xs.push((20,20))}
fn middle(xs:ref Array<(i64,i64)>){defer{add(ref xs)};xs=[(0,0)]}
fn answer()->i64{const b=Box([(0,0)]);middle(ref b.items);return len(b.items)==3 ? b.items[1].0+b.items[1].1+b.items[2].0+b.items[2].1 : 0}
export fn run()->i64{return comptime answer()}
