class Node{value:i64;next:Node?;constructor(value:i64,next:Node?){this.value=value;this.next=next}}
fn inc(x:ref i64){x=x+1}
fn work(x:ref i64){defer{inc(ref x)};inc(ref x);inc(ref x)}
fn answer()->i64{const b=Node(39,null);work(ref b.value);return b.value}
export fn run()->i64{return comptime answer()}
