class Box{items:Array<i64>;init(items:Array<i64>){this.items=items}}
fn answer()->i64{const b=Box([40]);try{defer{b.items[0]=b.items[0]+2};return b.items[1]}catch panic(p){return p.code==430 && p.message=="array index out of range: 1 (length 1)" ? b.items[0] : 0}}
export fn run()->i64{return comptime answer()}
