class Box{items:Array<(i64,i64)>;constructor(items:Array<(i64,i64)>){this.items=items}}
fn fail(xs:ref Array<(i64,i64)>)->i64{defer{xs.push((1,1))};xs.push((20,20));return xs[2].0}
fn middle(xs:ref Array<(i64,i64)>){try{fail(ref xs)}catch panic(p){xs[0]=p.code==430 && p.message=="array index out of range: 2 (length 2)" ? (0,0) : (1,1)}}
fn answer()->i64{const b=Box([(9,9)]);middle(ref b.items);return b.items[0].0==0 ? b.items[1].0+b.items[1].1+b.items[2].0+b.items[2].1 : 0}
export fn run()->i64{return comptime answer()}
