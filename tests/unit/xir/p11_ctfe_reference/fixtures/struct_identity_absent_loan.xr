class Marker{constructor(){}}
struct Wrap{next:Marker?;number:i64}
class Holder{data:Wrap;constructor(data:Wrap){this.data=data}}
fn inc(value:ref i64){value+=2}
fn answer()->i64{const h=Holder(Wrap{next:null,number:40});inc(ref h.data.number);return h.data.number}
export fn run()->i64{return comptime answer()}
