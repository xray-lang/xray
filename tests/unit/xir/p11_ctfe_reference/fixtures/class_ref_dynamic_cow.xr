class Box{items:Array<(i64,i64)>;constructor(items:Array<(i64,i64)>){this.items=items}}
fn change(xs:ref Array<(i64,i64)>){xs[0]=(20,20);xs.push((1,1))}
fn answer()->i64{const b=Box([(40,2)]);const alias=b;const snapshot=b.items;change(ref b.items);return len(snapshot)==1 && snapshot[0].0==40 && snapshot[0].1==2 && len(alias.items)==2 ? alias.items[0].0+alias.items[0].1+alias.items[1].0+alias.items[1].1 : 0}
export fn run()->i64{return comptime answer()}
