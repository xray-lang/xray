class Box{items:Array<(i64,i64)>;init(items:Array<(i64,i64)>){this.items=items}}
enum E{Bad}
fn fail(xs:ref Array<(i64,i64)>){defer{xs.push((1,1))};xs.push((20,20));throw E.Bad}
fn middle(xs:ref Array<(i64,i64)>){try{fail(ref xs)}catch(e:E){xs[0]=(0,0)}}
fn answer()->i64{const b=Box([(9,9)]);middle(ref b.items);return b.items[1].0+b.items[1].1+b.items[2].0+b.items[2].1}
export fn run()->i64{return comptime answer()}
