class Box{items:Array<(i64,i64)>;init(items:Array<(i64,i64)>){this.items=items}}
fn replace(xs:ref Array<(i64,i64)>){xs=[(20,20),(1,1)];xs.push((0,0))}
fn middle(xs:ref Array<(i64,i64)>){replace(ref xs);xs[2]=(9,9)}
fn answer()->i64{const b=Box([(0,0)]);middle(ref b.items);return len(b.items)==3 ? b.items[0].0+b.items[0].1+b.items[1].0+b.items[1].1 : 0}
export fn run()->i64{return comptime answer()}
