class Bucket{items:Array<(i64,i64)>;next:Bucket??;constructor(items:Array<(i64,i64)>,next:Bucket??){this.items=items;this.next=next}}
fn grow(xs:ref Array<(i64,i64)>){xs.push((1,1))}
fn change(xs:ref Array<(i64,i64)>){grow(ref xs);xs[0]=(20,20)}
export fn run()->i64{const inner:Bucket?=null;const b=Bucket([(0,0)],inner);change(ref b.items);return b.items[0].0+b.items[0].1+b.items[1].0+b.items[1].1}
