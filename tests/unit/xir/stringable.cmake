add_executable(test_xir_stringable_source xir/test_xir_stringable_source.c)
target_link_libraries(test_xir_stringable_source PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
set(stringable_c "${CMAKE_CURRENT_BINARY_DIR}/generated/stringable.c")
add_custom_command(OUTPUT "${stringable_c}"
 COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
 COMMAND $<TARGET_FILE:test_xir_stringable_source> "${PROJECT_SOURCE_DIR}" "${stringable_c}"
 DEPENDS test_xir_stringable_source "${CMAKE_CURRENT_LIST_DIR}/fixtures/stringable.xr" VERBATIM)
add_executable(test_xir_stringable_native xir/test_xir_stringable_native.c "${stringable_c}")
target_link_libraries(test_xir_stringable_native PRIVATE xray_xir_scalar)
foreach(target test_xir_stringable_source test_xir_stringable_native)
 set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
 if(MSVC)
  target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
 else()
  target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic-errors)
 endif()
endforeach()
add_test(NAME xir_stringable_source COMMAND test_xir_stringable_source "${PROJECT_SOURCE_DIR}")
add_test(NAME xir_stringable_native COMMAND test_xir_stringable_native)
set_tests_properties(xir_stringable_source xir_stringable_native PROPERTIES TIMEOUT 120 LABELS "unit;xir;source;ownership;generated-c")
