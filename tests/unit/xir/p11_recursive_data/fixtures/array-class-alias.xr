class Box{items:Array<(i64,i64)>;init(items:Array<(i64,i64)>){this.items=items}}
fn change(items:ref Array<Box>,box:Box)->i64{box.items.push((20,22));return items[0].items[1].0+items[0].items[1].1}
fn eval()->i64{const box=Box([(0,0)]);var nested=[[box]];return change(ref nested[0],box)}
export fn answer()->i64{return comptime eval()}
