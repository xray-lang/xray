class Box{items:Array<(i64,i64)>;init(items:Array<(i64,i64)>){this.items=items}}
struct Wrap{item:Box;number:i64}
fn change(number:ref i64,box:Box){box.items.push((20,22));number+=2}
fn eval()->i64{const box=Box([]);var wrap=Wrap{item:box,number:40};const before=wrap;change(ref wrap.number,box);return wrap.number+len(box.items)+before.number-41}
export fn answer()->i64{return comptime eval()}
