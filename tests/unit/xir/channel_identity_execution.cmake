add_executable(test_xir_channel_identity_source xir/test_xir_channel_identity_source.c)
target_link_libraries(test_xir_channel_identity_source PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
target_include_directories(test_xir_channel_identity_source PRIVATE ${XRAY_COMMON_INCLUDES} ${CMAKE_BINARY_DIR}/generated)
target_compile_definitions(test_xir_channel_identity_source PRIVATE XR_CHANNEL_IDENTITY_FIXTURES="${PROJECT_SOURCE_DIR}/tests/fixtures/xir_channel_identity" XR_CHANNEL_IDENTITY_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
set(CHANNEL_IDENTITY_NATIVE "${CMAKE_CURRENT_BINARY_DIR}/channel-identity-native.c")
add_custom_command(OUTPUT "${CHANNEL_IDENTITY_NATIVE}"
    COMMAND $<TARGET_FILE:test_xir_channel_identity_source> "${CHANNEL_IDENTITY_NATIVE}"
    DEPENDS test_xir_channel_identity_source "${PROJECT_SOURCE_DIR}/tests/fixtures/xir_channel_identity/root.xr" "${PROJECT_SOURCE_DIR}/tests/fixtures/xir_channel_identity/factory.xr"
    VERBATIM)
add_executable(test_xir_channel_identity_native xir/test_xir_channel_identity_native.c "${CHANNEL_IDENTITY_NATIVE}")
target_link_libraries(test_xir_channel_identity_native PRIVATE xray_xir_scalar xray_compile_resources)
