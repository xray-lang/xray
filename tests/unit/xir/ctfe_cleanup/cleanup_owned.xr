    try { return caughtCleanup() }
    catch (e: Failure) { return match (e) { Failure.Bad { text: t, number: n } -> t == "caught" ? n : -1 } }
}
fn ctfeDouble() -> i64 { defer { const ignored = remainder(0) }; return divide(0) }
fn ctfeDouble446() -> i64 { defer { const ignored = try! nextFailure() }; return try! priorFailure() }
export fn foldedOld() -> i64 { return comptime ctfeOldGraph() }
export fn foldedBoth() -> string { return comptime ctfeBothMessage() }
export fn foldedPending() -> i64 { return comptime ctfePendingLocal() }
