    } catch panic { return -2 }
}
fn ctfeRemaining() -> i64 {
    var value = 40
    try { defer { value = value + 2 }; defer { const ignored = divide(0) }; return 17 }
    catch panic (p) { return p.code == 420 ? value : -1 }
}
