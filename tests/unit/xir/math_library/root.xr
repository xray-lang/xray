import math
fn check(value:bool)->i64 {if(value){return 1};return 0}
export fn exercise() -> i64 {
    var passed:i64=0
    passed+=check(math.sqrt(81.0)==9.0)
    passed+=check(math.pow(2.0,3.0)==8.0)
    passed+=check(math.abs(-2.0)==2.0)
    passed+=check(math.floor(-2.5)==-3)
    passed+=check(math.ceil(-2.5)==-2)
    passed+=check(math.round(-2.5)==-3)
    passed+=check(math.trunc(-2.5)==-2)
    passed+=check(math.sin(0.0)==0.0)
    passed+=check(math.cos(0.0)==1.0)
    passed+=check(math.tan(0.0)==0.0)
    passed+=check(math.asin(0.0)==0.0)
    passed+=check(math.acos(1.0)==0.0)
    passed+=check(math.atan(0.0)==0.0)
    passed+=check(math.atan2(0.0,1.0)==0.0)
    passed+=check(math.log(1.0)==0.0)
    passed+=check(math.log10(1.0)==0.0)
    passed+=check(math.log2(1.0)==0.0)
    passed+=check(math.exp(0.0)==1.0)
    passed+=check(math.sinh(0.0)==0.0)
    passed+=check(math.cosh(0.0)==1.0)
    passed+=check(math.tanh(0.0)==0.0)
    passed+=check(math.hypot(3.0,4.0)==5.0)
    passed+=check(math.cbrt(-8.0)==-2.0)
    passed+=check(math.fmod(5.0,2.0)==1.0)
    passed+=check(math.log1p(0.0)==0.0)
    passed+=check(math.expm1(0.0)==0.0)
    passed+=check(math.lerp(1.0,5.0,0.5)==3.0)
    passed+=check(math.degToRad(180.0)==math.PI)
    passed+=check(math.radToDeg(math.PI)==180.0)
    passed+=check(math.sign(-2.0)==-1)
    passed+=check(math.isNaN(math.NAN))
    passed+=check(math.isFinite(1.0) && !math.isFinite(math.INF))
    passed+=check(math.min(4.0,-2.0,8.0)==-2.0 && math.isNaN(math.min()))
    passed+=check(math.max(4.0,-2.0,8.0)==8.0 && math.isNaN(math.max()))
    passed+=check(math.clamp(8.0,4.0,1.0)==4.0)
    const random=math.random()
    passed+=check(random>=0.0 && random<1.0)
    const integer=math.randomInt(4,-2)
    passed+=check(integer>=-2 && integer<=4 && math.randomInt(7,7)==7)
    passed+=check(math.PI>3.0 && math.PI<3.2)
    passed+=check(math.E>2.7 && math.E<2.8)
    passed+=check(math.TAU==math.PI*2.0)
    passed+=check(math.SQRT2>1.4 && math.SQRT2<1.5)
    passed+=check(math.LN2>0.6 && math.LN2<0.7)
    passed+=check(math.LN10>2.3 && math.LN10<2.4)
    passed+=check(math.LOG2E>1.4 && math.LOG2E<1.5)
    passed+=check(math.LOG10E>0.4 && math.LOG10E<0.5)
    passed+=check(math.EPSILON>0.0 && math.EPSILON<0.000001)
    passed+=check(math.MAX_I64==9223372036854775807)
    passed+=check(math.MIN_I64==(-9223372036854775807-1))
    passed+=check(math.MAX_F64>1.0e308 && math.isFinite(math.MAX_F64))
    passed+=check(math.INF>math.MAX_F64)
    passed+=check(math.NAN!=math.NAN)
    return passed
}
export fn deterministic() -> f64 {return math.sqrt(81.0)}
