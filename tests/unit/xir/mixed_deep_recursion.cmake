add_executable(test_xir_mixed_deep_producer xir/test_xir_mixed_deep_producer.c)
target_link_libraries(test_xir_mixed_deep_producer PRIVATE xray_xir_source xray_xir_cgen)
target_compile_definitions(test_xir_mixed_deep_producer PRIVATE
    XR_DEEP_FIXTURES="${CMAKE_SOURCE_DIR}/tests/unit/xir/fixtures/p20_worker_deep" XR_DEEP_STDLIB="${CMAKE_SOURCE_DIR}/stdlib")
set(deep_source "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_worker_deep.c")
add_custom_command(OUTPUT "${deep_source}"
    COMMAND $<TARGET_FILE:test_xir_mixed_deep_producer> "${deep_source}"
    DEPENDS test_xir_mixed_deep_producer xir/fixtures/p20_worker_deep/root.xr xir/fixtures/p20_worker_deep/callee.xr VERBATIM)

foreach(deep_target IN ITEMS test_xir_mixed_deep_producer)
    set_target_properties(${deep_target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${deep_target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${deep_target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
foreach(deep_keeper RANGE 0 1)

    set(deep_compile_begin 0)
    while(deep_compile_begin LESS 3692)
        math(EXPR deep_compile_end "${deep_compile_begin} + 64")
        if(deep_compile_end GREATER 3692)
            set(deep_compile_end 3692)
        endif()
        set(deep_compile_name test_xir_mixed_deep_compiler_${deep_keeper}_fi_${deep_compile_begin}_${deep_compile_end})

        set(deep_compile_begin ${deep_compile_end})
    endwhile()
endforeach()
# The frozen normal census bounds every shard; the executable rejects count drift.
set(deep_resource_site_counts 22 312 312 312 312 29)
foreach(deep_backend IN ITEMS 0 1 vm native)

    foreach(deep_source_runtime_mode RANGE 0 5)
        list(GET deep_resource_site_counts ${deep_source_runtime_mode} deep_source_runtime_sites)
        set(deep_source_runtime_begin 0)
        while(deep_source_runtime_begin LESS deep_source_runtime_sites)
            math(EXPR deep_source_runtime_end "${deep_source_runtime_begin} + 64")
            if(deep_source_runtime_end GREATER deep_source_runtime_sites)
                set(deep_source_runtime_end ${deep_source_runtime_sites})
            endif()
            set(deep_source_runtime_name test_xir_mixed_deep_source_resources_${deep_backend}_fi_m${deep_source_runtime_mode}_${deep_source_runtime_begin}_${deep_source_runtime_end})

            set(deep_source_runtime_begin ${deep_source_runtime_end})
        endwhile()
    endforeach()

    set(deep_source_begin 0)
    while(deep_source_begin LESS 4297)
        math(EXPR deep_source_end "${deep_source_begin} + 64")
        if(deep_source_end GREATER 4297)
            set(deep_source_end 4297)
        endif()
        set(deep_source_name test_xir_mixed_deep_source_compiler_${deep_backend}_fi_${deep_source_begin}_${deep_source_end})

        set(deep_source_begin ${deep_source_end})
    endwhile()

    foreach(deep_mode RANGE 0 5)
        list(GET deep_resource_site_counts ${deep_mode} deep_sites)
        set(deep_begin 0)
        while(deep_begin LESS deep_sites)
            math(EXPR deep_end "${deep_begin} + 64")
            if(deep_end GREATER deep_sites)
                set(deep_end ${deep_sites})
            endif()
            set(deep_name test_xir_mixed_deep_${deep_backend}_fi_m${deep_mode}_${deep_begin}_${deep_end})

            set(deep_begin ${deep_end})
        endwhile()
    endforeach()
endforeach()
