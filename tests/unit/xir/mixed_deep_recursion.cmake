add_executable(test_xir_mixed_deep_producer xir/test_xir_mixed_deep_producer.c)
target_link_libraries(test_xir_mixed_deep_producer PRIVATE xray_xir_source xray_xir_cgen)
target_compile_definitions(test_xir_mixed_deep_producer PRIVATE
    XR_DEEP_FIXTURES="${CMAKE_SOURCE_DIR}/tests/unit/xir/fixtures/p20_worker_deep" XR_DEEP_STDLIB="${CMAKE_SOURCE_DIR}/stdlib")
set(deep_source "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_worker_deep.c")
add_custom_command(OUTPUT "${deep_source}"
    COMMAND $<TARGET_FILE:test_xir_mixed_deep_producer> "${deep_source}"
    DEPENDS test_xir_mixed_deep_producer xir/fixtures/p20_worker_deep/root.xr xir/fixtures/p20_worker_deep/callee.xr VERBATIM)
add_executable(test_xir_mixed_deep_recursion xir/test_xir_mixed_deep_recursion.c "${deep_source}")
target_link_libraries(test_xir_mixed_deep_recursion PRIVATE xray_xir_vm xray_xir_scalar)
add_executable(test_xir_mixed_deep_resources xir/test_xir_mixed_deep_resources.c "${deep_source}")
target_link_libraries(test_xir_mixed_deep_resources PRIVATE xray_xir_vm xray_xir_scalar)
foreach(deep_target IN ITEMS test_xir_mixed_deep_producer test_xir_mixed_deep_recursion test_xir_mixed_deep_resources)
    set_target_properties(${deep_target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${deep_target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${deep_target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
# The frozen normal census bounds every shard; the executable rejects count drift.
set(deep_resource_site_counts 22 312 312 312 312 29)
foreach(deep_backend IN ITEMS 0 1 vm native)
    add_test(NAME test_xir_mixed_deep_${deep_backend} COMMAND test_xir_mixed_deep_recursion ${deep_backend})
    set_tests_properties(test_xir_mixed_deep_${deep_backend} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE COST 1
        LABELS "unit;xir;mixed;execution;ownership;root;worker;generated-c;lifecycle;recursion;stack")
    add_test(NAME test_xir_mixed_deep_${deep_backend}_axes COMMAND test_xir_mixed_deep_resources ${deep_backend} axes)
    set_tests_properties(test_xir_mixed_deep_${deep_backend}_axes PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE COST 1
        LABELS "unit;xir;mixed;execution;ownership;root;worker;generated-c;lifecycle;recursion;stack;axes")
    foreach(deep_mode RANGE 0 5)
        list(GET deep_resource_site_counts ${deep_mode} deep_sites)
        set(deep_begin 0)
        while(deep_begin LESS deep_sites)
            math(EXPR deep_end "${deep_begin} + 64")
            if(deep_end GREATER deep_sites)
                set(deep_end ${deep_sites})
            endif()
            set(deep_name test_xir_mixed_deep_${deep_backend}_fi_m${deep_mode}_${deep_begin}_${deep_end})
            add_test(NAME ${deep_name} COMMAND test_xir_mixed_deep_resources ${deep_backend} fi ${deep_mode} ${deep_begin} ${deep_end} ${deep_sites})
            set_tests_properties(${deep_name} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE COST 1
                LABELS "unit;xir;mixed;execution;ownership;root;worker;generated-c;lifecycle;recursion;stack;fi")
            set(deep_begin ${deep_end})
        endwhile()
    endforeach()
endforeach()
