add_executable(test_xir_call_observation ${CMAKE_CURRENT_LIST_DIR}/test_xir_call_observation.c "${CN_NATIVE_C}")
target_link_libraries(test_xir_call_observation PRIVATE xray_xir_vm xray_xir_scalar)
set_target_properties(test_xir_call_observation PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(MSVC)
    target_compile_options(test_xir_call_observation PRIVATE /W4 /WX /utf-8)
else()
    target_compile_options(test_xir_call_observation PRIVATE -Wall -Wextra -Werror)
endif()
foreach(direction vm-native native-vm)
    string(REPLACE "-" "_" name "${direction}")
    foreach(mode normal late cancel binding fi)
        add_test(NAME test_xir_call_observation_${name}_${mode} COMMAND test_xir_call_observation ${direction} ${mode})
        set_tests_properties(test_xir_call_observation_${name}_${mode} PROPERTIES TIMEOUT 60
            LABELS "unit;xir;task;call;observation;mixed;ownership;runtime;generated-c")
    endforeach()
endforeach()
