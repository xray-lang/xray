set(tuple_spread_native_targets)
foreach(case IN ITEMS order context empty nested failure callable context_prefix structure wide)
    set(expected 42)
    if(case STREQUAL "order")
        set(expected 12303111758)
    elseif(case STREQUAL "context")
        set(expected 107013)
    elseif(case STREQUAL "empty")
        set(expected 12181)
    elseif(case STREQUAL "nested")
        set(expected 323119)
    elseif(case STREQUAL "failure")
        set(expected 44512)
    elseif(case STREQUAL "callable")
        set(expected 17)
    endif()
    add_test(NAME test_xir_p10_tuple_spread_${case}
        COMMAND test_xir_p10_reference --accept tuple_spread_${case} ${expected})
    set_tests_properties(test_xir_p10_tuple_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;tuple-spread;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/tuple_spread_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit tuple_spread_${case} ${expected} "${generated}"
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/tuple_spread_${case}.xr"
        VERBATIM)
    foreach(mode IN ITEMS native mixed)
        set(target "test_xir_p10_tuple_spread_${mode}_${case}")
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        if(mode STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        list(APPEND tuple_spread_native_targets ${target})
        add_test(NAME ${target} COMMAND ${target} ${expected})
        set_tests_properties(${target} PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;tuple-spread;ownership;${mode}")
    endforeach()
endforeach()
foreach(case IN ITEMS scalar array arity type generic nullable excess unit_arity)
    set(message "Tuple literal spread requires a statically known Tuple")
    if(case STREQUAL "arity" OR case STREQUAL "excess" OR case STREQUAL "unit_arity")
        set(message "Tuple literal requires an exact ordered arity context")
    elseif(case STREQUAL "type")
        set(message "expression cannot satisfy its declared type")
    endif()
    add_test(NAME test_xir_p10_tuple_spread_reject_${case}
        COMMAND test_xir_p10_reference --reject reject_tuple_spread_${case} 2 "${message}")
    set_tests_properties(test_xir_p10_tuple_spread_reject_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;tuple-spread;ownership;reject")
endforeach()
add_custom_target(xir_p10_tuple_spread_native DEPENDS ${tuple_spread_native_targets})
xray_stage_windows_asan_runtime("${CMAKE_CURRENT_BINARY_DIR}")
xray_prepend_windows_asan_runtime_to_directory_tests()
