foreach(case IN ITEMS order generic suspend nested failure)
    set(suspensions 0)
    if(case STREQUAL "order")
        set(expected 12303074782)
    elseif(case STREQUAL "generic")
        set(expected 3342)
    elseif(case STREQUAL "suspend")
        set(expected 12331124)
        set(suspensions 1)
    elseif(case STREQUAL "failure")
        set(expected 44512)
    else()
        set(expected 323119)
    endif()
    add_test(NAME test_xir_p10_reference_array_spread_${case}
        COMMAND test_xir_p10_reference --accept array_spread_${case} ${expected} ${suspensions})
    set_tests_properties(test_xir_p10_reference_array_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;reference;array;spread;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/array_spread_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit array_spread_${case} ${expected} "${generated}" ${suspensions}
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/array_spread_${case}.xr"
        VERBATIM)
    foreach(backend IN ITEMS native mixed)
        set(target test_xir_p10_reference_${backend}_array_spread_${case})
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(backend STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        list(APPEND reference_native_targets ${target})
        add_test(NAME ${target} COMMAND ${target} ${expected} ${suspensions})
        set_tests_properties(${target} PROPERTIES
            TIMEOUT 30 LABELS "unit;xir;p10;reference;array;spread;ownership;${backend}")
    endforeach()
    add_test(NAME test_xir_p10_array_spread_${case}_source_resources
        COMMAND test_xir_p10_initializer_resources --array-spread-${case})
    set_tests_properties(test_xir_p10_array_spread_${case}_source_resources PROPERTIES
        TIMEOUT 300 RUN_SERIAL TRUE COST 100 LABELS "unit;xir;p10;array;spread;ownership;allocation;budget")
endforeach()
foreach(case IN ITEMS scalar type generic const_write)
    if(case STREQUAL "const_write")
        set(line 4)
        set(message "value mutation requires a mutable named root")
    elseif(case STREQUAL "type")
        set(line 3)
        set(message "expression cannot satisfy its declared type")
    elseif(case STREQUAL "scalar")
        set(line 2)
        set(message "Array literal spread requires an Array value")
    else()
        set(line 2)
        set(message "expression cannot satisfy its declared type")
    endif()
    add_test(NAME test_xir_p10_reference_reject_array_spread_${case}
        COMMAND test_xir_p10_reference --reject reject_array_spread_${case} ${line} "${message}")
    set_tests_properties(test_xir_p10_reference_reject_array_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;reference;array;spread;reject")
endforeach()
foreach(case IN ITEMS order generic suspend nested failure)
    set(target test_xir_p10_array_spread_${case}_runtime)
    add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_initializer_places_runtime.c"
        "${CMAKE_CURRENT_BINARY_DIR}/generated_native/array_spread_${case}.c")
    target_link_libraries(${target} PRIVATE xray_xir_vm)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(case STREQUAL "order")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=12303074782LL XR_LANGUAGE_RUNTIME_CROSSINGS=3)
    elseif(case STREQUAL "generic")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=3342 XR_LANGUAGE_RUNTIME_CROSSINGS=1)
    elseif(case STREQUAL "suspend")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=12331124 XR_LANGUAGE_RUNTIME_CROSSINGS=3 XR_LANGUAGE_RUNTIME_SUSPENSIONS=1)
    elseif(case STREQUAL "nested")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=323119 XR_LANGUAGE_RUNTIME_CROSSINGS=4)
    else()
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=44512 XR_LANGUAGE_RUNTIME_CROSSINGS=3)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
    list(APPEND reference_native_targets ${target})
    foreach(mode RANGE 0 3)
        foreach(operation IN ITEMS normal fi cancel axes)
            add_test(NAME test_xir_p10_array_spread_${case}_${operation}_${mode}
                COMMAND ${target} ${mode} --${operation})
            set_tests_properties(test_xir_p10_array_spread_${case}_${operation}_${mode} PROPERTIES
                TIMEOUT 300 LABELS "unit;xir;p10;array;spread;ownership;runtime;${operation}")
            if(NOT operation STREQUAL "normal")
                set_tests_properties(test_xir_p10_array_spread_${case}_${operation}_${mode} PROPERTIES RUN_SERIAL TRUE COST 100)
            endif()
        endforeach()
    endforeach()
endforeach()
