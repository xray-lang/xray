foreach(case IN ITEMS smoke basic empty order nested callable context struct array comptime comptime_callable)
    if(case STREQUAL "smoke")
        set(expected 16)
    elseif(case STREQUAL "basic")
        set(expected 819)
    elseif(case STREQUAL "empty")
        set(expected 17)
    elseif(case STREQUAL "order")
        set(expected 1233711)
    elseif(case STREQUAL "nested")
        set(expected 31713)
    elseif(case STREQUAL "callable")
        set(expected 12)
    elseif(case STREQUAL "context")
        set(expected 78)
    elseif(case STREQUAL "array")
        set(expected 317)
    elseif(case STREQUAL "comptime_callable")
        set(expected 12)
    elseif(case STREQUAL "comptime")
        set(expected 1732)
    elseif(case STREQUAL "struct")
        set(expected 581)
    endif()
    add_test(NAME test_xir_p10_record_source_${case}
        COMMAND test_xir_p10_reference --accept record_${case} ${expected})
    set_tests_properties(test_xir_p10_record_source_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;record;source;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/record_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit record_${case} ${expected} "${generated}"
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/record_${case}.xr"
        VERBATIM)
    foreach(backend IN ITEMS native mixed)
        if(case STREQUAL "smoke" AND backend STREQUAL "mixed")
            continue()
        endif()
        set(target test_xir_p10_record_${backend}_${case})
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(backend STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${target} COMMAND ${target} ${expected})
        set_tests_properties(${target} PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;record;ownership;${backend}")
        list(APPEND p10_record_targets ${target})
    endforeach()
endforeach()
add_custom_target(p10_record_consumers DEPENDS ${p10_record_targets})

