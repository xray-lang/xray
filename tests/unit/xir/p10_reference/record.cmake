foreach(case IN ITEMS duplicate const shape)
    if(case STREQUAL "duplicate")
        set(line 4)
        set(message "duplicate explicit record field")
    elseif(case STREQUAL "const")
        set(line 3)
        set(message "value mutation requires a mutable named root")
    else()
        set(line 3)
        set(message "expression cannot satisfy its declared type")
    endif()
    add_test(NAME test_xir_p10_record_reject_${case}
        COMMAND test_xir_p10_reference --reject record_reject_${case} ${line} "${message}")
    set_tests_properties(test_xir_p10_record_reject_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;record;source;reject;ownership")
endforeach()
