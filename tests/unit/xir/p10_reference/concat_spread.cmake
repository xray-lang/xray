foreach(case IN ITEMS named literal empty mixed order generic)
    set(expected 42)
    if(case STREQUAL "order")
        set(expected 123161)
    endif()
    add_test(NAME test_xir_p10_concat_spread_source_${case}
        COMMAND test_xir_p10_reference --accept concat_spread_${case} ${expected})
    set_tests_properties(test_xir_p10_concat_spread_source_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;ownership;concat-spread")
endforeach()
foreach(case IN ITEMS array scalar field element ref)
    set(line 2)
    set(message "Array concat spread requires a fixed Tuple")
    if(case STREQUAL "field" OR case STREQUAL "element")
        set(line 3)
        set(message "Array concat spread fields require its receiver Array type")
    elseif(case STREQUAL "ref")
        set(line 3)
        set(message "Array concat arguments use ordinary READ values")
    endif()
    add_test(NAME test_xir_p10_concat_spread_reject_${case}
        COMMAND test_xir_p10_reference --reject concat_spread_reject_${case} ${line} "${message}")
    set_tests_properties(test_xir_p10_concat_spread_reject_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;ownership;concat-spread")
endforeach()

set(concat_spread_c "${CMAKE_CURRENT_BINARY_DIR}/generated_native/concat_spread_order.c")
add_custom_command(OUTPUT "${concat_spread_c}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
    COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit concat_spread_order 123161 "${concat_spread_c}"
    DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/concat_spread_order.xr"
    VERBATIM)
foreach(mode IN ITEMS native mixed)
    set(target "test_xir_p10_concat_spread_${mode}")
    add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${concat_spread_c}")
    target_link_libraries(${target} PRIVATE xray_xir_vm)
    if(mode STREQUAL "mixed")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
    else()
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
    endif()
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME ${target} COMMAND ${target} 123161)
    set_tests_properties(${target} PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;ownership;concat-spread;${mode}")
endforeach()
xray_stage_windows_asan_runtime("${CMAKE_CURRENT_BINARY_DIR}")
xray_prepend_windows_asan_runtime_to_directory_tests()
