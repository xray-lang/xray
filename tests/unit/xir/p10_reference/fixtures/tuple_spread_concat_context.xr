fn append<T>(first: Array<T>, tail: Array<T>) -> Array<T> {
    return first.concat(...([], ...(tail, []), ...()))
}
export fn referenceAnswer() -> i64 {
    const receiver: Array<i8> = [40]
    const contextual = receiver.concat(...((...([], [2]), ...())))
    const generic = append<i8>([20], [22])
    if ((contextual[0] as i64) + (contextual[1] as i64) != 42) { return 0 }
    return (generic[0] as i64) + (generic[1] as i64)
}
