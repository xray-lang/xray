final class BuilderModel {
    private text: string
    private empty: string
    init() { this.text = ""; this.empty = "" }
    append(value: string) -> BuilderModel { this.text = this.text + value; return this }
    toString() -> string { return this.text }
    clear() -> BuilderModel { this.text = this.empty; return this }
}
var trace: i64 = 0
fn receiver(value: BuilderModel) -> BuilderModel { trace = trace * 10 + 1; return value }
fn argument(value: BuilderModel) -> string { trace = trace * 10 + 2; value.clear().append("side"); return "tail" }
export fn referenceAnswer() -> i64 {
    var b = BuilderModel()
    b.append("before")
    trace = 0
    receiver(b).append(argument(b))
    if (trace != 12 || b.toString() != "sidetail") { return 0 }
    return 42
}
