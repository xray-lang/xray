class Counter {
    value: i64
    init(value) { this.value = value }
}
fn layer<T>(value: T) -> T? { return value }
fn classify(value: i64??) -> i64 {
    if (value == null) { return 0 }
    if (value == null) { return 1 }
    return 2
}
export fn referenceAnswer() -> i64 {
    const inner: Array<i64> = [3, 7]
    const counter = Counter(17)
    const source: (Array<Array<i64>>, Counter, i64??, i64??) = ([inner], counter, layer<i64?>(null), null)
    const copied = (...source,)
    var changed = copied.0
    changed[0].push(13)
    copied.1.value = 19
    return source.0[0][0] * 100000 + len(source.0[0]) * 10000 + len(changed[0]) * 1000 + classify(copied.2) * 100 + classify(copied.3) * 10 + source.1.value
}
