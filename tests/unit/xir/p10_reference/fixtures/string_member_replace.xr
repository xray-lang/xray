export fn probe(s: string) -> i64 { return len(s.replace("a", "b")) }
export fn heldString() -> string { return "é\0é🙂".replace("é", "字") }
export fn referenceAnswer() -> i64 {
    if (probe("aa") != 2 || "aaaa".replace("aa", "X") != "Xaa") { return 0 }
    if ("é\0é🙂".replace("\0é", "Q") != "éQ🙂") { return 0 }
    if ("abc".replace("", "x") != "abc" || "abc".replace("b", "") != "ac") { return 0 }
    return 42
}
