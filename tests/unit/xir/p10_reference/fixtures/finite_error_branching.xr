enum BranchError { Stop }
fn branch(value:i64)->i64 {
    if(value==4) { throw BranchError.Stop }
    var result:i64=0
    if(value%2==0) { result=value*2 }
    else { result=value+1 }
    return result
}
export fn referenceAnswer()->i64 {
    var index:i64=0
    var total:i64=0
    while(index<8) {
        if(index==6) { break }
        if(index==1) { index=index+1; continue }
        try { total=total+branch(index) }
        catch(error:BranchError) { total=total+28 }
        index=index+1
    }
    return total
}
