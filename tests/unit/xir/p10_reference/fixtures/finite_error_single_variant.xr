enum RouteError { Left, Right }
fn fail(depth:i64)->i64 {
    if(depth>0) { return fail(depth-1) }
    throw RouteError.Left
}
export fn referenceAnswer()->i64 {
    var total:i64=0
    try { total=fail(3) }
    catch(error:RouteError) {
        total=match(error) { RouteError.Left->42, RouteError.Right->0 }
    }
    return total
}
