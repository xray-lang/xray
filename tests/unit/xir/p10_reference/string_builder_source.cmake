include_guard(GLOBAL)
add_executable(test_xir_p10_builder_catalog "${CMAKE_CURRENT_LIST_DIR}/test_builder_catalog.c")
target_link_libraries(test_xir_p10_builder_catalog PRIVATE xray_xir_source xray_xir_vm)
target_compile_definitions(test_xir_p10_builder_catalog PRIVATE XR_C08_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
set_target_properties(test_xir_p10_builder_catalog PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(MSVC)
    target_compile_options(test_xir_p10_builder_catalog PRIVATE /W4 /WX /utf-8)
else()
    target_compile_options(test_xir_p10_builder_catalog PRIVATE -Wall -Wextra -Werror)
endif()
add_test(NAME test_xir_p10_builder_catalog COMMAND test_xir_p10_builder_catalog)
set_tests_properties(test_xir_p10_builder_catalog PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;string-builder;catalog")
foreach(case IN ITEMS basic rune i64 f64 bool null alias_clear order repeated_owner comptime concat_order)
    add_test(NAME test_xir_p10_string_builder_source_${case}
        COMMAND test_xir_p10_reference --accept builder_${case} 42)
    set_tests_properties(test_xir_p10_string_builder_source_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;string-builder;source")
endforeach()
foreach(case IN ITEMS basic order)
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/builder_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit builder_${case} 42 "${generated}"
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/builder_${case}.xr"
        VERBATIM)
    foreach(backend IN ITEMS native mixed)
        set(target test_xir_p10_reference_${backend}_builder_${case})
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(backend STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${target} COMMAND ${target} 42)
        set_tests_properties(${target} PROPERTIES TIMEOUT 30 LABELS "unit;xir;p10;string-builder;${backend}")
    endforeach()
endforeach()
