        set_tests_properties(${target} PROPERTIES
            TIMEOUT 30 LABELS "unit;xir;p10;reference;call;spread;ownership;${backend}")
    endforeach()
    add_test(NAME test_xir_p10_call_spread_${case}_source_resources
        COMMAND test_xir_p10_initializer_resources --call-spread-${case})
    set_tests_properties(test_xir_p10_call_spread_${case}_source_resources PROPERTIES
        TIMEOUT 300 RUN_SERIAL TRUE COST 100 LABELS "unit;xir;p10;call;spread;ownership;allocation;budget")
endforeach()
foreach(case IN ITEMS scalar array arity ref generic type alias)
    set(line 3)
    if(case STREQUAL "generic")
        set(line 2)
    elseif(case STREQUAL "alias")
        set(line 4)
    endif()
    if(case STREQUAL "arity")
        set(message "too many call arguments")
    elseif(case STREQUAL "ref")
        set(message "call spread cannot satisfy a ref parameter")
    elseif(case STREQUAL "type")
        set(message "expression cannot satisfy its declared type")
    elseif(case STREQUAL "alias")
        set(message "ref arguments of one call must not alias")
    else()
        set(message "call spread requires a statically known Tuple")
    endif()
    add_test(NAME test_xir_p10_reference_reject_call_spread_${case}
        COMMAND test_xir_p10_reference --reject reject_call_spread_${case} ${line} "${message}")
    set_tests_properties(test_xir_p10_reference_reject_call_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;reference;call;spread;reject")
endforeach()
