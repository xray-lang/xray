set(call_spread_native_targets)
foreach(case IN ITEMS basic order empty nested context generic owned defaults ref callable)
    set(expected 42)
    if(case STREQUAL "order")
        set(expected 12303111758)
    elseif(case STREQUAL "empty")
        set(expected 127828)
    elseif(case STREQUAL "defaults")
        set(expected 711)
    endif()
    add_test(NAME test_xir_p10_call_spread_${case}
        COMMAND test_xir_p10_reference --accept call_spread_${case} ${expected})
    set_tests_properties(test_xir_p10_call_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;call-spread;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/call_spread_${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit call_spread_${case} ${expected} "${generated}"
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/call_spread_${case}.xr"
        VERBATIM)
    foreach(mode IN ITEMS native mixed)
        set(target "test_xir_p10_call_spread_${mode}_${case}")
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        if(mode STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        list(APPEND call_spread_native_targets ${target})
        add_test(NAME ${target} COMMAND ${target} ${expected})
        set_tests_properties(${target} PROPERTIES
            TIMEOUT 30 LABELS "unit;xir;p10;call-spread;ownership;${mode}")
    endforeach()
endforeach()
foreach(case IN ITEMS array scalar short excess type ref alias named)
    set(reject --reject)
    set(message "call spread requires a statically known Tuple")
    if(case STREQUAL "short")
        set(message "missing required call argument")
    elseif(case STREQUAL "excess")
        set(message "too many call arguments")
    elseif(case STREQUAL "type")
        set(message "expression cannot satisfy its declared type")
    elseif(case STREQUAL "ref")
        set(message "call spread cannot satisfy a ref parameter")
    elseif(case STREQUAL "alias")
        set(message "ref arguments of one call must not alias")
    elseif(case STREQUAL "named")
        set(reject --reject-structure)
        set(message "expected ')' after argument list")
    endif()
    add_test(NAME test_xir_p10_call_spread_reject_${case}
        COMMAND test_xir_p10_reference ${reject} reject_call_spread_${case} 2 "${message}")
    set_tests_properties(test_xir_p10_call_spread_reject_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;source;call-spread;ownership;reject")
endforeach()
add_custom_target(xir_p10_call_spread_native DEPENDS ${call_spread_native_targets})
xray_stage_windows_asan_runtime("${CMAKE_CURRENT_BINARY_DIR}")
xray_prepend_windows_asan_runtime_to_directory_tests()
