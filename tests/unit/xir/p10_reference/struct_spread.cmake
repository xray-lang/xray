foreach(case IN ITEMS struct_spread_order struct_spread_cow struct_spread_suspend struct_spread_import struct_spread_conversion)
    set(suspensions 0)
    if(case STREQUAL "struct_spread_order")
        set(expected 50401245)
    elseif(case STREQUAL "struct_spread_cow")
        set(expected 4135)
    elseif(case STREQUAL "struct_spread_import")
        set(expected 90)
    elseif(case STREQUAL "struct_spread_conversion")
        set(expected 710)
    else()
        set(expected 3623)
        set(suspensions 1)
    endif()
    add_test(NAME test_xir_p10_reference_${case}
        COMMAND test_xir_p10_reference --accept ${case} ${expected} ${suspensions})
    set_tests_properties(test_xir_p10_reference_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;reference;struct;spread;ownership")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated_native/${case}.c")
    add_custom_command(OUTPUT "${generated}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated_native"
        COMMAND $<TARGET_FILE:test_xir_p10_reference> --emit ${case} ${expected} "${generated}" ${suspensions}
        DEPENDS test_xir_p10_reference "${CMAKE_CURRENT_LIST_DIR}/fixtures/${case}.xr"
        VERBATIM)
    foreach(backend IN ITEMS native mixed)
        set(target "test_xir_p10_reference_${backend}_${case}")
        add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_language_native.c" "${generated}")
        target_link_libraries(${target} PRIVATE xray_xir_vm)
        set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(backend STREQUAL "mixed")
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=1)
        else()
            target_compile_definitions(${target} PRIVATE XR_LANGUAGE_MIXED=0)
        endif()
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
        list(APPEND reference_native_targets ${target})
        add_test(NAME ${target} COMMAND ${target} ${expected} ${suspensions})
        set_tests_properties(${target} PROPERTIES
            TIMEOUT 30 LABELS "unit;xir;p10;reference;struct;spread;ownership;${backend}")
    endforeach()
endforeach()

foreach(case IN ITEMS order cow)
    set(target test_xir_p10_struct_spread_${case}_runtime)
    add_executable(${target} "${CMAKE_CURRENT_LIST_DIR}/test_initializer_places_runtime.c"
        "${CMAKE_CURRENT_BINARY_DIR}/generated_native/struct_spread_${case}.c")
    target_link_libraries(${target} PRIVATE xray_xir_vm)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(case STREQUAL "order")
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=50401245 XR_LANGUAGE_RUNTIME_CROSSINGS=3)
    else()
        target_compile_definitions(${target} PRIVATE XR_LANGUAGE_RUNTIME_EXPECTED=4135 XR_LANGUAGE_RUNTIME_CROSSINGS=1)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
    list(APPEND reference_native_targets ${target})
    foreach(mode RANGE 0 3)
        foreach(operation IN ITEMS normal fi cancel axes)
            add_test(NAME test_xir_p10_struct_spread_${case}_${operation}_${mode}
                COMMAND ${target} ${mode} --${operation})
            set_tests_properties(test_xir_p10_struct_spread_${case}_${operation}_${mode} PROPERTIES
                TIMEOUT 300 LABELS "unit;xir;p10;struct;spread;ownership;runtime;${operation}")
            if(NOT operation STREQUAL "normal")
                set_tests_properties(test_xir_p10_struct_spread_${case}_${operation}_${mode} PROPERTIES RUN_SERIAL TRUE COST 100)
            endif()
        endforeach()
    endforeach()
    add_test(NAME test_xir_p10_struct_spread_${case}_source_resources
        COMMAND test_xir_p10_initializer_resources --struct-spread-${case})
    set_tests_properties(test_xir_p10_struct_spread_${case}_source_resources PROPERTIES
        TIMEOUT 300 RUN_SERIAL TRUE COST 100 LABELS "unit;xir;p10;struct;spread;ownership;allocation;budget")
endforeach()

foreach(case IN ITEMS duplicate extra type class private foreign_init generic)
    if(case STREQUAL "duplicate")
        set(line 3)
        set(message "duplicate struct literal field")
    elseif(case STREQUAL "extra")
        set(line 4)
        set(message "unknown struct field")
    elseif(case STREQUAL "type")
        set(line 4)
        set(message "expression cannot satisfy its declared type")
    elseif(case STREQUAL "private")
        set(line 7)
        set(message "field access is not permitted")
    elseif(case STREQUAL "foreign_init")
        set(line 3)
        set(message "struct literal with init is restricted to its declaring module")
    else()
        set(line 4)
        if(case STREQUAL "generic")
            set(line 3)
        endif()
        set(message "struct spread requires a nominal struct value")
    endif()
    add_test(NAME test_xir_p10_reference_reject_struct_spread_${case}
        COMMAND test_xir_p10_reference --reject reject_struct_spread_${case} ${line} "${message}")
    set_tests_properties(test_xir_p10_reference_reject_struct_spread_${case} PROPERTIES
        TIMEOUT 30 LABELS "unit;xir;p10;reference;struct;spread;reject")
endforeach()
