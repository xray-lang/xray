foreach(flavor results errors)
    if(flavor STREQUAL "results")
        set(recursive_class_group constructed)
        set(recursive_class_fixture_macro XR_TASK_CONSTRUCTED_FIXTURES)
        set(recursive_class_runner_source test_xir_task_constructed_results.c)
    else()
        set(recursive_class_group closed_error)
        set(recursive_class_fixture_macro XR_TASK_CLOSED_ERROR_FIXTURES)
        set(recursive_class_runner_source test_xir_task_closed_error_resources.c)
    endif()
    set(recursive_class_dir "${CMAKE_CURRENT_BINARY_DIR}/task-recursive-class-${flavor}")
    set(recursive_class_fixture "${PROJECT_SOURCE_DIR}/tests/fixtures/xir_p08_task_recursive_class_${flavor}")
    set(recursive_class_c "${recursive_class_dir}/task_${recursive_class_group}_native.c")
    set(recursive_class_header "${recursive_class_dir}/task_${recursive_class_group}_generated.h")
    set(recursive_class_emit test_xir_task_recursive_class_${flavor}_emit)
    set(recursive_class_runner test_xir_task_recursive_class_${flavor})
    add_executable(${recursive_class_emit} "${CMAKE_CURRENT_LIST_DIR}/test_xir_task_${recursive_class_group}_emit.c")
    target_link_libraries(${recursive_class_emit} PRIVATE xray_xir_source xray_xir_cgen xray_xir_vm)
    add_custom_command(OUTPUT "${recursive_class_c}" "${recursive_class_header}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${recursive_class_dir}"
        COMMAND ${recursive_class_emit} "${recursive_class_c}" "${recursive_class_header}"
        DEPENDS ${recursive_class_emit} "${recursive_class_fixture}/root.xr" VERBATIM)
    add_executable(${recursive_class_runner} "${CMAKE_CURRENT_LIST_DIR}/${recursive_class_runner_source}" "${recursive_class_c}" "${recursive_class_header}")
    target_include_directories(${recursive_class_runner} PRIVATE "${recursive_class_dir}")
    target_link_libraries(${recursive_class_runner} PRIVATE xray_xir_source xray_xir_vm)
    set(recursive_class_targets ${recursive_class_emit} ${recursive_class_runner})
    if(flavor STREQUAL "results")
        set(recursive_class_control test_xir_task_recursive_class_control)
        set(recursive_class_control_source test_xir_task_constructed_control.c)
    else()
        set(recursive_class_control test_xir_task_recursive_class_error_control)
        set(recursive_class_control_source test_xir_task_closed_error_control.c)
    endif()
    add_executable(${recursive_class_control} "${CMAKE_CURRENT_LIST_DIR}/${recursive_class_control_source}"
        "${recursive_class_c}" "${recursive_class_header}")
    target_include_directories(${recursive_class_control} PRIVATE "${recursive_class_dir}")
    target_link_libraries(${recursive_class_control} PRIVATE xray_xir_source xray_xir_vm)
    list(APPEND recursive_class_targets ${recursive_class_control})
    foreach(target IN LISTS recursive_class_targets)
        target_compile_definitions(${target} PRIVATE XR_TASK_STRUCT_FIXTURE=1 XR_TASK_CLASS_FIXTURE=1 XR_TASK_RECURSIVE_CLASS_FIXTURE=1 XR_TASK_PARAMETER_FIXTURE=1
            ${recursive_class_fixture_macro}="${recursive_class_fixture}" XR_SOURCE_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
    endforeach()
    foreach(backend vm native vm-native native-vm)
        string(REPLACE "-" "_" name "${backend}")
        foreach(mode normal fi)
            add_test(NAME test_xir_task_recursive_class_${flavor}_${name}_${mode}
                COMMAND ${recursive_class_runner} structure ${backend} ${mode})
            set_tests_properties(test_xir_task_recursive_class_${flavor}_${name}_${mode} PROPERTIES
                TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;class")
        endforeach()
        add_test(NAME ${recursive_class_control}_${name} COMMAND ${recursive_class_control} structure ${backend})
        set_tests_properties(${recursive_class_control}_${name} PROPERTIES
            TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;class;cancel")
    endforeach()
endforeach()

