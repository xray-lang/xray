add_executable(test_xir_source_comptime_limits "${CMAKE_CURRENT_LIST_DIR}/test_xir_source_comptime_limits.c")
target_link_libraries(test_xir_source_comptime_limits PRIVATE xray_xir_source xray_xir_vm)
set_target_properties(test_xir_source_comptime_limits PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(MSVC)
    target_compile_options(test_xir_source_comptime_limits PRIVATE /utf-8 /W4 /WX)
else()
    target_compile_options(test_xir_source_comptime_limits PRIVATE -Wall -Wextra -Werror)
endif()
foreach(limit_case IN ITEMS pair array fibonacci empty unit scalar invalid runtime)
    add_test(NAME test_xir_source_comptime_limit_${limit_case} COMMAND test_xir_source_comptime_limits ${limit_case})
    set_tests_properties(test_xir_source_comptime_limit_${limit_case} PROPERTIES TIMEOUT 30 LABELS "unit;xir;source;ctfe;ownership;output")
endforeach()
add_test(NAME test_xir_source_comptime_limits_resources COMMAND test_xir_source_comptime_limits --resources)
set_tests_properties(test_xir_source_comptime_limits_resources PROPERTIES TIMEOUT 600 RUN_SERIAL TRUE
    LABELS "unit;xir;source;ctfe;ownership;output;compiler-fault;resources")
