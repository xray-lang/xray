foreach(backend IN ITEMS 0 1 vm native)
    foreach(close RANGE 0 1)
        foreach(drop RANGE 0 1)
            foreach(shard RANGE 0 27)
                math(EXPR begin "${shard} * 16")
                math(EXPR end "${begin} + 16")
                if(end GREATER 437)
                    set(end 437)
                endif()
                set(name "test_xir_mixed_atomic_runtime_fi_${backend}_${close}_${drop}_${shard}")
                add_test(NAME ${name} COMMAND test_xir_mixed_atomic_resources ${backend} fi ${close} ${drop} ${begin} ${end} 437)
                set_tests_properties(${name} PROPERTIES RUN_SERIAL TRUE PROCESSORS 1 TIMEOUT 120 COST 4
                    LABELS "unit;xir;mixed;atomic;fault-injection;resources;ownership;generated-c")
            endforeach()
        endforeach()
    endforeach()
endforeach()
