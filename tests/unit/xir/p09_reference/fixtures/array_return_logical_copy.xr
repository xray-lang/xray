fn build_reversed() -> Array<i64> {
    var a = [1, 2, 3]
    return a.reverse()
}
var from_dead = build_reversed()
export fn p09Answer() -> i64 {
    var a = [1, 2, 3]
    var result = a.reverse()
    a.push(4)
    result[0] = 9
    var total = 0
    var i = 0
    while (i < 20) {
        var receiver = [1, 2, 3]
        var returned = receiver.reverse()
        total += returned[0]
        i += 1
    }
    return from_dead[0] * 100000 + from_dead[2] * 10000 + len(a) * 1000 +
        len(result) * 100 + a[0] * 10 + result[0] + total
}
