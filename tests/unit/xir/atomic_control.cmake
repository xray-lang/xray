add_executable(test_xir_mixed_atomic_control "${CMAKE_CURRENT_LIST_DIR}/test_xir_mixed_atomic_control.c" "${XIR_MIXED_ATOMIC_C}")
target_link_libraries(test_xir_mixed_atomic_control PRIVATE xray_xir_source xray_xir_cgen xray_xir_vm xray_xir_scalar)
target_compile_definitions(test_xir_mixed_atomic_control PRIVATE
    XR_P20_ATOMIC_RUNTIME_FIXTURES="${XIR_MIXED_ATOMIC_ROOT}/tests/fixtures/xir_p20_atomic_runtime"
