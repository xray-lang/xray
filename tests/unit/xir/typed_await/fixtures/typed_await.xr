enum A { Bad { text: string } }
enum B { Bad }
fn value() -> string { return "owned é\0界" }
fn failOne() throws(A) -> string { throw A.Bad { text: "owned é\0界" } }
fn failUnion(first: bool) throws(A|B) -> i64 {
    if (first) { throw A.Bad { text: "union é\0界" } }
    throw B.Bad
}
export fn awaitNever() throws(Cancelled) -> string {
    var task: Task<string> = go value()
    const first = try await task
    task.cancel()
    task.cancel()
    return try await task
}
export fn awaitOne() throws(A|Cancelled) -> string {
    const task: Task<string,A> = go failOne()
    return try await task
}
export fn awaitUnion(first: bool) throws(A|B|Cancelled) -> i64 {
    const task: Task<i64,A|B> = go failUnion(first)
    return try await task
}
fn spinning() -> i64 {
    defer { print("child-cleanup") }
    while (true) { Coro.yield() }
    return 7
}
export fn childCancellation() -> i64 {
    var task: Task<i64> = go spinning()
    task.cancel()
    task.cancel()
    var caught = 0
    try { const ignored = try await task } catch (e: Cancelled) { caught += 1 }
    try { const ignored = try await task } catch (e: Cancelled) { caught += 1 }
    return caught
}
export fn cancelledError() throws(Cancelled) -> i64 {
    var task = go spinning()
    task.cancel()
    return try await task
}
export fn ownCancellation() -> i64 {
    var task = go spinning()
    defer { print("parent-cleanup"); task.cancel() }
    try { return try await task }
    catch (e: Cancelled) { print("caught-own"); return -1 }
}
export fn independentParent() -> i64 {
    defer { print("parent-cleanup") }
    const task = go spinning()
    try { return try await task }
    catch (e: Cancelled) { print("caught-own"); return -1 }
}

print(childCancellation())
print(try awaitNever())
try { print(try awaitOne()) } catch (e: A) { print("one-error") }
try { print(try awaitUnion(true)) } catch (e: A) { print("union-a") } catch (e: B) { print("wrong-b") }
try { print(try awaitUnion(false)) } catch (e: A) { print("wrong-a") } catch (e: B) { print("union-b") }
