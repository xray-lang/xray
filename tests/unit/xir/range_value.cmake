set(XR_RANGE_VALUE_SOURCE_PACKET "${CMAKE_CURRENT_BINARY_DIR}/generated/range-source.chk")
set(XR_RANGE_VALUE_CATALOG_PACKET "${CMAKE_CURRENT_BINARY_DIR}/generated/range-catalog.chk")
add_custom_command(OUTPUT "${XR_RANGE_VALUE_SOURCE_PACKET}" "${XR_RANGE_VALUE_CATALOG_PACKET}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
    COMMAND $<TARGET_FILE:test_xir_range_value> "${XR_RANGE_VALUE_SOURCE_PACKET}" "${XR_RANGE_VALUE_CATALOG_PACKET}"
    DEPENDS test_xir_range_value VERBATIM)
add_executable(test_xir_range_value_packet "${CMAKE_CURRENT_LIST_DIR}/test_xir_range_value_execution.c")
target_compile_definitions(test_xir_range_value_packet PRIVATE RANGE_CONSUMER_KIND=0)
