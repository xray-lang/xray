file(MAKE_DIRECTORY "${XR_RANGE_VALUE_WORK}")
target_compile_definitions(test_xir_range_value PRIVATE XR_RANGE_VALUE_WORK="${XR_RANGE_VALUE_WORK}"
    XR_RANGE_VALUE_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
set_target_properties(test_xir_range_value PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
