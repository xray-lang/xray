foreach(range_flow IN ITEMS source catalog)
    if(range_flow STREQUAL "source")
        set(range_packet "${XR_RANGE_VALUE_SOURCE_PACKET}")
    else()
        set(range_packet "${XR_RANGE_VALUE_CATALOG_PACKET}")
    endif()
    set(range_c "${CMAKE_CURRENT_BINARY_DIR}/generated/range-${range_flow}.c")
    add_custom_command(OUTPUT "${range_c}"
        COMMAND $<TARGET_FILE:test_xir_range_value_packet> "${range_packet}" "${range_c}"
        DEPENDS test_xir_range_value_packet "${range_packet}" VERBATIM)
    add_test(NAME test_xir_range_value_${range_flow}_vm COMMAND test_xir_range_value_packet
        "${range_packet}" "${XR_RANGE_VALUE_WORK}/${range_flow}-vm.c")
    foreach(range_mode IN ITEMS native vm_native native_vm)
        set(range_target test_xir_range_value_${range_flow}_${range_mode})
        add_executable(${range_target} "${CMAKE_CURRENT_LIST_DIR}/test_xir_range_value_execution.c" "${range_c}")
        target_link_libraries(${range_target} PRIVATE xray_xir_vm)
        if(range_mode STREQUAL "native")
            target_compile_definitions(${range_target} PRIVATE RANGE_CONSUMER_KIND=1)
        elseif(range_mode STREQUAL "vm_native")
            target_compile_definitions(${range_target} PRIVATE RANGE_CONSUMER_KIND=4)
        else()
            target_compile_definitions(${range_target} PRIVATE RANGE_CONSUMER_KIND=2)
        endif()
        target_compile_definitions(${range_target} PRIVATE XR_RANGE_VALUE_PACKET="${range_packet}")
        list(APPEND XR_RANGE_VALUE_TARGETS ${range_target})
        add_test(NAME ${range_target} COMMAND ${range_target})
    endforeach()
    set_tests_properties(test_xir_range_value_${range_flow}_vm test_xir_range_value_${range_flow}_native
        test_xir_range_value_${range_flow}_vm_native test_xir_range_value_${range_flow}_native_vm
        PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "unit;xir;range;library;ownership;native;mixed;abi")
endforeach()
