set(P09_GRAPH_BASELINE "${CMAKE_BINARY_DIR}/graph-baseline/xir")
file(MAKE_DIRECTORY "${P09_GRAPH_BASELINE}")
foreach(name xxir_value.c xxir_value_graph_control.inc.c xxir_value_graph_retire.inc.c)
    execute_process(COMMAND git show "e299ccfd940b998df473cb65cca6ff179250d4e4:src/xir/${name}"
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_FILE "${P09_GRAPH_BASELINE}/${name}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()
foreach(variant current baseline)
    set(target "test_xir_p09_graph_idle_${variant}")
    add_executable(${target} "${PROJECT_SOURCE_DIR}/tests/unit/xir/test_xir_p09_graph_idle.c")
    if(variant STREQUAL "baseline")
        target_include_directories(${target} BEFORE PRIVATE "${CMAKE_BINARY_DIR}/graph-baseline" "${PROJECT_SOURCE_DIR}/src/xir")
    endif()
    target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/src/base")
    target_link_libraries(${target} PRIVATE xray_xir_scalar)
    if(WIN32)
        target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/os/win/thread_win.c")
    else()
        target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/os/unix/thread_unix.c")
        target_link_libraries(${target} PRIVATE Threads::Threads)
    endif()
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
