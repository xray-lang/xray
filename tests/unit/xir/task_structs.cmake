foreach(flavor results errors)
    if(flavor STREQUAL "results")
        set(struct_group constructed)
        set(struct_fixture_macro XR_TASK_CONSTRUCTED_FIXTURES)
        set(struct_runner_source test_xir_task_constructed_results.c)
    else()
        set(struct_group closed_error)
        set(struct_fixture_macro XR_TASK_CLOSED_ERROR_FIXTURES)
        set(struct_runner_source test_xir_task_closed_error_resources.c)
    endif()
    set(struct_dir "${CMAKE_CURRENT_BINARY_DIR}/task-struct-${flavor}")
    set(struct_fixture "${PROJECT_SOURCE_DIR}/tests/fixtures/xir_p08_task_struct_${flavor}")
    set(struct_c "${struct_dir}/task_${struct_group}_native.c")
    set(struct_header "${struct_dir}/task_${struct_group}_generated.h")
    set(struct_emit test_xir_task_struct_${flavor}_emit)
    set(struct_runner test_xir_task_struct_${flavor})
    add_executable(${struct_emit} "${CMAKE_CURRENT_LIST_DIR}/test_xir_task_${struct_group}_emit.c")
    target_link_libraries(${struct_emit} PRIVATE xray_xir_source xray_xir_cgen xray_xir_vm)
    add_custom_command(OUTPUT "${struct_c}" "${struct_header}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${struct_dir}"
        COMMAND ${struct_emit} "${struct_c}" "${struct_header}"
        DEPENDS ${struct_emit} "${struct_fixture}/root.xr" VERBATIM)
    add_executable(${struct_runner} "${CMAKE_CURRENT_LIST_DIR}/${struct_runner_source}" "${struct_c}" "${struct_header}")
    target_include_directories(${struct_runner} PRIVATE "${struct_dir}")
    target_link_libraries(${struct_runner} PRIVATE xray_xir_source xray_xir_vm)
    set(struct_targets ${struct_emit} ${struct_runner})
    if(flavor STREQUAL "results")
        set(struct_control test_xir_task_struct_control)
        set(struct_control_source test_xir_task_constructed_control.c)
    else()
        set(struct_control test_xir_task_struct_error_control)
        set(struct_control_source test_xir_task_closed_error_control.c)
    endif()
    add_executable(${struct_control} "${CMAKE_CURRENT_LIST_DIR}/${struct_control_source}"
        "${struct_c}" "${struct_header}")
    target_include_directories(${struct_control} PRIVATE "${struct_dir}")
    target_link_libraries(${struct_control} PRIVATE xray_xir_source xray_xir_vm)
    list(APPEND struct_targets ${struct_control})
    foreach(target IN LISTS struct_targets)
        target_compile_definitions(${target} PRIVATE XR_TASK_STRUCT_FIXTURE=1 XR_TASK_PARAMETER_FIXTURE=1
            ${struct_fixture_macro}="${struct_fixture}" XR_SOURCE_STDLIB="${PROJECT_SOURCE_DIR}/stdlib")
        if(MSVC)
            target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        endif()
    endforeach()
    foreach(backend vm native vm-native native-vm)
        string(REPLACE "-" "_" name "${backend}")
        foreach(mode normal fi)
            add_test(NAME test_xir_task_struct_${flavor}_${name}_${mode}
                COMMAND ${struct_runner} structure ${backend} ${mode})
            set_tests_properties(test_xir_task_struct_${flavor}_${name}_${mode} PROPERTIES
                TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;struct")
        endforeach()
        add_test(NAME ${struct_control}_${name} COMMAND ${struct_control} structure ${backend})
        set_tests_properties(${struct_control}_${name} PROPERTIES
            TIMEOUT 60 LABELS "unit;xir;task;ownership;runtime;generated-c;parameters;struct;cancel")
    endforeach()
endforeach()
