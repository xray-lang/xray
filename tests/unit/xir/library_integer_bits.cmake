add_executable(test_xir_library_integer_bits_source "${CMAKE_CURRENT_LIST_DIR}/test_xir_library_integer_bits_source.c")
target_link_libraries(test_xir_library_integer_bits_source PRIVATE xray_xir_source xray_xir_vm)
set(XR_LIBRARY_INTEGER_BITS_WORK "${CMAKE_CURRENT_BINARY_DIR}/library-integer-bits-work")
file(MAKE_DIRECTORY "${XR_LIBRARY_INTEGER_BITS_WORK}")
target_compile_definitions(test_xir_library_integer_bits_source PRIVATE XR_LIBRARY_INTEGER_BITS_WORK="${XR_LIBRARY_INTEGER_BITS_WORK}")
set(XR_LIBRARY_INTEGER_BITS_PACKET "${CMAKE_CURRENT_BINARY_DIR}/generated/library-integer-bits.chk")
add_custom_command(OUTPUT "${XR_LIBRARY_INTEGER_BITS_PACKET}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
    COMMAND $<TARGET_FILE:test_xir_library_integer_bits_source> "${XR_LIBRARY_INTEGER_BITS_PACKET}"
    DEPENDS test_xir_library_integer_bits_source VERBATIM)
add_executable(test_xir_library_integer_bits_packet "${CMAKE_CURRENT_LIST_DIR}/test_xir_library_integer_bits_execution.c")
target_link_libraries(test_xir_library_integer_bits_packet PRIVATE xray_xir_vm xray_xir_cgen)
target_compile_definitions(test_xir_library_integer_bits_packet PRIVATE BITS_CONSUMER_KIND=0)
set(bits_c "${CMAKE_CURRENT_BINARY_DIR}/generated/library-integer-bits.c")
add_custom_command(OUTPUT "${bits_c}"
    COMMAND $<TARGET_FILE:test_xir_library_integer_bits_packet> "${XR_LIBRARY_INTEGER_BITS_PACKET}" "${bits_c}"
    DEPENDS test_xir_library_integer_bits_packet "${XR_LIBRARY_INTEGER_BITS_PACKET}" VERBATIM)
set(bits_targets test_xir_library_integer_bits_source test_xir_library_integer_bits_packet)
add_test(NAME test_xir_library_integer_bits_source COMMAND test_xir_library_integer_bits_source)
add_test(NAME test_xir_library_integer_bits_packet COMMAND test_xir_library_integer_bits_packet
    "${XR_LIBRARY_INTEGER_BITS_PACKET}" "${XR_LIBRARY_INTEGER_BITS_WORK}/packet.c")
foreach(bits_mode IN ITEMS native vm_native native_vm)
    set(bits_target test_xir_library_integer_bits_${bits_mode})
    add_executable(${bits_target} "${CMAKE_CURRENT_LIST_DIR}/test_xir_library_integer_bits_execution.c" "${bits_c}")
    target_link_libraries(${bits_target} PRIVATE xray_xir_vm)
    if(bits_mode STREQUAL "native")
        target_compile_definitions(${bits_target} PRIVATE BITS_CONSUMER_KIND=1)
    elseif(bits_mode STREQUAL "vm_native")
        target_compile_definitions(${bits_target} PRIVATE BITS_CONSUMER_KIND=4)
    else()
        target_compile_definitions(${bits_target} PRIVATE BITS_CONSUMER_KIND=2)
    endif()
    target_compile_definitions(${bits_target} PRIVATE XR_LIBRARY_INTEGER_BITS_PACKET="${XR_LIBRARY_INTEGER_BITS_PACKET}")
    list(APPEND bits_targets ${bits_target})
    add_test(NAME ${bits_target} COMMAND ${bits_target})
endforeach()
foreach(bits_target IN LISTS bits_targets)
    set_target_properties(${bits_target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${bits_target} PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(${bits_target} PRIVATE -Wall -Wextra -Werror)
    endif()
    set_tests_properties(${bits_target} PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "unit;xir;library;ownership;native;mixed;abi")
endforeach()
