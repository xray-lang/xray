if(NOT TARGET test_xir_mixed_forin_resources)
    message(FATAL_ERROR "The authentic for-in resource consumer must exist before registering allocation ordinals")
endif()

set(xir_forin_resource_normal_sites 54 54 48 66 52 56 66 52 72 58 66 60)
foreach(backend IN ITEMS 0 1 vm native)
    foreach(scenario RANGE 0 11)
        list(GET xir_forin_resource_normal_sites ${scenario} sites)
        math(EXPR last "${sites} - 1")
        foreach(close RANGE 0 1)
            foreach(drop RANGE 0 1)
                foreach(begin RANGE 0 ${last} 16)
                    math(EXPR end "${begin} + 16")
                    if(end GREATER sites)
                        set(end ${sites})
                    endif()
                    set(name test_xir_mixed_forin_runtime_fi_${backend}_${scenario}_${close}_${drop}_${begin}_${end})
                    add_test(NAME ${name} COMMAND test_xir_mixed_forin_resources
                        ${backend} fi ${scenario} 3 0 ${close} ${drop} ${begin} ${end} ${sites})
                    set_tests_properties(${name} PROPERTIES TIMEOUT 120 RUN_SERIAL TRUE PROCESSORS 1 COST 5
                        LABELS "unit;xir;mixed;ownership;generated-c;lifecycle;generator;iterator;forin;resource;fi")
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endforeach()
