if(NOT TARGET test_xir_mixed_forin_resources)
    message(FATAL_ERROR "The authentic for-in resource consumer must exist before registering its cases")
endif()

function(xir_forin_resource_case name cost)
    add_test(NAME ${name} COMMAND test_xir_mixed_forin_resources ${ARGN})
    set_tests_properties(${name} PROPERTIES TIMEOUT 120 PROCESSORS 1 COST ${cost}
        LABELS "unit;xir;mixed;ownership;generated-c;lifecycle;generator;iterator;forin;resource")
endfunction()

set(xir_forin_resource_polls 52 88 50 95 66 64 118 102 130 129 116 143)
foreach(backend IN ITEMS 0 1 vm native)
    xir_forin_resource_case(test_xir_mixed_forin_resources_${backend}_census 10 ${backend} census)
    xir_forin_resource_case(test_xir_mixed_forin_resources_${backend}_early_work 10 ${backend} early-work)
    foreach(scenario RANGE 0 11)
        list(GET xir_forin_resource_polls ${scenario} last)
        math(EXPR end_exclusive "${last} + 1")
        foreach(close RANGE 0 1)
            foreach(drop RANGE 0 1)
                xir_forin_resource_case(test_xir_mixed_forin_resources_${backend}_normal_${scenario}_${close}_${drop}_axes 5
                    ${backend} axes ${scenario} 3 0 ${close} ${drop})
                foreach(mode RANGE 0 2)
                    set(base test_xir_mixed_forin_resources_${backend}_control_${scenario}_${mode}_${close}_${drop})
                    xir_forin_resource_case(${base}_baseline 25 ${backend} suite ${scenario} ${mode} ${last} ${close} ${drop})
                    foreach(begin RANGE 0 ${last} 4)
                        math(EXPR end "${begin} + 4")
                        if(end GREATER end_exclusive)
                            set(end ${end_exclusive})
                        endif()
                        xir_forin_resource_case(${base}_${begin}_${end}_axes 10
                            ${backend} range-axes ${scenario} ${mode} ${last} ${close} ${drop} ${begin} ${end})
                    endforeach()
                endforeach()
            endforeach()
        endforeach()
    endforeach()
endforeach()
