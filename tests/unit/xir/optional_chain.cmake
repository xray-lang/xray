add_executable(test_xir_optional_chain xir/test_xir_optional_chain.c)
target_link_libraries(test_xir_optional_chain PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
set(optional_chain_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/optional_chain.c")
add_custom_command(OUTPUT "${optional_chain_generated}"
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
    COMMAND $<TARGET_FILE:test_xir_optional_chain> "${optional_chain_generated}"
    DEPENDS test_xir_optional_chain VERBATIM)
add_executable(test_xir_optional_chain_native xir/test_xir_optional_chain_native.c "${optional_chain_generated}")
target_link_libraries(test_xir_optional_chain_native PRIVATE xray_xir_scalar)
foreach(target test_xir_optional_chain test_xir_optional_chain_native)
    set_target_properties(${target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror -pedantic-errors)
    endif()
endforeach()
add_test(NAME xir_optional_chain COMMAND test_xir_optional_chain)
add_test(NAME xir_optional_chain_native COMMAND test_xir_optional_chain_native)
set_tests_properties(xir_optional_chain xir_optional_chain_native PROPERTIES TIMEOUT 120 LABELS "unit;xir;source;ownership;generated-c")
