add_executable(xir_source_history_class_producer "${CMAKE_CURRENT_LIST_DIR}/source_history_class_native_producer.c")
target_link_libraries(xir_source_history_class_producer PRIVATE xray_xir_source xray_xir_vm xray_xir_cgen)
set_target_properties(xir_source_history_class_producer PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(MSVC)
    target_compile_definitions(xir_source_history_class_producer PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_compile_options(xir_source_history_class_producer PRIVATE /W4 /WX /utf-8)
else()
    target_compile_options(xir_source_history_class_producer PRIVATE -Wall -Wextra -Werror)
endif()
foreach(shape IN ITEMS normal shift_var)
    set(class_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/history_class_${shape}")
    set(class_header "${class_dir}/source_history_class_${shape}_generated.h")
    set(class_sources)
    foreach(generation RANGE 1 4)
        list(APPEND class_sources "${class_dir}/source_history_class_${shape}_${generation}.c")
    endforeach()
    add_custom_command(OUTPUT ${class_sources} "${class_header}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${class_dir}"
        COMMAND $<TARGET_FILE:xir_source_history_class_producer> "${class_dir}" ${shape}
        DEPENDS xir_source_history_class_producer "${CMAKE_CURRENT_LIST_DIR}/source_history_class_fixture.h"
        VERBATIM)
    add_library(history_class_native_${shape} STATIC ${class_sources} "${class_header}")
    target_link_libraries(history_class_native_${shape} PRIVATE xray_xir_scalar)
    set_target_properties(history_class_native_${shape} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(history_class_native_${shape} PRIVATE /W4 /WX /utf-8)
    else()
        target_compile_options(history_class_native_${shape} PRIVATE -Wall -Wextra -Werror)
    endif()
    foreach(backend IN ITEMS native vm_native native_vm)
        set(class_target test_xir_source_history_class_${backend}_${shape})
        add_executable(${class_target} "${CMAKE_CURRENT_LIST_DIR}/test_xir_source_history_class.c" "${class_header}")
        target_include_directories(${class_target} PRIVATE "${class_dir}")
        target_link_libraries(${class_target} PRIVATE xray_xir_source xray_xir_vm history_class_native_${shape})
        target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_NATIVE=1)
        if(shape STREQUAL "normal")
            target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_KIND=0)
            set(class_argument)
        else()
            target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_KIND=2)
            set(class_argument --shift-var)
        endif()
        if(backend STREQUAL "native")
            target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_OLD_VM=0 XR_HISTORY_CLASS_NEW_VM=0)
        elseif(backend STREQUAL "vm_native")
            target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_OLD_VM=1 XR_HISTORY_CLASS_NEW_VM=0)
        else()
            target_compile_definitions(${class_target} PRIVATE XR_HISTORY_CLASS_OLD_VM=0 XR_HISTORY_CLASS_NEW_VM=1)
        endif()
        set_target_properties(${class_target} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(MSVC)
            target_compile_options(${class_target} PRIVATE /W4 /WX /utf-8)
        else()
            target_compile_options(${class_target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${class_target} COMMAND ${class_target} ${class_argument})
        set_tests_properties(${class_target} PROPERTIES TIMEOUT 60 LABELS "unit;xir;source;history;class;ownership;native;mixed")
    endforeach()
endforeach()
