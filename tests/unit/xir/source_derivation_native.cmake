set(XIR_SOURCE_DERIVE_C "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_source_derivation.c")
set(XIR_SOURCE_DERIVE_PACKET "${CMAKE_CURRENT_BINARY_DIR}/generated/xir_source_derivation.chk")
add_test(NAME test_xir_source_derivation_runtime_resources COMMAND test_xir_source_derivation_mixed --vm-runtime-resources)
set_tests_properties(test_xir_source_derivation_runtime_resources PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "unit;xir;source;generated;ownership;runtime-fault;resources")
add_custom_command(OUTPUT ${XIR_SOURCE_DERIVE_C} ${XIR_SOURCE_DERIVE_PACKET}
    COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
    COMMAND $<TARGET_FILE:test_xir_source_derivation> --emit-native ${XIR_SOURCE_DERIVE_C} ${XIR_SOURCE_DERIVE_PACKET}
    DEPENDS test_xir_source_derivation VERBATIM)
add_executable(test_xir_source_derivation_native "${CMAKE_CURRENT_LIST_DIR}/test_xir_source_derivation_native.c" ${XIR_SOURCE_DERIVE_C})
target_link_libraries(test_xir_source_derivation_native PRIVATE xray_xir_scalar)
add_executable(test_xir_source_derivation_mixed "${CMAKE_CURRENT_LIST_DIR}/test_xir_source_derivation_mixed.c" ${XIR_SOURCE_DERIVE_C})
target_link_libraries(test_xir_source_derivation_mixed PRIVATE xray_xir_vm)
target_compile_definitions(test_xir_source_derivation_mixed PRIVATE XR_SOURCE_DERIVATION_PACKET="${XIR_SOURCE_DERIVE_PACKET}")
foreach(derive_test IN ITEMS test_xir_source_derivation_native test_xir_source_derivation_mixed)
    set_target_properties(${derive_test} PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${derive_test} PRIVATE /utf-8 /W4 /WX)
    else()
        target_compile_options(${derive_test} PRIVATE -Wall -Wextra -Werror)
    endif()
    add_test(NAME ${derive_test} COMMAND ${derive_test})
    set_tests_properties(${derive_test} PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "unit;xir;source;ctfe;generated;library;ownership;execution;abi")
    add_test(NAME ${derive_test}_runtime_resources COMMAND ${derive_test} --runtime-resources)
    set_tests_properties(${derive_test}_runtime_resources PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE LABELS "unit;xir;source;generated;ownership;runtime-fault;resources")
endforeach()
