fn edit(values:ref Array<i64>)->i64 {
    const before:Array<i64>=values
    const incoming:Array<i64>=[100,13]
    const empty:Array<i64>=[]
    const right:i64=17
    print(values[0])
    print(before[0])
    print(incoming[1])
    return values[0]+values[1]
}
fn observe(value:ref i64)->i64 { return value }
fn run() {
    var root:Array<i64>=[11,13]
    print(observe(ref root[0]))
    print(edit(ref root))
    print(root[0])
    print(root[1])
}
run()
