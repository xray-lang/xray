struct RefRecord { values:Array<i64>; sibling:i64 }
fn edit(values:ref Array<i64>)->i64 {
    const before:Array<i64>=values
    const incoming:Array<i64>=[100,13]
    const right:i64=17
    print(values[0])
    print(before[0])
    print(incoming[1])
    return values[0]+values[1]
}
fn run() {
    var root:Array<RefRecord>=[RefRecord{values:[11,13],sibling:37}]
    const saved:Array<RefRecord>=root
    print(edit(ref root[0].values))
    print(root[0].values[0])
    print(root[0].sibling)
    print(saved[0].values[0])
}
run()
