string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(dump_dir "${OUTPUT_ROOT}/backend-ice-${nonce}")
file(MAKE_DIRECTORY "${dump_dir}")
set(expected "${dump_dir}/expected-malformed.c")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "XRAY_CGEN_ICE_DIR=${dump_dir}"
    "${PROGRAM}" --ice "${expected}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
if(result STREQUAL "0" OR result STREQUAL "86")
    message(FATAL_ERROR "Emission returned after malformed generated C: ${result}")
endif()
if(NOT stderr MATCHES "\\[xi_cgen\\]\\[ICE\\]" OR NOT stderr MATCHES "W1_BALANCE" OR NOT stderr MATCHES "translation unit : backend")
    message(FATAL_ERROR "Missing actual emitter fatal boundary: ${result}; ${stderr}")
endif()
if(stderr MATCHES "ERROR: AddressSanitizer|runtime error:|UndefinedBehaviorSanitizer")
    message(FATAL_ERROR "Sanitizer failed before mandatory ICE: ${stderr}")
endif()
file(GLOB dumps "${dump_dir}/xray_cgen_ice_backend_*.c")
list(LENGTH dumps count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one actual backend full source dump: ${dumps}")
endif()
list(GET dumps 0 dump)
file(SHA256 "${dump}" actual_digest)
file(SHA256 "${expected}" expected_digest)
if(NOT actual_digest STREQUAL expected_digest)
    message(FATAL_ERROR "ICE did not preserve every emitted byte")
endif()
file(SIZE "${dump}" dump_size)
if(dump_size LESS 4096)
    message(FATAL_ERROR "Actual generated translation unit was not dumped completely")
endif()
message(STATUS "Actual emission malformed ICE preserved ${dump_size} bytes: ${dump}")
