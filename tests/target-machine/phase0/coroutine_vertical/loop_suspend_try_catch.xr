fn worker() -> int {
    defer {
        try {
            var zero = 0
            print(1 / zero)
        } catch panic (p) {
            print("caught-cleanup-panic")
        }
    }

    var sum = 0
    for (var i = 0; i < 3; i++) {
        Coro.yield()
        sum = sum + i
    }
    return sum
}

print(await go worker())
