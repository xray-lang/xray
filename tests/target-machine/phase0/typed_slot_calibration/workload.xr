// Independent Xray oracle for the disposable typed-slot calibration.
class Cell {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

fn addOne(value: i64) -> i64 {
    return value + 1
}

fn run(iterations: i64) -> i64 {
    var array: Array<i64> = [1, 2, 3, 4]
    var table: Map<i64, i64> = #{}
    table.set(3, 30)
    table.set(5, 50)
    table.set(7, 70)

    var total = 0
    var iteration = 0
    while (iteration < iterations) {
        var counter = 0
        var sum = 0
        while (counter < 8) {
            sum = sum + counter
            counter = counter + 1
        }
        sum = sum + array[0] + array[1] + array[2] + array[3]
        sum = sum + (table.get(5) ?? 0)
        var cell = Cell(sum)
        total = total + addOne(cell.value)
        iteration = iteration + 1
    }
    return total
}

print(run(20000))
