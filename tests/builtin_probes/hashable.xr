class Token implements Hashable {
    value: i64
    constructor(value: i64) { this.value = value }
    operator==(other: Token) -> bool { return this.value == other.value }
    hash() -> i64 { return this.value }
}
fn keyed<K: Hashable>(m: Map<K, i64>) -> i64 { return len(m) }
var m: Map<Token, i64> = #{}
m.set(Token(1), 9)
print(keyed(m))
