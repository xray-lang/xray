fn runtime_only_value() -> i64 {
    return 99
}

fn runtime_only_string() -> string {
    return "runtime"
}

@test
fn test_comptime_float_numeric_ops() {
    var sum = comptime (1.5 + 2.5)
    assertEqual(sum, 4.0)

    var mixed = comptime ((1 as f64) + 2.5 * 2)
    assertEqual(mixed, 6.0)

    var neg = comptime -1.5
    assertEqual(neg, -1.5)

    var div = comptime ((5 as f64) / 2.0)
    assertEqual(div, 2.5)
}

@test
fn test_comptime_numeric_text_and_char_comparisons() {
    assertEqual(comptime ((1 as f64) == 1.0), true)
    assertEqual(comptime (3.5 > (2 as f64)), true)
    assertEqual(comptime ("abc" < "abd"), true)
    assertEqual(comptime ('b' == 'b'), true)
}

@test
fn test_comptime_ternary_evaluates_only_selected_branch() {
    var picked = comptime (true ? 7 : runtime_only_value())
    assertEqual(picked, 7)

    const LEN = comptime ((1.5 < 2.5) ? 4 : runtime_only_value())
    var arr: [i64; LEN] = [3; LEN]
    assertEqual(len(arr), 4)
    assertEqual(arr[3], 3)
}

@test
fn test_comptime_nullish_coalesce_evaluates_only_selected_branch() {
    var fallback = comptime (null ?? "fallback")
    assertEqual(fallback, "fallback")

    var kept = comptime ("value" ?? runtime_only_string())
    assertEqual(kept, "value")
}
