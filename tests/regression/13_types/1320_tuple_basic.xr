// 作者：xingleixu@gmail.com
// 测试：tuple 字面量、字段访问、解构、函数返回，跨多个调用边界

@test
fn test_tuple_literal_and_field() {
    var t = (1, 2, 3)
    assertEqual(t.0, 1)
    assertEqual(t.1, 2)
    assertEqual(t.2, 3)
}

@test
fn test_tuple_heterogeneous() {
    var t = (10, "hi", true)
    assertEqual(t.0, 10)
    assertEqual(t.1, "hi")
    assertEqual(t.2, true)
}

@test
fn test_tuple_destructure() {
    var pair = (42, "hello")
    var (a, b) = pair
    assertEqual(a, 42)
    assertEqual(b, "hello")
}

fn make_pair() -> (i64, string) {
    return (7, "ok")
}

@test
fn test_tuple_function_return_field_access() {
    var r = make_pair()
    assertEqual(r.0, 7)
    assertEqual(r.1, "ok")
}

@test
fn test_tuple_function_return_destructure() {
    var (n, s) = make_pair()
    assertEqual(n, 7)
    assertEqual(s, "ok")
}

@test
fn test_tuple_nested_field_access() {
    // Tuples can contain tuples; .N is still constant-time per level.
    var t = ((1, 2), (3, 4))
    assertEqual(t.0.0, 1)
    assertEqual(t.0.1, 2)
    assertEqual(t.1.0, 3)
    assertEqual(t.1.1, 4)
}

@test
fn test_tuple_unary() {
    // Single-element tuple is structurally distinct from a scalar.
    var t = (99,)
    assertEqual(t.0, 99)
}
