class Holder {
    items: Array<Array<i64>>

    constructor() {
        this.items = []
    }

    ref outer(value: Array<i64>) {
        this.middle(value)
    }

    ref middle(value: Array<i64>) {
        this.store(value)
    }

    ref store(value: Array<i64>) {
        this.items.push(value)
    }
}

fn stash(data: Array<i64>, holder: ref Holder) {
    holder.outer(data)
}

var values: Array<i64> = [1, 2]
var holder = Holder()
stash(values, ref holder)
