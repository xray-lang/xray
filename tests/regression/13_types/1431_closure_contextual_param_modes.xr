@test
fn test_closure_contextual_ref_out_modes() {
    var bump: fn(ref i64) -> i64 = fn(x) -> i64 {
        x = x + 1
        return x
    }

    var fill: fn(ref i64) -> i64 = fn(x) -> i64 {
        x = 42
        return 7
    }

    var value = 1
    assertEqual(bump(ref value), 2)
    assertEqual(fill(ref value), 7)
}
