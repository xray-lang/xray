@test
fn test_closure_contextual_ref_out_modes() {
    var bump: (ref int) -> int = fn(x) -> int {
        x = x + 1
        return x
    }

    var fill: (out int) -> int = fn(x) -> int {
        x = 42
        return 7
    }

    var value = 1
    assert_eq(bump(ref value), 2)
    assert_eq(fill(out value), 7)
}
