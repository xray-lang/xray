const BLOCK_LEN = comptime {
    var n = comptime 1
    while (n < 4) {
        n += 1
    }
    return n
}

@test
fn test_comptime_block_fixed_array_length() {
    var direct: [int; comptime { return 3 }] = [1, 2, 3]
    assert_eq(len(direct), 3)

    var named: [int; BLOCK_LEN] = [1, 2, 3, 4]
    assert_eq(len(named), 4)
}
