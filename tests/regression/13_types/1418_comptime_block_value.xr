fn runtimeOnlyInt() -> i64 {
    return 99
}

struct BlockPoint {
    x: i64
    y: i64
}

struct BlockBox {
    p: BlockPoint
    tag: i64
}

const BLOCK_SUM = comptime {
    var total = comptime 0
    for (var i = 0; i < 5; i += 1) {
        total += i
    }
    return total
}

const BLOCK_TEXT = comptime {
    if (BLOCK_SUM == 10) {
        return "ok"
    }
    return runtimeOnlyInt()
}

const BLOCK_LOCAL = comptime {
    var n = comptime 1
    while (n < 4) {
        n += 1
    }
    return n
}

const BLOCK_TUPLE = comptime {
    var base = comptime 10
    return (base, base + 1, "block")
}

const BLOCK_TABLE: [i64; 3] = comptime {
    var base = comptime 5
    const values: [i64; 3] = comptime [base, base + 1, base + 2]
    return values
}

const BLOCK_POINT = comptime {
    var y = comptime 4
    return BlockPoint{x: 3, y: y}
}

@test
fn test_comptime_block_returns_scalar_value() {
    assertEqual(BLOCK_SUM, 10)
    assertEqual(BLOCK_TEXT, "ok")

    var local = comptime {
        var value = comptime 2
        value *= 6
        return value
    }
    assertEqual(local, 12)

    assertEqual(BLOCK_LOCAL, 4)
}

@test
fn test_comptime_block_returns_tuple_value() {
    var runtime = comptime {
        var base = comptime 20
        return (base, base + 2, "runtime")
    }
    assertEqual(runtime.0, 20)
    assertEqual(runtime.1, 22)
    assertEqual(runtime.2, "runtime")

    var picked = comptime (BLOCK_TUPLE.0 + BLOCK_TUPLE.1)
    assertEqual(picked, 21)
    assertEqual(BLOCK_TUPLE.2, "block")
}

@test
fn test_comptime_block_returns_fixed_array_value() {
    var runtime: [i64; 3] = copy(comptime {
        var base = comptime 30
        const values: [i64; 3] = comptime [base, base + 1, base + 2]
        return values
    })
    assertEqual(runtime[0], 30)
    assertEqual(runtime[1], 31)
    assertEqual(runtime[2], 32)

    var picked = comptime (BLOCK_TABLE[0] + BLOCK_TABLE[2])
    assertEqual(picked, 12)
}

@test
fn test_comptime_block_returns_struct_value() {
    var point = comptime {
        var x = comptime 7
        return BlockPoint{x: x, y: BLOCK_SUM}
    }
    assertEqual(point.x, 7)
    assertEqual(point.y, 10)

    var nested = comptime {
        const inner = comptime BlockPoint{x: BLOCK_POINT.x, y: BLOCK_POINT.y + 1}
        return BlockBox{p: inner, tag: BLOCK_SUM + 1}
    }
    assertEqual(nested.p.x, 3)
    assertEqual(nested.p.y, 5)
    assertEqual(nested.tag, 11)
}
