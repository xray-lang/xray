class Holder {
    items: Array<Array<i64>>

    constructor() {
        this.items = []
    }

    stash(value: Array<i64>) {
        this.items.push(value)
    }
}

fn stash(data: Array<i64>, holder: ref Holder) {
    holder.stash(data)
}

var values: Array<i64> = [1, 2, 3]
var holder = Holder()
stash(values, ref holder)
