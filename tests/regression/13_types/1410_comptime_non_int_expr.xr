const ALWAYS = comptime (1 < 2)
const GREETING = comptime "hi"
const LETTER = comptime 'x'
const TYPE_INT_ID = comptime Type.i64
const TYPE_BOOL_ID = comptime Type.bool

@test
fn test_comptime_bool_string_char_expr() {
    var flag = comptime (ALWAYS && (GREETING == "hi"))
    assertEqual(flag, true)
    assertEqual(GREETING, "hi")
    assertEqual(LETTER, 'x')
}

@test
fn test_comptime_typeid_constants() {
    var ids: [i64; TYPE_BOOL_ID] = [TYPE_INT_ID; TYPE_BOOL_ID]
    assertEqual(len(ids), 1)
    assertEqual(ids[0], TYPE_INT_ID)
    assertEqual(TYPE_INT_ID == TYPE_BOOL_ID, false)
}
