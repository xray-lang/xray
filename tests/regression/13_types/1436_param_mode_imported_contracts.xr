import {
    bumpRef,
    bumpRefValue,
    fillOut,
    fillOutValue,
} from "../../fixtures/param_mode_import_lib"
import "../../fixtures/param_mode_import_lib" as param_mode

@test
fn test_selective_import_ref_out_contracts() {
    var value = 1
    assertEqual(bumpRef(ref value), 2)
    assertEqual(value, 2)

    var slot = 0
    assertEqual(fillOut(ref slot), 9)
    assertEqual(slot, 9)
}

@test
fn test_namespace_import_ref_out_contracts() {
    var value = 3
    assertEqual(param_mode.bumpRef(ref value), 4)
    assertEqual(value, 4)

    var slot = 0
    assertEqual(param_mode.fillOut(ref slot), 9)
    assertEqual(slot, 9)
}

@test
fn test_exported_const_function_value_ref_out_contracts() {
    var value = 5
    assertEqual(bumpRefValue(ref value), 6)
    assertEqual(value, 6)

    var slot = 0
    assertEqual(param_mode.fillOutValue(ref slot), 11)
    assertEqual(slot, 11)

    const bump = bumpRefValue
    assertEqual(bump(ref value), 7)
    assertEqual(value, 7)

    const fill = fillOutValue
    assertEqual(fill(ref slot), 11)
    assertEqual(slot, 11)
}
