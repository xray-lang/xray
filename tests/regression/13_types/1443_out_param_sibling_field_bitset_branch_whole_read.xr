struct OutSiblingBranchPair {
    left: int
    right: int
}

fn fill_sibling_field(value: out int, next: int) {
    value = next
}

fn initialize_and_read_siblings(flag: bool, pair: out OutSiblingBranchPair) -> int {
    if (flag) {
        fill_sibling_field(out pair.left, 11)
    } else {
        pair.left = 13
    }

    if (flag) {
        pair.right = 17
    } else {
        fill_sibling_field(out pair.right, 19)
    }

    var whole = pair
    return whole.left + whole.right
}

@test
fn test_out_param_sibling_field_bitset_branch_whole_read() {
    var value = OutSiblingBranchPair{left: 0, right: 0}

    var first = initialize_and_read_siblings(true, out value)
    assert_eq(first, 28)
    assert_eq(value.left, 11)
    assert_eq(value.right, 17)

    var second = initialize_and_read_siblings(false, out value)
    assert_eq(second, 32)
    assert_eq(value.left, 13)
    assert_eq(value.right, 19)
}
