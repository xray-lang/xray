// JSON.Object mutation preserves key identity while values may change JSON kind.

@test
fn test_missing_key_and_type_change() {
    var obj: JSON.Object = JSON.parseObject("{\"value\":1}")
    assert_eq(obj.get("missing"), null)
    obj.set("value", "one")
    assert_eq(JSON.require<string>(obj, ["value"]), "one")
    obj.set("value", null)
    assert(JSON.isNull(JSON.require<JSON.Value>(obj, ["value"])))
}

fn add_field(obj: ref JSON.Object, key: string, value: i64) {
    obj.set(key, value)
}

@test
fn test_object_mutation_in_function() {
    var obj: JSON.Object = JSON.parseObject("{}")
    add_field(ref obj, "added", 123)
    assert_eq(JSON.require<i64>(obj, ["added"]), 123)
}

@test
fn test_nested_mutation() {
    var root = JSON.parseValue("{\"child\":{\"value\":1}}")
    JSON.set(root, ["child", "value"], 99)
    assert_eq(JSON.require<i64>(root, ["child", "value"]), 99)
}
