// 1316_json_decode.xr
// Test: JSON.decode<T>() compiler-generated typed decode

type User = { name: string, age: i64 }

@test
fn test_sanity() {
    assertEqual(1 + 1, 2)
}

@test
fn test_decode_basic() {
    var json = JSON.parseValue("{\"name\": \"Alice\", \"age\": 30}")
    var user = JSON.decode<User>(json)
    assert(user != null)
    assertEqual(user!.name, "Alice")
    assertEqual(user!.age, 30)
}

@test
fn test_decode_missing_field() {
    var partial = JSON.parseValue("{\"name\": \"Bob\"}")
    var bad = JSON.decode<User>(partial)
    assertEqual(bad, null)
}

@test
fn test_decode_wrong_type() {
    var wrong = JSON.parseValue("{\"name\": 123, \"age\": 30}")
    var result = JSON.decode<User>(wrong)
    assertEqual(result, null)
}

@test
fn test_decode_extra_fields() {
    var extra = JSON.parseValue("{\"name\": \"Carol\", \"age\": 25, \"email\": \"c@test.com\"}")
    var user = JSON.decode<User>(extra, JSON.UnknownFields.Ignore)
    assert(user != null)
    assertEqual(user!.name, "Carol")
    assertEqual(user!.age, 25)
}

@test
fn test_decode_non_object() {
    var arr = JSON.parseValue("[1, 2, 3]")
    var bad = JSON.decode<User>(arr)
    assertEqual(bad, null)
}

// Optional fields and more types
type Config = { host: string, port: i64, debug: bool }

@test
fn test_decode_bool_field() {
    var json = JSON.parseValue("{\"host\": \"localhost\", \"port\": 8080, \"debug\": true}")
    var cfg = JSON.decode<Config>(json)
    assert(cfg != null)
    assertEqual(cfg!.host, "localhost")
    assertEqual(cfg!.port, 8080)
    assertEqual(cfg!.debug, true)
}

type Point = { x: f64, y: f64 }

@test
fn test_decode_float_fields() {
    var json = JSON.parseValue("{\"x\": 1.5, \"y\": 2.7}")
    var pt = JSON.decode<Point>(json)
    assert(pt != null)
    assertEqual(pt!.x, 1.5)
    assertEqual(pt!.y, 2.7)
}

type Address = { city: string, zip: i64 }
type Profile = { name: string, address: Address }

@test
fn test_decode_nested_object_field() {
    var json = JSON.parseValue("{\"name\": \"Dana\", \"address\": {\"city\": \"Hangzhou\", \"zip\": 310000}}")
    var profile = JSON.decode<Profile>(json)
    assert(profile != null)
    assertEqual(profile!.name, "Dana")
    assertEqual(profile!.address.city, "Hangzhou")
    assertEqual(profile!.address.zip, 310000)
}

@test
fn test_decode_nested_object_wrong_type() {
    var wrong = JSON.parseValue("{\"name\": \"Dana\", \"address\": {\"city\": \"Hangzhou\", \"zip\": \"bad\"}}")
    var profile = JSON.decode<Profile>(wrong)
    assertEqual(profile, null)
}

@test
fn test_decode_nested_object_wrong_kind() {
    var wrong = JSON.parseValue("{\"name\": \"Dana\", \"address\": \"Hangzhou\"}")
    var profile = JSON.decode<Profile>(wrong)
    assertEqual(profile, null)
}

type JsonBag = { items: Array<JSON.Value> }

@test
fn test_decode_array_json_field() {
    var json = JSON.parseValue("{\"items\": [1, true, null, {\"x\": 2}]}")
    var bag = JSON.decode<JsonBag>(json)
    assert(bag != null)
    assertEqual(len(bag!.items), 4)
}

@test
fn test_decode_array_json_field_rejects_non_array() {
    var json = JSON.parseValue("{\"items\": 1}")
    var bag = JSON.decode<JsonBag>(json)
    assertEqual(bag, null)
}

type MixedProfile = { name: string, tags: Array<JSON.Value>, address: Address, active: bool }

@test
fn test_decode_mixed_nested_object_and_array_json_fields() {
    var json = JSON.parseValue("{\"name\": \"Dana\", \"tags\": [\"ops\", 3, null], \"address\": {\"city\": \"Hangzhou\", \"zip\": 310000}, \"active\": true}")
    var profile = JSON.decode<MixedProfile>(json)
    assert(profile != null)
    assertEqual(profile!.name, "Dana")
    assertEqual(len(profile!.tags), 3)
    assertEqual(profile!.address.city, "Hangzhou")
    assertEqual(profile!.address.zip, 310000)
    assertEqual(profile!.active, true)
}

@test
fn test_decode_mixed_rejects_nested_object_wrong_field() {
    var json = JSON.parseValue("{\"name\": \"Dana\", \"tags\": [\"ops\"], \"address\": {\"city\": \"Hangzhou\", \"zip\": \"bad\"}, \"active\": true}")
    var profile = JSON.decode<MixedProfile>(json)
    assertEqual(profile, null)
}

@test
fn test_decode_mixed_rejects_array_json_wrong_kind() {
    var json = JSON.parseValue("{\"name\": \"Dana\", \"tags\": {\"0\": \"ops\"}, \"address\": {\"city\": \"Hangzhou\", \"zip\": 310000}, \"active\": true}")
    var profile = JSON.decode<MixedProfile>(json)
    assertEqual(profile, null)
}

@test
fn test_decode_null_input() {
    var n = JSON.parseValue("null")
    var bad = JSON.decode<User>(n)
    assertEqual(bad, null)
}
