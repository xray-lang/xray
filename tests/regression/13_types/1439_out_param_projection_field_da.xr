struct ProjectionDaPair {
    left: int
    right: int
}

fn fill_projection_da(value: out int) {
    value = 5
}

fn init_left_by_call(pair: out ProjectionDaPair) {
    fill_projection_da(out pair.left)
    var observed = pair.left
    pair = ProjectionDaPair{left: observed, right: 8}
}

fn init_left_by_assignment(pair: out ProjectionDaPair) {
    pair.left = 7
    var observed = pair.left
    pair = ProjectionDaPair{left: observed, right: 9}
}

@test
fn test_out_projection_field_da_call() {
    var pair = ProjectionDaPair{left: 0, right: 0}
    init_left_by_call(out pair)
    assert_eq(pair.left, 5)
    assert_eq(pair.right, 8)
}

@test
fn test_out_projection_field_da_assignment() {
    var pair = ProjectionDaPair{left: 0, right: 0}
    init_left_by_assignment(out pair)
    assert_eq(pair.left, 7)
    assert_eq(pair.right, 9)
}
