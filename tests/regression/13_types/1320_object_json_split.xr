// 1320_object_json_split.xr
// Test: default object literals are exact object shapes; Json is explicit opt-in.

type User = { id: int, name: string }

@test
fn test_default_object() {
    var user = { id: 1, name: "Ada" }
    assert_eq(typeName(user), "object")
    assert_eq(user.id, 1)
    assert_eq(user.name, "Ada")
    user.name = "Grace"
    assert_eq(user.name, "Grace")
}

@test
fn test_object_alias_assignment() {
    var user: User = { id: 7, name: "Lin" }
    assert_eq(typeName(user), "object")
    assert_eq(user.id, 7)
    assert_eq(user.name, "Lin")
}

@test
fn test_json_opt_in_object() {
    var payload: Json = { id: 1, name: "Ada" }
    payload.extra = true
    assert_eq(typeName(payload), "object")
    assert_eq(payload.extra, true)
}

@test
fn test_json_array_literal_context() {
    var payload: Json = [1, "two", true]
    assert_eq(typeName(payload), "Array")
}

@test
fn test_json_decode_object() {
    var data = Json.parse("{\"id\": 9, \"name\": \"Ray\"}")
    var user = Json.decode<User>(data)
    assert(user != null)
    assert_eq(typeName(user), "object")
    assert_eq(user!.id, 9)
    assert_eq(user!.name, "Ray")
}

