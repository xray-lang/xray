// 1320_object_json_split.xr
// Test: object literals are exact shapes; schema-less JSON objects use Map storage.

type User = { id: i64, name: string }

@test
fn test_default_object() {
    var user = { id: 1, name: "Ada" }
    assert_eq(typeName(user), "object")
    assert_eq(user.id, 1)
    assert_eq(user.name, "Ada")
    user.name = "Grace"
    assert_eq(user.name, "Grace")
}

@test
fn test_object_alias_assignment() {
    var user: User = { id: 7, name: "Lin" }
    assert_eq(typeName(user), "object")
    assert_eq(user.id, 7)
    assert_eq(user.name, "Lin")
}

@test
fn test_json_object_is_map() {
    var payload: JSON.Object = JSON.parseObject("{\"id\":1,\"name\":\"Ada\"}")
    payload.set("extra", true)
    assert_eq(typeName(payload), "Map")
    assert_eq(payload.get("extra"), true)
}

@test
fn test_json_array_literal_context() {
    var payload: JSON.Value = JSON.parseValue("[1,\"two\",true]")
    assert_eq(typeName(payload), "Array")
}

@test
fn test_json_decode_object() {
    var data = JSON.parseValue("{\"id\": 9, \"name\": \"Ray\"}")
    var user = JSON.decode<User>(data)
    assert(user != null)
    assert_eq(typeName(user), "object")
    assert_eq(user!.id, 9)
    assert_eq(user!.name, "Ray")
}
