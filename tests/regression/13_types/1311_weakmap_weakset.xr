// 0520_weakmap_weakset.xr
// Test: WeakMap and WeakSet basic functionality
// WeakMap/WeakSet are lookup structures, NOT containers.
// No size/length, no enumeration, keys/values must be objects.

// ========== WeakMap tests ==========

// Test 1: create and basic set/get

@test
fn test_weakmap_weakset() {
    var wm = WeakMap<Json, Json>()
    var key1: Json = { name: "alice" }
    var key2: Json = { name: "bob" }
    wm.set(key1, "value1")
    wm.set(key2, "value2")
    assert_eq(wm.get(key1), "value1")
    assert_eq(wm.get(key2), "value2")
    print("PASS: weakmap set/get")

    // Test 2: has
    assert_eq(wm.containsKey(key1), true)
    var key3: Json = { name: "charlie" }
    assert_eq(wm.containsKey(key3), false)
    print("PASS: weakmap has")

    // Test 3: delete
    wm.delete(key1)
    assert_eq(wm.containsKey(key1), false)
    assert_eq(wm.get(key1), null)
    assert_eq(wm.containsKey(key2), true)
    print("PASS: weakmap delete")

    // Test 4: update value
    var key4: Json = { kind: "config" }
    wm.set(key4, "old")
    assert_eq(wm.get(key4), "old")
    wm.set(key4, "new")
    assert_eq(wm.get(key4), "new")
    print("PASS: weakmap update")

    // Test 5: array as value
    var key5: Json = { kind: "container" }
    var array_value: Json = [1, 2, 3]
    wm.set(key5, array_value)
    var arr = wm.get(key5)
    assert_eq(arr[0], 1)
    assert_eq(arr[1], 2)
    assert_eq(arr[2], 3)
    print("PASS: weakmap array value")

    // Test 6: nested object as value
    var key6: Json = { outer: true }
    var nested_value: Json = { inner: { deep: "value" } }
    wm.set(key6, nested_value)
    var val = wm.get(key6)
    assert_eq(val.inner.deep, "value")
    print("PASS: weakmap nested value")

    // ========== WeakSet tests ==========

    // Test 7: create and add/has
    var ws = WeakSet<Json>()
    var obj1: Json = { id: 1 }
    var obj2: Json = { id: 2 }
    assert_eq(ws.contains(obj1), false)
    ws.add(obj1)
    ws.add(obj2)
    assert_eq(ws.contains(obj1), true)
    assert_eq(ws.contains(obj2), true)
    print("PASS: weakset add/has")

    // Test 8: delete
    ws.delete(obj1)
    assert_eq(ws.contains(obj1), false)
    assert_eq(ws.contains(obj2), true)
    print("PASS: weakset delete")

    // Test 9: no duplicates
    var ws2 = WeakSet<Json>()
    var obj3: Json = { unique: true }
    ws2.add(obj3)
    ws2.add(obj3)
    ws2.add(obj3)
    assert_eq(ws2.contains(obj3), true)
    print("PASS: weakset no duplicates")
}
