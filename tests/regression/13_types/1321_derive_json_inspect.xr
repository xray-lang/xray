// 1321_derive_json_inspect.xr
// Test: explicit derive metadata replaces default runtime field reflection.

@derive(JSON, Inspect)
class User {
    name: string
    age: i64

    constructor(name: string, age: i64) {
        this.name = name
        this.age = age
    }
}

@derive(Inspect)
class InspectOnly {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

@derive(JSON)
class JsonOnly {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

@test
fn test_derive_json_stringify() {
    var user = User("Ada", 42)
    assertEqual(JSON.stringify(user), "{\"name\":\"Ada\",\"age\":42}")
}

@test
fn test_derive_json_encode() {
    var user = User("Ada", 42)
    var encoded = JSON.value(user)
    assertEqual(typeName(encoded), "Map")
    assertEqual(JSON.require<string>(encoded, ["name"]), "Ada")
    assertEqual(JSON.require<i64>(encoded, ["age"]), 42)
}

@test
fn test_derive_inspect_string() {
    var user = User("Ada", 42)
    assertEqual(string(user), "User{name: \"Ada\", age: 42}")
}

@test
fn test_derive_flags_are_independent() {
    var inspect_only = InspectOnly(7)
    assertEqual(string(inspect_only), "InspectOnly{value: 7}")

    var json_only = JsonOnly(9)
    var encoded = JSON.value(json_only)
    assertEqual(JSON.require<i64>(encoded, ["value"]), 9)
    assertEqual(string(json_only), "JsonOnly{...}")
}
