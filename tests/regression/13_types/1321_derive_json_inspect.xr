// 1321_derive_json_inspect.xr
// Test: explicit derive metadata replaces default runtime field reflection.

@derive(Json, Inspect)
class User {
    name: string
    age: int

    constructor(name: string, age: int) {
        this.name = name
        this.age = age
    }
}

class PlainUser {
    name: string

    constructor(name: string) {
        this.name = name
    }
}

@derive(Inspect)
class InspectOnly {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

@derive(Json)
class JsonOnly {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

@test
fn test_derive_json_stringify() {
    var user = User("Ada", 42)
    assert_eq(Json.stringify(user), "{\"name\":\"Ada\",\"age\":42}")
}

@test
fn test_derive_json_encode() {
    var user = User("Ada", 42)
    var encoded = Json.encode(user)
    assert_eq(typename(encoded), "Json")
    assert_eq(encoded.name, "Ada")
    assert_eq(encoded.age, 42)
}

@test
fn test_derive_inspect_string() {
    var user = User("Ada", 42)
    assert_eq(string(user), "User{name: \"Ada\", age: 42}")
}

@test
fn test_json_requires_explicit_derive() {
    var user = PlainUser("Ada")
    var caught = false
    try {
        Json.encode(user)
    } catch panic (e) {
        caught = true
        assert(string(e).includes("does not derive Json"))
    }
    assert(caught)
}

@test
fn test_derive_flags_are_independent() {
    var inspect_only = InspectOnly(7)
    assert_eq(string(inspect_only), "InspectOnly{value: 7}")

    var inspect_json_caught = false
    try {
        Json.encode(inspect_only)
    } catch panic (e) {
        inspect_json_caught = true
        assert(string(e).includes("does not derive Json"))
    }
    assert(inspect_json_caught)

    var json_only = JsonOnly(9)
    var encoded = Json.encode(json_only)
    assert_eq(encoded.value, 9)
    assert_eq(string(json_only), "JsonOnly{...}")
}
