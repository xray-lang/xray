// A realistic inbound-payload workflow: inspect, transform, and emit.

type Request = { action: string, userId: i64 }

@test
fn test_typed_boundary_rejects_unknown_by_default() {
    var raw = "{\"action\":\"activate\",\"userId\":7,\"trace\":\"t1\"}"
    var rejected = false
    try {
        JSON.parse<Request>(raw)
    } catch panic (e) {
        rejected = true
    }
    assert(rejected)
    var request = JSON.parse<Request>(raw, JSON.UnknownFields.Ignore)
    assert_eq(request.action, "activate")
    assert_eq(request.userId, 7)
}

@test
fn test_parse_with_rest_transform_and_merge() {
    var parts = JSON.parseWithRest<Request>(
        "{\"action\":\"activate\",\"userId\":7,\"trace\":\"t1\"}"
    )
    parts.rest.set("processed", true)
    var merged = JSON.merge(parts)
    assert_eq(JSON.require<string>(merged, ["action"]), "activate")
    assert_eq(JSON.require<string>(merged, ["trace"]), "t1")
    assert_eq(JSON.require<bool>(merged, ["processed"]), true)
}
