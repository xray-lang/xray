fn take(data: Array<int>) -> int {
    return len(data)
}

fn read(data: in Array<int>) -> int {
    return len(data)
}

@test
fn test_move_source_action_is_not_call_marker() {
    owned xs = Array<int>(2, 1)
    assert_eq(take(move xs), 2)

    owned ys = Array<int>(3, 1)
    assert_eq(read(move ys), 3)
}
