// JSON.Object is an alias of Map<string, JSON.Value>; collection methods are Map methods.

@test
fn test_object_collection_methods() {
    var obj: JSON.Object = JSON.parseObject("{\"name\":\"Alice\",\"age\":30}")
    assertEqual(len(obj), 2)
    assert(obj.containsKey("name"))
    assert(!obj.containsKey("email"))
    assertEqual(len(obj.keys()), 2)
    assertEqual(len(obj.values()), 2)
    assertEqual(len(obj.entries()), 2)
}

@test
fn test_object_delete_and_clear() {
    var obj: JSON.Object = JSON.parseObject("{\"a\":1,\"b\":2}")
    assert(obj.delete("a"))
    assertEqual(len(obj), 1)
    obj.clear()
    assertEqual(len(obj), 0)
}
