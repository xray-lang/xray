// Iteration over JSON.Object follows Map key and entry protocols.

@test
fn test_json_object_for_in() {
    var obj: JSON.Object = JSON.parseObject("{\"a\":1,\"b\":2,\"c\":3}")
    var keys = ""
    for (key in obj) { keys += key }
    assert_eq(keys, "abc")

    var total = 0
    for (_, value in obj) { total += int(value) }
    assert_eq(total, 6)
}

@test
fn test_empty_json_object_for_in() {
    var obj: JSON.Object = JSON.parseObject("{}")
    var count = 0
    for (_ in obj) { count++ }
    assert_eq(count, 0)
}
