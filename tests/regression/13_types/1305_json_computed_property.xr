// Computed keys belong to JSON.Object/Map operations, not object literals.

@test
fn test_computed_key_set() {
    var key = "name"
    var obj: JSON.Object = JSON.parseObject("{}")
    obj.set(key, "Alice")
    assertEqual(JSON.require<string>(obj, ["name"]), "Alice")
}

@test
fn test_expression_keys() {
    var obj: JSON.Object = JSON.parseObject("{}")
    var prefix = "user_"
    obj.set(prefix + "id", 123)
    for (i in 0..3) { obj.set("field_" + string(i), i * 10) }
    assertEqual(JSON.require<i64>(obj, ["user_id"]), 123)
    assertEqual(JSON.require<i64>(obj, ["field_2"]), 20)
}
