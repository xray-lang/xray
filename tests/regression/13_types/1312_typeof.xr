/*
** 0525_typeof.xr
** typeName() 内置函数测试
**
** 作者：xingleixu@gmail.com
**
** 测试 typeName() 函数返回变量类型名称字符串
*/
// 测试基本类型
assertEqual(typeName(123), "i64")
assertEqual(typeName(3.14), "f64")
assertEqual(typeName("hello"), "string")
assertEqual(typeName(true), "bool")
assertEqual(typeName(false), "bool")
assertEqual(typeName(null), "null")
// 测试容器类型
var arr = [1, 2, 3]
assertEqual(typeName(arr), "Array")
var map = #{"a": 1}
assertEqual(typeName(map), "Map")
var s = #[1, 2, 3]
assertEqual(typeName(s), "Set")

// 测试函数类型
@test
fn test_fn() -> i64 {
    return 42
}

assertEqual(typeName(test_fn), "function")
// 测试闭包
var closure = fn() {
    return 1
}
assertEqual(typeName(closure), "function")
// 测试变量类型
var x = 10
assertEqual(typeName(x), "i64")
var y = 3.14
assertEqual(typeName(y), "f64")
// 测试表达式结果类型
assertEqual(typeName(1 + 2), "i64")
assertEqual(typeName("a" + "b"), "string")
print("typeName() 测试通过!")
