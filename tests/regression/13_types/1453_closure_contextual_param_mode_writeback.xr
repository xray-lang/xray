// Contextually-inferred closure parameters must inherit READ/REF/MOVE from the
// expected function type all the way through IR lowering.
// Regression: an untyped `fn(x)` assigned to a `(ref int) -> ...` type used to
// lower its parameter as a value slot, so the callee received a place
// descriptor instead of the int and `x + 1` failed at runtime.

@test
fn test_contextual_read_closure_reads_value() {
    var reader: fn(i64) -> i64 = fn(x) -> i64 {
        return x + 100
    }
    var v = 5
    assertEqual(reader(v), 105)
    assertEqual(v, 5)
}

@test
fn test_contextual_ref_closure_writes_back() {
    var bump: fn(ref i64) -> i64 = fn(x) -> i64 {
        x = x + 1
        return x
    }
    var v = 1
    assertEqual(bump(ref v), 2)
    assertEqual(v, 2)
}

@test
fn test_contextual_move_closure_consumes_owner() {
    var take: fn(move Array<i64>) -> i64 = fn(x) -> i64 {
        return len(x)
    }
    var values = [1, 2, 3]
    assertEqual(take(move values), 3)
}
