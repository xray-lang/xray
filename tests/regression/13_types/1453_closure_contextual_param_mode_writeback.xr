// Contextually-inferred closure parameters must inherit the ParamMode from the
// expected function type all the way through IR lowering, so `in`/`ref`/`out`
// closures observe the same caller/callee contract as explicitly-typed ones.
// Regression: an untyped `fn(x)` assigned to a `(ref int) -> ...` type used to
// lower its parameter as a value slot, so the callee received a place
// descriptor instead of the int and `x + 1` failed at runtime.

@test
fn test_contextual_in_closure_reads_value() {
    var reader: (in int) -> int = fn(x) -> int {
        return x + 100
    }
    var v = 5
    assert_eq(reader(v), 105)
    assert_eq(v, 5)
}

@test
fn test_contextual_ref_closure_writes_back() {
    var bump: (ref int) -> int = fn(x) -> int {
        x = x + 1
        return x
    }
    var v = 1
    assert_eq(bump(ref v), 2)
    assert_eq(v, 2)
}

@test
fn test_contextual_out_closure_writes_back() {
    var fill: (out int) -> int = fn(x) -> int {
        x = 42
        return 7
    }
    var v = 0
    assert_eq(fill(out v), 7)
    assert_eq(v, 42)
}
