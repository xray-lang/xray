// 1380_tuple_spread.xr
// 测试：spread 操作符 `...t`（tuple 拼接 / 函数调用展开）

// ===== 函数调用展开：所有参数 =====
@test
fn test_call_spread_all_args() {
    fn dist(x1: i64, y1: i64, x2: i64, y2: i64) -> i64 {
        var dx = x2 - x1
        var dy = y2 - y1
        return dx * dx + dy * dy
    }
    var p1 = (0, 0)
    var p2 = (3, 4)
    assertEqual(dist(...p1, ...p2), 25)
}

// ===== 函数调用展开：混合 spread 与显式参数 =====
@test
fn test_call_spread_mixed() {
    fn add4(a: i64, b: i64, c: i64, d: i64) -> i64 {
        return a + b + c + d
    }
    var p1 = (1, 2)
    var p2 = (3, 4)
    assertEqual(add4(...p1, ...p2), 10)
    assertEqual(add4(0, ...p1, 99), 102)
    assertEqual(add4(...p1, 100, 200), 303)
}

// ===== Tuple 拼接：纯 spread =====
@test
fn test_tuple_concat_pure_spread() {
    var head = (1, 2)
    var tail = (3, 4, 5)
    var all = (...head, ...tail)
    assertEqual(all.0, 1)
    assertEqual(all.1, 2)
    assertEqual(all.2, 3)
    assertEqual(all.3, 4)
    assertEqual(all.4, 5)
}

// ===== Tuple 拼接：spread + 显式元素混合 =====
@test
fn test_tuple_concat_mixed() {
    var head = (1, 2)
    var tail = (4, 5)
    var mixed = (0, ...head, 3, ...tail, 6)
    assertEqual(mixed.0, 0)
    assertEqual(mixed.1, 1)
    assertEqual(mixed.2, 2)
    assertEqual(mixed.3, 3)
    assertEqual(mixed.4, 4)
    assertEqual(mixed.5, 5)
    assertEqual(mixed.6, 6)
}

// ===== 异构类型：spread 保留每个槽位的精确类型 =====
@test
fn test_spread_heterogeneous() {
    fn describe(n: i64, s: string, b: bool) -> string {
        return string(n) + "/" + s + "/" + string(b)
    }
    var t = (42, "answer", true)
    assertEqual(describe(...t), "42/answer/true")
}

// ===== 嵌套 spread 在 tuple 中 =====
@test
fn test_nested_spread() {
    var inner = (2, 3)
    var outer: (i64, i64, i64, i64) = (1, ...inner, 4)
    assertEqual(outer.0, 1)
    assertEqual(outer.1, 2)
    assertEqual(outer.2, 3)
    assertEqual(outer.3, 4)
}
