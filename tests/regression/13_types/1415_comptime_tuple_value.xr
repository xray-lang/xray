const COUNT = comptime 4

@test
fn test_comptime_tuple_value() {
    var t = comptime (1, "hi", true)
    assertEqual(t.0, 1)
    assertEqual(t.1, "hi")
    assertEqual(t.2, true)
}

@test
fn test_comptime_tuple_const_cache() {
    const local = comptime (COUNT, "items")
    var cached = comptime local
    assertEqual(cached.0, 4)
    assertEqual(cached.1, "items")
}

@test
fn test_comptime_nested_tuple_value() {
    var nested = comptime ((1, 2), (3, COUNT))
    assertEqual(nested.0.0, 1)
    assertEqual(nested.0.1, 2)
    assertEqual(nested.1.0, 3)
    assertEqual(nested.1.1, 4)
}

@test
fn test_comptime_tuple_spread_value() {
    const head = comptime (1, 2)
    const tail = comptime (4, COUNT)
    var mixed = comptime (0, ...head, 3, ...tail)
    assertEqual(mixed.0, 0)
    assertEqual(mixed.1, 1)
    assertEqual(mixed.2, 2)
    assertEqual(mixed.3, 3)
    assertEqual(mixed.4, 4)
    assertEqual(mixed.5, 4)
}
