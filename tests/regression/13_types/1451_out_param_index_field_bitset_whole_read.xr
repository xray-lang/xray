struct OutIndexFieldBitsetBox {
    slots: [int; 2]
}

fn fill_index_field_bitset_slot(value: out int, next: int) {
    value = next
}

fn initialize_index_fields_and_read_whole(box: out OutIndexFieldBitsetBox) -> int {
    fill_index_field_bitset_slot(out box.slots[0], 23)
    fill_index_field_bitset_slot(out box.slots[1], 29)

    var whole = box
    return whole.slots[0] + whole.slots[1]
}

@test
fn test_out_param_index_field_bitset_whole_read() {
    var value = OutIndexFieldBitsetBox{slots: [0, 0]}
    var total = initialize_index_fields_and_read_whole(out value)
    assert_eq(total, 52)
    assert_eq(value.slots[0], 23)
    assert_eq(value.slots[1], 29)
}
