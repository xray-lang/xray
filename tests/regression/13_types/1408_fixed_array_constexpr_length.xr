const BASE = 4
const DOUBLE = BASE * 2
const SHIFTED = 1 << 3

fn last_scaled(xs: [u8; DOUBLE]) -> i64 {
    return xs[7] as i64
}

@test
fn test_fixed_array_constexpr_lengths() {
    const LOCAL = BASE + 1

    var a: [u8; BASE] = [7; BASE]
    assert(len(a) == 4)
    assert(a[3] == 7)

    var b: [u8; DOUBLE] = [1; DOUBLE]
    assert(len(b) == 8)
    assert(last_scaled(b) == 1)

    var c: [u8; SHIFTED] = [0; SHIFTED]
    assert(len(c) == 8)
    assert(c[6] == 0)

    var d: [u8; LOCAL] = [2; LOCAL]
    assert(len(d) == 5)
    assert(d[4] == 2)

    var inferred = [3; BASE + 2]
    assert(len(inferred) == 6)
    assert(inferred[5] == 3)
}
