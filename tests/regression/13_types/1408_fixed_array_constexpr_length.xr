const BASE = 4
const DOUBLE = BASE * 2
const SHIFTED = 1 << 3

fn last_scaled(xs: [uint8; DOUBLE]) -> int {
    return xs[7]
}

@test
fn test_fixed_array_constexpr_lengths() {
    const LOCAL = BASE + 1

    let a: [uint8; BASE] = [7; BASE]
    assert(a.length == 4)
    assert(a[3] == 7)

    let b: [uint8; DOUBLE] = [1; DOUBLE]
    assert(b.length == 8)
    assert(last_scaled(b) == 1)

    let c: [uint8; SHIFTED] = [0; SHIFTED]
    assert(c.length == 8)
    assert(c[6] == 0)

    let d: [uint8; LOCAL] = [2; LOCAL]
    assert(d.length == 5)
    assert(d[4] == 2)

    let inferred = [3; BASE + 2]
    assert(inferred.length == 6)
    assert(inferred[5] == 3)
}
