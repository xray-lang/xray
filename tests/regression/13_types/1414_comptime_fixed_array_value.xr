const COUNT = comptime 4

@test
fn test_comptime_fixed_array_repeat_value() {
    var repeated: [i64; COUNT] = comptime [7; COUNT]
    assertEqual(len(repeated), 4)
    assertEqual(repeated[0], 7)
    assertEqual(repeated[3], 7)
}

@test
fn test_comptime_fixed_array_list_value() {
    var listed: [i64; 3] = comptime [1, COUNT - 2, COUNT]
    assertEqual(len(listed), 3)
    assertEqual(listed[0], 1)
    assertEqual(listed[1], 2)
    assertEqual(listed[2], 4)
}

@test
fn test_comptime_fixed_array_const_cache() {
    const local = comptime [5; COUNT]
    var cached: [i64; COUNT] = copy(comptime local)
    assertEqual(cached[0], 5)
    assertEqual(cached[3], 5)
}

@test
fn test_comptime_fixed_array_index_access() {
    const table: [i64; 3] = comptime [1, COUNT, 9]
    var picked = comptime (table[0] + table[1] + table[2])
    assertEqual(picked, 14)
}
