const COUNT = comptime 4

@test
fn test_comptime_fixed_array_repeat_value() {
    var repeated: [int; COUNT] = comptime [7; COUNT]
    assert_eq(len(repeated), 4)
    assert_eq(repeated[0], 7)
    assert_eq(repeated[3], 7)
}

@test
fn test_comptime_fixed_array_list_value() {
    var listed: [int; 3] = comptime [1, COUNT - 2, COUNT]
    assert_eq(len(listed), 3)
    assert_eq(listed[0], 1)
    assert_eq(listed[1], 2)
    assert_eq(listed[2], 4)
}

@test
fn test_comptime_fixed_array_const_cache() {
    const local = comptime [5; COUNT]
    var cached: [int; COUNT] = copy(comptime local)
    assert_eq(cached[0], 5)
    assert_eq(cached[3], 5)
}

@test
fn test_comptime_fixed_array_index_access() {
    const table: [int; 3] = comptime [1, COUNT, 9]
    var picked = comptime (table[0] + table[1] + table[2])
    assert_eq(picked, 14)
}
