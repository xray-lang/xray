enum OutTryCatchFieldBitsetErr {
    Fail
}

struct OutTryCatchFieldBitsetPair {
    left: int
    right: int
}

fn fill_try_field(value: out int, next: int) {
    value = next
}

fn maybe_fail(flag: bool) {
    if (flag) {
        throw OutTryCatchFieldBitsetErr.Fail
    }
}

fn initialize_try_catch_fields(flag: bool, pair: out OutTryCatchFieldBitsetPair) -> int {
    try {
        maybe_fail(flag)
        fill_try_field(out pair.left, 2)
        pair.right = 3
    } catch (e) {
        pair.left = 5
        fill_try_field(out pair.right, 7)
    }

    var whole = pair
    return whole.left + whole.right
}

@test
fn test_out_param_try_catch_field_bitset_whole_read() {
    var clean = OutTryCatchFieldBitsetPair{left: 0, right: 0}
    var clean_total = initialize_try_catch_fields(false, out clean)
    assert_eq(clean_total, 5)
    assert_eq(clean.left, 2)
    assert_eq(clean.right, 3)

    var recovered = OutTryCatchFieldBitsetPair{left: 0, right: 0}
    var recovered_total = initialize_try_catch_fields(true, out recovered)
    assert_eq(recovered_total, 12)
    assert_eq(recovered.left, 5)
    assert_eq(recovered.right, 7)
}
