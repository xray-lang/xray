// Schema-less traversal and mutation are explicit JSON.Path operations.

@test
fn test_path_get_and_require() {
    var root = JSON.parseValue("{\"user\":{\"name\":\"Alice\",\"age\":30}}")
    var key = "name"
    var path: JSON.Path = ["user", key]
    assert_eq(JSON.get<string>(root, path), "Alice")
    assert_eq(JSON.require<i64>(root, ["user", "age"]), 30)
    assert_eq(JSON.get<string>(root, ["user", "missing"]), null)
}

@test
fn test_path_set_and_remove() {
    var root = JSON.parseValue("{\"config\":{}}")
    JSON.set(root, ["config", "host"], "localhost")
    JSON.set(root, ["config", "port"], 8080)
    assert(JSON.containsPath(root, ["config", "host"]))
    assert_eq(JSON.require<i64>(root, ["config", "port"]), 8080)
    assert(JSON.remove(root, ["config", "host"]))
    assert(!JSON.containsPath(root, ["config", "host"]))
}

@test
fn test_path_create_parents() {
    var root = JSON.parseValue("{}")
    JSON.set(root, ["service", "limits", "retries"], 3, true)
    assert_eq(JSON.require<i64>(root, ["service", "limits", "retries"]), 3)
}
