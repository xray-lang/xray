// 测试：类型别名与对象类型

// ===== 严格类型别名（不允许扩展）=====

@test
fn test_strict_type_alias() {
    type Point = { x: i64, y: i64 }
    var p: Point = { x: 10, y: 20 }
    assertEqual(p.x, 10)
    assertEqual(p.y, 20)
}

@test
fn test_strict_type_modify_existing() {
    type Point2 = { x: i64, y: i64 }
    var p: Point2 = { x: 1, y: 2 }
    p.x = 100      // 修改已有字段，允许
    p.y = 200
    assertEqual(p.x, 100)
    assertEqual(p.y, 200)
}

// ===== spread 构造新的精确 shape =====

@test
fn test_spread_adds_static_fields() {
    type Config = { port: i64, host: string }
    var cfg: Config = { port: 8080, host: "localhost" }
    var extended = { ...cfg, timeout: 30, debug: true }
    assertEqual(extended.port, 8080)
    assertEqual(extended.host, "localhost")
    assertEqual(extended.timeout, 30)
    assertEqual(extended.debug, true)
}

@test
fn test_spread_adds_nested_static_field() {
    type Server = { id: i64 }
    var s: Server = { id: 1 }
    var extended = {
        ...s,
        name: "main",
        status: "running",
        metrics: { cpu: 0.5, mem: 0.8 }
    }
    assertEqual(extended.id, 1)
    assertEqual(extended.name, "main")
    assertEqual(extended.status, "running")
    assertEqual(extended.metrics.cpu, 0.5)
}

// ===== 带 const 的只读字段 =====

@test
fn test_readonly_field() {
    type User1 = { const id: i64, name: string }
    var u: User1 = { id: 1, name: "Alice" }
    u.name = "Bob"       // 可修改普通字段
    assertEqual(u.id, 1)
    assertEqual(u.name, "Bob")
}

// ===== 可选字段 =====

@test
fn test_optional_field() {
    type Profile1 = { name: string, email: string? }
    var p1: Profile1 = { name: "Alice" }
    assertEqual(p1.name, "Alice")
    
    var p2: Profile1 = { name: "Bob", email: "bob@test.com" }
    assertEqual(p2.email, "bob@test.com")
}

// ===== 嵌套类型别名 =====

@test
fn test_nested_type_alias() {
    type Address = { city: string, zip: string }
    type Person = { name: string, addr: Address }
    
    var p: Person = {
        name: "Charlie",
        addr: { city: "Beijing", zip: "100000" }
    }
    assertEqual(p.name, "Charlie")
    assertEqual(p.addr.city, "Beijing")
}

print("json_type_alias: all tests passed")
