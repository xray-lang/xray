struct OutIndexProjectionBox {
    slots: [int; 2]
}

fn fill_index_slot(value: out int, next: int) {
    value = next
}

fn initialize_index_projection(box: out OutIndexProjectionBox) -> int {
    fill_index_slot(out box.slots[0], 11)
    var first = box.slots[0]

    fill_index_slot(out box.slots[1], 17)
    var second = box.slots[1]

    box = OutIndexProjectionBox{slots: [first, second]}
    return first + second
}

@test
fn test_out_param_index_projection_da_read() {
    var value = OutIndexProjectionBox{slots: [0, 0]}
    var total = initialize_index_projection(out value)
    assert_eq(total, 28)
    assert_eq(value.slots[0], 11)
    assert_eq(value.slots[1], 17)
}
