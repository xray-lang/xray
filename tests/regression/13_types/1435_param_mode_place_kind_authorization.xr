fn bump(value: ref int) -> int {
    return value + 1
}

fn fill(value: out int) -> int {
    value = 7
    return value
}

fn observe(values: ref Array<int>) -> int {
    return len(values)
}

@test
fn test_var_and_owned_places_accept_ref_out() {
    var value = 1
    assert_eq(bump(ref value), 2)

    var slot = 0
    assert_eq(fill(out slot), 7)

    owned values = Array<int>(0)
    assert_eq(observe(ref values), 0)
}
