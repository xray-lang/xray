fn bump(value: ref i64) -> i64 {
    return value + 1
}

fn fill(value: ref i64) -> i64 {
    value = 7
    return value
}

fn observe(values: ref Array<i64>) -> i64 {
    return len(values)
}

@test
fn test_writable_places_accept_ref() {
    var value = 1
    assert_eq(bump(ref value), 2)

    var slot = 0
    assert_eq(fill(ref slot), 7)
    assert_eq(slot, 7)

    var values = Array<i64>(0)
    assert_eq(observe(ref values), 0)
}
