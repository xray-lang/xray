const SCALE = comptime 8 * 4
const COUNT = comptime SCALE + 2

@test
fn test_comptime_expr_feeds_static_int_positions() {
    var bytes: [byte; COUNT] = [3; COUNT]
    assert_eq(len(bytes), 34)
    assert_eq(bytes[0], 3)
    assert_eq(bytes[33], 3)

    var mask = comptime 1 << 8
    mask = mask + 1
    assert_eq(mask, 257)
}
