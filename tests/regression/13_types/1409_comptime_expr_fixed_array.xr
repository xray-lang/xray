const SCALE = comptime 8 * 4
const COUNT = comptime SCALE + 2

@test
fn test_comptime_expr_feeds_static_int_positions() {
    var bytes: [u8; COUNT] = [3; COUNT]
    assertEqual(len(bytes), 34)
    assertEqual(bytes[0], 3)
    assertEqual(bytes[33], 3)

    var mask = comptime 1 << 8
    mask = mask + 1
    assertEqual(mask, 257)
}
