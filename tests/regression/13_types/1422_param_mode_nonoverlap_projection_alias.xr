class Pair {
    left: i64
    right: i64

    constructor() {
        this.left = 0
        this.right = 0
    }
}

fn fill_pair(left: ref i64, right: ref i64) {
    left = 3
    right = 7
}

fn read_and_fill(snapshot: i64, target: ref i64) {
    target = snapshot + 5
}

@test
fn test_member_nonoverlap_compile_surface() {
    var pair = Pair()
    fill_pair(ref pair.left, ref pair.right)
}

@test
fn test_index_nonoverlap_compile_surface() {
    var values = [2, 0]
    read_and_fill(values[0], ref values[1])
}
