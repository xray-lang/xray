struct Pair {
    x: int
}

struct Holder {
    names: [string; 2]
    blocks: [[byte; 2]; 2]
}

fn sum_fixed_in(xs: in [byte; 4]) -> int {
    return xs[0] + xs[1]
}

fn bump_fixed_ref(xs: ref [byte; 4]) {
    xs[3] = 42
}

@test
fn test_fixed_array_repeat_nested_value_lanes_and_borrowing() {
    var zero: [byte; 4] = [0; 4]
    assert(len(zero) == 4)
    assert(zero[2] == 0)

    var blocks: [[byte; 2]; 2] = [[1, 2], [3, 4]]
    assert(len(blocks) == 2)
    assert(blocks[1][0] == 3)
    blocks[0][1] = 9
    assert(blocks[0][1] == 9)

    var names: [string; 2] = ["a", "b"]
    assert(names[1] == "b")

    var pairs: [Pair; 2] = [Pair{x: 7}, Pair{x: 8}]
    assert(pairs[0].x == 7)
    assert(pairs[1].x == 8)

    var lists: [Array<int>; 2] = [[10], [20, 21]]
    assert(lists[0][0] == 10)
    assert(len(lists[1]) == 2)

    var bytes: [byte; 4] = [5, 6, 7, 8]
    var view: Slice<byte> = bytes[1:4]
    assert(len(view) == 3)
    assert(view[0] == 6)
    view[1] = 99
    assert(bytes[2] == 99)

    var pass: [byte; 4] = [1, 2, 3, 4]
    assert(sum_fixed_in(pass) == 3)
    bump_fixed_ref(pass)
    assert(pass[3] == 42)

    var holder = Holder{names: ["x", "y"], blocks: [[11, 12], [13, 14]]}
    assert(holder.names[1] == "y")
    assert(holder.blocks[0][1] == 12)
    assert(holder.blocks[1][0] == 13)
    assert(holder.blocks[1][1] == 14)
}
