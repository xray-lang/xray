// 1306_repr_c_struct.xr
// @repr(C) value structs use headerless payload storage.

@repr(C)
struct CPoint {
    x: int32
    y: int32
}

@repr(C)
struct CBox {
    p: CPoint
    tag: uint8
}

fn make_point() -> CPoint {
    return CPoint{x: 10, y: 20}
}

@test
fn test_repr_c_struct_return_set_and_eq() {
    let p = make_point()
    p.x = p.x + 2
    let q = CPoint{x: 12, y: 20}
    assert_eq(p.x, 12)
    assert_eq(p.y, 20)
    assert_true(p == q)
}

@test
fn test_repr_c_nested_struct_field_access() {
    let b = CBox{p: CPoint{x: 1, y: 2}, tag: 3}
    b.p.x = b.p.x + b.tag
    assert_eq(b.p.x, 4)
    assert_eq(b.p.y, 2)
    assert_eq(b.tag, 3)
}
