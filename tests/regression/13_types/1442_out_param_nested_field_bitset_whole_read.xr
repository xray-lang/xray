struct OutNestedLeaf {
    x: int
    y: int
}

struct OutNestedPair {
    left: OutNestedLeaf
    right: int
}

fn fill_nested_leaf(value: out int, next: int) {
    value = next
}

fn initialize_and_read_nested(pair: out OutNestedPair) -> int {
    fill_nested_leaf(out pair.left.x, 3)
    var observed_leaf = pair.left.x
    fill_nested_leaf(out pair.left.y, 5)
    pair.right = 7
    var whole = pair
    return observed_leaf + whole.left.y + whole.right
}

@test
fn test_out_param_nested_field_bitset_whole_read() {
    var value = OutNestedPair{left: OutNestedLeaf{x: 0, y: 0}, right: 0}
    var total = initialize_and_read_nested(out value)
    assert_eq(total, 15)
    assert_eq(value.left.x, 3)
    assert_eq(value.left.y, 5)
    assert_eq(value.right, 7)
}
