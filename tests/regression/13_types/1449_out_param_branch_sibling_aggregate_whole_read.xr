struct OutBranchSiblingLeaf {
    x: int
    y: int
}

struct OutBranchSiblingAggregate {
    left: OutBranchSiblingLeaf
    right: OutBranchSiblingLeaf
}

fn fill_branch_sibling_leaf(value: out int, next: int) {
    value = next
}

fn initialize_branch_sibling_aggregate(flag: bool, pair: out OutBranchSiblingAggregate) -> int {
    if (flag) {
        fill_branch_sibling_leaf(out pair.left.x, 1)
    } else {
        pair.left.x = 2
    }
    if (flag) {
        pair.left.y = 3
    } else {
        fill_branch_sibling_leaf(out pair.left.y, 5)
    }
    var left = pair.left
    fill_branch_sibling_leaf(out pair.right.x, left.x + left.y)
    pair.right.y = left.y + 7
    var whole = pair
    return left.x + left.y + whole.right.x + whole.right.y
}

@test
fn test_out_param_branch_sibling_aggregate_whole_read() {
    var first = OutBranchSiblingAggregate{left: OutBranchSiblingLeaf{x: 0, y: 0}, right: OutBranchSiblingLeaf{x: 0, y: 0}}
    var first_total = initialize_branch_sibling_aggregate(true, out first)
    assert_eq(first_total, 18)
    assert_eq(first.left.x, 1)
    assert_eq(first.left.y, 3)
    assert_eq(first.right.x, 4)
    assert_eq(first.right.y, 10)
    var second = OutBranchSiblingAggregate{left: OutBranchSiblingLeaf{x: 0, y: 0}, right: OutBranchSiblingLeaf{x: 0, y: 0}}
    var second_total = initialize_branch_sibling_aggregate(false, out second)
    assert_eq(second_total, 26)
    assert_eq(second.left.x, 2)
    assert_eq(second.left.y, 5)
    assert_eq(second.right.x, 7)
    assert_eq(second.right.y, 12)
}
