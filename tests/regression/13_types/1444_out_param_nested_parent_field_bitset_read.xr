struct OutNestedParentReadLeaf {
    x: int
    y: int
}

struct OutNestedParentReadPair {
    left: OutNestedParentReadLeaf
    right: int
}

fn fill_nested_parent_read(value: out int, next: int) {
    value = next
}

fn initialize_and_read_parent_field(pair: out OutNestedParentReadPair) -> int {
    fill_nested_parent_read(out pair.left.x, 3)
    pair.left.y = 5

    var left = pair.left
    pair.right = 7
    return left.x + left.y + pair.right
}

@test
fn test_out_param_nested_parent_field_bitset_read() {
    var value = OutNestedParentReadPair{
        left: OutNestedParentReadLeaf{x: 0, y: 0},
        right: 0,
    }
    var total = initialize_and_read_parent_field(out value)
    assert_eq(total, 15)
    assert_eq(value.left.x, 3)
    assert_eq(value.left.y, 5)
    assert_eq(value.right, 7)
}
