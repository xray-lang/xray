// JSON is a prelude namespace; JSON.Value and JSON.Object are its public data types.

type User = { name: string, age: i64 }

@test
fn test_parse_and_stringify() {
    var value = JSON.parseValue("{\"name\":\"Ada\",\"age\":37}")
    assert_eq(JSON.require<string>(value, ["name"]), "Ada")
    assert_eq(JSON.stringify(value), "{\"name\":\"Ada\",\"age\":37}")
}

@test
fn test_typed_parse_and_value() {
    var user = JSON.parse<User>("{\"name\":\"Bob\",\"age\":42}")
    assert_eq(user.name, "Bob")
    var encoded = JSON.value(user)
    assert_eq(typeName(encoded), "Map")
    assert_eq(JSON.require<i64>(encoded, ["age"]), 42)
}

@test
fn test_is_valid_and_parse_failure() {
    assert(JSON.isValid("42"))
    assert(JSON.isValid("[1,2]"))
    assert(!JSON.isValid("not json"))
    var caught = false
    try {
        JSON.parseValue("{broken")
    } catch panic (e) {
        caught = true
    }
    assert(caught)
}
