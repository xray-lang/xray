// 0101_int_boundary.xr
// Regression: sBx encoding boundary for OP_LOADI
// Validates that integers near the sBx bias boundary
// are correctly encoded and decoded without sign flips.

@test
fn test_sbx_boundary_positive() {
    // MAXARG_sBx = 32767, should use LOADI
    assertEqual(32767, 32767)
    var x = 32767
    assertEqual(x, 32767)
    assertEqual(x + 1, 32768)
}

@test
fn test_sbx_boundary_negative() {
    // -MAXARG_sBx = -32767, should use LOADI
    assertEqual(-32767, -32767)
    var x = -32767
    assertEqual(x, -32767)
    assertEqual(x - 1, -32768)
}

@test
fn test_beyond_sbx_positive() {
    // 32768 exceeds LOADI range, must use LOADK constant pool
    var x = 32768
    assertEqual(x, 32768)
    assertEqual(x > 0, true)
    assertEqual(x - 1, 32767)
}

@test
fn test_beyond_sbx_negative() {
    // -32768 exceeds LOADI range, must use LOADK constant pool
    var x = -32768
    assertEqual(x, -32768)
    assertEqual(x < 0, true)
    assertEqual(x + 1, -32767)
    // Critical: -32768 must NOT be decoded as +32768 (sign flip bug)
    assertEqual(x != 32768, true)
    assertEqual(x + 32768, 0)
}

@test
fn test_sbx_zero_crossing() {
    // Verify small negative values are correct
    assertEqual(-1, -1)
    assertEqual(-128, -128)
    assertEqual(-256, -256)
    assertEqual(-1000, -1000)
}

@test
fn test_large_constants() {
    // Values well beyond sBx range, always use LOADK
    var a = 65535
    assertEqual(a, 65535)
    var b = -65535
    assertEqual(b, -65535)
    var c = 100000
    assertEqual(c, 100000)
    var d = -100000
    assertEqual(d, -100000)
}

@test
fn test_sbx_in_json() {
    // The original bug manifested when -32768 appeared in an object literal.
    var obj = {min: -32768, max: 32767, beyond: 32768}
    assertEqual(obj.min, -32768)
    assertEqual(obj.max, 32767)
    assertEqual(obj.beyond, 32768)
    assertEqual(obj.min + obj.max, -1)
    assertEqual(obj.min + obj.beyond, 0)
}
