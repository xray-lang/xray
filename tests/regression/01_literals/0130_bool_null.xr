// 测试：布尔值和 null
// ===== 布尔值基础 =====
@test
fn test_bool_true() {
    assert_eq(true, true)
    let b = true
    assert_eq(b, true)
}

@test
fn test_bool_false() {
    assert_eq(false, false)
    let b = false
    assert_eq(b, false)
}

@test
fn test_bool_equality() {
    assert_eq(true == true, true)
    assert_eq(false == false, true)
    assert_eq(true == false, false)
    assert_eq(true != false, true)
}

// ===== 布尔运算 =====
@test
fn test_bool_and() {
    assert_eq(true && true, true)
    assert_eq(true && false, false)
    assert_eq(false && true, false)
    assert_eq(false && false, false)
}

@test
fn test_bool_or() {
    assert_eq(true || true, true)
    assert_eq(true || false, true)
    assert_eq(false || true, true)
    assert_eq(false || false, false)
}

@test
fn test_bool_not() {
    assert_eq(!true, false)
    assert_eq(!false, true)
    assert_eq(!!true, true)
}

// ===== null 基础 =====
@test
fn test_null_basic() {
    let x = null
    assert_eq(x, null)
    assert_eq(x == null, true)
}

@test
fn test_null_comparison() {
    let x = null
    let y = null
    assert_eq(x == y, true)
    assert_eq(x != null, false)
}

@test
fn test_null_vs_value() {
    let x = null
    let y: int? = 0
    assert_eq(x == y, false)
    assert_eq(x != y, true)
}

// ===== 显式条件 =====
@test
fn test_explicit_bool_condition() {
    if (true) {
        assert(true)
    } else {
        assert(false)
    }
    if (false) {
        assert(false)
    } else {
        assert(true)
    }
}

@test
fn test_nullable_presence_condition() {
    let s: string? = null
    if (s) {
        assert(false)
    } else {
        assert(true)
    }
    let empty: string? = ""
    if (empty) {
        assert(true)
    } else {
        assert(false)
    }
    let zero: int? = 0
    if (zero) {
        assert(true)
    } else {
        assert(false)
    }
}

// ===== 空值合并 =====
@test
fn test_nullish_coalesce() {
    let x = null
    assert_eq(x ?? "default", "default")
    let y = "value"
    assert_eq(y ?? "default", "value")
    let z = 0
    assert_eq(z ?? 100, 0)
}

// ===== 可选链 =====
@test
fn test_optional_chain() {
    let obj = null
    assert_eq(obj?.property, null)
    let data = { "name": "test" }
    assert_eq(data?.name, "test")
}
