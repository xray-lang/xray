// 测试：提前返回

// ===== 函数提前返回 =====

@test
fn test_early_return() {
    fn findPositive(arr: Array<i64>) -> i64 {
        for (x in arr) {
            if (x > 0) {
                return x
            }
        }
        return -1
    }
    
    assertEqual(findPositive([-1, -2, 3, 4]), 3)
    assertEqual(findPositive([-1, -2, -3]), -1)
}

@test
fn test_guard_clause() {
    fn divide(a: i64, b: i64) -> i64? {
        if (b == 0) {
            return null
        }
        return a / b
    }
    
    assertEqual(divide(10, 2), 5)
    assertEqual(divide(10, 0), null)
}

// ===== 多条件提前返回 =====

@test
fn test_multiple_guards() {
    fn classify(n: i64) -> string {
        if (n < 0) { return "negative" }
        if (n == 0) { return "zero" }
        if (n < 10) { return "small" }
        if (n < 100) { return "medium" }
        return "large"
    }
    
    assertEqual(classify(-5), "negative")
    assertEqual(classify(0), "zero")
    assertEqual(classify(5), "small")
    assertEqual(classify(50), "medium")
    assertEqual(classify(500), "large")
}

// ===== 嵌套循环提前返回 =====

@test
fn test_nested_return() {
    fn findPair(arr: Array<i64>, target: i64) -> Array<i64>? {
        for (i in 0..len(arr)) {
            for (j in (i + 1)..len(arr)) {
                if (arr[i] + arr[j] == target) {
                    return [i, j]
                }
            }
        }
        return null
    }
    
    var result = findPair([1, 2, 3, 4], 5)
    assertEqual(result != null, true)
    assertEqual(result![0], 0)
    assertEqual(result![1], 3)
}

// ===== 递归提前返回 =====

@test
fn test_recursive_return() {
    fn binarySearch(arr: Array<i64>, target: i64, low: i64, high: i64) -> i64 {
        if (low > high) {
            return -1
        }
        var mid = (low + high) / 2
        if (arr[mid] == target) {
            return mid
        }
        if (arr[mid] < target) {
            return binarySearch(arr, target, mid + 1, high)
        }
        return binarySearch(arr, target, low, mid - 1)
    }
    
    var arr = [1, 3, 5, 7, 9]
    assertEqual(binarySearch(arr, 5, 0, len(arr) - 1), 2)
    assertEqual(binarySearch(arr, 4, 0, len(arr) - 1), -1)
}

// ===== 空返回 =====

@test
fn test_void_return() {
    var executed = false
    
    fn process(flag: bool) {
        if (!flag) {
            return
        }
        executed = true
    }
    
    process(false)
    assertEqual(executed, false)
    
    process(true)
    assertEqual(executed, true)
}
