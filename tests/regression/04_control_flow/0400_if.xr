// 测试：if 条件语句

// ===== 基础 if =====

@test
fn test_if_true() {
    var result = 0
    if (true) {
        result = 1
    }
    assertEqual(result, 1)
}

@test
fn test_if_false() {
    var result = 0
    if (false) {
        result = 1
    }
    assertEqual(result, 0)
}

@test
fn test_if_expression() {
    var x = 10
    var result = 0
    if (x > 5) {
        result = 1
    }
    assertEqual(result, 1)
}

// ===== if-else =====

@test
fn test_if_else_true() {
    var result = ""
    if (true) {
        result = "yes"
    } else {
        result = "no"
    }
    assertEqual(result, "yes")
}

@test
fn test_if_else_false() {
    var result = ""
    if (false) {
        result = "yes"
    } else {
        result = "no"
    }
    assertEqual(result, "no")
}

@test
fn test_if_else_expression() {
    var x = 3
    var result = ""
    if (x > 5) {
        result = "big"
    } else {
        result = "small"
    }
    assertEqual(result, "small")
}

// ===== if-else if-else =====

@test
fn test_elseif_first() {
    var x = 1
    var result = ""
    if (x == 1) {
        result = "one"
    } else if (x == 2) {
        result = "two"
    } else {
        result = "other"
    }
    assertEqual(result, "one")
}

@test
fn test_elseif_second() {
    var x = 2
    var result = ""
    if (x == 1) {
        result = "one"
    } else if (x == 2) {
        result = "two"
    } else {
        result = "other"
    }
    assertEqual(result, "two")
}

@test
fn test_elseif_else() {
    var x = 3
    var result = ""
    if (x == 1) {
        result = "one"
    } else if (x == 2) {
        result = "two"
    } else {
        result = "other"
    }
    assertEqual(result, "other")
}

@test
fn test_multiple_elseif() {
    var score = 75
    var grade = ""
    if (score >= 90) {
        grade = "A"
    } else if (score >= 80) {
        grade = "B"
    } else if (score >= 70) {
        grade = "C"
    } else if (score >= 60) {
        grade = "D"
    } else {
        grade = "F"
    }
    assertEqual(grade, "C")
}

// ===== 嵌套 if =====

@test
fn test_nested_if() {
    var x = 5
    var y = 10
    var result = ""
    
    if (x > 0) {
        if (y > 5) {
            result = "x>0, y>5"
        } else {
            result = "x>0, y<=5"
        }
    } else {
        result = "x<=0"
    }
    assertEqual(result, "x>0, y>5")
}

@test
fn test_deep_nested() {
    var a = 1
    var b = 2
    var c = 3
    var result = 0
    
    if (a > 0) {
        if (b > 0) {
            if (c > 0) {
                result = a + b + c
            }
        }
    }
    assertEqual(result, 6)
}

// ===== 显式条件（非 truthy） =====

@test
fn test_explicit_bool_condition() {
    var result = ""
    if (true) { result = "yes" } else { result = "no" }
    assertEqual(result, "yes")
    if (false) { result = "yes" } else { result = "no" }
    assertEqual(result, "no")
}

@test
fn test_nullable_presence_condition() {
    var s: string? = null
    var result = ""
    if (s) { result = "present" } else { result = "absent" }
    assertEqual(result, "absent")
    var empty: string? = ""
    if (empty) { result = "present" } else { result = "absent" }
    assertEqual(result, "present")
}

// ===== 复合条件 =====

@test
fn test_and_condition() {
    var x = 5
    var y = 10
    var result = false
    if (x > 0 && y > 0) {
        result = true
    }
    assertEqual(result, true)
}

@test
fn test_or_condition() {
    var x = -5
    var y = 10
    var result = false
    if (x > 0 || y > 0) {
        result = true
    }
    assertEqual(result, true)
}

@test
fn test_not_condition() {
    var flag = false
    var result = 0
    if (!flag) {
        result = 1
    }
    assertEqual(result, 1)
}

// ===== 边界条件 =====

@test
fn test_empty_if_body() {
    var x = 10
    if (x < 5) {
        // 空体
    }
    assertEqual(x, 10)  // 什么都没发生
}

@test
fn test_if_only_once() {
    var count = 0
    var x = 10
    
    if (x > 5) {
        count++
    }
    if (x > 3) {
        count++
    }
    assertEqual(count, 2)
}

