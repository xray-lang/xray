// 0442_match_struct_destructure.xr
// 测试：具名 struct 字段投影与数组解构；对象模式已删除。
// 覆盖：显式字段读取、标量 match、数组长度匹配、..rest、通配元素位与 guard。

// ===== 对象字段解构（簡寫） =====
struct Point {
    x: i64
    y: i64
}

struct Person {
    name: string
    age: i64
}

struct Config {
    mode: i64
    label: string
}

@test
fn test_struct_field_projection() {
    var p = Point{x: 3, y: 4}
    var r = p.x + p.y
    assertEqual(r, 7)
}

// ===== 对象字段重命名 + 簡寫混用 =====
@test
fn test_struct_named_fields() {
    var user = Person{name: "Bob", age: 5}
    var r = user.name + ":" + string(user.age)
    assertEqual(r, "Bob:5")
}

// ===== 对象可反驳字段子模式 =====
@test
fn test_match_struct_discriminant() {
    var cfg = Config{mode: 2, label: "go"}
    var r = match (cfg.mode) {
        1 => "one",
        2 => "two:" + cfg.label,
        _ => "other",
    }
    assertEqual(r, "two:go")
}

// ===== 数组解构 + ..rest =====
@test
fn test_match_array_rest() {
    var a = [10, 20, 30]
    match (a) {
        [first, ..rest] => {
            assertEqual(first, 10)
            assertEqual(len(rest), 2)
            assertEqual(rest[0], 20)
            assertEqual(rest[1], 30)
        },
        _ => { assert(false) },
    }
}

// ===== 数组按长度选择分支 =====
@test
fn test_match_array_length_select() {
    var pair = [1, 2]
    var r = match (pair) {
        [x] => x,
        [x, y] => x * 10 + y,
        _ => 0,
    }
    assertEqual(r, 12)
}

// ===== 空 rest =====
@test
fn test_match_array_empty_rest() {
    var single = [99]
    match (single) {
        [head, ..tail] => {
            assertEqual(head, 99)
            assertEqual(len(tail), 0)
        },
        _ => { assert(false) },
    }
}

// ===== 元素位通配 =====
@test
fn test_match_array_wildcards() {
    var triple = [7, 8, 9]
    var r = match (triple) {
        [_, mid, _] => mid,
        _ => 0,
    }
    assertEqual(r, 8)
}

// ===== 数组元素 guard（按值判断走守卫） =====
@test
fn test_match_array_guard() {
    var a = [5, 6]
    var r = match (a) {
        [x, y] if (x > 10) => "big",
        [x, y] => "small:" + string(x + y),
        _ => "none",
    }
    assertEqual(r, "small:11")
}
