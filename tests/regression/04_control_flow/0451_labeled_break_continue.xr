// 0451_labeled_break_continue.xr
// Test labeled break/continue on nested loops.

@test
fn test_labeled_break_exits_named_for_in() {
    var trace = ""
    outer: for (i in 0..4) {
        for (j in 0..4) {
            if (i == 2 && j == 1) {
                break outer
            }
            trace += string(i) + string(j) + ","
        }
    }
    assertEqual(trace, "00,01,02,03,10,11,12,13,20,")
}

@test
fn test_labeled_continue_targets_named_for_in() {
    var trace = ""
    outer: for (i in 0..3) {
        for (j in 0..4) {
            if (j == 1) {
                continue outer
            }
            trace += string(i) + string(j) + ","
        }
        trace += "unreachable,"
    }
    assertEqual(trace, "00,10,20,")
}

@test
fn test_labeled_continue_targets_traditional_for_increment() {
    var total = 0
    outer: for (var i = 0; i < 4; i++) {
        for (var j = 0; j < 4; j++) {
            if (j == 2) {
                continue outer
            }
            total += 1
        }
        total += 1000
    }
    assertEqual(total, 8)
}

@test
fn test_labeled_while_break_and_continue() {
    var i = 0
    var count = 0
    outer: while (i < 5) {
        var j = 0
        i += 1
        while (j < 5) {
            j += 1
            if (i == 3) {
                break outer
            }
            if (j == 2) {
                continue outer
            }
            count += 1
        }
    }
    assertEqual(count, 2)
}
