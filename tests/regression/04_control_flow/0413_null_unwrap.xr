// Null force unwrap (!) throws PanicInfo with code 413

@test
fn test_null_unwrap_throws_413() {
    var x: int? = null
    var caught = false
    try {
        var v = x!
        assert(false)
    } catch(e) {
        caught = true
        assert_eq(e.code, 413)
        // The code carries E0413; the message carries what went wrong. The
        // constructor strips a recognised "E0xxx: " prefix on purpose, so that
        // reporters can re-prefix from the code field without doubling it.
        assert(e.message.contains("unwrap"))
    }
    assert_eq(caught, true)
}

@test
fn test_non_null_unwrap_succeeds() {
    var y: int? = 42
    assert_eq(y!, 42)
}
