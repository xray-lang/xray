// Test: deopt recovery preserves all live variable values.
// After JIT deopts, the interpreter must continue with exactly the same
// variable state as if JIT had never been used.
// End-to-end correctness test for S8.3 (deopt reconstruction).

fn deopt_callee(x: int | string) -> int {
    if (typeof(x) == "string") {
        return x.length
    }
    return x * 2
}

// Verify deopt preserves caller's live variables (spill pressure)
fn deopt_spill_pressure() -> int {
    let a = 10
    let b = 20
    let c = 30
    let d = 40
    let e = 50

    // warm up JIT with int path
    let r1 = deopt_callee(1)
    let r2 = deopt_callee(2)

    // trigger deopt with string
    let r3 = deopt_callee("hi")

    // back to int
    let r4 = deopt_callee(3)

    // all caller variables must survive deopt
    return a + b + c + d + e + r1 + r2 + r3 + r4
    // 10+20+30+40+50 + 2+4 + 2 + 6 = 164
}

// Test deopt in a loop with accumulator state
fn deopt_loop_accum() -> int {
    let sum = 0
    for (let i = 0; i < 8; i++) {
        sum = sum + deopt_callee(i)
    }
    // sum = 0+2+4+6+8+10+12+14 = 56
    // now trigger deopt
    sum = sum + deopt_callee("abc")
    // sum = 56 + 3 = 59
    // continue with int
    sum = sum + deopt_callee(10)
    // sum = 59 + 20 = 79
    return sum
}

// Test nested calls where inner deopts but outer state is intact
fn outer_wrapper() -> int {
    let base = 1000
    let r = deopt_callee(5) + deopt_callee("test") + deopt_callee(7)
    // r = 10 + 4 + 14 = 28
    return base + r
    // 1000 + 28 = 1028
}

@test
fn test_deopt_spill_pressure() {
    assert_eq(deopt_spill_pressure(), 164)
}

@test
fn test_deopt_loop_accum() {
    assert_eq(deopt_loop_accum(), 79)
}

@test
fn test_deopt_nested_outer() {
    assert_eq(outer_wrapper(), 1028)
}
