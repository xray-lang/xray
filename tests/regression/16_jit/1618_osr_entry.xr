// Test: S8.4 OSR (on-stack replacement) entry correctness.
// Verifies that a function can be JIT-compiled while its loop is
// already running, and the transition preserves all local state.

// Simple hot loop — should trigger OSR
fn osr_simple_sum(n: int) -> int {
    let sum = 0
    for (let i = 0; i < n; i++) {
        sum = sum + i
    }
    return sum
}

// Nested loop — outer loop may OSR
fn osr_nested(n: int) -> int {
    let total = 0
    for (let i = 0; i < n; i++) {
        let inner = 0
        for (let j = 0; j < 10; j++) {
            inner = inner + j
        }
        total = total + inner
    }
    // inner = 0+1+...+9 = 45, total = n * 45
    return total
}

// Multiple live variables across OSR point
fn osr_multi_var(n: int) -> int {
    let a = 100
    let b = 200
    let c = 300
    let sum = 0
    for (let i = 0; i < n; i++) {
        sum = sum + a + b + c  // 600 per iteration
    }
    return sum + a + b + c
}

// Loop with conditional — ensures guard handling after OSR
fn osr_conditional(n: int) -> int {
    let even_sum = 0
    let odd_sum = 0
    for (let i = 0; i < n; i++) {
        if (i % 2 == 0) {
            even_sum = even_sum + i
        } else {
            odd_sum = odd_sum + i
        }
    }
    return even_sum - odd_sum
}

@test
fn test_osr_simple_sum() {
    // sum(0..99) = 4950
    assert_eq(osr_simple_sum(100), 4950)
}

@test
fn test_osr_nested() {
    assert_eq(osr_nested(20), 900)
}

@test
fn test_osr_multi_var() {
    // n=50: sum = 50*600 = 30000, + 600 = 30600
    assert_eq(osr_multi_var(50), 30600)
}

@test
fn test_osr_conditional() {
    // n=100: even_sum = 0+2+4+...+98 = 2450, odd_sum = 1+3+5+...+99 = 2500
    // result = 2450 - 2500 = -50
    assert_eq(osr_conditional(100), -50)
}
