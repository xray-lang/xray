// Test: S8.2 safepoint/stackmap — GC pressure during JIT execution.
// Allocates heavily in a hot loop so GC must scan JIT stack frames
// via safepoint stackmap. Verifies that live objects survive GC.

fn alloc_pressure() -> int {
    let count = 0
    for (let i = 0; i < 200; i++) {
        let arr = [i, i + 1, i + 2]
        let s = "item_" + string(i)
        if (arr[0] == i && s.length > 0) {
            count = count + 1
        }
    }
    return count
}

// Verify objects allocated before a hot loop survive GC triggered inside
fn objects_survive_gc() -> int {
    let kept = "preserved"
    let arr = [10, 20, 30]
    let sum = 0

    // Hot loop with allocation — may trigger GC
    for (let i = 0; i < 100; i++) {
        let tmp = [i, i * 2]
        sum = sum + tmp[0]
    }

    // Pre-loop objects must still be valid
    return arr[1] + sum + kept.length
}

// Array-of-arrays stress — tests GC scanning of nested heap objects
fn nested_alloc_stress() -> int {
    let total = 0
    for (let i = 0; i < 50; i++) {
        let inner = [i, i + 1]
        let outer = [inner[0], inner[1], i * 10]
        total = total + outer[2]
    }
    // total = sum(i*10 for i=0..49) = 10 * (49*50/2) = 12250
    return total
}

@test
fn test_alloc_pressure() {
    assert_eq(alloc_pressure(), 200)
}

@test
fn test_objects_survive_gc() {
    // arr[1]=20, sum=4950, kept.length=9 => 4979
    assert_eq(objects_survive_gc(), 4979)
}

@test
fn test_nested_alloc_stress() {
    assert_eq(nested_alloc_stress(), 12250)
}
