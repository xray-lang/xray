// 1620_jit_channel_call_resume.xr
// A JIT-compiled helper that blocks on ch.recv() must resume into the caller's
// OP_CALL destination, not complete the whole coroutine.

fn recv_int(ch: Channel<int>, fallback: int) -> int {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> fallback
    }
}

fn ping(n: int, c1: Channel<int>, c2: Channel<int>) -> int {
    let last = 0
    for (let i = 0; i < n; i++) {
        c1.send(i)
        last = recv_int(c2, -1)
    }
    return last
}

fn pong(n: int, c1: Channel<int>, c2: Channel<int>) -> int {
    let last = 0
    for (let i = 0; i < n; i++) {
        let msg = recv_int(c1, -1)
        c2.send(msg + 1)
        last = msg
    }
    return last
}

@test
fn test_jit_channel_call_resume_continues_caller() {
    shared const c1 = Channel(1)
    shared const c2 = Channel(1)
    let n = 220
    let t1 = go ping(n, c1, c2)
    let t2 = go pong(n, c1, c2)
    let r1 = await t1
    let r2 = await t2
    c1.close()
    c2.close()
    assert_eq(r1, n)
    assert_eq(r2, n - 1)
}
