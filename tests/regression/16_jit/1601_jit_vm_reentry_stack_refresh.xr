fn reentry_leaf(x: int) -> int {
    return x + 1
}

fn reentry_b(x: int) -> int {
    return reentry_leaf(x) + 1
}

fn reentry_c(x: int) -> int {
    return reentry_b(x) + 1
}

fn reentry_interpreted(x: int) -> int {
    return reentry_c(x) + 1
}

fn reentry_jit_driver() -> int {
    return reentry_interpreted(10)
}

fn reentry_after_jit(x: int) -> int {
    return x + 5
}

@test
fn test_jit_vm_reentry_refreshes_vm_stack_cache() {
    let value = reentry_jit_driver()
    let checked = reentry_after_jit(value)
    assert_eq(checked, 19)
}
