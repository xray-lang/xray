// Test: cycle collector reclaims mutual reference cycles
// The gc.collect() call triggers trial deletion on cycle candidates.

import gc

class Node {
    name: string
    next: Node | null = null

    constructor(name: string) {
        this.name = name
    }
}

@test
fn test_cycle_mutual_reference() {
    let a = new Node("A")
    let b = new Node("B")
    // Create cycle: A -> B -> A
    a.next = b
    b.next = a
    // gc.collect() should detect and free the dead cycle
    gc.collect()
    assert(true) // if we get here without leak/crash, pass
}

@test
fn test_non_cyclic_not_affected() {
    let a = new Node("solo")
    let b = new Node("chain")
    b.next = a
    // b -> a is NOT a cycle (a.next == null)
    gc.collect()
    // b is still live
    assert(b.next != null)
    assert(b.name == "chain")
}

@test
fn test_self_referencing_cycle() {
    let s = new Node("self")
    s.next = s  // self-cycle
    gc.collect()
    assert(true) // reclaimed or still live — no crash
}
