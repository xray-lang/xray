fn recv_timeout_until_close(ch: Channel<int>, ready: Channel<int>, done: Channel<int>, timeout_ms: int) {
    ready.send(1)
    match (ch.recvTimeout(timeout_ms)) {
        Recv.Value(value) -> done.send(value)
        _ -> done.send(-1)
    }
}

fn recv_int(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

@test
fn test_channel_close_wakes_timed_recv_fanout() {
    shared const waiter_count = 64
    shared const ch = new Channel<int>(0)
    shared const ready = new Channel<int>(0)
    shared const done = new Channel<int>(waiter_count)

    for (let i = 0; i < waiter_count; i++) {
        go recv_timeout_until_close(ch, ready, done, 2000)
    }

    for (let i = 0; i < waiter_count; i++) {
        assert_eq(recv_int(ready), 1)
    }

    for (let i = 0; i < 16; i++) {
        yield
    }

    ch.close()

    let closed_waiters = 0
    for (let i = 0; i < waiter_count; i++) {
        if (recv_int(done) == -1) {
            closed_waiters++
        }
    }

    assert_eq(closed_waiters, waiter_count)
    ready.close()
    done.close()
}
