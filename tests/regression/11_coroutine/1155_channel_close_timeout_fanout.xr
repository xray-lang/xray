fn recv_timeout_until_close(ch: Channel<i64>, ready: Channel<i64>, done: Channel<i64>, timeout_ms: i64) {
    ready.send(1)
    match (ch.recvTimeout(timeout_ms)) {
        Recv.Value { value } -> done.send(value)
        _ -> done.send(-1)
    }
}

fn recv_int(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

@test
fn test_channel_close_wakes_timed_recv_fanout() {
    const waiter_count = 64
    const ch = Channel<i64>(0)
    const ready = Channel<i64>(0)
    const done = Channel<i64>(waiter_count)

    for (var i = 0; i < waiter_count; i++) {
        go recv_timeout_until_close(ch, ready, done, 2000)
    }

    for (var i = 0; i < waiter_count; i++) {
        assertEqual(recv_int(ready), 1)
    }

    for (var i = 0; i < 16; i++) {
        Coro.yield()
    }

    ch.close()

    var closed_waiters = 0
    for (var i = 0; i < waiter_count; i++) {
        if (recv_int(done) == -1) {
            closed_waiters++
        }
    }

    assertEqual(closed_waiters, waiter_count)
    ready.close()
    done.close()
}
