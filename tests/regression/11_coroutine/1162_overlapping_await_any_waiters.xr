// Regression: multiple aggregate await waiters may observe the same Task.

import time

fn delayed_value() -> i64 {
    time.sleep(80)
    return 9
}

fn await_any_report(id: i64, task: Task<i64>, ready: Channel<i64>, out: Channel<i64>) {
    ready.send(id)
    var value = await any [task]
    out.send(id * 100 + value)
}

fn recv_int(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

@test
fn test_overlapping_await_any_waiters() {
    const ready = Channel<i64>(2)
    const out = Channel<i64>(2)

    const task = go delayed_value()
    var a = go await_any_report(1, task, ready, out)
    var b = go await_any_report(2, task, ready, out)

    recv_int(ready)
    recv_int(ready)

    var first = recv_int(out)
    var second = recv_int(out)
    print(first + second)

    await a
    await b
    ready.close()
    out.close()
    print("done")
}

// 期望输出：
// 318
// done
