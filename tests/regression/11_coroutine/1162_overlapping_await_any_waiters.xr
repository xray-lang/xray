// Regression: multiple aggregate await waiters may observe the same Task.

import time

fn delayed_value() -> int {
    time.sleep(80)
    return 9
}

fn await_any_report(id: int, task: Task, ready: Channel<int>, out: Channel<int>) {
    ready.send(id)
    let value = await any [task]
    out.send(id * 100 + value)
}

fn recv_int(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

@test
fn test_overlapping_await_any_waiters() {
    const ready = new Channel<int>(2)
    const out = new Channel<int>(2)

    let task = go delayed_value()
    let a = go await_any_report(1, task, ready, out)
    let b = go await_any_report(2, task, ready, out)

    recv_int(ready)
    recv_int(ready)

    let first = recv_int(out)
    let second = recv_int(out)
    print(first + second)

    await a
    await b
    ready.close()
    out.close()
    print("done")
}

// 期望输出：
// 318
// done
