/*
** 作者：xingleixu@gmail.com
** 测试 scope 结构化并发基础功能
**
** scope { ... } 会自动等待内部所有 go 启动的协程完成
**
** 注意：协程函数通过参数传递数据，避免闭包捕获非线程安全变量
*/

fn task1(counter: Atomic<int>) -> int {
    counter.fetchAdd(2)
    return 1
}
fn task2(counter: Atomic<int>) -> int {
    counter.fetchAdd(2)
    return 2
}
fn task3(counter: Atomic<int>) -> int {
    counter.fetchAdd(2)
    return 3
}
fn inner1_task(counter: Atomic<int>) {
    counter.fetchAdd(1)
}
fn nested_task(counter: Atomic<int>) {
    counter.fetchAdd(1)
}

@test
fn test_scope_basic() {
    const results: Atomic<int> = Atomic<int>(0)




    // 测试 scope 自动等待
    print("=== scope 基础测试 ===")

    scope {
        go task1(results)
        go task2(results)
        go task3(results)
    }

    // scope 退出后，所有任务应该已完成
    print("scope 结束")
    var taskCount = results.load()
    print("任务数量:", taskCount)

    // 检查所有任务都执行了
    if (taskCount >= 6) {
        print("所有任务完成")
    } else {
        print("错误：任务未完成")
    }

    print("=== 嵌套 scope 测试 ===")

    const outer_results: Atomic<int> = Atomic<int>(0)



    scope {
        outer_results.fetchAdd(1)
        go inner1_task(outer_results)

        scope {
            outer_results.fetchAdd(1)
            go nested_task(outer_results)
        }

        outer_results.fetchAdd(1)
    }

    print("嵌套 scope 结果数量:", outer_results.load())
}

test_scope_basic()
