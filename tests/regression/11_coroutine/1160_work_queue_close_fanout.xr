import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Regression: WorkQueue.close wakes all blocked pop waiters.

import time

const q: WorkQueue<i64> = WorkQueue<i64>(2, 2)

fn pop_or_sentinel() -> i64 {
    var value = q.pop(0)
    return value ?? -1
}

@test
fn test_work_queue_close_fanout() {
    var t1 = go pop_or_sentinel()
    var t2 = go pop_or_sentinel()
    var t3 = go pop_or_sentinel()
    var t4 = go pop_or_sentinel()

    time.sleep(1)
    q.close()

    var results = await all [t1, t2, t3, t4]
    assertEqual(results[0], -1)
    assertEqual(results[1], -1)
    assertEqual(results[2], -1)
    assertEqual(results[3], -1)
}
