/*
** 测试协程错误隔离
** 协程内的错误可通过 awaitResult 显式观察
** 作者：xingleixu@gmail.com
*/

// 会抛出错误的任务

fn error_task() -> i64 {
    var x: i64 = 1 / 0  // 除零错误
    return x
}
fn normal_task() -> i64 {
    return 42
}

@test
fn test_error_isolation() {

    // 正常任务

    // 测试1：错误隔离
    print("test1: error isolation")
    var task1 = go error_task()
    var result1 = task1.awaitResult()
    print("  done:", task1.done)
    print("  failed:", match (result1) {
        TaskResult.Failed { error: _ } -> true
        _ -> false
    })

    // 测试2：错误不影响其他协程
    print("test2: error does not affect other coroutines")
    var task2 = go normal_task()
    var result2 = await task2
    print("  result:", result2)
}
