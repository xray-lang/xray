// Regression: a receive-only blocking select must wake when a producer
// refills a buffered channel after the select coroutine has gone to sleep.

fn produce(ch: Channel<i64>, count: i64) {
    for (var i = 0; i < count; i++) {
        ch.send(i)
    }
    ch.close()
}

@test
fn test_select_wakes_after_buffer_refill() {
    const ch = Channel<i64>(10)
    var task = go produce(ch, 50)

    var received = 0
    var sum = 0
    while (received < 50) {
        select {
            msg from ch -> {
                received++
                sum = sum + msg
            }
        }
    }

    await task
    assertEqual(received, 50)
    assertEqual(sum, 1225)
}
