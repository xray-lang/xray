// Cross-worker stress for structured-concurrency scope paths.
//
// A plain `scope` is a wait barrier: a failing child must not disturb its
// siblings, and no child may be lost. The test observes completion through an
// explicit channel.

enum RaceErr { Msg(string) }

const ITERATIONS = 50
const FAILING_PER_SCOPE = 200
const SUCCEEDING_PER_SCOPE = 50

fn make_failing(id: int) -> int {
    var x = 0
    for (var k = 0; k < 50; k++) {
        x = x + k
    }
    throw RaceErr.Msg("err_" + string(id))
    return x
}

fn make_failing_report(ch: Channel<int>, id: int) -> int {
    var x = 0
    for (var k = 0; k < 50; k++) {
        x = x + k
    }
    ch.send(-1)
    throw RaceErr.Msg("err_" + string(id))
    return x
}

fn make_ok_report(ch: Channel<int>, id: int) -> int {
    var x = 0
    for (var k = 0; k < 50; k++) {
        x = x + k
    }
    ch.send(1)
    return x + id
}

fn drain_counts(ch: Channel<int>, expected: int) -> Array<int> {
    var counts: Array<int> = [0, 0]
    for (var i = 0; i < expected; i++) {
        match (ch.recv()) {
            Recv.Value(v) -> {
                if (v < 0) {
                    counts[0] = counts[0] + 1
                } else {
                    counts[1] = counts[1] + 1
                }
            }
            _ -> {}
        }
    }
    return counts
}

@test
fn test_scope_loses_no_children() {
    for (var iter = 0; iter < ITERATIONS; iter++) {
        const ch = Channel<int>(FAILING_PER_SCOPE + SUCCEEDING_PER_SCOPE)
        scope {
            for (var i = 0; i < FAILING_PER_SCOPE; i++) {
                go make_failing_report(ch, i)
            }
            for (var i = 0; i < SUCCEEDING_PER_SCOPE; i++) {
                go make_ok_report(ch, i)
            }
        }
        var counts = drain_counts(ch, FAILING_PER_SCOPE + SUCCEEDING_PER_SCOPE)
        assert_eq(counts[0], FAILING_PER_SCOPE)
        assert_eq(counts[1], SUCCEEDING_PER_SCOPE)
        ch.close()
    }
}

@test
fn test_scope_all_success() {
    for (var iter = 0; iter < 5; iter++) {
        const ch = Channel<int>(FAILING_PER_SCOPE)
        scope {
            for (var i = 0; i < FAILING_PER_SCOPE; i++) {
                go make_ok_report(ch, i)
            }
        }
        var counts = drain_counts(ch, FAILING_PER_SCOPE)
        assert_eq(counts[0], 0)
        assert_eq(counts[1], FAILING_PER_SCOPE)
        ch.close()
    }
}

@test
fn test_linked_first_error_deterministic() {
    for (var iter = 0; iter < ITERATIONS; iter++) {
        var caught = false
        var msg = ""
        try {
            linked scope {
                for (var i = 0; i < FAILING_PER_SCOPE; i++) {
                    go make_failing(i)
                }
            }
        } catch (e) {
            caught = true
            msg = string(e)
        }
        assert(caught, "linked scope must propagate child error")
        assert(msg.contains("err_"), "first_error must be a child error")
    }
}
