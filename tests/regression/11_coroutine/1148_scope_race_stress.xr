// Cross-worker race regression for the structured-concurrency scope path.
//
// Targets the three races CORO-10 used to expose:
//
//   A. linked scope first_error: two failing children both see
//      XR_IS_NULL(first_error) and both write — winner non-deterministic
//      but must be a real child error string.
//
//   B. supervisor outcomes[] lazy-init lost update: two failing children
//      both see scope->outcomes == NULL, both allocate, the second store
//      overwrites the first — outcomes collected into the displaced array
//      are silently lost.
//
//   C. supervisor outcomes[] concurrent push: two pushes interleave on
//      length / data and corrupt the array.
//
// Eager-allocation of outcomes[] at scope entry plus moving
// record_child_completion inside the scope spinlock closes B and C; A is
// serialized as a side effect.
//
// This stress harness spawns many failing children per scope across
// many iterations so cross-worker scheduling exercises the race
// window. It is multicore-aware: `xray test` runs with auto-detected
// num_workers > 1 on any host with multiple cores.
//
// Run mode: scripts/run_regression_tests.sh forces --no-jit for this
// file because the JIT register allocator currently mis-assigns
// overlapping live ranges on the try/catch + linked scope path used
// by Test 3 (independent JIT bug; the scope race fix being verified
// here is in the interpreter / runtime path, not in the JIT).

enum RaceErr { Msg(string) }

const ITERATIONS = 50
const FAILING_PER_SCOPE = 200
const SUCCEEDING_PER_SCOPE = 50

// Each child does a bit of arithmetic before throwing so several
// children overlap in flight on different workers — this widens the
// race window for the wake_waiter scope-side bookkeeping.
fn make_failing(id: int) -> int {
    let x = 0
    for (let k = 0; k < 50; k++) {
        x = x + k
    }
    throw RaceErr.Msg("err_" + string(id))
    return x
}

fn make_ok(id: int) -> int {
    let x = 0
    for (let k = 0; k < 50; k++) {
        x = x + k
    }
    return x + id
}

fn count_success(outcomes: Array<TaskOutcome>) -> int {
    let count = 0
    for (let i = 0; i < outcomes.length; i++) {
        match (outcomes[i]) {
            TaskOutcome.Success(_) -> { count = count + 1 }
            _ -> {}
        }
    }
    return count
}

fn count_failed(outcomes: Array<TaskOutcome>) -> int {
    let count = 0
    for (let i = 0; i < outcomes.length; i++) {
        match (outcomes[i]) {
            TaskOutcome.Failed(_) -> { count = count + 1 }
            _ -> {}
        }
    }
    return count
}

fn failed_payloads_valid(outcomes: Array<TaskOutcome>) -> bool {
    for (let i = 0; i < outcomes.length; i++) {
        match (outcomes[i]) {
            TaskOutcome.Failed(err) -> {
                match (err) {
                    RaceErr.Msg(msg) -> {
                        if (!msg.includes("err_")) {
                            return false
                        }
                    }
                    _ -> { return false }
                }
            }
            _ -> { return false }
        }
    }
    return true
}

// Test 1 — supervisor: every child must produce one TaskOutcome; total
// success/failure counts are deterministic across all iterations.
@test
fn test_supervisor_no_lost_updates() {
    for (let iter = 0; iter < ITERATIONS; iter++) {
        let outcomes = supervisor scope {
            for (let i = 0; i < FAILING_PER_SCOPE; i++) {
                go make_failing(i)
            }
            for (let i = 0; i < SUCCEEDING_PER_SCOPE; i++) {
                go make_ok(i)
            }
        }
        assert_eq(outcomes.length, FAILING_PER_SCOPE + SUCCEEDING_PER_SCOPE)
        assert_eq(count_failed(outcomes), FAILING_PER_SCOPE)
        assert_eq(count_success(outcomes), SUCCEEDING_PER_SCOPE)
    }
}

// Test 2 — supervisor: every Failed payload must be the original enum
// produced by some failing child, with no torn / NULL slots from a
// concurrent xr_array_push.
@test
fn test_supervisor_no_torn_pushes() {
    for (let iter = 0; iter < ITERATIONS; iter++) {
        let outcomes = supervisor scope {
            for (let i = 0; i < FAILING_PER_SCOPE; i++) {
                go make_failing(i)
            }
        }
        assert_eq(outcomes.length, FAILING_PER_SCOPE)
        assert_eq(count_failed(outcomes), FAILING_PER_SCOPE)
        assert(failed_payloads_valid(outcomes), "failed payloads must stay intact")
    }
}

// Test 3 — linked scope: even with many concurrent failures the scope
// must throw exactly one error (the latched first_error). The string
// form must be a valid err_<n> from one of the children.
@test
fn test_linked_first_error_deterministic() {
    for (let iter = 0; iter < ITERATIONS; iter++) {
        let caught = false
        let msg = ""
        try {
            linked scope {
                for (let i = 0; i < FAILING_PER_SCOPE; i++) {
                    go make_failing(i)
                }
            }
        } catch (e) {
            caught = true
            msg = string(e)
        }
        assert(caught, "linked scope must propagate child error")
        // Accept any err_<n>; we do not depend on a specific winner.
        assert(msg.includes("err_"), "first_error must be a child error")
    }
}

// Test 4 — supervisor: all-success outcomes must stay deterministic under load.
@test
fn test_supervisor_all_success() {
    for (let iter = 0; iter < 5; iter++) {
        let outcomes = supervisor scope {
            for (let i = 0; i < FAILING_PER_SCOPE; i++) {
                go make_ok(i)
            }
        }
        assert_eq(outcomes.length, FAILING_PER_SCOPE)
        assert_eq(count_success(outcomes), FAILING_PER_SCOPE)
        assert_eq(count_failed(outcomes), 0)
    }
}
