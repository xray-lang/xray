// 测试 go { block } 匿名闭包协程

@test
fn test_go_block() {
    // 基本形式
    var t1 = go fn() -> int {
        return 100
    }()
    print(await t1)  // 100

    // 多个匿名协程
    var t2 = go fn() -> int {
        return 200
    }()
    var t3 = go fn() -> int {
        return 300
    }()

    var results = await all [t2, t3]
    print(results[0])  // 200
    print(results[1])  // 300

    print("done")
}

// 期望输出：
// 100
// 200
// 300
// done

test_go_block()
