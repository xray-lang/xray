shared const maps = Channel(256)
shared const done = Channel(8)

let PRODUCERS = 4
let SENDS_PER_PRODUCER = 5000

fn producer(id: int) -> int {
    let m: Map<int, int> = #{}
    m.set(id, id + 1)
    m.set(id + 1000, id + 2)

    for (let i = 0; i < SENDS_PER_PRODUCER; i++) {
        maps.send(m)
    }

    done.send(SENDS_PER_PRODUCER)
    return SENDS_PER_PRODUCER
}

fn recv_map_size() -> int {
    return match (maps.recv()) {
        Recv.Value(m) -> m.size
        _ -> -1
    }
}

fn recv_done_count() -> int {
    return match (done.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

@test
fn test_channel_map_deep_copy_stress() {
    for (let p = 0; p < PRODUCERS; p++) {
        go producer(p)
    }

    let total = PRODUCERS * SENDS_PER_PRODUCER
    let sum = 0
    for (let i = 0; i < total; i++) {
        sum = sum + recv_map_size()
    }

    let completed = 0
    for (let p = 0; p < PRODUCERS; p++) {
        completed = completed + recv_done_count()
    }

    assert_eq(sum, total * 2)
    assert_eq(completed, total)

    maps.close()
    done.close()
}
