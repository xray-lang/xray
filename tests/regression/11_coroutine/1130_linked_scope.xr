// Test linked scope: child enum error propagates to parent via the
// value-return error channel, observed by the parent's `catch (e)`.
//
// A linked scope's first child failure is re-raised at the scope
// boundary (OP_SCOPE_EXIT).  Value-channel `throw <enum>` failures
// surface through the value channel so `catch (e)` catches them and
// `match` recovers the payload.

enum WorkerErr { Failed(code: i64) }

fn failing_worker() -> i64 {
    throw WorkerErr.Failed(1)
    return 0
}
fn ok_worker() -> i64 {
    return 42
}
fn test_linked_scope_error() {
    var caught = false
    var code = -1
    try {
        linked scope {
            go ok_worker()
            go failing_worker()
        }
    } catch (e) {
        caught = true
        match (e) {
            WorkerErr.Failed(c) -> { code = c }
            _ -> {}
        }
    }
    assert(caught, "linked scope should have thrown child error")
    assertEqual(code, 1)
}
fn test_normal_scope_no_error() {
    var caught = false
    try {
        scope {
            go ok_worker()
            go failing_worker()
        }
    } catch (e) {
        caught = true
    }
    assert(!caught, "normal scope should not throw child error")
}
fn test_linked_scope_success() {
    var caught = false
    try {
        linked scope {
            go ok_worker()
            go ok_worker()
        }
    } catch (e) {
        caught = true
    }
    assert(!caught, "linked scope with all success should not throw")
}

@test
fn test_linked_scope() {
    // Test 1: linked scope with a failing child should throw
    // Test 2: normal scope with a failing child should NOT throw
    // Test 3: linked scope with all success should NOT throw
    test_linked_scope_error()
    test_normal_scope_no_error()
    test_linked_scope_success()
}
