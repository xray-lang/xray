/*
** 测试协程优先级 API 和调度效果
** 作者：xingleixu@gmail.com
**
** Test 1: setPriority(task, 0/1/2) API 可用性
** Test 2: 先创建 LOW 任务、后创建 HIGH 任务，全部就绪后统一释放
**         验证 HIGH 在 soft priority 调度中更早完成
*/

fn compute(n: int) -> int {
    return n * n
}

fn work_and_report(label: string, start: Channel<int>, ready: Channel<int>,
                   ch: Channel<string>) -> string {
    ready.send(1)
    start.recv()

    let sum = 0
    for (let i = 0; i < 400; i++) {
        sum = sum + i
        if (i % 20 == 0) { yield }
    }
    ch.send(label)
    return label
}

@test
fn test_coro_priority() {
    // Test 1: setPriority API with all priority levels
    print("test1: setPriority API")
    let t1 = go compute(3)
    Coro.setPriority(t1, 0)
    print("  low:", await t1)
    let t2 = go compute(4)
    Coro.setPriority(t2, 1)
    print("  normal:", await t2)
    let t3 = go compute(5)
    Coro.setPriority(t3, 2)
    print("  high:", await t3)

    // Test 2: Priority scheduling effect
    // LOW tasks created first (FIFO-advantaged), HIGH tasks created after
    // If priority works, HIGH still completes earlier
    print("test2: priority scheduling")
    const total_low = 10
    const total_high = 10
    const total = total_low + total_high
    const start = new Channel<int>(total)
    const ready = new Channel<int>(total)
    const ch = new Channel<string>(total)

    for (let i = 0; i < total_low; i++) {
        go(priority: Coro.LOW) work_and_report("L", start, ready, ch)
    }
    for (let i = 0; i < total_high; i++) {
        go(priority: Coro.HIGH) work_and_report("H", start, ready, ch)
    }

    for (let i = 0; i < total; i++) {
        assert_eq(ready.recv(), 1)
    }
    for (let i = 0; i < total; i++) {
        start.send(1)
    }

    let high_early = 0
    for (let i = 0; i < total; i++) {
        let label = ch.recv()
        if (i < total_high && label == "H") {
            high_early = high_early + 1
        }
    }
    start.close()
    ready.close()
    ch.close()

    // With priority scheduling, majority of HIGH tasks complete in first half
    print("  priority effective:", high_early >= 6)
    assert(high_early >= 6, "high priority tasks should complete earlier")
    print("done")
}

// 期望输出：
// test1: setPriority API
//   low: 9
//   normal: 16
//   high: 25
// test2: priority scheduling
//   priority effective: true
// done
