fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_array(ch: Channel<Array<int>>) -> Array<int> {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> []
    }
}

@test
fn test_channel_send_copy_preserves_source() {
    let ch: Channel<Array<int>> = Channel(1)
    let xs = [1, 2]
    ch.send(copy(xs))
    xs.push(3)

    let got = recv_array(ch)
    got.push(99)

    assert_eq(xs.length, 3)
    assert_eq(got.length, 3)
    assert_eq(got[0], 1)
    assert_eq(got[1], 2)
    assert_eq(got[2], 99)
    ch.close()
}

@test
fn test_channel_try_send_copy_preserves_source() {
    let ch: Channel<Array<int>> = Channel(1)
    let xs = [4, 5]
    assert(sent(ch.trySend(copy(xs))))
    xs.push(6)

    let got = recv_array(ch)
    assert_eq(xs.length, 3)
    assert_eq(got.length, 2)
    assert_eq(got[0], 4)
    assert_eq(got[1], 5)
    ch.close()
}

@test
fn test_channel_send_timeout_copy_preserves_source() {
    let ch: Channel<Array<int>> = Channel(1)
    let xs = [7, 8]
    assert(sent(ch.sendTimeout(copy(xs), 0)))
    xs.push(9)

    let got = recv_array(ch)
    assert_eq(xs.length, 3)
    assert_eq(got.length, 2)
    assert_eq(got[0], 7)
    assert_eq(got[1], 8)
    ch.close()
}

@test
fn test_channel_send_move_transfers_source() {
    let ch: Channel<Array<int>> = Channel(1)
    let xs = [10, 11]
    ch.send(move xs)

    let got = recv_array(ch)
    assert_eq(got.length, 2)
    assert_eq(got[0], 10)
    assert_eq(got[1], 11)
    ch.close()
}
