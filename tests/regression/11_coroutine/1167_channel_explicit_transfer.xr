fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_array(ch: Channel<Array<i64>>) -> Array<i64> {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> []
    }
}

fn forward_array(ch: Channel<Array<i64>>, data: move Array<i64>) {
    ch.send(move data)
}

@test
fn test_channel_send_copy_preserves_source() {
    const ch: Channel<Array<i64>> = Channel(1)
    var xs = [1, 2]
    ch.send(copy(xs))
    xs.push(3)

    var got = recv_array(ch)
    got.push(99)

    assertEqual(len(xs), 3)
    assertEqual(len(got), 3)
    assertEqual(got[0], 1)
    assertEqual(got[1], 2)
    assertEqual(got[2], 99)
    ch.close()
}

@test
fn test_channel_try_send_copy_preserves_source() {
    const ch: Channel<Array<i64>> = Channel(1)
    var xs = [4, 5]
    assert(sent(ch.trySend(copy(xs))))
    xs.push(6)

    var got = recv_array(ch)
    assertEqual(len(xs), 3)
    assertEqual(len(got), 2)
    assertEqual(got[0], 4)
    assertEqual(got[1], 5)
    ch.close()
}

@test
fn test_channel_send_timeout_copy_preserves_source() {
    const ch: Channel<Array<i64>> = Channel(1)
    var xs = [7, 8]
    assert(sent(ch.sendTimeout(copy(xs), 0)))
    xs.push(9)

    var got = recv_array(ch)
    assertEqual(len(xs), 3)
    assertEqual(len(got), 2)
    assertEqual(got[0], 7)
    assertEqual(got[1], 8)
    ch.close()
}

@test
fn test_channel_send_move_transfers_source() {
    const ch: Channel<Array<i64>> = Channel(1)
    var xs = Array<i64>(2, 0)
    xs[0] = 10
    xs[1] = 11
    ch.send(move xs)

    var got = recv_array(ch)
    assertEqual(len(got), 2)
    assertEqual(got[0], 10)
    assertEqual(got[1], 11)
    ch.close()
}

@test
fn test_channel_send_helper_move_transfers_owned_param() {
    const ch: Channel<Array<i64>> = Channel(1)
    var xs = Array<i64>(2, 0)
    xs[0] = 12
    xs[1] = 13
    forward_array(ch, move xs)

    var got = recv_array(ch)
    assertEqual(len(got), 2)
    assertEqual(got[0], 12)
    assertEqual(got[1], 13)
    ch.close()
}
