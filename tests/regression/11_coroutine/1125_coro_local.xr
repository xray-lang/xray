/*
** Typed coroutine-local storage.
**
** Covers distinct typed slots, per-coroutine isolation, preservation of the
** caller's values, and the nullable result of an unset slot.
*/

@test
fn test_coro_local() {
    var nameLocal = Coro.Local<string>()
    var countLocal = Coro.Local<i64>()
    nameLocal.set("main")
    countLocal.set(42)
    assert_eq(nameLocal.get(), "main")
    assert_eq(countLocal.get(), 42)

    var idLocal = Coro.Local<i64>()
    var idTask = go fn(slot: CoroLocal<i64>) -> i64 {
        slot.set(1)
        return slot.get() ?? -1
    }(copy(idLocal))
    assert_eq(await idTask, 1)
    assert_eq(idLocal.get(), null)

    var valueLocal = Coro.Local<string>()
    var taskA = go fn(slot: CoroLocal<string>) -> string {
        slot.set("A")
        return slot.get() ?? "missing"
    }(copy(valueLocal))
    var taskB = go fn(slot: CoroLocal<string>) -> string {
        slot.set("B")
        return slot.get() ?? "missing"
    }(copy(valueLocal))
    assert_eq(await taskA, "A")
    assert_eq(await taskB, "B")

    assert_eq(nameLocal.get(), "main")
    assert_eq(countLocal.get(), 42)
    assert_eq(Coro.Local<i64>().get(), null)
}
