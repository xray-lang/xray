// Regression: low-priority work must make progress under high-priority pressure.

fn priority_work(label: string, ch: Channel<string>, rounds: int) -> string {
    for (let i = 0; i < rounds; i++) {
        if (i % 4 == 0) {
            yield
        }
    }
    ch.send(label)
    return label
}

@test
fn test_low_priority_aging_progress() {
    const total_high = 8
    const ch = new Channel<string>(total_high + 1)

    for (let i = 0; i < total_high; i++) {
        go(priority: Coro.HIGH) priority_work("H", ch, 120)
    }
    go(priority: Coro.LOW) priority_work("L", ch, 8)

    let low_index = -1
    for (let i = 0; i < total_high + 1; i++) {
        let label = ch.recv()
        if (label == "L") {
            low_index = i
        }
    }
    ch.close()

    assert_eq(low_index >= 0, true)
    assert_eq(low_index < total_high, true)
}
