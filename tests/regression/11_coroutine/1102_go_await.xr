// 测试 go/await 表达式
// 第一阶段：同步执行版本

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn multiply(x: i64, y: i64) -> i64 {
    return x * y
}

@test
fn test_go_await() {
    // go 启动协程（同步执行）
    var task1 = go add(10, 20)
    var task2 = go multiply(5, 6)

    // await 获取结果
    var result1 = await task1
    var result2 = await task2

    print(result1)  // 30
    print(result2)  // 30

    // 组合使用
    var task3 = go add(result1, result2)
    var final_result = await task3
    print(final_result)  // 60

    print("done")
}

// 期望输出：
// 30
// 30
// 60
// done

test_go_await()
