// Coro.dump() 和 Coro.stalled() 测试
// 作者：xingleixu@gmail.com

fn worker(c: Channel<int>) -> string {
    c.send(42)
    return "done"
}

@test
fn test_coro_dump() {
    print("test1: Coro.stats()")
    var stats = Coro.stats()
    print("stats total:", stats.total)

    print("test2: Coro.dump()")
    Coro.dump()

    print("test3: Coro.stalled()")
    var stalled = Coro.stalled()
    print("stalled:", len(stalled))

    print("test4: with coroutines")
    const ch = Channel<int>(1)


    var t = go(name: "test-worker") worker(ch)
    var result = await t
    print("worker result:", result)

    print("test5: final dump")
    Coro.dump(10)
}

test_coro_dump()
