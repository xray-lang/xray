// 测试生产者-消费者模型

fn recv_value(r: Recv<i64>) -> i64 {
    return match (r) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

fn recv_ok(r: Recv<i64>) -> bool {
    return match (r) {
        Recv.Value { value: _ } -> true
        _ -> false
    }
}

@test
fn test_main() {
    const ch = Channel<i64>(10)
    
    // 生产者发送数据
    var i = 0
    while (i < 3) {
        ch.trySend(100 + i)
        i = i + 1
    }
    i = 0
    while (i < 3) {
        ch.trySend(200 + i)
        i = i + 1
    }
    
    // 消费者接收数据（使用 Recv<T>）
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var r3 = ch.tryRecv()
    var r4 = ch.tryRecv()
    var r5 = ch.tryRecv()
    var r6 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    var v3 = recv_value(r3)
    var v4 = recv_value(r4)
    var v5 = recv_value(r5)
    var v6 = recv_value(r6)
    
    print(v1)  // 100
    print(v2)  // 101
    print(v3)  // 102
    print(v4)  // 200
    print(v5)  // 201
    print(v6)  // 202
    print(recv_ok(r1) && recv_ok(r2) && recv_ok(r3) && recv_ok(r4) && recv_ok(r5) && recv_ok(r6))  // true
    
    print("done")
}

