/*
** const 共享值与 var move 语义测试
** 作者：xingleixu@gmail.com
**
** 测试内容：
**   - const: 共享存储，引用计数共享，并发读取
**   - const: 稳定共享身份，可直接跨协程传递
**   - move: 唯一根显式所有权转移（用于 go / ch.send）
**   - 普通变量: 通过 copy(...) 显式深拷贝后传递给协程
*/

fn recvArray(ch: Channel<Array<int>>) -> Array<int> {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> []
    }
}

type Config = { name: string, value: int }
type StepMessage = { step: int }
type CountRecord = { count: int }

fn emptyStep() -> StepMessage {
    return { step: 0 }
}

fn recvStep(ch: Channel<StepMessage>) -> StepMessage {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> emptyStep()
    }
}

// Test 1: shared — concurrent read (zero-copy via refcount)
@test
fn test_shared_const() {
    print("=== Test shared ===")

    const config: Config = {
        name: "test",
        value: 42
    }
    print(config)

    // Multiple coroutines read the same shared (zero-copy)
    var t1 = go fn(c: Config) -> int {
        return c.value
    }(config)

    var t2 = go fn(c: Config) -> int {
        return c.value * 2
    }(config)

    var r1 = await t1
    var r2 = await t2
    print("coro1:", r1)
    print("coro2:", r2)
    print("results:", r1, r2)  // 42 84
}

// Test 2: move with go — ownership transfer of an owned root to coroutine
@test
fn test_move_go() {
    print("=== Test move go ===")

    var data: CountRecord = { count: 10 }

    // 'move data' transfers the owned root to child coroutine
    var task = go fn(d: move CountRecord) -> int {
        print("child got:", d.count)
        return d.count + 1
    }(move data)

    var result = await task
    print("child result:", result)  // 11
    // data is no longer usable here (compile error if referenced)
}

// Test 3: move with ch.send — ownership transfer via channel
@test
fn test_move_channel_send() {
    print("=== Test move channel send ===")

    const ch: Channel<Array<int>> = Channel(1)
    var payload = Array<int>(3, 0)
    payload[0] = 10
    payload[1] = 20
    payload[2] = 30

    // send with move: transfers ownership through channel
    ch.send(move payload)
    // payload is no longer usable here (compile error if referenced)

    var received = recvArray(ch)
    print("received:", received)   // [10, 20, 30]
    ch.close()
}

// Test 4: normal variable — explicit copy to coroutine (no move)
@test
fn test_normal_copy() {
    print("=== Test normal copy ===")

    var arr = [1, 2, 3]

    // Explicit copy: coroutine gets a deep copy
    var task = go fn(data: move Array<int>) {
        data.push(4)  // does not affect original
        return len(data)
    }(copy(arr))

    var result = await task
    print("original:", arr)        // [1, 2, 3] (unchanged)
    print("coro result:", result)  // 4
}

// Test 5: move in pipeline — sequential ownership transfer via channel
@test
fn test_move_pipeline() {
    print("=== Test move pipeline ===")

    const ch: Channel<StepMessage> = Channel(1)
    var msg: StepMessage = { step: 0 }

    // Stage 1: modify and move-send
    var t1 = go fn(c: Channel<StepMessage>, d: move StepMessage) {
        var next: StepMessage = copy(d)
        next.step = next.step + 1
        print("stage1:", next.step)
        c.send(move next)
    }(ch, move msg)

    await t1
    // msg is no longer usable here (moved in go call above)

    // Stage 2: receive and process
    var t2 = go fn(c: Channel<StepMessage>) -> int {
        var d = recvStep(c)
        d.step = d.step + 1
        print("stage2:", d.step)
        return d.step
    }(ch)

    var final_step = await t2
    print("final step:", final_step)  // 2
    ch.close()
}

test_shared_const()
test_move_go()
test_move_channel_send()
test_normal_copy()
test_move_pipeline()
