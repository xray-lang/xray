// Test: generic queue-style class can initialize Array<Channel<T>>
// Expected: prints "ok"

class GenericQueue<T> {
    shards: Array<Channel<T>>
    workers: i64

    constructor(count: i64, capacity: i64) {
        this.workers = count
        this.shards = []
        for (var i = 0; i < count; i++) {
            const ch: Channel<T> = Channel(capacity)
            this.shards.push(ch)
        }
    }

    push(value: move T, shard: i64) {
        var idx = shard % this.workers
        this.shards[idx].send(move value)
    }

    tryPop(worker_id: i64) -> T? {
        for (var i = 0; i < this.workers; i++) {
            var idx = (worker_id + i) % this.workers
            match (this.shards[idx].tryRecv()) {
                Recv.Value(item) -> {
                    return item
                }
                _ -> {}
            }
        }
        return null
    }

    close() {
        for (ch in this.shards) {
            ch.close()
        }
    }
}

@test
fn test_work_queue_generic_class() {
    var q = GenericQueue<i64>(4, 8)
    q.push(10, 0)
    q.push(20, 1)
    q.push(30, 2)

    assertEqual(q.tryPop(0), 10)
    assertEqual(q.tryPop(1), 20)
    assertEqual(q.tryPop(2), 30)
    assertEqual(q.tryPop(3), null)
    q.close()
}
