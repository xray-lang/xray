// Test: generic queue-style class can initialize Array<Channel<T>>
// Expected: prints "ok"

class GenericQueue<T> {
    shards: Array<Channel<T>>
    workers: int

    constructor(count: int, capacity: int) {
        this.workers = count
        this.shards = []
        for (var i = 0; i < count; i++) {
            shared ch: Channel<T> = Channel(capacity)
            this.shards.push(ch)
        }
    }

    push(value: T, shard: int) {
        var idx = shard % this.workers
        this.shards[idx].send(value)
    }

    tryPop(worker_id: int) -> T? {
        for (var i = 0; i < this.workers; i++) {
            var idx = (worker_id + i) % this.workers
            match (this.shards[idx].tryRecv()) {
                Recv.Value(value) -> {
                    return value
                }
                _ -> {}
            }
        }
        return null
    }

    close() {
        for (ch in this.shards) {
            ch.close()
        }
    }
}

@test
fn test_work_queue_generic_class() {
    var q = GenericQueue<int>(4, 8)
    q.push(10, 0)
    q.push(20, 1)
    q.push(30, 2)

    assert_eq(q.tryPop(0), 10)
    assert_eq(q.tryPop(1), 20)
    assert_eq(q.tryPop(2), 30)
    assert_eq(q.tryPop(3), null)
    q.close()
}
