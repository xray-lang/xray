// 测试 Channel 创建和基本操作

fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_value(r: Recv<i64>) -> i64 {
    return match (r) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

fn recv_ok(r: Recv<i64>) -> bool {
    return match (r) {
        Recv.Value { value: _ } -> true
        _ -> false
    }
}

@test
fn test_channel() {
    // 创建缓冲 Channel（容量 3）
    const ch: Channel<i64> = Channel(3)
    print(ch.capacity == 3)  // true
    
    // 非阻塞发送到缓冲区
    var ok1 = ch.trySend(10)
    var ok2 = ch.trySend(20)
    var ok3 = ch.trySend(30)
    print(sent(ok1))  // true
    print(sent(ok2))  // true
    print(sent(ok3))  // true
    
    // 缓冲区已满，再次发送应失败
    var ok4 = ch.trySend(40)
    print(sent(ok4))  // false
    
    // 非阻塞接收（返回 Recv<T>）
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var r3 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    var v3 = recv_value(r3)
    print(v1)  // 10
    print(v2)  // 20
    print(v3)  // 30
    print(recv_ok(r1) && recv_ok(r2) && recv_ok(r3))  // true
    
    // 缓冲区为空，再次接收返回 Recv.Empty
    var r4 = ch.tryRecv()
    print(recv_ok(r4))  // false
    
    // 关闭 Channel
    ch.close()
    
    print("done")
}

test_channel()

// 期望输出：
// true
// true
// true
// true
// false
// 10
// 20
// 30
// true
// false
// done
