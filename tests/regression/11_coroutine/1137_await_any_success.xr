/*
** 测试 await anySuccess - 等待任一协程成功完成（跳过失败的）
** 作者：xingleixu@gmail.com
*/

enum CoroErr { Msg { message: string } }

fn success() -> i64 {
    return 42
}
fn failing() -> i64 {
    throw CoroErr.Msg { message: "error" }
    return 0
}

@test
fn test_await_any_success() {
    // Test 1: single success
    print("test1: single success")
    var t1 = go success()
    var r1 = await anySuccess [t1]
    print("  result:", r1)

    // Test 2: pre-completed tasks, array-order scan (deterministic)
    print("test2: pre-completed tasks")
    var t2 = go success()
    var t3 = go success()
    await t2
    await t3
    var r2 = await anySuccess [t2, t3]
    print("  result:", r2)

    // Test 3: one failing + one success — anySuccess skips failure
    print("test3: skip failure")
    var t4 = go failing()
    var t5 = go success()
    var failed = t4.awaitResult()
    assert(match (failed) {
        TaskResult.Failed { error: _ } -> true
        _ -> false
    })
    await t5
    var r3 = await anySuccess [t4, t5]
    print("  result:", r3)

    print("done")
}

// 期望输出：
// test1: single success
//   result: 42
// test2: pre-completed tasks
//   result: 42
// test3: skip failure
//   result: 42
// done
