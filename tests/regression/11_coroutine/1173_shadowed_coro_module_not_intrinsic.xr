// A declaration that merely spells `Coro` is not the built-in intrinsic module.
// The OS-thread and parallel-callback effect scans used to recognize
// `Coro.yield()` by comparing the receiver's source spelling, so any local named
// `Coro` with a `yield` member was reported as a cooperative scheduling point
// and the enclosing body was rejected. Recognition now goes through the resolved
// symbol, which must be the built-in module.

import sys
import parallel

@test
fn test_shadowed_coro_in_thread_body_is_not_intrinsic_yield() {
    var t = sys.Thread.spawn(fn() -> int {
        var Coro: Json = {"yield": 7}
        if (false) {
            // Analyzed, never executed: a dynamic Json member call, not a
            // scheduling point.
            var ignored = Coro.yield()
            print(ignored)
        }
        return Coro.yield as int
    })
    assert(t.join() == 7)
}

@test
fn test_shadowed_coro_in_parallel_callback_is_not_intrinsic() {
    const total: Atomic<int> = Atomic<int>(0)
    parallel.forEach(0..4, (i) -> {
        var Coro: Json = {"yield": 1}
        total.fetchAdd(Coro.yield as int)
    }, parallel.Options(2))
    assert(total.load() == 4)
}
