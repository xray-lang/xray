// 协程系统综合示例

fn recv_has_value(r: Recv<int>) -> bool {
    return match (r) {
        Recv.Value(_) -> true
        _ -> false
    }
}

// 生产者-消费者模式
fn producer(ch: Channel<int>, id: int, count: int) -> int {
    var i = 0
    while (i < count) {
        ch.trySend(id * 100 + i)
        i++
    }
    return id
}

fn consumer(ch: Channel<int>, expected: int) -> int {
    var received = 0
    var i = 0
    while (i < expected) {
        var msg = ch.tryRecv()
        if (recv_has_value(msg)) {
            received = received + 1
        }
        i++
    }
    return received
}

@test
fn test_producer_consumer() {
    const ch = Channel(10)

    // 启动多个生产者
    var p1 = go producer(ch, 1, 3)
    var p2 = go producer(ch, 2, 3)

    // 等待所有生产者完成
    var producer_ids = await all [p1, p2]
    print(producer_ids[0])  // 1
    print(producer_ids[1])  // 2

    // 消费者获取消息
    var c1 = go consumer(ch, 6)
    var received = await c1
    print(received)  // 6
}

// 资源管理示例
fn cleanup(name: string) {
    print(name)
}

@test
fn test_defer() {
    defer cleanup("resource1")
    defer cleanup("resource2")
    print("working")
    // 函数结束时按 LIFO 执行 defer
}

// select 多路复用示例
@test
fn test_select() {
    const ch1 = Channel(1)
    const ch2 = Channel(1)

    ch1.trySend(100)

    select {
        msg from ch1 -> { print(msg) }
        msg from ch2 -> { print(msg) }
        _ -> { print("default") }
    }
}

// 期望输出 test_producer_consumer：
// 1
// 2
// 6
//
// 期望输出 test_defer：
// working
// resource2
// resource1
//
// 期望输出 test_select：
// 100

test_producer_consumer()
test_defer()
test_select()
