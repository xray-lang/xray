@test
fn test_countdown_latch_wait_reset_and_close() {
    shared const latch = CountdownLatch(2)
    shared const counter = Atomic(0)

    go fn() {
        counter.add(1)
        latch.done()
    }()
    go fn() {
        counter.add(2)
        latch.done()
    }()

    assert_true(latch.wait())
    assert_eq(counter.load(), 3)
    assert_eq(latch.remaining, 0)
    assert_true(latch.tryWait())

    assert_true(latch.reset(1))
    assert_eq(latch.remaining, 1)

    go fn() {
        counter.add(4)
        latch.done()
    }()

    assert_true(latch.wait())
    assert_eq(counter.load(), 7)

    latch.close()
    assert_true(latch.isClosed)
    assert_false(latch.wait())
}
