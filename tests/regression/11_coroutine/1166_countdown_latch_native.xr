import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
@test
fn test_countdown_latch_wait_reset_and_close() {
    const latch = CountdownLatch(2)
    const counter = Atomic(0)

    go fn() {
        counter.add(1)
        latch.done()
    }()
    go fn() {
        counter.add(2)
        latch.done()
    }()

    assert(latch.wait())
    assertEqual(counter.load(), 3)
    assertEqual(latch.remaining, 0)
    assert(latch.tryWait())

    assert(latch.reset(1))
    assertEqual(latch.remaining, 1)

    go fn() {
        counter.add(4)
        latch.done()
    }()

    assert(latch.wait())
    assertEqual(counter.load(), 7)

    latch.close()
    assert(latch.isClosed)
    assert(!(latch.wait()))
}
