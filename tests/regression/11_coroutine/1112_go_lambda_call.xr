// 测试 go CallExpr 的匿名 lambda 调用

@test
fn test_go_lambda_call() {
    // 基本形式
    var t1 = go fn() -> i64 {
        return 100
    }()
    print(await t1)  // 100

    // 多个匿名协程
    var t2 = go fn() -> i64 {
        return 200
    }()
    var t3 = go fn() -> i64 {
        return 300
    }()

    var results = await all [t2, t3]
    print(results[0])  // 200
    print(results[1])  // 300

    print("done")
}

// 期望输出：
// 100
// 200
// 300
// done

test_go_lambda_call()
