/*
** 测试 await all 语法
** await all [task1, task2, ...] 等待所有协程完成
** 作者：xingleixu@gmail.com
*/

fn task1() -> i64 {
    return 10
}
fn task2() -> i64 {
    return 20
}
fn task3() -> i64 {
    return 30
}

@test
fn test_await_all_syntax() {



    // 测试1：await all 基本用法
    print("test1: await all basic")
    var t1 = go task1()
    var t2 = go task2()
    var t3 = go task3()

    var results = await all [t1, t2, t3]
    print("  r0:", results[0])
    print("  r1:", results[1])
    print("  r2:", results[2])
    print("  sum:", results[0] + results[1] + results[2])

    // 测试2：await all with two tasks
    print("test2: await all two tasks")
    var t4 = go task1()
    var t5 = go task2()

    var results2 = await all [t4, t5]
    print("  r0:", results2[0])
    print("  r1:", results2[1])
}

test_await_all_syntax()
