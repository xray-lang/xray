// Test: Coro.whereis and Coro.monitor for named coroutine lifecycle monitoring

import time

fn worker1() -> int {
    time.sleep(50)
    return 42
}
fn worker2() -> string {
    time.sleep(30)
    return "done"
}
fn worker3() -> int {
    return 100
}

@test
fn test_coro_monitor() {

    // ========== Test 1: Coro.whereis for named coroutine ==========

    var t1 = go(name: "test-worker-1") worker1()

    // Named coroutine should be findable
    var found = Coro.whereis("test-worker-1")
    print(found)  // expect: true

    // Non-existent name should return false
    var notfound = Coro.whereis("no-such-coro")
    print(notfound)  // expect: false

    var r1 = await t1
    print(r1)  // expect: 42

    // After completion, should no longer be findable
    var gone = Coro.whereis("test-worker-1")
    print(gone)  // expect: false

    // ========== Test 2: Coro.monitor basic ==========

    var t2 = go(name: "test-worker-2") worker2()
    var ch = Coro.monitor("test-worker-2")

    // Wait for exit notification
    var reason = match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
    print(reason)  // expect: normal

    // ========== Test 3: monitor non-existent coroutine ==========
    var ch2 = Coro.monitor("does-not-exist")
    var reason2 = match (ch2.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
    print(reason2)  // expect: noproc

    // ========== Test 4: monitor already completed coroutine ==========

    var t3 = go(name: "test-worker-3") worker3()
    var r3 = await t3
    print(r3)  // expect: 100

    // Coroutine already done
    time.sleep(10)
    var ch3 = Coro.monitor("test-worker-3")
    var reason3 = match (ch3.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
    print(reason3)  // expect: noproc

    print("all tests passed")  // expect: all tests passed
}
