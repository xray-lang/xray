// 测试 task.cancel() 功能
// 作者：xingleixu@gmail.com

fn blocked_task(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn quick_task(x: int) -> int {
    return x * 2
}

@test
fn test_cancel() {
    // Test 1: cancel a task that cannot self-complete (blocked on channel)
    const ch = Channel<int>(0)
    let t1 = go blocked_task(ch)
    t1.cancel()
    let r1 = t1.awaitResult()
    print("t1 cancelled:", match (r1) {
        TaskResult.Cancelled -> true
        _ -> false
    })
    print("t1 status:", t1.status)
    ch.close()

    // Test 2: cancel an already-completed task is no-op
    let t2 = go quick_task(21)
    let r2 = await t2
    t2.cancel()
    print("t2 success:", match (t2.poll()) {
        TaskResult.Success(_) -> true
        _ -> false
    })
    print("t2 result:", r2)

    print("done")
}

// 期望输出：
// t1 cancelled: true
// t1 status: Cancelled
// t2 success: true
// t2 result: 42
// done
