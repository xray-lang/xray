// Test standalone linked go error propagation (outside scope)

enum LinkErr { Msg { message: string } }

fn failing() -> i64 {
    throw LinkErr.Msg { message: "linked child error" }
    return 0
}
fn slow_work() -> i64 {
    var x = 0
    for (var i = 0; i < 1000; i++) {
        x = x + 1
    }
    return x
}
fn test_linked_go_fail() {
    var t = linked go failing()
    var r = t.awaitResult()
    match (r) {
        TaskResult.Failed { error: _ } -> assert(true, "failed linked go should report TaskResult.Failed")
        _ -> assert(false, "failed linked go should not return null or success")
    }
}
fn test_linked_go_success() {
    var t = linked go slow_work()
    var r = await t
    assert(r == 1000, "await of successful linked go should return result")
}

@test
fn test_linked_go_propagation() {


    // Test 1: linked go child fails → awaitResult reports failure

    // Test 2: linked go child succeeds

    test_linked_go_fail()
    test_linked_go_success()
}
