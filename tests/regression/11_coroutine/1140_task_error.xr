// Test TaskResult failure/success status
// Author: xingleixu@gmail.com

fn bad() -> int {
    var x = 1 / 0
    return x
}

fn good() -> int {
    return 42
}

@test
fn test_main() {
    // Error task
    var t1 = go bad()
    var r1 = t1.awaitResult()
    print("t1.done:", t1.done)
    print("t1.failed:", match (r1) {
        TaskResult.Failed(_) -> true
        _ -> false
    })

    // Good task
    var t2 = go good()
    var r = t2.awaitResult()
    print("t2.done:", t2.done)
    print("t2.result:", match (r) {
        TaskResult.Success(v) -> v
        _ -> -1
    })
}

