fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_value(r: Recv<int>) -> int {
    return match (r) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn recv_ok(r: Recv<int>) -> bool {
    return match (r) {
        Recv.Value(_) -> true
        _ -> false
    }
}

@test
fn test_dynamic_channel_capacity() {
    var n = 3
    shared ch = Channel<int>(n)
    assert_eq(ch.capacity, 3)
    assert_eq(sent(ch.trySend(1)), true)
    assert_eq(sent(ch.trySend(2)), true)
    assert_eq(sent(ch.trySend(3)), true)
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var r3 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    var v3 = recv_value(r3)
    assert_eq(recv_ok(r1), true)
    assert_eq(recv_ok(r2), true)
    assert_eq(recv_ok(r3), true)
    assert_eq(v1 + v2 + v3, 6)
    ch.close()
}

@test
fn test_bare_dynamic_channel_capacity() {
    var n = 2
    shared ch: Channel<int> = Channel(n)
    assert_eq(ch.capacity, 2)
    assert_eq(sent(ch.trySend(4)), true)
    assert_eq(sent(ch.trySend(5)), true)
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    assert_eq(recv_ok(r1), true)
    assert_eq(recv_ok(r2), true)
    assert_eq(v1 + v2, 9)
    ch.close()
}
