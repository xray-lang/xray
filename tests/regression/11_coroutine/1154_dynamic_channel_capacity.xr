@test
fn test_dynamic_channel_capacity() {
    let n = 3
    const ch = new Channel<int>(n)
    assert_eq(ch.capacity, 3)
    assert_eq(ch.trySend(1), true)
    assert_eq(ch.trySend(2), true)
    assert_eq(ch.trySend(3), true)
    let (v1, ok1) = ch.tryRecv()
    let (v2, ok2) = ch.tryRecv()
    let (v3, ok3) = ch.tryRecv()
    assert_eq(ok1, true)
    assert_eq(ok2, true)
    assert_eq(ok3, true)
    assert_eq(v1 + v2 + v3, 6)
    ch.close()
}

@test
fn test_bare_dynamic_channel_capacity() {
    let n = 2
    const ch: Channel<int> = Channel(n)
    assert_eq(ch.capacity, 2)
    assert_eq(ch.trySend(4), true)
    assert_eq(ch.trySend(5), true)
    let (v1, ok1) = ch.tryRecv()
    let (v2, ok2) = ch.tryRecv()
    assert_eq(ok1, true)
    assert_eq(ok2, true)
    assert_eq(v1 + v2, 9)
    ch.close()
}
