fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_value(r: Recv<i64>) -> i64 {
    return match (r) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

fn recv_ok(r: Recv<i64>) -> bool {
    return match (r) {
        Recv.Value { value: _ } -> true
        _ -> false
    }
}

@test
fn test_dynamic_channel_capacity() {
    var n = 3
    const ch = Channel<i64>(n)
    assertEqual(ch.capacity, 3)
    assertEqual(sent(ch.trySend(1)), true)
    assertEqual(sent(ch.trySend(2)), true)
    assertEqual(sent(ch.trySend(3)), true)
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var r3 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    var v3 = recv_value(r3)
    assertEqual(recv_ok(r1), true)
    assertEqual(recv_ok(r2), true)
    assertEqual(recv_ok(r3), true)
    assertEqual(v1 + v2 + v3, 6)
    ch.close()
}

@test
fn test_bare_dynamic_channel_capacity() {
    var n = 2
    const ch: Channel<i64> = Channel(n)
    assertEqual(ch.capacity, 2)
    assertEqual(sent(ch.trySend(4)), true)
    assertEqual(sent(ch.trySend(5)), true)
    var r1 = ch.tryRecv()
    var r2 = ch.tryRecv()
    var v1 = recv_value(r1)
    var v2 = recv_value(r2)
    assertEqual(recv_ok(r1), true)
    assertEqual(recv_ok(r2), true)
    assertEqual(v1 + v2, 9)
    ch.close()
}
