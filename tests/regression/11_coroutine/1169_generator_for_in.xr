// Generator value-yield: `yield expr` produces Iterator<T>, consumable by for-in.

fn counter(n: i64) -> Iterator<i64> {
    for (var i = 0; i < n; i++) {
        yield i
    }
}

fn rangeSum(n: i64) -> i64 {
    var sum = 0
    for (x in counter(n)) {
        sum = sum + x
    }
    return sum
}

fn firstTwoTotal(n: i64) -> i64 {
    var sum = 0
    for (x in counter(n)) {
        sum = sum + x
        if (x == 1) {
            break
        }
    }
    return sum
}

@test
fn test_generator_for_in() {
    assert(rangeSum(5) == 10)  // 0+1+2+3+4
    assert(rangeSum(0) == 0)
    assert(firstTwoTotal(5) == 1)
}
