// Helper for 1149_module_call_stack_grow.
//
// Provides a class whose methods deliberately keep many locals alive
// and then invoke another wide method via `this.foo()` (OP_INVOKE).
// Before the fix, OP_INVOKE pushed a frame without checking stack
// capacity, so the callee's register file silently overflowed the
// combined [stack:64][frames:4] slab used by pooled coroutines.

export class Chain {
    wide(n: i64) -> i64 {
        var a0 = n + 0
        var a1 = a0 + 1
        var a2 = a1 + 1
        var a3 = a2 + 1
        var a4 = a3 + 1
        var a5 = a4 + 1
        var a6 = a5 + 1
        var a7 = a6 + 1
        var a8 = a7 + 1
        var a9 = a8 + 1
        var b0 = a9 + 1
        var b1 = b0 + 1
        var b2 = b1 + 1
        var b3 = b2 + 1
        var b4 = b3 + 1
        var b5 = b4 + 1
        var b6 = b5 + 1
        var b7 = b6 + 1
        var b8 = b7 + 1
        var b9 = b8 + 1
        var c0 = b9 + 1
        var c1 = c0 + 1
        var c2 = c1 + 1
        var c3 = c2 + 1
        var c4 = c3 + 1
        var c5 = c4 + 1
        var c6 = c5 + 1
        var c7 = c6 + 1
        var c8 = c7 + 1
        var c9 = c8 + 1
        // Keep all 30 values live until the return so the compiler
        // cannot fold them into a few registers.
        return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
             + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9
             + c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9
    }

    middle(n: i64) -> i64 {
        // Keep many locals live, then dispatch through `this.wide()`
        // which is OP_INVOKE. Caller base + register + callee maxstack
        // must exceed the slab's 64-slot stack for the regression to
        // catch the bug.
        var p0 = n + 0
        var p1 = p0 + 1
        var p2 = p1 + 1
        var p3 = p2 + 1
        var p4 = p3 + 1
        var p5 = p4 + 1
        var p6 = p5 + 1
        var p7 = p6 + 1
        var p8 = p7 + 1
        var p9 = p8 + 1
        var q0 = p9 + 1
        var q1 = q0 + 1
        var q2 = q1 + 1
        var q3 = q2 + 1
        var q4 = q3 + 1
        var q5 = q4 + 1
        var r = this.wide(q5)
        return r + p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9
             + q0 + q1 + q2 + q3 + q4 + q5
    }
}
