// 测试 Task.poll / Task.awaitResult
// 作者：xingleixu@gmail.com

fn blocked(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

fn compute(x: i64) -> i64 {
    return x * 2
}

@test
fn test_main() {
    // Test 1: blocked task — poll is Pending before completion
    const ch = Channel<i64>(0)
    var task = go blocked(ch)
    print("before pending:", match (task.poll()) {
        TaskResult.Pending -> true
        _ -> false
    })

    ch.send(21)
    var result = await task
    print("after:", result)
    print("again:", match (task.poll()) {
        TaskResult.Success { value: v } -> v
        _ -> -1
    })
    ch.close()

    // Test 2: cancel blocked task — explicit status is Cancelled
    const ch2 = Channel<i64>(0)
    var task2 = go blocked(ch2)
    task2.cancel()
    var cancelled = task2.awaitResult()
    print("cancelled:", match (cancelled) {
        TaskResult.Cancelled -> true
        _ -> false
    })
    ch2.close()

    // Test 3: completed task — awaitResult observes success
    var task3 = go compute(21)
    var done = task3.awaitResult()
    print("completed:", match (done) {
        TaskResult.Success { value: v } -> v
        _ -> -1
    })
}

// 期望输出：
// before pending: true
// after: 21
// again: 21
// cancelled: true
// completed: 42
