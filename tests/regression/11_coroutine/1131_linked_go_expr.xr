// Test go expressions and explicit TaskResult observation

fn ok() -> int {
    return 42
}
fn test_linked_go_basic() {
    let t = go ok()
    let r = await t
    assert(r == 42, "linked go should return result via await")
}
fn test_go_with_await_result() {
    let t = go ok()
    let result = t.awaitResult()
    assert(t.done, "awaitResult should complete the task")
    match (result) {
        TaskResult.Success(value) -> assert(value == 42, "awaitResult should carry the task value")
        _ -> assert(false, "awaitResult should return Success")
    }
}
fn test_linked_go_in_scope() {
    let result = 0
    linked scope {
        let t = go ok()
        result = await t
    }
    assert(result == 42, "linked go in linked scope should work")
}

@test
fn test_linked_go_expr() {

    // Test 1: linked go as expression returns Task

    // Test 2: go + awaitResult() delivers explicit task status

    // Test 3: linked go inside linked scope

    test_linked_go_basic()
    test_go_with_await_result()
    test_linked_go_in_scope()
}
