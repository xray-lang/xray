import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
@test
fn test_event_count_epoch_wait_and_close() {
    const event = EventCount(0)

    assertEqual(event.epoch, 0)
    assert(!(event.isClosed))

    assertEqual(event.advance(), 1)
    assertEqual(event.epoch, 1)
    assertEqual(event.wait(0), 1)

    const ready = CountdownLatch(1)
    var t = go fn() -> i64 {
        ready.done()
        return event.wait(1, 0)
    }()

    assert(ready.wait())
    assertEqual(event.advance(), 2)
    assertEqual(await t, 2)

    const closed = EventCount(7)
    const closeReady = CountdownLatch(1)
    var closeTask = go fn() -> i64 {
        closeReady.done()
        return closed.wait(7)
    }()

    assert(closeReady.wait())
    closed.close()
    assert(closed.isClosed)
    assertEqual(await closeTask, -1)
    assertEqual(closed.advance(), -1)
    assertEqual(closed.wait(7), -1)
}
