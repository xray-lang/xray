// 测试 task.done 和 task.status 属性
// 作者：xingleixu@gmail.com

fn blocked(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn compute(x: int) -> int {
    return x * 2
}

@test
fn test_main() {
    // Test 1: blocked task — done is deterministically false
    const ch = Channel<int>(0)
    let task = go blocked(ch)
    print("before send:")
    print("  done:", task.done)
    print("  status:", task.status)

    ch.send(21)
    let result = await task
    print("after await:")
    print("  done:", task.done)
    print("  result:", result)
    ch.close()

    // Test 2: cancel blocked task — cancelled is deterministically true
    const ch2 = Channel<int>(0)
    let task2 = go blocked(ch2)
    task2.cancel()
    let result2 = task2.awaitResult()
    print("after cancel:")
    print("  done:", task2.done)
    print("  status:", task2.status)
    print("  cancelled result:", match (result2) {
        TaskResult.Cancelled -> true
        _ -> false
    })
    ch2.close()

    // Test 3: completed task status
    let task3 = go compute(21)
    let result3 = await task3
    print("completed:")
    print("  done:", task3.done)
    print("  status:", task3.status)
    print("  result:", result3)
}

// 期望输出：
// before send:
//   done: false
//   status: Running
// after await:
//   done: true
//   result: 21
// after cancel:
//   done: true
//   status: Cancelled
//   cancelled result: true
// completed:
//   done: true
//   status: Success
//   result: 42
