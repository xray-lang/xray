/*
** 测试 Channel 带超时操作
** 作者：xingleixu@gmail.com
** 
** 测试内容：
** 1. ch.sendTimeout(value, timeout) - 带超时发送
** 2. ch.recvTimeout(timeout) - 带超时接收
*/

// 测试 1：recvTimeout 立即成功（Channel 有数据）

@test
fn test_channel_timeout() {
    print("test1: recvTimeout with data")
    shared ch1: Channel<int> = Channel(1)
    ch1.send(42)
    var result1 = ch1.recvTimeout(1000)
    var result1_value = match (result1) {
        Recv.Value(v) -> v
        _ -> -1
    }
    var result1_ok = match (result1) {
        Recv.Value(_) -> true
        _ -> false
    }
    print("  result:", result1_value, "ok:", result1_ok)  // expect: 42, true

    // 测试 2：recvTimeout 超时（Channel 无数据）
    print("test2: recvTimeout timeout")
    shared ch2: Channel<int> = Channel(1)
    var result2 = ch2.recvTimeout(100)  // 100ms 超时
    match (result2) {
        Recv.Timeout -> print("  timeout")  // expect: timeout
        Recv.Value(v) -> print("  got:", v)
        _ -> print("  no value")
    }

    // 测试 3：sendTimeout 立即成功（Channel 有空间）
    print("test3: sendTimeout with space")
    shared ch3: Channel<int> = Channel(1)
    var ok3 = ch3.sendTimeout(100, 1000)
    print("  success:", match (ok3) {
        SendResult.Sent -> true
        _ -> false
    })  // expect: true
    var v3 = ch3.recv()
    print("  value:", match (v3) {
        Recv.Value(v) -> v
        _ -> -1
    })  // expect: 100

    // 测试 4：sendTimeout 超时（Channel 满）
    print("test4: sendTimeout timeout")
    shared ch4: Channel<int> = Channel(1)
    ch4.send(1)  // 填满 channel
    var ok4 = ch4.sendTimeout(2, 100)  // 100ms 超时
    print("  success:", match (ok4) {
        SendResult.Sent -> true
        _ -> false
    })  // expect: false（超时）

    // 测试 5：生产者-消费者带超时
    print("test5: producer-consumer with timeout")
    shared ch5: Channel<int> = Channel(2)

    // 生产者
    var producer = go {
        for (i in 1..4) {
            match (ch5.sendTimeout(i, 500)) {
                SendResult.Sent -> {}
                _ -> {
                    print("  producer timeout at", i)
                }
            }
        }
        ch5.close()
    }

    // 消费者（慢）
    var consumer = go fn() -> int {
        var count = 0
        while (true) {
            match (ch5.recvTimeout(200)) {
                Recv.Value(val) -> {
                    print("  consumed:", val)
                    count++
                }
                _ -> {
                    break
                }
            }
        }
        return count
    }()

    await producer
    var consumed = await consumer
    print("  total consumed:", consumed)
}

test_channel_timeout()
