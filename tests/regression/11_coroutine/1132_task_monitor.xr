// Test TaskResult API — explicit status observation

enum MonitorErr { Msg(string) }

fn compute() -> int {
    return 42
}
fn failing() -> int {
    throw MonitorErr.Msg("monitor test error")
    return 0
}
fn test_monitor_success() {
    let t = go compute()
    let r = t.awaitResult()
    match (r) {
        TaskResult.Success(value) -> assert(value == 42, "TaskResult.Success should carry result")
        _ -> assert(false, "successful task should return TaskResult.Success")
    }
    assert(t.done, "task should be done after awaitResult")
}
fn test_monitor_fail() {
    let t = go failing()
    let r = t.awaitResult()
    match (r) {
        TaskResult.Failed(_) -> assert(true, "failed task should return TaskResult.Failed")
        _ -> assert(false, "failed task should not report success")
    }
    assert(t.done, "failed task should be done")
}
fn test_monitor_already_done() {
    let t = go compute()
    let r = await t
    let observed = t.poll()
    match (observed) {
        TaskResult.Success(value) -> assert(value == 42, "poll should observe completed result")
        _ -> assert(false, "poll on completed task should return Success")
    }
}

@test
fn test_task_monitor() {


    // Test 1: observe a successful task

    // Test 2: observe a failing task

    // Test 3: observe an already-completed task

    test_monitor_success()
    test_monitor_fail()
    test_monitor_already_done()
}
