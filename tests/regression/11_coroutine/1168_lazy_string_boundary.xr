fn make_key(n: int) -> string {
    return "k" + string(n)
}

fn recv_string(ch: Channel<string>) -> string {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
}

fn build_message(prefix: string, n: int) -> string {
    return prefix + "_" + string(n)
}

fn map_worker(seed: string) -> Map<string, string> {
    var k = make_key(3)
    var m: Map<string, string> = #{}
    m.set(k, seed + "_value")
    Coro.yield()
    return m
}

@test
fn test_lazy_string_map_set_content_keys() {
    var key = make_key(1)
    var m: Map<string, int> = #{}
    m.set(key, 7)
    m.set(make_key(1), 11)

    assert_eq(len(m), 1)
    assert_eq(m.get("k1"), 11)
    assert_eq(m.containsKey(make_key(1)), true)
    assert_eq(m.delete("k1"), true)
    assert_eq(m.containsKey(make_key(1)), false)

    var s: Set<string> = #[]
    s.add(make_key(2))
    s.add("k2")
    assert_eq(len(s), 1)
    assert_eq(s.contains(make_key(2)), true)
    assert_eq(s.delete("k2"), true)
    assert_eq(s.contains(make_key(2)), false)
}

@test
fn test_lazy_string_channel_and_task_publish() {
    shared ch: Channel<string> = Channel(1)
    var msg = build_message("msg", 4)
    ch.send(msg)
    assert_eq(recv_string(ch), "msg_4")
    ch.close()

    var task = go build_message("task", 5)
    assert_eq(await task, "task_5")
}

@test
fn test_lazy_string_nested_container_task_result() {
    var task = go map_worker(build_message("seed", 6))
    var out = await task
    assert_eq(out.get(make_key(3)), "seed_6_value")
    assert_eq(out.get("k3"), "seed_6_value")
}
