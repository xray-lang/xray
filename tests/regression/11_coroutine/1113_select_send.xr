// 测试 select 发送分支

fn recv_value(r: Recv<int>) -> int {
    return match (r) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn recv_ok(r: Recv<int>) -> bool {
    return match (r) {
        Recv.Value(_) -> true
        _ -> false
    }
}

@test
fn test_select_send() {
    shared const ch = new Channel(2)
    
    // 发送分支：val to ch -> ...
    select {
        100 to ch -> { print("sent 100") }
        _ -> { print("send failed") }
    }
    
    // 再发送一个
    select {
        200 to ch -> { print("sent 200") }
        _ -> { print("send failed") }
    }
    
    // 缓冲满了，发送失败
    select {
        300 to ch -> { print("sent 300") }
        _ -> { print("buffer full") }
    }
    
    // 接收并验证（使用 Recv<T>）
    let r1 = ch.tryRecv()
    let r2 = ch.tryRecv()
    let v1 = recv_value(r1)
    let v2 = recv_value(r2)
    print(v1)  // 100
    print(v2)  // 200
    print(recv_ok(r1) && recv_ok(r2))  // true
    
    print("done")
}

test_select_send()

// 期望输出：
// sent 100
// sent 200
// buffer full
// 100
// 200
// true
// done
