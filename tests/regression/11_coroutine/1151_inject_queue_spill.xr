// Regression: a deep go/await chain must survive local run-queue overflow.

fn spill_chain(depth: i64) -> i64 {
    if (depth <= 0) {
        return 0
    }
    var child = go spill_child(depth - 1)
    var value = await child
    return value + 1
}

fn spill_child(depth: i64) -> i64 {
    return spill_chain(depth)
}

@test
fn test_inject_queue_spill_chain() {
    var depth = 2048
    var result = await go spill_child(depth)
    assertEqual(result, depth)
}
