// 测试 cleanup 块调用带参数函数

fn cleanup(msg: string) {
    print(msg)
}

fn log_value(name: string, value: int) {
    print(name)
    print(value)
}

@test
fn test_defer_args() {
    print("start")
    
    // cleanup 块内的单参数调用
    defer { cleanup("cleanup 1") }
    defer { cleanup("cleanup 2") }
    
    // cleanup 块内的多参数调用
    defer { log_value("result", 42) }
    
    print("work done")
    
    // LIFO 执行：log_value -> cleanup 2 -> cleanup 1
}

test_defer_args()
print("end")

// 期望输出：
// start
// work done
// result
// 42
// cleanup 2
// cleanup 1
// end
