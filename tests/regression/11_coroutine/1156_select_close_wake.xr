fn wait_select_close(ch: Channel<i64>, ready: Channel<i64>, done: Channel<i64>) {
    ready.send(1)
    select {
        msg from ch -> {}
    }
    done.send(1)
}

fn recv_int(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

@test
fn test_select_wakes_on_channel_close() {
    const ch = Channel<i64>(0)
    const ready = Channel<i64>(0)
    const done = Channel<i64>(1)

    go wait_select_close(ch, ready, done)
    assertEqual(recv_int(ready), 1)

    for (var i = 0; i < 16; i++) {
        Coro.yield()
    }

    ch.close()
    var result = done.recvTimeout(2000)
    var ok = match (result) {
        Recv.Value { value: _ } -> true
        _ -> false
    }
    var value = match (result) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
    assertEqual(ok, true)
    assertEqual(value, 1)
    ready.close()
    done.close()
}
