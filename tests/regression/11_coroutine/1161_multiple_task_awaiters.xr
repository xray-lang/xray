// 测试同一个 pending Task 可被多个协程同时 await

import time

fn delayed_value() -> int {
    time.sleep(80)
    return 7
}

fn await_and_report(id: int, task: Task<int>, ready: Channel<int>, out: Channel<int>) {
    ready.send(id)
    var value = await task
    out.send(id * 100 + value)
}

fn recv_int(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

@test
fn test_multiple_task_awaiters() {
    shared ready = Channel<int>(2)
    shared out = Channel<int>(2)
    var task = go delayed_value()
    var a = go await_and_report(1, task, ready, out)
    var b = go await_and_report(2, task, ready, out)

    recv_int(ready)
    recv_int(ready)

    var first = recv_int(out)
    var second = recv_int(out)
    print(first + second)

    await a
    await b
    ready.close()
    out.close()
    print("done")
}

// 期望输出：
// 314
// done
