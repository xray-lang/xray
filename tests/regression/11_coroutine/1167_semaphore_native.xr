import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
@test
fn test_semaphore_permits_and_close() {
    const sem = Semaphore(0)
    const ready = CountdownLatch(2)
    const counter = Atomic(0)

    fn worker(id: int) -> int {
        ready.done()
        if (!sem.acquire()) {
            return -id
        }
        counter.add(id)
        return id
    }

    var t1 = go worker(7)
    var t2 = go worker(11)

    assert_true(ready.wait())
    sem.release(2)

    var r1: int = await t1
    var r2: int = await t2
    assert_eq(r1 + r2, 18)
    assert_eq(counter.load(), 18)
    assert_eq(sem.available, 0)
    assert_false(sem.isClosed)

    sem.release()
    assert_eq(sem.available, 1)
    assert_true(sem.tryAcquire())
    assert_eq(sem.available, 0)

    const closedSem = Semaphore(0)
    const closeReady = CountdownLatch(1)
    var closedTask = go fn() -> int {
        closeReady.done()
        return closedSem.acquire() ? 1 : -1
    }()

    assert_true(closeReady.wait())
    closedSem.close()
    assert_true(closedSem.isClosed)
    assert_eq(await closedTask, -1)
    assert_false(closedSem.acquire())
}
