import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
@test
fn test_semaphore_permits_and_close() {
    const sem = Semaphore(0)
    const ready = CountdownLatch(2)
    const counter = Atomic(0)

    fn worker(id: i64) -> i64 {
        ready.done()
        if (!sem.acquire()) {
            return -id
        }
        counter.add(id)
        return id
    }

    var t1 = go worker(7)
    var t2 = go worker(11)

    assert(ready.wait())
    sem.release(2)

    var r1: i64 = await t1
    var r2: i64 = await t2
    assertEqual(r1 + r2, 18)
    assertEqual(counter.load(), 18)
    assertEqual(sem.available, 0)
    assert(!(sem.isClosed))

    sem.release()
    assertEqual(sem.available, 1)
    assert(sem.tryAcquire())
    assertEqual(sem.available, 0)

    const closedSem = Semaphore(0)
    const closeReady = CountdownLatch(1)
    var closedTask = go fn() -> i64 {
        closeReady.done()
        return closedSem.acquire() ? 1 : -1
    }()

    assert(closeReady.wait())
    closedSem.close()
    assert(closedSem.isClosed)
    assertEqual(await closedTask, -1)
    assert(!(closedSem.acquire()))
}
