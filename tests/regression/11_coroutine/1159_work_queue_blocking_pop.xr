import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
// Regression: WorkQueue.pop blocks a coroutine and resumes it when a task arrives.

import time

const q: WorkQueue<i64> = WorkQueue<i64>(2, 2)

fn delayed_push(value: i64) -> i64 {
    assert(q.push(value, 0))
    return value
}

@test
fn test_work_queue_blocking_pop() {
    var consumer = go fn() -> i64 {
        var value = q.pop(0)
        return value ?? -1
    }()
    time.sleep(1)
    var producer = go delayed_push(42)
    assertEqual(await producer, 42)
    assertEqual(await consumer, 42)

    q.close()
    assertEqual(q.pop(0), null)
}
