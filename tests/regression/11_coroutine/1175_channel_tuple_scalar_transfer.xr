fn publish(results: Channel<(i64, i64, i64)>, producer: i64) {
    var result = (producer + 1, producer + 2, producer + 3)
    results.send(move result)
}

const results = Channel<(i64, i64, i64)>(4)
var total = 0
scope {
    for (var producer = 0; producer < 4; producer++) {
        go publish(results, producer)
    }
    for (var producer = 0; producer < 4; producer++) {
        match (results.recv()) {
            Recv.Value((first, second, third)) -> {
                total = total + first + second + third
            }
            _ -> {}
        }
    }
}
results.close()
print(total)
