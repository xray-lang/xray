import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
shared q: WorkQueue<int> = WorkQueue<int>(4, 2)

@test
fn test_native_work_queue() {
    assert_eq(q.shardCount, 4)
    assert_eq(len(q), 0)
    assert_false(q.isClosed)

    assert_true(q.push(1, 0))
    assert_true(q.push(2, 0))
    assert_true(q.push(3, 1))
    assert_eq(len(q), 3)

    var (own, own_ok) = q.tryPop(0)
    assert_true(own_ok)
    assert_eq(own, 2)

    var (stolen, stolen_ok) = q.tryPop(1)
    assert_true(stolen_ok)
    assert_eq(stolen, 3)

    var (remaining, remaining_ok) = q.tryPop(2)
    assert_true(remaining_ok)
    assert_eq(remaining, 1)

    var (_, empty_ok) = q.tryPop(0)
    assert_false(empty_ok)
    assert_eq(len(q), 0)

    assert_eq(q.pushRange(10, 6, 0), 6)
    assert_eq(len(q), 6)
    var (r0, r0_ok) = q.tryPop(0)
    assert_true(r0_ok)
    assert_eq(r0, 14)
    var (r1, r1_ok) = q.tryPop(1)
    assert_true(r1_ok)
    assert_eq(r1, 15)
    var (r2, r2_ok) = q.tryPop(2)
    assert_true(r2_ok)
    assert_eq(r2, 12)
    var (r3, r3_ok) = q.tryPop(3)
    assert_true(r3_ok)
    assert_eq(r3, 13)
    var (r4, r4_ok) = q.tryPop(0)
    assert_true(r4_ok)
    assert_eq(r4, 10)
    var (r5, r5_ok) = q.tryPop(1)
    assert_true(r5_ok)
    assert_eq(r5, 11)
    assert_eq(len(q), 0)

    q.close()
    assert_true(q.isClosed)
    assert_false(q.push(9, 0))
    assert_eq(q.pushRange(20, 2, 0), 0)
}
