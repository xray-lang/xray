import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
const q: WorkQueue<i64> = WorkQueue<i64>(4, 2)

@test
fn test_native_work_queue() {
    assertEqual(q.shardCount, 4)
    assertEqual(len(q), 0)
    assert(!(q.isClosed))

    assert(q.push(1, 0))
    assert(q.push(2, 0))
    assert(q.push(3, 1))
    assertEqual(len(q), 3)

    var (own, own_ok) = q.tryPop(0)
    assert(own_ok)
    assertEqual(own, 2)

    var (stolen, stolen_ok) = q.tryPop(1)
    assert(stolen_ok)
    assertEqual(stolen, 3)

    var (remaining, remaining_ok) = q.tryPop(2)
    assert(remaining_ok)
    assertEqual(remaining, 1)

    var (_, empty_ok) = q.tryPop(0)
    assert(!(empty_ok))
    assertEqual(len(q), 0)

    assertEqual(q.pushRange(10, 6, 0), 6)
    assertEqual(len(q), 6)
    var (r0, r0_ok) = q.tryPop(0)
    assert(r0_ok)
    assertEqual(r0, 14)
    var (r1, r1_ok) = q.tryPop(1)
    assert(r1_ok)
    assertEqual(r1, 15)
    var (r2, r2_ok) = q.tryPop(2)
    assert(r2_ok)
    assertEqual(r2, 12)
    var (r3, r3_ok) = q.tryPop(3)
    assert(r3_ok)
    assertEqual(r3, 13)
    var (r4, r4_ok) = q.tryPop(0)
    assert(r4_ok)
    assertEqual(r4, 10)
    var (r5, r5_ok) = q.tryPop(1)
    assert(r5_ok)
    assertEqual(r5, 11)
    assertEqual(len(q), 0)

    q.close()
    assert(q.isClosed)
    assert(!(q.push(9, 0)))
    assertEqual(q.pushRange(20, 2, 0), 0)
}
