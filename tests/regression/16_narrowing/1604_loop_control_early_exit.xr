// 1604_loop_control_early_exit.xr
// Conformance: LANGUAGE_SPEC §2.13 N-8 for the loop-control terminators.
// A then-branch ending in `continue` / `break` terminates, so the code after
// the `if` inherits the opposite fact — exactly as it does for `return`.
// Writes on the jump path must still reach the code after the loop (N-10),
// so each test also drives the runtime result, not just the compile.

// ===== N-8: continue in for-in narrows the fallthrough =====

fn pickFirstString(xs: Array<i64 | string>) -> string {
    for (x in xs) {
        if (x is i64) { continue }
        return x
    }
    return ""
}

@test
fn test_n8_continue_for_in() {
    assertEqual(pickFirstString([1, 2, "a", 3]), "a")
    assertEqual(pickFirstString([7]), "")
}

// ===== N-8: continue in while narrows the fallthrough =====

fn sumStringsWhile(xs: Array<i64 | string>) -> i64 {
    var total = 0
    var i = 0
    while (i < len(xs)) {
        var x = xs[i]
        i = i + 1
        if (x is i64) { continue }
        total = total + len(x)
    }
    return total
}

@test
fn test_n8_continue_while() {
    assertEqual(sumStringsWhile([1, "ab", 2, "cde"]), 5)
}

// ===== N-8: continue in a classic for narrows the fallthrough =====

fn sumStringsFor(xs: Array<i64 | string>) -> i64 {
    var total = 0
    for (var i = 0; i < len(xs); i = i + 1) {
        var x = xs[i]
        if (x is i64) { continue }
        total = total + len(x)
    }
    return total
}

@test
fn test_n8_continue_classic_for() {
    assertEqual(sumStringsFor(["a", 1, "bc"]), 3)
}

// ===== N-8: break narrows the fallthrough inside the body =====

fn firstLenBeforeInt(xs: Array<i64 | string>) -> i64 {
    var total = 0
    for (x in xs) {
        if (x is i64) { break }
        total = total + len(x)
    }
    return total
}

@test
fn test_n8_break_for_in() {
    assertEqual(firstLenBeforeInt(["ab", "c", 9, "zzz"]), 3)
}

// ===== N-8: null test with continue =====

fn joinNonNull(xs: Array<string?>) -> i64 {
    var total = 0
    for (x in xs) {
        if (x == null) { continue }
        total = total + len(x)
    }
    return total
}

@test
fn test_n8_continue_null_check() {
    assertEqual(joinNonNull([null, "ab", null, "c"]), 3)
}

// ===== N-8: labeled continue targeting the outer loop =====

fn countPairs(xs: Array<i64 | string>) -> i64 {
    var count = 0
    outer: for (x in xs) {
        for (y in xs) {
            if (x is i64) { continue outer }
            count = count + len(x)
            break
        }
    }
    return count
}

@test
fn test_n8_labeled_continue() {
    assertEqual(countPairs([1, "ab"]), 2)
}

// ===== N-10: a write on the jump path survives to the loop header =====

fn drainWithContinue(first: string?) -> i64 {
    var cur = first
    var rounds = 0
    while (cur != null) {
        rounds = rounds + 1
        if (rounds >= 2) { cur = null; continue }
        cur = "x"
    }
    return rounds
}

@test
fn test_n10_continue_write_reaches_header() {
    assertEqual(drainWithContinue("seed"), 2)
    assertEqual(drainWithContinue(null), 0)
}
