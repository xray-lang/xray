// 测试：数组方法扩展
// ===== slice expression =====
@test
fn test_slice_basic() {
    var arr = [1, 2, 3, 4, 5]
    var s: Slice<int> = arr[1:4]
    assert_eq(len(s), 3)
    assert_eq(s[0], 2)
    assert_eq(s[2], 4)
}

@test
fn test_slice_from_start() {
    var arr = [1, 2, 3, 4, 5]
    var s: Slice<int> = arr[:2]
    assert_eq(len(s), 2)
    assert_eq(s[0], 1)
}

@test
fn test_slice_to_end() {
    var arr = [1, 2, 3, 4, 5]
    var s: Slice<int> = arr[3:]
    assert_eq(len(s), 2)
    assert_eq(s[1], 5)
}

@test
fn test_slice_negative_bounds() {
    var arr = [1, 2, 3, 4, 5]
    var s: Slice<int> = arr[-4:-1]
    assert_eq(len(s), 3)
    assert_eq(s[0], 2)
    assert_eq(s[2], 4)
    var empty: Slice<int> = arr[4:2]
    assert_eq(len(empty), 0)
}

@test
fn test_slice_is_view() {
    var arr = [10, 20, 30, 40]
    var s: Slice<int> = arr[1:3]
    arr[1] = 21
    assert_eq(s[0], 21)
    s[1] = 31
    assert_eq(arr[2], 31)
}

@test
fn test_slice_copy_is_independent() {
    var arr = [10, 20, 30, 40]
    var s = copy(arr[1:3])
    arr[1] = 21
    assert_eq(s[0], 20)
    s[1] = 31
    assert_eq(arr[2], 30)
}

// ===== concat =====
@test
fn test_concat_arrays() {
    var a = [1, 2]
    var b = [3, 4]
    var c = a.concat(b)
    assert_eq(len(c), 4)
    assert_eq(c[0], 1)
    assert_eq(c[3], 4)
}

// ===== find =====
@test
fn test_find_element() {
    var arr = [10, 20, 30, 40]
    var found = arr.find(fn(x) {
        return x > 25
    })
    assert_eq(found, 30)
}

@test
fn test_find_not_found() {
    var arr = [1, 2, 3]
    var found = arr.find(fn(x) {
        return x > 100
    })
    assert_eq(found, null)
}

// ===== findIndex =====
@test
fn test_find_index() {
    var arr = ["a", "b", "c", "d"]
    var idx = arr.findIndex(fn(x) {
        return x == "c"
    })
    assert_eq(idx, 2)
}

@test
fn test_find_index_not_found() {
    var arr = [1, 2, 3]
    var idx = arr.findIndex(fn(x) {
        return x > 100
    })
    assert_eq(idx, -1)
}

@test
fn test_index_of_and_includes() {
    var arr = [10, 20, 30]
    assert_eq(arr.indexOf(20), 1)
    assert_eq(arr.indexOf(99), -1)
    assert_eq(arr.contains(30), true)
    assert_eq(arr.contains(99), false)
}

// ===== every =====
@test
fn test_every_true() {
    var arr = [2, 4, 6, 8]
    var result = arr.every(fn(x) {
        return x % 2 == 0
    })
    assert_eq(result, true)
}

@test
fn test_every_false() {
    var arr = [2, 3, 4, 6]
    var result = arr.every(fn(x) {
        return x % 2 == 0
    })
    assert_eq(result, false)
}

// ===== some =====
@test
fn test_some_true() {
    var arr = [1, 3, 5, 6]
    var result = arr.some(fn(x) {
        return x % 2 == 0
    })
    assert_eq(result, true)
}

@test
fn test_some_false() {
    var arr = [1, 3, 5, 7]
    var result = arr.some(fn(x) {
        return x % 2 == 0
    })
    assert_eq(result, false)
}

// ===== fill =====
@test
fn test_fill() {
    var arr = [1, 2, 3, 4, 5]
    arr.fill(0)
    assert_eq(arr[0], 0)
    assert_eq(arr[4], 0)
}

@test
fn test_fill_range_and_negative_bounds() {
    var arr = [1, 2, 3, 4, 5, 6]
    arr.fill(9, 2, 5)
    assert_eq(arr[0], 1)
    assert_eq(arr[2], 9)
    assert_eq(arr[4], 9)
    assert_eq(arr[5], 6)

    arr.fill(7, -3, -1)
    assert_eq(arr[2], 9)
    assert_eq(arr[3], 7)
    assert_eq(arr[4], 7)
    assert_eq(arr[5], 6)

    arr.fill(8, 5, 2)
    assert_eq(arr[2], 9)
    assert_eq(arr[5], 6)

    arr.fill(4, 4)
    assert_eq(arr[3], 7)
    assert_eq(arr[4], 4)
    assert_eq(arr[5], 4)
}

// ===== sort =====
@test
fn test_sort_numbers() {
    var arr = [3, 1, 4, 1, 5, 9, 2, 6]
    arr.sort()
    assert_eq(arr[0], 1)
    assert_eq(arr[1], 1)
    assert_eq(arr[7], 9)
}

@test
fn test_sort_strings() {
    var arr = ["banana", "apple", "cherry"]
    arr.sort()
    assert_eq(arr[0], "apple")
    assert_eq(arr[2], "cherry")
}
