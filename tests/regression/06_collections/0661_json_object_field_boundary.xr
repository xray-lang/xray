// Static object fields and explicit JSON paths agree across hot VM/JIT code.

type State = { count: i64, last: i64?, flag: bool }

fn update(state: ref State, value: i64) {
    state.count += 1
    state.last = value
    state.flag = value % 2 == 0
}

@test
fn test_static_object_hot_updates() {
    var state: State = { count: 0, last: null, flag: false }
    for (i in 0..100) { update(ref state, i) }
    assertEqual(state.count, 100)
    assertEqual(state.last, 99)
    assertEqual(state.flag, false)
}

@test
fn test_dynamic_json_path_chain() {
    var root = JSON.parseValue("{}")
    for (i in 0..10) {
        JSON.set(root, ["nodes", string(i), "value"], i * i, true)
    }
    var sum = 0
    for (i in 0..10) { sum += JSON.require<i64>(root, ["nodes", string(i), "value"]) }
    assertEqual(sum, 285)
}
