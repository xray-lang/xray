// Hot JSON.Object mutations keep full JSON.Value tags and payloads intact.

@test
fn test_scalar_kind_transitions() {
    var object: JSON.Object = JSON.parseObject("{\"value\":0}")
    object.set("value", null)
    assert(JSON.isNull(JSON.require<JSON.Value>(object, ["value"])))
    object.set("value", true)
    assertEqual(JSON.require<bool>(object, ["value"]), true)
    object.set("value", -123)
    assertEqual(JSON.require<i64>(object, ["value"]), -123)
    object.set("value", 3.14)
    assertEqual(JSON.require<f64>(object, ["value"]), 3.14)
    object.set("value", "hello")
    assertEqual(JSON.require<string>(object, ["value"]), "hello")
}

@test
fn test_nested_composite_store() {
    var object: JSON.Object = JSON.parseObject("{}")
    object.set("child", JSON.value({ x: 10, y: 20 }))
    assertEqual(JSON.require<i64>(object, ["child", "x"]), 10)
    object.set("items", JSON.value([1, 2, 3]))
    assertEqual(JSON.require<i64>(object, ["items", 2]), 3)
}
