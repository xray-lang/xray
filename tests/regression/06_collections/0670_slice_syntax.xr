/*
 * 切片语法测试
 * 仅 Array 和 Array<byte> 支持切片语法
 */

@test
fn test_slice_syntax() {

    // 数组切片测试
    var arr = [1, 2, 3, 4, 5]

    // 完整切片 [start:end]
    var slice1: Slice<int> = arr[1:4]
    print(slice1)  // [2, 3, 4]

    // 省略 start [:end]
    var slice2: Slice<int> = arr[:3]
    print(slice2)  // [1, 2, 3]

    // 省略 end [start:]
    var slice3: Slice<int> = arr[2:]
    print(slice3)  // [3, 4, 5]

    // 全切片 [:]
    var slice4: Slice<int> = arr[:]
    print(slice4)  // [1, 2, 3, 4, 5]

    // 负索引从尾部计算
    var slice5: Slice<int> = arr[-4:-1]
    print(slice5)  // [2, 3, 4]

    // 切片是零拷贝 view
    slice5[1] = 30
    print(arr[2])  // 30

    print("All slice tests passed!")

    // expect: [2, 3, 4]
    // expect: [1, 2, 3]
    // expect: [3, 4, 5]
    // expect: [1, 2, 3, 4, 5]
    // expect: [2, 3, 4]
    // expect: 30
    // expect: Hello
    // expect: Hello
    // expect: World!
    // expect: Hello, World!
    // expect: All slice tests passed!
}
