// Result<T, E> generic type annotation support

@test fn result_ok_with_generic_annotation() {
    let r: Result<int, string> = Result.Ok(42)
    assert(r != null)
}

@test fn result_err_with_generic_annotation() {
    let r: Result<int, string> = Result.Err("oops")
    assert(r != null)
}

@test fn result_generic_return_type() {
    fn safe_div(a: int, b: int) -> Result<int, string> {
        if (b == 0) {
            return Result.Err("division by zero")
        }
        return Result.Ok(a / b)
    }
    let ok = safe_div(10, 2)
    let err = safe_div(10, 0)
    assert(ok != null)
    assert(err != null)
}

@test fn result_match_ok_err() {
    fn parse_int(s: string) -> Result<int, string> {
        if (s == "42") {
            return Result.Ok(42)
        }
        return Result.Err("not a number")
    }
    let r = parse_int("42")
    let msg = match (r) {
        Result.Ok(v) -> "got: ${v}",
        Result.Err(e) -> "err: ${e}",
    }
    assert(msg == "got: 42")
}

@test fn result_without_generic_still_works() {
    let r: Result = Result.Ok("hello")
    assert(r != null)
}

@test fn result_ok_err_accessors() {
    let ok_res: Result<int, string> = Result.Ok(42)
    let err_res: Result<int, string> = Result.Err("oops")

    assert_eq(ok_res.ok(), 42)
    assert_eq(ok_res.err(), null)
    assert_eq(err_res.ok(), null)
    assert_eq(err_res.err(), "oops")
}

@test fn result_map_err_maps_err_only() {
    let ok_res: Result<int, string> = Result.Ok(7)
    let err_res: Result<int, string> = Result.Err("oops")

    let mapped_ok = ok_res.mapErr((e) -> e + "!")
    let mapped_err = err_res.mapErr((e) -> e + "!")

    assert_eq(mapped_ok.ok(), 7)
    assert_eq(mapped_err.err(), "oops!")
}
