// Helper module for cross-module Result identity tests.
// Returns the builtin prelude Result enum across a module boundary so the
// importing module can pattern-match the variants. This is the scenario that
// per-module enum injection used to break (each module got a distinct Result
// type identity, so Ok/Err never matched across the boundary).

export fn safe_div(a: int, b: int) -> Result<int, string> {
    if (b == 0) {
        return Result.Err("division by zero")
    }
    return Result.Ok(a / b)
}

export fn parse_flag(s: string) -> Result<bool, string> {
    if (s == "on") {
        return Result.Ok(true)
    }
    if (s == "off") {
        return Result.Ok(false)
    }
    return Result.Err("bad flag: ${s}")
}
