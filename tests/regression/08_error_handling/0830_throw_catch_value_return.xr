// Value-return error channel: throw enum + catch

enum MathErr { DivByZero, Overflow }
enum AppErr { NotFound(string), Timeout }
enum IoErr { Closed, Timeout }
enum ParseErr { Invalid }

fn safe_div(a: i64, b: i64) -> i64 {
    if (b == 0) {
        throw MathErr.DivByZero
    }
    return a / b
}

@test fn basic_throw_catch() {
    var result = 0
    try {
        result = safe_div(10, 2)
    } catch (e) {
        result = -1
    }
    assertEqual(result, 5)
}

@test fn catch_on_error() {
    var result = 0
    try {
        result = safe_div(10, 0)
    } catch (e) {
        result = -1
    }
    assertEqual(result, -1)
}

@test fn typed_catch() {
    var msg = "ok"
    try {
        safe_div(1, 0)
    } catch (e: MathErr) {
        msg = "math error"
    }
    assertEqual(msg, "math error")
}

@test fn auto_propagation() {
    fn wrapper() -> i64 {
        var x = safe_div(10, 0)
        return x + 1
    }
    var result = 0
    try {
        result = wrapper()
    } catch (e) {
        result = -99
    }
    assertEqual(result, -99)
}

@test fn nested_try_catch() {
    var inner_val = 0
    try {
        inner_val = safe_div(1, 0)
    } catch (e) {
        inner_val = 42
    }
    var outer = 0
    try {
        outer = inner_val + safe_div(10, 5)
    } catch (e) {
        outer = -1
    }
    assertEqual(outer, 44)
}

@test fn catch_preserves_error_value() {
    fn lookup(key: string) -> string {
        if (key == "") {
            throw AppErr.NotFound("empty key")
        }
        return "value_${key}"
    }
    var msg = ""
    try {
        msg = lookup("")
    } catch (e: AppErr) {
        msg = match (e) {
            AppErr.NotFound(s) -> "not found: ${s}",
            AppErr.Timeout -> "timeout",
        }
    }
    assertEqual(msg, "not found: empty key")
}

@test fn defer_runs_on_throw() {
    var cleaned = false
    var caught = false
    fn work() -> i64 {
        defer { cleaned = true }
        throw MathErr.Overflow
        return 0
    }
    try {
        work()
    } catch (e) {
        caught = true
    }
    assertEqual(caught, true)
    assertEqual(cleaned, true)
}

@test fn multi_catch_typed() {
    fn process(input: string) -> i64 {
        if (input == "closed") { throw IoErr.Closed }
        if (input == "bad") { throw ParseErr.Invalid }
        return len(input)
    }

    var r1 = 0
    try {
        r1 = process("closed")
    } catch (e: IoErr) {
        r1 = -1
    } catch (e: ParseErr) {
        r1 = -2
    }
    assertEqual(r1, -1)

    var r2 = 0
    try {
        r2 = process("bad")
    } catch (e: IoErr) {
        r2 = -1
    } catch (e: ParseErr) {
        r2 = -2
    }
    assertEqual(r2, -2)

    var r3 = 0
    try {
        r3 = process("hello")
    } catch (e: IoErr) {
        r3 = -1
    } catch (e: ParseErr) {
        r3 = -2
    }
    assertEqual(r3, 5)
}
