// Cross-module error propagation via value-return channel.
// Errors thrown in an imported module propagate correctly to the caller.

import "./modules/error_source" as src

@test fn catch_error_from_imported_module() {
    var result = 0
    try {
        result = src.safe_div(10, 0)
    } catch (e) {
        result = -1
    }
    assertEqual(result, -1)
}

@test fn success_from_imported_module() {
    var result = 0
    try {
        result = src.safe_div(10, 2)
    } catch (e) {
        result = -1
    }
    assertEqual(result, 5)
}

@test fn catch_cross_module_with_match() {
    var msg = ""
    try {
        msg = src.validate("")
    } catch (e) {
        msg = "validation error"
    }
    assertEqual(msg, "validation error")
}

@test fn auto_propagation_cross_module() {
    fn wrapper() -> i64 {
        var x = src.safe_div(100, 0)
        return x + 1
    }
    var result = 0
    try {
        result = wrapper()
    } catch (e) {
        result = -99
    }
    assertEqual(result, -99)
}

@test fn multiple_cross_module_calls() {
    var sum = 0
    try {
        var a = src.safe_div(10, 2)
        var b = src.safe_div(20, 4)
        sum = a + b
    } catch (e) {
        sum = -1
    }
    assertEqual(sum, 10)
}
