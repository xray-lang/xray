// Cross-module Result identity.
//
// Result is a canonical builtin prelude enum bound to a single type identity
// for the whole isolate. A Result value produced in one module must match the
// Result.Ok / Result.Err patterns in another module. Previously Result was
// injected as a fresh enum declaration per compilation unit, giving each
// module a distinct type identity and breaking cross-module pattern matching
// (and forcing user-space workaround enums).

import "./modules/result_source" as src

@test fn match_ok_from_imported_module() {
    let r = src.safe_div(10, 2)
    let msg = match (r) {
        Result.Ok(v) -> "ok: ${v}",
        Result.Err(e) -> "err: ${e}",
    }
    assert_eq(msg, "ok: 5")
}

@test fn match_err_from_imported_module() {
    let r = src.safe_div(1, 0)
    let msg = match (r) {
        Result.Ok(v) -> "ok: ${v}",
        Result.Err(e) -> "err: ${e}",
    }
    assert_eq(msg, "err: division by zero")
}

@test fn accessors_cross_module() {
    let ok_res = src.safe_div(20, 4)
    let err_res = src.safe_div(20, 0)
    assert_eq(ok_res.ok(), 5)
    assert_eq(err_res.err(), "division by zero")
}

@test fn rewrap_and_match_cross_module() {
    // A Result produced in the imported module can be re-wrapped into a fresh
    // Result here and still match — exercising shared variant identity in both
    // directions across the module boundary.
    fn classify(r: Result<int, string>) -> Result<string, string> {
        return match (r) {
            Result.Ok(v) -> Result.Ok("v=${v}"),
            Result.Err(e) -> Result.Err(e),
        }
    }
    let msg = match (classify(src.safe_div(8, 2))) {
        Result.Ok(s) -> s,
        Result.Err(e) -> "err: ${e}",
    }
    assert_eq(msg, "v=4")
}

@test fn bool_payload_variant_cross_module() {
    let on = src.parse_flag("on")
    let bad = src.parse_flag("xyz")
    let a = match (on) {
        Result.Ok(v) -> v,
        Result.Err(e) -> false,
    }
    assert_eq(a, true)
    let b = match (bad) {
        Result.Ok(v) -> "ok",
        Result.Err(e) -> e,
    }
    assert_eq(b, "bad flag: xyz")
}
