// 测试：高阶函数

// ===== 函数作为参数 =====

@test
fn test_function_as_param() {
    fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
        return f(x)
    }
    
    fn double(x: i64) -> i64 { return x * 2 }
    fn square(x: i64) -> i64 { return x * x }
    
    assertEqual(apply(double, 5), 10)
    assertEqual(apply(square, 5), 25)
}

@test
fn test_binary_function_param() {
    fn combine(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
        return f(a, b)
    }
    
    fn add(x: i64, y: i64) -> i64 { return x + y }
    fn mul(x: i64, y: i64) -> i64 { return x * y }
    
    assertEqual(combine(add, 3, 5), 8)
    assertEqual(combine(mul, 3, 5), 15)
}

// ===== 函数作为返回值 =====

@test
fn test_function_factory() {
    fn createGreeter(greeting: string) -> fn(string) -> string {
        fn greet(name: string) -> string {
            return greeting + ", " + name + "!"
        }
        return greet
    }
    
    var hello = createGreeter("Hello")
    var hi = createGreeter("Hi")
    
    assertEqual(hello("Alice"), "Hello, Alice!")
    assertEqual(hi("Bob"), "Hi, Bob!")
}

// ===== 函数组合 =====

@test
fn test_compose() {
    fn compose(f: fn(i64) -> i64, g: fn(i64) -> i64) -> fn(i64) -> i64 {
        fn composed(x: i64) -> i64 {
            return f(g(x))
        }
        return composed
    }
    
    fn double(x: i64) -> i64 { return x * 2 }
    fn addOne(x: i64) -> i64 { return x + 1 }
    
    var doubleThenAdd = compose(addOne, double)
    var addThenDouble = compose(double, addOne)
    
    assertEqual(doubleThenAdd(5), 11)  // (5*2)+1
    assertEqual(addThenDouble(5), 12)  // (5+1)*2
}

// ===== 部分应用 =====

@test
fn test_partial() {
    fn add(a: i64, b: i64) -> i64 {
        return a + b
    }
    
    fn partial(f: fn(i64, i64) -> i64, x: i64) -> fn(i64) -> i64 {
        fn applied(y: i64) -> i64 {
            return f(x, y)
        }
        return applied
    }
    
    var add5 = partial(add, 5)
    assertEqual(add5(3), 8)
    assertEqual(add5(10), 15)
}

// ===== 回调模式 =====

@test
fn test_callback() {
    var received = 0
    
    fn processAsync(callback: fn(i64)) {
        var result = 42
        callback(result)
    }
    
    fn handler(value: i64) {
        received = value
    }
    
    processAsync(handler)
    assertEqual(received, 42)
}

// ===== 自定义迭代器 =====

@test
fn test_custom_map() {
    fn myMap(arr: Array<i64>, transform: fn(i64) -> i64) -> Array<i64> {
        var result: Array<i64> = []
        for (x in arr) {
            result.push(transform(x))
        }
        return result
    }
    
    fn double(x: i64) -> i64 { return x * 2 }
    
    var arr = [1, 2, 3]
    var doubled = myMap(arr, double)
    
    assertEqual(doubled[0], 2)
    assertEqual(doubled[1], 4)
    assertEqual(doubled[2], 6)
}

@test
fn test_custom_filter() {
    fn myFilter(arr: Array<i64>, predicate: fn(i64) -> bool) -> Array<i64> {
        var result: Array<i64> = []
        for (x in arr) {
            if (predicate(x)) {
                result.push(x)
            }
        }
        return result
    }
    
    fn isEven(x: i64) -> bool { return x % 2 == 0 }
    
    var arr = [1, 2, 3, 4, 5, 6]
    var evens = myFilter(arr, isEven)
    
    assertEqual(len(evens), 3)
    assertEqual(evens[0], 2)
}

@test
fn test_custom_reduce() {
    fn myReduce(arr: Array<i64>, reducer: fn(i64, i64) -> i64, initial: i64) -> i64 {
        var acc = initial
        for (x in arr) {
            acc = reducer(acc, x)
        }
        return acc
    }
    
    fn addFn(a: i64, b: i64) -> i64 { return a + b }
    fn mulFn(a: i64, b: i64) -> i64 { return a * b }
    
    var arr = [1, 2, 3, 4]
    assertEqual(myReduce(arr, addFn, 0), 10)
    assertEqual(myReduce(arr, mulFn, 1), 24)
}

// ===== 管道 =====

@test
fn test_pipe() {
    fn double(x: i64) -> i64 { return x * 2 }
    fn addTen(x: i64) -> i64 { return x + 10 }
    fn square(x: i64) -> i64 { return x * x }
    
    // 手动管道
    var x = 5
    x = double(x)   // 10
    x = addTen(x)   // 20
    x = square(x)   // 400
    assertEqual(x, 400)
}

// ===== 边界条件 =====

@test
fn test_identity_function() {
    fn identity<T>(x: T) -> T { return x }
    
    assertEqual(identity(42), 42)
    assertEqual(identity("hello"), "hello")
    // null requires nullable type parameter, skip this test
}

@test
fn test_constant_function() {
    fn makeConstant(value: i64) -> fn() -> i64 {
        fn constant() -> i64 {
            return value
        }
        return constant
    }
    
    var always42 = makeConstant(42)
    assertEqual(always42(), 42)
    assertEqual(always42(), 42)
}

