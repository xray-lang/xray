@test
fn test_function_item_hoists_before_definition() {
    assertEqual(item_later(41), 42)
}

fn item_later(x: i64) -> i64 {
    return x + 1
}

@test
fn test_const_function_value_call_after_binding() {
    const f = fn(x: i64) -> i64 {
        return x + 3
    }
    assertEqual(f(39), 42)
}

@test
fn test_var_function_value_can_rebind() {
    var op = fn(x: i64) -> i64 {
        return x + 1
    }
    assertEqual(op(10), 11)

    op = fn(x: i64) -> i64 {
        return x * 2
    }
    assertEqual(op(21), 42)
}

fn fact_item(n: i64) -> i64 {
    if (n <= 1) { return 1 }
    return n * fact_item(n - 1)
}

@test
fn test_function_item_recursion() {
    assertEqual(fact_item(5), 120)
}
