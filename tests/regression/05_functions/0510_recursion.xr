// 测试：递归函数

// ===== 阶乘 =====

@test
fn test_factorial() {
    fn factorial(n: i64) -> i64 {
        if (n <= 1) { return 1 }
        return n * factorial(n - 1)
    }
    
    assertEqual(factorial(0), 1)
    assertEqual(factorial(1), 1)
    assertEqual(factorial(5), 120)
    assertEqual(factorial(6), 720)
}

// ===== 斐波那契 =====

@test
fn test_fibonacci() {
    fn fib(n: i64) -> i64 {
        if (n <= 1) { return n }
        return fib(n - 1) + fib(n - 2)
    }
    
    assertEqual(fib(0), 0)
    assertEqual(fib(1), 1)
    assertEqual(fib(2), 1)
    assertEqual(fib(5), 5)
    assertEqual(fib(10), 55)
}

// ===== 累加 =====

@test
fn test_sum_to() {
    fn sumTo(n: i64) -> i64 {
        if (n <= 0) { return 0 }
        return n + sumTo(n - 1)
    }
    
    assertEqual(sumTo(0), 0)
    assertEqual(sumTo(1), 1)
    assertEqual(sumTo(5), 15)
    assertEqual(sumTo(10), 55)
}

// ===== 最大公约数 =====

@test
fn test_gcd() {
    fn gcd(a: i64, b: i64) -> i64 {
        if (b == 0) { return a }
        return gcd(b, a % b)
    }
    
    assertEqual(gcd(48, 18), 6)
    assertEqual(gcd(100, 25), 25)
    assertEqual(gcd(17, 13), 1)
    assertEqual(gcd(12, 12), 12)
}

// ===== 幂运算 =====

@test
fn test_power() {
    fn power(base: i64, exp: i64) -> i64 {
        if (exp == 0) { return 1 }
        return base * power(base, exp - 1)
    }
    
    assertEqual(power(2, 0), 1)
    assertEqual(power(2, 1), 2)
    assertEqual(power(2, 10), 1024)
    assertEqual(power(3, 4), 81)
}

// ===== 数组递归 =====

@test
fn test_array_sum() {
    fn arraySum(arr: Array<i64>, i: i64) -> i64 {
        if (i >= len(arr)) { return 0 }
        return arr[i] + arraySum(arr, i + 1)
    }
    
    assertEqual(arraySum([1, 2, 3, 4, 5], 0), 15)
    assertEqual(arraySum([], 0), 0)
    assertEqual(arraySum([42], 0), 42)
}

@test
fn test_count_down() {
    var result: Array<i64> = []
    fn countdown(n: i64) {
        if (n <= 0) { return }
        result.push(n)
        countdown(n - 1)
    }
    
    countdown(5)
    assertEqual(len(result), 5)
    assertEqual(result[0], 5)
    assertEqual(result[4], 1)
}

// ===== 二分查找 =====

@test
fn test_binary_search() {
    fn binarySearch(arr: Array<i64>, target: i64, low: i64, high: i64) -> i64 {
        if (low > high) { return -1 }
        var mid = (low + high) / 2
        if (arr[mid] == target) { return mid }
        if (arr[mid] > target) {
            return binarySearch(arr, target, low, mid - 1)
        }
        return binarySearch(arr, target, mid + 1, high)
    }
    
    var arr = [1, 3, 5, 7, 9, 11, 13]
    assertEqual(binarySearch(arr, 7, 0, len(arr) - 1), 3)
    assertEqual(binarySearch(arr, 1, 0, len(arr) - 1), 0)
    assertEqual(binarySearch(arr, 13, 0, len(arr) - 1), 6)
    assertEqual(binarySearch(arr, 4, 0, len(arr) - 1), -1)
}

// ===== 相互递归 =====

@test
fn test_mutual_recursion() {
    fn isEven(n: i64) -> bool {
        if (n == 0) { return true }
        return isOdd(n - 1)
    }
    
    fn isOdd(n: i64) -> bool {
        if (n == 0) { return false }
        return isEven(n - 1)
    }
    
    assertEqual(isEven(0), true)
    assertEqual(isEven(4), true)
    assertEqual(isEven(7), false)
    assertEqual(isOdd(5), true)
    assertEqual(isOdd(6), false)
}

// ===== 边界条件 =====

@test
fn test_deep_recursion() {
    fn recurse(n: i64) -> i64 {
        if (n <= 0) { return 0 }
        return 1 + recurse(n - 1)
    }
    
    assertEqual(recurse(100), 100)
    assertEqual(recurse(500), 500)
}

