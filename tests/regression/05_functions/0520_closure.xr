// 测试：闭包

// ===== 基础闭包 =====

@test
fn test_closure_basic() {
    fn makeCounter() -> fn() -> i64 {
        var count = 0
        fn increment() -> i64 {
            count++
            return count
        }
        return increment
    }
    
    var counter = makeCounter()
    assert_eq(counter(), 1)
    assert_eq(counter(), 2)
    assert_eq(counter(), 3)
}

@test
fn test_closure_multiple_instances() {
    fn makeCounter() -> fn() -> i64 {
        var count = 0
        fn increment() -> i64 {
            count++
            return count
        }
        return increment
    }
    
    var c1 = makeCounter()
    var c2 = makeCounter()
    
    assert_eq(c1(), 1)
    assert_eq(c1(), 2)
    assert_eq(c2(), 1)  // 独立计数器
    assert_eq(c1(), 3)
    assert_eq(c2(), 2)
}

// ===== 参数捕获 =====

@test
fn test_capture_param() {
    fn makeAdder(x: i64) -> fn(i64) -> i64 {
        fn add(y: i64) -> i64 {
            return x + y
        }
        return add
    }
    
    var add5 = makeAdder(5)
    var add10 = makeAdder(10)
    
    assert_eq(add5(3), 8)
    assert_eq(add10(3), 13)
    assert_eq(add5(add10(1)), 16)
}

@test
fn test_capture_multiple_params() {
    fn makeRange(min: i64, max: i64) -> fn(i64) -> bool {
        fn isInRange(x: i64) -> bool {
            return x >= min && x <= max
        }
        return isInRange
    }
    
    var inRange = makeRange(5, 10)
    assert_eq(inRange(3), false)
    assert_eq(inRange(5), true)
    assert_eq(inRange(7), true)
    assert_eq(inRange(10), true)
    assert_eq(inRange(12), false)
}

// ===== 修改外层变量 =====

@test
fn test_modify_outer() {
    var x = 10
    
    fn modify() {
        x = 20
    }
    
    assert_eq(x, 10)
    modify()
    assert_eq(x, 20)
}

@test
fn test_accumulator() {
    fn makeAccumulator() -> fn(i64) -> i64 {
        var total = 0
        fn add(n: i64) -> i64 {
            total += n
            return total
        }
        return add
    }
    
    var acc = makeAccumulator()
    assert_eq(acc(5), 5)
    assert_eq(acc(10), 15)
    assert_eq(acc(3), 18)
}

// ===== 嵌套闭包 =====

@test
fn test_nested_closure() {
    fn outer(x: i64) -> fn(i64) -> fn(i64) -> i64 {
        fn middle(y: i64) -> fn(i64) -> i64 {
            fn inner(z: i64) -> i64 {
                return x + y + z
            }
            return inner
        }
        return middle
    }
    
    var f = outer(1)(2)
    assert_eq(f(3), 6)
}

@test
fn test_deeply_nested() {
    fn level1(a: i64) -> fn(i64) -> fn(i64) -> fn(i64) -> i64 {
        fn level2(b: i64) -> fn(i64) -> fn(i64) -> i64 {
            fn level3(c: i64) -> fn(i64) -> i64 {
                fn level4(d: i64) -> i64 {
                    return a + b + c + d
                }
                return level4
            }
            return level3
        }
        return level2
    }
    
    var result = level1(1)(2)(3)(4)
    assert_eq(result, 10)
}

// ===== 闭包工厂 =====

@test
fn test_multiplier_factory() {
    fn createMultiplier(factor: i64) -> fn(i64) -> i64 {
        fn multiply(x: i64) -> i64 {
            return x * factor
        }
        return multiply
    }
    
    var double = createMultiplier(2)
    var triple = createMultiplier(3)
    
    assert_eq(double(5), 10)
    assert_eq(triple(5), 15)
}

@test
fn test_greeting_factory() {
    fn createGreeter(greeting: string) -> fn(string) -> string {
        fn greet(name: string) -> string {
            return greeting + ", " + name + "!"
        }
        return greet
    }
    
    var hello = createGreeter("Hello")
    var hi = createGreeter("Hi")
    
    assert_eq(hello("Alice"), "Hello, Alice!")
    assert_eq(hi("Bob"), "Hi, Bob!")
}

// ===== 闭包与循环 =====

@test
fn test_closure_captures_value() {
    var funcs: Array<fn() -> i64> = []
    for (var i = 0; i < 3; i++) {
        var val = i  // 每次循环创建新变量
        fn capture() -> i64 {
            return val
        }
        funcs.push(capture)
    }
    
    assert_eq(funcs[0](), 0)
    assert_eq(funcs[1](), 1)
    assert_eq(funcs[2](), 2)
}

// ===== 边界条件 =====

@test
fn test_closure_no_capture() {
    fn outer() -> fn() -> i64 {
        fn inner() -> i64 {
            return 42
        }
        return inner
    }
    
    var f = outer()
    assert_eq(f(), 42)
}

@test
fn test_closure_capture_const() {
    const VALUE = 100
    
    fn getClosure() -> fn() -> i64 {
        fn inner() -> i64 {
            return VALUE
        }
        return inner
    }
    
    var f = getClosure()
    assert_eq(f(), 100)
}

