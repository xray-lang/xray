// 0381_optional_call.xr
// Test: optional function call operator (?.()).

type IntFn = fn(i64) -> i64

@test
fn test_optional_call_on_value() {
    var hits = 0

    fn bump(x: i64) -> i64 {
        hits += 1
        return x + 1
    }

    var f: IntFn? = bump
    var value = f?.(41)
    assertEqual(value, 42)
    assertEqual(hits, 1)
}

@test
fn test_optional_call_on_null_short_circuits() {
    var hits = 0

    fn arg_side_effect() -> i64 {
        hits += 100
        return 41
    }

    var f: IntFn? = null
    var value = f?.(arg_side_effect())
    assertEqual(value, null)
    assertEqual(hits, 0)
}

@test
fn test_optional_call_with_nullish_default() {
    var f: IntFn? = null
    assertEqual(f?.(10) ?? 99, 99)
}
