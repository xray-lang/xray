// 0361_bigint_methods.xr
// 作者：xingleixu@gmail.com
// 测试：BigInt 内置方法

// ===== toString() =====

@test
fn test_toString_large() {
    var a = 12345678901234567890n
    assert_eq(a.toString(), "12345678901234567890")
}

@test
fn test_toString_negative() {
    var a = -123n
    assert_eq(a.toString(), "-123")
}

// ===== abs() =====

@test
fn test_abs_negative() {
    var a = -999n
    assert_eq(a.abs().toString(), "999")
}

@test
fn test_abs_positive() {
    var a = 123n
    assert_eq(a.abs().toString(), "123")
}

@test
fn test_abs_zero() {
    var a = 0n
    assert_eq(a.abs().toString(), "0")
}

// ===== sign() =====

@test
fn test_sign_positive() {
    var a = 100n
    assert_eq(a.sign(), 1)
}

@test
fn test_sign_negative() {
    var a = -50n
    assert_eq(a.sign(), -1)
}

@test
fn test_sign_zero() {
    var a = 0n
    assert_eq(a.sign(), 0)
}

// ===== isZero() =====

@test
fn test_isZero_true() {
    var a = 0n
    assert_eq(a.isZero(), true)
}

@test
fn test_isZero_false() {
    var a = 100n
    assert_eq(a.isZero(), false)
}

// ===== isNegative() =====

@test
fn test_isNegative_true() {
    var a = -50n
    assert_eq(a.isNegative(), true)
}

@test
fn test_isNegative_false() {
    var a = 100n
    assert_eq(a.isNegative(), false)
}

@test
fn test_isNegative_zero() {
    var a = 0n
    assert_eq(a.isNegative(), false)
}

// ===== isPositive() =====

@test
fn test_isPositive_true() {
    var a = 100n
    assert_eq(a.isPositive(), true)
}

@test
fn test_isPositive_false() {
    var a = -50n
    assert_eq(a.isPositive(), false)
}

@test
fn test_isPositive_zero() {
    var a = 0n
    assert_eq(a.isPositive(), false)
}

// ===== toI64() =====

@test
fn test_toI64_int64_min() {
    var a = -9223372036854775808n
    assert_eq(a.toI64(), -9223372036854775808)
}

@test
fn test_toI64_below_int64_min_overflows() {
    var a = -9223372036854775809n
    assert_eq(a.toI64(), null)
}
