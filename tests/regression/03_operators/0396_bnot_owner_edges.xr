@test
fn test_bnot_owner_signed_64_bit_edges() {
    assertEqual(~0, -1)
    assertEqual(~1, -2)
    assertEqual(~(-1), 0)
    assertEqual(~9223372036854775807, -9223372036854775807 - 1)
    assertEqual(~(-9223372036854775807 - 1), 9223372036854775807)
}

@test
fn test_bnot_owner_is_involutive() {
    var values = [0, 1, -1, 42, -42, 9223372036854775807, -9223372036854775807 - 1]
    for (value in values) {
        assertEqual(~~value, value)
    }
}
