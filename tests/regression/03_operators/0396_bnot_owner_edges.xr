@test
fn test_bnot_owner_signed_64_bit_edges() {
    assert_eq(~0, -1)
    assert_eq(~1, -2)
    assert_eq(~(-1), 0)
    assert_eq(~9223372036854775807, -9223372036854775807 - 1)
    assert_eq(~(-9223372036854775807 - 1), 9223372036854775807)
}

@test
fn test_bnot_owner_is_involutive() {
    var values = [0, 1, -1, 42, -42, 9223372036854775807, -9223372036854775807 - 1]
    for (value in values) {
        assert_eq(~~value, value)
    }
}
