// 0395_inc_dec_bnot.xr
// 作者：xingleixu@gmail.com
// 测试：自增自减和按位取反

// ===== 自增 ++ =====

@test
fn test_post_increment() {
    var x = 5
    x++
    assertEqual(x, 6)
}

@test
fn test_multiple_increment() {
    var x = 0
    x++
    x++
    x++
    assertEqual(x, 3)
}

// ===== 自减 -- =====

@test
fn test_post_decrement() {
    var x = 5
    x--
    assertEqual(x, 4)
}

@test
fn test_multiple_decrement() {
    var x = 10
    x--
    x--
    x--
    assertEqual(x, 7)
}

// ===== 混合使用 =====

@test
fn test_inc_dec_mixed() {
    var x = 5
    x++
    x++
    x--
    assertEqual(x, 6)
}

// ===== 在循环中使用 =====

@test
fn test_inc_in_loop() {
    var count = 0
    var i = 0
    while (i < 5) {
        count++
        i++
    }
    assertEqual(count, 5)
}

// ===== 浮点数自增自减 =====

@test
fn test_float_increment() {
    var x = 1.5
    x++
    assertEqual(x, 2.5)
}

@test
fn test_float_decrement() {
    var x = 3.5
    x--
    assertEqual(x, 2.5)
}

// ===== 按位取反 ~ =====

@test
fn test_bitwise_not() {
    assertEqual(~0, -1)
    assertEqual(~1, -2)
    assertEqual(~(-1), 0)
}

@test
fn test_bitwise_not_patterns() {
    // ~x = -(x+1)
    assertEqual(~5, -6)
    assertEqual(~10, -11)
    assertEqual(~100, -101)
}

@test
fn test_double_bitwise_not() {
    var x = 42
    assertEqual(~~x, x)
}

// ===== 按位取反在表达式中 =====

@test
fn test_bnot_in_expression() {
    var x = 5
    var y = ~x + 10
    assertEqual(y, 4)  // -6 + 10 = 4
}

