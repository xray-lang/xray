// 0350_ternary_nullish.xr
// 作者：xingleixu@gmail.com
// 测试：三元运算符和空值处理

// ===== 三元运算符基础 =====

@test
fn test_ternary_true() {
    var result = true ? "yes" : "no"
    assertEqual(result, "yes")
}

@test
fn test_ternary_false() {
    var result = false ? "yes" : "no"
    assertEqual(result, "no")
}

@test
fn test_ternary_expression() {
    var x = 10
    var result = x > 5 ? "big" : "small"
    assertEqual(result, "big")
    
    result = x > 20 ? "big" : "small"
    assertEqual(result, "small")
}

@test
fn test_ternary_numbers() {
    var x = 5
    var max = x > 10 ? x : 10
    assertEqual(max, 10)
    
    var min = x < 10 ? x : 10
    assertEqual(min, 5)
}

// ===== 嵌套三元 =====

@test
fn test_ternary_nested() {
    var score = 85
    var grade = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "D"
    assertEqual(grade, "B")
}

@test
fn test_ternary_in_expression() {
    var x = 5
    var result = 10 + (x > 0 ? x : 0)
    assertEqual(result, 15)
}

// ===== 空值合并 (??) =====

@test
fn test_nullish_with_null() {
    var x = null
    assertEqual(x ?? "default", "default")
}

@test
fn test_nullish_with_value() {
    var x = "value"
    assertEqual(x ?? "default", "value")
}

@test
fn test_nullish_with_zero() {
    var x = 0
    assertEqual(x ?? 100, 0)  // 0 不是 null/undefined
}

@test
fn test_nullish_with_false() {
    var x = false
    assertEqual(x ?? true, false)  // false 不是 null
}

@test
fn test_nullish_with_empty_string() {
    var x = ""
    assertEqual(x ?? "default", "")  // 空字符串不是 null
}

@test
fn test_nullish_chain() {
    var a = null
    var b = null
    var c = "value"
    assertEqual(a ?? b ?? c, "value")
}

// ===== 可选链 (?.) =====

@test
fn test_optional_chain_null() {
    var obj = null
    assertEqual(obj?.name, null)
}

@test
fn test_optional_chain_value() {
    var obj = { name: "Alice", age: 30 }
    assertEqual(obj?.name, "Alice")
    assertEqual(obj?.age, 30)
}

@test
fn test_optional_chain_nested() {
    var data = { user: { name: "Bob" } }
    assertEqual(data?.user?.name, "Bob")
    
    var empty = null
    assertEqual(empty?.user?.name, null)
}

// 注意：可选链方法调用语法暂不支持

// ===== 组合使用 =====

@test
fn test_optional_with_nullish() {
    var obj = null
    assertEqual(obj?.name ?? "unknown", "unknown")
    
    var data = { name: "Alice" }
    assertEqual(data?.name ?? "unknown", "Alice")
}

@test
fn test_ternary_with_nullish() {
    var value = null
    var result = value != null ? value : "default"
    assertEqual(result, "default")
    
    // 等价于
    assertEqual(value ?? "default", "default")
}

// ===== 边界条件 =====

@test
fn test_deeply_nested_optional() {
    var obj = { a: { b: { c: { d: 42 } } } }
    assertEqual(obj?.a?.b?.c?.d, 42)
}

@test
fn test_short_circuit() {
    var count = 0
    fn increment() -> null {
        count++
        return null
    }
    
    var result = increment() ?? "default"
    assertEqual(result, "default")
    assertEqual(count, 1)  // 函数被调用一次
}

