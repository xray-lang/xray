// 0372_range_inclusive.xr
// Test: inclusive range operator `..=`

@test
fn test_inclusive_range_properties() {
    let r = 1..=3
    assert_eq(r.length, 3)
    assert_eq(r.includes(1), true)
    assert_eq(r.includes(3), true)
    assert_eq(r.includes(4), false)
    assert_eq(r[0], 1)
    assert_eq(r[2], 3)
}

@test
fn test_inclusive_for_in() {
    let sum = 0
    for (i in 1..=3) {
        sum = sum + i
    }
    assert_eq(sum, 6)

    let half_sum = 0
    for (i in 1..3) {
        half_sum = half_sum + i
    }
    assert_eq(half_sum, 3)
}

@test
fn test_inclusive_for_in_max_boundary() {
    let max = 9223372036854775807
    let count = 0
    let last = 0
    for (i in max..=max) {
        count = count + 1
        last = i
        continue
    }
    assert_eq(count, 1)
    assert_eq(last, max)
}

@test
fn test_inclusive_length_saturates_without_overflow() {
    let min = -9223372036854775807 - 1
    let max = 9223372036854775807
    assert_eq((min..=max).length, max)
}

@test
fn test_inclusive_match_range() {
    fn bucket(x: int) -> string {
        return match (x) {
            1..=3 -> "low"
            4..6 -> "mid"
            _ -> "other"
        }
    }

    assert_eq(bucket(1), "low")
    assert_eq(bucket(3), "low")
    assert_eq(bucket(5), "mid")
    assert_eq(bucket(6), "other")
}
