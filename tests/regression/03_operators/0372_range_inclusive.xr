// 0372_range_inclusive.xr
// Test: inclusive range operator `..=`

@test
fn test_inclusive_range_properties() {
    var r = 1..=3
    assertEqual(len(r), 3)
    assertEqual(r.contains(1), true)
    assertEqual(r.contains(3), true)
    assertEqual(r.contains(4), false)
    assertEqual(r[0], 1)
    assertEqual(r[2], 3)
    assertEqual(r.toArray(), [1, 2, 3])
}

@test
fn test_inclusive_for_in() {
    var sum = 0
    for (i in 1..=3) {
        sum = sum + i
    }
    assertEqual(sum, 6)

    var half_sum = 0
    for (i in 1..3) {
        half_sum = half_sum + i
    }
    assertEqual(half_sum, 3)
}

@test
fn test_inclusive_for_in_max_boundary() {
    var max = 9223372036854775807
    var count = 0
    var last = 0
    for (i in max..=max) {
        count = count + 1
        last = i
        continue
    }
    assertEqual(count, 1)
    assertEqual(last, max)
}

@test
fn test_inclusive_length_saturates_without_overflow() {
    var min = -9223372036854775807 - 1
    var max = 9223372036854775807
    assertEqual((min..=max).count(), max)
}

@test
fn test_inclusive_match_range() {
    fn bucket(x: i64) -> string {
        return match (x) {
            1..=3 -> "low"
            4..6 -> "mid"
            _ -> "other"
        }
    }

    assertEqual(bucket(1), "low")
    assertEqual(bucket(3), "low")
    assertEqual(bucket(5), "mid")
    assertEqual(bucket(6), "other")
}
