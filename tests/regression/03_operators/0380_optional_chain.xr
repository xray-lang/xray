// 0380_optional_chain.xr
// 作者：xingleixu@gmail.com
// 测试：可选链运算符（?.）

// ===== 基本可选链 =====

@test
fn test_optional_property_access() {
    var person = { name: "Alice", age: 25 }
    var name = person?.name
    assert_eq(name, "Alice")
}

@test
fn test_optional_on_null() {
    var person = null
    var name = person?.name
    assert_eq(name, null)
}

// ===== 嵌套可选链 =====

@test
fn test_nested_optional_chain() {
    var data = {
        user: {
            profile: {
                name: "Bob"
            }
        }
    }
    var name = data?.user?.profile?.name
    assert_eq(name, "Bob")
}

@test
fn test_nested_null_in_chain() {
    var data = {
        user: null
    }
    var name = data?.user?.profile?.name
    assert_eq(name, null)
}

// ===== 可选链与索引访问 =====

@test
fn test_optional_index_access() {
    var data = {
        items: [1, 2, 3]
    }
    var items = data?.items
    assert_eq(items![0], 1)
}

@test
fn test_optional_array_chain() {
    var data = {
        values: [10, 20, 30]
    }
    var vals = data?.values
    assert_eq(vals != null, true)
    assert_eq(vals![1], 20)
}

// ===== ?[ optional index access =====

@test
fn test_optional_index_on_array() {
    var arr = [10, 20, 30]
    var val = arr?[1]
    assert_eq(val, 20)
}

@test
fn test_optional_index_on_null() {
    var arr = null
    var val = arr?[0]
    assert_eq(val, null)
}

@test
fn test_optional_index_nested() {
    var data = {
        items: [100, 200, 300]
    }
    var val = data?.items?[2]
    assert_eq(val, 300)
}

@test
fn test_optional_index_null_nested() {
    var data = {
        items: null
    }
    var val = data?.items?[0]
    assert_eq(val, null)
}

@test
fn test_optional_index_with_nullish() {
    var arr = null
    var val = arr?[0] ?? "fallback"
    assert_eq(val, "fallback")
}

// ===== 与空值合并组合 =====

@test
fn test_optional_with_nullish() {
    var config = {
        settings: null
    }
    var theme = config?.settings?.theme ?? "default"
    assert_eq(theme, "default")
}

@test
fn test_optional_value_with_nullish() {
    var config = {
        settings: {
            theme: "dark"
        }
    }
    var theme = config?.settings?.theme ?? "default"
    assert_eq(theme, "dark")
}

// ===== Optional chain method calls =====

@test
fn test_optional_method_on_value() {
    var s: string? = "42"
    var n = s == null ? null : i64.tryParse(s!)
    assert_eq(n, 42)
}

@test
fn test_optional_method_on_null() {
    var s: string? = null
    var n = s == null ? null : i64.tryParse(s!)
    assert_eq(n, null)
}

@test
fn test_optional_method_substring() {
    var s: string? = "hello world"
    var sub = s?.slice(0, 5)
    assert_eq(sub, "hello")
}

@test
fn test_optional_method_on_array() {
    var arr: Array<i64>? = [1, 2, 3]
    var rev = arr?.reverse()
    assert_eq(rev, [3, 2, 1])
}

@test
fn test_optional_method_on_null_array() {
    var arr: Array<i64>? = null
    var rev = arr?.reverse()
    assert_eq(rev, null)
}
