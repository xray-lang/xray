// 0380_optional_chain.xr
// 作者：xingleixu@gmail.com
// 测试：可选链运算符（?.）

// ===== 基本可选链 =====

@test
fn test_optional_property_access() {
    let person = { name: "Alice", age: 25 }
    let name = person?.name
    assert_eq(name, "Alice")
}

@test
fn test_optional_on_null() {
    let person = null
    let name = person?.name
    assert_eq(name, null)
}

// ===== 嵌套可选链 =====

@test
fn test_nested_optional_chain() {
    let data = {
        user: {
            profile: {
                name: "Bob"
            }
        }
    }
    let name = data?.user?.profile?.name
    assert_eq(name, "Bob")
}

@test
fn test_nested_null_in_chain() {
    let data = {
        user: null
    }
    let name = data?.user?.profile?.name
    assert_eq(name, null)
}

// ===== 可选链与索引访问 =====

@test
fn test_optional_index_access() {
    let data = {
        items: [1, 2, 3]
    }
    let items = data?.items
    assert_eq(items[0], 1)
}

@test
fn test_optional_array_chain() {
    let data = {
        values: [10, 20, 30]
    }
    let vals = data?.values
    assert_eq(vals != null, true)
    assert_eq(vals[1], 20)
}

// ===== ?[ optional index access =====

@test
fn test_optional_index_on_array() {
    let arr = [10, 20, 30]
    let val = arr?[1]
    assert_eq(val, 20)
}

@test
fn test_optional_index_on_null() {
    let arr = null
    let val = arr?[0]
    assert_eq(val, null)
}

@test
fn test_optional_index_nested() {
    let data = {
        items: [100, 200, 300]
    }
    let val = data?.items?[2]
    assert_eq(val, 300)
}

@test
fn test_optional_index_null_nested() {
    let data = {
        items: null
    }
    let val = data?.items?[0]
    assert_eq(val, null)
}

@test
fn test_optional_index_with_nullish() {
    let arr = null
    let val = arr?[0] ?? "fallback"
    assert_eq(val, "fallback")
}

// ===== 与空值合并组合 =====

@test
fn test_optional_with_nullish() {
    let config = {
        settings: null
    }
    let theme = config?.settings?.theme ?? "default"
    assert_eq(theme, "default")
}

@test
fn test_optional_value_with_nullish() {
    let config = {
        settings: {
            theme: "dark"
        }
    }
    let theme = config?.settings?.theme ?? "default"
    assert_eq(theme, "dark")
}

// ===== Optional chain method calls =====

@test
fn test_optional_method_on_value() {
    let s: string? = "42"
    let n = s?.toInt()
    assert_eq(n, 42)
}

@test
fn test_optional_method_on_null() {
    let s: string? = null
    let n = s?.toInt()
    assert_eq(n, null)
}

@test
fn test_optional_method_substring() {
    let s: string? = "hello world"
    let sub = s?.substring(0, 5)
    assert_eq(sub, "hello")
}

@test
fn test_optional_method_on_array() {
    let arr: Array<int>? = [1, 2, 3]
    let rev = arr?.reverse()
    assert_eq(rev, [3, 2, 1])
}

@test
fn test_optional_method_on_null_array() {
    let arr: Array<int>? = null
    let rev = arr?.reverse()
    assert_eq(rev, null)
}
