// 测试：范围运算符

// ===== 基本范围 =====

@test
fn test_basic_range() {
    var sum = 0
    for (i in 0..5) {
        sum = sum + i
    }
    assertEqual(sum, 10)  // 0+1+2+3+4
}

@test
fn test_range_start_one() {
    var sum = 0
    for (i in 1..5) {
        sum = sum + i
    }
    assertEqual(sum, 10)  // 1+2+3+4
}

// ===== 范围边界 =====

@test
fn test_range_single() {
    var count = 0
    for (i in 0..1) {
        count = count + 1
    }
    assertEqual(count, 1)
}

@test
fn test_range_empty() {
    var count = 0
    for (i in 5..5) {
        count = count + 1
    }
    assertEqual(count, 0)
}

// ===== 范围与变量 =====

@test
fn test_range_variable_end() {
    var n = 5
    var sum = 0
    for (i in 0..n) {
        sum = sum + i
    }
    assertEqual(sum, 10)
}

@test
fn test_range_both_variables() {
    var start = 2
    var end = 6
    var sum = 0
    for (i in start..end) {
        sum = sum + i
    }
    assertEqual(sum, 14)  // 2+3+4+5
}

// ===== 范围嵌套 =====

@test
fn test_nested_ranges() {
    var count = 0
    for (i in 0..3) {
        for (j in 0..3) {
            count = count + 1
        }
    }
    assertEqual(count, 9)
}

// ===== 范围与数组 =====

@test
fn test_range_array_index() {
    var arr = [10, 20, 30, 40, 50]
    var sum = 0
    for (i in 0..len(arr)) {
        sum = sum + arr[i]
    }
    assertEqual(sum, 150)
}

// ===== 范围计算 =====

@test
fn test_range_expression_end() {
    var n = 3
    var sum = 0
    for (i in 0..(n * 2)) {
        sum = sum + i
    }
    assertEqual(sum, 15)  // 0+1+2+3+4+5
}

// Range endpoints are additive expressions, so the parentheses above are
// optional. These are the loop bounds people actually write; before range got
// its own precedence level they parsed as `(0..n) * 2` and failed.

@test
fn test_range_end_takes_arithmetic_without_parens() {
    var n = 3
    var sum = 0
    for (i in 0..n * 2) {
        sum = sum + i
    }
    assertEqual(sum, 15)

    var sum2 = 0
    for (i in 0..n + 1) {
        sum2 = sum2 + i
    }
    assertEqual(sum2, 6)  // 0+1+2+3

    var sum3 = 0
    for (i in 0..n - 1) {
        sum3 = sum3 + i
    }
    assertEqual(sum3, 1)  // 0+1

    var sum4 = 0
    for (i in 1..=n + 1) {
        sum4 = sum4 + i
    }
    assertEqual(sum4, 10)  // 1+2+3+4
}

@test
fn test_range_start_takes_arithmetic_without_parens() {
    var n = 2
    var sum = 0
    for (i in n - 1..n * 3) {
        sum = sum + i
    }
    assertEqual(sum, 15)  // 1+2+3+4+5
}

@test
fn test_range_endpoints_use_len_and_calls() {
    var a: Array<i64> = [10, 20, 30, 40]
    var sum = 0
    for (i in 0..len(a) - 1) {
        sum = sum + a[i]
    }
    assertEqual(sum, 60)  // a[0]+a[1]+a[2]
}

// Range binds looser than `+ -` but tighter than shifts, comparisons and the
// logical operators, so a whole range is what those operators see.

@test
fn test_range_binds_tighter_than_comparison() {
    var n = 2
    assert(len(0..n + 1) == 3, "range is the left operand of ==, not `n + 1 == 3`")
    assert(len(0..n) == 2 && true, "&& sees the comparison, not the range end")
}

