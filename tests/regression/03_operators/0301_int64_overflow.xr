// 0301_int64_overflow.xr
// Test: 64-bit integer wrap-on-overflow semantics
//
// Tagged Union uses full 64-bit signed integer range:
//   INT64_MAX =  9223372036854775807  ( 2^63 - 1)
//   INT64_MIN = -9223372036854775808  (-2^63)
//
// All integer overflow wraps (Go/Rust/Java semantics).
// No auto-promotion to BigInt. BigInt must be used explicitly.

// ===== Boundary constants =====

@test
fn test_int64_max_value() {
    var max: i64 = 9223372036854775807
    assertEqual(max, 9223372036854775807)
    assertEqual(typeName(max), "i64")
}

@test
fn test_int64_min_value() {
    var min: i64 = -9223372036854775807 - 1
    assertEqual(min, -9223372036854775807 - 1)
}

@test
fn test_boundary_identity() {
    var max: i64 = 9223372036854775807
    var min: i64 = -9223372036854775807 - 1
    assertEqual(max - max, 0)
    assertEqual(min - min, 0)
    assertEqual(max * 1, max)
    assertEqual(min * 1, min)
    assertEqual(max * 0, 0)
    assertEqual(max + 0, max)
    assertEqual(min + 0, min)
}

// ===== Large values within int64 range =====

@test
fn test_large_values_still_int() {
    var a: i64 = 140737488355327
    var r = a + 1
    assertEqual(r, 140737488355328)
    assertEqual(typeName(r), "i64")
}

@test
fn test_large_addition_still_int() {
    var a: i64 = 100000000000000
    var b: i64 = 100000000000000
    var r = a + b
    assertEqual(r, 200000000000000)
    assertEqual(typeName(r), "i64")
}

// ===== Addition overflow wraps =====

@test
fn test_add_near_boundary_ok() {
    var a: i64 = 9223372036854775806
    assertEqual(a + 1, 9223372036854775807)
}

@test
fn test_add_overflow_wraps() {
    var max: i64 = 9223372036854775807
    var r = max + 1
    // INT64_MAX + 1 wraps to INT64_MIN
    assertEqual(r, -9223372036854775807 - 1)
    assertEqual(typeName(r), "i64")
}

@test
fn test_add_negative_overflow_wraps() {
    var min: i64 = -9223372036854775807 - 1
    var r = min + (-1)
    // INT64_MIN + (-1) wraps to INT64_MAX
    assertEqual(r, 9223372036854775807)
    assertEqual(typeName(r), "i64")
}

// ===== Subtraction overflow wraps =====

@test
fn test_sub_near_boundary_ok() {
    var a: i64 = -9223372036854775807
    assertEqual(a - 1, -9223372036854775807 - 1)
}

@test
fn test_sub_overflow_wraps() {
    var min: i64 = -9223372036854775807 - 1
    var r = min - 1
    // INT64_MIN - 1 wraps to INT64_MAX
    assertEqual(r, 9223372036854775807)
    assertEqual(typeName(r), "i64")
}

@test
fn test_sub_positive_overflow_wraps() {
    var max: i64 = 9223372036854775807
    var r = max - (-1)
    // INT64_MAX - (-1) = INT64_MAX + 1 wraps to INT64_MIN
    assertEqual(r, -9223372036854775807 - 1)
    assertEqual(typeName(r), "i64")
}

// ===== Multiplication overflow wraps =====

@test
fn test_mul_within_range() {
    var a: i64 = 1000000
    assertEqual(a * 1000000, 1000000000000)
}

@test
fn test_mul_overflow_wraps() {
    var max: i64 = 9223372036854775807
    var r = max * 2
    // INT64_MAX * 2 wraps: result is -2 (unsigned: 0xFFFFFFFFFFFFFFFE)
    assertEqual(r, -2)
    assertEqual(typeName(r), "i64")
}

@test
fn test_mul_both_large_ok() {
    var a: i64 = 3000000000
    var b: i64 = 3000000001
    var r = a * b
    assertEqual(r, 9000000003000000000)
    assertEqual(typeName(r), "i64")
}

// ===== Negation overflow wraps =====

@test
fn test_neg_normal() {
    assertEqual(-42, -42)
    assertEqual(-(-42), 42)
    assertEqual(-140737488355327, -140737488355327)
}

@test
fn test_neg_min_wraps() {
    var min: i64 = -9223372036854775807 - 1
    var r = -min
    // -INT64_MIN wraps to INT64_MIN (two's complement)
    assertEqual(r, -9223372036854775807 - 1)
    assertEqual(typeName(r), "i64")
}

// ===== Left shift within range =====

@test
fn test_shift_within_range() {
    var one: i64 = 1
    assertEqual(one << 46, 70368744177664)
    assertEqual(one << 62, 4611686018427387904)
}

// ===== Compound assignment overflow wraps =====

@test
fn test_compound_add_wraps() {
    var x: i64 = 9223372036854775807
    x += 1
    assertEqual(x, -9223372036854775807 - 1)
    assertEqual(typeName(x), "i64")
}

@test
fn test_compound_sub_wraps() {
    var x: i64 = -9223372036854775807 - 1
    x -= 1
    assertEqual(x, 9223372036854775807)
    assertEqual(typeName(x), "i64")
}

@test
fn test_compound_mul_wraps() {
    var x: i64 = 9223372036854775807
    x *= 2
    assertEqual(x, -2)
    assertEqual(typeName(x), "i64")
}

// ===== Compound assignment within range =====

@test
fn test_compound_near_boundary_ok() {
    var x: i64 = 9223372036854775806
    x += 1
    assertEqual(x, 9223372036854775807)

    var y: i64 = -9223372036854775807
    y -= 1
    assertEqual(y, -9223372036854775807 - 1)
}

// ===== Negative * negative boundary =====

@test
fn test_mul_neg_neg_ok() {
    var a: i64 = 140737488355327
    assertEqual(a * -1, -140737488355327)
}

// ===== INT64_MIN / -1 wrap (would overflow signed range) =====
//
// 2^63 cannot fit in int64, so VM/JIT/AOT all wrap:
//   INT64_MIN / -1 = INT64_MIN
//   INT64_MIN % -1 = 0
// On x64 this requires the JIT to detect the case before IDIV (which
// raises #DE / SIGFPE); on ARM64 SDIV produces the wrap naturally.

@test
fn test_div_min_neg_one_wraps() {
    var min: i64 = -9223372036854775807 - 1
    var r = min / -1
    assertEqual(r, -9223372036854775807 - 1)
    assertEqual(typeName(r), "i64")
}

@test
fn test_mod_min_neg_one_is_zero() {
    var min: i64 = -9223372036854775807 - 1
    var r = min % -1
    assertEqual(r, 0)
    assertEqual(typeName(r), "i64")
}

@test
fn test_div_min_neg_one_in_loop() {
    // Loop forces JIT compilation on hot paths so that the wrap path
    // is exercised on the JIT side, not just the interpreter.
    var min: i64 = -9223372036854775807 - 1
    var acc: i64 = 0
    for (i in 0..200) {
        acc += min / -1
    }
    // min / -1 = min, summed 200 times wraps repeatedly.
    // 200 * min mod 2^64: 200 * (-2^63) wraps; explicit value: 0
    // because (-2^63 * 200) mod 2^64 = (-2^63 * 200 + k * 2^64) for some k
    // 200 * 2^63 = 25 * 2^66 = (multiple of 2^64) so result wraps to 0.
    assertEqual(acc, 0)
}

@test
fn test_div_normal_with_neg_one_divisor() {
    // Non-INT64_MIN dividends with -1 divisor stay correct.
    assertEqual(42 / -1, -42)
    assertEqual(-42 / -1, 42)
    assertEqual(0 / -1, 0)
    var big: i64 = 9223372036854775807
    assertEqual(big / -1, -9223372036854775807)
}

// ===== int.abs() boundary =====
//
// (-INT64_MIN) is signed-overflow UB. abs() must wrap, returning
// INT64_MIN itself instead of letting the compiler emit a NEG that
// triggers SIGFPE in some build configurations.

@test
fn test_abs_min_wraps() {
    var min: i64 = -9223372036854775807 - 1
    assertEqual(min.abs(), -9223372036854775807 - 1)
}

@test
fn test_abs_normal() {
    assertEqual((-42).abs(), 42)
    assertEqual((42).abs(), 42)
    assertEqual((0).abs(), 0)
    var max: i64 = 9223372036854775807
    assertEqual(max.abs(), 9223372036854775807)
}

// ===== Explicit overflow-control methods =====

@test
fn test_checked_add_sub_mul() {
    var max: i64 = 9223372036854775807
    var min: i64 = -9223372036854775807 - 1
    assertEqual(max.checkedAdd(0), max)
    assertEqual(max.checkedAdd(1), null)
    assertEqual(min.checkedAdd(-1), null)
    assertEqual(40.checkedAdd(2), 42)

    assertEqual(min.checkedSub(0), min)
    assertEqual(min.checkedSub(1), null)
    assertEqual(max.checkedSub(-1), null)
    assertEqual(10.checkedSub(3), 7)

    assertEqual(max.checkedMul(1), max)
    assertEqual(max.checkedMul(2), null)
    assertEqual(min.checkedMul(-1), null)
    assertEqual(7.checkedMul(6), 42)
}

@test
fn test_saturating_add_sub_mul() {
    var max: i64 = 9223372036854775807
    var min: i64 = -9223372036854775807 - 1
    assertEqual(max.saturatingAdd(1), max)
    assertEqual(min.saturatingAdd(-1), min)
    assertEqual(max.saturatingSub(-1), max)
    assertEqual(min.saturatingSub(1), min)
    assertEqual(max.saturatingMul(2), max)
    assertEqual(min.saturatingMul(2), min)
    assertEqual(min.saturatingMul(-1), max)
}

@test
fn test_wrapping_add_sub_mul() {
    var max: i64 = 9223372036854775807
    var min: i64 = -9223372036854775807 - 1
    assertEqual(max.wrappingAdd(1), min)
    assertEqual(min.wrappingAdd(-1), max)
    assertEqual(min.wrappingSub(1), max)
    assertEqual(max.wrappingSub(-1), min)
    assertEqual(max.wrappingMul(2), -2)
    assertEqual(min.wrappingMul(-1), min)
}

@test
fn test_to_hex_min_boundary() {
    var min: i64 = -9223372036854775807 - 1
    assertEqual(min.toHex(), "-0x8000000000000000")
}
