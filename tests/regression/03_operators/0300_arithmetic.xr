// 0300_arithmetic.xr
// 作者：xingleixu@gmail.com
// 测试：算术运算符

// ===== 加法 =====

@test
fn test_add_integers() {
    assertEqual(1 + 2, 3)
    assertEqual(0 + 0, 0)
    assertEqual(-1 + 1, 0)
    assertEqual(-5 + -3, -8)
}

@test
fn test_add_floats() {
    assertEqual(1.5 + 2.5, 4.0)
    assertEqual(0.0 + 0.0, 0.0)
    assertEqual(-1.5 + 1.5, 0.0)
}

@test
fn test_add_mixed() {
    assertEqual((1 as f64) + 1.5, 2.5)
    assertEqual(2.5 + (1 as f64), 3.5)
}

// ===== 减法 =====

@test
fn test_sub_integers() {
    assertEqual(5 - 3, 2)
    assertEqual(0 - 0, 0)
    assertEqual(3 - 5, -2)
    assertEqual(-5 - -3, -2)
}

@test
fn test_sub_floats() {
    assertEqual(5.5 - 2.5, 3.0)
    assertEqual(1.0 - 1.0, 0.0)
}

@test
fn test_sub_mixed() {
    assertEqual((5 as f64) - 2.5, 2.5)
    assertEqual(5.5 - (2 as f64), 3.5)
}

// ===== 乘法 =====

@test
fn test_mul_integers() {
    assertEqual(3 * 4, 12)
    assertEqual(0 * 100, 0)
    assertEqual(-3 * 4, -12)
    assertEqual(-3 * -4, 12)
}

@test
fn test_mul_floats() {
    assertEqual(2.5 * 4.0, 10.0)
    assertEqual(0.5 * 0.5, 0.25)
}

@test
fn test_mul_mixed() {
    assertEqual((2 as f64) * 2.5, 5.0)
    assertEqual(2.5 * (2 as f64), 5.0)
}

// ===== 除法 =====

@test
fn test_div_integers() {
    assertEqual(10 / 2, 5)
    assertEqual(7 / 2, 3)  // 整数除法
    assertEqual(-10 / 3, -3)
}

@test
fn test_div_floats() {
    assertEqual(10.0 / 4.0, 2.5)
    assertEqual(1.0 / 2.0, 0.5)
}

@test
fn test_div_mixed() {
    assertEqual((5 as f64) / 2.0, 2.5)
    assertEqual(5.0 / (2 as f64), 2.5)
}

// ===== 取模 =====

@test
fn test_mod_positive() {
    assertEqual(10 % 3, 1)
    assertEqual(15 % 5, 0)
    assertEqual(7 % 4, 3)
}

@test
fn test_mod_negative() {
    assertEqual(-10 % 3, -1)
    assertEqual(10 % -3, 1)
}

@test
fn test_mod_zero_dividend() {
    assertEqual(0 % 5, 0)
}

// ===== 一元运算 =====

@test
fn test_unary_minus() {
    assertEqual(-5, -5)
    assertEqual(-(-5), 5)
    assertEqual(-(3 + 2), -5)
}

// 注意：xray 不支持一元正运算符 +x

// ===== 边界条件 =====

@test
fn test_with_zero() {
    assertEqual(0 + 5, 5)
    assertEqual(5 - 0, 5)
    assertEqual(0 * 100, 0)
    assertEqual(0 / 100, 0)
}

@test
fn test_identity() {
    assertEqual(5 + 0, 5)
    assertEqual(5 - 0, 5)
    assertEqual(5 * 1, 5)
    assertEqual(5 / 1, 5)
}

@test
fn test_chained() {
    assertEqual(1 + 2 + 3, 6)
    assertEqual(10 - 3 - 2, 5)
    assertEqual(2 * 3 * 4, 24)
}

// ===== 优先级 =====

@test
fn test_precedence() {
    assertEqual(2 + 3 * 4, 14)      // 乘法优先
    assertEqual((2 + 3) * 4, 20)    // 括号优先
    assertEqual(10 - 4 / 2, 8)      // 除法优先
    assertEqual(10 / 2 + 3, 8)
}

