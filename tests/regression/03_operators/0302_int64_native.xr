// 0302_int64_native.xr
// Test: int64 native operations (no 48-bit limit) + division by zero
//
// All arithmetic uses native 64-bit instructions when typed as int.
// These tests deliberately exercise >48-bit values and edge cases
// to expose any hidden boxing/overflow issues in the compiler.

// ===== Basic int64 arithmetic =====

@test
fn test_int64_add() {
    var a: i64 = 100
    var b: i64 = 200
    assertEqual(a + b, 300)
}

@test
fn test_int64_sub() {
    var a: i64 = 100
    var b: i64 = 200
    assertEqual(a - b, -100)
}

@test
fn test_int64_mul() {
    var a: i64 = 1000000
    var b: i64 = 1000000
    assertEqual(a * b, 1000000000000)
}

@test
fn test_int64_div() {
    var a: i64 = 100
    var b: i64 = 3
    assertEqual(a / b, 33)
}

@test
fn test_int64_mod() {
    var a: i64 = 100
    var b: i64 = 3
    assertEqual(a % b, 1)
}

@test
fn test_int64_neg() {
    var a: i64 = 42
    assertEqual(-a, -42)
}

// ===== Beyond 48-bit: assertEqual with both I64 operands =====

@test
fn test_int64_beyond_48bit_add() {
    var a: i64 = 140737488355327
    var b: i64 = 1
    var result: i64 = a + b
    // Both sides are I64 — should use OP_EQ_I64, no boxing
    assertEqual(result - b, a)
}

@test
fn test_int64_large_multiply_verify() {
    var a: i64 = 1000000000
    var b: i64 = 1000000000
    var result: i64 = a * b
    // Both sides are I64 — should use OP_EQ_I64
    assertEqual(result / a, b)
}

@test
fn test_int64_negative_large() {
    var a: i64 = -140737488355328
    var b: i64 = -1
    var result: i64 = a + b
    assertEqual(result + 1, a)
}

// ===== Beyond 48-bit: assertEqual with >48-bit literal =====
// This tests whether assertEqual(I64_var, literal) correctly avoids boxing
// when the literal exceeds 48-bit range.

@test
fn test_int64_large_literal_equality() {
    var a: i64 = 140737488355327
    var b: i64 = a + 1
    // b = 140737488355328 (>48-bit), assertEqual second arg is I64 expr
    var expected: i64 = 140737488355328
    assertEqual(b, expected)
}

// ===== Beyond 48-bit: comparison in expression context =====
// assert(result > a) where both are I64 — does it box?

@test
fn test_int64_comparison_expr() {
    var a: i64 = 140737488355327
    var b: i64 = 1
    var result: i64 = a + b
    // This tests if > comparison boxes I64 operands
    assert(result > a)
}

@test
fn test_int64_comparison_expr_lt() {
    var a: i64 = 140737488355327
    var result: i64 = a + 1000
    assert(a < result)
}

@test
fn test_int64_comparison_eq_expr() {
    var a: i64 = 140737488355327
    var b: i64 = a
    assert(a == b)
}

// ===== Division by zero =====

@test
fn test_int64_div_by_zero() {
    var a: i64 = 42
    var zero: i64 = 0
    assertPanics(fn() { var r = a / zero })
}

@test
fn test_int64_mod_by_zero() {
    var a: i64 = 42
    var zero: i64 = 0
    assertPanics(fn() { var r = a % zero })
}

// ===== Bitwise operations =====

@test
fn test_int64_bitwise() {
    var a: i64 = 0xFF00
    var b: i64 = 0x0FF0
    assertEqual(a & b, 0x0F00)
    assertEqual(a | b, 0xFFF0)
    assertEqual(a ^ b, 0xF0F0)
}

// ===== Shift operations beyond 48-bit =====

@test
fn test_int64_shift_large() {
    var a: i64 = 1
    var r47: i64 = a << 47
    // 2^47 = 140737488355328, verify via shift back
    assertEqual(r47 >> 47, 1)
}

@test
fn test_int64_shift_62() {
    var a: i64 = 1
    var r62: i64 = a << 62
    assertEqual(r62 >> 62, 1)
}

// ===== Compound assignment beyond 48-bit =====

@test
fn test_int64_compound_add_large() {
    var x: i64 = 140737488355327
    x += 1000
    assertEqual(x - 1000, 140737488355327)
}

@test
fn test_int64_compound_mul_large() {
    var x: i64 = 1000000000
    x *= 1000000000
    assertEqual(x / 1000000000, 1000000000)
}

// ===== typeof =====

@test
fn test_typeof_int64() {
    var a: i64 = 42
    assertEqual(typeName(a), "i64")
}

@test
fn test_typeof_float64() {
    var a: f64 = 3.14
    assertEqual(typeName(a), "f64")
}
