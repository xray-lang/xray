// 作者：xingleixu@gmail.com
// 测试：Range 方法与属性 —— 端点包含性与 for-in 一致 (半开区间 [start, end))

// ===== 属性访问 =====

@test
fn test_range_start_property() {
    var r = 1..10
    assertEqual(r.start, 1)
}

@test
fn test_range_end_property() {
    var r = 1..10
    assertEqual(r.end, 10)
}

@test
fn test_range_count() {
    // 半开区间 [1, 10) 的元素数 = 9
    var r = 1..10
    assertEqual(r.count(), 9)
}

@test
fn test_range_count_empty() {
    var r = 5..5
    assertEqual(r.count(), 0)
}

@test
fn test_range_length_matches_iteration() {
    // length 与 for-in 迭代次数必须一致
    var count = 0
    for (i in 0..7) {
        count = count + 1
    }
    assertEqual(count, (0..7).count())
}

// ===== contains —— 半开区间 [start, end) =====

@test
fn test_contains_start() {
    // start 端点包含
    assertEqual((1..10).contains(1), true)
}

@test
fn test_contains_end_exclusive() {
    // end 端点不包含 (核心修复点)
    assertEqual((1..10).contains(10), false)
}

@test
fn test_contains_last_iterated() {
    // 最后被迭代的值 (end - 1) 必须包含
    assertEqual((1..10).contains(9), true)
}

@test
fn test_contains_below_start() {
    assertEqual((1..10).contains(0), false)
}

@test
fn test_contains_above_end() {
    assertEqual((1..10).contains(100), false)
}

@test
fn test_contains_empty_range() {
    var r = 5..5
    assertEqual(r.contains(5), false)
    assertEqual(r.contains(4), false)
}

// ===== contains 与 for-in 必须语义一致 =====

@test
fn test_contains_matches_iteration() {
    // 对 [0, 5) 内的每个候选值，contains(x) 必须 ⇔ x 在 for-in 中出现
    var i = -2
    while (i < 8) {
        var by_for = false
        for (j in 0..5) {
            if (j == i) {
                by_for = true
            }
        }
        assertEqual((0..5).contains(i), by_for)
        i = i + 1
    }
}
