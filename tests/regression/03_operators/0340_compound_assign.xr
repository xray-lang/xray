// 测试：复合赋值运算符

// ===== 算术复合赋值 =====

@test
fn test_add_assign() {
    var x = 10
    x += 5
    assertEqual(x, 15)
    
    x += -3
    assertEqual(x, 12)
}

@test
fn test_sub_assign() {
    var x = 10
    x -= 3
    assertEqual(x, 7)
    
    x -= -2
    assertEqual(x, 9)
}

@test
fn test_mul_assign() {
    var x = 5
    x *= 3
    assertEqual(x, 15)
    
    x *= 2
    assertEqual(x, 30)
}

@test
fn test_div_assign() {
    var x = 20
    x /= 4
    assertEqual(x, 5)
    
    x /= 2
    assertEqual(x, 2)
}

@test
fn test_mod_assign() {
    var x = 17
    x %= 5
    assertEqual(x, 2)
}

@test
fn test_member_mod_assign_ignores_same_named_const() {
    class Counter {
        value: i64

        constructor() {
            this.value = 17
        }

        ref reduce() {
            this.value %= 5
        }

        get() -> i64 {
            return this.value
        }
    }

    const value = 99
    var c = Counter()
    c.reduce()
    assertEqual(c.get(), 2)
    assertEqual(value, 99)
}

// ===== 位运算复合赋值 =====

@test
fn test_and_assign() {
    var x = 0b1111
    x &= 0b1010
    assertEqual(x, 0b1010)
}

@test
fn test_or_assign() {
    var x = 0b1010
    x |= 0b0101
    assertEqual(x, 0b1111)
}

@test
fn test_xor_assign() {
    var x = 0b1111
    x ^= 0b1010
    assertEqual(x, 0b0101)
}

@test
fn test_shl_assign() {
    var x = 1
    x <<= 3
    assertEqual(x, 8)
}

@test
fn test_shr_assign() {
    var x = 16
    x >>= 2
    assertEqual(x, 4)
}

// ===== 自增自减 =====

// xray 仅支持后置自增自减，且只能单独成行

@test
fn test_increment_postfix() {
    var x = 5
    x++
    assertEqual(x, 6)
}

@test
fn test_decrement_postfix() {
    var x = 5
    x--
    assertEqual(x, 4)
}

// ===== 链式操作 =====

@test
fn test_chain_increment() {
    var x = 0
    x++
    x++
    x++
    assertEqual(x, 3)
}

// ===== 浮点数 =====

@test
fn test_float_compound() {
    var x = 1.5
    x += 2.5
    assertEqual(x, 4.0)
    
    x *= 2.0
    assertEqual(x, 8.0)
}

// ===== 边界条件 =====

@test
fn test_assign_zero() {
    var x = 10
    x += 0
    assertEqual(x, 10)
    
    x *= 0
    assertEqual(x, 0)
}

@test
fn test_negative_increment() {
    var x = 0
    x--
    assertEqual(x, -1)
}
