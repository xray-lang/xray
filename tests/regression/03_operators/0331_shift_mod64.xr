// 0331_shift_mod64.xr
// Test: shift count is taken modulo 64 (spec "Expressions" §3).
//
// Unlike C, xray shifts are ALWAYS defined:
//   x << n  ===  x << (n & 63)   (left shift via uint64, wraps)
//   x >> n  ===  x >> (n & 63)   (ARITHMETIC right shift, sign-extends)
//
// This must hold identically across VM, JIT (hardware CL/LSL/SLL masking),
// AOT (xrt_i64_shl/shr) and constant folding (xi_opt / SCCP / xm_fold).
// Each case is exercised twice: once with runtime variables (interpreter /
// JIT path) and once inside a hot loop (forces JIT + optimizer folds).

// ===== Count mod 64: out-of-range counts wrap around =====

@test
fn test_shl_count_64_is_identity() {
    var x: i64 = 12345
    var n: i64 = 64
    assertEqual(x << n, 12345)   // 64 & 63 == 0
    assertEqual(x << 64, 12345)  // constant-folded path must agree
}

@test
fn test_shl_count_65_is_shift_1() {
    var x: i64 = 7
    var n: i64 = 65
    assertEqual(x << n, 14)
    assertEqual(x << 65, 14)
}

@test
fn test_shr_count_64_is_identity() {
    var x: i64 = -12345
    var n: i64 = 64
    assertEqual(x >> n, -12345)
    assertEqual(x >> 64, -12345)
}

@test
fn test_shr_count_70_is_shift_6() {
    var x: i64 = 640
    var n: i64 = 70
    assertEqual(x >> n, 10)
    assertEqual(x >> 70, 10)
}

// ===== Negative count: -1 & 63 == 63 =====

@test
fn test_shl_negative_count() {
    var one: i64 = 1
    var n: i64 = -1
    // 1 << 63 == INT64_MIN
    assertEqual(one << n, -9223372036854775807 - 1)
    assertEqual(one << -1, -9223372036854775807 - 1)
}

@test
fn test_shr_negative_count() {
    var x: i64 = -1
    var n: i64 = -1
    // -1 >> 63 == -1 (arithmetic shift keeps the sign)
    assertEqual(x >> n, -1)
}

// ===== Arithmetic right shift on negative values =====

@test
fn test_shr_negative_value_sign_extends() {
    var x: i64 = -8
    var n: i64 = 1
    assertEqual(x >> n, -4)
    assertEqual(-8 >> 1, -4)      // constant fold must be arithmetic too
    assertEqual(-1 >> 63, -1)
    assertEqual(-9223372036854775807 - 1 >> 63, -1)
}

// ===== Left shift wraps through the sign bit =====

@test
fn test_shl_into_sign_bit_wraps() {
    var one: i64 = 1
    var s: i64 = 63
    assertEqual(one << s, -9223372036854775807 - 1)
    var three: i64 = 3
    // 3 << 63 wraps: only bit 63 survives
    assertEqual(three << 63, -9223372036854775807 - 1)
}

@test
fn test_shl_negative_value_defined() {
    var x: i64 = -1
    var n: i64 = 1
    assertEqual(x << n, -2)
    assertEqual(-1 << 1, -2)
}

// ===== Hot loop: exercise the JIT + optimizer pipeline =====

@test
fn test_shift_mod64_in_hot_loop() {
    var acc: i64 = 0
    for (i in 0..300) {
        var x: i64 = 12345
        acc += (x << 64) - x        // identity → contributes 0
        acc += (x >> 64) - x        // identity → contributes 0
        acc += ((-8) >> 1) + 4      // arithmetic → contributes 0
    }
    assertEqual(acc, 0)
}

// ===== Compound assignment uses the same semantics =====

@test
fn test_compound_shift_mod64() {
    var x: i64 = 5
    x <<= 64
    assertEqual(x, 5)
    x >>= 64
    assertEqual(x, 5)
    var y: i64 = -32
    y >>= 2
    assertEqual(y, -8)
}

// ===== BigInt: counts are NOT masked; negative counts are an error =====

@test
fn test_bigint_shift_positive_count_unmasked() {
    var a = 1.toBigInt()
    // BigInt << 64 is a true 64-bit shift (arbitrary precision, no mod-64)
    assertEqual((a << 64).toString(), "18446744073709551616")
}

@test
fn test_bigint_negative_shift_count_panics() {
    var a = 1.toBigInt()
    var caught = false
    // An out-of-range bigint shift count is a runtime fault on the panic
    // channel; a plain `catch` only sees user-thrown enum errors.
    try {
        var r = a << -1
        print(r)  // unreachable
    } catch panic (e) {
        caught = true
    }
    assert(caught)
}

@test
fn test_bigint_right_shift_past_magnitude_is_zero() {
    assertEqual((1.toBigInt() >> 4096).toString(), "0")
    assertEqual((((-8).toBigInt()) >> 1).toString(), "-4")
}
