// 测试：逻辑运算符

// ===== AND (&&) =====

@test
fn test_and_truth_table() {
    assertEqual(true && true, true)
    assertEqual(true && false, false)
    assertEqual(false && true, false)
    assertEqual(false && false, false)
}

@test
fn test_and_with_expressions() {
    assertEqual((5 > 3) && (2 < 4), true)
    assertEqual((5 > 3) && (2 > 4), false)
}

@test
fn test_and_short_circuit() {
    var called = false
    fn sideEffect() -> bool {
        called = true
        return true
    }
    
    // false && ... 不会执行右侧
    var result = false && sideEffect()
    assertEqual(result, false)
    assertEqual(called, false)
}

@test
fn test_and_chain() {
    assertEqual(true && true && true, true)
    assertEqual(true && true && false, false)
    assertEqual(true && false && true, false)
}

// ===== OR (||) =====

@test
fn test_or_truth_table() {
    assertEqual(true || true, true)
    assertEqual(true || false, true)
    assertEqual(false || true, true)
    assertEqual(false || false, false)
}

@test
fn test_or_with_expressions() {
    assertEqual((5 > 10) || (2 < 4), true)
    assertEqual((5 > 10) || (2 > 4), false)
}

@test
fn test_or_short_circuit() {
    var called = false
    fn sideEffect() -> bool {
        called = true
        return true
    }
    
    // true || ... 不会执行右侧
    var result = true || sideEffect()
    assertEqual(result, true)
    assertEqual(called, false)
}

@test
fn test_or_chain() {
    assertEqual(false || false || true, true)
    assertEqual(false || false || false, false)
}

// ===== NOT (!) =====

@test
fn test_not_basic() {
    assertEqual(!true, false)
    assertEqual(!false, true)
}

@test
fn test_not_double() {
    assertEqual(!!true, true)
    assertEqual(!!false, false)
}

@test
fn test_not_expression() {
    assertEqual(!(5 > 3), false)
    assertEqual(!(5 < 3), true)
}

@test
fn test_not_explicit() {
    // ! requires an explicit bool operand (no truthy/falsy)
    assertEqual(!(0 != 0), true)         // 0 == 0
    assertEqual(!(1 != 0), false)        // 1 != 0
    assertEqual(!(len("") == 0), false)  // empty string
    assertEqual(!(len("hi") == 0), true) // non-empty
    var n: i64? = null
    assertEqual(!(n != null), true)      // null presence
}

// ===== 组合 =====

@test
fn test_and_or_combined() {
    assertEqual(true && true || false, true)
    assertEqual(false || true && true, true)
    assertEqual((true || false) && true, true)
}

@test
fn test_not_and() {
    assertEqual(!(true && false), true)
    assertEqual(!true && false, false)
}

@test
fn test_not_or() {
    assertEqual(!(true || false), false)
    assertEqual(!true || false, false)
    assertEqual(!false || true, true)
}

// ===== 优先级 =====

@test
fn test_precedence_not_highest() {
    // ! 优先级最高
    assertEqual(!true && true, false)
    assertEqual(!false && true, true)
}

@test
fn test_precedence_and_before_or() {
    // && 优先级高于 ||
    assertEqual(true || false && false, true)   // true || (false && false)
    assertEqual(false || true && true, true)    // false || (true && true)
}

// ===== 边界条件 =====

@test
fn test_with_nullable_presence() {
    // Logical operators require bool operands; use explicit presence checks
    var a: string? = null
    var b: string? = "value"
    assertEqual((a != null) || (b != null), true)
    assertEqual((b != null) || (a != null), true)
    assertEqual((a != null) && (b != null), false)
}

@test
fn test_complex_condition() {
    var x = 5
    var y = 10
    assertEqual(x > 0 && y > 0 && x < y, true)
    assertEqual(x < 0 || y < 0 || x > y, false)
}
