// Test: struct basic functionality
// Expected: struct declaration, instantiation, field access, methods

// === Basic struct with fields ===

struct Point {
    x: f64
    y: f64
}
struct Vec2 {
    x: f64
    y: f64

    magnitude_sq() -> f64 {
        return this.x * this.x + this.y * this.y
    }

    add(other: Vec2) -> Vec2 {
        var result = Vec2()
        result.x = this.x + other.x
        result.y = this.y + other.y
        return result
    }
}
struct Color {
    r: i64
    g: i64
    b: i64
    a: i64
}
struct Rect {
    x: f64
    y: f64
    width: f64
    height: f64

    area() -> f64 {
        return this.width * this.height
    }
}
struct MathHelper {
    static pi() -> f64 {
        return 3.14159
    }
}

@test
fn test_struct_basic() {

    var p = Point()
    p.x = 3.0
    p.y = 4.0
    assert(p.x == 3.0)
    assert(p.y == 4.0)

    // === Struct with method ===

    var a = Vec2()
    a.x = 3.0
    a.y = 4.0
    assert(a.magnitude_sq() == 25.0)

    var b = Vec2()
    b.x = 1.0
    b.y = 2.0

    var c = a.add(b)
    assert(c.x == 4.0)
    assert(c.y == 6.0)

    // === Struct with int fields ===

    var red = Color()
    red.r = 255
    red.g = 0
    red.b = 0
    red.a = 255
    assert(red.r == 255)
    assert(red.g == 0)
    assert(red.a == 255)

    // === Struct with mixed field types ===

    var r = Rect()
    r.x = 10.0
    r.y = 20.0
    r.width = 100.0
    r.height = 50.0
    assert(r.area() == 5000.0)

    // === Struct with static method ===

    assert(MathHelper.pi() > 3.14)
    assert(MathHelper.pi() < 3.15)

    // === Struct typeof ===
    var p2 = Point()
    assert(typeName(p2) == "Point")

    // === Multiple struct instances ===
    var points: Array<Point> = []
    for (var i = 0; i < 5; i++) {
        var pt = Point()
        pt.x = (i as f64)
        pt.y = (i * 2 as f64)
        points.push(pt)
    }
    assert(len(points) == 5)
    assert(points[0].x == 0.0)
    assert(points[4].x == 4.0)
    assert(points[4].y == 8.0)
}

