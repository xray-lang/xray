// 测试：类继承
// 父类构造函数调用使用 Java 风格：super(args)

// ===== 基础继承 =====

class Animal {
    name: string

    constructor(name) {
        this.name = name
    }

    speak() -> string {        return this.name + " makes a sound"
    }
}

class Dog extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {        return this.name + " barks"
    }
}

@test
fn test_basic_inheritance() {
    var dog = Dog("Buddy")
    assertEqual(dog.name, "Buddy")
    assertEqual(dog.speak(), "Buddy barks")
}

// ===== 方法重写 =====

class Cat extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {        return this.name + " meows"
    }
}

@test
fn test_method_override() {
    var cat = Cat("Whiskers")
    assertEqual(cat.speak(), "Whiskers meows")
}

// ===== 继承链 =====

class Vehicle {
    brand: string

    constructor(brand) {
        this.brand = brand
    }

    info() -> string {        return this.brand
    }

    drive() -> string {        return "test"
    }



}

class Car extends Vehicle {
    model: string

    constructor(brand, model) {
        super(brand)
        this.model = model
    }

    info() -> string {        return this.brand + " " + this.model
    }
}

@test
fn test_multi_field_inheritance() {
    var car = Car("Toyota", "Camry")

    assertEqual(car.brand, "Toyota")
    assertEqual(car.model, "Camry")
    assertEqual(car.info(), "Toyota Camry")
}

// ===== 多态 =====

@test
fn test_polymorphism() {
    var animal = Animal("Generic")
    var dog = Dog("Rex")

    assertEqual(animal.speak(), "Generic makes a sound")
    assertEqual(dog.speak(), "Rex barks")
}

// ===== 继承字段访问 =====

class Base {
    value: i64

    constructor(v) {
        this.value = v
    }

    getValue() -> i64 {        return this.value
    }
}

class Derived extends Base {
    extra: i64

    constructor(v, e) {
        super(v)
        this.extra = e
    }

    getSum() -> i64 {        return this.value + this.extra
    }
}

@test
fn test_inherited_field_access() {
    var d = Derived(10, 5)
    assertEqual(d.value, 10)
    assertEqual(d.extra, 5)
    assertEqual(d.getValue(), 10)
    assertEqual(d.getSum(), 15)
}

// ===== super() 多参数 =====

class Person {
    name: string
    age: i64

    constructor(name: string, age: i64) {
        this.name = name
        this.age = age
    }

    info() -> string {        return "${this.name}, ${this.age}"
    }
}

class Student extends Person {
    grade: i64

    constructor(name: string, age: i64, grade: i64) {
        super(name, age)
        this.grade = grade
    }

    info() -> string {        // super.method() 未实现，使用组合方式
        return "${this.name}, ${this.age}, grade ${this.grade}"
    }
}

@test
fn test_base_multi_params() {
    var s = Student("Alice", 18, 12)
    assertEqual(s.name, "Alice")
    assertEqual(s.age, 18)
    assertEqual(s.grade, 12)
}

@test
fn test_method_override_with_parent_fields() {
    var s = Student("Bob", 17, 11)
    var info = s.info()
    assertEqual(info.contains("Bob"), true)
    assertEqual(info.contains("grade"), true)
}

// ===== super.method() 调用父类方法 =====

class Bird extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {        return "Bird: " + this.name + " chirps"
    }

    parentSpeak() -> string {        return super.speak()
    }
}

@test
fn test_super_method_call() {
    var bird = Bird("Tweety")
    assertEqual(bird.speak(), "Bird: Tweety chirps")
    assertEqual(bird.parentSpeak(), "Tweety makes a sound")
}

