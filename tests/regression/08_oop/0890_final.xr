// 0890_final.xr
// Test: final keyword for classes only

// ===== Final class basic usage =====

final class Config {
    name: string
    value: i64

    constructor(name, value) {
        this.name = name
        this.value = value
    }

    getName() -> string {
        return this.name
    }
}

@test
fn test_final_class_basic() {
    var cfg = Config("host", 8080)
    assertEqual(cfg.name, "host")
    assertEqual(cfg.value, 8080)
    assertEqual(cfg.getName(), "host")
}

// ===== Inherited method and automatic override =====

class Base {
    greet() -> string {
        return "hello from Base"
    }

    normal() -> string {
        return "normal from Base"
    }
}

class Child extends Base {
    // Can override non-final method
    normal() -> string {
        return "normal from Child"
    }
}

@test
fn test_final_method_normal_override() {
    var b = Base()
    assertEqual(b.greet(), "hello from Base")
    assertEqual(b.normal(), "normal from Base")

    var c = Child()
    assertEqual(c.greet(), "hello from Base")
    assertEqual(c.normal(), "normal from Child")
}

// ===== Final class with inheritance chain =====

class Animal {
    name: string

    constructor(name) {
        this.name = name
    }

    speak() -> string {
        return this.name + " makes a sound"
    }
}

final class Cat extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {
        return this.name + " meows"
    }
}

@test
fn test_final_class_with_parent() {
    var cat = Cat("Kitty")
    assertEqual(cat.speak(), "Kitty meows")
    assertEqual(cat.name, "Kitty")
}

// ===== Static method =====

class MathUtil {
    static pi() -> f64 {
        return 3.14159
    }

    static compute(x: f64) -> f64 {
        return x * 2.0
    }
}

@test
fn test_final_static_method() {
    assertEqual(MathUtil.pi(), 3.14159)
    assertEqual(MathUtil.compute(5.0), 10.0)
}

// ===== Const field =====

class Settings {
    const maxRetries: i64 = 3
    timeout: i64 = 1000

    constructor() {
    }
}

@test
fn test_final_field() {
    var s = Settings()
    assertEqual(s.maxRetries, 3)
    assertEqual(s.timeout, 1000)
}

// ===== Multiple modifiers combined =====

class Service {
    private const secret: string = "key123"
    
    getSecret() -> string {
        return this.secret
    }

    normal() -> string {
        return "service"
    }
}

@test
fn test_combined_modifiers() {
    var svc = Service()
    assertEqual(svc.getSecret(), "key123")
    assertEqual(svc.normal(), "service")
}
