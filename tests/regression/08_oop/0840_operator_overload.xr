// 测试：运算符重载

// ===== 加法运算符 =====

class Vector2 {
    x: f64
    y: f64
    
    constructor(x, y) {
        this.x = x
        this.y = y
    }
    
    operator+(other: Vector2) -> Vector2 {
        return Vector2(this.x + other.x, this.y + other.y)
    }
    
    operator-(other: Vector2) -> Vector2 {
        return Vector2(this.x - other.x, this.y - other.y)
    }
    
    operator*(scalar: f64) -> Vector2 {
        return Vector2(this.x * scalar, this.y * scalar)
    }
    
    operator==(other: Vector2) -> bool {
        return this.x == other.x && this.y == other.y
    }
}

@test
fn test_operator_add() {
    var a = Vector2(1, 2)
    var b = Vector2(3, 4)
    var c = a + b
    assertEqual(c.x, 4)
    assertEqual(c.y, 6)
}

@test
fn test_operator_sub() {
    var a = Vector2(5, 7)
    var b = Vector2(2, 3)
    var c = a - b
    assertEqual(c.x, 3)
    assertEqual(c.y, 4)
}

@test
fn test_operator_mul() {
    var v = Vector2(2, 3)
    // operator* declares a float scalar, so the literal is a float argument and
    // the products are floats. assertEqual does not equate 4.0 with 4.
    var scaled = v * 2
    assertEqual(scaled.x, 4.0)
    assertEqual(scaled.y, 6.0)
}

@test
fn test_operator_eq() {
    var a = Vector2(1, 2)
    var b = Vector2(1, 2)
    var c = Vector2(3, 4)
    assertEqual(a == b, true)
    assertEqual(a == c, false)
}

// ===== 下标运算符 =====

class Matrix {
    data: Array<i64>
    
    constructor() {
        this.data = [0, 0, 0, 0]
    }
    
    operator[](index: i64) -> i64 {
        return this.data[index]
    }
    
    operator[]=(index: i64, value: i64) {
        this.data[index] = value
    }
}

@test
fn test_subscript_get() {
    var m = Matrix()
    m.data[0] = 10
    m.data[1] = 20
    assertEqual(m[0], 10)
    assertEqual(m[1], 20)
}

@test
fn test_subscript_set() {
    var m = Matrix()
    m[0] = 100
    m[1] = 200
    assertEqual(m.data[0], 100)
    assertEqual(m.data[1], 200)
}

// ===== 比较运算符 =====

class Money {
    amount: i64
    
    constructor(amount) {
        this.amount = amount
    }
    
    operator<(other: Money) -> bool {
        return this.amount < other.amount
    }
    
    operator<=(other: Money) -> bool {
        return this.amount <= other.amount
    }
    
    operator>(other: Money) -> bool {
        return this.amount > other.amount
    }
    
    operator>=(other: Money) -> bool {
        return this.amount >= other.amount
    }
}

@test
fn test_comparison_operators() {
    var a = Money(100)
    var b = Money(200)
    
    assertEqual(a < b, true)
    assertEqual(a <= b, true)
    assertEqual(b > a, true)
    assertEqual(b >= a, true)
}

// ===== 链式运算 =====

@test
fn test_chained_operations() {
    var a = Vector2(1, 1)
    var b = Vector2(2, 2)
    var c = Vector2(3, 3)
    
    var result = a + b + c
    assertEqual(result.x, 6)
    assertEqual(result.y, 6)
}

