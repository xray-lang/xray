// Test: comprehensive struct scenarios
// Expected: struct creation, methods, arrays, return values

struct Point {
    x: float
    y: float
}
fn make_point(x: float, y: float) -> Point {
    return Point{x: x, y: y}
}
fn origin() -> Point {
    return Point{x: 0.0, y: 0.0}
}
struct Rect {
    x: float
    y: float
    w: float
    h: float

    area() -> float {
        return this.w * this.h
    }
}
struct Color {
    r: int
    g: int
    b: int
}

@test
fn test_struct_comprehensive() {

    // === Struct as return value ===

    var p1 = make_point(100.0, 200.0)
    assert(p1.x == 100.0)
    assert(p1.y == 200.0)

    // === Struct in array ===
    var points = [Point{x: 1.0, y: 2.0}, Point{x: 3.0, y: 4.0}]
    assert(points[0].x == 1.0)
    assert(points[1].y == 4.0)

    // === Value copy from function return ===

    var o1 = origin()
    var o2 = origin()
    o1.x = 99.0
    assert(o2.x == 0.0)

    // === Struct with method ===

    var r = Rect{x: 0.0, y: 0.0, w: 100.0, h: 50.0}
    assert(r.area() == 5000.0)

    // === Copy preserves methods ===
    var r2 = r
    r2.w = 200.0
    assert(r.area() == 5000.0)
    assert(r2.area() == 10000.0)

    // === Struct with int fields ===

    var red = Color{r: 255, g: 0, b: 0}
    var blue = Color{r: 0, g: 0, b: 255}
    var mix = red
    mix.b = blue.b
    assert(mix.r == 255)
    assert(mix.g == 0)
    assert(mix.b == 255)
    assert(red.b == 0)

    // === Chain of copies ===
    var base = Point{x: 0.0, y: 0.0}
    var a = base
    var b = a
    var c = b
    c.x = 42.0
    assert(base.x == 0.0)
    assert(a.x == 0.0)
    assert(b.x == 0.0)
    assert(c.x == 42.0)

    // === Struct literal reassignment ===
    var p = Point{x: 1.0, y: 2.0}
    p = Point{x: 10.0, y: 20.0}
    assert(p.x == 10.0)
    assert(p.y == 20.0)

    // === Typename preserved ===
    assert(typename(p1) == "Point")
    assert(typename(r) == "Rect")
    assert(typename(red) == "Color")
}

