// 测试：自定义迭代器协议（Iterable/Iterator 接口）

// ===== 基本范围迭代器 =====

class CustomRangeIter {
    current: i64
    end: i64
    
    constructor(start: i64, end: i64) {
        this.current = start
        this.end = end
    }
    
    hasNext() -> bool {
        return this.current < this.end
    }
    
    ref next() -> i64 {
        var val = this.current
        this.current = this.current + 1
        return val
    }
}

class CustomRange {
    start: i64
    end: i64
    
    constructor(start: i64, end: i64) {
        this.start = start
        this.end = end
    }
    
    iterator() -> CustomRangeIter {
        return CustomRangeIter(this.start, this.end)
    }
}

@test
fn test_basic_range_iterator() {
    var sum = 0
    for (i in CustomRange(1, 6)) {
        sum = sum + i
    }
    assertEqual(sum, 15)  // 1+2+3+4+5
}

@test
fn test_empty_range() {
    var count = 0
    for (i in CustomRange(5, 5)) {
        count = count + 1
    }
    assertEqual(count, 0)
}

@test
fn test_single_element_range() {
    var result = 0
    for (i in CustomRange(42, 43)) {
        result = i
    }
    assertEqual(result, 42)
}

// ===== 步长迭代器 =====

class StepIterator {
    current: i64
    end: i64
    step: i64
    
    constructor(start: i64, end: i64, step: i64) {
        this.current = start
        this.end = end
        this.step = step
    }
    
    hasNext() -> bool {
        if (this.step > 0) {
            return this.current < this.end
        } else {
            return this.current > this.end
        }
    }
    
    ref next() -> i64 {
        var val = this.current
        this.current = this.current + this.step
        return val
    }
}

class StepRange {
    start: i64
    end: i64
    step: i64
    
    constructor(start: i64, end: i64, step: i64) {
        this.start = start
        this.end = end
        this.step = step
    }
    
    iterator() -> StepIterator {
        return StepIterator(this.start, this.end, this.step)
    }
}

@test
fn test_step_range_forward() {
    var values: Array<i64> = []
    for (i in StepRange(0, 10, 2)) {
        values.push(i)
    }
    assertEqual(len(values), 5)
    assertEqual(values[0], 0)
    assertEqual(values[1], 2)
    assertEqual(values[2], 4)
    assertEqual(values[3], 6)
    assertEqual(values[4], 8)
}

@test
fn test_step_range_backward() {
    var values: Array<i64> = []
    for (i in StepRange(10, 0, -2)) {
        values.push(i)
    }
    assertEqual(len(values), 5)
    assertEqual(values[0], 10)
    assertEqual(values[1], 8)
    assertEqual(values[2], 6)
    assertEqual(values[3], 4)
    assertEqual(values[4], 2)
}

// ===== 斐波那契迭代器 =====

class FibIterator {
    a: i64
    b: i64
    count: i64
    max: i64
    
    constructor(max: i64) {
        this.a = 0
        this.b = 1
        this.count = 0
        this.max = max
    }
    
    hasNext() -> bool {
        return this.count < this.max
    }
    
    ref next() -> i64 {
        var val = this.a
        var tmp = this.a + this.b
        this.a = this.b
        this.b = tmp
        this.count = this.count + 1
        return val
    }
}

class Fibonacci {
    max: i64
    
    constructor(n: i64) {
        this.max = n
    }
    
    iterator() -> FibIterator {
        return FibIterator(this.max)
    }
}

@test
fn test_fibonacci_iterator() {
    var values: Array<i64> = []
    for (n in Fibonacci(8)) {
        values.push(n)
    }
    assertEqual(len(values), 8)
    assertEqual(values[0], 0)
    assertEqual(values[1], 1)
    assertEqual(values[2], 1)
    assertEqual(values[3], 2)
    assertEqual(values[4], 3)
    assertEqual(values[5], 5)
    assertEqual(values[6], 8)
    assertEqual(values[7], 13)
}

// ===== 字符串字符迭代器 =====

class CharIterator {
    str: string
    index: i64
    
    constructor(s: string) {
        this.str = s
        this.index = 0
    }
    
    hasNext() -> bool {
        return this.index < len(this.str)
    }
    
    ref next() -> string {
        var ch = this.str.runes().nth(this.index)
        this.index = this.index + 1
        return ch.toString()
    }
}

class Chars {
    str: string
    
    constructor(s: string) {
        this.str = s
    }
    
    iterator() -> CharIterator {
        return CharIterator(this.str)
    }
}

@test
fn test_char_iterator() {
    var chars: Array<string> = []
    for (ch in Chars("hello")) {
        chars.push(ch)
    }
    assertEqual(len(chars), 5)
    assertEqual(chars[0], "h")
    assertEqual(chars[1], "e")
    assertEqual(chars[2], "l")
    assertEqual(chars[3], "l")
    assertEqual(chars[4], "o")
}

// ===== 嵌套迭代 =====

@test
fn test_nested_iteration() {
    var pairs: Array<string> = []
    for (i in CustomRange(1, 4)) {
        for (j in CustomRange(1, 4)) {
            pairs.push("${i},${j}")
        }
    }
    assertEqual(len(pairs), 9)
    assertEqual(pairs[0], "1,1")
    assertEqual(pairs[4], "2,2")
    assertEqual(pairs[8], "3,3")
}

// ===== 迭代器与 break/continue =====

@test
fn test_iterator_with_break() {
    var sum = 0
    for (i in CustomRange(1, 100)) {
        if (i > 5) {
            break
        }
        sum = sum + i
    }
    assertEqual(sum, 15)  // 1+2+3+4+5
}

@test
fn test_iterator_with_continue() {
    var sum = 0
    for (i in CustomRange(1, 11)) {
        if (i % 2 == 0) {
            continue
        }
        sum = sum + i
    }
    assertEqual(sum, 25)  // 1+3+5+7+9
}

// ===== 迭代器变量作为表达式 =====

@test
fn test_iterator_inline() {
    var sum = 0
    for (i in CustomRange(1, 6)) {
        sum = sum + i * i
    }
    assertEqual(sum, 55)  // 1+4+9+16+25
}

// ===== 迭代器与变量存储 =====

@test
fn test_iterator_stored_in_variable() {
    var r = CustomRange(1, 4)
    var sum = 0
    for (i in r) {
        sum = sum + i
    }
    assertEqual(sum, 6)  // 1+2+3
}
