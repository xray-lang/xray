// 0841_operator_overload_compat.xr
// 作者：xingleixu@gmail.com
// 测试：运算符重载回归覆盖
//
// **Feature: operator-overload-optimization, Property 5: 有运算符重载**
// **Validates: Requirements 5.1, 5.3**
//
// **Feature: operator-overload-optimization, Property 6: 无运算符重载**
// **Validates: Requirements 5.2**
//
// 验证：
// 1. 有运算符重载的类执行算术运算产生正确结果
// 2. 无运算符重载的类执行算术运算产生正确结果
// 3. 继承运算符重载的类正确工作
// 4. 继承到的运算符方法正确工作；子类同名隐藏由 compile-error 测试覆盖

// ===== Property 5: 有运算符重载的类 =====

// 测试类：Vector2D - 有加减乘除运算符重载
class Vector2D {
    x: f64
    y: f64
    
    constructor(x, y) {
        this.x = x
        this.y = y
    }
    
    operator+(other: Vector2D) -> Vector2D {
        return Vector2D(this.x + other.x, this.y + other.y)
    }
    
    operator-(other: Vector2D) -> Vector2D {
        return Vector2D(this.x - other.x, this.y - other.y)
    }
    
    operator*(scalar: f64) -> Vector2D {
        return Vector2D(this.x * scalar, this.y * scalar)
    }
    
    operator/(scalar: f64) -> Vector2D {
        return Vector2D(this.x / scalar, this.y / scalar)
    }
    
    operator==(other: Vector2D) -> bool {
        return this.x == other.x && this.y == other.y
    }
}

@test
fn test_property5_add_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Vector2D(1.0, 2.0)
    var b = Vector2D(3.0, 4.0)
    var c = a + b
    assertEqual(c.x, 4.0)
    assertEqual(c.y, 6.0)
}

@test
fn test_property5_sub_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Vector2D(5.0, 7.0)
    var b = Vector2D(2.0, 3.0)
    var c = a - b
    assertEqual(c.x, 3.0)
    assertEqual(c.y, 4.0)
}

@test
fn test_property5_mul_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var v = Vector2D(2.0, 3.0)
    var scaled = v * 2.0
    assertEqual(scaled.x, 4.0)
    assertEqual(scaled.y, 6.0)
}

@test
fn test_property5_div_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var v = Vector2D(10.0, 20.0)
    var halved = v / 2.0
    assertEqual(halved.x, 5.0)
    assertEqual(halved.y, 10.0)
}

@test
fn test_property5_eq_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Vector2D(1.0, 2.0)
    var b = Vector2D(1.0, 2.0)
    var c = Vector2D(3.0, 4.0)
    assertEqual(a == b, true)
    assertEqual(a == c, false)
}

@test
fn test_property5_chained_operations() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Vector2D(1.0, 1.0)
    var b = Vector2D(2.0, 2.0)
    var c = Vector2D(3.0, 3.0)
    var result = a + b + c
    assertEqual(result.x, 6.0)
    assertEqual(result.y, 6.0)
}

// ===== 测试类：Money - 有比较运算符重载 =====

class Money {
    amount: i64
    
    constructor(amount) {
        this.amount = amount
    }
    
    operator<(other: Money) -> bool {
        return this.amount < other.amount
    }
    
    operator<=(other: Money) -> bool {
        return this.amount <= other.amount
    }
    
    operator>(other: Money) -> bool {
        return this.amount > other.amount
    }
    
    operator>=(other: Money) -> bool {
        return this.amount >= other.amount
    }
}

@test
fn test_property5_comparison_operators() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Money(100)
    var b = Money(200)
    var c = Money(100)
    
    assertEqual(a < b, true)
    assertEqual(a <= b, true)
    assertEqual(b > a, true)
    assertEqual(b >= a, true)
    assertEqual(a <= c, true)
    assertEqual(a >= c, true)
}

// ===== 测试类：BitSet - 有位运算符重载 =====

class BitSet {
    value: i64
    
    constructor(v) {
        this.value = v
    }
    
    operator &(other: BitSet) -> BitSet {
        return BitSet(this.value & other.value)
    }
    
    operator |(other: BitSet) -> BitSet {
        return BitSet(this.value | other.value)
    }
    
    operator ^(other: BitSet) -> BitSet {
        return BitSet(this.value ^ other.value)
    }
}

@test
fn test_property5_bitwise_and() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var bs1 = BitSet(12)  // 0b1100
    var bs2 = BitSet(10)  // 0b1010
    var result = bs1 & bs2
    assertEqual(result.value, 8)  // 0b1000
}

@test
fn test_property5_bitwise_or() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var bs1 = BitSet(12)  // 0b1100
    var bs2 = BitSet(10)  // 0b1010
    var result = bs1 | bs2
    assertEqual(result.value, 14)  // 0b1110
}

@test
fn test_property5_bitwise_xor() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var bs1 = BitSet(12)  // 0b1100
    var bs2 = BitSet(10)  // 0b1010
    var result = bs1 ^ bs2
    assertEqual(result.value, 6)  // 0b0110
}

// ===== 测试类：Matrix - 有下标运算符重载 =====

class Matrix {
    data: Array<i64>
    
    constructor() {
        this.data = [0, 0, 0, 0]
    }
    
    operator[](index: i64) -> i64 {
        return this.data[index]
    }
    
    ref operator[]=(index: i64, value: i64) {
        this.data[index] = value
    }
}

@test
fn test_property5_subscript_get() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var m = Matrix()
    m.data[0] = 10
    m.data[1] = 20
    assertEqual(m[0], 10)
    assertEqual(m[1], 20)
}

@test
fn test_property5_subscript_set() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var m = Matrix()
    m[0] = 100
    m[1] = 200
    assertEqual(m.data[0], 100)
    assertEqual(m.data[1], 200)
}

// ===== 测试继承运算符重载 =====

class Vector3D extends Vector2D {
    z: f64
    
    constructor(x, y, z) {
        super(x, y)
        this.z = z
    }
    
    // 不重新声明 operator+：Xray 禁止子类隐藏/重载继承方法。
}

@test
fn test_property5_inherited_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = Vector3D(1.0, 2.0, 3.0)
    var b = Vector3D(4.0, 5.0, 6.0)
    var c = a + b
    assertEqual(c.x, 5.0)
    assertEqual(c.y, 7.0)
}

// ===== Property 6: 无运算符重载的类 =====

// 测试类：Point - 没有运算符重载
class Point {
    x: i64
    y: i64
    
    constructor(x, y) {
        this.x = x
        this.y = y
    }
    
    add(other: Point) -> Point {
        return Point(this.x + other.x, this.y + other.y)
    }
}

@test
fn test_property6_no_operator_overload() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    var p1 = Point(1, 2)
    var p2 = Point(3, 4)
    
    // 使用普通方法而不是运算符
    var p3 = p1.add(p2)
    assertEqual(p3.x, 4)
    assertEqual(p3.y, 6)
}

@test
fn test_property6_primitive_arithmetic() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    // 验证原始类型的算术运算不受影响
    var a = 10
    var b = 3
    
    assertEqual(a + b, 13)
    assertEqual(a - b, 7)
    assertEqual(a * b, 30)
    assertEqual(a / b, 3)
    assertEqual(a % b, 1)
}

@test
fn test_property6_primitive_comparison() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    // 验证原始类型的比较运算不受影响
    var a = 10
    var b = 20
    
    assertEqual(a < b, true)
    assertEqual(a <= b, true)
    assertEqual(b > a, true)
    assertEqual(b >= a, true)
    assertEqual(a == a, true)
    assertEqual(a != b, true)
}

@test
fn test_property6_primitive_bitwise() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    // 验证原始类型的位运算不受影响
    var a = 12  // 0b1100
    var b = 10  // 0b1010
    
    assertEqual(a & b, 8)   // 0b1000
    assertEqual(a | b, 14)  // 0b1110
    assertEqual(a ^ b, 6)   // 0b0110
}

@test
fn test_property6_float_arithmetic() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    // 验证浮点数算术运算不受影响
    var a = 10.5
    var b = 2.5
    
    assertEqual(a + b, 13.0)
    assertEqual(a - b, 8.0)
    assertEqual(a * b, 26.25)
    assertEqual(a / b, 4.2)
}

@test
fn test_property6_string_concat() {
    // **Feature: operator-overload-optimization, Property 6: 无运算符重载**
    // **Validates: Requirements 5.2**
    // 验证字符串拼接不受影响
    var s1 = "Hello"
    var s2 = " World"
    var s3 = s1 + s2
    assertEqual(s3, "Hello World")
}

// ===== 混合测试：有运算符重载和无运算符重载的类混合使用 =====

@test
fn test_mixed_classes() {
    // 同时使用有运算符重载和无运算符重载的类
    var v1 = Vector2D(1.0, 2.0)
    var v2 = Vector2D(3.0, 4.0)
    var p1 = Point(1, 2)
    var p2 = Point(3, 4)
    
    // Vector2D 使用运算符重载
    var v3 = v1 + v2
    assertEqual(v3.x, 4.0)
    assertEqual(v3.y, 6.0)
    
    // Point 使用普通方法
    var p3 = p1.add(p2)
    assertEqual(p3.x, 4)
    assertEqual(p3.y, 6)
    
    // 原始类型运算
    var sum = 10 + 20
    assertEqual(sum, 30)
}

// ===== 测试取模运算符重载 =====

class ModVector {
    x: i64
    y: i64
    
    constructor(x, y) {
        this.x = x
        this.y = y
    }
    
    operator%(other: ModVector) -> ModVector {
        return ModVector(this.x % other.x, this.y % other.y)
    }
}

@test
fn test_property5_mod_operator() {
    // **Feature: operator-overload-optimization, Property 5: 有运算符重载**
    // **Validates: Requirements 5.1, 5.3**
    var a = ModVector(17, 23)
    var b = ModVector(5, 7)
    var c = a % b
    assertEqual(c.x, 2)  // 17 % 5 = 2
    assertEqual(c.y, 2)  // 23 % 7 = 2
}
