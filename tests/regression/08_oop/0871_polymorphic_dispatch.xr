// 0870_polymorphic_dispatch.xr
// Tests: Polymorphic method dispatch correctness
// Verifies IC-based devirtualization produces correct results

class Animal {
    name: string

    constructor(name) {
        this.name = name
    }

    speak() -> string {
        return this.name + " says ..."
    }

    legs() -> i64 {
        return 0
    }
}

class Dog extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {
        return this.name + " says woof"
    }

    legs() -> i64 {
        return 4
    }
}

class Cat extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {
        return this.name + " says meow"
    }

    legs() -> i64 {
        return 4
    }
}

class Bird extends Animal {
    constructor(name) {
        super(name)
    }

    speak() -> string {
        return this.name + " says tweet"
    }

    legs() -> i64 {
        return 2
    }
}

// Monomorphic call site: always Dog
@test
fn test_monomorphic_dispatch() {
    var dog = Dog("Rex")
    var total = 0
    for (var i = 0; i < 10; i++) {
        total += dog.legs()
    }
    assertEqual(total, 40)
    assertEqual(dog.speak(), "Rex says woof")
}

// Polymorphic call site: Dog and Cat
@test
fn test_polymorphic_dispatch() {
    var animals = [Dog("Rex"), Cat("Whiskers"), Dog("Buddy")]
    var results: Array<string> = []
    for (var i = 0; i < len(animals); i++) {
        results.push(animals[i].speak())
    }
    assertEqual(results[0], "Rex says woof")
    assertEqual(results[1], "Whiskers says meow")
    assertEqual(results[2], "Buddy says woof")
}

// Megamorphic: Dog, Cat, Bird
@test
fn test_megamorphic_dispatch() {
    var animals = [Dog("D"), Cat("C"), Bird("B")]
    var total_legs = 0
    for (var i = 0; i < len(animals); i++) {
        total_legs += animals[i].legs()
    }
    assertEqual(total_legs, 10)  // 4 + 4 + 2
}

// Method with side effects through virtual dispatch
@test
fn test_virtual_dispatch_with_state() {
    var dog = Dog("Max")
    var results: Array<string> = []
    for (var i = 0; i < 5; i++) {
        results.push(dog.speak())
    }
    assertEqual(len(results), 5)
    for (var i = 0; i < 5; i++) {
        assertEqual(results[i], "Max says woof")
    }
}

// Mixed dispatch: base class and derived
@test
fn test_base_and_derived() {
    var base = Animal("Generic")
    var derived = Dog("Specific")
    assertEqual(base.speak(), "Generic says ...")
    assertEqual(derived.speak(), "Specific says woof")
    assertEqual(base.legs(), 0)
    assertEqual(derived.legs(), 4)
}
