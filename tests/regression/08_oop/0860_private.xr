// ===== 私有字段 =====

class Account {
    private balance: i64

    constructor(initial: i64) {
        this.balance = initial
    }

    deposit(amount: i64) {        this.balance = this.balance + amount
    }

    withdraw(amount: i64) -> bool {        if (amount <= this.balance) {
            this.balance = this.balance - amount
            return true
        }
        return false
    }

    getBalance() -> i64 {        return this.balance
    }
}

@test
fn test_private_field_access() {
    var acc = Account(100)
    assertEqual(acc.getBalance(), 100)
}

@test
fn test_private_field_modify() {
    var acc = Account(100)
    acc.deposit(50)
    assertEqual(acc.getBalance(), 150)
}

@test
fn test_private_field_withdraw() {
    var acc = Account(100)
    var success = acc.withdraw(30)
    assertEqual(success, true)
    assertEqual(acc.getBalance(), 70)
}

// ===== 多私有字段 =====

class User {
    private password: string
    private email: string
    name: string

    constructor(name: string, email: string, password: string) {
        this.name = name
        this.email = email
        this.password = password
    }

    checkPassword(pwd: string) -> bool {        return this.password == pwd
    }

    getEmail() -> string {        return this.email
    }
}

@test
fn test_multiple_private_fields() {
    var user = User("Alice", "alice@test.com", "secret123")
    assertEqual(user.name, "Alice")
    assertEqual(user.checkPassword("secret123"), true)
    assertEqual(user.checkPassword("wrong"), false)
}

// ===== 私有字段与继承 =====

class BankAccount {
    private balance: i64

    constructor(initial: i64) {
        this.balance = initial
    }

    getBalance() -> i64 {        return this.balance
    }

    addAmount(amount: i64) {        this.balance = this.balance + amount
    }
}

class SavingsAccount extends BankAccount {
    interestRate: f64

    constructor(initial: i64, rate: f64) {
        super(initial)
        this.interestRate = rate
    }

    applyInterest() {        var interest = ((this.getBalance() as f64) * this.interestRate).floor()
        this.addAmount(interest)
    }
}

@test
fn test_private_with_inheritance() {
    var savings = SavingsAccount(1000, 0.1)
    assertEqual(savings.getBalance(), 1000)
    savings.applyInterest()
    assertEqual(savings.getBalance(), 1100)
}
