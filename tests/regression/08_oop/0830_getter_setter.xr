// 测试：getter 和 setter
// 新语法：使用 fn() 定义属性访问器

// ===== 基本 getter =====

class Circle {
    _radius: f64
    
    constructor(r) {
        this._radius = r
    }
    
    radius: f64 {
        fn() { return this._radius }
    }
    
    diameter: f64 {
        fn() { return this._radius * 2 }
    }
    
    area: f64 {
        fn() { return 3.14159 * this._radius * this._radius }
    }
}

@test
fn test_basic_getter() {
    var c = Circle(5.0)
    assert_eq(c.radius, 5.0)
    assert_eq(c.diameter, 10.0)
}

@test
fn test_computed_getter() {
    var c = Circle(2.0)
    var area = c.area
    assert_eq(area > 12, true)
    assert_eq(area < 13, true)
}

// ===== 基本 setter =====

class Temperature {
    _celsius: f64
    
    constructor(c) {
        this._celsius = c
    }
    
    celsius: f64 {
        fn() { return this._celsius }
        fn(value: f64) { this._celsius = value }
    }
    
    fahrenheit: f64 {
        fn() { return this._celsius * 1.8 + 32 }
        fn(value: f64) { this._celsius = (value - 32) / 1.8 }
    }
}

@test
fn test_basic_setter() {
    var t = Temperature(0.0)
    assert_eq(t.celsius, 0.0)
    
    t.celsius = 100.0
    assert_eq(t.celsius, 100.0)
}

@test
fn test_computed_setter() {
    var t = Temperature(0.0)
    t.fahrenheit = 212.0
    assert_eq(t.celsius, 100.0)
}

// ===== 验证 setter =====

class Age {
    _value: i64
    
    constructor() {
        this._value = 0
    }
    
    value: i64 {
        fn() { return this._value }
        fn(v: i64) {
            if (v >= 0) {
                this._value = v
            }
        }
    }
}

@test
fn test_validating_setter() {
    var age = Age()
    age.value = 25
    assert_eq(age.value, 25)
    
    age.value = -5  // 应该被忽略
    assert_eq(age.value, 25)
}

// ===== 只读属性 =====

class ReadOnly {
    _secret: string
    
    constructor(s) {
        this._secret = s
    }
    
    secret: string {
        fn() { return this._secret }
    }
}

@test
fn test_readonly_property() {
    var r = ReadOnly("password")
    assert_eq(r.secret, "password")
}

// ===== getter 链式访问 =====

class Box {
    _width: i64
    _height: i64
    
    constructor(w, h) {
        this._width = w
        this._height = h
    }
    
    width: i64 { fn() { return this._width } }
    height: i64 { fn() { return this._height } }
    area: i64 { fn() { return this._width * this._height } }
    perimeter: i64 { fn() { return 2 * (this._width + this._height) } }
}

@test
fn test_multiple_getters() {
    var box = Box(3, 4)
    assert_eq(box.width, 3)
    assert_eq(box.height, 4)
    assert_eq(box.area, 12)
    assert_eq(box.perimeter, 14)
}

