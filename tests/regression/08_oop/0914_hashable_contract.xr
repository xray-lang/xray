// Test: Hashable requires operator== and hash as a static key contract.

class Token implements Hashable {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    operator==(other: Token) -> bool {
        return this.value == other.value
    }

    hash() -> i64 {
        return this.value
    }
}

struct Cell implements Hashable {
    value: i64

    operator==(other: Cell) -> bool {
        return this.value == other.value
    }

    hash() -> i64 {
        return this.value
    }
}

fn passHashable<T: Hashable>(value: T) -> T {
    return value
}

@test
fn test_class_hashable_map_set_key() {
    var token = Token(7)
    var values: Map<Token, i64> = #{}
    values.set(token, 99)
    assert(values.containsKey(token))
    assertEqual(values.get(token), 99)

    var seen: Set<Token> = #[]
    seen.add(token)
    assert(seen.contains(token))
}

@test
fn test_user_hashable_generic_constraint() {
    var token = Token(3)
    assertEqual(passHashable(token).value, 3)

    var cell = Cell{value: 5}
    assertEqual(passHashable(cell).value, 5)
}
