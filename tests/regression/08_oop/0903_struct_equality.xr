// Test: struct equality comparison
// Expected: == on structs without operator== uses deep comparison

struct Point {
    x: float
    y: float
}
struct Vec2 {
    x: float
    y: float

    operator ==(other: Vec2) -> bool {
        return this.x == other.x && this.y == other.y
    }
}

@test
fn test_struct_equality() {

    // === Deep equality (no operator== defined) ===
    var a = Point{x: 1.0, y: 2.0}
    var b = Point{x: 1.0, y: 2.0}
    var c = Point{x: 3.0, y: 4.0}

    assert(a == b)
    assert(!(a == c))

    // === Copy is equal ===
    var d = a
    assert(a == d)

    // === After modification, no longer equal ===
    d.x = 99.0
    assert(!(a == d))

    // === Struct with operator== ===

    var v1 = Vec2{x: 1.0, y: 2.0}
    var v2 = Vec2{x: 1.0, y: 2.0}
    var v3 = Vec2{x: 5.0, y: 6.0}

    assert(v1 == v2)
    assert(!(v1 == v3))
}
