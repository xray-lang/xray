// 0851_interface_generic_property.xr
// 作者：xingleixu@gmail.com
// 测试：接口的泛型类型参数、属性签名、以及 implements/extends
//      子句对参数化接口的承载（语法层面）。
//
// 说明：当前阶段约束匹配仍按裸名进行，所以 `Iterable<int>` 与
// `Iterable<string>` 在类型层面是等价的；type-arg-aware 校验是后续
// commit 的工作。

// ===== 单类型参数泛型接口 =====

interface Container<T> {
    get(index: i64) -> T
    size() -> i64
}

class IntBox implements Container<i64> {
    value: i64

    constructor(v: i64) {
        this.value = v
    }

    get(index: i64) -> i64 {
        return this.value
    }

    size() -> i64 {
        return 1
    }
}

@test
fn test_implements_with_type_args() {
    var b = IntBox(42)
    assertEqual(b.get(0), 42)
    assertEqual(b.size(), 1)
}

// ===== 多类型参数泛型接口 + 带类型实参的 extends =====

interface Pair<K, V> {
    key() -> K
    value() -> V
}

interface KVDescriptor<K, V> extends Pair<K, V> {
    describe() -> string
}

class StringIntEntry implements KVDescriptor<string, i64> {
    k: string
    v: i64

    constructor(k: string, v: i64) {
        this.k = k
        this.v = v
    }

    key() -> string {
        return this.k
    }

    value() -> i64 {
        return this.v
    }

    describe() -> string {
        return this.k
    }
}

@test
fn test_extends_with_type_args() {
    var e = StringIntEntry("age", 30)
    assertEqual(e.key(), "age")
    assertEqual(e.value(), 30)
    assertEqual(e.describe(), "age")
}

// ===== 接口属性签名 =====

interface HasLength {
    length: i64
}

class PropertyBuffer implements HasLength {
    size: i64

    constructor(s: i64) {
        this.size = s
    }

    length: i64 {
        fn() { return this.size }
    }
}

@test
fn test_interface_property() {
    var b = PropertyBuffer(10)
    assertEqual(b.length, 10)
}

// ===== 接口属性 + const 修饰 =====

interface Identifiable {
    const id: i64
    name: string
}

class Item implements Identifiable {
    item_id: i64
    item_name: string

    constructor(id: i64, name: string) {
        this.item_id = id
        this.item_name = name
    }

    id: i64 {
        fn() { return this.item_id }
    }

    name: string {
        fn() { return this.item_name }
    }
}

@test
fn test_interface_const_property() {
    var it = Item(7, "widget")
    assertEqual(it.id, 7)
    assertEqual(it.name, "widget")
}

// ===== 泛型接口 + 属性混合 =====

interface SizedCollection<T> {
    length: i64
    first() -> T
}

@test
fn test_generic_interface_with_property_declares() {
    assertEqual(1, 1)
}

// ===== 受约束的泛型类型参数 =====

interface Numeric {
    toF64() -> f64
}

interface Stats<T: Numeric> {
    mean() -> f64
    sum() -> T
}

@test
fn test_constrained_generic_interface() {
    assertEqual(1, 1)
}
