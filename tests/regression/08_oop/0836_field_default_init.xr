/*
 * 0836_field_default_init.xr - test class field default initialization
 */

class Simple {
    a = 0
    b = 3.14
    c = "hello"
    d = true

    constructor() {
        // 字段已自动初始化
    }
}
class Complex {
    _map: Map<string, i64> = #{}
    _arr: Array<i64> = []
    _config: Map<string, i64> = #{"debug": 0, "port": 8080}

    constructor() {
        // 字段已自动初始化
    }

    ref addItem(key: string, value: i64) {
        this._map[key] = value
        this._arr.push(value)
    }

    getMapSize() -> i64 {
        return len(this._map.keys())
    }

    getArrSize() -> i64 {
        return len(this._arr)
    }

    getPort() -> i64 {
        return this._config["port"]
    }
}
class Override {
    _name = "default"
    _count = 0

    constructor(name, count) {
        this._name = name
        this._count = count
    }

    getName() -> string {
        return this._name
    }

    getCount() -> i64 {
        return this._count
    }
}
class Counter {
    _items: Array<string> = []

    constructor() {}

    ref add(item: string) {
        this._items.push(item)
    }

    count() -> i64 {
        return len(this._items)
    }
}

class NoCtorDefaults {
    nums: Array<i64> = [1, 2]
    settings: Map<string, i64> = #{"port": 8080}
}

@test
fn test_field_default_init() {

    /* 测试1：简单字面量默认值 */

    var s = Simple()

    print("Simple.a = ${s.a}")       // expect: 0
    print("Simple.b = ${s.b}")       // expect: 3.14
    print("Simple.c = ${s.c}")       // expect: hello
    print("Simple.d = ${s.d}")       // expect: true

    /* 测试2：复合类型默认值 */

    var c = Complex()


    print("初始 map size: ${c.getMapSize()}")  // expect: 0
    print("初始 arr size: ${c.getArrSize()}")  // expect: 0
    print("config port: ${c.getPort()}")       // expect: 8080

    c.addItem("a", 1)
    c.addItem("b", 2)
    print("添加后 map size: ${c.getMapSize()}")  // expect: 2
    print("添加后 arr size: ${c.getArrSize()}")  // expect: 2

    /* 测试3：构造函数参数覆盖默认值 */

    var o2 = Override("custom", 42)

    print("Override 覆盖 name: ${o2.getName()}")   // expect: custom
    print("Override 覆盖 count: ${o2.getCount()}") // expect: 42

    /* 测试4：多实例独立性 */

    var c1 = Counter()
    var c2 = Counter()

    c1.add("a")
    c1.add("b")
    c2.add("x")

    print("c1 count: ${c1.count()}")  // expect: 2
    print("c2 count: ${c2.count()}")  // expect: 1
}

@test
fn test_field_default_init_without_constructor() {
    var a = NoCtorDefaults()
    var b = NoCtorDefaults()

    assertEqual(len(a.nums), 2)
    assertEqual(a.settings["port"], 8080)

    a.nums.push(3)
    a.settings["port"] = 9090

    assertEqual(len(a.nums), 3)
    assertEqual(a.settings["port"], 9090)
    assertEqual(len(b.nums), 2)
    assertEqual(b.settings["port"], 8080)
}
