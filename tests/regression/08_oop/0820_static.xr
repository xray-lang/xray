// 测试：静态成员

// ===== 静态字段 =====

class Counter {
    static count: i64 = 0
    
    static increment() {
        Counter.count = Counter.count + 1
    }
    
    static getCount() -> i64 {
        return Counter.count
    }
}

@test
fn test_static_field() {
    assert_eq(Counter.count, 0)
    Counter.count = 5
    assert_eq(Counter.count, 5)
}

@test
fn test_static_method() {
    Counter.count = 0
    Counter.increment()
    assert_eq(Counter.getCount(), 1)
    Counter.increment()
    assert_eq(Counter.getCount(), 2)
}

// ===== 静态常量 =====

class MathConstants {
    static PI: f64 = 3.14159
    static E: f64 = 2.71828
}

@test
fn test_static_constants() {
    assert_eq(MathConstants.PI > 3.14, true)
    assert_eq(MathConstants.E > 2.71, true)
}

// ===== 工厂模式 =====

class Point {
    x: i64
    y: i64
    
    constructor(x, y) {
        this.x = x
        this.y = y
    }
    
    static origin() -> Point {
        return Point(0, 0)
    }
    
    static fromPolar(r: f64, theta: f64) -> Point {
        // 简化：只返回近似值
        return Point(r, 0)
    }
}

@test
fn test_factory_method() {
    var p = Point.origin()
    assert_eq(p.x, 0)
    assert_eq(p.y, 0)
}

// ===== 混合静态和实例 =====

class Item {
    static nextId: i64 = 1
    id: i64
    name: string
    
    constructor(name) {
        this.id = Item.nextId
        Item.nextId = Item.nextId + 1
        this.name = name
    }
    
    static resetId() {
        Item.nextId = 1
    }
}

@test
fn test_mixed_static_instance() {
    Item.resetId()
    var a = Item("Apple")
    var b = Item("Banana")
    
    assert_eq(a.id, 1)
    assert_eq(b.id, 2)
    assert_eq(Item.nextId, 3)
}

// ===== 静态方法调用静态方法 =====

class Calculator {
    static add(a: i64, b: i64) -> i64 {
        return a + b
    }
    
    static addThree(a: i64, b: i64, c: i64) -> i64 {
        return Calculator.add(Calculator.add(a, b), c)
    }
}

@test
fn test_static_call_static() {
    assert_eq(Calculator.add(2, 3), 5)
    assert_eq(Calculator.addThree(1, 2, 3), 6)
}

