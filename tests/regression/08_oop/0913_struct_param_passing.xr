// Test: struct parameter passing modes (value / in / ref)

struct Vec2 {
    x: float = 0.0
    y: float = 0.0
}

struct Rect {
    origin: Vec2
    size: Vec2
}

fn move_value(v: Vec2) -> Vec2 {
    var result = copy(v)
    result.x = result.x + 10.0
    result.y = result.y + 20.0
    return result
}
fn length_sq(v: Vec2) -> float {
    return v.x * v.x + v.y * v.y
}
fn translate(v: ref Vec2, dx: float, dy: float) {
    v.x = v.x + dx
    v.y = v.y + dy
}
fn add_to(target: ref Vec2, src: Vec2) {
    target.x = target.x + src.x
    target.y = target.y + src.y
}
fn scale(v: ref Vec2, factor: float) {
    v.x = v.x * factor
    v.y = v.y * factor
}
fn dot(a: Vec2, b: Vec2) -> float {
    return a.x * b.x + a.y * b.y
}
fn normalize(v: ref Vec2) {
    var lengthValue = length_sq(v)
    if (lengthValue > 0.0) {
        var inv = 1.0 / lengthValue
        v.x = v.x * inv
        v.y = v.y * inv
    }
}

@test
fn test_basic_modes() {

    // === Value passing (default): callee gets a copy ===

    var a = Vec2{x: 1.0, y: 2.0}
    var b = move_value(a)
    assert(a.x == 1.0)
    assert(a.y == 2.0)
    assert(b.x == 11.0)
    assert(b.y == 22.0)

// === default READ passing: readonly reference, no copy ===

    var c = Vec2{x: 3.0, y: 4.0}
    assert(length_sq(c) == 25.0)
    assert(c.x == 3.0)
    assert(c.y == 4.0)

    // === ref passing: mutable reference, caller sees changes ===

    var d = Vec2{x: 1.0, y: 2.0}
    translate(ref d, 5.0, 10.0)
    assert(d.x == 6.0)
    assert(d.y == 12.0)

    // === Mixed: ref + in in same function ===

    var e = Vec2{x: 10.0, y: 20.0}
    var f = Vec2{x: 3.0, y: 7.0}
    add_to(ref e, f)
    assert(e.x == 13.0)
    assert(e.y == 27.0)
    assert(f.x == 3.0)
    assert(f.y == 7.0)
}

@test
fn test_multiple_ref_calls() {
    // Same struct modified by ref multiple times
    var v = Vec2{x: 0.0, y: 0.0}
    translate(ref v, 1.0, 2.0)
    assert(v.x == 1.0)
    assert(v.y == 2.0)

    translate(ref v, 3.0, 4.0)
    assert(v.x == 4.0)
    assert(v.y == 6.0)

    scale(ref v, 2.0)
    assert(v.x == 8.0)
    assert(v.y == 12.0)
}

@test
fn test_ref_then_in() {
    // Modify via ref, then read via in
    var v = Vec2{x: 3.0, y: 4.0}
    scale(ref v, 3.0)
    assert(v.x == 9.0)
    assert(v.y == 12.0)
    assert(length_sq(v) == 225.0)  // 9*9 + 12*12
}

@test
fn test_two_in_params() {
    // Both parameters are in (no copy, no mutation)
    var a = Vec2{x: 2.0, y: 3.0}
    var b = Vec2{x: 4.0, y: 5.0}
    assert(dot(a, b) == 23.0)  // 2*4 + 3*5
    assert(a.x == 2.0)
    assert(b.x == 4.0)
}

@test
fn test_ref_reads_in() {
    // normalize reads via in (length_sq), modifies via ref
    var v = Vec2{x: 4.0, y: 0.0}
    normalize(ref v)
    assert(v.x == 0.25)  // 4 * (1/16) = 0.25
    assert(v.y == 0.0)
}

@test
fn test_value_independence() {
    // value copy is fully independent from original
    var orig = Vec2{x: 5.0, y: 10.0}
    var copy = move_value(orig)

    // modify original via ref — copy must not change
    translate(ref orig, 100.0, 200.0)
    assert(orig.x == 105.0)
    assert(copy.x == 15.0)  // 5 + 10 from move_value
    assert(copy.y == 30.0)
}

@test
fn test_ref_in_loop() {
    // ref modification inside a loop
    var v = Vec2{x: 0.0, y: 0.0}
    for (var i = 0; i < 5; i++) {
        translate(ref v, 1.0, 2.0)
    }
    assert(v.x == 5.0)
    assert(v.y == 10.0)
}
