// 测试：类型注解
// ===== 基本类型注解 =====
@test
fn test_int_annotation() {
    var x: int = 42
    assert_eq(x, 42)
    assert_eq(typename(x), "int")
}

@test
fn test_float_annotation() {
    var x: float = 3.14
    assert_eq(x > 3, true)
    assert_eq(typename(x), "float")
}

@test
fn test_string_annotation() {
    var s: string = "hello"
    assert_eq(s, "hello")
    assert_eq(typename(s), "string")
}

@test
fn test_bool_annotation() {
    var flag: bool = true
    assert_eq(flag, true)
    assert_eq(typename(flag), "bool")
}

// ===== 集合类型注解 =====
@test
fn test_array_annotation() {
    var arr: Array<int> = [1, 2, 3]
    assert_eq(arr.length, 3)
    assert_eq(typename(arr), "Array")
}

@test
fn test_map_annotation() {
    var m: Map<string, int> = #{"a": 1}
    assert_eq(m.get("a"), 1)
    assert_eq(typename(m), "Map")
}

@test
fn test_set_annotation() {
    var s: Set<int> = #[1, 2, 3]
    assert_eq(s.length, 3)
    assert_eq(typename(s), "Set")
}

// ===== 函数参数类型注解 =====
@test
fn test_function_param_annotation() {
    fn add(a: int, b: int) -> int {
        return a + b
    }
    assert_eq(add(2, 3), 5)
}

@test
fn test_function_return_annotation() {
    fn double(x: int) -> int {
        return x * 2
    }
    assert_eq(double(5), 10)
}

// ===== 类字段类型注解 =====
@test
fn test_class_field_annotation() {
    class Point {
        x: int
        y: int

        constructor(x: int, y: int) {
            this.x = x
            this.y = y
        }
    }
    var p = Point(3, 4)
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

// ===== 复杂类型 =====
@test
fn test_nullable_type() {
    var x: int = 10
    var y: int? = null
    if (y == null) {
        y = x
    }
    assert_eq(y, 10)
}
