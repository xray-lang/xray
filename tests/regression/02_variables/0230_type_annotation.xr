// 测试：类型注解
// ===== 基本类型注解 =====
@test
fn test_int_annotation() {
    var x: i64 = 42
    assert_eq(x, 42)
    assert_eq(typeName(x), "i64")
}

@test
fn test_float_annotation() {
    var x: f64 = 3.14
    assert_eq(x > 3, true)
    assert_eq(typeName(x), "f64")
}

@test
fn test_string_annotation() {
    var s: string = "hello"
    assert_eq(s, "hello")
    assert_eq(typeName(s), "string")
}

@test
fn test_bool_annotation() {
    var flag: bool = true
    assert_eq(flag, true)
    assert_eq(typeName(flag), "bool")
}

// ===== 集合类型注解 =====
@test
fn test_array_annotation() {
    var arr: Array<i64> = [1, 2, 3]
    assert_eq(len(arr), 3)
    assert_eq(typeName(arr), "Array")
}

@test
fn test_map_annotation() {
    var m: Map<string, i64> = #{"a": 1}
    assert_eq(m.get("a"), 1)
    assert_eq(typeName(m), "Map")
}

@test
fn test_set_annotation() {
    var s: Set<i64> = #[1, 2, 3]
    assert_eq(len(s), 3)
    assert_eq(typeName(s), "Set")
}

// ===== 函数参数类型注解 =====
@test
fn test_function_param_annotation() {
    fn add(a: i64, b: i64) -> i64 {
        return a + b
    }
    assert_eq(add(2, 3), 5)
}

@test
fn test_function_return_annotation() {
    fn double(x: i64) -> i64 {
        return x * 2
    }
    assert_eq(double(5), 10)
}

// ===== 类字段类型注解 =====
@test
fn test_class_field_annotation() {
    class Point {
        x: i64
        y: i64

        constructor(x: i64, y: i64) {
            this.x = x
            this.y = y
        }
    }
    var p = Point(3, 4)
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

// ===== 复杂类型 =====
@test
fn test_nullable_type() {
    var x: i64 = 10
    var y: i64? = null
    if (y == null) {
        y = x
    }
    assert_eq(y, 10)
}
