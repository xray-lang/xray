// 0221_map_destructure.xr
// Map destructuring is no longer supported.
// Use map["key"] instead. This test verifies the alternative pattern.

@test
fn test_map_destructure() {
    var data = #{"name": "Alice", "age": 30, "city": "Beijing"}
    var n = data["name"]
    var a = data["age"]
    assert_eq(n, "Alice")
    assert_eq(a, 30)

    var c = data["city"]
    assert_eq(c, "Beijing")

    var person = #{"first": "John", "last": "Doe", "id": 123}
    var firstName = person["first"]
    var lastName = person["last"]
    var userId = person["id"]
    assert_eq(firstName, "John")
    assert_eq(lastName, "Doe")
    assert_eq(userId, 123)
}

