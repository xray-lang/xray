// 0221_map_destructure.xr
// Map destructuring is no longer supported.
// Use map["key"] instead. This test verifies the alternative pattern.

@test
fn test_map_destructure() {
    var data = #{"name": "Alice", "age": 30, "city": "Beijing"}
    var n = data["name"]
    var a = data["age"]
    assert(n is string)
    assertEqual(n as string, "Alice")
    assert(a is i64)
    assertEqual(a as i64, 30)

    var c = data["city"]
    assert(c is string)
    assertEqual(c as string, "Beijing")

    var person = #{"first": "John", "last": "Doe", "id": 123}
    var firstName = person["first"]
    var lastName = person["last"]
    var userId = person["id"]
    assert(firstName is string)
    assertEqual(firstName as string, "John")
    assert(lastName is string)
    assertEqual(lastName as string, "Doe")
    assert(userId is i64)
    assertEqual(userId as i64, 123)
}
