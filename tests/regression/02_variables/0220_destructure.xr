// 0220_destructure.xr
// Flat destructuring tests (no nesting, no rest, no renaming)

// ===== Array destructuring =====

struct Person {
    name: string
    age: i64
}

struct InnerFields {
    f1: i64
    f2: i64
}

struct OuterFields {
    d: i64
    e: i64
    f: InnerFields
}

@test
fn test_array_basic() {
    var [a, b, c] = [1, 2, 3]
    assertEqual(a, 1)
    assertEqual(b, 2)
    assertEqual(c, 3)
}

@test
fn test_array_partial() {
    var [first, second] = [1, 2, 3, 4, 5]
    assertEqual(first, 1)
    assertEqual(second, 2)
}

@test
fn test_array_single() {
    var [x] = [42]
    assertEqual(x, 42)
}

// ===== Skip elements =====

@test
fn test_skip_elements() {
    var [first, , third] = [10, 20, 30]
    assertEqual(first, 10)
    assertEqual(third, 30)
}

@test
fn test_skip_multiple() {
    var [a, , , d] = [1, 2, 3, 4]
    assertEqual(a, 1)
    assertEqual(d, 4)
}

// ===== Flat array: nested values are kept as-is =====

@test
fn test_flat_nested_value() {
    var values: Array<i64 | Array<i64>> = [10, [11, 12], 13]
    var [a, b, c] = values
    assert(a is i64)
    assertEqual(a as i64, 10)
    assert(b is Array<i64>)
    var nested = b as Array<i64>
    assertEqual(nested[0], 11)
    assertEqual(nested[1], 12)
    assert(c is i64)
    assertEqual(c as i64, 13)
}

// ===== Named struct field projection =====

@test
fn test_struct_fields() {
    var person = Person{name: "Alice", age: 30}
    var name = person.name
    var age = person.age
    assertEqual(name, "Alice")
    assertEqual(age, 30)
}

@test
fn test_struct_nested_fields() {
    var fields = OuterFields{d: 100, e: 200, f: InnerFields{f1: 300, f2: 400}}
    var d = fields.d
    var e = fields.e
    var f = fields.f
    assertEqual(d, 100)
    assertEqual(e, 200)
    assertEqual(f.f1, 300)
    assertEqual(f.f2, 400)
}

@test
fn test_struct_field_rename() {
    var user = Person{name: "Alice", age: 30}
    var localName = user.name
    var age = user.age
    assertEqual(localName, "Alice")
    assertEqual(age, 30)

    var otherName = ""
    otherName = user.name
    assertEqual(otherName, "Alice")
}
