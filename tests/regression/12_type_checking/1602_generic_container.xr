// Test generic container type inference

// Array element type propagation

fn getFirst<T>(arr: Array<T>) -> T? {
    if (len(arr) > 0) {
        return arr[0]
    }
    return null
}
fn swap<T>(arr: ref Array<T>, i: int, j: int) {
    var temp = copy(arr[i])
    arr[i] = copy(arr[j])
    arr[j] = temp
}
fn contains<T>(arr: Array<T>, target: T) -> bool {
    for (item in arr) {
        if (item == target) {
            return true
        }
    }
    return false
}

@test
fn test_generic_container() {

    // Test with arrays (no explicit type annotation)
    var intArr = [10, 20, 30]
    var firstInt = getFirst(intArr)
    print(firstInt)            // 10

    var strArr = ["x", "y", "z"]
    var firstStr = getFirst(strArr)
    print(firstStr)            // "x"

    // Generic swap function

    var nums = [1, 2, 3]
    swap(ref nums, 0, 2)
    print(nums)                // [3, 2, 1]

    // Generic contains function

    print(contains([1, 2, 3], 2))      // true
    print(contains(["a", "b"], "c"))   // false

    print("Generic container test completed")
}
