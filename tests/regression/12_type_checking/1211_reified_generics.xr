// Test generic container and class behavior after removing the Reflect surface.

class Box<T> {
    value: T
    constructor(v: T) {
        this.value = v
    }
}
class Pair<A, B> {
    first: A
    second: B
    constructor(a: A, b: B) {
        this.first = a
        this.second = b
    }
}

@test
fn test_reified_generics() {
    // === Test 1: Runtime container names stay shape-based ===
    var arr = [1, 2, 3]
    assertEqual(typeName(arr), "Array")

    var map = #{"a": 1, "b": 2}
    assertEqual(typeName(map), "Map")

    var set = Set<i64>()
    assertEqual(typeName(set), "Set")

    // === Test 2: Typed containers keep their checked behavior ===
    var int_arr: Array<i64> = [10, 20, 30]
    assertEqual(typeName(int_arr), "Array")

    var float_arr: Array<f64> = [1.0, 2.0]
    assertEqual(typeName(float_arr), "Array")

    var str_arr: Array<string> = ["hello", "world"]
    assertEqual(typeName(str_arr), "Array")

    var bool_arr: Array<bool> = [true, false]
    assertEqual(typeName(bool_arr), "Array")

    var byte_arr: Array<u8> = [65, 66]
    assertEqual(typeName(byte_arr), "Array")

    // === Test 3: Empty typed containers ===
    var empty_int: Array<i64> = []
    empty_int.push(1)
    assertEqual(empty_int[0], 1)

    // === Test 4: Non-container type names use typeName() ===
    assertEqual(typeName(42), "i64")
    assertEqual(typeName("hello"), "string")

    // === Test 5: Slice preserves typed access behavior ===
    var src: Array<i64> = [1, 2, 3, 4, 5]
    var sliced: Slice<i64> = src[1:4]
    assertEqual(typeName(sliced), "Slice")
    assertEqual(sliced[0], 2)

    // === Test 6: Generic containers retain typed operations ===
    assertEqual(int_arr[0], 10)
    assertEqual(float_arr[0], 1.0)
    assertEqual(str_arr[0], "hello")
    assertEqual(bool_arr[0], true)

    var typed_map: Map<string, i64> = #{"x": 1}
    assertEqual(typeName(typed_map), "Map")
    assertEqual(typed_map["x"], 1)

    var typed_set: Set<string> = Set()
    assertEqual(typeName(typed_set), "Set")

    const typed_channel = Channel<i64>(1)
    assertEqual(typeName(typed_channel), "Channel")
    typed_channel.close()

    const annotated_channel: Channel<string> = Channel(1)
    assertEqual(typeName(annotated_channel), "Channel")
    annotated_channel.close()

    const zero_channel = Channel<bool>()
    assertEqual(typeName(zero_channel), "Channel")
    zero_channel.close()

    const annotated_zero: Channel<f64> = Channel()
    assertEqual(typeName(annotated_zero), "Channel")
    annotated_zero.close()

    // === Test 7: Typed Array compact storage + operations ===
    int_arr.push(40)
    assertEqual(len(int_arr), 4)
    assertEqual(int_arr[3], 40)

    var mapped_bytes = byte_arr.map(fn(x: u8) -> i64 { return (x as i64) + 1 })
    assertEqual(typeName(mapped_bytes), "Array")
    assertEqual(mapped_bytes[0], 66)

    // === Test 8: User-defined generic classes retain origin and value behavior ===

    var int_box = Box<i64>(42)
    assert(int_box is Box)
    assertEqual(int_box.value, 42)

    var str_box = Box<string>("hello")
    assert(str_box is Box)
    assertEqual(str_box.value, "hello")

    // Non-generic instance
    var plain_box = Box(99)
    assert(plain_box is Box)
    assertEqual(plain_box.value, 99)

    // Two type params

    var pair = Pair<i64, string>(1, "one")
    assert(pair is Pair)
    assertEqual(pair.first, 1)
    assertEqual(pair.second, "one")

    var plain_pair = Pair(1, 2)
    assert(plain_pair is Pair)
    assertEqual(plain_pair.first, 1)
    assertEqual(plain_pair.second, 2)
}
