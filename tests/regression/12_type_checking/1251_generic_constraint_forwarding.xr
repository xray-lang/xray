// 1251_generic_constraint_forwarding.xr
// Forwarding a constrained type parameter into another generic.
//
// REGRESSION: `fn outer<T: C>(x: T) { inner(x) }` where `inner<U: C>` was
//             rejected with E0358 "Type 'T' does not satisfy constraint 'C'
//             for type parameter 'U'", even though T carries exactly the
//             constraint U demands.
// FAIL_AT:    the call-site constraint check handed the type argument to
//             xr_type_satisfies_constraint(). A type parameter's constraints
//             live on the enclosing declaration's XaSymbolLinks, not on the
//             XrType, so the runtime-layer check saw a bare
//             XR_KIND_TYPE_PARAM, had nothing to match, and fell through to
//             `return false`.
// PASS_AT:    the analyzer now resolves the entailment before calling down:
//             it walks out to the function or class that introduced the type
//             parameter and accepts when one of that parameter's own
//             constraints implies the target constraint.
//
// The entailment must stay conservative — forwarding to a constraint the
// parameter does not carry is still an error. See
// tests/compile_errors/type/143_generic_constraint_forwarding_unsatisfied.xr.

// ===== Implicit type argument (inferred from the argument) =====
fn innerC<U: Comparable>(y: U) -> U {
    return y
}

fn outerC<T: Comparable>(x: T) -> T {
    return innerC(x)
}

@test
fn test_forward_inferred_int() {
    assertEqual(outerC(3), 3)
}

@test
fn test_forward_inferred_string() {
    assertEqual(outerC("hi"), "hi")
}

// ===== Explicit type argument =====
fn outerCExplicit<T: Comparable>(x: T) -> T {
    return innerC<T>(x)
}

@test
fn test_forward_explicit_type_arg() {
    assertEqual(outerCExplicit(7), 7)
    assertEqual(outerCExplicit("ok"), "ok")
}

// ===== Constraint-agnostic: Hashable and Iterable behave the same =====
fn innerH<U: Hashable>(y: U) -> U {
    return y
}

fn outerH<T: Hashable>(x: T) -> T {
    return innerH(x)
}

@test
fn test_forward_hashable() {
    assertEqual(outerH(5), 5)
}

// Returns a derived value rather than the parameter itself: an Array argument
// is an owned value, and returning a read parameter is a separate ownership
// error that would mask what this case is meant to check.
fn innerIt<U: Iterable<i64>>(y: U) -> i64 {
    return len(y)
}

fn outerIt<T: Iterable<i64>>(x: T) -> i64 {
    return innerIt(x)
}

@test
fn test_forward_iterable() {
    assertEqual(outerIt([1, 2, 3]), 3)
}

// ===== Wider source constraint satisfies a narrower target =====
// T carries Comparable & Hashable; U only demands Hashable.
fn outerCH<T: Comparable & Hashable>(x: T) -> T {
    return innerH(x)
}

@test
fn test_forward_subset_of_constraints() {
    assertEqual(outerCH(9), 9)
    assertEqual(outerCH("z"), "z")
}

// ===== Universally-satisfied target constraint =====
fn innerS<U: Stringable>(y: U) -> U {
    return y
}

fn outerCtoS<T: Comparable>(x: T) -> T {
    return innerS(x)
}

@test
fn test_forward_to_universal_constraint() {
    assertEqual(outerCtoS(4), 4)
}

// ===== Class upper bound: a subclass bound satisfies a superclass bound =====
class Animal {
    name: string

    constructor(name) {
        this.name = name
    }
}

class Dog extends Animal {
    constructor(name) {
        super(name)
    }
}

fn innerAnimal<U: Animal>(y: U) -> string {
    return y.name
}

fn outerDog<T: Dog>(x: T) -> string {
    return innerAnimal(x)
}

@test
fn test_forward_class_bound_to_superclass() {
    assertEqual(outerDog(Dog("rex")), "rex")
}

// ===== User-defined interface constraint =====
interface Shape {
    area() -> f64
}

class Square implements Shape {
    side: f64

    constructor(side) {
        this.side = side
    }

    area() -> f64 {
        return this.side * this.side
    }
}

fn innerShape<U: Shape>(y: U) -> f64 {
    return y.area()
}

fn outerShape<T: Shape>(x: T) -> f64 {
    return innerShape(x)
}

@test
fn test_forward_user_interface() {
    var a = outerShape<Square>(Square(2.0))
    assert(a > 3.9 && a < 4.1)
}

// ===== Type parameter introduced by the enclosing class =====
fn identityC<U: Comparable>(y: U) -> U {
    return y
}

class Holder<T: Comparable> {
    value: T

    constructor(value) {
        this.value = value
    }

    forwarded() -> T {
        return identityC(this.value)
    }
}

@test
fn test_forward_class_type_param() {
    assertEqual(Holder<i64>(11).forwarded(), 11)
    assertEqual(Holder<string>("cls").forwarded(), "cls")
}

// ===== Forwarding into a method's own generic constraint =====
// A method's `<U: C>` reaches the same shared call-site check as a plain fn,
// so entailment has to hold there too.
class Forwarder {
    constructor() {}

    pick<U: Comparable>(y: U) -> U {
        return y
    }

    static pickStatic<U: Comparable>(y: U) -> U {
        return y
    }
}

fn outerToMethod<T: Comparable>(x: T) -> T {
    return Forwarder().pick(x)
}

fn outerToStaticMethod<T: Comparable>(x: T) -> T {
    return Forwarder.pickStatic(x)
}

@test
fn test_forward_into_instance_method() {
    assertEqual(outerToMethod(15), 15)
    assertEqual(outerToMethod("m"), "m")
}

@test
fn test_forward_into_static_method() {
    assertEqual(outerToStaticMethod(16), 16)
}

// ===== Multi-hop forwarding: T -> U -> V =====
fn hop3<V: Comparable>(z: V) -> V {
    return z
}

fn hop2<U: Comparable>(y: U) -> U {
    return hop3(y)
}

fn hop1<T: Comparable>(x: T) -> T {
    return hop2(x)
}

@test
fn test_forward_multi_hop() {
    assertEqual(hop1(21), 21)
    assertEqual(hop1("hop"), "hop")
}

// ===== An unconstrained target still accepts a constrained parameter =====
fn innerFree<U>(y: U) -> U {
    return y
}

fn outerToFree<T: Comparable>(x: T) -> T {
    return innerFree(x)
}

@test
fn test_forward_to_unconstrained() {
    assertEqual(outerToFree(6), 6)
}

// ===== Shadowing: an inner unconstrained T must not borrow the outer bound =====
// `shadowOuter` declares T: Comparable, but `shadowInner` re-binds T with no
// constraint. Calling shadowInner (not identityC) from shadowOuter is fine —
// the point is that the analyzer resolves T against the innermost binder.
fn shadowInner<T>(z: T) -> T {
    return z
}

fn shadowOuter<T: Comparable>(x: T) -> T {
    return shadowInner(x)
}

@test
fn test_shadowed_type_param_resolves_to_inner_binder() {
    assertEqual(shadowOuter(13), 13)
}

print("All generic constraint forwarding tests passed!")
