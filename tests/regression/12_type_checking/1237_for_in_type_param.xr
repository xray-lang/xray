// 1237_for_in_type_param.xr
// `for (i in xs)` where xs has a generic type parameter type: legal exactly
// when one of that parameter's declared bounds is iterable, and the loop
// variable takes the bound's element type.
//
//     fn total<T: Iterable<int>>(xs: T) -> int {
//         var n = 0
//         for (i in xs) { n = n + i }   // i: int, from the Iterable<int> bound
//         return n
//     }
//
// This is the shape xanalyzer_builtin_interfaces.c documented as the point of
// the built-in Iterable interface ("fn process<T: Iterable>(collection: T) {
// for (item in collection) ... }") but that never worked.
//
// REGRESSION: the for-in branch of xa_visit_call had no XR_KIND_TYPE_PARAM
//             case, so a type parameter fell through to the generic
//             "iterator() protocol" path and always failed.
// FAIL_AT:    pre-fix, for BOTH methods and top-level functions
//             -> E0352 "type 'T' is not iterable; expected an Array, Map, Set,
//                string, Json, range or a class with an 'iterator()' method"
// PASS_AT:    post-fix
//             -> the bound is consulted; xa_analyzer_is_iterable now also
//                recognizes Iterable<T> (it previously knew only Iterator<T>),
//                so the element type comes from the bound's type argument.
//
// The negative half (an unbounded T) lives in
// tests/compile_errors/type/141_for_in_unbounded_type_param.xr.

class Summer {
    constructor() {}

    // The original bug report's exact shape.
    total<T: Iterable<int>>(xs: T) -> int {
        var n = 0
        for (i in xs) { n = n + i }
        return n
    }

    static totalStatic<T: Iterable<int>>(xs: T) -> int {
        var n = 0
        for (i in xs) { n = n + i }
        return n
    }
}

// ===== The reported repro =====
@test
fn test_method_iterable_bound() {
    var c = Summer()
    assert_eq(c.total([1, 2, 3]), 6)
}

@test
fn test_static_method_iterable_bound() {
    assert_eq(Summer.totalStatic([10, 20]), 30)
}

// ===== Same bound on a top-level function =====
@test
fn test_function_iterable_bound() {
    fn total<T: Iterable<int>>(xs: T) -> int {
        var n = 0
        for (i in xs) { n = n + i }
        return n
    }
    assert_eq(total([4, 5, 6]), 15)
}

// ===== The element type really comes from the bound =====
@test
fn test_element_type_follows_bound() {
    fn joinAll<T: Iterable<string>>(xs: T) -> string {
        var s = ""
        for (w in xs) { s = s + w }
        return s
    }
    assert_eq(joinAll(["a", "b", "c"]), "abc")
}

// ===== Set and explicit type argument =====
@test
fn test_iterable_bound_explicit_type_arg() {
    fn count<T: Iterable<int>>(xs: T) -> int {
        var n = 0
        for (i in xs) { n = n + 1 }
        return n
    }
    assert_eq(count<Array<int>>([7, 8, 9]), 3)
}

// ===== An iterable bound alongside an unconstrained parameter =====
@test
fn test_iterable_bound_with_second_param() {
    fn tagAll<T: Iterable<int>, U>(xs: T, tag: U) -> int {
        var n = 0
        for (i in xs) { n = n + i }
        return n
    }
    assert_eq(tagAll([1, 2], "label"), 3)
    assert_eq(tagAll([3, 4], 99), 7)
}

print("All for-in type parameter tests passed!")
