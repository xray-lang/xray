// 1230_function_type_annotation.xr
// Test: Function type annotation syntax fn(T): R

// ===== Basic function type parameter =====

@test
fn test_fn_type_basic() {
    fn apply(x: i64, f: fn(i64) -> i64) -> i64 {
        return f(x)
    }
    
    var result = apply(5, (n) -> n * 2)
    assertEqual(result, 10)
}

// ===== Function type with void return =====

@test
fn test_fn_type_void() {
    var count = 0
    
    fn forEach(arr: Array<i64>, f: fn(i64)) {
        for (item in arr) {
            f(item)
        }
    }
    
    forEach([1, 2, 3], (x) -> {
        count = count + x
    })
    assertEqual(count, 6)
}

// ===== Function type with no parameters =====

@test
fn test_fn_type_no_params() {
    fn callIt(f: fn() -> i64) -> i64 {
        return f()
    }
    
    var result = callIt(() -> 42)
    assertEqual(result, 42)
}

// ===== Function type with multiple parameters =====

@test
fn test_fn_type_multi_params() {
    fn combine(a: i64, b: i64, f: fn(i64, i64) -> i64) -> i64 {
        return f(a, b)
    }
    
    assertEqual(combine(3, 4, (a, b) -> a + b), 7)
    assertEqual(combine(3, 4, (a, b) -> a * b), 12)
}

// ===== Function type with string return =====

@test
fn test_fn_type_string_return() {
    fn transform(x: i64, f: fn(i64) -> string) -> string {
        return f(x)
    }
    
    var result = transform(42, (n) -> "value: " + string(n))
    assertEqual(result, "value: 42")
}

// ===== Higher-order: function returning function =====

@test
fn test_fn_type_higher_order() {
    fn makeAdder(n: i64) -> fn(i64) -> i64 {
        return (x) -> x + n
    }
    
    var add5 = makeAdder(5)
    assertEqual(add5(10), 15)
    assertEqual(add5(0), 5)
}

// ===== Nested function types: fn(fn(int): int): int =====

@test
fn test_fn_type_nested() {
    fn applyTwice(x: i64, f: fn(i64) -> i64) -> i64 {
        return f(f(x))
    }
    
    assertEqual(applyTwice(3, (n) -> n * 2), 12)
    assertEqual(applyTwice(1, (n) -> n + 10), 21)
}

// ===== Function type in variable declaration =====

@test
fn test_fn_type_variable() {
    var f: fn(i64) -> i64 = (x) -> x * 3
    assertEqual(f(5), 15)
}

// ===== Optional function type =====

@test
fn test_fn_type_optional() {
    fn maybeApply(x: i64, f: fn(i64) -> i64) -> i64 {
        return f(x)
    }
    
    assertEqual(maybeApply(5, (n) -> n + 1), 6)
}

// ===== Tuple type still works: (int, bool) =====

@test
fn test_tuple_type_unchanged() {
    fn divide(a: i64, b: i64) -> (i64, bool) {
        if (b == 0) {
            return (0, false)
        }
        return (a / b, true)
    }
    
    var (result, ok) = divide(10, 3)
    assertEqual(result, 3)
    assertEqual(ok, true)
    
    var (result2, ok2) = divide(10, 0)
    assertEqual(result2, 0)
    assertEqual(ok2, false)
}
