// 1301_is_as_union.xr
// Test: is type guard, as type assertion, and union type behavior

// ===== is type guard =====

@test
fn test_is_basic() {
    var x: i64 | string | bool = 42
    assertEqual(x is i64, true)
    assertEqual(x is string, false)
    assertEqual(x is bool, false)
}

@test
fn test_is_string() {
    var x: i64 | string | bool = "hello"
    assertEqual(x is string, true)
    assertEqual(x is i64, false)
}

@test
fn test_is_bool() {
    var x: i64 | string | bool = true
    assertEqual(x is bool, true)
    assertEqual(x is i64, false)
}

@test
fn test_is_null() {
    var x: i64? = null
    assertEqual(x is null, true)
    assertEqual(x is i64, false)
}

@test
fn test_is_array() {
    var x: Array<i64> = [1, 2, 3]
    assertEqual(x is Array<i64>, true)
    assertEqual(x is i64, false)
}

// ===== as type assertion =====

@test
fn test_as_safe() {
    var x: i64 | string | bool = 42
    var n = x as i64?
    assertEqual(n, 42)
    
    var s = x as string?
    assertEqual(s, null)
}

@test
fn test_as_unsafe() {
    var x: i64 | string | bool = "hello"
    var s = x as string
    assertEqual(s, "hello")
}

@test
fn test_as_safe_chain() {
    var x: i64 | f64 | string = 3.14
    var n = x as i64?
    assertEqual(n, null)
    
    var f = x as f64?
    assertEqual(f, 3.14)
}

// ===== is type guard narrowing =====

@test
fn test_is_narrowing_in_if() {
    var x: i64 | string | bool = 42
    var result: i64 = 0
    if (x is i64) {
        result = x + 1
    }
    assertEqual(result, 43)
}

@test
fn test_is_narrowing_string() {
    var x: i64 | string | bool = "hello"
    var result: string = ""
    if (x is string) {
        result = x + " world"
    }
    assertEqual(result, "hello world")
}

// ===== Union type basics =====

@test
fn test_union_variable() {
    var x: i64 | string = 42
    assertEqual(x is i64, true)
    
    var y: i64 | string = "hello"
    assertEqual(y is string, true)
}

@test
fn test_union_function_param() {
    fn process(x: i64 | string) -> string {
        if (x is i64) {
            return "int"
        }
        return "other"
    }
    assertEqual(process(42), "int")
    assertEqual(process("hi"), "other")
}

@test
fn test_union_nullable() {
    var x: i64? = null
    assertEqual(x is null, true)
    assertEqual(x is i64, false)
    
    var y: i64? = 42
    assertEqual(y is i64, true)
    assertEqual(y is null, false)
}
