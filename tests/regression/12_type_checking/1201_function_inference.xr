// 1201_function_inference.xr
// Test function type inference
// ===== Return Type Inference =====
@test
fn test_implicit_return_int() {
    fn add(a: i64, b: i64) -> i64 {
        return a + b
    }
    var result = add(2, 3)
    assertEqual(result, 5)
    assertEqual(typeName(result), "i64")
}

@test
fn test_implicit_return_string() {
    fn greet(name: string) -> string {
        return "Hello, " + name
    }
    var result = greet("World")
    assertEqual(result, "Hello, World")
    assertEqual(typeName(result), "string")
}

@test
fn test_explicit_return_type() {
    fn double(x: i64) -> i64 {
        return x * 2
    }
    var result = double(5)
    assertEqual(result, 10)
    assertEqual(typeName(result), "i64")
}

@test
fn test_void_return() {
    var called = false
    fn doSomething() {
        called = true
    }
    doSomething()
    assertEqual(called, true)
}

// ===== Parameter Type Inference =====
@test
fn test_typed_params() {
    fn multiply(a: i64, b: i64) -> i64 {
        return a * b
    }
    assertEqual(multiply(3, 4), 12)
}

@test
fn test_mixed_typed_params() {
    fn format(name: string, age: i64) -> string {
        return name + " is " + string(age)
    }
    assertEqual(format("Alice", 30), "Alice is 30")
}

// ===== Multi-value Return =====
@test
fn test_multi_return() {
    fn divmod(a: i64, b: i64) -> (i64, i64) {
        return (a / b, a % b)
    }
    var (q, r) = divmod(17, 5)
    assertEqual(q, 3)
    assertEqual(r, 2)
}

@test
fn test_multi_return_typed() {
    fn minmax(a: i64, b: i64) -> (i64, i64) {
        if (a < b) {
            return (a, b)
        }
        return (b, a)
    }
    var (min, max) = minmax(10, 5)
    assertEqual(min, 5)
    assertEqual(max, 10)
}

// ===== Closure Type Inference =====
@test
fn test_closure_captures() {
    var multiplier = 3
    fn triple(x: i64) -> i64 {
        return x * multiplier
    }
    assertEqual(triple(4), 12)
}

@test
fn test_counter_closure() {
    fn makeCounter() -> fn() -> i64 {
        var count = 0
        return fn() {
            count = count + 1
            return count
        }
    }
    var counter = makeCounter()
    assertEqual(counter(), 1)
    assertEqual(counter(), 2)
    assertEqual(counter(), 3)
}

// ===== Arrow Function Inference =====
@test
fn test_arrow_single_expr() {
    var double = fn(x: i64) {
        return x * 2
    }
    assertEqual(double(5), 10)
}

@test
fn test_arrow_with_block() {
    var factorial = fn(n: i64) -> i64 {
        if (n <= 1) {
            return 1
        }
        return n * factorial(n - 1)
    }
    assertEqual(factorial(5), 120)
}

@test
fn test_arrow_multi_param() {
    var add = fn(a: i64, b: i64) {
        return a + b
    }
    assertEqual(add(3, 4), 7)
}

// ===== Higher Order Functions =====
@test
fn test_callback_inference() {
    var arr = [1, 2, 3, 4, 5]
    var doubled = arr.map(fn(x) {
        return x * 2
    })
    assertEqual(doubled[0], 2)
    assertEqual(doubled[4], 10)
}

@test
fn test_filter_inference() {
    var arr = [1, 2, 3, 4, 5]
    var evens = arr.filter(fn(x) {
        return x % 2 == 0
    })
    assertEqual(len(evens), 2)
    assertEqual(evens[0], 2)
    assertEqual(evens[1], 4)
}

@test
fn test_reduce_inference() {
    var arr = [1, 2, 3, 4, 5]
    var sum = arr.reduce(fn(acc, x) {
        return acc + x
    }, 0)
    assertEqual(sum, 15)
}

// ===== Recursive Function Inference =====
@test
fn test_recursive_fibonacci() {
    fn fib(n: i64) -> i64 {
        if (n <= 1) {
            return n
        }
        return fib(n - 1) + fib(n - 2)
    }
    assertEqual(fib(10), 55)
}

// Mutual recursion - now supported via function hoisting
@test
fn test_mutual_recursion() {
    fn isEven(n: i64) -> bool {
        if (n == 0) {
            return true
        }
        return isOdd(n - 1)
    }
    fn isOdd(n: i64) -> bool {
        if (n == 0) {
            return false
        }
        return isEven(n - 1)
    }
    assertEqual(isEven(10), true)
    assertEqual(isOdd(10), false)
}
