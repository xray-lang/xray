// Test: Generic function with explicit type parameters
// Expected: prints "ok"
// Basic identity function

fn identity<T>(x: T) -> T {
    return x
}
fn makePair<A, B>(a: A, b: B) -> (A, B) {
    return (a, b)
}
fn first<T>(arr: Array<T>) -> T? {
    if (len(arr) > 0) {
        return arr[0]
    }
    return null
}
fn last<T>(arr: Array<T>) -> T? {
    if (len(arr) > 0) {
        return arr[len(arr) - 1]
    }
    return null
}
fn apply<T, R>(x: T, f: fn(T) -> R) -> R {
    return f(x)
}
fn wrap<T>(x: T) -> Array<T> {
    return [x]
}
fn double<T>(x: T) -> T {
    return x
}

@test
fn test_generic_functions() {

    // Test 1: Implicit type inference
    assertEqual(identity(42), 42)
    assertEqual(identity("hello"), "hello")
    assertEqual(identity(true), true)
    // Test 2: Explicit type parameter
    assertEqual(identity<i64>(100), 100)
    assertEqual(identity<string>("world"), "world")
    assertEqual(identity<bool>(false), false)

    // Multiple type parameters

    // Test 3: Multiple type params - implicit
    var (p1a, p1b) = makePair(1, "one")
    assertEqual(p1a, 1)
    assertEqual(p1b, "one")
    // Test 4: Multiple type params - explicit  
    var (p2a, p2b) = makePair<string, i64>("age", 30)
    assertEqual(p2a, "age")
    assertEqual(p2b, 30)

    // Generic array functions


    // Test 5: Array functions
    assertEqual(first([1, 2, 3]), 1)
    assertEqual(last([1, 2, 3]), 3)
    assertEqual(first(["a", "b", "c"]), "a")
    assertEqual(last(["x", "y", "z"]), "z")
    assertEqual(first([]), null)

    // Higher-order generic functions

    // Test 6: Higher-order
    var doubled = apply(5, fn(n) {
        return n * 2
    })
    assertEqual(doubled, 10)
    var length = apply("hello", fn(s) {
        return len(s)
    })
    assertEqual(length, 5)

    // Generic with array result

    // Test 7: Wrap
    var intArr = wrap(42)
    assertEqual(intArr[0], 42)
    assertEqual(len(intArr), 1)
    var strArr = wrap("test")
    assertEqual(strArr[0], "test")

    // Nested generic calls

    // Test 8: Nested calls
    var result = wrap(identity(99))
    assertEqual(result[0], 99)
}

