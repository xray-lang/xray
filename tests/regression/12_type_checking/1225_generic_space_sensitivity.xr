// Test: Swift-style space-sensitive generic disambiguation
// Rule: foo<T>() is generic call, foo < T is comparison
// Generic function definition

fn identity<T>(x: T) -> T {
    return x
}
fn compare(a: i64, b: i64) -> bool {
    return a < b
}
fn getFirstComparison() -> bool {
    var x = 5
    var y = 10
    // With space, this is a comparison, not generic syntax
    return x < y
}
fn getSecondComparison() -> bool {
    var z = 3
    var x = 5
    return z < x
}
fn bothTrue(a: bool, b: bool) -> bool {
    return a && b
}
class Box<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }

    get() -> T {
        return this.value
    }
}
class Utils {
    wrap<T>(item: T) -> Array<T> {
        return [item]
    }
}

@test
fn test_generic_space_sensitivity() {


    // =============================================================================
    // Test 1: Generic call without space (should work)
    // =============================================================================
    var n1 = identity<i64>(42)
    assertEqual(n1, 42)
    var s1 = identity<string>("hello")
    assertEqual(s1, "hello")
    // =============================================================================
    // Test 2: Comparison with space (should NOT be parsed as generic)
    // =============================================================================
    var a = 10
    var b = 20
    var c = 5
    // These should all be comparisons, not generic calls
    var cmp1 = a < b
    // true
    var cmp2 = b > a
    // true
    var cmp3 = a < b && c < a
    // true && true = true
    assertEqual(cmp1, true)
    assertEqual(cmp2, true)
    assertEqual(cmp3, true)

    // =============================================================================
    // Test 3: Multi-value return with comparison (the critical case)
    // =============================================================================


    var r1 = getFirstComparison()
    var r2 = getSecondComparison()
    assertEqual(r1, true)
    assertEqual(r2, true)

    // =============================================================================
    // Test 4: Function call with multiple comparison arguments
    // =============================================================================

    var result = bothTrue(3 < 5, 10 > 7)
    // bothTrue(true, true)
    assertEqual(result, true)

    // =============================================================================
    // Test 5: Nested generic types (>> handling)
    // =============================================================================

    // Nested generic - tests >> split handling
    var nested = Box<Array<i64>>([1, 2, 3])
    assertEqual(nested.get()[0], 1)
    // Double nested
    var deep = Box<Box<i64>>(Box<i64>(42))
    assertEqual(deep.get().get(), 42)

    // =============================================================================
    // Test 6: Generic method call
    // =============================================================================

    var u = Utils()
    var arr = u.wrap<i64>(100)
    assertEqual(arr[0], 100)
    // =============================================================================
    // Test 7: Type inference (no explicit type args needed)
    // =============================================================================
    var inferred = identity(999)
    // Should infer int
    assertEqual(inferred, 999)
    var box = Box(123)
    // Should infer Box<int>
    assertEqual(box.get(), 123)
    // =============================================================================
    // Test 8: Array literals with comparisons
    // =============================================================================
    var comparisons = [1 < 2, 3 > 2, 5 < 10]
    // [true, true, true]
    assertEqual(comparisons[0], true)
    assertEqual(comparisons[1], true)
    assertEqual(comparisons[2], true)
}

