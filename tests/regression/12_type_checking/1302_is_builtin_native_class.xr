// 1302_is_builtin_native_class.xr
// `is` / `as` against source-defined NetConn/NetListener and prelude-native
// BigInt/StringBuilder on union values. Both identity paths must compile and
// answer correctly, and a safe cast must reject a mismatching member.
// Fixed-width targets ride the same lowering path and are pinned here too.

import net
import { NetConn, NetListener } from net

fn isConn(x: NetConn | i64) -> bool { return x is NetConn }
fn isListener(x: NetListener | i64) -> bool { return x is NetListener }
fn isBig(x: BigInt | i64) -> bool { return x is BigInt }
fn isSb(x: StringBuilder | i64) -> bool { return x is StringBuilder }

fn describeConn(x: NetConn | i64) -> string {
    match (x) {
        is NetConn -> { return "conn" }
        is i64 -> { return "int" }
    }
}

fn describeBig(x: BigInt | i64) -> string {
    match (x) {
        is BigInt -> { return "big" }
        is i64 -> { return "int" }
    }
}

@test
fn test_native_class_negative_members() {
    assertEqual(isConn(1), false)
    assertEqual(isListener(2), false)
    assertEqual(isBig(3), false)
    assertEqual(isSb(4), false)
    assertEqual(describeConn(5), "int")
    assertEqual(describeBig(6), "int")
}

@test
fn test_bigint_and_stringbuilder_positive() {
    assertEqual(isBig(123n), true)
    assertEqual(describeBig(45n), "big")
    var sb = StringBuilder()
    assertEqual(isSb(sb), true)
}

@test
fn test_safe_cast_rejects_wrong_member() {
    var x: NetConn | i64 = 42
    var c = x as NetConn?
    assertEqual(c == null, true)
    var y: BigInt | i64 = 7
    var b = y as BigInt?
    assertEqual(b == null, true)
}

@test
fn test_fixed_width_targets() {
    var small: i64 = 42
    var wide: i64 = 70000
    assertEqual(small is i16, true)
    assertEqual(wide is i16, false)
    assertEqual(small is i32, true)
    assertEqual(small is u64, true)
    // Erasure keeps only the 64-bit payload, so every integer pattern is a
    // u64 value; signedness only gates the sub-64 widths.
    assertEqual((-1) is u64, true)
    assertEqual((-1) is u16, false)
    var fits = wide as i16?
    assertEqual(fits == null, true)
    var kept = small as i16?
    assertEqual(kept == null, false)
}

// Loopback pair: `net.dial` yields until the listener side accepts, so the
// accept runs in a child coroutine, as in 1433_net_loopback.xr.
fn acceptOne(lst: NetListener) {
    var conn = net.accept(lst)!
    net.close(conn)
}

@test
fn test_net_handles_positive() {
    var maybeLst = net.listen(0, 8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    assertEqual(isListener(lst), true)
    var port = net.port(lst)
    go acceptOne(lst)
    var c = net.dial("127.0.0.1", port)!
    assertEqual(isConn(c), true)
    assertEqual(describeConn(c), "conn")
    var back = c as NetConn?
    assertEqual(back == null, false)
    net.close(c)
    net.close(lst)
}
