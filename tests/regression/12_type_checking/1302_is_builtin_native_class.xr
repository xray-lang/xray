// 1302_is_builtin_native_class.xr
// `is` / `as` against prelude native classes on union values: NetConn,
// NetListener, BigInt, StringBuilder. These classes have no class value in
// any scope, so the test lowers to their runtime type id; both the if and
// the match positions must compile and answer correctly, and the safe cast
// must reject a mismatching member instead of passing it through.
// Fixed-width targets ride the same lowering path and are pinned here too.

import net

fn isConn(x: NetConn | i64) -> bool { return x is NetConn }
fn isListener(x: NetListener | i64) -> bool { return x is NetListener }
fn isBig(x: BigInt | i64) -> bool { return x is BigInt }
fn isSb(x: StringBuilder | i64) -> bool { return x is StringBuilder }

fn describeConn(x: NetConn | i64) -> string {
    match (x) {
        is NetConn -> { return "conn" }
        is i64 -> { return "int" }
    }
}

fn describeBig(x: BigInt | i64) -> string {
    match (x) {
        is BigInt -> { return "big" }
        is i64 -> { return "int" }
    }
}

@test
fn test_native_class_negative_members() {
    assert_eq(isConn(1), false)
    assert_eq(isListener(2), false)
    assert_eq(isBig(3), false)
    assert_eq(isSb(4), false)
    assert_eq(describeConn(5), "int")
    assert_eq(describeBig(6), "int")
}

@test
fn test_bigint_and_stringbuilder_positive() {
    assert_eq(isBig(123n), true)
    assert_eq(describeBig(45n), "big")
    var sb = StringBuilder()
    assert_eq(isSb(sb), true)
}

@test
fn test_safe_cast_rejects_wrong_member() {
    var x: NetConn | i64 = 42
    var c = x as NetConn?
    assert_eq(c == null, true)
    var y: BigInt | i64 = 7
    var b = y as BigInt?
    assert_eq(b == null, true)
}

@test
fn test_fixed_width_targets() {
    var small: i64 = 42
    var wide: i64 = 70000
    assert_eq(small is i16, true)
    assert_eq(wide is i16, false)
    assert_eq(small is i32, true)
    assert_eq(small is u64, true)
    // Erasure keeps only the 64-bit payload, so every integer pattern is a
    // u64 value; signedness only gates the sub-64 widths.
    assert_eq((-1) is u64, true)
    assert_eq((-1) is u16, false)
    var fits = wide as i16?
    assert_eq(fits == null, true)
    var kept = small as i16?
    assert_eq(kept == null, false)
}

// Loopback pair: `net.dial` yields until the listener side accepts, so the
// accept runs in a child coroutine, as in 1433_net_loopback.xr.
fn acceptOne(lst: NetListener) {
    var conn = net.accept(lst)!
    net.close(conn)
}

@test
fn test_net_handles_positive() {
    var maybeLst = net.listen(0, 8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    assert_eq(isListener(lst), true)
    var port = lst.port()
    go acceptOne(lst)
    var c = net.dial("127.0.0.1", port)!
    assert_eq(isConn(c), true)
    assert_eq(describeConn(c), "conn")
    var back = c as NetConn?
    assert_eq(back == null, false)
    net.close(c)
    net.close(lst)
}
