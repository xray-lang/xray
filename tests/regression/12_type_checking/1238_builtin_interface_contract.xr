// 1238_builtin_interface_contract.xr
// 测试：内建接口在没有被同名用户接口遮蔽时照常生效
//
// Pairs with 1237_prelude_interface_shadowing.xr: that file declares its own
// `interface Lengthable` and must not inherit the builtin contract; this file
// declares none, so `implements Lengthable` resolves to the builtin and its
// `operator len() -> int` requirement is what makes len(bag) legal.

class Bag implements Lengthable {
    n: i64
    constructor(n: i64) { this.n = n }
    operator len() -> i64 { return this.n }
}

@test
fn test_builtin_lengthable_contract_still_enforced() {
    var b = Bag(5)
    assertEqual(len(b), 5)
    assertEqual(len(Bag(0)), 0)
}

@test
fn test_builtin_lengthable_via_generic_constraint() {
    assertEqual(measure(Bag(7)), 7)
    assertEqual(measure([1, 2, 3]), 3)
    assertEqual(measure("abcd"), 4)
}

fn measure<T: Lengthable>(value: T) -> i64 {
    return len(value)
}
