// 1202_generic_inference.xr
// Test generic type inference

fn recvInt(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value { value: v } -> v
        _ -> -1
    }
}

// ===== Array Generic Inference =====
@test
fn test_array_type_annotation() {
    var arr: Array<i64> = [1, 2, 3]
    assertEqual(len(arr), 3)
    arr.push(4)
    assertEqual(len(arr), 4)
}

@test
fn test_array_infer_from_elements() {
    // Type should be inferred as Array<int>
    var arr = [1, 2, 3]
    arr.push(4)
    assertEqual(arr[3], 4)
}

@test
fn test_array_empty_with_annotation() {
    var arr: Array<string> = []
    arr.push("hello")
    arr.push("world")
    assertEqual(len(arr), 2)
}

// ===== Map Generic Inference =====
@test
fn test_map_type_annotation() {
    var m: Map<string, i64> = #{}
    m.set("a", 1)
    m.set("b", 2)
    assertEqual(m.get("a"), 1)
    assertEqual(len(m), 2)
}

@test
fn test_map_infer_from_literal() {
    var m = #{"name": "Alice", "city": "Beijing"}
    assertEqual(m.get("name"), "Alice")
}

// ===== Set Generic Inference =====
@test
fn test_set_type_annotation() {
    var s: Set<i64> = #[]
    s.add(1)
    s.add(2)
    s.add(1)
    // duplicate
    assertEqual(len(s), 2)
}

@test
fn test_set_infer_from_literal() {
    var s = #[1, 2, 3]
    assert(s.contains(1))
    assert(!s.contains(4))
}

// ===== Channel Generic Inference =====
@test
fn test_channel_basic() {
    const ch = Channel<i64>(1)
    ch.send(42)
    var val = recvInt(ch)
    assertEqual(val, 42)
}

// ===== Container Method Return Types =====
@test
fn test_array_map_return_type() {
    var arr = [1, 2, 3]
    var doubled = arr.map(fn(x) {
        return x * 2
    })
    // doubled should be Array<int>
    assertEqual(typeName(doubled), "Array")
    assertEqual(doubled[0], 2)
}

@test
fn test_array_filter_return_type() {
    var arr = ["apple", "banana", "cherry"]
    var filtered = arr.filter(fn(s) {
        return len(s) > 5
    })
    // filtered should be Array<string>
    assertEqual(typeName(filtered), "Array")
    assertEqual(len(filtered), 2)
}

@test
fn test_array_slice_return_type() {
    var arr = [1, 2, 3, 4, 5]
    var sliced: Slice<i64> = arr[1:4]
    assertEqual(typeName(sliced), "Slice")
    assertEqual(len(sliced), 3)
}

@test
fn test_map_keys_return_type() {
    var m = #{"a": 1, "b": 2}
    var keys = m.keys()
    assertEqual(typeName(keys), "Array")
}

@test
fn test_map_values_return_type() {
    var m = #{"a": 1, "b": 2}
    var values = m.values()
    assertEqual(typeName(values), "Array")
}

// ===== Nested Generic Types =====
@test
fn test_array_of_arrays() {
    var matrix: Array<Array<i64>> = [[1, 2], [3, 4]]
    assertEqual(matrix[0][0], 1)
    assertEqual(matrix[1][1], 4)
}

@test
fn test_map_of_arrays() {
    var groups = #{"odd": [1, 3, 5], "even": [2, 4, 6]}
    assertEqual(groups.get("odd")![0], 1)
    assertEqual(groups.get("even")![2], 6)
}

// ===== Generic Function Calls =====
@test
fn test_array_concat() {
    var a = [1, 2]
    var b = [3, 4]
    var c = a.concat(b)
    assertEqual(len(c), 4)
    assertEqual(c[2], 3)
}

@test
fn test_array_indexOf() {
    var arr = ["a", "b", "c"]
    assertEqual(arr.indexOf("b"), 1)
    assertEqual(arr.indexOf("z"), -1)
}

@test
fn test_array_contains() {
    var arr = [1, 2, 3]
    assert(arr.contains(2))
    assert(!arr.contains(5))
}
