// Test: Monomorphization end-to-end
// Expected: prints "ok"
// Verifies that generic functions with explicit type args are
// monomorphized correctly: cloned, type-substituted, and call sites rewritten.

// === Basic identity monomorphization ===

fn id<T>(x: T) -> T {
    return x
}
fn pair<A, B>(a: A, b: B) -> (A, B) {
    return (a, b)
}
fn add_one<T>(x: T) -> T {
    return x + 1
}
fn wrap<T>(x: T) -> Array<T> {
    return [x]
}

@test
fn test_mono_e2e() {

    // Explicit type args trigger monomorphization
    assertEqual(id<i64>(42), 42)
    assertEqual(id<f64>(3.14), 3.14)
    assertEqual(id<string>("hello"), "hello")

    // bool shares I64 rep with int (rep-dedup)
    assertEqual(id<bool>(true), true)

    // === Multi-type-parameter monomorphization ===

    var (p1a, p1b) = pair<i64, f64>(10, 2.5)
    assertEqual(p1a, 10)
    assertEqual(p1b, 2.5)

    var (p2a, p2b) = pair<string, i64>("age", 30)
    assertEqual(p2a, "age")
    assertEqual(p2b, 30)

    // === Generic with computation ===

    assertEqual(add_one<i64>(9), 10)
    assertEqual(add_one<f64>(1.5), 2.5)

    // === Generic returning array ===

    var wi = wrap<i64>(77)
    assertEqual(wi[0], 77)
    assertEqual(len(wi), 1)

    var ws = wrap<string>("mono")
    assertEqual(ws[0], "mono")

    // === Nested generic calls ===
    assertEqual(id<i64>(add_one<i64>(99)), 100)

    // === Multiple calls to same monomorphized version ===
    assertEqual(id<i64>(1), 1)
    assertEqual(id<i64>(2), 2)
    assertEqual(id<i64>(3), 3)
}

