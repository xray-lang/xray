// 1236_prelude_name_shadowing.xr
// 测试：用户类可以复用 prelude/内建类型名，且不继承内建语义
//
// Prelude type names are ordinary identifiers, so a program may declare its
// own class with one of those names. Such a class must behave like any other
// user class: its own members resolve, and it inherits none of the builtin's
// typing, methods, or lowering. The negative half — that `r[0]` and `len(r)`
// on a shadowing class are compile errors — lives in
// tests/compile_errors/type/prelude_shadow_*.xr.

class Range {
    v: int
    constructor(v: int) { this.v = v }
    doubled() -> int { return this.v * 2 }
}

// The zero-argument form is the one the parser rewrites into a new-expr and
// both the analyzer and Xi lowering used to answer with the builtin, ignoring
// this declaration entirely.
class StringBuilder {
    tag: string
    constructor() { this.tag = "user" }
    label() -> string { return "sb:" + this.tag }
}

class Buffer {
    n: int
    constructor(n: int) { this.n = n }
}

@test
fn test_shadowing_class_uses_its_own_members() {
    var r = Range(21)
    assert_eq(r.v, 21)
    assert_eq(r.doubled(), 42)
}

@test
fn test_shadowing_class_with_builtin_constructor_path() {
    // StringBuilder has a builtin construction path; the declaration in scope
    // must win, so this builds the user class rather than the builtin.
    var b = StringBuilder()
    assert_eq(b.tag, "user")
    assert_eq(b.label(), "sb:user")
}

@test
fn test_shadowing_class_is_an_ordinary_instance() {
    var buf = Buffer(7)
    assert_eq(buf.n, 7)
}

@test
fn test_builtin_range_literal_still_works() {
    // The builtin is reached through the `a..b` literal, which no user
    // declaration shadows.
    var built_in = 1..4
    assert_eq(built_in.count(), 3)
    assert_eq(len(built_in), 3)
    assert_eq(built_in[0], 1)

    var total = 0
    for (i in 1..4) {
        total = total + i
    }
    assert_eq(total, 6)
}
