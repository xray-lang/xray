// 1203_nullable_type.xr
// Test nullable type checking and narrowing
// All types can be nullable (int?, string?, etc.)
// Nullable primitives use NaN-boxed storage to handle null.

// ===== Nullable Type Annotation =====
@test
fn test_nullable_annotation() {
    var x: i64? = null
    assertEqual(x, null)
    x = 42
    assertEqual(x, 42)
}

@test
fn test_nullable_assignment() {
    var x: i64? = 10
    assertEqual(x, 10)
    x = null
    assertEqual(x, null)
}

// ===== Null Check Narrowing =====
@test
fn test_null_check_if() {
    var x: i64? = 42
    if (x != null) {
        var y = x + 1
        assertEqual(y, 43)
    }
}

@test
fn test_null_check_else() {
    var x: i64? = null
    var result = 0
    if (x == null) {
        result = -1
    } else {
        result = x
    }
    assertEqual(result, -1)
}

@test
fn test_null_coalescing() {
    var x: i64? = null
    var y = x ?? 100
    assertEqual(y, 100)
    var z: i64? = 50
    var w = z ?? 100
    assertEqual(w, 50)
}

// ===== Optional Chaining =====
@test
fn test_optional_chain_basic() {
    class Person {
        name: string

        constructor(name: string) {
            this.name = name
        }
    }
    var p: Person? = null
    // Optional chaining should return null if p is null
    var name = p?.name
    assertEqual(name, null)
    p = Person("Alice")
    name = p?.name
    assertEqual(name, "Alice")
}

@test
fn test_optional_chain_method() {
    var arr: Array<i64>? = null
    var count = arr == null ? null : len(arr!)
    assertEqual(count, null)
    arr = [1, 2, 3]
    count = len(arr!)
    assertEqual(count, 3)
}

// ===== Function with Nullable Parameters =====
@test
fn test_nullable_param() {
    fn greet(name: string?) -> string {
        if (name == null) {
            return "Hello, Guest"
        }
        return "Hello, " + name
    }
    assertEqual(greet(null), "Hello, Guest")
    assertEqual(greet("Alice"), "Hello, Alice")
}

@test
fn test_nullable_return() {
    fn findIndex(arr: Array<i64>, target: i64) -> i64? {
        for (var i = 0; i < len(arr); i++) {
            if (arr[i] == target) {
                return i
            }
        }
        return null
    }
    var arr = [10, 20, 30]
    var idx = findIndex(arr, 20)
    assertEqual(idx, 1)
    idx = findIndex(arr, 99)
    assertEqual(idx, null)
}

// ===== Nested Null Checks =====
@test
fn test_nested_nullable() {
    class Address {
        city: string

        constructor(city: string) {
            this.city = city
        }
    }
    class Person {
        address: Address?

        constructor() {
            this.address = null
        }
    }
    var p = Person()
    // Nested optional chain
    var city = p.address?.city
    assertEqual(city, null)
    p.address = Address("Beijing")
    city = p.address?.city
    assertEqual(city, "Beijing")
}

// ===== Nullable Presence Narrowing =====
@test
fn test_nullable_presence_string() {
    var s: string? = null
    if (s) {
        assert(false)
    }
    var empty: string? = ""
    if (empty) {
        assertEqual(len(empty), 0)
    }
    var hello: string? = "hello"
    if (hello) {
        assertEqual(len(hello), 5)
    }
}

@test
fn test_nullable_presence_number() {
    var n: i64? = null
    if (n) {
        assert(false)
    }
    var zero: i64? = 0
    if (zero) {
        assertEqual(zero + 1, 1)
    }
    var forty: i64? = 42
    if (forty) {
        assertEqual(forty + 1, 43)
    }
}

// ===== Collection Nullable Elements =====
@test
fn test_array_nullable_elements() {
    var arr = [1, null, 3]
    assertEqual(arr[0], 1)
    assertEqual(arr[1], null)
    assertEqual(arr[2], 3)
}

@test
fn test_map_nullable_values() {
    var m = #{"a": 1, "b": null}
    assertEqual(m.get("a"), 1)
    assertEqual(m.get("b"), null)
    assertEqual(m.get("c"), null)
}
