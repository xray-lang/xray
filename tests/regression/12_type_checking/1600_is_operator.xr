// Test 'is' operator for runtime type checking
// Basic type checks

@test
fn test_is_operator() {
    var a = 42
    var b = 3.14
    var c = "hello"
    var d = true
    var e = null
    var arr = [1, 2, 3]
    var map = #{"a": 1}
    // Test basic types
    print(a is i64)
    // true
    print(b is f64)
    // true
    print(c is string)
    // true
    print(d is bool)
    // true
    print(e is null)
    // true
    // Test negative cases
    print(a is string)
    // false
    print(c is i64)
    // false
    // Test container types
    print(arr is Array<i64>)
    // true
    print(map is Map<string, i64>)
    // true
    print("is operator test completed")
}

