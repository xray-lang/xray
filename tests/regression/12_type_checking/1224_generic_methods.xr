// Test: Generic methods in classes
// Expected: prints "ok"
// Class with generic method

class Container<T> {
    items: Array<T>

    constructor() {
        this.items = []
    }

    ref add(item: T) {
        this.items.push(item)
    }

    wrap(item: T) -> Array<T> {
        return [item]
    }

    pair(a: T, b: T) -> (T, T) {
        return (a, b)
    }
}
class Util {
    static identity<T>(x: T) -> T {
        return x
    }

    static swap<A, B>(pair: Array<i64>) -> Array<i64> {
        return [pair[1], pair[0]]
    }
}
class Box<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    get() -> T {
        return this.value
    }

    transform<U>(f: fn(T) -> U) -> U {
        return f(this.value)
    }
}

@test
fn test_generic_methods() {

    var c = Container<i64>()
    // Test 1: Typed add method
    c.add(42)
    c.add(100)
    c.add(7)
    assertEqual(len(c.items), 3)
    assertEqual(c.items[0], 42)
    assertEqual(c.items[1], 100)
    assertEqual(c.items[2], 7)
    // Test 2: Typed wrap method
    var wrapped = c.wrap(100)
    assertEqual(wrapped[0], 100)
    var sc = Container<string>()
    var strWrapped = sc.wrap("test")
    assertEqual(strWrapped[0], "test")
    // Test 3: Pair method (multi-value return)
    var (x, y) = c.pair(10, 20)
    assertEqual(x, 10)
    assertEqual(y, 20)

    // Class with static generic method

    // Test 4: Static generic method
    assertEqual(Util.identity(42), 42)
    assertEqual(Util.identity("hello"), "hello")
    var swapped = Util.swap([1, 2])
    assertEqual(swapped[0], 2)
    assertEqual(swapped[1], 1)

    // Generic class with generic method

    // Test 5: Generic class with generic method
    var box: Box<i64> = Box<i64>(10)
    assertEqual(box.get(), 10)
    var str = box.transform(fn(n) {
        return "value: " + string(n)
    })
    assertEqual(str, "value: 10")
    var doubled = box.transform(fn(n) {
        return n * 2
    })
    assertEqual(doubled, 20)
}

