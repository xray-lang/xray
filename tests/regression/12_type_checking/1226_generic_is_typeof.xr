// Test: generic class/struct `is` checks after removing runtime type-string checks
// Covers: instanceof with generic_origin, struct generics, rep-sharing correctness

class Box<T> {
    value: T
    constructor(v: T) {
        this.value = v
    }
}

struct Pair<A, B> {
    first: A
    second: B
}

class Wrapper<T> {
    value: T
    constructor(v: T) {
        this.value = v
    }
}

@test
fn test_generic_instanceof() {
    // T1: instanceof with generic — generic_origin check
    var b = Box<i64>(42)
    assert(b is Box)

    var bs = Box<string>("hello")
    assert(bs is Box)

    // Non-Box should fail
    var w = Wrapper<i64>(1)
    assert(!(w is Box))
    assert(w is Wrapper)
}

@test
fn test_generic_runtime_behavior() {
    // T2: Generic class values preserve origin and payload behavior.
    var b = Box<i64>(42)
    assert(b is Box)
    assert_eq(b.value, 42)

    var bs = Box<string>("hello")
    assert(bs is Box)
    assert_eq(bs.value, "hello")

    // T7: Multiple type parameters
    var p = Pair<i64, string>{first: 1, second: "x"}
    assert(p is Pair)
    assert_eq(p.first, 1)
    assert_eq(p.second, "x")

    // T8: Non-generic instance
    var plain = Box(99)
    assert(plain is Box)
    assert_eq(plain.value, 99)
}

@test
fn test_struct_generic_is_typeof() {
    // T9: Struct generic `is` + value behavior
    var p1 = Pair<i64, string>{first: 1, second: "x"}
    assert(p1 is Pair)
    assert_eq(p1.first, 1)
    assert_eq(p1.second, "x")

    var p2 = Pair<f64, bool>{first: 3.14, second: true}
    assert(p2 is Pair)
    assert_eq(p2.first, 3.14)
    assert_eq(p2.second, true)

    // Non-struct should not match
    var b = Box<i64>(1)
    assert(!(b is Pair))
}

@test
fn test_rep_sharing_correctness() {
    // T10: Rep-sharing must not merge distinct reference-type instantiations
    // Wrapper<string> and Wrapper<Array> have the same slot layout (both PTR)
    // but must remain distinct classes with correct type info
    var ws = Wrapper<string>("hello")
    var wi = Wrapper<i64>(42)

    assert_eq(ws.value, "hello")
    assert_eq(wi.value, 42)

    // Both should be Wrapper via generic_origin
    assert(ws is Wrapper)
    assert(wi is Wrapper)

    // Different instantiations must not be confused
    var b = Box<i64>(1)
    assert(!(b is Wrapper))
    assert(!(ws is Box))
}
