// 1231_type_alias.xr
// Test: Type alias functionality

// ===== Basic type alias =====

type Age = i64
type Name = string

@test
fn test_basic_alias() {
    var a: Age = 25
    var n: Name = "Alice"
    assertEqual(a, 25)
    assertEqual(n, "Alice")
}

// ===== Struct type alias =====

type Point = { x: f64, y: f64 }

@test
fn test_struct_alias() {
    var p: Point = { x: 1.0, y: 2.0 }
    assertEqual(p.x, 1.0)
    assertEqual(p.y, 2.0)
}

// ===== Function type alias =====

type Mapper = fn(i64) -> i64
type Predicate = fn(i64) -> bool

@test
fn test_fn_type_alias() {
    fn apply(x: i64, f: Mapper) -> i64 {
        return f(x)
    }
    
    var result = apply(5, (n) -> n * 2)
    assertEqual(result, 10)
}

// ===== Container type alias =====

type StringList = Array<string>

@test
fn test_container_alias() {
    var names: StringList = ["Alice", "Bob", "Charlie"]
    assertEqual(len(names), 3)
    assertEqual(names[0], "Alice")
}

// ===== Optional type alias =====

type MaybeInt = i64?

@test
fn test_optional_alias() {
    var x: MaybeInt = 42
    var y: MaybeInt = null
    assertEqual(x, 42)
    assertEqual(y, null)
}

// ===== Nested type alias =====

type Callback = fn(i64) -> i64

@test
fn test_nested_alias() {
    fn applyTwice(x: i64, f: Callback) -> i64 {
        return f(f(x))
    }
    
    assertEqual(applyTwice(3, (n) -> n * 2), 12)
}

// ===== Type alias in return type =====

@test
fn test_alias_in_return() {
    fn getAge() -> Age {
        return 30
    }
    assertEqual(getAge(), 30)
}

// ===== Type alias with void function =====

type Action = fn(i64)

@test
fn test_void_fn_alias() {
    var sum = 0
    
    fn forEach(arr: Array<i64>, f: Action) {
        for (item in arr) {
            f(item)
        }
    }
    
    forEach([1, 2, 3], (x) -> {
        sum = sum + x
    })
    assertEqual(sum, 6)
}