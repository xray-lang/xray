// 1234_generic_type_alias.xr
// Test: generic type aliases are syntax-level substitutions.

type Pair<T> = { first: T, second: T }
type Mapper<T, U> = fn(T) -> U
type Vec<T> = Array<T>
type Maybe<T> = T?
type Forward<T> = Box<T>
type Box<T> = { value: T }

@test
fn test_object_alias() {
    var ints: Pair<i64> = { first: 2, second: 5 }
    var names: Pair<string> = { first: "x", second: "ray" }
    assertEqual(ints.first + ints.second, 7)
    assertEqual(names.first + names.second, "xray")
}

@test
fn test_function_alias() {
    fn apply(f: Mapper<i64, string>, value: i64) -> string {
        return f(value)
    }
    assertEqual(apply((n) -> "n=" + string(n), 9), "n=9")
}

@test
fn test_container_and_optional_alias() {
    var xs: Vec<i64> = [1, 2, 3]
    var hit: Maybe<string> = "ok"
    var miss: Maybe<string> = null
    assertEqual(len(xs), 3)
    assertEqual(hit ?? "no", "ok")
    assertEqual(miss ?? "no", "no")
}

@test
fn test_forward_generic_alias() {
    var box: Forward<i64> = { value: 42 }
    assertEqual(box.value, 42)
}
