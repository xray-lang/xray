// Test: Class monomorphization end-to-end
// Expected: prints "ok"
// Verifies that generic classes with explicit type args are
// monomorphized correctly: cloned, type-substituted, injected, and new-exprs rewritten.

// === Basic Box<T> class ===

class Box<T> {
    value: T
    constructor(v: T) {
        this.value = v
    }
    get() -> T {
        return this.value
    }
}
class Pair<K, V> {
    key: K
    val: V
    constructor(k: K, v: V) {
        this.key = k
        this.val = v
    }
}

@test
fn test_mono_class_e2e() {

    // Box<int>
    var intBox = Box<i64>(42)
    assertEqual(intBox.value, 42)
    assertEqual(intBox.get(), 42)

    // Box<float>
    var floatBox = Box<f64>(3.14)
    assertEqual(floatBox.value, 3.14)
    assertEqual(floatBox.get(), 3.14)

    // Box<string>
    var strBox = Box<string>("hello")
    assertEqual(strBox.value, "hello")
    assertEqual(strBox.get(), "hello")

    // Box<bool> — shares I64 rep with int (rep-dedup)
    var boolBox = Box<bool>(true)
    assertEqual(boolBox.value, true)

    // === Multi-type-parameter class ===

    var p1 = Pair<string, i64>("age", 30)
    assertEqual(p1.key, "age")
    assertEqual(p1.val, 30)

    var p2 = Pair<i64, f64>(1, 2.5)
    assertEqual(p2.key, 1)
    assertEqual(p2.val, 2.5)

    // === Multiple instances of same class ===
    var a = Box<i64>(1)
    var b = Box<i64>(2)
    var c = Box<i64>(3)
    assertEqual(a.get() + b.get() + c.get(), 6)

    // === Nested generic class usage ===
    var inner = Box<i64>(100)
    var outer = Box<Box<i64>>(inner)
    assertEqual(outer.get().get(), 100)

    // === Array of generic class instances ===
    var boxes = [Box<i64>(10), Box<i64>(20), Box<i64>(30)]
    assertEqual(boxes[0].get(), 10)
    assertEqual(boxes[1].get(), 20)
    assertEqual(boxes[2].get(), 30)
}

