// Regression: a closure declared inside a loop and capturing its own binding
// must not keep a chain of previous-iteration closures alive.

import runtime

fn churn_self_capture(count: int) {
    let i = 0
    while (i < count) {
        let f = fn() -> int {
            if (false) {
                return f()
            }
            return 1
        }
        i += 1
    }
}

@test
fn test_self_capture_closure_reclaimed_each_iteration() {
    runtime.collectCycles()
    let base_objects = runtime.liveObjects()
    let base_bytes = runtime.liveBytes()

    churn_self_capture(10000)

    runtime.collectCycles()
    assert_eq(runtime.liveObjects() - base_objects, 0)
    assert_eq(runtime.liveBytes() - base_bytes, 0)
}
