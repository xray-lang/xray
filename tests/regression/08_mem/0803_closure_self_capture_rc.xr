// Regression: a closure declared inside a loop and capturing its own binding
// must not keep a chain of previous-iteration closures alive.

import mem

fn churn_self_capture(count: int) {
    let i = 0
    while (i < count) {
        let f = fn() -> int {
            if (false) {
                return f()
            }
            return 1
        }
        i += 1
    }
}

@test
fn test_self_capture_closure_reclaimed_each_iteration() {
    mem.collectCycles()
    let base_objects = mem.liveObjects()
    let base_bytes = mem.liveBytes()

    churn_self_capture(10000)

    mem.collectCycles()
    assert_eq(mem.liveObjects() - base_objects, 0)
    assert_eq(mem.liveBytes() - base_bytes, 0)
}
