fn caughtUtf8Invalid(bytes: Array<u8>) -> bool {
    try {
        string.fromUtf8(bytes[:])
    } catch (e: Utf8Error) {
        return e.toString() == "Utf8Error.InvalidUtf8"
    }
    return false
}

fn caughtInvalidByteRange(s: string, start: i64, end: i64) -> bool {
    try {
        s.sliceBytes(start, end)
    } catch (e: StringSliceError) {
        return e.toString() == "StringSliceError.InvalidByteRange"
    }
    return false
}

@test
fn test_utf8_conversion_surface() {
    var ascii: Array<u8> = [104, 105]
    var unicode: Array<u8> = [104, 195, 169]
    var invalid: Array<u8> = [255]
    assertEqual(string.fromUtf8(ascii[:]), "hi")
    assertEqual(string.fromUtf8(unicode[:]), "hé")
    var caught_invalid_utf8 = false
    var invalid_utf8_error = ""
    try {
        string.fromUtf8(invalid[:])
    } catch (e: Utf8Error) {
        caught_invalid_utf8 = true
        invalid_utf8_error = e.toString()
    }
    assertEqual(caught_invalid_utf8, true)
    assertEqual(invalid_utf8_error, "Utf8Error.InvalidUtf8")
    var overlongNul: Array<u8> = [192, 128]
    var surrogateScalar: Array<u8> = [237, 160, 128]
    var outOfRangeScalar: Array<u8> = [244, 144, 128, 128]
    var invalidContinuation: Array<u8> = [226, 40, 161]
    assertEqual(caughtUtf8Invalid(overlongNul), true)
    assertEqual(caughtUtf8Invalid(surrogateScalar), true)
    assertEqual(caughtUtf8Invalid(outOfRangeScalar), true)
    assertEqual(caughtUtf8Invalid(invalidContinuation), true)
    var mixed: Array<u8> = [65, 255, 66]
    assertEqual(string.fromUtf8Lossy(mixed[:]), "A�B")
    assertEqual(string.fromUtf8Lossy(invalidContinuation[:]), "�(�")
    var truncatedFour: Array<u8> = [240, 144, 128]
    assertEqual(string.fromUtf8Lossy(truncatedFour[:]), "�")
    var validThenOutOfRange: Array<u8> = [65, 226, 130, 172, 244, 144, 128, 128, 66]
    assertEqual(string.fromUtf8Lossy(validThenOutOfRange[:]), "A€����B")
    // Unicode 17 maximal-subpart examples: non-shortest and surrogate
    // sequences replace each byte, while a still-valid truncated prefix is
    // replaced once.
    var nonShortest: Array<u8> = [192, 175, 224, 128, 191, 240, 129, 130, 65]
    assertEqual(string.fromUtf8Lossy(nonShortest[:]), "��������A")
    var surrogate: Array<u8> = [237, 160, 128, 65]
    assertEqual(string.fromUtf8Lossy(surrogate[:]), "���A")
    var truncated: Array<u8> = [225, 128, 226, 240, 145, 146, 241, 191, 65]
    assertEqual(string.fromUtf8Lossy(truncated[:]), "����A")
    assertEqual(ascii.toString(), "[104, 105]")
    assertEqual(string.fromRune('é'), "é")
    assertEqual(string.fromRune('🙂'), "🙂")
    assertEqual(string.join(["a", "β", "中"], "|"), "a|β|中")
    assertEqual(string.join(["a", "β", "中"]), "aβ中")
    var s = "Aé中"
    assertEqual(s.sliceBytes(0, 1), "A")
    assertEqual(s.sliceBytes(1, 3), "é")
    assertEqual(s.sliceBytes(3, 6), "中")
    assertEqual(caughtInvalidByteRange(s, -1, 1), true)
    assertEqual(caughtInvalidByteRange(s, 3, 2), true)
    var caught_mid_scalar = false
    var mid_scalar_error = ""
    try {
        s.sliceBytes(2, 3)
    } catch (e: StringSliceError) {
        caught_mid_scalar = true
        mid_scalar_error = e.toString()
    }
    assertEqual(caught_mid_scalar, true)
    assertEqual(mid_scalar_error, "StringSliceError.InvalidByteRange")
    var caught_oob = false
    var oob_error = ""
    try {
        s.sliceBytes(0, 7)
    } catch (e: StringSliceError) {
        caught_oob = true
        oob_error = e.toString()
    }
    assertEqual(caught_oob, true)
    assertEqual(oob_error, "StringSliceError.InvalidByteRange")
}
