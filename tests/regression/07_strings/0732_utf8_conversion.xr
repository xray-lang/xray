@test
fn test_utf8_conversion_surface() {
    var ascii: Array<byte> = [104, 105]
    var unicode: Array<byte> = [104, 195, 169]
    var invalid: Array<byte> = [255]

    assert_eq(string.fromUtf8(ascii[:]), "hi")
    assert_eq(string.fromUtf8(unicode[:]), "hé")
    var caught_invalid_utf8 = false
    try {
        string.fromUtf8(invalid[:])
    } catch (e: Utf8Error) {
        caught_invalid_utf8 = true
    }
    assert_eq(caught_invalid_utf8, true)

    var mixed: Array<byte> = [65, 255, 66]
    assert_eq(string.fromUtf8Lossy(mixed[:]), "A�B")

    // Unicode 17 maximal-subpart examples: non-shortest and surrogate
    // sequences replace each byte, while a still-valid truncated prefix is
    // replaced once.
    var nonShortest: Array<byte> = [192, 175, 224, 128, 191, 240, 129, 130, 65]
    assert_eq(string.fromUtf8Lossy(nonShortest[:]), "��������A")
    var surrogate: Array<byte> = [237, 160, 128, 65]
    assert_eq(string.fromUtf8Lossy(surrogate[:]), "���A")
    var truncated: Array<byte> = [225, 128, 226, 240, 145, 146, 241, 191, 65]
    assert_eq(string.fromUtf8Lossy(truncated[:]), "����A")
    assert_eq(ascii.toString(), "[104, 105]")

    assert_eq(string.fromRune('é'), "é")
    assert_eq(string.fromRune('🙂'), "🙂")
    assert_eq(string.join(["a", "β", "中"], "|"), "a|β|中")
    assert_eq(string.join(["a", "β", "中"]), "aβ中")

    var s = "Aé中"
    assert_eq(s.sliceBytes(0, 1), "A")
    assert_eq(s.sliceBytes(1, 3), "é")
    assert_eq(s.sliceBytes(3, 6), "中")

    var caught_mid_scalar = false
    try {
        s.sliceBytes(2, 3)
    } catch (e: StringSliceError) {
        caught_mid_scalar = true
    }
    assert_eq(caught_mid_scalar, true)

    var caught_oob = false
    try {
        s.sliceBytes(0, 7)
    } catch (e: StringSliceError) {
        caught_oob = true
    }
    assert_eq(caught_oob, true)
}
