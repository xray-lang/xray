// 0740_context_auto_select.xr
// 作者：xingleixu@gmail.com
// 
// Property 2: 上下文自动选择
// Validates: Requirements 1.2, 3.1, 3.2
//
// 测试 xr_strbuf_tmp() 根据当前执行上下文自动选择正确的缓冲区：
// - 单线程模式：使用 Isolate 的 vm_ctx.tmp_strbuf
// - 多核模式：使用 Worker 的 vm_ctx.tmp_strbuf
//
// 属性：对于任意执行上下文，xr_strbuf_tmp() 应该返回当前 vm_ctx 的缓冲区

fn context_inner_task(x: string) -> string {
    return "inner_" + string(x)
}

fn context_outer_task(x: string) -> string {
    var prefix = "outer_" + string(x) + "_"
    var t = go context_inner_task(x)
    var inner_result = await t
    return prefix + inner_result
}

// ===== 单线程模式测试 =====

@test
fn test_single_thread_context() {
    // 在主线程中执行字符串拼接
    // 应该使用 Isolate 的 vm_ctx.tmp_strbuf
    var result = "hello" + " " + "world"
    assert_eq(result, "hello world")
    
    // 多次拼接，验证缓冲区重用正确
    var s1 = "a" + "b"
    var s2 = "c" + "d"
    var s3 = "e" + "f"
    assert_eq(s1, "ab")
    assert_eq(s2, "cd")
    assert_eq(s3, "ef")
}

@test
fn test_single_thread_long_concat() {
    // 测试长字符串拼接（使用 XrStrBuf 路径）
    var base = "x".repeat(100)
    var result = base + base
    assert_eq(len(result), 200)
    
    // 验证内容正确
    assert_eq(result.runes().nth(0), 'x')
    assert_eq(result.runes().nth(199), 'x')
}

// ===== 多核模式测试 =====

@test
fn test_multicore_context_isolation() {
    // 在多个协程中并发执行字符串拼接
    // 每个协程应该使用自己 Worker 的 vm_ctx.tmp_strbuf
    
    fn concat_task(id: int) -> string {
        // 每个协程执行独立的字符串拼接
        var prefix = "task_" + string(id) + "_"
        var result = prefix + "data"
        return result
    }
    
    var n = 10
    var tasks: Array<Task> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个协程的结果独立且正确
    for (var i = 0; i < n; i++) {
        var expected = "task_" + string(i) + "_data"
        assert_eq(results[i], expected)
    }
}

@test
fn test_multicore_concurrent_long_concat() {
    // 多个协程并发执行长字符串拼接
    // 验证 Worker 间的缓冲区隔离
    
    fn long_concat_task(id: int) -> string {
        var base = "x".repeat(50)
        var result = base + "_" + string(id) + "_" + base
        return result
    }
    
    var n = 20
    var tasks: Array<Task> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go long_concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果的长度和内容
    for (var i = 0; i < n; i++) {
        var id_str = string(i)
        var expected_len = 50 + 1 + len(id_str) + 1 + 50
        assert_eq(len(results[i]), expected_len)
        
        // 验证包含正确的 id
        assert_eq(results[i].contains("_" + string(i) + "_"), true)
    }
}

@test
fn test_context_switch_correctness() {
    // 测试上下文切换时缓冲区选择的正确性
    // 主线程和协程交替执行字符串拼接
    
    var main_result = "main_" + "start"
    
    fn coro_task() -> string {
        return "coro_" + "result"
    }
    
    var t = go coro_task()
    
    // 主线程继续拼接
    main_result = main_result + "_end"
    
    var coro_result = await t
    
    assert_eq(main_result, "main_start_end")
    assert_eq(coro_result, "coro_result")
}

@test
fn test_nested_coro_context() {
    // 测试嵌套协程的上下文选择

    var t = go context_outer_task("test")
    var result = await t
    
    assert_eq(result, "outer_test_inner_test")
}

// ===== 属性测试：随机并发拼接 =====

@test
fn test_property_concurrent_concat_correctness() {
    // 属性：对于任意数量的并发协程，每个协程的字符串拼接结果应该独立且正确
    
    fn random_concat_task(seed: int) -> string {
        // 使用 seed 生成确定性的拼接序列
        var result = ""
        var count = (seed % 10) + 1
        for (var i = 0; i < count; i++) {
            result = result + "s" + string(seed) + "_" + string(i) + "_"
        }
        return result
    }
    
    // 创建多个并发任务
    var n = 50
    var tasks: Array<Task> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go random_concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果
    for (var i = 0; i < n; i++) {
        var count = (i % 10) + 1
        
        // 验证结果包含正确数量的片段
        var expected_parts = count
        var actual_parts = 0
        for (var j = 0; j < count; j++) {
            if (results[i].contains("s" + string(i) + "_" + string(j) + "_")) {
                actual_parts = actual_parts + 1
            }
        }
        assert_eq(actual_parts, expected_parts)
    }
}

@test
fn test_property_buffer_reuse_safety() {
    // 属性：缓冲区重用不应该导致数据污染
    
    fn sequential_concat_task(id: int) -> Array<string> {
        // 执行多次拼接，每次都应该得到正确结果
        var results: Array<string> = []
        for (var i = 0; i < 5; i++) {
            var s = "id" + string(id) + "_iter" + string(i)
            results.push(s)
        }
        return results
    }
    
    var n = 20
    var tasks: Array<Task> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go sequential_concat_task(i))
    }
    
    var all_results = await all tasks
    
    // 验证每个协程的每次拼接结果
    for (var i = 0; i < n; i++) {
        var results = all_results[i]
        for (var j = 0; j < 5; j++) {
            var expected = "id" + string(i) + "_iter" + string(j)
            assert_eq(results[j], expected)
        }
    }
}
