// Test chr() global function - convert integer code point to character string

// @test ASCII characters

@test
fn test_chr_function() {
    assertEqual(chr(65), "A")
    assertEqual(chr(97), "a")
    assertEqual(chr(48), "0")
    assertEqual(chr(32), " ")
    assertEqual(chr(10), "\n")
    assertEqual(chr(9), "\t")

    // @test printable ASCII range
    assertEqual(chr(33), "!")
    assertEqual(chr(64), "@")
    assertEqual(chr(90), "Z")
    assertEqual(chr(122), "z")
    assertEqual(chr(126), "~")

    // @test Unicode 2-byte characters (U+0080 - U+07FF)
    assertEqual(chr(169), "©")
    assertEqual(chr(246), "ö")

    // @test Unicode 3-byte characters (U+0800 - U+FFFF)
    assertEqual(chr(20013), "中")
    assertEqual(chr(19990), "世")
    assertEqual(chr(30028), "界")
    assertEqual(chr(8364), "€")

    // @test Unicode 4-byte characters (U+10000 - U+10FFFF)
    assertEqual(chr(128522), "😊")
    assertEqual(chr(127881), "🎉")

    // @test boundary values
    var del = chr(0x7F)
    assertEqual(del.runes().nth(0).toUInt32(), 127)
    var first_2byte = chr(0x80)
    assertEqual(first_2byte.runes().nth(0).toUInt32(), 128)

    // @test invalid code points return null
    assertEqual(typeName(chr(-1)), "null")
    assertEqual(typeName(chr(-100)), "null")
    assertEqual(typeName(chr(0xD800)), "null")
    assertEqual(typeName(chr(0xDFFF)), "null")
    assertEqual(typeName(chr(0x110000)), "null")

    // Non-integer inputs are now caught at compile time (type system prevents passing
    // wrong types to chr). Only valid int inputs are tested above.

    // @test chr + ord roundtrip
    var ch = chr(65)
    assertEqual(ch.runes().nth(0).toUInt32(), 65)

    var ch2 = chr(20013)
    assertEqual(ch2.runes().nth(0).toUInt32(), 20013)
}
