/*
** 字符串重复测试
** 作者：xingleixu@gmail.com
**
** 测试 s.repeat(n)。`"str" * n` 不是合法写法：`*` 只作用于数值。
*/

@test
fn test_string_repeat() {
    var line = "=".repeat(50)
    assert_eq(len(line), 50)

    var stars = "*".repeat(10)
    assert_eq(stars, "**********")

    // 边界情况
    var empty = "x".repeat(0)
    assert_eq(empty, "")

    var single = "abc".repeat(1)
    assert_eq(single, "abc")

    // 多字符重复
    var pattern = "ab".repeat(3)
    assert_eq(pattern, "ababab")

    // 中文字符重复
    var chinese = "好".repeat(3)
    assert_eq(chinese, "好好好")

    // 变量方式
    var s: string = "-"
    var n: int = 5
    var result = s.repeat(n)
    assert_eq(result, "-----")

    // 表达式中使用
    var header = "+" + "-".repeat(20) + "+"
    assert_eq(len(header), 22)
}
