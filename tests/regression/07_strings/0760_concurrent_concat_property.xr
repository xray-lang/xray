// 0760_concurrent_concat_property.xr
// 作者：xingleixu@gmail.com
// 
// Property 5: 并发拼接正确性
// Validates: Requirements 1.1, 5.1
//
// 属性：对于任意 N 个 Worker 并发执行字符串拼接，
//       每个 Worker 的结果应该独立且正确，不受其他 Worker 影响
//
// 测试策略：
// - 多个协程并发执行字符串拼接
// - 验证每个协程的结果独立且正确
// - 测试短字符串（栈上缓冲区）和长字符串（XrStrBuf）两种路径

// ===== Property 5: 并发拼接正确性 =====

@test
fn test_property_concurrent_concat_short() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：对于任意 N 个协程并发执行短字符串拼接，结果应独立且正确
    
    fn concat_task(id: i64) -> string {
        // 短字符串拼接（总长度 < 64）
        var a = "prefix_" + string(id)
        var b = "_suffix"
        return a + b
    }
    
    var n = 50
    var tasks: Array<Task<string>> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果独立且正确
    for (var i = 0; i < n; i++) {
        var expected = "prefix_" + string(i) + "_suffix"
        assert_eq(results[i], expected)
    }
}

@test
fn test_property_concurrent_concat_long() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：对于任意 N 个协程并发执行长字符串拼接，结果应独立且正确
    
    fn concat_task(id: i64) -> string {
        // 长字符串拼接（总长度 >= 64）
        var a = "x".repeat(40)
        var b = "_id" + string(id) + "_"
        var c = "y".repeat(40)
        return a + b + c
    }
    
    var n = 50
    var tasks: Array<Task<string>> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果独立且正确
    for (var i = 0; i < n; i++) {
        var result = results[i]
        assert_eq(result.startsWith("x".repeat(40)), true)
        assert_eq(result.contains("_id" + string(i) + "_"), true)
        assert_eq(result.endsWith("y".repeat(40)), true)
    }
}

@test
fn test_property_concurrent_concat_mixed() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：对于任意 N 个协程混合执行短/长字符串拼接，结果应独立且正确
    
    fn concat_task(id: i64) -> string {
        if (id % 2 == 0) {
            // 短字符串
            return "short_" + string(id) + "_end"
        } else {
            // 长字符串
            return "a".repeat(40) + "_long_" + string(id) + "_" + "b".repeat(40)
        }
    }
    
    var n = 40
    var tasks: Array<Task<string>> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果独立且正确
    for (var i = 0; i < n; i++) {
        if (i % 2 == 0) {
            assert_eq(results[i], "short_" + string(i) + "_end")
        } else {
            assert_eq(results[i].contains("_long_" + string(i) + "_"), true)
        }
    }
}

@test
fn test_property_concurrent_concat_isolation() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：每个协程的拼接操作应该完全隔离，不会相互干扰
    
    var chars = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]
    
    fn isolation_task(id: i64, glyph: string) -> string {
        // 使用唯一字符构建字符串
        var prefix = glyph.repeat(30)
        var middle = "_" + string(id) + "_"
        var suffix = glyph.repeat(30)
        return prefix + middle + suffix
    }
    
    var n = 30
    var tasks: Array<Task<string>> = []
    for (var i = 0; i < n; i++) {
        var glyph = chars[i % 10]
        tasks.push(go isolation_task(i, glyph))
    }
    
    var results = await all tasks
    
    // 验证每个结果只包含该协程的唯一字符
    for (var i = 0; i < n; i++) {
        var glyph = chars[i % 10]
        var result = results[i]

        // 验证前缀
        assert_eq(result.startsWith(glyph.repeat(30)), true)
        // 验证后缀
        assert_eq(result.endsWith(glyph.repeat(30)), true)
        // 验证中间包含 id
        assert_eq(result.contains("_" + string(i) + "_"), true)
    }
}

@test
fn test_property_concurrent_concat_threshold_boundary() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：在阈值边界附近的并发拼接应该正确
    
    fn boundary_task(id: i64) -> Array<i64> {
        // 根据 id 选择不同长度，跨越 64 字节阈值
        var pieceLength = 30 + (id % 10)  // 30-39
        var a = "a".repeat(pieceLength)
        var b = "b".repeat(pieceLength)
        // 总长度: 60-78，跨越 64 阈值
        var result = a + b
        return [len(result), pieceLength * 2]
    }
    
    var n = 30
    var tasks: Array<Task<Array<i64>>> = []
    for (var i = 0; i < n; i++) {
        tasks.push(go boundary_task(i))
    }
    
    var results = await all tasks
    
    // 验证每个结果长度正确
    for (var i = 0; i < n; i++) {
        var actual_len = results[i][0]
        var expected_len = results[i][1]
        assert_eq(actual_len, expected_len)
    }
}

@test
fn test_property_concurrent_concat_correctness() {
    // **Feature: string-concat-optimization, Property 5: 并发拼接正确性**
    // **Validates: Requirements 1.1, 5.1**
    // 属性：并发拼接的结果应该与串行拼接的结果一致
    
    fn concat_task(id: i64) -> string {
        var a = "hello_" + string(id)
        var b = "_world"
        return a + b
    }
    
    // 先串行计算期望结果
    var expected: Array<string> = []
    for (var i = 0; i < 30; i++) {
        expected.push("hello_" + string(i) + "_world")
    }
    
    // 并发执行
    var tasks: Array<Task<string>> = []
    for (var i = 0; i < 30; i++) {
        tasks.push(go concat_task(i))
    }
    
    var results = await all tasks
    
    // 验证并发结果与串行结果一致
    for (var i = 0; i < 30; i++) {
        assert_eq(results[i], expected[i])
    }
}
