import text

// 0700_string_basic.xr
// 作者：xingleixu@gmail.com
// 测试：字符串基础操作

// ===== 长度 =====

@test
fn test_length() {
    assertEqual(len("hello"), 5)
    assertEqual(len(""), 0)
    assertEqual(len("x"), 1)
    assertEqual(len("中文"), 2)
}

// ===== 拼接 =====

@test
fn test_concat() {
    assertEqual("hello" + " " + "world", "hello world")
    assertEqual("" + "test", "test")
    assertEqual("a" + "b" + "c", "abc")
}

@test
fn test_concat_with_numbers() {
    assertEqual("value: " + string(42), "value: 42")
    assertEqual(string(10) + " items", "10 items")
}

// ===== rune nth =====

@test
fn test_rune_nth() {
    var s = "hello"
    assertEqual(s.runes().nth(0), 'h')
    assertEqual(s.runes().nth(4), 'o')
}

// ===== rune slice =====

@test
fn test_substring() {
    var s = "hello world"
    assertEqual(s.slice(0, 5), "hello")
    assertEqual(s.slice(6, 11), "world")
    assertEqual(s.slice(0, 1), "h")
}

@test
fn test_substring_full() {
    var s = "test"
    assertEqual(s.slice(0, 4), "test")
}

@test
fn test_substring_empty() {
    var s = "test"
    assertEqual(s.slice(0, 0), "")
    assertEqual(s.slice(2, 2), "")
}

@test
fn test_substring_bounds() {
    var s = "abcdef"
    assertPanics(fn() { s.slice(-1, 3) })
    assertPanics(fn() { s.slice(2, 7) })
    assertPanics(fn() { s.slice(4, 2) })
}

// ===== indexOf =====

@test
fn test_indexOf() {
    var s = "hello world"
    assertEqual(s.indexOf("hello"), 0)
    assertEqual(s.indexOf("world"), 6)
    assertEqual(s.indexOf("o"), 4)
    assertEqual(s.indexOf("xyz"), -1)
}

@test
fn test_indexOf_empty() {
    var s = "test"
    assertEqual(s.indexOf(""), 0)
}

// ===== contains =====

@test
fn test_contains() {
    var s = "hello world"
    assertEqual(s.contains("hello"), true)
    assertEqual(s.contains("world"), true)
    assertEqual(s.contains("xyz"), false)
}

// ===== startsWith/endsWith =====

@test
fn test_startsWith() {
    var s = "hello world"
    assertEqual(s.startsWith("hello"), true)
    assertEqual(s.startsWith("world"), false)
    assertEqual(s.startsWith(""), true)
}

@test
fn test_endsWith() {
    var s = "hello world"
    assertEqual(s.endsWith("world"), true)
    assertEqual(s.endsWith("hello"), false)
    assertEqual(s.endsWith(""), true)
}

// ===== trim =====

@test
fn test_trim() {
    assertEqual(text.trim("  hello  "), "hello")
    assertEqual(text.trim("hello"), "hello")
    assertEqual(text.trim("   "), "")
    assertEqual(text.trim(""), "")
}

@test
fn test_trim_tabs_newlines() {
    assertEqual(text.trim("\t hello \n"), "hello")
}

// ===== padStart/padEnd =====

@test
fn test_pad() {
    assertEqual(text.padStart("42", 5, "0"), "00042")
    assertEqual(text.padEnd("hi", 5, "!"), "hi!!!")
    assertEqual(text.padStart("x", 3), "  x")
    assertEqual(text.padEnd("x", 3), "x  ")
    assertEqual(text.padStart("abc", 2, "0"), "abc")
    assertEqual(text.padEnd("abc", 5, ""), "abc")
    assertEqual(text.padStart("好", 6, "."), ".....好")
}

// ===== conversion =====

@test
fn test_toInt() {
    assertEqual(i64.tryParse("123"), 123)
    assertEqual(i64.tryParse(" \t\r\n-17tail"), null)
    assertEqual(i64.tryParse("+42"), 42)
    assertEqual(i64.tryParse("abc"), null)
    assertEqual(i64.tryParse("   "), null)
}

@test
fn test_toFloat() {
    assertEqual(f64.tryParse("3.5"), 3.5)
    assertEqual(f64.tryParse(" \n-3.5e2tail"), null)
    assertEqual(f64.tryParse("+0.25"), 0.25)
    assertEqual(f64.tryParse("abc"), null)
    assertEqual(f64.tryParse("\t"), null)
}

// ===== split =====

@test
fn test_split() {
    var s = "a,b,c,d"
    var parts = s.split(",")
    assertEqual(len(parts), 4)
    assertEqual(parts[0], "a")
    assertEqual(parts[3], "d")

    var edges = "a,,b,".split(",")
    assertEqual(len(edges), 4)
    assertEqual(edges[0], "a")
    assertEqual(edges[1], "")
    assertEqual(edges[2], "b")
    assertEqual(edges[3], "")

    var chars = "ab".split("")
    assertEqual(len(chars), 2)
    assertEqual(chars[0], "a")
    assertEqual(chars[1], "b")

    var empty = "".split("")
    assertEqual(len(empty), 0)
}

@test
fn test_split_spaces() {
    var s = "hello world test"
    var words = s.split(" ")
    assertEqual(len(words), 3)
}

@test
fn test_split_no_delimiter() {
    var s = "hello"
    var parts = s.split(",")
    assertEqual(len(parts), 1)
    assertEqual(parts[0], "hello")
}

// ===== toUpperCase/toLowerCase =====

@test
fn test_toUpperCase() {
    assertEqual(text.upper("hello"), "HELLO")
    assertEqual(text.upper("Hello World"), "HELLO WORLD")
    assertEqual(text.upper("Hello 世界🌍"), "HELLO 世界🌍")
    assertEqual(text.upper(""), "")
}

@test
fn test_toLowerCase() {
    assertEqual(text.lower("HELLO"), "hello")
    assertEqual(text.lower("Hello World"), "hello world")
    assertEqual(text.lower("Hello 世界🌍"), "hello 世界🌍")
    assertEqual(text.lower(""), "")
}

// ===== replace =====

@test
fn test_replace() {
    var s = "hello world"
    assertEqual(s.replace("world", "xray"), "hello xray")
    assertEqual(s.replace("xyz", "abc"), "hello world")
    assertEqual(s.replace("", "x"), "hello world")
    assertEqual("hello".replace("l", "L"), "heLlo")
    assertEqual("hello".replace("l", ""), "helo")
}

@test
fn test_replace_all() {
    var s = "a-b-c-d"
    assertEqual(s.replaceAll("-", "_"), "a_b_c_d")
    assertEqual("aaaa".replaceAll("aa", "X"), "XX")
    assertEqual("abc".replaceAll("b", ""), "ac")
    assertEqual("abc".replaceAll("", "x"), "abc")
}

// ===== repeat =====

@test
fn test_repeat() {
    assertEqual("ab".repeat(3), "ababab")
    assertEqual("x".repeat(5), "xxxxx")
    assertEqual("test".repeat(0), "")
    assertEqual("xy".repeat(-2), "")
    assertEqual("".repeat(10), "")
    assertEqual("好".repeat(2), "好好")
    assertEqual("a".repeat(1), "a")
}

// ===== 比较 =====

@test
fn test_comparison() {
    assertEqual("abc" == "abc", true)
    assertEqual("abc" != "def", true)
    assertEqual("abc" < "abd", true)
    assertEqual("abc" > "abb", true)
    assertEqual("a" < "b", true)
}

// ===== 边界条件 =====

@test
fn test_empty_string_operations() {
    var s = ""
    assertEqual(len(s), 0)
    assertEqual(text.trim(s), "")
    assertEqual(text.upper(s), "")
    assertEqual(s.contains(""), true)
}

@test
fn test_long_string() {
    var s = "a".repeat(1000)
    assertEqual(len(s), 1000)
    assertEqual(s.runes().nth(500), 'a')
}
