// 测试：字符串基础操作

// ===== 长度 =====

@test
fn test_length() {
    assert_eq(len("hello"), 5)
    assert_eq(len(""), 0)
    assert_eq(len("x"), 1)
    assert_eq(len("中文"), 2)
}

// ===== 拼接 =====

@test
fn test_concat() {
    assert_eq("hello" + " " + "world", "hello world")
    assert_eq("" + "test", "test")
    assert_eq("a" + "b" + "c", "abc")
}

@test
fn test_concat_with_numbers() {
    assert_eq("value: " + string(42), "value: 42")
    assert_eq(string(10) + " items", "10 items")
}

// ===== charAt =====

@test
fn test_charAt() {
    var s = "hello"
    assert_eq(s.charAt(0), "h")
    assert_eq(s.charAt(4), "o")
    assert_eq(s.charAt(-1), "o")
    assert_eq(s.charAt(-5), "h")
}

@test
fn test_charAt_empty() {
    var s = ""
    assert_eq(s.charAt(0), null)
}

@test
fn test_charAt_out_of_bounds() {
    var s = "abc"
    assert_eq(s.charAt(10), null)
    assert_eq(s.charAt(-4), null)
}

// ===== substring =====

@test
fn test_substring() {
    var s = "hello world"
    assert_eq(s.substring(0, 5), "hello")
    assert_eq(s.substring(6, 11), "world")
    assert_eq(s.substring(0, 1), "h")
}

@test
fn test_substring_full() {
    var s = "test"
    assert_eq(s.substring(0, 4), "test")
}

@test
fn test_substring_empty() {
    var s = "test"
    assert_eq(s.substring(0, 0), "")
    assert_eq(s.substring(2, 2), "")
}

@test
fn test_substring_bounds() {
    var s = "abcdef"
    assert_eq(s.substring(-3, 3), "abc")
    assert_eq(s.substring(2, -1), "cdef")
    assert_eq(s.substring(0, 99), "abcdef")
    assert_eq(s.substring(9, 12), "")
    assert_eq(s.substring(4, 2), "")
}

// ===== indexOf =====

@test
fn test_indexOf() {
    var s = "hello world"
    assert_eq(s.indexOf("hello"), 0)
    assert_eq(s.indexOf("world"), 6)
    assert_eq(s.indexOf("o"), 4)
    assert_eq(s.indexOf("xyz"), -1)
}

@test
fn test_indexOf_empty() {
    var s = "test"
    assert_eq(s.indexOf(""), 0)
}

// ===== contains =====

@test
fn test_contains() {
    var s = "hello world"
    assert_eq(s.contains("hello"), true)
    assert_eq(s.contains("world"), true)
    assert_eq(s.contains("xyz"), false)
}

// ===== startsWith/endsWith =====

@test
fn test_startsWith() {
    var s = "hello world"
    assert_eq(s.startsWith("hello"), true)
    assert_eq(s.startsWith("world"), false)
    assert_eq(s.startsWith(""), true)
}

@test
fn test_endsWith() {
    var s = "hello world"
    assert_eq(s.endsWith("world"), true)
    assert_eq(s.endsWith("hello"), false)
    assert_eq(s.endsWith(""), true)
}

// ===== trim =====

@test
fn test_trim() {
    assert_eq("  hello  ".trim(), "hello")
    assert_eq("hello".trim(), "hello")
    assert_eq("   ".trim(), "")
    assert_eq("".trim(), "")
}

@test
fn test_trim_tabs_newlines() {
    assert_eq("\t hello \n".trim(), "hello")
}

// ===== padStart/padEnd =====

@test
fn test_pad() {
    assert_eq("42".padStart(5, "0"), "00042")
    assert_eq("hi".padEnd(5, "!"), "hi!!!")
    assert_eq("x".padStart(3), "  x")
    assert_eq("x".padEnd(3), "x  ")
    assert_eq("abc".padStart(2, "0"), "abc")
    assert_eq("abc".padEnd(5, ""), "abc")
    assert_eq("好".padStart(6, "."), "...好")
}

// ===== conversion =====

@test
fn test_toInt() {
    assert_eq("123".toInt(), 123)
    assert_eq(" \t\r\n-17tail".toInt(), -17)
    assert_eq("+42".toInt(), 42)
    assert_eq("abc".toInt(), null)
    assert_eq("   ".toInt(), null)
}

@test
fn test_toFloat() {
    assert_eq("3.5".toFloat(), 3.5)
    assert_eq(" \n-3.5e2tail".toFloat(), -350.0)
    assert_eq("+0.25".toFloat(), 0.25)
    assert_eq("abc".toFloat(), null)
    assert_eq("\t".toFloat(), null)
}

// ===== split =====

@test
fn test_split() {
    var s = "a,b,c,d"
    var parts = s.split(",")
    assert_eq(len(parts), 4)
    assert_eq(parts[0], "a")
    assert_eq(parts[3], "d")

    var edges = "a,,b,".split(",")
    assert_eq(len(edges), 4)
    assert_eq(edges[0], "a")
    assert_eq(edges[1], "")
    assert_eq(edges[2], "b")
    assert_eq(edges[3], "")

    var chars = "ab".split("")
    assert_eq(len(chars), 2)
    assert_eq(chars[0], "a")
    assert_eq(chars[1], "b")

    var empty = "".split("")
    assert_eq(len(empty), 0)
}

@test
fn test_split_spaces() {
    var s = "hello world test"
    var words = s.split(" ")
    assert_eq(len(words), 3)
}

@test
fn test_split_no_delimiter() {
    var s = "hello"
    var parts = s.split(",")
    assert_eq(len(parts), 1)
    assert_eq(parts[0], "hello")
}

// ===== toUpperCase/toLowerCase =====

@test
fn test_toUpperCase() {
    assert_eq("hello".toUpperCase(), "HELLO")
    assert_eq("Hello World".toUpperCase(), "HELLO WORLD")
    assert_eq("Hello 世界🌍".toUpperCase(), "HELLO 世界🌍")
    assert_eq("".toUpperCase(), "")
}

@test
fn test_toLowerCase() {
    assert_eq("HELLO".toLowerCase(), "hello")
    assert_eq("Hello World".toLowerCase(), "hello world")
    assert_eq("Hello 世界🌍".toLowerCase(), "hello 世界🌍")
    assert_eq("".toLowerCase(), "")
}

// ===== replace =====

@test
fn test_replace() {
    var s = "hello world"
    assert_eq(s.replace("world", "xray"), "hello xray")
    assert_eq(s.replace("xyz", "abc"), "hello world")
    assert_eq(s.replace("", "x"), "hello world")
    assert_eq("hello".replace("l", "L"), "heLlo")
    assert_eq("hello".replace("l", ""), "helo")
}

@test
fn test_replace_all() {
    var s = "a-b-c-d"
    assert_eq(s.replaceAll("-", "_"), "a_b_c_d")
    assert_eq("aaaa".replaceAll("aa", "X"), "XX")
    assert_eq("abc".replaceAll("b", ""), "ac")
    assert_eq("abc".replaceAll("", "x"), "abc")
}

// ===== repeat =====

@test
fn test_repeat() {
    assert_eq("ab".repeat(3), "ababab")
    assert_eq("x".repeat(5), "xxxxx")
    assert_eq("test".repeat(0), "")
    assert_eq("xy".repeat(-2), "")
    assert_eq("".repeat(10), "")
    assert_eq("好".repeat(2), "好好")
    assert_eq("a".repeat(1), "a")
}

// ===== 比较 =====

@test
fn test_comparison() {
    assert_eq("abc" == "abc", true)
    assert_eq("abc" != "def", true)
    assert_eq("abc" < "abd", true)
    assert_eq("abc" > "abb", true)
    assert_eq("a" < "b", true)
}

// ===== 边界条件 =====

@test
fn test_empty_string_operations() {
    var s = ""
    assert_eq(len(s), 0)
    assert_eq(s.trim(), "")
    assert_eq(s.toUpperCase(), "")
    assert_eq(s.contains(""), true)
}

@test
fn test_long_string() {
    var s = "a".repeat(1000)
    assert_eq(len(s), 1000)
    assert_eq(s.charAt(500), "a")
}
