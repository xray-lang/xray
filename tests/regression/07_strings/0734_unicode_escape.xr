// 0734_unicode_escape.xr
// 作者：xingleixu@gmail.com
// 测试：字符串字面量 unicode 转义（\uXXXX 与 \u{...}）
// 回归背景：R2-1 —— string 转义解码器曾缺失 case 'u'，\u{...} 被静默原样输出。
// 断言全部使用绝对期望值（不依赖 VM/AOT 对拍），防止"两后端一致错"再次潜伏。

// ===== \u{...} 花括号形式（1-6 位十六进制）=====

@test
fn test_braced_ascii() {
    assertEqual("\u{48}\u{49}", "HI")
    assertEqual("\u{7A}", "z")
    assertEqual(len("\u{48}"), 1)
}

@test
fn test_braced_cjk() {
    assertEqual("\u{4E16}\u{754C}", "世界")
    assertEqual("\u{4F60}\u{597D}", "你好")
    assertEqual(len("\u{4E16}"), 1)
    assertEqual(len("\u{4E16}".bytes()), 3)
}

@test
fn test_braced_emoji() {
    assertEqual("\u{1F600}", "😀")
    assertEqual(len("\u{1F600}"), 1)
    assertEqual(len("\u{1F600}".bytes()), 4)
    assertEqual("\u{1F600}".runes().nth(0).toUInt32(), 128512)
}

@test
fn test_braced_max_codepoint() {
    // U+10FFFF 是最大合法码点；6 位十六进制上限
    assertEqual(len("\u{10FFFF}"), 1)
    assertEqual("\u{10FFFF}".runes().nth(0).toUInt32(), 1114111)
}

@test
fn test_braced_leading_zeros() {
    assertEqual("\u{000041}", "A")
    assertEqual("\u{0041}", "A")
}

// ===== \uXXXX 四位形式（规范 EscapeSeq: 'u' HexDigit{4}）=====

@test
fn test_four_digit_form() {
    assertEqual("\u4F60\u597D", "你好")
    assertEqual("\u0041\u0042\u0043", "ABC")
    assertEqual("\u20AC", "€")
    assertEqual(len("\u4E16"), 1)
}

// ===== string 与 rune 两条解析路径必须一致 =====

@test
fn test_string_rune_consistency() {
    assertEqual("\u{4E16}".runes().nth(0), '\u{4E16}')
    assertEqual("\u{1F600}".runes().nth(0), '\u{1F600}')
    assertEqual("\u{41}".runes().nth(0), 'A')
}

// ===== 模板字符串（插值路径与普通字符串共用解码器）=====

@test
fn test_template_string_unicode() {
    var n = 42
    assertEqual("n=${n} \u{2764}", "n=42 ❤")
    assertEqual("\u{48}${n}\u{49}", "H42I")
    assertEqual("前${n}\u4E16后", "前42世后")
}

@test
fn test_template_string_hex_escape() {
    // \xHH 在模板字符串中必须与普通字符串一致（曾经只在普通字符串生效）
    var n = 1
    assertEqual("a${n}\x41end", "a1Aend")
    assertEqual("\x41plain", "Aplain")
}

// ===== 与相邻文本混排 =====

@test
fn test_mixed_text() {
    assertEqual("abc\u{4E16}def", "abc世def")
    assertEqual(len("abc\u{4E16}def"), 7)
    assertEqual("\u{48}\u{49} there", "HI there")
}

// ===== raw string 不解码 =====

@test
fn test_raw_string_untouched() {
    var raw = r"\u{48}"
    assertEqual(len(raw), 6)  // \ u { 4 8 } 原样保留，共 6 个字符
    assertEqual(raw.runes().nth(0), '\\')
}

print("=== Unicode escape tests completed ===")
