// 0710_template_string.xr
// 作者：xingleixu@gmail.com
// 测试：模板字符串

// ===== 基本插值 =====

@test
fn test_basic_interpolation() {
    let name = "World"
    let s = "Hello, ${name}!"
    assert_eq(s, "Hello, World!")
}

@test
fn test_number_interpolation() {
    let x = 42
    let s = "The answer is ${x}"
    assert_eq(s, "The answer is 42")
}

// ===== 表达式插值 =====

@test
fn test_expression_interpolation() {
    let a = 10
    let b = 20
    let s = "Sum: ${a + b}"
    assert_eq(s, "Sum: 30")
}

@test
fn test_method_call_interpolation() {
    let name = "alice"
    let s = "Hello, ${name.toUpperCase()}!"
    assert_eq(s, "Hello, ALICE!")
}

// ===== 多变量插值 =====

@test
fn test_multi_variable() {
    let first = "John"
    let last = "Doe"
    let age = 30
    let s = "${first} ${last}, age ${age}"
    assert_eq(s, "John Doe, age 30")
}

// ===== 嵌套引号 =====

@test
fn test_nested_quotes() {
    let name = "test"
    let s = "He said \"Hello, ${name}\""
    assert_eq(s.includes("Hello"), true)
}

@test
fn test_same_quote_in_interpolation() {
    let s = "${"x"}"
    assert_eq(s, "x")
}

@test
fn test_same_quote_with_inner_brace() {
    let s = "value=${"a}b"}"
    assert_eq(s, "value=a}b")
}

@test
fn test_same_quote_map_index() {
    let m = #{"k": "value"}
    let s = "${m["k"]}"
    assert_eq(s, "value")
}

@test
fn test_nested_template_in_interpolation() {
    let name = "Ada"
    let s = "outer ${"inner ${name}"}"
    assert_eq(s, "outer inner Ada")
}

@test
fn test_single_quote_literal_in_interpolation() {
    let close = "${'}'}"
    let quote = "${'"'}"
    assert_eq(close, "}")
    assert_eq(quote, "\"")
}

// ===== 空插值 =====

@test
fn test_empty_template() {
    let s = ""
    assert_eq(s, "")
}

@test
fn test_no_interpolation() {
    let s = "plain text"
    assert_eq(s, "plain text")
}

// ===== 布尔和 null 插值 =====

@test
fn test_bool_interpolation() {
    let flag = true
    let s = "Flag is ${flag}"
    assert_eq(s, "Flag is true")
}

@test
fn test_null_interpolation() {
    let x = null
    let s = "Value is ${x}"
    assert_eq(s, "Value is null")
}

// ===== 多行模板 =====

@test
fn test_multiline() {
    let name = "Alice"
    let s = "Hello,
${name}!"
    assert_eq(s.includes("Alice"), true)
}
