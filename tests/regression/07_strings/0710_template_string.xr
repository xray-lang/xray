import text

// 0710_template_string.xr
// 作者：xingleixu@gmail.com
// 测试：模板字符串

// ===== 基本插值 =====

@test
fn test_basic_interpolation() {
    var name = "World"
    var s = "Hello, ${name}!"
    assertEqual(s, "Hello, World!")
}

@test
fn test_number_interpolation() {
    var x = 42
    var s = "The answer is ${x}"
    assertEqual(s, "The answer is 42")
}

// ===== 表达式插值 =====

@test
fn test_expression_interpolation() {
    var a = 10
    var b = 20
    var s = "Sum: ${a + b}"
    assertEqual(s, "Sum: 30")
}

@test
fn test_method_call_interpolation() {
    var name = "alice"
    var s = "Hello, ${text.upper(name)}!"
    assertEqual(s, "Hello, ALICE!")
}

// ===== 多变量插值 =====

@test
fn test_multi_variable() {
    var first = "John"
    var last = "Doe"
    var age = 30
    var s = "${first} ${last}, age ${age}"
    assertEqual(s, "John Doe, age 30")
}

// ===== 嵌套引号 =====

@test
fn test_nested_quotes() {
    var name = "test"
    var s = "He said \"Hello, ${name}\""
    assertEqual(s.contains("Hello"), true)
}

@test
fn test_same_quote_in_interpolation() {
    var s = "${"x"}"
    assertEqual(s, "x")
}

@test
fn test_same_quote_with_inner_brace() {
    var s = "value=${"a}b"}"
    assertEqual(s, "value=a}b")
}

@test
fn test_same_quote_map_index() {
    var m = #{"k": "value"}
    var s = "${m["k"]}"
    assertEqual(s, "value")
}

@test
fn test_nested_template_in_interpolation() {
    var name = "Ada"
    var s = "outer ${"inner ${name}"}"
    assertEqual(s, "outer inner Ada")
}

@test
fn test_single_quote_literal_in_interpolation() {
    var close = "${'}'}"
    var quote = "${'"'}"
    assertEqual(close, "}")
    assertEqual(quote, "\"")
}

// ===== 空插值 =====

@test
fn test_empty_template() {
    var s = ""
    assertEqual(s, "")
}

@test
fn test_no_interpolation() {
    var s = "plain text"
    assertEqual(s, "plain text")
}

// ===== 布尔和 null 插值 =====

@test
fn test_bool_interpolation() {
    var flag = true
    var s = "Flag is ${flag}"
    assertEqual(s, "Flag is true")
}

@test
fn test_null_interpolation() {
    var x = null
    var s = "Value is ${x}"
    assertEqual(s, "Value is null")
}

// ===== 多行模板 =====

@test
fn test_multiline() {
    var name = "Alice"
    var s = """
Hello,
${name}!
"""
    assertEqual(s.contains("Alice"), true)
}
