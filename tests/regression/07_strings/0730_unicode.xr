import text

// 0730_unicode.xr
// 作者：xingleixu@gmail.com
// 测试：Unicode 字符串支持

// ===== length 属性（字符数）=====

@test
fn test_length_ascii() {
    assertEqual(len("Hello"), 5)
    assertEqual(len(""), 0)
    assertEqual(len("x"), 1)
}

@test
fn test_length_chinese() {
    assertEqual(len("你好"), 2)
    assertEqual(len("你好世界"), 4)
    assertEqual(len("中"), 1)
}

@test
fn test_length_emoji() {
    assertEqual(len("🎉"), 1)
    assertEqual(len("🎉🎊🌍"), 3)
}

@test
fn test_length_mixed() {
    assertEqual(len("Hello世界"), 7)
    assertEqual(len("Hello世界🌍"), 8)
    assertEqual(len("a中b"), 3)
}

// ===== UTF-8 byte 数 =====

@test
fn test_byteLength_ascii() {
    assertEqual(len("Hello".bytes()), 5)
    assertEqual(len("".bytes()), 0)
}

@test
fn test_byteLength_chinese() {
    assertEqual(len("你好".bytes()), 6)       // 2 * 3 bytes
    assertEqual(len("你好世界".bytes()), 12)  // 4 * 3 bytes
}

@test
fn test_byteLength_emoji() {
    assertEqual(len("🎉".bytes()), 4)         // 4 bytes
    assertEqual(len("🎉🎊🌍".bytes()), 12)    // 3 * 4 bytes
}

@test
fn test_byteLength_mixed() {
    assertEqual(len("Hello世界🌍".bytes()), 15)  // 5 + 6 + 4
}

// ===== 显式 rune 访问 =====

@test
fn test_index_ascii() {
    var s = "Hello"
    assertEqual(s.runes().nth(0), 'H')
    assertEqual(s.runes().nth(1), 'e')
    assertEqual(s.runes().nth(4), 'o')
}

@test
fn test_index_chinese() {
    var s = "你好世界"
    assertEqual(s.runes().nth(0), '你')
    assertEqual(s.runes().nth(1), '好')
    assertEqual(s.runes().nth(3), '界')
}

@test
fn test_index_emoji() {
    var s = "🎉🎊🌍"
    assertEqual(s.runes().nth(0), '🎉')
    assertEqual(s.runes().nth(1), '🎊')
    assertEqual(s.runes().nth(2), '🌍')
}

@test
fn test_index_mixed() {
    var s = "Hello世界🌍"
    assertEqual(s.runes().nth(0), 'H')
    assertEqual(s.runes().nth(5), '世')
    assertEqual(s.runes().nth(6), '界')
    assertEqual(s.runes().nth(7), '🌍')
}

// ===== rune nth =====

@test
fn test_rune_nth_ascii() {
    assertEqual("Hello".runes().nth(0), 'H')
    assertEqual("Hello".runes().nth(4), 'o')
}

@test
fn test_rune_nth_chinese() {
    assertEqual("你好世界".runes().nth(0), '你')
    assertEqual("你好世界".runes().nth(1), '好')
}

@test
fn test_rune_nth_emoji() {
    assertEqual("🎉🎊".runes().nth(0), '🎉')
    assertEqual("🎉🎊".runes().nth(1), '🎊')
}

// ===== rune code point =====

@test
fn test_codePointAt_ascii() {
    assertEqual("A".runes().nth(0).toUInt32(), 65)
    assertEqual("Z".runes().nth(0).toUInt32(), 90)
    assertEqual("a".runes().nth(0).toUInt32(), 97)
    assertEqual("0".runes().nth(0).toUInt32(), 48)
}

@test
fn test_codePointAt_chinese() {
    assertEqual("世".runes().nth(0).toUInt32(), 19990)  // U+4E16
    assertEqual("界".runes().nth(0).toUInt32(), 30028)  // U+754C
    assertEqual("你".runes().nth(0).toUInt32(), 20320)  // U+4F60
}

@test
fn test_codePointAt_emoji() {
    assertEqual("🎉".runes().nth(0).toUInt32(), 127881)  // U+1F389
    assertEqual("🌍".runes().nth(0).toUInt32(), 127757)  // U+1F30D
}

// ===== 字符遍历 =====

@test
fn test_iterate_mixed() {
    var s = "Hi你好"
    var chars: Array<rune> = []
    for (r in s) { chars.push(r) }
    assertEqual(len(chars), 4)
    assertEqual(chars[0], 'H')
    assertEqual(chars[1], 'i')
    assertEqual(chars[2], '你')
    assertEqual(chars[3], '好')
}

// ===== 字符串比较 =====

@test
fn test_compare_chinese() {
    assertEqual("你好" == "你好", true)
    assertEqual("你好" != "世界", true)
}

@test
fn test_compare_emoji() {
    assertEqual("🎉" == "🎉", true)
    assertEqual("🎉" != "🎊", true)
}

// ===== 字符串拼接 =====

@test
fn test_concat_mixed() {
    var s = "Hello" + "世界"
    assertEqual(s, "Hello世界")
    assertEqual(len(s), 7)
}

@test
fn test_concat_emoji() {
    var s = "🎉" + "开始"
    assertEqual(s, "🎉开始")
    assertEqual(len(s), 3)
}

// ===== reverse 方法 =====

@test
fn test_reverse_unicode() {
    assertEqual(text.reverseRunes("你好🌍"), "🌍好你")
    assertEqual(text.reverseRunes("a你b"), "b你a")
}

// ===== rune 数 =====

@test
fn test_charLength() {
    assertEqual(len("Hello"), 5)
    assertEqual(len("你好世界"), 4)
    assertEqual(len("🎉🎊🌍"), 3)
}

// ===== slice（rune ordinal）=====

@test
fn test_substring_ascii() {
    assertEqual("Hello".slice(0, 5), "Hello")
    assertEqual("Hello".slice(0, 2), "He")
}

@test
fn test_substring_chinese() {
    assertEqual("你好世界".slice(0, 2), "你好")
    assertEqual("你好世界".slice(0, 1), "你")
}

print("=== Unicode tests completed ===")
