var text = "A中🙂"
assertEqual(len(text), 3)
assertEqual(len(text.bytes()), 8)

var bytes = b"A中"
assertEqual(typeName(bytes), "[byte; 4]")
assertEqual(len(bytes), 4)
assertEqual(bytes[0], 65)

var cstr = c"ok"
assertEqual(len(cstr), 3)
assertEqual(cstr[2], 0)

fn sliceLen() -> i64 {
    var buffer: Array<u8> = [1, 2, 3]
    var borrowed: Slice<u8> = buffer[0:2]
    return len(borrowed)
}

assertEqual(sliceLen(), 2)
