/* Array<byte> slice tests: Array<byte> is Array<byte>, slicing uses standard array slice */

@test
fn test_bytes_slice() {

    // ========== Basic slice ==========
    var bytes = Array<byte>(5)
    bytes[0] = 10
    bytes[1] = 20
    bytes[2] = 30
    bytes[3] = 40
    bytes[4] = 50
    print(len(bytes))  // 5

    var s1: Slice<byte> = bytes[1:4]
    print(len(s1))  // 3
    print(s1[0])      // 20
    print(s1[1])      // 30
    print(s1[2])      // 40

    // ========== Slice boundaries ==========
    var b = Array<byte>(5)
    b[0] = 1
    b[1] = 2
    b[2] = 3
    b[3] = 4
    b[4] = 5

    // Omit start
    var s3: Slice<byte> = b[:3]
    print(len(s3))  // 3

    // Omit end
    var s4: Slice<byte> = b[2:]
    print(len(s4))  // 3

    // Full slice
    var s5: Slice<byte> = b[:]
    print(len(s5))  // 5

    // Empty slice
    var s6: Slice<byte> = b[2:2]
    print(len(s6))  // 0

    // Negative bounds
    var s7: Slice<byte> = b[-4:-1]
    print(len(s7))  // 3
    print(s7[0])      // 2
    print(s7[2])      // 4

    // Slice aliases the source buffer
    s7[1] = 99
    print(b[2])       // 99

    print("Array<byte> slice tests passed!")

    // expect: 5
    // expect: 3
    // expect: 20
    // expect: 30
    // expect: 40
    // expect: 3
    // expect: 3
    // expect: 5
    // expect: 0
    // expect: 3
    // expect: 2
    // expect: 4
    // expect: 99
    // expect: Array<byte> slice tests passed!
}
