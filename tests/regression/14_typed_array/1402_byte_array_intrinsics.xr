/* Array<byte> intrinsic and capacity tests. */

@test
fn test_byte_array_intrinsics_and_capacity() {
    var b = Array<u8>(16)
    b[0] = 1
    b[1] = 2
    b[2] = 3
    b[3] = 4
    b[4] = 5
    b[5] = 6
    b[6] = 7
    b[7] = 8

    var view: Slice<u8> = b[:]
    var word32: u32 = view.load<u32>(0, Endian.LE)
    var word64: u64 = view.load<u64>(0, Endian.LE)
    assertEqual((word32 as i64), 67305985)
    assertEqual((word64 as i64), 578437695752307201)

    var dst: Array<u8> = Array.withCapacity(6)
    assertEqual(len(dst), 0)
    assertEqual(dst.capacity, 6)
    dst.appendFrom(view[1:4])
    assertEqual(len(dst), 3)
    assertEqual(dst[0], 2)
    assertEqual(dst[1], 3)
    assertEqual(dst[2], 4)

    var rep: Array<u8> = Array.withCapacity(9)
    var seed = Array<u8>(3)
    seed[0] = 65
    seed[1] = 66
    seed[2] = 67
    rep.appendFrom(seed[:])
    rep.repeatFrom(3, 6)
    assertEqual(rep[0], 65)
    assertEqual(rep[1], 66)
    assertEqual(rep[2], 67)
    assertEqual(rep[3], 65)
    assertEqual(rep[4], 66)
    assertEqual(rep[5], 67)
    assertEqual(rep[6], 65)
    assertEqual(rep[7], 66)
    assertEqual(rep[8], 67)

    var fill = Array<u8>(6)
    fill.fill(1)
    fill.fill(255, 1, 4)
    assertEqual(fill[0], 1)
    assertEqual(fill[1], 255)
    assertEqual(fill[3], 255)
    assertEqual(fill[4], 1)
    fill.fill(7, -3, -1)
    assertEqual(fill[2], 255)
    assertEqual(fill[3], 7)
    assertEqual(fill[4], 7)
    assertEqual(fill[5], 1)
    assertEqual(fill.indexOf(255), 1)
    assertEqual(fill.indexOf(42), -1)
    assertEqual(fill.contains(7), true)
    assertEqual(fill.contains(42), false)
}

@test
fn test_array_filled_constructor_and_integer_wrap() {
    var xs = Array<i64>(4, 9)
    assertEqual(len(xs), 4)
    assertEqual(xs[0], 9)
    assertEqual(xs[3], 9)

    var u: u32 = 4294967295
    var wrapped = u + 1
    assertEqual(wrapped, 0)

    var assigned_expr: u32 = 4294967295 + 1
    assertEqual(assigned_expr, 0)

    var octet: u8 = 255
    var byte_wrapped = octet + 1
    assertEqual(byte_wrapped, 0)
}
