@test
fn test_byte_receiver_effect_matrix_var_owned_const_shared() {
    var seed: Array<u8> = [1, 2, 3]

    var local = Array<u8>(0)
    local.appendFrom(seed[:])
    local.repeatFrom(3, 2)
    assertEqual(len(local), 5)
    assertEqual(local[0], 1)
    assertEqual(local[3], 1)
    assertEqual(local[4], 2)

    var localView: Slice<u8> = local[1:3]
    localView.fill(9)
    assertEqual(local[1], 9)
    assertEqual(local[2], 9)

    var ownedBuf = Array<u8>(0)
    ownedBuf.appendFrom(seed[1:3])
    ownedBuf.repeatFrom(2, 2)
    assertEqual(len(ownedBuf), 4)
    assertEqual(ownedBuf[0], 2)
    assertEqual(ownedBuf[1], 3)
    assertEqual(ownedBuf[2], 2)
    assertEqual(ownedBuf[3], 3)

    const readonlyView: Slice<u8> = seed[:]
    assertEqual(readonlyView[2], 3)
    assertEqual((readonlyView.load<u16>(0, Endian.LE) as i64), 513)

    const frozen = copy(seed)
    const sharedView: Slice<u8> = frozen[:]
    assertEqual(len(sharedView), 3)
    assertEqual(sharedView[0], 1)
    assertEqual((sharedView.load<u16>(1, Endian.LE) as i64), 770)
}
