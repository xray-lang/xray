@test
fn test_byte_receiver_effect_matrix_var_owned_const_shared() {
    var seed: Array<u8> = [1, 2, 3]

    var local = Array<u8>(0)
    local.appendFrom(seed[:])
    local.repeatFrom(3, 2)
    assert_eq(len(local), 5)
    assert_eq(local[0], 1)
    assert_eq(local[3], 1)
    assert_eq(local[4], 2)

    var localView: Slice<u8> = local[1:3]
    localView.fill(9)
    assert_eq(local[1], 9)
    assert_eq(local[2], 9)

    var ownedBuf = Array<u8>(0)
    ownedBuf.appendFrom(seed[1:3])
    ownedBuf.repeatFrom(2, 2)
    assert_eq(len(ownedBuf), 4)
    assert_eq(ownedBuf[0], 2)
    assert_eq(ownedBuf[1], 3)
    assert_eq(ownedBuf[2], 2)
    assert_eq(ownedBuf[3], 3)

    const readonlyView: Slice<u8> = seed[:]
    assert_eq(readonlyView[2], 3)
    assert_eq((readonlyView.load<u16>(0, Endian.LE) as i64), 513)

    const frozen = copy(seed)
    const sharedView: Slice<u8> = frozen[:]
    assert_eq(len(sharedView), 3)
    assert_eq(sharedView[0], 1)
    assert_eq((sharedView.load<u16>(1, Endian.LE) as i64), 770)
}
