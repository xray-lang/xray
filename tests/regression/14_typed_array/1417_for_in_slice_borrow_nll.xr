@test
fn test_for_in_local_slice_borrow_ends_before_owner_grow() {
    var bytes = Array<byte>(0)

    for (i in 0..3) {
        bytes.push(1)
        var view: Slice<byte> = bytes[:]
        var before = len(view)
        bytes.push(2)
        assert_eq(len(bytes), before + 1)
    }

    assert_eq(len(bytes), 6)
}
