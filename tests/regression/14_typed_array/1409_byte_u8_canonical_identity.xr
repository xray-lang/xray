fn takeByte(x: u8) -> i64 {
    return x as i64
}

fn takeU8(x: u8) -> i64 {
    return x as i64
}

fn firstByteArray(xs: Array<u8>) -> i64 {
    return xs[0] as i64
}

fn secondU8Array(xs: Array<u8>) -> i64 {
    return xs[1] as i64
}

fn sumByteSlice(xs: Slice<u8>) -> i64 {
    return (xs[0] as i64) + (xs[1] as i64)
}

fn sumU8Slice(xs: Slice<u8>) -> i64 {
    return (xs[0] as i64) + (xs[1] as i64)
}

@test
fn test_byte_u8_scalar_and_container_identity() {
    var u: u8 = 250
    var b: u8 = u
    var u2: u8 = b

    assertEqual(takeByte(u), 250)
    assertEqual(takeU8(b), 250)
    assertEqual(u2, 250)

    var byteArray: Array<u8> = [1, 2, 3]
    var uint8Array: Array<u8> = [4, 5, 6]
    var byteFromUint8: Array<u8> = uint8Array
    var uint8FromByte: Array<u8> = byteArray

    assertEqual(firstByteArray(uint8Array), 4)
    assertEqual(secondU8Array(byteArray), 2)
    assertEqual(byteFromUint8[2], 6)
    assertEqual(uint8FromByte[0], 1)
}

@test
fn test_byte_u8_slice_and_method_identity() {
    var byteArray: Array<u8> = [10, 20, 30]
    var uint8Array: Array<u8> = [40, 50, 60]

    var byteView: Slice<u8> = uint8Array[:]
    var uint8View: Slice<u8> = byteArray[:]

    assertEqual(sumByteSlice(uint8Array[:]), 90)
    assertEqual(sumU8Slice(byteArray[:]), 30)
    assertEqual(byteView[2], 60)
    assertEqual(uint8View[1], 20)

    var appendToByte: Array<u8> = [1]
    appendToByte.appendFrom(uint8Array[0:2])
    assertEqual(len(appendToByte), 3)
    assertEqual(appendToByte[2], 50)

    var appendToUint8: Array<u8> = [2]
    appendToUint8.appendFrom(byteArray[1:3])
    assertEqual(len(appendToUint8), 3)
    assertEqual(appendToUint8[1], 20)
    appendToUint8.repeatFrom(2, 2)
    assertEqual(len(appendToUint8), 5)
    assertEqual(appendToUint8[3], 20)
    assertEqual(appendToUint8[4], 30)
}
