/* Span/slice lifetime stress (task 143/144 M2).
 *
 * Exercises the refcounted storage block under harder conditions than 1403:
 *   - a slice escapes its source's scope (the source local is dropped),
 *   - the source grows (forks the storage) AFTER the slice is taken,
 *   - many slices share one source across repeated growth,
 *   - a slice of a slice (nested view) survives source growth.
 * All must stay valid (snapshot) with no use-after-free under ASan, for both POD
 * (Array<int>) and ANY (object) element buffers.
 */

fn escaped_int_slice() -> Span<int> {
    let src = Array<int>(4, 0)
    src[0] = 10
    src[1] = 20
    src[2] = 30
    src[3] = 40
    for (let i = 0; i < 64; i++) {
        src.push(100 + i)
    }
    let s = src[1:4]
    // Grow the source AFTER slicing (forks storage); then `src` goes out of scope.
    for (let i = 0; i < 4096; i++) {
        src.push(i)
    }
    return s
}

fn escaped_str_slice() -> Span<string> {
    let src = ["a", "b", "c", "d"]
    for (let i = 0; i < 64; i++) {
        src.push("x")
    }
    let s = src[1:4]
    for (let i = 0; i < 4096; i++) {
        src.push("y")
    }
    return s
}

@test
fn test_span_outlives_source_scope_pod() {
    let v = escaped_int_slice()
    print(v[0])  // 20
    print(v[1])  // 30
    print(v[2])  // 40
    print("escaped POD span valid")

    // expect: 20
    // expect: 30
    // expect: 40
    // expect: escaped POD span valid
}

@test
fn test_span_outlives_source_scope_any() {
    let v = escaped_str_slice()
    print(v[0])  // b
    print(v[1])  // c
    print(v[2])  // d
    print("escaped ANY span valid")

    // expect: b
    // expect: c
    // expect: d
    // expect: escaped ANY span valid
}

@test
fn test_many_slices_survive_repeated_growth() {
    let src = Array<int>(8, 0)
    for (let i = 0; i < 8; i++) {
        src[i] = i * 10
    }
    for (let i = 0; i < 32; i++) {
        src.push(i)
    }

    // Three overlapping slices sharing the same storage.
    let s1 = src[0:3]
    let s2 = src[2:6]
    let s3 = src[1:4]

    // Repeated growth -> repeated forks; every existing slice must stay valid.
    for (let r = 0; r < 8; r++) {
        for (let i = 0; i < 1024; i++) {
            src.push(r * 1024 + i)
        }
    }

    print(s1[0])  // 0
    print(s2[0])  // 20
    print(s3[2])  // 30
    print("many slices survived growth")

    // expect: 0
    // expect: 20
    // expect: 30
    // expect: many slices survived growth
}

@test
fn test_nested_slice_survives_growth() {
    let src = Array<int>(4, 0)
    src[0] = 5
    src[1] = 6
    src[2] = 7
    src[3] = 8
    for (let i = 0; i < 64; i++) {
        src.push(i)
    }

    let outer = src[1:4]   // [6, 7, 8]
    let inner = outer[1:3] // [7, 8]

    for (let i = 0; i < 4096; i++) {
        src.push(i)
    }

    print(inner[0])  // 7
    print(inner[1])  // 8
    print("nested slice survived growth")

    // expect: 7
    // expect: 8
    // expect: nested slice survived growth
}
