/* Array<byte> intrinsic and capacity tests. */

@test
fn test_bytes_intrinsics_and_capacity() {
    var b = Array<byte>(16)
    b[0] = 1
    b[1] = 2
    b[2] = 3
    b[3] = 4
    b[4] = 5
    b[5] = 6
    b[6] = 7
    b[7] = 8

    var view: Slice<byte> = b[:]
    var u32: uint32 = view.load<uint32>(0, Endian.LE)
    var u64: uint64 = view.load<uint64>(0, Endian.LE)
    assert_eq(int(u32), 67305985)
    assert_eq(int(u64), 578437695752307201)

    var dst: Array<byte> = Array.withCapacity(6)
    assert_eq(len(dst), 0)
    assert_eq(dst.capacity, 6)
    dst.appendFrom(view[1:4])
    assert_eq(len(dst), 3)
    assert_eq(dst[0], 2)
    assert_eq(dst[1], 3)
    assert_eq(dst[2], 4)

    var rep: Array<byte> = Array.withCapacity(9)
    var seed = Array<byte>(3)
    seed[0] = 65
    seed[1] = 66
    seed[2] = 67
    rep.appendFrom(seed[:])
    rep.repeatFrom(3, 6)
    assert_eq(rep[0], 65)
    assert_eq(rep[1], 66)
    assert_eq(rep[2], 67)
    assert_eq(rep[3], 65)
    assert_eq(rep[4], 66)
    assert_eq(rep[5], 67)
    assert_eq(rep[6], 65)
    assert_eq(rep[7], 66)
    assert_eq(rep[8], 67)

    var fill = Array<byte>(6)
    fill.fill(1)
    fill.fill(255, 1, 4)
    assert_eq(fill[0], 1)
    assert_eq(fill[1], 255)
    assert_eq(fill[3], 255)
    assert_eq(fill[4], 1)
    fill.fill(7, -3, -1)
    assert_eq(fill[2], 255)
    assert_eq(fill[3], 7)
    assert_eq(fill[4], 7)
    assert_eq(fill[5], 1)
    assert_eq(fill.indexOf(255), 1)
    assert_eq(fill.indexOf(42), -1)
    assert_eq(fill.contains(7), true)
    assert_eq(fill.contains(42), false)
}

@test
fn test_array_filled_constructor_and_integer_wrap() {
    var xs = Array<int>(4, 9)
    assert_eq(len(xs), 4)
    assert_eq(xs[0], 9)
    assert_eq(xs[3], 9)

    var u: uint32 = 4294967295
    var wrapped = u + 1
    assert_eq(wrapped, 0)

    var assigned_expr: uint32 = 4294967295 + 1
    assert_eq(assigned_expr, 0)

    var octet: byte = 255
    var byte_wrapped = octet + 1
    assert_eq(byte_wrapped, 0)
}
