/* Bytes intrinsic and capacity tests. */

@test
fn test_bytes_intrinsics_and_capacity() {
    let b = Bytes(16)
    b[0] = 1
    b[1] = 2
    b[2] = 3
    b[3] = 4
    b[4] = 5
    b[5] = 6
    b[6] = 7
    b[7] = 8

    let view: ByteSpan = b
    let u32: uint32 = view.loadLE<uint32>(0)
    let u64: uint64 = view.loadLE<uint64>(0)
    assert_eq(int(u32), 67305985)
    assert_eq(int(u64), 578437695752307201)

    let dst = Bytes.withCapacity(6)
    assert_eq(dst.length, 0)
    assert_eq(dst.capacity, 6)
    unsafe {
        dst.appendFromUnchecked(view, 1, 3)
    }
    assert_eq(dst.length, 3)
    assert_eq(dst[0], 2)
    assert_eq(dst[1], 3)
    assert_eq(dst[2], 4)

    let rep = Bytes.withCapacity(9)
    let seed = Bytes(3)
    seed[0] = 65
    seed[1] = 66
    seed[2] = 67
    unsafe {
        rep.appendFromUnchecked(seed, 0, 3)
        rep.repeatFromUnchecked(3, 6)
    }
    assert_eq(rep[0], 65)
    assert_eq(rep[1], 66)
    assert_eq(rep[2], 67)
    assert_eq(rep[3], 65)
    assert_eq(rep[4], 66)
    assert_eq(rep[5], 67)
    assert_eq(rep[6], 65)
    assert_eq(rep[7], 66)
    assert_eq(rep[8], 67)

    let fill = Bytes(6)
    fill.fill(1)
    fill.fill(255, 1, 4)
    assert_eq(fill[0], 1)
    assert_eq(fill[1], 255)
    assert_eq(fill[3], 255)
    assert_eq(fill[4], 1)
    fill.fill(7, -3, -1)
    assert_eq(fill[2], 255)
    assert_eq(fill[3], 7)
    assert_eq(fill[4], 7)
    assert_eq(fill[5], 1)
    assert_eq(fill.indexOf(255), 1)
    assert_eq(fill.indexOf(42), -1)
    assert_eq(fill.includes(7), true)
    assert_eq(fill.includes(42), false)
}

@test
fn test_array_filled_constructor_and_integer_wrap() {
    let xs = Array<int>(4, 9)
    assert_eq(xs.length, 4)
    assert_eq(xs[0], 9)
    assert_eq(xs[3], 9)

    let u: uint32 = 4294967295
    let wrapped = u + 1
    assert_eq(wrapped, 0)

    let assigned_expr: uint32 = 4294967295 + 1
    assert_eq(assigned_expr, 0)

    let byte: uint8 = 255
    let byte_wrapped = byte + 1
    assert_eq(byte_wrapped, 0)
}
