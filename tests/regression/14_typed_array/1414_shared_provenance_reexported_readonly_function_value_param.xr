import { readFirst } from "../../fixtures/shared_mutation_reexport"
import "../../fixtures/shared_mutation_reexport_all" as mut

@test
fn test_shared_provenance_reexported_readonly_function_value_param() {
    const bytes = Array<u8>(2, 5)
    const view: Slice<u8> = bytes[:]
    const f = readFirst
    assertEqual(f(view), 7)
}

@test
fn test_shared_provenance_star_reexported_readonly_function_value_param() {
    const bytes = Array<u8>(3, 6)
    const view: Slice<u8> = bytes[:]
    const f = mut.readFirst
    assertEqual(f(view), 9)
}
