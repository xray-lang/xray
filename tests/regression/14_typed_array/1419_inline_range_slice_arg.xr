/* Inline range-slice expressions handed straight to a call argument must lower
 * to the same Slice representation a named `Slice<byte>` binding produces. A
 * native builtin method argument (string.fromUtf8Lossy) offers no Slice target
 * type, so the analyzer leaves the slice node type unresolved; lowering recovers
 * Slice<T> from the source element type. Without that, a bounded inline slice
 * (arr[a:b] / arr[:b]) crashed the bytecode emitter with an internal error,
 * while full slices (arr[:]) and named `Slice<byte>` bindings were unaffected. */

fn sumSlice(s: Slice<byte>) -> int {
    var total = 0
    var i = 0
    while (i < len(s)) {
        total += s[i]
        i += 1
    }
    return total
}

@test
fn test_inline_bounded_range_slice_native_method_arg() {
    var raw: Array<byte> = [104, 105, 33, 65, 66] // h i ! A B

    // arr[a:b] inline as a native builtin method argument
    print(string.fromUtf8Lossy(raw[0:2])) // hi

    // arr[:b] inline (omitted start)
    print(string.fromUtf8Lossy(raw[:3])) // hi!

    // arr[a:] inline (omitted end)
    print(string.fromUtf8Lossy(raw[3:])) // AB

    // expect: hi
    // expect: hi!
    // expect: AB
}

@test
fn test_inline_range_slice_arg_in_if() {
    var raw: Array<byte> = [104, 105]
    var end = 2
    if (end >= 0) {
        print(string.fromUtf8Lossy(raw[0:end])) // hi
    }
    // expect: hi
}

@test
fn test_inline_range_slice_arg_in_while() {
    var raw: Array<byte> = [104, 105, 33] // h i !
    var i = 1
    while (i <= 3) {
        print(string.fromUtf8Lossy(raw[0:i]))
        i += 1
    }
    // expect: h
    // expect: hi
    // expect: hi!
}

@test
fn test_inline_range_slice_user_fn_arg_unaffected() {
    // A user function argument already resolves the Slice target; this guards
    // that the lowering recovery did not disturb the pre-existing path.
    var raw: Array<byte> = [1, 2, 3, 4]
    print(sumSlice(raw[1:3])) // 2 + 3 = 5
    // expect: 5
}
