/* Span<T> / ByteSpan static surface.
 *
 * Span is a bounded view over contiguous storage. It supports length/size,
 * indexing, indexed writes, slicing, and for-in; owner-only Array methods
 * are covered by compile_errors/type/span_owner_method.xr.
 */
@test
fn test_span_static_surface() {
    let a = Array<int>(4, 0)
    a[0] = 10
    a[1] = 20
    a[2] = 30
    a[3] = 40
    let s: Span<int> = a[1:4]
    assert_eq(s.length, 3)
    assert_eq(s.size, 3)
    assert_eq(s[0], 20)
    s[1] = 99
    assert_eq(s[1], 99)
    let whole: Span<int> = a.span()
    assert_eq(whole.length, 4)
    assert_eq(whole[2], 99)
    whole[0] = 11
    assert_eq(a[0], 11)
    let nested: Span<int> = s[1:3]
    assert_eq(nested.length, 2)
    assert_eq(nested[0], 99)
    let sum = 0
    for (x in s) {
        sum = sum + x
    }
    assert_eq(sum, 159)
    print("span static surface passed")
}

@test
fn test_bytespan_alias() {
    let src = Bytes(4)
    src[0] = 1
    src[1] = 2
    src[2] = 3
    src[3] = 4
    let s: ByteSpan = src[1:3]
    assert_eq(s.length, 2)
    assert_eq(s[0], 2)
    print("bytespan alias passed")
}

@test
fn test_string_bytes_view() {
    let text = "ABCD"
    let bytes: ByteSpan = text.bytes()
    assert_eq(bytes.length, 4)
    assert_eq(bytes.size, 4)
    assert_eq(bytes[0], 65)
    assert_eq(bytes[1], 66)
    let mid: ByteSpan = bytes[1:3]
    assert_eq(mid.length, 2)
    assert_eq(mid[0], 66)
    assert_eq(mid[1], 67)
    print("string bytes view passed")
}
