/* Slice<T> / Slice<byte> static surface.
 *
 * Slice is a bounded view over contiguous storage. It supports length/size,
 * indexing, indexed writes, slicing, and for-in; owner-only Array methods
 * are covered by compile_errors/type/span_owner_method.xr.
 */
@test
fn test_span_static_surface() {
    var a = Array<int>(4, 0)
    a[0] = 10
    a[1] = 20
    a[2] = 30
    a[3] = 40
    var s: Slice<int> = a[1:4]
    assert_eq(len(s), 3)
    assert_eq(len(s), 3)
    assert_eq(s[0], 20)
    s[1] = 99
    assert_eq(s[1], 99)
    var whole: Slice<int> = a[:]
    assert_eq(len(whole), 4)
    assert_eq(whole[2], 99)
    whole[0] = 11
    assert_eq(a[0], 11)
    var nested: Slice<int> = s[1:3]
    assert_eq(len(nested), 2)
    assert_eq(nested[0], 99)
    var sum = 0
    for (x in s) {
        sum = sum + x
    }
    assert_eq(sum, 159)
    print("span static surface passed")
}

@test
fn test_byte_slice_alias() {
    var src = Array<byte>(4)
    src[0] = 1
    src[1] = 2
    src[2] = 3
    src[3] = 4
    var s: Slice<byte> = src[1:3]
    assert_eq(len(s), 2)
    assert_eq(s[0], 2)
    print("byte slice alias passed")
}

@test
fn test_string_byte_slice_view() {
    var text = "ABCD"
    var bytes: Slice<byte> = text.bytes()
    assert_eq(len(bytes), 4)
    assert_eq(len(bytes), 4)
    assert_eq(bytes[0], 65)
    assert_eq(bytes[1], 66)
    var mid: Slice<byte> = bytes[1:3]
    assert_eq(len(mid), 2)
    assert_eq(mid[0], 66)
    assert_eq(mid[1], 67)
    print("string bytes view passed")
}
