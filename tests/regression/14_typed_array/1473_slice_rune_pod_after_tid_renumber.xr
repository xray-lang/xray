// 1473_slice_rune_pod_after_tid_renumber.xr
//
// REGRESSION: 任务 247 阶段 B 删除 XR_TID_WEAKMAP / XR_TID_WEAKSET 后，
//             XR_TID_RUNE 从 45 前移到 43，而 src/shared/xr_elem_type.h 里
//             `xr_tid_to_elem_type` 手抄了 `case 45`。它不再匹配，于是每个
//             Slice<rune> 静默降级为 XR_ELEM_ANY —— Slice.fill 把自己的
//             接收者判成"不是 POD Slice"并 panic。
//
// FAIL_AT:    阶段 B 之后、编号修正之前。**构建全绿**，只有差分测试抓到
//             （VM panic / AOT 正常）。这正是手抄常量的代价。
// PASS_AT:    编号修正 + xtype_names.h 里的 _Static_assert 把它钉死，
//             此后任何重新编号都是编译错误而不是运行期降级。
//
// Slice<bool> 和 Slice<u16> 一并覆盖：它们的 TID 在 43 之前，不受移位影响，
// 是"只有 rune 坏了"这一判断的对照。

fn main() {
    var chars = Array<rune>(3, 'a')
    var charSlice: Slice<rune> = chars[:]
    charSlice.fill('z')
    print(chars[0].toString() + chars[1].toString() + chars[2].toString())

    var window: Slice<rune> = chars[1:3]
    window.fill('q')
    print(chars[0].toString() + chars[1].toString() + chars[2].toString())

    // 对照：TID 在移位点之前的元素类型
    var flags = Array<bool>(3, false)
    var flagSlice: Slice<bool> = flags[:]
    flagSlice.fill(true)
    print(flags[0])

    var shorts = Array<u16>(3, 7)
    var shortSlice: Slice<u16> = shorts[:]
    shortSlice.fill(0)
    print(int(shorts[0]) + int(shorts[1]) + int(shorts[2]))
}

main()
