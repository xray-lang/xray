// 0901_adt_enum.xr - ADT enum (payload + non-payload variants) matching.
//
// Regression: an ADT enum (any variant carries a payload) represents EVERY
// variant, including the non-payload ones, as a tagged aggregate. Pattern
// matching reads that tag uniformly, so a bare non-payload variant
// (`Shape.Point`) must match its own arm and fall through a wildcard correctly,
// whether or not the match also binds a payload arm. This previously crashed
// under native AOT (array-tag read of an enum singleton) while returning the
// right value under the VM.

enum Shape {
    Circle { radius: i64 },
    Square { side: i64 },
    Point,
    Unknown
}

enum Tree {
    Leaf { value: i64 },
    Branch { value: i64 },
    Empty
}

fn describe(s: Shape) -> string {
    return match (s) {
        Shape.Circle { radius: r } -> "circle:" + string(r)
        Shape.Square { side } -> "square:" + string(side)
        Shape.Point -> "point"
        Shape.Unknown -> "unknown"
    }
}

fn radius_or(s: Shape) -> i64 {
    return match (s) {
        Shape.Circle { radius: r } -> r
        Shape.Point -> -1
        _ -> -2
    }
}

@test
fn test_adt_enum() {
    // Payload and non-payload variants describe correctly.
    assertEqual(describe(Shape.Circle { radius: 3 }), "circle:3")
    assertEqual(describe(Shape.Square { side: 4 }), "square:4")
    assertEqual(describe(Shape.Point), "point")
    assertEqual(describe(Shape.Unknown), "unknown")

    // Cold enum metadata still works for ADT aggregates.
    assertEqual(Shape.Circle { radius: 3 }.name, "Circle")
    assertEqual(Shape.Circle { radius: 3 }.ordinal, 0)
    assertEqual(Shape.Circle { radius: 3 }.toString(), "Shape.Circle(3)")
    assertEqual(Shape.Point.name, "Point")
    assertEqual(Shape.Point.ordinal, 2)
    assertEqual(Shape.Point.toString(), "Shape.Point")

    // Non-payload variant matched alongside a payload arm, then wildcard.
    assertEqual(radius_or(Shape.Circle { radius: 9 }), 9)
    assertEqual(radius_or(Shape.Point), -1)
    assertEqual(radius_or(Shape.Square { side: 2 }), -2)
    assertEqual(radius_or(Shape.Unknown), -2)

    // Bare non-payload variant bound to a local, then matched.
    var p = Shape.Point
    var is_point = match (p) {
        Shape.Point -> true
        _ -> false
    }
    assertEqual(is_point, true)

    // Non-payload variant must NOT match a payload arm of the same ordinal
    // family — Circle(0) is ordinal 0, Point is ordinal 2.
    var c0 = Shape.Circle { radius: 0 }
    var matched_circle = match (c0) {
        Shape.Circle { radius: _ } -> true
        _ -> false
    }
    assertEqual(matched_circle, true)

    // ADT variants inside an array keep their instance representation.
    var shapes = [Shape.Circle { radius: 1 }, Shape.Point, Shape.Square { side: 5 }, Shape.Unknown]
    assertEqual(describe(shapes[0]), "circle:1")
    assertEqual(describe(shapes[1]), "point")
    assertEqual(describe(shapes[2]), "square:5")
    assertEqual(describe(shapes[3]), "unknown")

    // A second ADT enum with a leading non-payload arm.
    var t = Tree.Empty
    var td = match (t) {
        Tree.Empty -> 0
        Tree.Leaf { value: v } -> v
        Tree.Branch { value: v } -> v * 10
    }
    assertEqual(td, 0)
    var leaf = Tree.Leaf { value: 7 }
    var ld = match (leaf) {
        Tree.Empty -> 0
        Tree.Leaf { value: v } -> v
        Tree.Branch { value: v } -> v * 10
    }
    assertEqual(ld, 7)
}
