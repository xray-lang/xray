// 0912_typeof_builtin.xr
// 作者：xingleixu@gmail.com
// 测试：typeName() builtin —— 返回运行时类型的字符串名

// ===== 基本类型 =====

@test
fn test_typeof_typeid_constants() {
    assertEqual(typeOf(42), Type.i64)
    assertEqual(typeOf(3.14), Type.f64)
    assertEqual(typeOf("hello"), Type.string)
    assertEqual(typeOf(true), Type.bool)
    assertEqual(typeOf(null), Type.null)
    assertEqual(typeOf([1, 2, 3]), Type.Array)
    assertEqual(typeOf(#{"a": 1}), Type.Map)
    assertEqual(typeOf(#[1, 2, 3]), Type.Set)
}

@test
fn test_typeof_int() {
    assertEqual(typeName(42), "i64")
    assertEqual(typeName(0), "i64")
    assertEqual(typeName(-100), "i64")
}

@test
fn test_typeof_float() {
    assertEqual(typeName(3.14), "f64")
    assertEqual(typeName(0.0), "f64")
}

@test
fn test_typeof_string() {
    assertEqual(typeName("hello"), "string")
    assertEqual(typeName(""), "string")
}

@test
fn test_typeof_bool() {
    assertEqual(typeName(true), "bool")
    assertEqual(typeName(false), "bool")
}

@test
fn test_typeof_null() {
    var n: i64? = null
    assertEqual(typeName(n), "null")
}

// ===== 容器类型 =====

@test
fn test_typeof_array() {
    var a = [1, 2, 3]
    assertEqual(typeName(a), "Array")
}

@test
fn test_typeof_map() {
    var m = #{"a": 1}
    assertEqual(typeName(m), "Map")
}

@test
fn test_typeof_set() {
    var s = #[1, 2, 3]
    assertEqual(typeName(s), "Set")
}

// ===== 实例 =====

class Point {
    x: i64
    y: i64
    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }
}

@test
fn test_typeof_instance() {
    var p = Point(3, 4)
    // For class instances typeName() returns the class name.
    assertEqual(typeName(p), "Point")
}

// ===== 寄存器使用 =====

@test
fn test_typeof_does_not_corrupt_argument() {
    // typeName() reads R[B]; verify the source register is intact afterwards.
    var v = 42
    var n = typeName(v)
    assertEqual(n, "i64")
    assertEqual(v, 42)
}

@test
fn test_typeof_in_expression() {
    var s = "hello"
    var result = typeName(s) + ":" + s
    assertEqual(result, "string:hello")
}

@test
fn test_type_name_static_type_argument() {
    assertEqual(typeName<i64>(), "i64")
    assertEqual(typeName<f64>(), "f64")
    assertEqual(typeName<u8>(), "u8")
    assertEqual(typeName<i8>(), "i8")
    assertEqual(typeName<u64>(), "u64")
    assertEqual(typeName<f32>(), "f32")
    assertEqual(typeName<string>(), "string")
    assertEqual(typeName<Array<i64>>(), "Array<i64>")
    assertEqual(Type.i64, Type.i64)
    assertEqual(Type.f64, Type.f64)
    assertEqual(Type.u8, Type.u8)
}
