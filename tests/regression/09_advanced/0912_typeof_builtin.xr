// 0912_typeof_builtin.xr
// 作者：xingleixu@gmail.com
// 测试：typename() builtin —— 返回运行时类型的字符串名

// ===== 基本类型 =====

@test
fn test_typeof_typeid_constants() {
    assert_eq(typeof(42), Type.int)
    assert_eq(typeof(3.14), Type.float)
    assert_eq(typeof("hello"), Type.string)
    assert_eq(typeof(true), Type.bool)
    assert_eq(typeof(null), Type.null)
    assert_eq(typeof([1, 2, 3]), Type.Array)
    assert_eq(typeof(#{"a": 1}), Type.Map)
    assert_eq(typeof(#[1, 2, 3]), Type.Set)
}

@test
fn test_typeof_int() {
    assert_eq(typename(42), "int")
    assert_eq(typename(0), "int")
    assert_eq(typename(-100), "int")
}

@test
fn test_typeof_float() {
    assert_eq(typename(3.14), "float")
    assert_eq(typename(0.0), "float")
}

@test
fn test_typeof_string() {
    assert_eq(typename("hello"), "string")
    assert_eq(typename(""), "string")
}

@test
fn test_typeof_bool() {
    assert_eq(typename(true), "bool")
    assert_eq(typename(false), "bool")
}

@test
fn test_typeof_null() {
    var n: int? = null
    assert_eq(typename(n), "null")
}

// ===== 容器类型 =====

@test
fn test_typeof_array() {
    var a = [1, 2, 3]
    assert_eq(typename(a), "Array")
}

@test
fn test_typeof_map() {
    var m = #{"a": 1}
    assert_eq(typename(m), "Map")
}

@test
fn test_typeof_set() {
    var s = #[1, 2, 3]
    assert_eq(typename(s), "Set")
}

// ===== 实例 =====

class Point {
    x: int
    y: int
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

@test
fn test_typeof_instance() {
    var p = Point(3, 4)
    // For class instances typename() returns the class name.
    assert_eq(typename(p), "Point")
}

// ===== 寄存器使用 =====

@test
fn test_typeof_does_not_corrupt_argument() {
    // typename() reads R[B]; verify the source register is intact afterwards.
    var v = 42
    var n = typename(v)
    assert_eq(n, "int")
    assert_eq(v, 42)
}

@test
fn test_typeof_in_expression() {
    var s = "hello"
    var result = typename(s) + ":" + s
    assert_eq(result, "string:hello")
}
