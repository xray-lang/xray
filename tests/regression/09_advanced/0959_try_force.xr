/*
** PanicInfo propagation via try-catch (migrated from try!).
** When a called function throws, the exception propagates naturally.
** The surrounding try-catch can still handle it.
*/

enum ForceErr { Msg(string) }

fn maybeFailInt(should_throw: bool) -> int {
    if (should_throw) {
        throw ForceErr.Msg("force-try violation")
    }
    return 42
}

fn maybeFailJson(should_throw: bool) -> Json {
    if (should_throw) {
        throw ForceErr.Msg("deeper failure")
    }
    return { id: 99, name: "Bob" }
}

@test
fn test_propagation_success_int() {
    print("1. success returns the value unchanged")
    let a = maybeFailInt(false)
    assert_eq(a, 42)
    print("   PASS")
}

@test
fn test_propagation_success_json() {
    print("2. success — composite type")
    let obj = maybeFailJson(false)
    assert_eq(obj.id, 99)
    assert_eq(obj.name, "Bob")
    print("   PASS")
}

@test
fn test_propagation_throw_caught() {
    print("3. throw propagates and is caught by surrounding try-catch")
    let saw_catch = false
    try {
        let x = maybeFailInt(true)
        print("should not reach:", x)
    } catch (e) {
        saw_catch = true
        match (e) { ForceErr.Msg(s) -> { assert_eq(s, "force-try violation") } }
    }
    assert_eq(saw_catch, true)
    print("   PASS")
}

@test
fn test_propagation_nested_throw() {
    print("4. nested call propagates the inner exception")
    fn helper() -> Json {
        return maybeFailJson(true)
    }
    let saw_catch = false
    try {
        let result = helper()
        print("should not reach:", result)
    } catch (e) {
        saw_catch = true
        match (e) { ForceErr.Msg(s) -> { assert_eq(s, "deeper failure") } }
    }
    assert_eq(saw_catch, true)
    print("   PASS")
}

@test
fn test_propagation_keeps_value_type() {
    print("5. value type is preserved (no widening)")
    let v = maybeFailInt(false)
    let next = v + 1
    assert_eq(next, 43)
    print("   PASS")
}
