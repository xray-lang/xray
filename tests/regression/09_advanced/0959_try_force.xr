/*
** PanicInfo propagation via try-catch (migrated from try!).
** When a called function throws, the exception propagates naturally.
** The surrounding try-catch can still handle it.
*/

enum ForceErr { Msg { message: string } }
type User = { id: i64, name: string }

fn maybeFailInt(should_throw: bool) -> i64 {
    if (should_throw) {
        throw ForceErr.Msg { message: "force-try violation" }
    }
    return 42
}

fn maybeFailJson(should_throw: bool) -> User {
    if (should_throw) {
        throw ForceErr.Msg { message: "deeper failure" }
    }
    return { id: 99, name: "Bob" }
}

@test
fn test_propagation_success_int() {
    print("1. success returns the value unchanged")
    var a = maybeFailInt(false)
    assertEqual(a, 42)
    print("   PASS")
}

@test
fn test_propagation_success_json() {
    print("2. success — composite type")
    var obj = maybeFailJson(false)
    assertEqual(obj.id, 99)
    assertEqual(obj.name, "Bob")
    print("   PASS")
}

@test
fn test_propagation_throw_caught() {
    print("3. throw propagates and is caught by surrounding try-catch")
    var saw_catch = false
    try {
        var x = maybeFailInt(true)
        print("should not reach:", x)
    } catch (e) {
        saw_catch = true
        match (e) { ForceErr.Msg { message: s } -> { assertEqual(s, "force-try violation") } }
    }
    assertEqual(saw_catch, true)
    print("   PASS")
}

@test
fn test_propagation_nested_throw() {
    print("4. nested call propagates the inner exception")
    fn helper() -> User {
        return maybeFailJson(true)
    }
    var saw_catch = false
    try {
        var result = helper()
        print("should not reach:", result)
    } catch (e) {
        saw_catch = true
        match (e) { ForceErr.Msg { message: s } -> { assertEqual(s, "deeper failure") } }
    }
    assertEqual(saw_catch, true)
    print("   PASS")
}

@test
fn test_propagation_keeps_value_type() {
    print("5. value type is preserved (no widening)")
    var v = maybeFailInt(false)
    var next = v + 1
    assertEqual(next, 43)
    print("   PASS")
}
