// Enum static domains reuse ordinary for-in CFG, cleanup, checked indexing,
// and closure-capture semantics.
enum Color {
    Red,
    Green,
    Blue,
    White
}

enum Event {
    Ready,
    Data(value: i64),
    Error(message: string)
}

fn firstPayloadVariantOrdinal() -> i64 {
    for (variant in Event.variants) {
        if (!variant.isUnit) {
            return variant.ordinal
        }
    }
    return -1
}

@test
fn test_enum_value_loop_break_and_continue() {
    var trace = ""
    for (color in Color) {
        if (color == Color.Green) {
            continue
        }
        if (color == Color.White) {
            break
        }
        trace += color.name + ":"
    }
    assertEqual(trace, "Red:Blue:")
}

@test
fn test_enum_descriptor_labeled_control_flow() {
    var trace = ""
    outer: for (variant in Event.variants) {
        for (i in 0..2) {
            if (variant.ordinal == 1) {
                continue outer
            }
            if (variant.ordinal == 2) {
                break outer
            }
            trace += string(variant.ordinal) + string(i)
        }
    }
    assertEqual(trace, "0001")
    assertEqual(firstPayloadVariantOrdinal(), 1)
}

@test
fn test_enum_descriptor_checked_indexing() {
    assertPanics(fn() {
        var value = Event.variants[-1]
    })
    assertPanics(fn() {
        var value = Event.variants[3]
    })
    assertPanics(fn() {
        var value = Event.variants[1].payloads[1]
    })
}

@test
fn test_enum_descriptor_closure_capture_keeps_iteration_value() {
    var readers: Array<fn() -> i64> = []
    for (variant in Event.variants) {
        var captured = variant
        fn readOrdinal() -> i64 {
            return captured.ordinal
        }
        readers.push(readOrdinal)
    }
    assertEqual(len(readers), 3)
    assertEqual(readers[0](), 0)
    assertEqual(readers[1](), 1)
    assertEqual(readers[2](), 2)
}

@test
fn test_unit_enum_variants_empty_body_is_valid() {
    for (variant in Color.variants) {
    }
}
