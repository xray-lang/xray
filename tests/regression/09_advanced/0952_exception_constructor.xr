// REGRESSION: ADT enum construction and variant matching.
// Validates that enum variants (both simple and ADT with payloads) can be
// constructed, destructured via `match`, thrown, and caught correctly.

enum TestErr {
    Msg { s: string },
    Wrapped { msg: string, cause: string }
}

@test
fn test_enum_basic_construct() {
    var e = TestErr.Msg { s: "hi" }
    match (e) {
        TestErr.Msg { s } -> { assertEqual(s, "hi") }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_multi_field() {
    var e = TestErr.Wrapped { msg: "outer", cause: "inner" }
    match (e) {
        TestErr.Wrapped { msg, cause } -> {
            assertEqual(msg, "outer")
            assertEqual(cause, "inner")
        }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_cause_chain() {
    var inner = TestErr.Msg { s: "inner" }
    var outer = TestErr.Wrapped { msg: "outer", cause: "inner" }
    match (outer) {
        TestErr.Wrapped { msg, cause } -> {
            assertEqual(msg, "outer")
            match (inner) {
                TestErr.Msg { s } -> { assertEqual(s, cause) }
                _ -> { assert(false) }
            }
        }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_to_string() {
    var e = TestErr.Msg { s: "boom" }
    var s = string(e)
    assert(len(s) > 0)
}

@test
fn test_enum_throw_and_catch() {
    var caught_msg = ""
    try {
        throw TestErr.Msg { s: "oops" }
    } catch (e) {
        match (e) { TestErr.Msg { s } -> { caught_msg = s } }
    }
    assertEqual(caught_msg, "oops")
}

@test
fn test_enum_throw_with_wrapped() {
    var primary_msg = ""
    var cause_msg = ""
    try {
        throw TestErr.Wrapped { msg: "wrapped", cause: "primary" }
    } catch (e) {
        match (e) {
            TestErr.Wrapped { msg, cause } -> {
                primary_msg = msg
                cause_msg = cause
            }
        }
    }
    assertEqual(primary_msg, "wrapped")
    assertEqual(cause_msg, "primary")
}

@test
fn test_enum_typed_catch() {
    var caught = false
    try {
        throw TestErr.Msg { s: "annotated" }
    } catch (e: TestErr) {
        caught = true
    }
    assertEqual(caught, true)
}

fn make_failure(msg: string) -> TestErr {
    return TestErr.Msg { s: msg }
}

@test
fn test_enum_function_return() {
    var e = make_failure("via fn")
    match (e) {
        TestErr.Msg { s } -> { assertEqual(s, "via fn") }
        _ -> { assert(false) }
    }
}
