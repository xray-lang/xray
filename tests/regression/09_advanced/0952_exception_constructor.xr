// REGRESSION: ADT enum construction and variant matching.
// Validates that enum variants (both simple and ADT with payloads) can be
// constructed, destructured via `match`, thrown, and caught correctly.

enum TestErr {
    Msg(s: string),
    Wrapped(msg: string, cause: string)
}

@test
fn test_enum_basic_construct() {
    let e = TestErr.Msg("hi")
    match (e) {
        TestErr.Msg(s) -> { assert_eq(s, "hi") }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_multi_field() {
    let e = TestErr.Wrapped("outer", "inner")
    match (e) {
        TestErr.Wrapped(msg, cause) -> {
            assert_eq(msg, "outer")
            assert_eq(cause, "inner")
        }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_cause_chain() {
    let inner = TestErr.Msg("inner")
    let outer = TestErr.Wrapped("outer", "inner")
    match (outer) {
        TestErr.Wrapped(msg, cause) -> {
            assert_eq(msg, "outer")
            match (inner) {
                TestErr.Msg(s) -> { assert_eq(s, cause) }
                _ -> { assert(false) }
            }
        }
        _ -> { assert(false) }
    }
}

@test
fn test_enum_to_string() {
    let e = TestErr.Msg("boom")
    let s = string(e)
    assert(s.length > 0)
}

@test
fn test_enum_throw_and_catch() {
    let caught_msg = ""
    try {
        throw TestErr.Msg("oops")
    } catch (e) {
        match (e) { TestErr.Msg(s) -> { caught_msg = s } }
    }
    assert_eq(caught_msg, "oops")
}

@test
fn test_enum_throw_with_wrapped() {
    let primary_msg = ""
    let cause_msg = ""
    try {
        throw TestErr.Wrapped("wrapped", "primary")
    } catch (e) {
        match (e) {
            TestErr.Wrapped(msg, cause) -> {
                primary_msg = msg
                cause_msg = cause
            }
        }
    }
    assert_eq(primary_msg, "wrapped")
    assert_eq(cause_msg, "primary")
}

@test
fn test_enum_typed_catch() {
    let caught = false
    try {
        throw TestErr.Msg("annotated")
    } catch (e: TestErr) {
        caught = true
    }
    assert_eq(caught, true)
}

fn make_failure(msg: string) -> TestErr {
    return TestErr.Msg(msg)
}

@test
fn test_enum_function_return() {
    let e = make_failure("via fn")
    match (e) {
        TestErr.Msg(s) -> { assert_eq(s, "via fn") }
        _ -> { assert(false) }
    }
}
