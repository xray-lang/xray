// 0955_exception_stack_array.xr
// 作者：xingleixu@gmail.com
// 测试：栈轨迹是 Array<string>（F035 回归）
// spec §16.6 / §18.8 声明 stack: Array<string>，每帧一行格式化字符串。
//
// 栈轨迹属于 panic 通道：运行时故障（除零、断言失败等）unwind 时记录
// 调用链，由 `catch panic (p)` 捕获，p.stack 暴露 Array<string>。
// 用户错误（`throw <enum>`）走值返回通道，不携带栈轨迹。

fn mkzero() -> int { return 0 }

@test
fn test_new_exception_stack_is_array() {
    let e = new Exception("hello")
    assert_eq(typeof(e.stack), "Array")
}

@test
fn test_new_exception_stack_initially_empty() {
    // 直接 new 不经过 unwind 控制流，stack 为空数组
    let e = new Exception("hello")
    assert_eq(e.stack.length, 0)
}

@test
fn test_panic_stack_is_array() {
    fn inner() -> int {
        let z = mkzero()
        return 100 / z  // div-by-zero -> panic
    }
    let stack_type = ""
    try {
        inner()
    } catch panic (p) {
        stack_type = typeof(p.stack)
    }
    assert_eq(stack_type, "Array")
}

@test
fn test_panic_stack_has_frames() {
    fn level2() -> int {
        let z = mkzero()
        return 100 / z
    }
    fn level1() -> int {
        return level2()
    }
    let frames = 0
    try {
        level1()
    } catch panic (p) {
        frames = p.stack.length
    }
    // 至少 1 帧（panic 点本身），具体数量取决于内联 / 调度细节
    assert(frames >= 1)
}

@test
fn test_panic_stack_frames_are_strings() {
    fn inner() -> int {
        let z = mkzero()
        return 100 / z
    }
    let all_strings = true
    try {
        inner()
    } catch panic (p) {
        let idx = 0
        while (idx < p.stack.length) {
            if (typeof(p.stack[idx]) != "string") {
                all_strings = false
            }
            idx = idx + 1
        }
    }
    assert_eq(all_strings, true)
}

@test
fn test_subclass_exception_stack_is_array() {
    class MyErr extends Exception {
        constructor(m: string) { super(m) }
    }
    let e = new MyErr("hi")
    assert_eq(typeof(e.stack), "Array")
    assert_eq(e.stack.length, 0)
}

// ===== code / data 字段（同步 spec §16.6 完整字段） =====

@test
fn test_exception_code_default_zero() {
    let e = new Exception("plain message")
    assert_eq(e.code, 0)
}

@test
fn test_exception_data_default_null() {
    let e = new Exception("plain message")
    assert_eq(e.data, null)
}
