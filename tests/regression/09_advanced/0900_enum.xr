// 0900_enum.xr - Enum comprehensive test

// ===== Basic enum =====

enum Color {
    Red,
    Green,
    Blue
}
enum HttpStatus {
    OK,
    NotFound,
    ServerError

    code() -> i64 {
        return match (this) {
            HttpStatus.OK -> 200,
            HttpStatus.NotFound -> 404,
            HttpStatus.ServerError -> 500
        }
    }
}
enum Direction {
    North,
    South,
    East,
    West

    symbol() -> string {
        return match (this) {
            Direction.North -> "N",
            Direction.South -> "S",
            Direction.East -> "E",
            Direction.West -> "W"
        }
    }
}
enum Day {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday
}
fn getColorCode(c: Color) -> string {
    return match (c) {
        Color.Red -> "#FF0000",
        Color.Green -> "#00FF00",
        Color.Blue -> "#0000FF"
    }
}

@test
fn test_enum() {

    // Test: enum identity comparison
    var c = Color.Red
    assertEqual(c == Color.Red, true)
    assertEqual(c == Color.Green, false)
    assertEqual(Color.Red == Color.Red, true)
    assertEqual(Color.Red != Color.Blue, true)

    // ===== Protocol values via explicit methods =====


    assertEqual(HttpStatus.OK.code(), 200)
    assertEqual(HttpStatus.NotFound.code(), 404)
    assertEqual(HttpStatus.ServerError.code(), 500)

    // ===== String protocol symbols via explicit methods =====


    assertEqual(Direction.North.symbol(), "N")
    assertEqual(Direction.East.symbol(), "E")
    assertEqual(Direction.West.symbol(), "W")

    // ===== Enum properties: name, ordinal =====

    assertEqual(Color.Red.name, "Red")
    assertEqual(Color.Green.name, "Green")
    assertEqual(Color.Blue.name, "Blue")

    assertEqual(Color.Red.ordinal, 0)
    assertEqual(Color.Green.ordinal, 1)
    assertEqual(Color.Blue.ordinal, 2)

    assertEqual(HttpStatus.OK.name, "OK")
    assertEqual(HttpStatus.OK.ordinal, 0)
    assertEqual(HttpStatus.NotFound.ordinal, 1)

    // ===== Enum toString =====

    assertEqual(Color.Red.toString(), "Color.Red")
    assertEqual(Color.Green.toString(), "Color.Green")
    assertEqual(Direction.North.toString(), "Direction.North")

    // ===== Enum in match =====

    var color = Color.Green
    var name = match (color) {
        Color.Red -> "red",
        Color.Green -> "green",
        Color.Blue -> "blue"
    }
    assertEqual(name, "green")

    var status = HttpStatus.NotFound
    var message = match (status) {
        HttpStatus.OK -> "Success",
        HttpStatus.NotFound -> "Not Found",
        HttpStatus.ServerError -> "Server Error"
    }
    assertEqual(message, "Not Found")

    // ===== Enum as function parameter =====


    assertEqual(getColorCode(Color.Red), "#FF0000")
    assertEqual(getColorCode(Color.Green), "#00FF00")
    assertEqual(getColorCode(Color.Blue), "#0000FF")

    // ===== Enum in array =====

    var colors = [Color.Red, Color.Green, Color.Blue]
    assertEqual(len(colors), 3)
    assertEqual(colors[0] == Color.Red, true)
    assertEqual(colors[2] == Color.Blue, true)
}
