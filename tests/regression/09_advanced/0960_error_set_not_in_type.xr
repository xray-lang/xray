// 126-P3 / 216: the concrete error_set is analyzer metadata, not part of
// function type identity. Task 216 adds only a typed throw-effect bit and the
// build-time no-throw contract; it does not put enum/variant sets back into the
// type. Functions with the same signature but different inferred error sets
// therefore still unify in a may-throw `(int) -> int` array.

enum E { A, B }

fn fa(x: int) -> int {
    if (x < 0) {
        throw E.A
    }
    return x + 1
}

fn fb(x: int) -> int {
    if (x < 0) {
        throw E.B
    }
    return x + 2
}

fn call_first(fns: Array<(int) -> int>, x: int) -> int {
    return fns[0](x)
}

@test
fn test_error_set_not_in_function_type() {
    // [fa, fb] only type-checks as Array<(int) -> int> if fa and fb share the
    // same function type despite throwing different enum errors.
    var fns: Array<(int) -> int> = [fa, fb]
    assert_eq(len(fns), 2)
    assert_eq(fns[0](10), 11)
    assert_eq(fns[1](10), 12)
    assert_eq(call_first(fns, 5), 6)
}

test_error_set_not_in_function_type()
