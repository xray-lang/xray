// 0960_enum_static_iteration_metadata.xr
// Unit-only enums iterate actual values. Every enum exposes explicit, typed
// variant descriptors through `.variants`; payload descriptors are metadata,
// never synthesized enum values.
enum Color {
    Red,
    Green,
    Blue
}

enum WireEvent {
    Ready,
    Data(bytes: string, code: int),
    Error(message: string)
}

enum GenericResult<T> {
    Ok(value: T),
    Error(message: string),
    Empty
}

enum PositionalPayload {
    Pair(int, int)
}

type PaletteColor = Color

fn colorVariantName(variant: EnumVariant<Color>) -> string {
    return variant.name
}

fn payloadFieldName(field: EnumPayloadField<WireEvent>) -> string {
    return field.name
}

fn firstColorVariant() -> EnumVariant<Color> {
    return Color.variants[0]
}

fn variantOrdinal(variant: EnumVariant<Color>) -> int {
    return variant.ordinal
}

fn secondDataField() -> EnumPayloadField<WireEvent> {
    return WireEvent.variants[1].payloads[1]
}

@test
fn test_unit_enum_value_iteration() {
    var ordinal = 0
    for (color in Color) {
        assert_eq(color.ordinal, ordinal)
        if (ordinal == 0) {
            assert_eq(color, Color.Red)
        }
        if (ordinal == 1) {
            assert_eq(color, Color.Green)
        }
        if (ordinal == 2) {
            assert_eq(color, Color.Blue)
        }
        ordinal += 1
    }
    assert_eq(ordinal, 3)
}

@test
fn test_unit_enum_variant_descriptors() {
    assert_eq(Color.variants.length, 3)
    assert_eq(Color.variants[0].ordinal, 0)
    assert_eq(Color.variants[1].name, "Green")
    assert_eq(Color.variants[2].payloadCount, 0)
    assert_eq(Color.variants[2].isUnit, true)
    assert_eq(Color.variants[2].payloads.length, 0)
    assert_eq(variantOrdinal(firstColorVariant()), 0)
    var count = 0
    for (variant in Color.variants) {
        assert_eq(variant.ordinal, count)
        assert_eq(variant.payloadCount, 0)
        assert_eq(variant.isUnit, true)
        assert_eq(colorVariantName(variant), variant.name)
        count += 1
    }
    assert_eq(count, 3)
}

@test
fn test_payload_enum_variant_descriptors() {
    assert_eq(WireEvent.variants.length, 3)
    assert_eq(WireEvent.variants[0].name, "Ready")
    assert_eq(WireEvent.variants[0].isUnit, true)
    assert_eq(WireEvent.variants[1].name, "Data")
    assert_eq(WireEvent.variants[1].payloadCount, 2)
    assert_eq(WireEvent.variants[1].isUnit, false)
    assert_eq(WireEvent.variants[2].payloadCount, 1)
    var variants = 0
    var fields = 0
    for (variant in WireEvent.variants) {
        variants += 1
        for (field in variant.payloads) {
            assert_eq(field.index, fields)
            assert_eq(field.type > 0, true)
            assert_eq(payloadFieldName(field), field.name)
            fields += 1
        }
        fields = 0
    }
    assert_eq(variants, 3)
    var data = WireEvent.variants[1]
    assert_eq(data.payloads.length, 2)
    assert_eq(data.payloads[0].index, 0)
    assert_eq(data.payloads[0].name, "bytes")
    assert_eq(data.payloads[1].index, 1)
    assert_eq(data.payloads[1].name, "code")
    assert_eq(WireEvent.variants[2].payloads[0].name, "message")
    assert_eq(payloadFieldName(secondDataField()), "code")
}

@test
fn test_concrete_generic_enum_variant_descriptors() {
    assert_eq(GenericResult<int>.variants.length, 3)
    assert_eq(GenericResult<int>.variants[0].name, "Ok")
    assert_eq(GenericResult<int>.variants[0].payloadCount, 1)
    assert_eq(GenericResult<int>.variants[0].payloads[0].name, "value")
    assert_eq(GenericResult<int>.variants[0].payloads[0].type > 0, true)
}

@test
fn test_positional_payload_descriptor_names_are_empty() {
    assert_eq(PositionalPayload.variants[0].payloads.length, 2)
    assert_eq(PositionalPayload.variants[0].payloads[0].name, "")
    assert_eq(PositionalPayload.variants[0].payloads[1].name, "")
}

@test
fn test_enum_alias_static_domains() {
    var valueCount = 0
    for (color in PaletteColor) {
        assert_eq(color.ordinal, valueCount)
        valueCount += 1
    }
    assert_eq(valueCount, 3)
    assert_eq(PaletteColor.variants.length, 3)
    assert_eq(PaletteColor.variants[1].name, "Green")
}
