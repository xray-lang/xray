// Regression: supervisor scope is statement-only and still waits for children.

enum ScopeExprErr { Msg(string) }

fn send_value(ch: Channel<int>, n: int) {
    ch.send(n)
}

fn fail_after_send(ch: Channel<int>, n: int) -> int {
    ch.send(n)
    throw ScopeExprErr.Msg("scope")
    return 0
}

fn recv_sum(ch: Channel<int>, count: int) -> int {
    var sum = 0
    for (var i = 0; i < count; i++) {
        match (ch.recv()) {
            Recv.Value(v) -> { sum = sum + v }
            _ -> {}
        }
    }
    return sum
}

@test
fn test_supervisor_scope_statement_waits_for_children() {
    shared ch = Channel<int>(3)
    supervisor scope {
        go send_value(ch, 1)
        go fail_after_send(ch, 2)
        go send_value(ch, 4)
    }

    assert_eq(recv_sum(ch, 3), 7)
    ch.close()
}
