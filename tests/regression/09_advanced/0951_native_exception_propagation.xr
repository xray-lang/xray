// 0951_native_exception_propagation.xr
// Regression: C primitive methods must propagate exceptions to try/catch.

@test
fn test_json_parse_value_catches_malformed_input() {
    var caught = false
    try {
        JSON.parseValue("{broken")
    } catch panic (e) {
        caught = true
    }
    assert_eq(caught, true)
}

@test
fn test_json_parse_object_catches_non_object_root() {
    var caught = false
    var msg = ""
    try {
        JSON.parseObject("[1, 2, 3]")
    } catch panic (e) {
        caught = true
        msg = string(e)
    }
    assert_eq(caught, true)
    assert_eq(len(msg) > 0, true)
}

@test
fn test_json_stringify_succeeds() {
    var result = JSON.stringify({a: 1, b: "hello"})
    assert_eq(len(result) > 0, true)
}

@test
fn test_exception_after_catch_continues() {
    var step1 = false
    var step2 = false
    try {
        JSON.parseValue("")
    } catch panic (e) {
        step1 = true
    }
    step2 = true
    assert_eq(step1, true)
    assert_eq(step2, true)
}

@test
fn test_multiple_catch_blocks() {
    var count = 0
    for (i in 0..3) {
        try {
            JSON.parseValue("invalid")
        } catch panic (e) {
            count = count + 1
        }
    }
    assert_eq(count, 3)
}
