// 0951_native_exception_propagation.xr
// Regression: C primitive methods must propagate exceptions to try/catch

@test
fn test_json_stringify_catches_function() {
    var f = fn() {}
    var obj = { handler: f }
    var caught = false
    try {
        Json.stringify(obj)
    } catch panic (e) {
        caught = true
    }
    assert_eq(caught, true)
}

@test
fn test_json_stringify_catches_nested() {
    var inner = fn() {}
    var obj = { callback: inner }
    var caught = false
    var msg = ""
    try {
        Json.stringify(obj)
    } catch panic (e) {
        caught = true
        msg = string(e)
    }
    assert_eq(caught, true)
    assert_eq(len(msg) > 0, true)
}

@test
fn test_json_stringify_normal_succeeds() {
    var result = Json.stringify({a: 1, b: "hello"})
    assert_eq(len(result) > 0, true)
}

@test
fn test_exception_after_catch_continues() {
    var f = fn() {}
    var obj = { handler: f }
    var step1 = false
    var step2 = false
    try {
        Json.stringify(obj)
    } catch panic (e) {
        step1 = true
    }
    step2 = true
    assert_eq(step1, true)
    assert_eq(step2, true)
}

@test
fn test_multiple_catch_blocks() {
    var f = fn() {}
    var count = 0
    for (i in 0..3) {
        var obj = { handler: f }
        try {
            Json.stringify(obj)
        } catch panic (e) {
            count = count + 1
        }
    }
    assert_eq(count, 3)
}
