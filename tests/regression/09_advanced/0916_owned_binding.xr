// 0916_owned_binding.xr
// Regression: owned declarations are storage declarations, not type modifiers.

@test
fn test_owned_fresh_array() {
    var buffer = Array<i64>()
    buffer.push(1)
    buffer.push(2)
    assertEqual(len(buffer), 2)
    assertEqual(buffer[0], 1)
    assertEqual(buffer[1], 2)
}

@test
fn test_owned_move_initializer() {
    var source = Array<i64>()
    source.push(7)
    var buffer = move source
    buffer.push(8)
    assertEqual(len(buffer), 2)
    assertEqual(buffer[0], 7)
    assertEqual(buffer[1], 8)
}

@test
fn test_owned_copy_initializer() {
    var source = Array<i64>()
    source.push(3)
    var buffer = copy(source)
    source.push(4)
    assertEqual(len(source), 2)
    assertEqual(len(buffer), 1)
    assertEqual(buffer[0], 3)
}

@test
fn test_shared_copy_initializer() {
    var source = Array<u8>(2, 0)
    source[0] = 1
    source[1] = 2

    const frozen = copy(source)
    source[0] = 9

    assertEqual(len(frozen), 2)
    assertEqual(frozen[0], 1)
    assertEqual(frozen[1], 2)
}

@test
fn test_owned_move_to_shared_ref_free_array() {
    var bytes = Array<u8>(3, 0)
    bytes[0] = 10
    bytes[1] = 20
    bytes[2] = 30

    const frozen = move bytes

    assertEqual(len(frozen), 3)
    assertEqual(frozen[0], 10)
    assertEqual(frozen[1], 20)
    assertEqual(frozen[2], 30)
}

@test
fn test_owned_move_to_shared_after_slice_last_use() {
    var bytes = Array<u8>(2, 0)
    bytes[0] = 41
    bytes[1] = 42
    var view: Slice<u8> = bytes[:]
    assertEqual(len(view), 2)

    const frozen = move bytes

    assertEqual(len(frozen), 2)
    assertEqual(frozen[0], 41)
    assertEqual(frozen[1], 42)
}

fn make_owned_return_buffer() -> Array<u8> {
    var bytes = Array<u8>(2, 0)
    bytes[0] = 11
    bytes[1] = 12
    return bytes
}

fn make_owned_return_buffer_alt() -> Array<u8> {
    var bytes = Array<u8>(2, 0)
    bytes[0] = 31
    bytes[1] = 32
    return bytes
}

fn choose_owned_return_buffer(flag: bool) -> Array<u8> {
    return flag ? make_owned_return_buffer() : make_owned_return_buffer_alt()
}

fn make_shared_return_buffer() -> const Array<u8> {
    var bytes = Array<u8>(2, 0)
    bytes[0] = 21
    bytes[1] = 22
    const frozen = move bytes
    return frozen
}

@test
fn test_owned_return_to_owned_binding() {
    var bytes = make_owned_return_buffer()
    assertEqual(len(bytes), 2)
    assertEqual(bytes[0], 11)
    assertEqual(bytes[1], 12)
}

@test
fn test_shared_return_to_shared_binding() {
    const bytes = make_shared_return_buffer()
    assertEqual(len(bytes), 2)
    assertEqual(bytes[0], 21)
    assertEqual(bytes[1], 22)
}

@test
fn test_copy_owned_return_to_var_binding() {
    var bytes = copy(make_owned_return_buffer())
    assertEqual(len(bytes), 2)
    assertEqual(bytes[0], 11)
    assertEqual(bytes[1], 12)
}

@test
fn test_owned_return_through_const_function_alias() {
    const build = make_owned_return_buffer
    var bytes = build()
    assertEqual(len(bytes), 2)
    assertEqual(bytes[0], 11)
    assertEqual(bytes[1], 12)
}

@test
fn test_owned_return_through_ternary_summary() {
    var bytes = choose_owned_return_buffer(false)
    assertEqual(len(bytes), 2)
    assertEqual(bytes[0], 31)
    assertEqual(bytes[1], 32)
}
