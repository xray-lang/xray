// 0916_owned_binding.xr
// Regression: owned declarations are storage declarations, not type modifiers.

@test
fn test_owned_fresh_array() {
    owned buffer = Array<int>()
    buffer.push(1)
    buffer.push(2)
    assert_eq(len(buffer), 2)
    assert_eq(buffer[0], 1)
    assert_eq(buffer[1], 2)
}

@test
fn test_owned_move_initializer() {
    var source = Array<int>()
    source.push(7)
    owned buffer = move source
    buffer.push(8)
    assert_eq(len(buffer), 2)
    assert_eq(buffer[0], 7)
    assert_eq(buffer[1], 8)
}

@test
fn test_owned_copy_initializer() {
    var source = Array<int>()
    source.push(3)
    owned buffer = copy(source)
    source.push(4)
    assert_eq(len(source), 2)
    assert_eq(len(buffer), 1)
    assert_eq(buffer[0], 3)
}

@test
fn test_shared_copy_initializer() {
    var source = Array<byte>(2, 0)
    source[0] = 1
    source[1] = 2

    shared frozen = copy(source)
    source[0] = 9

    assert_eq(len(frozen), 2)
    assert_eq(frozen[0], 1)
    assert_eq(frozen[1], 2)
}

@test
fn test_owned_move_to_shared_ref_free_array() {
    owned bytes = Array<byte>(3, 0)
    bytes[0] = 10
    bytes[1] = 20
    bytes[2] = 30

    shared frozen = move bytes

    assert_eq(len(frozen), 3)
    assert_eq(frozen[0], 10)
    assert_eq(frozen[1], 20)
    assert_eq(frozen[2], 30)
}

fn make_owned_return_buffer() -> Array<byte> {
    owned bytes = Array<byte>(2, 0)
    bytes[0] = 11
    bytes[1] = 12
    return move bytes
}

fn make_shared_return_buffer() -> Array<byte> {
    owned bytes = Array<byte>(2, 0)
    bytes[0] = 21
    bytes[1] = 22
    shared frozen = move bytes
    return frozen
}

@test
fn test_owned_return_to_owned_binding() {
    owned bytes = make_owned_return_buffer()
    assert_eq(len(bytes), 2)
    assert_eq(bytes[0], 11)
    assert_eq(bytes[1], 12)
}

@test
fn test_shared_return_to_shared_binding() {
    shared bytes = make_shared_return_buffer()
    assert_eq(len(bytes), 2)
    assert_eq(bytes[0], 21)
    assert_eq(bytes[1], 22)
}

@test
fn test_copy_owned_return_to_var_binding() {
    var bytes = copy(make_owned_return_buffer())
    assert_eq(len(bytes), 2)
    assert_eq(bytes[0], 11)
    assert_eq(bytes[1], 12)
}
