// 0915_shared_for_go.xr
// Regression: shared captured by go closures inside for loops
// must resolve to the actual value, not an uninitialized register left
// behind by an eliminated PHI node.

@test
fn test_shared_atomic_for_go() {
    const counter = Atomic(0)
    scope {
        for (i in 0..3) {
            go fn() {
                counter.add(1)
            }()
        }
    }
    assert_eq(counter.load(), 3)
}

@test
fn test_shared_typeof_for_go() {
    const counter = Atomic(0)
    const ok_count = Atomic(0)
    scope {
        for (i in 0..3) {
            go fn() {
                if (typeName(counter) == "Atomic") {
                    ok_count.add(1)
                }
            }()
        }
    }
    assert_eq(ok_count.load(), 3)
}

@test
fn test_shared_channel_for_go() {
    const ch = Channel<int>(3)
    scope {
        for (i in 0..3) {
            go fn() {
                ch.send(1)
            }()
        }
    }
    var sum = 0
    for (i in 0..3) {
        sum = sum + match (ch.recv()) {
            Recv.Value(v) -> v
            _ -> 0
        }
    }
    assert_eq(sum, 3)
}

@test
fn test_shared_no_for_baseline() {
    const counter = Atomic(0)
    scope {
        go fn() { counter.add(1) }()
        go fn() { counter.add(1) }()
        go fn() { counter.add(1) }()
    }
    assert_eq(counter.load(), 3)
}
