// 作者：xingleixu@gmail.com
// 测试：typeName() 运行时类型名

// ===== 基本类型 =====

@test
fn test_typeof_int() {
    var x = 42
    assertEqual(typeName(x), "i64")
    // Bare literals without type context are NaN-boxed
    assertEqual(typeName(0), "i64")
    assertEqual(typeName(-100), "i64")
}

@test
fn test_typeof_float() {
    var x = 3.14
    assertEqual(typeName(x), "f64")
    assertEqual(typeName(0.0), "f64")
}

@test
fn test_typeof_string() {
    var s = "hello"
    assertEqual(typeName(s), "string")
    assertEqual(typeName(""), "string")
}

@test
fn test_typeof_bool() {
    assertEqual(typeName(true), "bool")
    assertEqual(typeName(false), "bool")
}

@test
fn test_typeof_null() {
    assertEqual(typeName(null), "null")
}

// ===== 集合类型 =====

@test
fn test_typeof_array() {
    var arr = [1, 2, 3]
    assertEqual(typeName(arr), "Array")
}

@test
fn test_typeof_map() {
    var m = #{"key": "value"}
    assertEqual(typeName(m), "Map")
}

@test
fn test_typeof_set() {
    var s = #[1, 2, 3]
    assertEqual(typeName(s), "Set")
}

// ===== 函数类型 =====

@test
fn test_typeof_function() {
    fn add(a: i64, b: i64) -> i64 { return a + b }
    assertEqual(typeName(add), "function")
    
    var lambda = (x: i64) -> x * 2
    assertEqual(typeName(lambda), "function")
}

// ===== 类实例 =====

class MyClass {
    value: i64
    constructor(v) { this.value = v }
}

@test
fn test_typeof_instance() {
    var obj = MyClass(10)
    assertEqual(typeName(obj), "MyClass")
}
