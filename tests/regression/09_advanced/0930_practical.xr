// ===== 斐波那契数列 =====

@test
fn test_fibonacci() {
    fn fib(n: i64) -> i64 {
        if (n <= 1) { return n }
        return fib(n - 1) + fib(n - 2)
    }
    
    assertEqual(fib(0), 0)
    assertEqual(fib(1), 1)
    assertEqual(fib(5), 5)
    assertEqual(fib(10), 55)
}

// ===== 阶乘 =====

@test
fn test_factorial() {
    fn fact(n: i64) -> i64 {
        if (n <= 1) { return 1 }
        return n * fact(n - 1)
    }
    
    assertEqual(fact(0), 1)
    assertEqual(fact(1), 1)
    assertEqual(fact(5), 120)
}

// ===== 质数判断 =====

@test
fn test_is_prime() {
    fn isPrime(n: i64) -> bool {
        if (n < 2) { return false }
        if (n == 2) { return true }
        if (n % 2 == 0) { return false }
        var i = 3
        while (i * i <= n) {
            if (n % i == 0) { return false }
            i = i + 2
        }
        return true
    }
    
    assertEqual(isPrime(2), true)
    assertEqual(isPrime(3), true)
    assertEqual(isPrime(4), false)
    assertEqual(isPrime(17), true)
    assertEqual(isPrime(18), false)
}

// ===== 最大公约数 =====

@test
fn test_gcd() {
    fn gcd(a: i64, b: i64) -> i64 {
        var x = a
        var y = b
        while (y != 0) {
            var temp = y
            y = x % y
            x = temp
        }
        return x
    }
    
    assertEqual(gcd(12, 8), 4)
    assertEqual(gcd(17, 13), 1)
    assertEqual(gcd(100, 25), 25)
}

// ===== 二分查找 =====

@test
fn test_binary_search() {
    fn binarySearch(arr: Array<i64>, target: i64) -> i64 {
        var low = 0
        var high = len(arr) - 1
        while (low <= high) {
            var mid = (low + high) / 2
            if (arr[mid] == target) { return mid }
            if (arr[mid] < target) {
                low = mid + 1
            } else {
                high = mid - 1
            }
        }
        return -1
    }
    
    var arr = [1, 3, 5, 7, 9, 11, 13]
    assertEqual(binarySearch(arr, 7), 3)
    assertEqual(binarySearch(arr, 1), 0)
    assertEqual(binarySearch(arr, 13), 6)
    assertEqual(binarySearch(arr, 4), -1)
}

// ===== 冒泡排序 =====

@test
fn test_bubble_sort() {
    fn bubbleSort(arr: ref Array<i64>) {
        var n = len(arr)
        for (i in 0..n) {
            for (j in 0..(n - i - 1)) {
                if (arr[j] > arr[j + 1]) {
                    var temp = arr[j]
                    arr[j] = arr[j + 1]
                    arr[j + 1] = temp
                }
            }
        }
    }
    
    var arr = [64, 34, 25, 12, 22, 11, 90]
    bubbleSort(ref arr)
    assertEqual(arr[0], 11)
    assertEqual(arr[6], 90)
}

// ===== 字符串反转 =====

@test
fn test_reverse_string() {
    fn reverse(s: string) -> string {
        var result = ""
        var i = len(s) - 1
        while (i >= 0) {
            result = result + s.runes().nth(i).toString()
            i = i - 1
        }
        return result
    }
    
    assertEqual(reverse("hello"), "olleh")
    assertEqual(reverse("a"), "a")
    assertEqual(reverse(""), "")
}

// ===== 计数器类 =====

@test
fn test_counter_class() {
    class Counter {
        value: i64
        constructor() { this.value = 0 }
        ref inc() { this.value += 1 }        ref dec() { this.value -= 1 }        getValue() -> i64 { return this.value }    }
    
    var c = Counter()
    c.inc()
    c.inc()
    c.inc()
    c.dec()
    assertEqual(c.getValue(), 2)
}

// ===== 栈实现 =====

@test
fn test_stack() {
    class Stack implements Lengthable {
        items: Array<i64>
        constructor() { this.items = [] }
        ref push(x: i64) { this.items.push(x) }
        ref pop() -> i64? { return this.items.pop() }
        peek() -> i64 { return this.items[len(this.items) - 1] }
        isEmpty() -> bool { return len(this.items) == 0 }
        operator len() -> i64 { return len(this.items) }
    }
    
    var s = Stack()
    assertEqual(len(s) == 0, true)
    s.push(1)
    s.push(2)
    s.push(3)
    assertEqual(s.peek(), 3)
    assertEqual(s.pop(), 3)
    assertEqual(s.pop(), 2)
    assertEqual(len(s) == 0, false)
}
