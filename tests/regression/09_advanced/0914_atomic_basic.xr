// 0914_atomic_basic.xr
// Atomic<T> basic operations: load, store, add, sub, fetchAdd, fetchSub,
// swap, compareExchange, toggle, toString, Ordering enum

@test
fn test_atomic_int_load_store() {
    const a = Atomic(0)
    assertEqual(a.load(), 0)
    a.store(42)
    assertEqual(a.load(), 42)
}

@test
fn test_atomic_int_add_sub() {
    const a = Atomic(10)
    a.add(5)
    assertEqual(a.load(), 15)
    a.sub(3)
    assertEqual(a.load(), 12)
}

@test
fn test_atomic_int_fetch_add_sub() {
    const a = Atomic(10)
    var old1 = a.fetchAdd(5)
    assertEqual(old1, 10)
    assertEqual(a.load(), 15)
    var old2 = a.fetchSub(3)
    assertEqual(old2, 15)
    assertEqual(a.load(), 12)
}

@test
fn test_atomic_int_swap() {
    const a = Atomic(1)
    var old = a.swap(99)
    assertEqual(old, 1)
    assertEqual(a.load(), 99)
}

@test
fn test_atomic_int_compare_exchange_success() {
    const a = Atomic(0)
    var (prev, ok) = a.compareExchange(0, 1)
    assertEqual(prev, 0)
    assertEqual(ok, true)
    assertEqual(a.load(), 1)
}

@test
fn test_atomic_int_compare_exchange_failure() {
    const a = Atomic(5)
    var (prev, ok) = a.compareExchange(0, 1)
    assertEqual(ok, false)
    assertEqual(prev, 5)
    assertEqual(a.load(), 5)
}

@test
fn test_atomic_bool_load_store() {
    const flag = Atomic(false)
    assertEqual(flag.load(), false)
    flag.store(true)
    assertEqual(flag.load(), true)
}

@test
fn test_atomic_bool_toggle() {
    const flag = Atomic(false)
    var was = flag.toggle()
    assertEqual(was, false)
    assertEqual(flag.load(), true)
    var was2 = flag.toggle()
    assertEqual(was2, true)
    assertEqual(flag.load(), false)
}

@test
fn test_atomic_float_load_store() {
    const rate = Atomic(0.0)
    assertEqual(rate.load(), 0.0)
    rate.store(3.14)
    assertEqual(rate.load(), 3.14)
}

@test
fn test_atomic_float_add_sub() {
    const rate = Atomic(1.0)
    rate.add(0.5)
    assertEqual(rate.load(), 1.5)
    rate.sub(0.25)
    assertEqual(rate.load(), 1.25)
}

@test
fn test_atomic_to_string() {
    const a = Atomic(42)
    var s = a.toString()
    assertEqual(s, "42")
}

@test
fn test_atomic_ordering_enum() {
    const a = Atomic(0)
    a.store(1, Ordering.Relaxed)
    var v = a.load(Ordering.Relaxed)
    assertEqual(v, 1)
    a.store(2, Ordering.SeqCst)
    assertEqual(a.load(Ordering.SeqCst), 2)
}
