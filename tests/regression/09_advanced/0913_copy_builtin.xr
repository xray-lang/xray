// 0913_copy_builtin.xr
// 作者：xingleixu@gmail.com
// 测试：copy() builtin —— deep copy

@test
fn test_copy_int() {
    // Primitives are value-typed; copy() is essentially a passthrough.
    var x = 42
    var y = copy(x)
    assertEqual(y, 42)
    assertEqual(x, 42)
}

@test
fn test_copy_string() {
    var s = "hello"
    var t = copy(s)
    assertEqual(t, "hello")
    assertEqual(s, "hello")
}

@test
fn test_copy_array_independent() {
    var a = [1, 2, 3]
    var b = copy(a)
    a.push(4)
    // b must not see the mutation on a (deep copy semantics).
    assertEqual(len(b), 3)
    assertEqual(len(a), 4)
}

@test
fn test_copy_array_mutate_element() {
    var a = [10, 20, 30]
    var b = copy(a)
    a[0] = 999
    assertEqual(b[0], 10)
    assertEqual(a[0], 999)
}

@test
fn test_copy_nested_array() {
    var outer = [[1, 2], [3, 4]]
    var copied = copy(outer)
    // Mutating the inner array of the original must not propagate to the copy.
    outer[0].push(99)
    assertEqual(len(copied[0]), 2)
    assertEqual(len(outer[0]), 3)
}

@test
fn test_copy_map_independent() {
    var m = #{"a": 1, "b": 2}
    var n = copy(m)
    m["c"] = 3
    assertEqual(len(n), 2)
    assertEqual(len(m), 3)
    assertEqual(n.containsKey("c"), false)
}

@test
fn test_copy_does_not_corrupt_source() {
    // copy() reads R[B] and writes R[A]; verify the source register survives.
    var a = [1, 2, 3]
    var b = copy(a)
    assertEqual(len(a), 3)
    assertEqual(a[0], 1)
    assertEqual(a[1], 2)
    assertEqual(a[2], 3)
    assertEqual(len(b), 3)
}

@test
fn test_copy_in_expression() {
    var a = [10, 20, 30]
    var total = len(copy(a)) + len(a)
    assertEqual(total, 6)
}

@test
fn test_copy_chain() {
    var a = [1, 2, 3]
    var b = copy(copy(a))
    a.push(4)
    assertEqual(len(b), 3)
    assertEqual(len(a), 4)
}

@test
fn test_copy_range_native_body() {
    // Range is half-open [start, end), so 2..6 covers {2, 3, 4, 5}.
    var r = 2..6
    var c = copy(r)
    var values = c.toArray()
    assertEqual(len(values), 4)
    assertEqual(values[0], 2)
    assertEqual(values[3], 5)
    assertEqual(c.contains(4), true)
    assertEqual(c.contains(6), false)
}

class CopyBox {
    value: i64

    constructor(v: i64) {
        this.value = v
    }
}

@test
fn test_copy_const_array_returns_mutable_owned_copy() {
    const a = [1, 2]
    var b = copy(a)
    b.push(3)
    assertEqual(len(a), 2)
    assertEqual(len(b), 3)
}

@test
fn test_copy_const_map_returns_mutable_owned_copy() {
    const m = #{"a": 1}
    var n = copy(m)
    n["b"] = 2
    assertEqual(len(m), 1)
    assertEqual(len(n), 2)
}

@test
fn test_copy_const_object_returns_mutable_owned_copy() {
    const b = CopyBox(1)
    var c = copy(b)
    c.value = 2
    assertEqual(b.value, 1)
    assertEqual(c.value, 2)
}
