// 0913_copy_builtin.xr
// 作者：xingleixu@gmail.com
// 测试：copy() builtin —— deep copy

@test
fn test_copy_int() {
    // Primitives are value-typed; copy() is essentially a passthrough.
    var x = 42
    var y = copy(x)
    assert_eq(y, 42)
    assert_eq(x, 42)
}

@test
fn test_copy_string() {
    var s = "hello"
    var t = copy(s)
    assert_eq(t, "hello")
    assert_eq(s, "hello")
}

@test
fn test_copy_array_independent() {
    var a = [1, 2, 3]
    var b = copy(a)
    a.push(4)
    // b must not see the mutation on a (deep copy semantics).
    assert_eq(b.length, 3)
    assert_eq(a.length, 4)
}

@test
fn test_copy_array_mutate_element() {
    var a = [10, 20, 30]
    var b = copy(a)
    a[0] = 999
    assert_eq(b[0], 10)
    assert_eq(a[0], 999)
}

@test
fn test_copy_nested_array() {
    var outer = [[1, 2], [3, 4]]
    var copied = copy(outer)
    // Mutating the inner array of the original must not propagate to the copy.
    outer[0].push(99)
    assert_eq(copied[0].length, 2)
    assert_eq(outer[0].length, 3)
}

@test
fn test_copy_map_independent() {
    var m = #{"a": 1, "b": 2}
    var n = copy(m)
    m["c"] = 3
    assert_eq(n.length, 2)
    assert_eq(m.length, 3)
    assert_eq(n.has("c"), false)
}

@test
fn test_copy_does_not_corrupt_source() {
    // copy() reads R[B] and writes R[A]; verify the source register survives.
    var a = [1, 2, 3]
    var b = copy(a)
    assert_eq(a.length, 3)
    assert_eq(a[0], 1)
    assert_eq(a[1], 2)
    assert_eq(a[2], 3)
    assert_eq(b.length, 3)
}

@test
fn test_copy_in_expression() {
    var a = [10, 20, 30]
    var total = copy(a).length + a.length
    assert_eq(total, 6)
}

@test
fn test_copy_chain() {
    var a = [1, 2, 3]
    var b = copy(copy(a))
    a.push(4)
    assert_eq(b.length, 3)
    assert_eq(a.length, 4)
}

@test
fn test_copy_range_native_body() {
    // Range is half-open [start, end), so 2..6 covers {2, 3, 4, 5}.
    var r = 2..6
    var c = copy(r)
    var values = c.toArray()
    assert_eq(values.length, 4)
    assert_eq(values[0], 2)
    assert_eq(values[3], 5)
    assert_eq(c.includes(4), true)
    assert_eq(c.includes(6), false)
}

class CopyBox {
    value: int

    constructor(v: int) {
        this.value = v
    }
}

@test
fn test_copy_const_array_returns_mutable_owned_copy() {
    const a = [1, 2]
    var b = copy(a)
    b.push(3)
    assert_eq(a.length, 2)
    assert_eq(b.length, 3)
}

@test
fn test_copy_const_map_returns_mutable_owned_copy() {
    const m = #{"a": 1}
    var n = copy(m)
    n["b"] = 2
    assert_eq(m.length, 1)
    assert_eq(n.length, 2)
}

@test
fn test_copy_const_object_returns_mutable_owned_copy() {
    const b = CopyBox(1)
    var c = copy(b)
    c.value = 2
    assert_eq(b.value, 1)
    assert_eq(c.value, 2)
}
