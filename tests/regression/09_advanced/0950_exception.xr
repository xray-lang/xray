// REGRESSION: Bug #3/#4 - x64 JIT error propagation across nested calls
//             (commit 9da287d).
// FAIL_AT:    pre-9da287d on x64 with --jit-force
//             -> Bug #3: errors thrown from JIT-compiled callees were
//                silently discarded because the x64 backend skipped the
//                error check after a call that ARM64 already emits.
//             -> Bug #4: the rebuilt error value lost its heap type tag,
//                so downstream type checks misclassified it.
// PASS_AT:    9da287d+ on x64 and on ARM64 (already correct).
// REQUIRES_JIT_FORCE
// Triggering shape: deeply nested fn that throw, with try-catch at the
// outer scope (test_cross_function / test_deep_call_stack below).
/*
** Error handling regression suite (value-return error model).
**
** `throw <enum>` propagates through the value-return error channel and is
** observed by `catch (e)`.  The caught value IS the thrown enum, so tests
** use `match (e)` to recover the payload.  Deterministic cleanup is done
** with `defer` (runs on normal exit, on `return`, and on a propagating
** error), which replaces the removed `finally` construct.
*/

// Error type: a single variant carrying a string payload lets tests
// assert on the user-visible message via pattern matching.
enum AppErr {
    Msg(s: string)
}

// 1. Helper functions used by multiple tests
fn thr7() { throw AppErr.Msg("from_fn") }
fn d4() { throw AppErr.Msg("deep") }
fn d3() { d4() }
fn d2() { d3() }
fn d1() { d2() }
fn r12() -> string {
    try { return "ret" } catch (e) { return "no" }
}
fn r13() -> string {
    try { throw AppErr.Msg("x") } catch (e) { return "caught" }
}

// defer-based cleanup that runs even when the body throws.
let g8 = false
fn fn8() {
    defer { g8 = true }
    throw AppErr.Msg("x")
}

@test
fn test_basic_catch() {
    print("1. try-catch")
    let got = ""
    try { throw AppErr.Msg("e1") } catch (e) {
        match (e) { AppErr.Msg(s) -> { got = s } }
    }
    assert_eq(got, "e1")
    print("   PASS")
}

@test
fn test_nested_rethrow() {
    print("2. nested catch re-throw")
    let i6 = false
    let o6 = false
    let outer_msg = ""
    try {
        try {
            throw AppErr.Msg("inner")
        } catch (e) {
            i6 = true
            throw AppErr.Msg("outer")
        }
    } catch (e) {
        o6 = true
        match (e) { AppErr.Msg(s) -> { outer_msg = s } }
    }
    assert_eq(i6, true)
    assert_eq(o6, true)
    assert_eq(outer_msg, "outer")
    print("   PASS")
}

@test
fn test_cross_function() {
    print("3. cross function")
    let captured = ""
    try { thr7() } catch (e) {
        match (e) { AppErr.Msg(s) -> { captured = s } }
    }
    assert_eq(captured, "from_fn")
    print("   PASS")
}

@test
fn test_constructed_message() {
    print("4. constructed messages")
    let m1 = ""
    let m2 = ""
    try { throw AppErr.Msg("str") } catch (e) {
        match (e) { AppErr.Msg(s) -> { m1 = s } }
    }
    try { throw AppErr.Msg("ans=" + string(42)) } catch (e) {
        match (e) { AppErr.Msg(s) -> { m2 = s } }
    }
    assert_eq(m1, "str")
    assert_eq(m2, "ans=42")
    print("   PASS")
}

@test
fn test_deep_call_stack() {
    print("5. deep call stack")
    let captured = ""
    try { d1() } catch (e) {
        match (e) { AppErr.Msg(s) -> { captured = s } }
    }
    assert_eq(captured, "deep")
    print("   PASS")
}

@test
fn test_rethrow_chain() {
    print("6. re-throw chain with derived message")
    let n11 = 0
    let final_msg = ""
    try {
        try {
            try {
                throw AppErr.Msg("a")
            } catch (e) {
                n11 = n11 + 1
                match (e) { AppErr.Msg(s) -> { throw AppErr.Msg(s + "b") } }
            }
        } catch (e) {
            n11 = n11 + 1
            match (e) { AppErr.Msg(s) -> { throw AppErr.Msg(s + "c") } }
        }
    } catch (e) {
        n11 = n11 + 1
        match (e) { AppErr.Msg(s) -> { final_msg = s } }
    }
    assert_eq(n11, 3)
    assert_eq(final_msg, "abc")
    print("   PASS")
}

@test
fn test_return_in_try() {
    print("7. return in try")
    assert_eq(r12(), "ret")
    print("   PASS")
}

@test
fn test_return_in_catch() {
    print("8. return in catch")
    assert_eq(r13(), "caught")
    print("   PASS")
}

@test
fn test_sequential() {
    print("9. sequential try-catch")
    let s14: Array<string> = []
    try { s14.push("a"); throw AppErr.Msg("x") } catch (e) { s14.push("b") }
    try { s14.push("c"); throw AppErr.Msg("y") } catch (e) { s14.push("d") }
    assert_eq(s14.length, 4)
    assert_eq(s14[0], "a")
    assert_eq(s14[1], "b")
    assert_eq(s14[2], "c")
    assert_eq(s14[3], "d")
    print("   PASS")
}

@test
fn test_catch_rethrow_propagates() {
    print("10. catch rethrow propagates to outer")
    let a20: Array<string> = []
    let outer_msg = ""
    try {
        try {
            throw AppErr.Msg("a")
        } catch (e) {
            a20.push("inner-catch")
            throw AppErr.Msg("b")
        }
    } catch (e) {
        a20.push("outer-catch")
        match (e) { AppErr.Msg(s) -> { outer_msg = s } }
    }
    assert_eq(a20.length, 2)
    assert_eq(a20[0], "inner-catch")
    assert_eq(a20[1], "outer-catch")
    assert_eq(outer_msg, "b")
    print("   PASS")
}

@test
fn test_defer_runs_on_throw() {
    print("11. defer cleanup runs on throw")
    g8 = false
    try { fn8() } catch (e) { }
    assert_eq(g8, true)
    print("   PASS")
}

@test
fn test_defer_lifo_cleanup() {
    print("12. defer LIFO cleanup on error path")
    let order: Array<string> = []
    fn body() {
        defer { order.push("close-1") }
        defer { order.push("close-2") }
        order.push("work")
        throw AppErr.Msg("boom")
    }
    try { body() } catch (e) { order.push("handled") }
    assert_eq(order.length, 4)
    assert_eq(order[0], "work")
    assert_eq(order[1], "close-2")
    assert_eq(order[2], "close-1")
    assert_eq(order[3], "handled")
    print("   PASS")
}
