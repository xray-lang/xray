// 测试：类型转换

// ===== 转为字符串 =====

@test
fn test_int_to_string() {
    var x = 42
    var s = string(x)
    assertEqual(s, "42")
    assertEqual(typeName(s), "string")
}

@test
fn test_float_to_string() {
    var x = 3.14
    var s = string(x)
    assertEqual(s.startsWith("3.14"), true)
}

@test
fn test_bool_to_string() {
    assertEqual(string(true), "true")
    assertEqual(string(false), "false")
}

// ===== 转为整数 =====

@test
fn test_string_to_int() {
    assertEqual(i64.parse("42"), 42)
    assertEqual(i64.parse("-100"), -100)
    assertEqual(i64.parse("0"), 0)
}

@test
fn test_float_to_int() {
    assertEqual((3.7 as i64), 3)
    assertEqual((-2.9 as i64), -2)
}

// ===== 转为浮点数 =====

@test
fn test_string_to_float() {
    var f = f64.parse("3.14")
    assertEqual(f > 3.13, true)
    assertEqual(f < 3.15, true)
}

@test
fn test_int_to_float() {
    var f = (42 as f64)
    assertEqual(f, 42.0)
}

// ===== 转为布尔值 =====

@test
fn test_int_to_bool() {
    assertEqual(bool(0), false)
    assertEqual(bool(1), true)
    assertEqual(bool(-1), true)
}

@test
fn test_string_to_bool() {
    assertEqual(bool(""), false)
    assertEqual(bool("hello"), true)
}

@test
fn test_null_to_bool() {
    assertEqual(bool(null), false)
}

// ===== 数组转换 =====

@test
fn test_array_unique() {
    var arr = [1, 2, 2, 3, 3, 3]
    var s = #[1, 2, 3]  // 手动去重
    assertEqual(len(s), 3)
    assertEqual(s.contains(1), true)
    assertEqual(s.contains(2), true)
    assertEqual(s.contains(3), true)
}

