// 0911_dump_builtin.xr
// 作者：xingleixu@gmail.com
// 测试：全局 dump() builtin
//
// dump() 没有返回值（写到 stdout），无法直接断言输出内容。但 codegen
// 出错时通常表现为：1) 进程崩溃；2) 寄存器分配被破坏，dump() 之后变量
// 失效。这个测试覆盖第二类——每个 dump() 之后都用 assert 验证原变量
// 仍然可用，能抓到 OP_DUMP 字段错位等导致的寄存器读写串扰。

@test
fn test_dump_int() {
    var x = 42
    dump(x)
    assertEqual(x, 42)
}

@test
fn test_dump_float() {
    var f = 3.14
    dump(f)
    assert(f > 3.13 && f < 3.15)
}

@test
fn test_dump_string() {
    var s = "hello"
    dump(s)
    assertEqual(s, "hello")
    assertEqual(len(s), 5)
}

@test
fn test_dump_bool() {
    var b = true
    dump(b)
    assertEqual(b, true)
}

@test
fn test_dump_null() {
    var n: i64? = null
    dump(n)
    assertEqual(n == null, true)
}

@test
fn test_dump_array() {
    var a = [1, 2, 3]
    dump(a)
    assertEqual(len(a), 3)
    assertEqual(a[0], 1)
    assertEqual(a[1], 2)
    assertEqual(a[2], 3)
}

@test
fn test_dump_map() {
    // The original reported bug: dump(map) printed last value (92) instead
    // of the map. Even though stdout cannot be asserted, the codegen bug
    // also corrupted the register holding the map. This case verifies the
    // map is intact after dump().
    var scores = #{"alice": 95, "bob": 87, "charlie": 92}
    dump(scores)
    assertEqual(scores["alice"], 95)
    assertEqual(scores["bob"], 87)
    assertEqual(scores["charlie"], 92)
}

@test
fn test_dump_set() {
    var s = #[1, 2, 3]
    dump(s)
    assertEqual(len(s), 3)
    assertEqual(s.contains(2), true)
}

@test
fn test_dump_with_indent() {
    var data = #{"name": "alice", "score": 95}
    dump(data, 2)
    dump(data, 4)
    dump(data, 0)
    // After three dump() calls with different indents, the map must
    // still be intact — covers OP_DUMP B-field literal handling.
    assert(data["name"] == "alice")
    assert(data["score"] == 95)
}

@test
fn test_dump_inside_function() {
    // Regression for: dump() inside a function body must not interfere
    // with the function's return register or local variables.
    fn helper(v: i64) -> i64 {
        var doubled = v * 2
        dump(doubled)
        return doubled + 1
    }
    assertEqual(helper(10), 21)
    assertEqual(helper(0), 1)
}

@test
fn test_dump_nested_expr() {
    var arr = [10, 20, 30]
    var idx = 1
    dump(arr[idx])
    assertEqual(arr[idx], 20)
    assertEqual(idx, 1)
    assertEqual(len(arr), 3)
}

@test
fn test_dump_in_loop() {
    var total = 0
    for (i in 0..5) {
        dump(i)
        total = total + i
    }
    assertEqual(total, 10)
}

@test
fn test_dump_return_is_null() {
    // dump() is statically unit-valued; the runtime sentinel remains null.
    var r = dump(42)
    assertEqual(typeName(r), "null")
}
