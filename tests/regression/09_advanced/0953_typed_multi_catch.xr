// REGRESSION: Typed catch and multi-catch clauses.
// Parser supports catch (e: T) type annotations and multiple catch blocks.
// Single-catch, typed-catch, multi-catch with catch-all, and `defer`
// cleanup interactions are all tested.

enum CatchErr { Msg(string) }
enum OtherErr { Msg(string) }

// 1. Single catch — existing syntax unchanged
@test
fn test_single_catch() {
    let msg = ""
    try {
        throw CatchErr.Msg("single")
    } catch (e) {
        match (e) { CatchErr.Msg(s) -> { msg = s } }
    }
    assert_eq(msg, "single")
}

// 2. Typed catch — catch (e: CatchErr)
@test
fn test_typed_catch_exception() {
    let msg = ""
    try {
        throw CatchErr.Msg("typed")
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg(s) -> { msg = s } }
    }
    assert_eq(msg, "typed")
}

// 3. Typed catch + defer cleanup (defer runs at function exit, after catch)
@test
fn test_typed_catch_defer() {
    let msg = ""
    let fin = false
    fn work() {
        defer { fin = true }
        try {
            throw CatchErr.Msg("tcf")
        } catch (e: CatchErr) {
            match (e) { CatchErr.Msg(s) -> { msg = s } }
        }
    }
    work()
    assert_eq(msg, "tcf")
    assert_eq(fin, true)
}

// 4. Multi-catch: typed then catch-all
@test
fn test_multi_catch_typed_then_catchall() {
    let result = ""
    try {
        throw CatchErr.Msg("multi")
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg(s) -> { result = "typed:" + s } }
    } catch (e) {
        result = "catchall"
    }
    assert_eq(result, "typed:multi")
}

// 5. Multi-catch: all typed (CatchErr matches first)
@test
fn test_multi_catch_all_typed() {
    let result = ""
    try {
        throw CatchErr.Msg("first")
    } catch (e: CatchErr) {
        result = "match"
    }
    assert_eq(result, "match")
}

// 6. Multi-catch with defer cleanup
@test
fn test_multi_catch_defer() {
    let result = ""
    let fin = false
    fn work() {
        defer { fin = true }
        try {
            throw CatchErr.Msg("mf")
        } catch (e: CatchErr) {
            match (e) { CatchErr.Msg(s) -> { result = s } }
        } catch (e) {
            result = "catchall"
        }
    }
    work()
    assert_eq(result, "mf")
    assert_eq(fin, true)
}

// 7. Nested multi-catch with rethrow
@test
fn test_nested_multi_catch_rethrow() {
    let log: Array<string> = []
    try {
        try {
            throw CatchErr.Msg("inner")
        } catch (e: CatchErr) {
            log.push("inner-catch")
            throw CatchErr.Msg("rethrown")
        }
    } catch (e: CatchErr) {
        log.push("outer-catch")
        match (e) { CatchErr.Msg(s) -> { assert_eq(s, "rethrown") } }
    }
    assert_eq(log.length, 2)
    assert_eq(log[0], "inner-catch")
    assert_eq(log[1], "outer-catch")
}

// 8. Sequential multi-catch blocks
@test
fn test_sequential_multi_catch() {
    let a = ""
    let b = ""
    try {
        throw CatchErr.Msg("first")
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg(s) -> { a = s } }
    }
    try {
        throw CatchErr.Msg("second")
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg(s) -> { b = s } }
    }
    assert_eq(a, "first")
    assert_eq(b, "second")
}

// 9. Catch-all only (untyped)
@test
fn test_catchall_only() {
    let msg = ""
    try {
        throw CatchErr.Msg("any")
    } catch (e) {
        match (e) { CatchErr.Msg(s) -> { msg = s } }
    }
    assert_eq(msg, "any")
}

// 10. Multi-catch: catch-all catches when typed enum doesn't match
@test
fn test_multi_catch_fallthrough_to_catchall() {
    let result = ""
    try {
        throw CatchErr.Msg("fall")
    } catch (e: OtherErr) {
        result = "other"
    } catch (e) {
        match (e) { CatchErr.Msg(s) -> { result = "catchall:" + s } }
    }
    assert_eq(result, "catchall:fall")
}
