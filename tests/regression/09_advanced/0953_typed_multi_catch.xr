// REGRESSION: Typed catch and multi-catch clauses.
// Parser supports catch (e: T) type annotations and multiple catch blocks.
// Single-catch, typed-catch, multi-catch with catch-all, and `defer`
// cleanup interactions are all tested.

enum CatchErr { Msg { message: string } }
enum OtherErr { Msg { message: string } }

// 1. Single catch — existing syntax unchanged
@test
fn test_single_catch() {
    var msg = ""
    try {
        throw CatchErr.Msg { message: "single" }
    } catch (e) {
        match (e) { CatchErr.Msg { message: s } -> { msg = s } }
    }
    assertEqual(msg, "single")
}

// 2. Typed catch — catch (e: CatchErr)
@test
fn test_typed_catch_exception() {
    var msg = ""
    try {
        throw CatchErr.Msg { message: "typed" }
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg { message: s } -> { msg = s } }
    }
    assertEqual(msg, "typed")
}

// 3. Typed catch + defer cleanup (defer runs at function exit, after catch)
@test
fn test_typed_catch_defer() {
    var msg = ""
    var fin = false
    fn work() {
        defer { fin = true }
        try {
            throw CatchErr.Msg { message: "tcf" }
        } catch (e: CatchErr) {
            match (e) { CatchErr.Msg { message: s } -> { msg = s } }
        }
    }
    work()
    assertEqual(msg, "tcf")
    assertEqual(fin, true)
}

// 4. Multi-catch: typed then catch-all
@test
fn test_multi_catch_typed_then_catchall() {
    var result = ""
    try {
        throw CatchErr.Msg { message: "multi" }
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg { message: s } -> { result = "typed:" + s } }
    } catch (e) {
        result = "catchall"
    }
    assertEqual(result, "typed:multi")
}

// 5. Multi-catch: all typed (CatchErr matches first)
@test
fn test_multi_catch_all_typed() {
    var result = ""
    try {
        throw CatchErr.Msg { message: "first" }
    } catch (e: CatchErr) {
        result = "match"
    }
    assertEqual(result, "match")
}

// 6. Multi-catch with defer cleanup
@test
fn test_multi_catch_defer() {
    var result = ""
    var fin = false
    fn work() {
        defer { fin = true }
        try {
            throw CatchErr.Msg { message: "mf" }
        } catch (e: CatchErr) {
            match (e) { CatchErr.Msg { message: s } -> { result = s } }
        } catch (e) {
            result = "catchall"
        }
    }
    work()
    assertEqual(result, "mf")
    assertEqual(fin, true)
}

// 7. Nested multi-catch with rethrow
@test
fn test_nested_multi_catch_rethrow() {
    var log: Array<string> = []
    try {
        try {
            throw CatchErr.Msg { message: "inner" }
        } catch (e: CatchErr) {
            log.push("inner-catch")
            throw CatchErr.Msg { message: "rethrown" }
        }
    } catch (e: CatchErr) {
        log.push("outer-catch")
        match (e) { CatchErr.Msg { message: s } -> { assertEqual(s, "rethrown") } }
    }
    assertEqual(len(log), 2)
    assertEqual(log[0], "inner-catch")
    assertEqual(log[1], "outer-catch")
}

// 8. Sequential multi-catch blocks
@test
fn test_sequential_multi_catch() {
    var a = ""
    var b = ""
    try {
        throw CatchErr.Msg { message: "first" }
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg { message: s } -> { a = s } }
    }
    try {
        throw CatchErr.Msg { message: "second" }
    } catch (e: CatchErr) {
        match (e) { CatchErr.Msg { message: s } -> { b = s } }
    }
    assertEqual(a, "first")
    assertEqual(b, "second")
}

// 9. Catch-all only (untyped)
@test
fn test_catchall_only() {
    var msg = ""
    try {
        throw CatchErr.Msg { message: "any" }
    } catch (e) {
        match (e) { CatchErr.Msg { message: s } -> { msg = s } }
    }
    assertEqual(msg, "any")
}

// 10. Multi-catch: catch-all catches when typed enum doesn't match
@test
fn test_multi_catch_fallthrough_to_catchall() {
    var result = ""
    try {
        throw CatchErr.Msg { message: "fall" }
    } catch (e: OtherErr) {
        result = "other"
    } catch (e) {
        match (e) { CatchErr.Msg { message: s } -> { result = "catchall:" + s } }
    }
    assertEqual(result, "catchall:fall")
}
