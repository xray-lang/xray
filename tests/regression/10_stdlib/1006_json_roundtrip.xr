// Roundtrip coverage for every JSON value family.

@test
fn test_primitive_roundtrip() {
    assertEqual(JSON.require<i64>(JSON.parseValue(JSON.stringify(42)), []), 42)
    assertEqual(JSON.require<f64>(JSON.parseValue(JSON.stringify(3.14)), []), 3.14)
    assertEqual(JSON.require<bool>(JSON.parseValue(JSON.stringify(true)), []), true)
    var nothing: JSON.Value = null
    assert(JSON.isNull(JSON.parseValue(JSON.stringify(nothing))))
    assertEqual(JSON.require<string>(JSON.parseValue(JSON.stringify("hello")), []), "hello")
}

@test
fn test_nested_roundtrip() {
    var original = {
        users: [
            { name: "Alice", scores: [100, 95, 88] },
            { name: "Bob", scores: [85, 90, 92] },
        ],
        metadata: { version: 1, valid: true },
    }
    var parsed = JSON.parseValue(JSON.stringify(original))
    assertEqual(JSON.require<string>(parsed, ["users", 0, "name"]), "Alice")
    assertEqual(JSON.require<i64>(parsed, ["users", 1, "scores", 2]), 92)
    assertEqual(JSON.require<i64>(parsed, ["metadata", "version"]), 1)
    assertEqual(JSON.require<bool>(parsed, ["metadata", "valid"]), true)
}

@test
fn test_parsed_value_stability() {
    var source = "{\"a\":1,\"items\":[true,null,\"x\"]}"
    var once = JSON.parseValue(source)
    var twice = JSON.parseValue(JSON.stringify(once))
    assertEqual(twice, once)
}
