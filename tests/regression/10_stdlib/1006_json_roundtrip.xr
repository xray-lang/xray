

// 1006_json_roundtrip.xr
// 作者：xingleixu@gmail.com
// 测试：JSON 往返测试（parse -> stringify -> parse）
// 借鉴：simdjson 的往返一致性测试

// ===== 基本类型往返 =====

@test
fn test_roundtrip_null() {
    var original = null
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_true() {
    var original = true
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_false() {
    var original = false
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_integer() {
    var original = 42
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_negative_integer() {
    var original = -100
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_float() {
    var original = 3.14159
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    // 浮点数可能有精度损失，检查近似相等
    assert_eq(parsed > 3.14, true)
    assert_eq(parsed < 3.15, true)
}

@test
fn test_roundtrip_string() {
    var original = "Hello, World!"
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_empty_string() {
    var original = ""
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

// ===== 数组往返 =====

@test
fn test_roundtrip_empty_array() {
    var original: Array<int> = []
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 0)
}

@test
fn test_roundtrip_integer_array() {
    var original = [1, 2, 3, 4, 5]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 5)
    assert_eq(parsed[0], 1)
    assert_eq(parsed[4], 5)
}

@test
fn test_roundtrip_string_array() {
    var original = ["a", "b", "c"]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 3)
    assert_eq(parsed[0], "a")
    assert_eq(parsed[2], "c")
}

@test
fn test_roundtrip_mixed_array() {
    var original = [1, "two", true, null]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 4)
    assert_eq(parsed[0], 1)
    assert_eq(parsed[1], "two")
    assert_eq(parsed[2], true)
    assert_eq(parsed[3], null)
}

@test
fn test_roundtrip_nested_array() {
    var original = [[1, 2], [3, 4]]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 2)
    assert_eq(parsed[0][0], 1)
    assert_eq(parsed[1][1], 4)
}

// ===== 对象往返 =====

@test
fn test_roundtrip_empty_object() {
    var original: Json = {}
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed != null, true)
}

@test
fn test_roundtrip_simple_object() {
    var original: Json = { name: "Alice", age: 30 }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.name, "Alice")
    assert_eq(parsed.age, 30)
}

@test
fn test_roundtrip_nested_object() {
    var original: Json = { user: { name: "Bob", profile: { city: "NYC" } } }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.user.name, "Bob")
    assert_eq(parsed.user.profile.city, "NYC")
}

@test
fn test_roundtrip_object_with_array() {
    var original: Json = { numbers: [1, 2, 3], active: true }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.numbers.length, 3)
    assert_eq(parsed.numbers[0], 1)
    assert_eq(parsed.active, true)
}

// ===== Unicode 往返 =====

@test
fn test_roundtrip_chinese() {
    var original = "你好世界"
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_emoji() {
    var original = "Hello 🌍"
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_mixed_unicode() {
    var original: Json = { greeting: "你好", emoji: "🎉", text: "Hello" }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.greeting, "你好")
    assert_eq(parsed.text, "Hello")
}

// ===== 数字边界往返 =====

@test
fn test_roundtrip_zero() {
    var original = 0
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, 0)
}

@test
fn test_roundtrip_large_integer() {
    // Use max 48-bit integer (NaN Boxing limit)
    var original = 140737488355327
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

@test
fn test_roundtrip_small_float() {
    var original = 0.000001
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    // 检查近似相等
    assert_eq(parsed > 0, true)
    assert_eq(parsed < 0.00001, true)
}

@test
fn test_roundtrip_scientific() {
    var original = 1.5e10
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed, original)
}

// ===== 复杂结构往返 =====

@test
fn test_roundtrip_complex_structure() {
    var original: Json = {
        id: 12345,
        name: "Test User",
        active: true,
        score: 98.5,
        tags: ["tag1", "tag2", "tag3"],
        metadata: {
            created: "2024-01-01",
            updated: null
        }
    }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    
    assert_eq(parsed.id, 12345)
    assert_eq(parsed.name, "Test User")
    assert_eq(parsed.active, true)
    assert_eq(parsed.tags.length, 3)
    assert_eq(parsed.tags[0], "tag1")
    assert_eq(parsed.metadata.created, "2024-01-01")
    assert_eq(parsed.metadata.updated, null)
}

@test
fn test_roundtrip_array_of_objects() {
    var original: Json = [
        { id: 1, name: "First" },
        { id: 2, name: "Second" },
        { id: 3, name: "Third" }
    ]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    
    assert_eq(parsed.length, 3)
    assert_eq(parsed[0].id, 1)
    assert_eq(parsed[0].name, "First")
    assert_eq(parsed[2].id, 3)
    assert_eq(parsed[2].name, "Third")
}

// ===== 双重往返测试 =====

@test
fn test_double_roundtrip() {
    // parse -> stringify -> parse -> stringify
    var json1 = "{\"a\": 1, \"b\": [2, 3]}"
    var obj1 = Json.parse(json1)
    var json2 = Json.stringify(obj1)
    var obj2 = Json.parse(json2)
    var json3 = Json.stringify(obj2)
    var obj3 = Json.parse(json3)
    
    assert_eq(obj3.a, 1)
    assert_eq(obj3.b.length, 2)
    assert_eq(obj3.b[0], 2)
}

// ===== 一致性测试 =====

@test
fn test_consistency_array() {
    // 同样的数据，多次 stringify 应该得到相同结果
    var data = [1, 2, 3]
    var json1 = Json.stringify(data)
    var json2 = Json.stringify(data)
    assert_eq(json1, json2)
}

@test
fn test_consistency_object() {
    // 注意：对象键顺序可能不确定
    var data: Json = { a: 1 }
    var json1 = Json.stringify(data)
    var json2 = Json.stringify(data)
    // 至少两次应该包含相同内容
    assert_eq(json1.includes("a"), true)
    assert_eq(json2.includes("a"), true)
}

// ===== 边界情况往返 =====

@test
fn test_roundtrip_deep_nesting() {
    var original = [[[[[1]]]]]
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed[0][0][0][0][0], 1)
}

@test
fn test_roundtrip_many_keys() {
    var original: Json = { a: 1, b: 2, c: 3, d: 4, e: 5 }
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.a, 1)
    assert_eq(parsed.e, 5)
}

@test
fn test_roundtrip_long_string() {
    var original = "x".repeat(100)
    var jsonStr = Json.stringify(original)
    var parsed = Json.parse(jsonStr)
    assert_eq(parsed.length, 100)
    assert_eq(parsed, original)
}

@test
fn test_stringify_char_as_string() {
    assert_eq(Json.stringify('A'), "\"A\"")
    assert_eq(Json.stringify('\u{1F600}'), "\"😀\"")

    var original: Json = { letter: 'A', emoji: '\u{1F600}' }
    var parsed = Json.parse(Json.stringify(original))
    assert_eq(parsed.letter, "A")
    assert_eq(parsed.emoji, "😀")
}
