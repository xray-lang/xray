// Test HTTP header map construction and access

import http

@test
fn test_request_headers() {
    var h = #{"Content-Type": "application/json",
        "Accept": "*/*",
        "User-Agent": "xray-http/1.0",
        "Authorization": "Bearer token123"}
    assertEqual(h.get("Content-Type"), "application/json")
    assertEqual(h.get("Accept"), "*/*")
    assertEqual(h.get("Authorization"), "Bearer token123")
}

@test
fn test_common_headers() {
    var h = #{"Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "no-cache",
        "Connection": "keep-alive"}
    assert(h.get("Content-Type")!.indexOf("text/html") >= 0)
    assertEqual(h.get("Cache-Control"), "no-cache")
}

@test
fn test_empty_headers() {
    var h: Map<string, string> = #{}
    assertEqual(h.get("X-Not-Exist"), null)
}

@test
fn test_multi_value_header_split() {
    var header = "text/html, application/json, text/plain"
    var values = header.split(", ")
    assertEqual(len(values), 3)
    assertEqual(values[0], "text/html")
    assertEqual(values[2], "text/plain")
}

print("All http headers tests passed")
