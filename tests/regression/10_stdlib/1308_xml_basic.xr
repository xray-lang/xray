// 1303_xml_basic.xr - XML module tests

import xml

// ===== Basic parsing =====

@test
fn test_parse_basic() {
    var data = "<root><item>Hello</item></root>"
    var doc: Json = xml.parse(data) ?? {}
    assert_eq(doc["tag"], "root")
}

@test
fn test_parse_children() {
    var data = "<root><item>Hello</item></root>"
    var doc: Json = xml.parse(data) ?? {}
    var children = doc["children"]
    assert_eq(len(children), 1)
    assert_eq(children[0]["tag"], "item")
}

@test
fn test_parse_text() {
    var data = "<root><item>Hello</item></root>"
    var doc: Json = xml.parse(data) ?? {}
    var textNode = doc["children"][0]["children"][0]
    assert_eq(textNode["text"], "Hello")
}

// ===== Attributes =====

@test
fn test_parse_attrs() {
    var data = "<user id=\"123\" name=\"Alice\"/>"
    var doc: Json = xml.parse(data) ?? {}
    var attrs = doc["attrs"]
    assert_eq(attrs["id"], "123")
    assert_eq(attrs["name"], "Alice")
}

// ===== Nested elements =====

@test
fn test_parse_deep_nesting() {
    var data = "<root><a><b><c>deep</c></b></a></root>"
    var doc: Json = xml.parse(data) ?? {}
    var cNode = doc["children"][0]["children"][0]["children"][0]
    assert_eq(cNode["tag"], "c")
}

// ===== Multiple children =====

@test
fn test_parse_multiple_children() {
    var data = "<list><item>1</item><item>2</item><item>3</item></list>"
    var doc: Json = xml.parse(data) ?? {}
    assert_eq(len(doc["children"]), 3)
}

// ===== Create element =====

@test
fn test_create_element() {
    var elem = xml.element("div")
    assert_eq(elem["tag"], "div")
}

// ===== Empty element =====

@test
fn test_parse_empty_element() {
    var data = "<empty/>"
    var doc: Json = xml.parse(data) ?? {}
    assert_eq(doc["tag"], "empty")
    assert_eq(len(doc["children"]), 0)
}

// ===== Comments =====

@test
fn test_parse_preserve_comments() {
    var data = "<root><!-- comment --><item/></root>"
    var doc: Json = xml.parse(data, { preserveComments: true }) ?? {}
    assert_eq(len(doc["children"]), 2)
}

// ===== Stringify =====

@test
fn test_stringify_compact() {
    var data = "<msg>Hi</msg>"
    var doc: Json = xml.parse(data) ?? {}
    var str = xml.stringify(doc, { indent: 0, declaration: false })
    assert_eq(str, "<msg>Hi</msg>")
}
