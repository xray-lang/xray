// 1308_xml_basic.xr - XML module tests (typed XmlNode ADT)

import xml
import { XmlNode, XmlName, XmlAttribute } from xml

// ===== Basic parsing =====

@test
fn test_parse_basic() {
    var doc = xml.parse("<root><item>Hello</item></root>")
    assertEqual(xml.tag(doc) ?? "", "root")
}

@test
fn test_parse_children() {
    var doc = xml.parse("<root><item>Hello</item></root>")
    var children = xml.children(doc)
    assertEqual(len(children), 1)
    assertEqual(xml.tag(children[0]) ?? "", "item")
}

@test
fn test_parse_text() {
    var doc = xml.parse("<root><item>Hello</item></root>")
    var item = xml.children(doc)[0]
    assertEqual(xml.textContent(item), "Hello")
}

// ===== Attributes =====

@test
fn test_parse_attrs() {
    var doc = xml.parse("<user id=\"123\" name=\"Alice\"/>")
    assertEqual(xml.attr(doc, "id") ?? "", "123")
    assertEqual(xml.attr(doc, "name") ?? "", "Alice")
}

// ===== Nested elements =====

@test
fn test_parse_deep_nesting() {
    var doc = xml.parse("<root><a><b><c>deep</c></b></a></root>")
    var a = xml.children(doc)[0]
    var b = xml.children(a)[0]
    var c = xml.children(b)[0]
    assertEqual(xml.tag(c) ?? "", "c")
    assertEqual(xml.textContent(c), "deep")
}

// ===== Multiple children =====

@test
fn test_parse_multiple_children() {
    var doc = xml.parse("<list><item>1</item><item>2</item><item>3</item></list>")
    assertEqual(len(xml.children(doc)), 3)
}

// ===== Create element =====

@test
fn test_create_element() {
    var elem = xml.element("div")
    assertEqual(xml.tag(elem) ?? "", "div")
}

// ===== Empty element =====

@test
fn test_parse_empty_element() {
    var doc = xml.parse("<empty/>")
    assertEqual(xml.tag(doc) ?? "", "empty")
    assertEqual(len(xml.children(doc)), 0)
}

// ===== Comments =====

@test
fn test_parse_preserve_comments() {
    var doc = xml.parse("<root><!-- comment --><item/></root>",
        { preserveWhitespace: false, preserveComments: true, preserveCData: true, validateEntities: true })
    assertEqual(len(xml.children(doc)), 2)
}

// ===== Stringify =====

@test
fn test_stringify_compact() {
    var doc = xml.parse("<msg>Hi</msg>")
    var str = xml.stringify(doc, { indent: 0, declaration: false, encoding: "UTF-8" })
    assertEqual(str, "<msg>Hi</msg>")
}
