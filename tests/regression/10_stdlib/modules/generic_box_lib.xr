// generic_box_lib.xr - helper module for 1039_cross_module_generic_annotation

export class Box<T> {
    value: T
    constructor(value: T) { this.value = value }
    get() -> T { return this.value }
    lock<U>(f: fn(T) -> U) -> U { return f(this.value) }
}

export fn boxOf(value: i64) -> Box<i64> {
    return Box<i64>(value)
}
