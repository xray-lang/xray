/*
** sel_lib.xr
** Library used by 1033_selective_import_nested.xr
**
** Exports: Box class, makeBox factory, BOX_VERSION constant.
** Used to verify cross-file selective import works inside nested function bodies.
*/

export const BOX_VERSION = "1.0"

export class Box {
    width: i64
    height: i64

    constructor(w: i64, h: i64) {
        this.width = w
        this.height = h
    }

    area() -> i64 {
        return this.width * this.height
    }
}

export fn makeBox(w: i64, h: i64) -> Box {
    return Box(w, h)
}
