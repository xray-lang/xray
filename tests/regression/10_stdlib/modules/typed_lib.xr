/*
** typed_lib.xr
** Library used by 1034_cross_module_typed.xr
**
** Exports typed declarations: function with annotated params/return,
** class, constant.  Used to verify cross-module type resolution
** through the module graph (imports get concrete types, not unknown).
*/

import math

export fn double_it(n: i64) -> i64 {
    return n * 2
}

export fn greet(name: string) -> string {
    return "Hello, " + name
}

export fn first_byte(xs: Array<u8>) -> i64 {
    return xs[0] as i64
}

export fn second_uint8(xs: Array<u8>) -> i64 {
    return xs[1] as i64
}

export fn sum_byte_slice(xs: Slice<u8>) -> i64 {
    return (xs[0] as i64) + (xs[1] as i64)
}

export fn sum_uint8_slice(xs: Slice<u8>) -> i64 {
    return (xs[0] as i64) + (xs[1] as i64)
}

export fn make_uint8_bytes() -> Array<u8> {
    return [7, 8, 9]
}

export const MAGIC: i64 = 42

export class Point {
    x: i64
    y: i64

    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }

    dist() -> f64 {
        return math.sqrt((this.x * this.x + this.y * this.y) as f64)
    }
}
