// 1420_datetime_basic.xr
// Test: datetime basic functionality (dot-syntax API)

import datetime

// ============================================================
// Part 1: Date creation
// ============================================================

@test
fn test_create_full_date() {
    var dt = datetime.create(2024, 12, 25, 10, 30, 45)
    assertEqual(dt.year, 2024)
    assertEqual(dt.month, 12)
    assertEqual(dt.day, 25)
    assertEqual(dt.hour, 10)
    assertEqual(dt.minute, 30)
    assertEqual(dt.second, 45)
}

@test
fn test_create_unix_epoch() {
    var dt = datetime.create(1970, 1, 1, 0, 0, 0)
    assertEqual(dt.year, 1970)
    assertEqual(dt.month, 1)
    assertEqual(dt.day, 1)
}

@test
fn test_create_year_only() {
    var dt = datetime.create(2000)
    assertEqual(dt.year, 2000)
    assertEqual(dt.month, 1)
    assertEqual(dt.day, 1)
}

@test
fn test_create_year_month() {
    var dt = datetime.create(2024, 6)
    assertEqual(dt.year, 2024)
    assertEqual(dt.month, 6)
    assertEqual(dt.day, 1)
}

// ============================================================
// Part 2: Create from timestamp (UTC)
// ============================================================

@test
fn test_from_timestamp_zero() {
    var dt = datetime.fromTimestamp(0)
    assertEqual(dt.year, 1970)
}

@test
fn test_from_timestamp_billion() {
    var dt = datetime.fromTimestamp(1000000000)
    assertEqual(dt.year, 2001)
    assertEqual(dt.month, 9)
    assertEqual(dt.day, 9)
}

@test
fn test_from_timestamp_recent() {
    var dt = datetime.fromTimestamp(1700000000)
    assertEqual(dt.year, 2023)
}

// ============================================================
// Part 3: Timestamp access
// ============================================================

@test
fn test_timestamp_positive() {
    var dt = datetime.create(2024, 1, 1)
    var ts = dt.timestamp
    assert(ts > 0)
}

@test
fn test_timestamp_roundtrip() {
    var original_ts = 1700000000
    var dt = datetime.fromTimestamp(original_ts)
    var result_ts = dt.timestamp
    assertEqual(result_ts, original_ts)
}

// ============================================================
// Part 4: Current time
// ============================================================

@test
fn test_now_returns_valid_date() {
    var dt = datetime.now()
    assert(dt.year >= 2024)
}

@test
fn test_utc_returns_valid_date() {
    var dt = datetime.utc()
    assert(dt.year >= 2024)
}

@test
fn test_now_timestamp_positive() {
    var dt = datetime.now()
    var ts = dt.timestamp
    assert(ts > 1700000000)
}

// ============================================================
// Part 5: Millisecond support
// ============================================================

@test
fn test_millisecond_default_zero() {
    var dt = datetime.create(2024, 6, 15)
    assertEqual(dt.millisecond, 0)
}

@test
fn test_from_timestamp_ms() {
    var dt = datetime.fromTimestampMs(1700000000123)
    assertEqual(dt.timestamp, 1700000000)
    assertEqual(dt.millisecond, 123)
}
