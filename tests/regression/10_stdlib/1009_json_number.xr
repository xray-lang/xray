

// 1001_json_number.xr
// 作者：xingleixu@gmail.com
// 测试：JSON 数字解析边界测试
// 借鉴：simdjson 的 powers_of_two, small_integers, nines 测试

// ===== 小整数测试（-1024 到 1024）=====

@test
fn test_small_integers() {
    // 正整数
    assertEqual(JSON.parse<i64>("0"), 0)
    assertEqual(JSON.parse<i64>("1"), 1)
    assertEqual(JSON.parse<i64>("10"), 10)
    assertEqual(JSON.parse<i64>("100"), 100)
    assertEqual(JSON.parse<i64>("1000"), 1000)
    assertEqual(JSON.parse<i64>("1024"), 1024)
    
    // 负整数
    assertEqual(JSON.parse<i64>("-1"), -1)
    assertEqual(JSON.parse<i64>("-10"), -10)
    assertEqual(JSON.parse<i64>("-100"), -100)
    assertEqual(JSON.parse<i64>("-1000"), -1000)
    assertEqual(JSON.parse<i64>("-1024"), -1024)
}

@test
fn test_integer_boundaries() {
    // 32 位整数边界
    assertEqual(JSON.parse<i64>("2147483647"), 2147483647)      // INT32_MAX
    assertEqual(JSON.parse<i64>("-2147483648"), -2147483648)    // INT32_MIN
    
    // 超过 32 位的整数
    assertEqual(JSON.parse<i64>("2147483648"), 2147483648)      // INT32_MAX + 1
    assertEqual(JSON.parse<i64>("-2147483649"), -2147483649)    // INT32_MIN - 1
}

@test
fn test_large_integers() {
    // Full 64-bit integer range (Tagged Union)
    assertEqual(JSON.parse<i64>("140737488355327"), 140737488355327)
    assertEqual(JSON.parse<i64>("-140737488355327"), -140737488355327)
    
    // Large integers within int64 range are parsed as int64
    var large = JSON.parse<i64>("9007199254740992")
    assertEqual(typeName(large), "i64")
    assertEqual(large, 9007199254740992)
}

// ===== 浮点数测试 =====

@test
fn test_simple_floats() {
    assertEqual(JSON.parse<f64>("0.0"), 0.0)
    assertEqual(JSON.parse<f64>("1.0"), 1.0)
    assertEqual(JSON.parse<f64>("-1.0"), -1.0)
    assertEqual(JSON.parse<f64>("3.14"), 3.14)
    assertEqual(JSON.parse<f64>("-3.14"), -3.14)
}

@test
fn test_float_precision() {
    // 测试浮点精度（借鉴 simdjson 的 nines 测试）
    assertEqual(JSON.parse<f64>("0.1"), 0.1)
    assertEqual(JSON.parse<f64>("0.01"), 0.01)
    assertEqual(JSON.parse<f64>("0.001"), 0.001)
    assertEqual(JSON.parse<f64>("0.0001"), 0.0001)
    assertEqual(JSON.parse<f64>("0.00001"), 0.00001)
}

@test
fn test_negative_zero() {
    // 负零
    var nz = JSON.parse<f64>("-0.0")
    assertEqual(nz, 0.0)  // -0.0 == 0.0 在数值上相等
}

// ===== 科学计数法测试 =====

@test
fn test_scientific_notation_positive_exp() {
    assertEqual(JSON.parse<f64>("1e0"), 1.0)
    assertEqual(JSON.parse<f64>("1e1"), 10.0)
    assertEqual(JSON.parse<f64>("1e2"), 100.0)
    assertEqual(JSON.parse<f64>("1e3"), 1000.0)
    assertEqual(JSON.parse<f64>("1e10"), 1e10)
}

@test
fn test_scientific_notation_negative_exp() {
    assertEqual(JSON.parse<f64>("1e-1"), 0.1)
    assertEqual(JSON.parse<f64>("1e-2"), 0.01)
    assertEqual(JSON.parse<f64>("1e-3"), 0.001)
    assertEqual(JSON.parse<f64>("1e-6"), 1e-6)
    assertEqual(JSON.parse<f64>("1e-10"), 1e-10)
}

@test
fn test_scientific_notation_uppercase() {
    // 大写 E
    assertEqual(JSON.parse<f64>("1E2"), 100.0)
    assertEqual(JSON.parse<f64>("1E-2"), 0.01)
    assertEqual(JSON.parse<f64>("2.5E3"), 2500.0)
}

@test
fn test_scientific_notation_with_plus() {
    // 显式正号
    assertEqual(JSON.parse<f64>("1e+2"), 100.0)
    assertEqual(JSON.parse<f64>("1E+2"), 100.0)
    assertEqual(JSON.parse<f64>("5e+0"), 5.0)
}

@test
fn test_scientific_notation_complex() {
    // 复杂科学计数法
    assertEqual(JSON.parse<f64>("-1.23e4"), -12300.0)
    assertEqual(JSON.parse<f64>("1.23e-4"), 0.000123)
    assertEqual(JSON.parse<f64>("-1.23e-4"), -0.000123)
    assertEqual(JSON.parse<f64>("1.5e10"), 1.5e10)
}

// ===== 边界值测试 =====

@test
fn test_very_small_floats() {
    // 非常小的浮点数
    assertEqual(JSON.parse<f64>("1e-100"), 1e-100)
    assertEqual(JSON.parse<f64>("1e-200"), 1e-200)
    assertEqual(JSON.parse<f64>("1e-300"), 1e-300)
}

@test
fn test_very_large_floats() {
    // 非常大的浮点数
    assertEqual(JSON.parse<f64>("1e100"), 1e100)
    assertEqual(JSON.parse<f64>("1e200"), 1e200)
    assertEqual(JSON.parse<f64>("1e300"), 1e300)
}

@test
fn test_max_precision_integers() {
    // Full 64-bit int range (Tagged Union)
    var n = JSON.parse<i64>("72057594037927935")
    assertEqual(typeName(n), "i64")
    assertEqual(n, 72057594037927935)
}

// ===== 特殊格式测试 =====

@test
fn test_leading_zeros_in_fraction() {
    // 小数部分前导零
    assertEqual(JSON.parse<f64>("1.0001"), 1.0001)
    assertEqual(JSON.parse<f64>("1.00001"), 1.00001)
    assertEqual(JSON.parse<f64>("0.000001"), 0.000001)
}

@test
fn test_trailing_zeros() {
    // 尾随零
    assertEqual(JSON.parse<f64>("1.00"), 1.0)
    assertEqual(JSON.parse<f64>("1.000"), 1.0)
    assertEqual(JSON.parse<f64>("10.0"), 10.0)
}

@test
fn test_nines_pattern() {
    // Large integer nines pattern: beyond 48-bit, parsed as float
    var n1 = JSON.parse<f64>("9999999999999999999")
    assertEqual(typeName(n1), "f64")
    assertEqual(n1 > 9e18, true)
    // Float nines patterns
    var n2 = JSON.parse<f64>("999999999999999999.9")
    assertEqual(n2 > 9e17, true)
    var n3 = JSON.parse<f64>("99999999999999999.99")
    assertEqual(n3 > 9e16, true)
    var n4 = JSON.parse<f64>("0.9999999999999999999")
    assertEqual(n4 > 0.999, true)
    assertEqual(n4 <= 1.0, true)
}

// ===== 数组中的数字 =====

@test
fn test_numbers_in_array() {
    var arr = JSON.parseValue("[1, 2.5, -3, 1e10, -1.5e-3]")
    assertEqual(len(JSON.asArray(arr)!), 5)
    assertEqual(JSON.require<i64>(arr, [0]), 1)
    assertEqual(JSON.require<f64>(arr, [1]), 2.5)
    assertEqual(JSON.require<i64>(arr, [2]), -3)
    assertEqual(JSON.require<f64>(arr, [3]), 1e10)
    assertEqual(JSON.require<f64>(arr, [4]), -1.5e-3)
}

// ===== 对象中的数字 =====

@test
fn test_numbers_in_object() {
    var obj = JSON.parseValue("{\"intVal\": 42, \"floatVal\": 3.14, \"sci\": 1e10, \"neg\": -100}")
    assertEqual(JSON.require<i64>(obj, ["intVal"]), 42)
    assertEqual(JSON.require<f64>(obj, ["floatVal"]), 3.14)
    assertEqual(JSON.require<f64>(obj, ["sci"]), 1e10)
    assertEqual(JSON.require<i64>(obj, ["neg"]), -100)
}

// ===== 边界溢出测试（应返回 Infinity 或特殊处理）=====

@test
fn test_overflow_to_infinity() {
    // 超大指数应该返回 Infinity
    var inf = JSON.parse<f64>("1e309")
    assertEqual(inf > 1e308, true)  // 应该是 Infinity
}

@test
fn test_underflow_to_zero() {
    // 超小指数应该返回 0
    var zero = JSON.parse<f64>("1e-400")
    assertEqual(zero, 0.0)
}
