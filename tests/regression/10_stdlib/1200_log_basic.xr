// 1200_log_basic.xr - Log module tests

import log
import { LogFormat, LogLevel } from log

// ===== Typed levels =====

@test
fn test_log_level_ordering() {
    assertEqual(log.isEnabled(LogLevel.Fatal), true)
    assertEqual(LogLevel.Debug == LogLevel.Debug, true)
    assertEqual(LogLevel.Debug == LogLevel.Info, false)
}

// ===== isEnabled =====

@test
fn test_is_enabled_default() {
    // Default level is Info
    assertEqual(log.isEnabled(LogLevel.Info), true)
    assertEqual(log.isEnabled(LogLevel.Error), true)
    assertEqual(log.isEnabled(LogLevel.Debug), false)
}

@test
fn test_set_level() {
    log.setLevel(LogLevel.Debug)
    assertEqual(log.isEnabled(LogLevel.Debug), true)
    // Restore default
    log.setLevel(LogLevel.Info)
    assertEqual(log.isEnabled(LogLevel.Debug), false)
}

// ===== Log output (should not crash) =====

@test
fn test_log_functions() {
    log.setLevel(LogLevel.Debug)
    log.debug("debug message")
    log.info("info message")
    log.warn("warning message")
    log.error("error message")
    log.setLevel(LogLevel.Info)
}

@test
fn test_log_with_attrs() {
    log.info("server started", "port", 8080, "host", "localhost")
}

// ===== Format =====

@test
fn test_log_json_format() {
    log.setFormat(LogFormat.JSON)
    log.info("json format test", "key", "value")
    log.setFormat(LogFormat.Text)
}
