// 1436_net_halfclose_bidi.xr
// TCP half-close and copyBidirectional.

import net
import { NetError } from net

fn tryListen(backlog: int) -> NetListener? {
    try {
        return net.listen(0, backlog)
    } catch (e: NetError) {
        return null
    }
}

fn serveReadUntilEof(c: NetConn) {
    var total = 0
    while (true) {
        var data = net.readBytes(c)
        if (data == null) {
            break
        }
        total = total + len(data!)
    }
    if (total == 4) {
        // "done"
        net.writeBytes(c, Array<byte>([100, 111, 110, 101]))
    } else {
        // "bad"
        net.writeBytes(c, Array<byte>([98, 97, 100]))
    }
    net.close(c)
}

fn acceptReadUntilEof(lst: NetListener) {
    var c = net.accept(lst)!
    go serveReadUntilEof(c)
}

fn serveUpstreamEcho(lst: NetListener) {
    var c = net.accept(lst)!
    net.copy(c, c)
    net.close(c)
}

fn serveProxyOnce(lst: NetListener, upstreamPort: int) {
    var client = net.accept(lst)!
    var upstream = net.dial("127.0.0.1", upstreamPort)
    var stats = net.copyBidirectional(client, upstream)
    assert_true(stats.aToB >= 4)
    assert_true(stats.bToA >= 4)
    net.close(client)
    net.close(upstream)
}

@test
fn test_shutdown_write_allows_response() {
    var maybeLst = tryListen(8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = lst.port()
    go acceptReadUntilEof(lst)

    var c = net.dial("127.0.0.1", port)
    // "body"
    assert_eq(net.writeBytes(c, Array<byte>([98, 111, 100, 121])), 4)
    assert_true(net.shutdownWrite(c))

    var resp = Array<byte>(8)
    var n = net.readInto(c, ref resp)
    assert_eq(n, 4)
    // "done"
    assert_eq(resp[0], 100)
    assert_eq(resp[1], 111)
    assert_eq(resp[2], 110)
    assert_eq(resp[3], 101)

    net.close(c)
    net.close(lst)
}

@test
fn test_copy_bidirectional_proxy_echo() {
    var maybeUpstreamLst = tryListen(8)
    if (maybeUpstreamLst == null) { return }
    var upstreamLst = maybeUpstreamLst!
    var upstreamPort = upstreamLst.port()
    go serveUpstreamEcho(upstreamLst)

    var maybeProxyLst = tryListen(8)
    if (maybeProxyLst == null) {
        net.close(upstreamLst)
        return
    }
    var proxyLst = maybeProxyLst!
    var proxyPort = proxyLst.port()
    go serveProxyOnce(proxyLst, upstreamPort)

    var c = net.dial("127.0.0.1", proxyPort)
    // "ping"
    assert_eq(net.writeBytes(c, Array<byte>([112, 105, 110, 103])), 4)
    var resp = Array<byte>(8)
    var n = net.readInto(c, ref resp)
    assert_eq(n, 4)
    assert_eq(resp[0], 112)
    assert_eq(resp[1], 105)
    assert_eq(resp[2], 110)
    assert_eq(resp[3], 103)
    assert_true(net.shutdownWrite(c))

    // Clean EOF after the proxy drains: readBytes returns null and
    // lastError stays null, so EOF is distinguishable from an error.
    var eof = net.readBytes(c)
    assert_true(eof == null)
    assert_true(net.lastError(c) == null)

    net.close(c)
    net.close(proxyLst)
    net.close(upstreamLst)
}
