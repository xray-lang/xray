// Test regex module - compile, test, find, replace, split

import regex

// @test compile and test
@test
fn test_compile_and_test() {
    var re = regex.compile("\\d+")
    assertEqual(regex.test(re, "abc123"), true)
    assertEqual(regex.test(re, "no digits"), false)
}

// The Regex.test / .find / .findAll / ... instance methods are gone. They were
// class_method rows dispatching into C, and the engine is Xray now; a C method
// that forwarded into Xray would be exactly the compatibility shim this
// migration exists to avoid. Every operation is a module function.
@test
fn test_module_functions() {
    var re = regex.compile("([a-z]+)(\\d+)")
    assertEqual(regex.test(re, "abc123"), true)

    var found = regex.find(re, "abc123 xyz456")
    assert(found != null)
    assertEqual(found!.text, "abc123")

    assertEqual(regex.findText(re, "abc123 xyz456"), "abc123")
    assertEqual(regex.findGroup(re, "abc123 xyz456", 1), "abc")
    assertEqual(regex.findGroup(re, "abc123 xyz456", 2), "123")

    var all = regex.findAll(re, "abc123 xyz456")
    assertEqual(len(all), 2)

    assertEqual(regex.replace(re, "abc123 xyz456", "N"), "N xyz456")

    var comma = regex.compile(",\\s*")
    var parts = regex.split(comma, "a, b, c")
    assertEqual(len(parts), 3)
    assertEqual(parts[2], "c")
}

// @test find with positions
@test
fn test_find() {
    var re = regex.compile("\\d+")
    var result = regex.find(re, "abc123def")
    assert(result != null)
    assertEqual(result!.start, 3)
    assertEqual(result!.end, 6)
    assertEqual(result!.groups[0], "123")
}

// @test capture groups
@test
fn test_capture_groups() {
    var re = regex.compile("(\\w+)@(\\w+)")
    var result = regex.find(re, "contact: user@host.com")
    assert(result != null)
    var groups = result!.groups
    assertEqual(groups[0], "user@host")
    assertEqual(groups[1], "user")
    assertEqual(groups[2], "host")
}

// @test fullFind (entire string must match)
@test
fn test_full_find() {
    var re = regex.compile("[a-z]+")
    assert(regex.fullFind(re, "hello") != null)
    assertEqual(regex.fullFind(re, "hello123"), null)
}

// @test replace (first occurrence)
@test
fn test_replace() {
    var re = regex.compile("\\s+")
    assertEqual(regex.replace(re, "hello   world", "_"), "hello_world")
}

// @test replaceAll
@test
fn test_replace_all() {
    var re = regex.compile("\\s+")
    assertEqual(regex.replaceAll(re, "a   b   c", "-"), "a-b-c")
}

// @test split
@test
fn test_split() {
    var re = regex.compile(",\\s*")
    var parts = regex.split(re, "a, b, c, d")
    assertEqual(len(parts), 4)
    assertEqual(parts[0], "a")
    assertEqual(parts[1], "b")
    assertEqual(parts[3], "d")
}

// @test escape
@test
fn test_escape() {
    var escaped = regex.escape("a.b*c?")
    assert(escaped.contains("\\."))
    assert(escaped.contains("\\*"))
}

// @test isValid
@test
fn test_is_valid() {
    assertEqual(regex.isValid("\\d+"), true)
    assertEqual(regex.isValid("["), false)
}

print("All regex tests passed")
