// Test regex module - compile, test, find, replace, split

import regex

// @test compile and test
@test
fn test_compile_and_test() {
    var re = regex.compile("\\d+")
    assert_eq(regex.test(re, "abc123"), true)
    assert_eq(regex.test(re, "no digits"), false)
}

// @test instance methods
@test
fn test_instance_methods() {
    var re = regex.compile("([a-z]+)(\\d+)")
    assert_eq(re.test("abc123"), true)

    var found = re.find("abc123 xyz456")
    assert(found != null)
    assert_eq(found!.text, "abc123")

    assert_eq(re.findText("abc123 xyz456"), "abc123")
    assert_eq(re.findGroup("abc123 xyz456", 1), "abc")
    assert_eq(re.findGroup("abc123 xyz456", 2), "123")

    var all = re.findAll("abc123 xyz456")
    assert_eq(len(all), 2)

    assert_eq(re.replace("abc123 xyz456", "N"), "N xyz456")

    var comma = regex.compile(",\\s*")
    var parts = comma.split("a, b, c")
    assert_eq(len(parts), 3)
    assert_eq(parts[2], "c")
}

// @test find with positions
@test
fn test_find() {
    var re = regex.compile("\\d+")
    var result = regex.find(re, "abc123def")
    assert(result != null)
    assert_eq(result!.start, 3)
    assert_eq(result!.end, 6)
    assert_eq(result!.groups[0], "123")
}

// @test capture groups
@test
fn test_capture_groups() {
    var re = regex.compile("(\\w+)@(\\w+)")
    var result = regex.find(re, "contact: user@host.com")
    assert(result != null)
    var groups = result!.groups
    assert_eq(groups[0], "user@host")
    assert_eq(groups[1], "user")
    assert_eq(groups[2], "host")
}

// @test fullFind (entire string must match)
@test
fn test_full_find() {
    var re = regex.compile("[a-z]+")
    assert(regex.fullFind(re, "hello") != null)
    assert_eq(regex.fullFind(re, "hello123"), null)
}

// @test replace (first occurrence)
@test
fn test_replace() {
    var re = regex.compile("\\s+")
    assert_eq(regex.replace(re, "hello   world", "_"), "hello_world")
}

// @test replaceAll
@test
fn test_replace_all() {
    var re = regex.compile("\\s+")
    assert_eq(regex.replaceAll(re, "a   b   c", "-"), "a-b-c")
}

// @test split
@test
fn test_split() {
    var re = regex.compile(",\\s*")
    var parts = regex.split(re, "a, b, c, d")
    assert_eq(len(parts), 4)
    assert_eq(parts[0], "a")
    assert_eq(parts[1], "b")
    assert_eq(parts[3], "d")
}

// @test escape
@test
fn test_escape() {
    var escaped = regex.escape("a.b*c?")
    assert(escaped.contains("\\."))
    assert(escaped.contains("\\*"))
}

// @test isValid
@test
fn test_is_valid() {
    assert_eq(regex.isValid("\\d+"), true)
    assert_eq(regex.isValid("["), false)
}

print("All regex tests passed")
