import text

// 1151_string_translate.xr - text.translate (Unicode-aware scalar mapping)

@test
fn test_translate_basic_ascii() {
    var COMP = #{"A": "T", "T": "A", "C": "G", "G": "C"}
    assertEqual(text.translate("ACGT", COMP), "TGCA")
    assertEqual(text.translate("AAAA", COMP), "TTTT")
    assertEqual(text.translate("CCCC", COMP), "GGGG")
    assertEqual(text.translate("", COMP), "")
}

@test
fn test_translate_partial() {
    var partial = #{"A": "X"}
    assertEqual(text.translate("ABCD", partial), "XBCD")
    assertEqual(text.translate("AAAA", partial), "XXXX")
}

@test
fn test_translate_unicode() {
    var cnTable = #{"你": "我", "好": "坏"}
    assertEqual(text.translate("你好", cnTable), "我坏")
    assertEqual(text.translate("你好你", cnTable), "我坏我")
}

@test
fn test_translate_empty_table() {
    var empty: Map<string, string> = #{}
    assertEqual(text.translate("ABC", empty), "ABC")
}

@test
fn test_translate_with_reverse() {
    // Byte-level reverse used to live on String; now reverse() is
    // Unicode-aware and round-trips through translate for ASCII data.
    var COMP = #{"A": "T", "T": "A", "C": "G", "G": "C"}
    assertEqual(text.translate(text.reverseRunes("ACGTACGT"), COMP), "ACGTACGT")
    assertEqual(text.translate(text.reverseRunes("AACC"), COMP), "GGTT")
}
