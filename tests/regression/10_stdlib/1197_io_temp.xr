// Temporary paths are built from the root the os module reports, joined once.
// A root that already ends in a separator must not produce a doubled one: the
// platform hands one over routinely, since macOS sets TMPDIR with a trailing
// slash.

import io
import os
import { Path } from path

fn hasDoubleSlash(text: string) -> bool {
    for (var i = 1; i < len(text); i++) {
        if (text.slice(i - 1, i) == "/" && text.slice(i, i + 1) == "/") { return true }
    }
    return false
}

fn restoreTmpdir(saved: string?) {
    if (saved != null) { assert(os.setenv("TMPDIR", saved!)) }
    else { assert(os.unsetenv("TMPDIR")) }
}

@test
fn test_temp_dir_is_created_and_is_a_directory() {
    var dir = io.tempDir()
    assert(dir != null)
    assert(io.isDir(dir!))
    io.removeAll(dir!)
}

@test
fn test_temp_file_is_created_and_is_a_file() {
    var file = io.tempFile()
    assert(file != null)
    assert(io.isFile(file!))
    io.remove(file!)
}

@test
fn test_a_trailing_separator_in_the_root_is_not_doubled() {
    const saved = os.getenv("TMPDIR")
    var base = io.tempDir()!
    var set = false
    var dir: Path? = null
    {
        defer { restoreTmpdir(saved) }
        set = os.setenv("TMPDIR", base.toString() + "/")
        if (set) { dir = io.tempDir() }
    }
    var removedDir = true
    if (dir != null) { removedDir = io.removeAll(dir!) }
    var removedBase = io.removeAll(base)
    assert(set)
    assert(dir != null)
    assertEqual(hasDoubleSlash(dir!.toString()), false)
    assert(removedDir)
    assert(removedBase)
}

@test
fn test_the_root_comes_from_the_environment() {
    var base = io.tempDir()!
    const saved = os.getenv("TMPDIR")
    var set = false
    var inner: Path? = null
    {
        defer { restoreTmpdir(saved) }
        set = os.setenv("TMPDIR", base.toString())
        if (set) { inner = io.tempDir() }
    }
    var removedBase = io.removeAll(base)
    assert(set)
    assert(inner != null)
    // Created inside the root the environment named.
    assert(inner!.toString().indexOf(base.toString()) == 0)
    assert(removedBase)
}

@test
fn test_two_calls_do_not_collide() {
    var a = io.tempDir()!
    var b = io.tempDir()!
    assert(a.toString() != b.toString())
    io.removeAll(a)
    io.removeAll(b)
}
