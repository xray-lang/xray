import cluster
import { ClusterConfig, ClusterDiscoveryAnnouncement, ClusterInfo, ClusterTlsOptions } from cluster

@test
fn test_xray_owned_discovery_protocol_and_admission() {
    var value: ClusterDiscoveryAnnouncement = {
        name: "node-a",
        port: 47201,
        clusterHash: 0x0102030405060708 as u64
    }
    var packet = cluster.encodeDiscoveryAnnouncement(value)
    assert(packet != null)
    assertEqual(len(packet!), 22)
    assertEqual(packet![0], 0x58)
    assertEqual(packet![1], 0x52)
    assertEqual(packet![2], 0x44)
    assertEqual(packet![3], 0x59)
    assertEqual(packet![4], 2)
    assertEqual(packet![5], 6)
    assertEqual(packet![12], 0xB8)
    assertEqual(packet![13], 0x61)
    for (var i = 0; i < 8; i++) { assertEqual(packet![14 + i], (i + 1) as u8) }

    var decoded = cluster.decodeDiscoveryAnnouncement(packet!)
    assert(decoded != null)
    assertEqual(decoded!.name, "node-a")
    assertEqual(decoded!.port, 47201)
    assertEqual(decoded!.clusterHash, value.clusterHash)

    var connected: Array<string> = ["node-b"]
    var departed: Array<string> = []
    assert(cluster.shouldJoinDiscoveredNode("self", connected, departed, decoded!,
                                            value.clusterHash))
    connected.push("node-a")
    assert(!cluster.shouldJoinDiscoveredNode("self", connected, departed, decoded!,
                                             value.clusterHash))
    connected.clear()
    departed.push("node-a")
    assert(!cluster.shouldJoinDiscoveredNode("self", connected, departed, decoded!,
                                             value.clusterHash))
}

@test
fn test_xray_owned_admission_policy() {
    assert(cluster.validNodeName("node-a"))
    assert(!cluster.validNodeName("bad\nnode"))
    assert(cluster.validCoroutineName("worker-1"))
    assert(!cluster.validCoroutineName("bad\nworker"))
    assert(cluster.validTopicName("service.echo"))
    assert(!cluster.validTopicName("service bad"))
    assert(!cluster.validTopicPattern("service.\tbad"))

    var longSecret: ClusterConfig = {
        name: "invalid-secret",
        port: 0,
        secret: "0123456789012345678901234567890123456789012345678901234567890123",
        tls: null
    }
    assert(!cluster.start(longSecret))

    var incompleteTls: ClusterTlsOptions = {
        enabled: true,
        caFile: null,
        certFile: "server.crt",
        keyFile: null,
        insecure: false
    }
    var incompleteTlsConfig: ClusterConfig = {
        name: "invalid-tls",
        port: 0,
        secret: null,
        tls: incompleteTls
    }
    assert(!cluster.start(incompleteTlsConfig))
}

@test
fn test_xray_owned_health_and_tombstone_policy() {
    assertEqual(cluster.heartbeatTickInterval(100), 500)
    assertEqual(cluster.heartbeatTickInterval(5000), 2500)

    var detector = cluster.PhiDetector(5000)
    detector.record(1000)
    detector.record(6000)
    detector.record(11000)
    assertEqual(detector.sampleCount, 2)
    assert(detector.value(11000) < 0.001)
    var oneIntervalLate = detector.value(16000)
    assert(oneIntervalLate > 0.30 && oneIntervalLate < 0.31)
    for (var i = 0; i < cluster.PHI_WINDOW_SIZE + 20; i++) {
        detector.record(16000 + i * 5000)
    }
    assertEqual(detector.sampleCount, cluster.PHI_WINDOW_SIZE)

    assert(!cluster.heartbeatIsDead(99.0, 2, 14999, 2, 15000, 3))
    assert(cluster.heartbeatIsDead(99.0, 3, 0, 0, 15000, 3))
    assert(cluster.heartbeatIsDead(0.0, 2, 15001, 2, 15000, 3))

    assert(cluster.tombstoneIsLive(1000, 60999))
    assert(!cluster.tombstoneIsLive(1000, 61000))
    assert(cluster.tombstoneIsLive(1000, 999))
}

@test
fn test_typed_start_and_info() {
    var config: ClusterConfig = {
        name: "typed-control-test",
        port: 0,
        secret: null,
        tls: null
    }
    assert(cluster.start(config))

    var info: ClusterInfo = cluster.info()!
    assertEqual(info.self, "typed-control-test")
    assertEqual(info.port, 0)
    assert(info.running)
    assertEqual(len(info.nodes), 0)
    assertEqual(info.listeners, 0)
    assert(!info.tls.enabled)
    assert(!info.tls.clientReady)
    assert(!info.tls.serverReady)

    cluster.stop()
    assert(cluster.info() == null)
}
