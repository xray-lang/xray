import cluster
import { ClusterConfig, ClusterInfo } from cluster

@test
fn test_typed_start_and_info() {
    var config: ClusterConfig = {
        name: "typed-control-test",
        port: 0,
        secret: null,
        tls: null
    }
    assert(cluster.start(config))

    var info: ClusterInfo = cluster.info()!
    assertEqual(info.self, "typed-control-test")
    assertEqual(info.port, 0)
    assert(info.running)
    assertEqual(len(info.nodes), 0)
    assertEqual(info.listeners, 0)
    assert(!info.tls.enabled)
    assert(!info.tls.clientReady)
    assert(!info.tls.serverReady)

    cluster.stop()
    assert(cluster.info() == null)
}
