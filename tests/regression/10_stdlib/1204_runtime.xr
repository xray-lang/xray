// Test runtime module - RC memory introspection and cycle collection control

import runtime

// @test runtime.isCycleCollectionEnabled returns bool
@test
fn test_mem_is_cycle_collection_enabled() {
    let running = runtime.isCycleCollectionEnabled()
    assert_eq(typeof(running), "bool")
}

// @test runtime.liveBytes returns non-negative
@test
fn test_mem_live_bytes() {
    let bytes = runtime.liveBytes()
    assert(bytes >= 0)
}

// @test runtime.liveObjects returns non-negative
@test
fn test_mem_live_objects() {
    let objs = runtime.liveObjects()
    assert(objs >= 0)
}

// @test runtime.collectCycles does not crash
@test
fn test_mem_collect_cycles() {
    runtime.collectCycles()
    assert(true)
}

// @test runtime.info()["cycleCollections"] returns non-negative
@test
fn test_mem_cycle_collections() {
    let c = runtime.info()["cycleCollections"]
    assert(c >= 0)
}

// @test allocation increases memory
@test
fn test_alloc_increases_memory() {
    runtime.collectCycles()
    let before = runtime.liveBytes()
    let arr: Array<string> = []
    for (let i = 0; i < 100; i++) {
        arr.push("item_" + string(i))
    }
    let after = runtime.liveBytes()
    assert(after >= before)
}

print("All mem tests passed")
