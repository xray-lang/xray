// 1191_io_edge.xr - IO module edge case tests

import io

// ===== Non-existent file =====

@test
fn test_read_nonexistent() {
    let content = io.readFile("/tmp/xray_nonexistent_file_12345.txt")
    assert_eq(content, null)
}

@test
fn test_exists_nonexistent() {
    assert_eq(io.exists("/tmp/xray_nonexistent_path_12345"), false)
}

@test
fn test_is_file_nonexistent() {
    assert_eq(io.isFile("/tmp/xray_nonexistent_12345"), false)
}

@test
fn test_is_dir_nonexistent() {
    assert_eq(io.isDir("/tmp/xray_nonexistent_12345"), false)
}

// ===== Empty file =====

@test
fn test_write_empty() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "")
    assert_eq(io.fileSize(tmp), 0)
    let content = io.readFile(tmp) ?? ""
    assert_eq(content, "")
    io.remove(tmp)
}

// ===== Overwrite =====

@test
fn test_overwrite_file() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "first content")
    io.writeFile(tmp, "second")
    assert_eq(io.readFile(tmp) ?? "", "second")
    assert_eq(io.fileSize(tmp), 6)
    io.remove(tmp)
}

// ===== Large content =====

@test
fn test_large_write_read() {
    let tmp = io.tempFile() ?? ""
    let data = ""
    for (let i = 0; i < 100; i++) {
        data = data + "line " + string(i) + "\n"
    }
    io.writeFile(tmp, data)
    let content = io.readFile(tmp) ?? ""
    assert_eq(content, data)
    io.remove(tmp)
}

// ===== readDirRecursive =====

@test
fn test_read_dir_recursive() {
    let tmpDir = io.tempDir() ?? ""
    io.mkdirp(tmpDir + "/a/b")
    io.writeFile(tmpDir + "/file1.txt", "1")
    io.writeFile(tmpDir + "/a/file2.txt", "2")
    io.writeFile(tmpDir + "/a/b/file3.txt", "3")
    let all = io.readDirRecursive(tmpDir)
    assert(all.length >= 3)
    io.removeAll(tmpDir)
}

// ===== mkdirp existing directory and trailing slashes =====

@test
fn test_mkdirp_existing_and_trailing_slashes() {
    let tmpDir = io.tempDir() ?? ""
    let nested = tmpDir + "/a/b"
    assert_eq(io.mkdirp(nested), true)
    assert_eq(io.mkdirp(nested), true)
    assert_eq(io.mkdirp(nested + "///"), true)
    assert_eq(io.isDir(nested), true)
    io.removeAll(tmpDir)
}

// ===== Remove non-existent =====

@test
fn test_remove_nonexistent() {
    // Should not crash
    io.remove("/tmp/xray_nonexistent_file_12345.txt")
}

// ===== readLines empty file =====

@test
fn test_read_lines_empty() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "")
    let lines = io.readLines(tmp)
    assert_eq(lines.length, 0)
    io.remove(tmp)
}

// ===== readLines single line (no newline) =====

@test
fn test_read_lines_single() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "single line")
    let lines = io.readLines(tmp)
    assert_eq(lines.length, 1)
    assert_eq(lines[0], "single line")
    io.remove(tmp)
}

// ===== readLines trailing newline does not add final empty line =====

@test
fn test_read_lines_trailing_newline() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "alpha\n")
    let lines = io.readLines(tmp)
    assert_eq(lines.length, 1)
    assert_eq(lines[0], "alpha")
    io.remove(tmp)
}

// ===== readLines middle empty lines and CRLF =====

@test
fn test_read_lines_middle_empty_and_crlf() {
    let tmp = io.tempFile() ?? ""
    io.writeFile(tmp, "a\r\n\r\nb\r\n")
    let lines = io.readLines(tmp)
    assert_eq(lines.length, 3)
    assert_eq(lines[0], "a")
    assert_eq(lines[1], "")
    assert_eq(lines[2], "b")
    io.remove(tmp)
}
