import cluster
import mem
import { ClusterConfig, ClusterDelivery } from cluster

type DeliveryBoundary = ClusterDelivery | i64

fn erase_delivery(value: ClusterDelivery) -> DeliveryBoundary {
    return value
}

fn envelope(seed: u8) -> Buffer {
    var out = mem.allocZeroed(64)
    {
        var bytes: Slice<u8> = out.asMutBytes()
        bytes[0] = seed
        bytes[63] = seed + 1
    }
    return out
}

fn receive_buffer(ch: Channel<Buffer>) -> Buffer {
    return match (ch.recv()) {
        Recv.Value { value } -> value
        _ -> mem.allocZeroed(0)
    }
}

@test
fn test_cluster_transports_only_opaque_envelopes() {
    var config: ClusterConfig = {
        name: "opaque-transport-test",
        port: 0,
        secret: null,
        tls: null
    }
    assert(cluster.start(config))

    var invalid_topic = envelope(1)
    var invalid_topic_delivery = cluster.send("service.*", move invalid_topic)
    assert(invalid_topic_delivery == ClusterDelivery.InvalidTopic)
    var erased_delivery = erase_delivery(invalid_topic_delivery)
    assert(erased_delivery is ClusterDelivery)
    var restored_delivery = erased_delivery as ClusterDelivery
    assertEqual(restored_delivery.name, "InvalidTopic")
    assertEqual(restored_delivery.ordinal, 1)

    var invalid_envelope = mem.allocZeroed(63)
    assert(cluster.send("service.echo", move invalid_envelope) == ClusterDelivery.InvalidEnvelope)

    var disconnected = envelope(2)
    assert(cluster.send("service.none", move disconnected) == ClusterDelivery.Disconnected)

    assert(cluster.listen("service.invalid", 0) == null)
    assert(cluster.listen("service.invalid", 1048577) == null)
    var inbox: Channel<Buffer> = cluster.listen("service.>", 64)!
    var payload = envelope(41)
    assert(cluster.send("service.echo", move payload) == ClusterDelivery.Accepted)
    var received = receive_buffer(inbox)
    var bytes: Slice<u8> = received.asBytes()
    assertEqual(len(bytes), 64)
    assertEqual(bytes[0], 41)
    assertEqual(bytes[63], 42)

    var queued = 0
    while (queued < 64) {
        var next = envelope(7)
        assert(cluster.send("service.echo", move next) == ClusterDelivery.Accepted)
        queued += 1
    }
    var overflow = envelope(8)
    assert(cluster.send("service.echo", move overflow) == ClusterDelivery.Overloaded)

    inbox.close()
    cluster.stop()
    var unavailable = envelope(3)
    assert(cluster.send("service.echo", move unavailable) == ClusterDelivery.Unavailable)
}
