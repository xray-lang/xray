// 1303_yaml_nested_flow.xr
// Author: xingleixu@gmail.com
// Test: YAML nested flow structures (flow mapping + flow sequence combinations)
// Regression: scan-ahead not stopping at flow indicators (fixed)
// Typed YamlValue ADT access.

import yaml
import { YamlValue } from yaml

fn getV(v: YamlValue, k: string) -> YamlValue { return yaml.get(v, k)! }
fn getInt(v: YamlValue, k: string) -> i64 { return yaml.asInt(yaml.get(v, k)!) ?? -1 }
fn getStr(v: YamlValue, k: string) -> string { return yaml.asString(yaml.get(v, k)!) ?? "" }
fn getBool(v: YamlValue, k: string) -> bool { return yaml.asBool(yaml.get(v, k)!) ?? false }
fn getFloat(v: YamlValue, k: string) -> f64 { return yaml.asFloat(yaml.get(v, k)!) ?? 0.0 }
fn atV(v: YamlValue, i: i64) -> YamlValue { return yaml.at(v, i)! }
fn atInt(v: YamlValue, i: i64) -> i64 { return yaml.asInt(yaml.at(v, i)!) ?? -1 }
fn atStr(v: YamlValue, i: i64) -> string { return yaml.asString(yaml.at(v, i)!) ?? "" }

// ===== Flow mapping nested in flow mapping =====

@test
fn test_nested_flow_mapping() {
    var data = "outer: {inner: {a: 1, b: 2}, c: 3}"
    var obj = yaml.parse(data)
    var outer = getV(obj, "outer")
    var inner = getV(outer, "inner")
    assertEqual(getInt(inner, "a"), 1)
    assertEqual(getInt(inner, "b"), 2)
    assertEqual(getInt(outer, "c"), 3)
}

// ===== Flow sequence nested in flow mapping =====

@test
fn test_flow_sequence_in_flow_mapping() {
    var data = "config: {ports: [80, 443, 8080], host: localhost}"
    var obj = yaml.parse(data)
    var cfg = getV(obj, "config")
    var ports = getV(cfg, "ports")
    assertEqual(atInt(ports, 0), 80)
    assertEqual(atInt(ports, 1), 443)
    assertEqual(atInt(ports, 2), 8080)
    assertEqual(getStr(cfg, "host"), "localhost")
}

// ===== Flow mapping nested in flow sequence =====

@test
fn test_flow_mapping_in_flow_sequence() {
    var data = "items: [{name: alice, age: 30}, {name: bob, age: 25}]"
    var obj = yaml.parse(data)
    var items = getV(obj, "items")
    var i0 = atV(items, 0)
    var i1 = atV(items, 1)
    assertEqual(getStr(i0, "name"), "alice")
    assertEqual(getInt(i0, "age"), 30)
    assertEqual(getStr(i1, "name"), "bob")
    assertEqual(getInt(i1, "age"), 25)
}

// ===== Flow sequence nested in flow sequence =====

@test
fn test_nested_flow_sequence() {
    var data = "matrix: [[1, 2, 3], [4, 5, 6], [7, 8, 9]]"
    var obj = yaml.parse(data)
    var m = getV(obj, "matrix")
    assertEqual(atInt(atV(m, 0), 0), 1)
    assertEqual(atInt(atV(m, 0), 2), 3)
    assertEqual(atInt(atV(m, 1), 1), 5)
    assertEqual(atInt(atV(m, 2), 2), 9)
}

// ===== Multiple flow mappings at same level =====

@test
fn test_multiple_flow_mappings() {
    var data = "a: {x: 1}\nb: {y: 2}\nc: {z: 3}"
    var obj = yaml.parse(data)
    assertEqual(getInt(getV(obj, "a"), "x"), 1)
    assertEqual(getInt(getV(obj, "b"), "y"), 2)
    assertEqual(getInt(getV(obj, "c"), "z"), 3)
}

// ===== Flow mapping with various value types =====

@test
fn test_flow_mapping_mixed_values() {
    var data = "mix: {num: 42, str: hello, flag: true, nothing: null}"
    var obj = yaml.parse(data)
    var mix = getV(obj, "mix")
    assertEqual(getInt(mix, "num"), 42)
    assertEqual(getStr(mix, "str"), "hello")
    assertEqual(getBool(mix, "flag"), true)
    assert(yaml.isNull(getV(mix, "nothing")))
}

// ===== Empty flow structures =====

@test
fn test_empty_flow_structures() {
    var data = "empty_map: {}\nempty_list: []"
    var obj = yaml.parse(data)
    assert(yaml.get(obj, "empty_map") != null)
    assert(yaml.get(obj, "empty_list") != null)
    assertEqual(yaml.length(getV(obj, "empty_map")), 0)
    assertEqual(yaml.length(getV(obj, "empty_list")), 0)
}

// ===== Deeply nested flow =====

@test
fn test_deep_nested_flow() {
    var data = "deep: {l1: {l2: {l3: 42}}}"
    var obj = yaml.parse(data)
    assertEqual(getInt(getV(getV(getV(obj, "deep"), "l1"), "l2"), "l3"), 42)
}

// ===== Flow mapping with quoted keys =====

@test
fn test_flow_mapping_quoted_keys() {
    var data = "data: {\"key one\": 1, 'key two': 2}"
    var obj = yaml.parse(data)
    var d = getV(obj, "data")
    assertEqual(getInt(d, "key one"), 1)
    assertEqual(getInt(d, "key two"), 2)
}

// ===== Complex real-world-like YAML =====

@test
fn test_complex_yaml_config() {
    var data = "app:\n  name: myapp\n  version: 1\n  database:\n    host: localhost\n    port: 5432\n  features: [auth, logging, cache]\n  limits: {max_conn: 100, timeout: 30}"
    var obj = yaml.parse(data)
    var app = getV(obj, "app")
    assertEqual(getStr(app, "name"), "myapp")
    assertEqual(getInt(app, "version"), 1)
    var db = getV(app, "database")
    assertEqual(getStr(db, "host"), "localhost")
    assertEqual(getInt(db, "port"), 5432)
    var features = getV(app, "features")
    assertEqual(atStr(features, 0), "auth")
    assertEqual(atStr(features, 2), "cache")
    var limits = getV(app, "limits")
    assertEqual(getInt(limits, "max_conn"), 100)
    assertEqual(getInt(limits, "timeout"), 30)
}

// ===== Block sequence with flow mapping items =====

@test
fn test_flow_in_block_sequence() {
    var data = "servers:\n  - {host: a.com, port: 80}\n  - {host: b.com, port: 443}"
    var obj = yaml.parse(data)
    var servers = getV(obj, "servers")
    var s0 = atV(servers, 0)
    var s1 = atV(servers, 1)
    assertEqual(getStr(s0, "host"), "a.com")
    assertEqual(getInt(s0, "port"), 80)
    assertEqual(getStr(s1, "host"), "b.com")
    assertEqual(getInt(s1, "port"), 443)
}

// ===== Block sequence with nested block mappings =====

@test
fn test_block_sequence_nested_mappings() {
    var data = "users:\n  - name: Alice\n    age: 30\n  - name: Bob\n    age: 25"
    var obj = yaml.parse(data)
    var users = getV(obj, "users")
    assertEqual(getStr(atV(users, 0), "name"), "Alice")
    assertEqual(getInt(atV(users, 0), "age"), 30)
    assertEqual(getStr(atV(users, 1), "name"), "Bob")
    assertEqual(getInt(atV(users, 1), "age"), 25)
}

// ===== Block sequence with 3+ multi-line items =====

@test
fn test_block_sequence_three_items() {
    var data = "tasks:\n  - id: 1\n    status: done\n  - id: 2\n    status: pending\n  - id: 3\n    status: active"
    var obj = yaml.parse(data)
    var tasks = getV(obj, "tasks")
    assertEqual(yaml.length(tasks), 3)
    assertEqual(getInt(atV(tasks, 0), "id"), 1)
    assertEqual(getStr(atV(tasks, 0), "status"), "done")
    assertEqual(getInt(atV(tasks, 1), "id"), 2)
    assertEqual(getStr(atV(tasks, 2), "status"), "active")
}

// ===== Block sequence with mixed inline and block items =====

@test
fn test_block_sequence_mixed_items() {
    var data = "items:\n  - simple\n  - {complex: true}\n  - name: nested\n    value: 42"
    var obj = yaml.parse(data)
    var items = getV(obj, "items")
    assertEqual(atStr(items, 0), "simple")
    assertEqual(getBool(atV(items, 1), "complex"), true)
    assertEqual(getStr(atV(items, 2), "name"), "nested")
    assertEqual(getInt(atV(items, 2), "value"), 42)
}

// ===== Deeply nested block structure =====

@test
fn test_deep_block_nesting() {
    var data = "l1:\n  l2:\n    l3:\n      value: deep"
    var obj = yaml.parse(data)
    assertEqual(getStr(getV(getV(getV(obj, "l1"), "l2"), "l3"), "value"), "deep")
}

// ===== Block sequence inside block sequence (via multiline) =====

@test
fn test_block_mapping_with_multiple_sequences() {
    var data = "fruits: [apple, banana]\nvegs: [carrot, pea]"
    var obj = yaml.parse(data)
    assertEqual(atStr(getV(obj, "fruits"), 0), "apple")
    assertEqual(atStr(getV(obj, "fruits"), 1), "banana")
    assertEqual(atStr(getV(obj, "vegs"), 0), "carrot")
    assertEqual(atStr(getV(obj, "vegs"), 1), "pea")
}

// ===== Real-world: docker-compose-like YAML =====

@test
fn test_docker_compose_like() {
    var data = "services:\n  web:\n    image: nginx\n    ports: [80, 443]\n  db:\n    image: postgres\n    ports: [5432]"
    var obj = yaml.parse(data)
    var svc = getV(obj, "services")
    var web = getV(svc, "web")
    assertEqual(getStr(web, "image"), "nginx")
    assertEqual(atInt(getV(web, "ports"), 0), 80)
    assertEqual(atInt(getV(web, "ports"), 1), 443)
    var db = getV(svc, "db")
    assertEqual(getStr(db, "image"), "postgres")
    assertEqual(atInt(getV(db, "ports"), 0), 5432)
}

// ===== YAML multiline and special values =====

@test
fn test_yaml_special_values() {
    var data = "t1: true\nt2: false\nn1: null\nn2: ~\ni1: 42\nf1: 3.14"
    var obj = yaml.parse(data)
    assertEqual(getBool(obj, "t1"), true)
    assertEqual(getBool(obj, "t2"), false)
    assert(yaml.isNull(getV(obj, "n1")))
    assert(yaml.isNull(getV(obj, "n2")))
    assertEqual(getInt(obj, "i1"), 42)
    assertEqual(getFloat(obj, "f1"), 3.14)
}
