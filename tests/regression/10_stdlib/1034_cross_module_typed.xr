// 1034_cross_module_typed.xr
// Test: cross-module typed imports via module graph
//
// Verifies that selective imports from user modules resolve concrete types
// (function signatures, class types, constants) rather than unknown.

import {
    double_it,
    first_byte,
    greet,
    MAGIC,
    make_uint8_bytes,
    Point,
    second_uint8,
    sum_byte_slice,
    sum_uint8_slice,
} from "./modules/typed_lib"

@test
fn test_imported_fn_int() {
    var r = double_it(21)
    assert_eq(r, 42)
}

@test
fn test_imported_fn_string() {
    var s = greet("xray")
    assert_eq(s, "Hello, xray")
}

@test
fn test_imported_const() {
    assert_eq(MAGIC, 42)
}

@test
fn test_imported_class() {
    var p = Point(3, 4)
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

@test
fn test_imported_class_with_new() {
    // Regression: previously threw "method 'constructor' called on unsupported type"
    // when constructing an imported class with the `new` keyword.
    var p = Point(7, 24)
    assert_eq(p.x, 7)
    assert_eq(p.y, 24)
}

@test
fn test_imported_in_nested_fn() {
    fn inner() -> int {
        return double_it(10)
    }
    assert_eq(inner(), 20)
}

@test
fn test_imported_const_nested() {
    fn get_magic() -> int {
        return MAGIC
    }
    assert_eq(get_magic(), 42)
}

@test
fn test_imported_byte_uint8_canonical_identity() {
    var byteArray: Array<byte> = [1, 2, 3]
    var uint8Array: Array<uint8> = [4, 5, 6]
    var fromModule: Array<byte> = make_uint8_bytes()

    assert_eq(first_byte(uint8Array), 4)
    assert_eq(second_uint8(byteArray), 2)
    assert_eq(fromModule[2], 9)
}

@test
fn test_imported_byte_uint8_slice_and_method_identity() {
    var byteArray: Array<byte> = [10, 20, 30]
    var uint8Array: Array<uint8> = [40, 50, 60]

    assert_eq(sum_byte_slice(uint8Array[:]), 90)
    assert_eq(sum_uint8_slice(byteArray[:]), 30)

    var appendToByte: Array<byte> = [1]
    appendToByte.appendFrom(uint8Array[0:2])
    assert_eq(len(appendToByte), 3)
    assert_eq(appendToByte[2], 50)

    var appendToUint8: Array<uint8> = [2]
    appendToUint8.appendFrom(byteArray[1:3])
    assert_eq(len(appendToUint8), 3)
    assert_eq(appendToUint8[1], 20)
}
