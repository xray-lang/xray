// 1152_string_slice.xr - String slice tests

// ===== Basic slice =====

@test
fn test_slice_basic() {
    var s = "Hello World"
    assertEqual(s.slice(0, 5), "Hello")
    assertEqual(s.slice(6, 11), "World")
    assertEqual(s.slice(0, 11), "Hello World")
}

// ===== Invalid ranges are rejected =====

@test
fn test_slice_negative() {
    var s = "Hello World"
    assertPanics(fn() { s.slice(-1) })
    assertPanics(fn() { s.slice(0, -1) })
}

// ===== Single argument =====

@test
fn test_slice_single_arg() {
    var s = "Hello World"
    assertEqual(s.slice(6), "World")
    assertEqual(s.slice(0), "Hello World")
}

// ===== Boundary cases =====

@test
fn test_slice_boundary() {
    var s = "Hello World"
    assertPanics(fn() { s.slice(0, 100) })
    assertPanics(fn() { s.slice(5, 2) })
}

// ===== Empty string =====

@test
fn test_slice_empty() {
    assertEqual("".slice(0), "")
    assertPanics(fn() { "".slice(-1) })
}

// ===== Practical example =====

@test
fn test_slice_extension() {
    var path = "/home/user/file.txt"
    assertEqual(path.slice(len(path) - 4), ".txt")
    assertEqual(path.slice(0, len(path) - 4), "/home/user/file")
}
