// touch updates a path's timestamps and creates the file when there is
// nothing to update. The order matters: a directory accepts the timestamp
// update but cannot be created as a file, so attempting creation first would
// report failure for a path touch handles.

import io
import path

fn scratch(name: string) -> Path {
    return path.join(io.tempDir()!, path.from(name))
}

@test
fn test_creates_a_missing_file_empty() {
    var target = scratch("touch_new")
    assertEqual(io.exists(target), false)
    assert(io.touch(target))
    assert(io.isFile(target))
    assertEqual(io.fileSize(target), 0)
    io.remove(target)
}

@test
fn test_does_not_truncate_an_existing_file() {
    var target = scratch("touch_existing")
    assert(io.writeFile(target, "hello"))
    assert(io.touch(target))
    assertEqual(io.fileSize(target), 5)
    assertEqual(io.readFile(target) ?? "", "hello")
    io.remove(target)
}

@test
fn test_succeeds_on_a_directory() {
    var dir = scratch("touch_dir")
    assert(io.mkdirp(dir))
    // The timestamp update accepts a directory; creation would not.
    assert(io.touch(dir))
    assert(io.isDir(dir))
    io.removeAll(dir)
}

@test
fn test_fails_when_the_parent_is_missing() {
    var orphan = path.join(scratch("touch_absent_parent"), path.from("child"))
    assertEqual(io.touch(orphan), false)
    assertEqual(io.exists(orphan), false)
}
