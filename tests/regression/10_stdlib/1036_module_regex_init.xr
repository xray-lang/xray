// Regression: module-level regex.compile() in an imported (non-entry)
// module must succeed.
//
// Before fix: stdlib/regex/xregex_binding.c wrap_regex passed an
// XrCoroutine* where xr_instance_new expects XrVMRuntime*. During
// multi-module preload (no worker thread running yet), this caused
// xr_current_coro to dereference garbage and xr_alloc to FATAL on
// the coroutine type check.

import "./modules/regex_compile_mod" as rx

@test
fn test_module_regex_compiled_at_load() {
    assert(rx.isDigit("12345"))
    assert(!(rx.isDigit("abc")))
}

@test
fn test_module_regex_word() {
    assert(rx.isWord("hello"))
    assert(rx.isWord("_x123"))
    assert(!(rx.isWord("1abc")))
}
