// 1430_net_basic.xr
// net module basics: DNS resolution and module exports.
//
// Covers:
//   - lookup returns Array<IpAddress>, empty on failure, never null
//   - resolve returns the first address or null
//   - IPv4/IPv6 dual-stack results

import net

// ============================================================
// Part 1: DNS resolution
// ============================================================

@test
fn test_lookup_localhost() {
    var addrs = net.lookup("localhost")
    assert_true(len(addrs) > 0)
    // localhost resolves to 127.0.0.1 or ::1 depending on stack order.
    var first = addrs[0].toString()
    assert_true(first == "127.0.0.1" || first.startsWith("::"))
}

@test
fn test_lookup_invalid_host() {
    // A non-resolvable name must not crash: the result is an empty array,
    // unless a hijacking resolver still hands back addresses.
    var addrs = net.lookup("this-host-does-not-exist-12345.invalid")
    for (var i = 0; i < len(addrs); i++) {
        assert_true(len(addrs[i].toString()) > 0)
    }
}

@test
fn test_resolve_matches_lookup_head() {
    var first = net.resolve("localhost")
    assert_true(first != null)
    var addrs = net.lookup("localhost")
    assert_true(len(addrs) > 0)
    assert_eq(first!.toString(), addrs[0].toString())
}

// ============================================================
// Part 2: module exports
// ============================================================

@test
fn test_net_module_exists() {
    assert_true(typeName(net.lookup) == "function")
}

@test
fn test_net_dial_exists() {
    assert_true(typeName(net.dial) == "function")
}

@test
fn test_net_resolve_exists() {
    assert_true(typeName(net.resolve) == "function")
}

// ============================================================
// Part 3: IPv6 dual-stack support
// ============================================================

@test
fn test_lookup_ipv6_localhost() {
    // The result set may contain IPv4, IPv6, or both, depending on the
    // system configuration.
    var addrs = net.lookup("localhost")
    assert_true(len(addrs) > 0)
}

@test
fn test_lookup_returns_valid_addresses() {
    var addrs = net.lookup("localhost")
    for (var i = 0; i < len(addrs); i++) {
        var value = addrs[i].toString()
        assert_true(len(value) > 0)
        assert_true(value.contains(".") || value.contains(":"))
    }
}
