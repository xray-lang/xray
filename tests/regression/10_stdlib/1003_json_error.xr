// JSON syntax errors fail predictably and isValid never throws.

@test
fn test_invalid_documents() {
    var invalid = [
        "", "   ", "{", "[", "\"unterminated", "{key:1}", "[1,]",
        "{\"a\":1,}", "+1", "01", "undefined", "\"\\q\"", "1 2"
    ]
    for (text in invalid) { assert(!JSON.isValid(text), text) }
}

@test
fn test_parse_value_throws_on_error() {
    var caught = false
    try {
        JSON.parseValue("{incomplete")
    } catch panic (e) {
        caught = true
        assert(string(e).contains("JSON"))
    }
    assert(caught)
}

@test
fn test_valid_whitespace() {
    assert(JSON.isValid("  42  "))
    assert(JSON.isValid("\n\t{\n\t}\n\t"))
    assert(JSON.isValid("[ 1 , 2 , 3 ]"))
}
