// 1035_namespace_import_typed.xr
// Test: namespace import with typed member access via module graph
//
// Verifies that whole-module imports (namespace style) resolve
// member types from the graph's export table, not just unknown.

import "./modules/typed_lib" as typed_lib

@test
fn test_namespace_fn_call() {
    var r = typed_lib.double_it(21)
    assert_eq(r, 42)
}

@test
fn test_namespace_string_fn() {
    var s = typed_lib.greet("world")
    assert_eq(s, "Hello, world")
}

@test
fn test_namespace_const() {
    assert_eq(typed_lib.MAGIC, 42)
}

@test
fn test_namespace_class() {
    var p = typed_lib.Point(3, 4)
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

@test
fn test_namespace_in_nested() {
    fn inner() -> int {
        return typed_lib.double_it(5)
    }
    assert_eq(inner(), 10)
}

@test
fn test_namespace_byte_u8_canonical_identity() {
    var byteArray: Array<byte> = [1, 2, 3]
    var uint8Array: Array<u8> = [4, 5, 6]
    var fromModule: Array<u8> = typed_lib.make_uint8_bytes()

    assert_eq(typed_lib.first_byte(uint8Array), 4)
    assert_eq(typed_lib.second_uint8(byteArray), 2)
    assert_eq(fromModule[0], 7)
}

@test
fn test_namespace_byte_u8_slice_identity() {
    var byteArray: Array<byte> = [10, 20, 30]
    var uint8Array: Array<u8> = [40, 50, 60]

    assert_eq(typed_lib.sum_byte_slice(uint8Array[:]), 90)
    assert_eq(typed_lib.sum_uint8_slice(byteArray[:]), 30)
}
