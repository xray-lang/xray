// Test net module - API existence and non-I/O functionality

import net

// @test module exports exist
@test
fn test_net_core_apis() {
    assert(typeof(net.dial) == "function")
    assert(typeof(net.listen) == "function")
    assert(typeof(net.accept) == "function")
    assert(typeof(net.read) == "function")
    assert(typeof(net.readInto) == "function")
    assert(typeof(net.write) == "function")
    assert(typeof(net.writeBytes) == "function")
    assert(typeof(net.copy) == "function")
    assert(typeof(net.copyBidirectional) == "function")
    assert(typeof(net.shutdownRead) == "function")
    assert(typeof(net.shutdownWrite) == "function")
    assert(typeof(net.shutdown) == "function")
    assert(typeof(net.close) == "function")
    assert(typeof(net.lookup) == "function")
    assert(typeof(net.fd) == "function")
    assert(typeof(net.setReadDeadline) == "function")
    assert(typeof(net.setWriteDeadline) == "function")
    assert(typeof(net.setDeadline) == "function")
    assert(typeof(net.setAcceptDeadline) == "function")
    assert(typeof(net.lastError) == "function")
    assert(typeof(net.lastErrno) == "function")
}

// @test TLS APIs exist
@test
fn test_net_tls_apis() {
    assert(typeof(net.hasTLS) == "function")
    let tls = net.hasTLS()
    assert(typeof(tls) == "bool")
}

// @test UDP APIs exist
@test
fn test_net_udp_apis() {
    assert(typeof(net.udpBind) == "function")
    assert(typeof(net.sendTo) == "function")
    assert(typeof(net.recvFrom) == "function")
}

// @test DNS lookup - multiple calls consistent
@test
fn test_lookup_consistent() {
    let a1 = net.lookup("localhost")
    let a2 = net.lookup("localhost")
    assert_eq(a1, a2)
}

// @test DNS lookup - returns string or null
@test
fn test_lookup_type() {
    let addr = net.lookup("localhost")
    if (addr != null) {
        assert_eq(typeof(addr), "string")
        assert(addr.length > 0)
    }
}

print("All net extended tests passed")
