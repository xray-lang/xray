// Test net module - API existence and non-I/O functionality

import net

// @test module exports exist
@test
fn test_net_core_apis() {
    assert(typename(net.dial) == "function")
    assert(typename(net.listen) == "function")
    assert(typename(net.accept) == "function")
    assert(typename(net.read) == "function")
    assert(typename(net.readInto) == "function")
    assert(typename(net.write) == "function")
    assert(typename(net.writeBytes) == "function")
    assert(typename(net.copy) == "function")
    assert(typename(net.copyBidirectional) == "function")
    assert(typename(net.shutdownRead) == "function")
    assert(typename(net.shutdownWrite) == "function")
    assert(typename(net.shutdown) == "function")
    assert(typename(net.close) == "function")
    assert(typename(net.lookup) == "function")
    assert(typename(net.fd) == "function")
    assert(typename(net.setReadDeadline) == "function")
    assert(typename(net.setWriteDeadline) == "function")
    assert(typename(net.setDeadline) == "function")
    assert(typename(net.setAcceptDeadline) == "function")
    assert(typename(net.lastError) == "function")
    assert(typename(net.lastErrno) == "function")
}

// @test TLS APIs exist
@test
fn test_net_tls_apis() {
    assert(typename(net.hasTLS) == "function")
    var tls = net.hasTLS()
    assert(typename(tls) == "bool")
}

// @test UDP APIs exist
@test
fn test_net_udp_apis() {
    assert(typename(net.udpBind) == "function")
    assert(typename(net.sendTo) == "function")
    assert(typename(net.recvFrom) == "function")
}

// @test DNS lookup - multiple calls consistent
@test
fn test_lookup_consistent() {
    var a1 = net.lookup("localhost")
    var a2 = net.lookup("localhost")
    assert_eq(a1, a2)
}

// @test DNS lookup - returns string or null
@test
fn test_lookup_type() {
    var addr = net.lookup("localhost")
    if (addr != null) {
        assert_eq(typename(addr), "string")
        assert(addr.length > 0)
    }
}

print("All net extended tests passed")
