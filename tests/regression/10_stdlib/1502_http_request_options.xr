// Test http request options object construction

import http
import net

fn recv_line(ch: Channel<string>) -> string {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
}

fn capture_request_line(lst: NetListener, lines: Channel<string>) {
    var conn = net.accept(lst)
    if (conn == null) {
        lines.send("")
        net.close(lst)
        return
    }

    var raw = net.read(conn!, 4096) ?? ""
    var end = raw.indexOf("\r\n")
    var line = raw
    if (end >= 0) { line = raw.slice(0, end) }
    lines.send(line)

    net.write(conn!, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    net.close(conn!)
    net.close(lst)
}

fn serve_raw_response(lst: NetListener, response: string) {
    var conn = net.accept(lst)
    if (conn == null) {
        net.close(lst)
        return
    }

    net.read(conn!, 4096)
    net.write(conn!, response)
    net.close(conn!)
    net.close(lst)
}

@test
fn test_request_options_object() {
    var options = {
        url: "http://127.0.0.1:19998/test",
        method: "POST",
        headers: #{"Content-Type": "application/json",
            "X-Custom-Header": "test-value"},
        body: "{\"key\": \"value\"}",
        timeout: 5000
    }
    assert_eq(options.url, "http://127.0.0.1:19998/test")
    assert_eq(options.method, "POST")
    assert_eq(options.headers["Content-Type"], "application/json")
    assert_eq(options.body, "{\"key\": \"value\"}")
    assert_eq(options.timeout, 5000)
}

@test
fn test_request_api_exists() {
    assert(typename(http.request) == "function")
}

@test
fn test_request_rejects_unsupported_scheme() {
    var r = http.request({url: "ftp://example.com/path"})
    assert(!r.ok)
    assert_eq(r.error, "URL parse error")
}

@test
fn test_request_rejects_invalid_explicit_port() {
    var zero = http.request({url: "http://example.com:0/path"})
    assert(!zero.ok)
    assert_eq(zero.error, "URL parse error")

    var tooLarge = http.request({url: "http://example.com:99999/path"})
    assert(!tooLarge.ok)
    assert_eq(tooLarge.error, "URL parse error")
}

@test
fn test_request_rejects_url_userinfo() {
    var r = http.request({url: "http://user:pass@example.com/path"})
    assert(!r.ok)
    assert_eq(r.error, "URL parse error")
}

@test
fn test_request_preserves_custom_method_token() {
    var maybeLst = net.listen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    shared lines: Channel<string> = Channel(1)
    go capture_request_line(lst, lines)

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/custom",
        method: "propfind"
    })

    var line = recv_line(lines)
    assert(resp.ok)
    assert_eq(line, "PROPFIND /custom HTTP/1.1")
}

@test
fn test_request_ignores_no_body_status_payload() {
    var maybeLst = net.listen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    go serve_raw_response(
        lst,
        "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\nignored"
    )

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/empty"
    })

    assert(resp.ok)
    assert_eq(resp.status, 204)
    assert_eq(resp.body, "")
}

@test
fn test_request_stream_option_does_not_expose_native_stream_facade() {
    var maybeLst = net.listen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    go serve_raw_response(
        lst,
        "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"
    )

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/stream",
        stream: true
    })

    assert(resp.ok)
    assert_eq(resp.body, "hello")
    assert_eq(Json.has(resp, "_streamId"), false)
    assert_eq(Json.has(resp, "streaming"), false)
}

print("All http request options tests passed")
