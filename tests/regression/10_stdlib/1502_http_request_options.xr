// Test http request options object construction

import http
import { Headers, HttpError, HttpMethod, HttpRequestOptions } from http
import net

fn recv_line(ch: Channel<string>) -> string {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> ""
    }
}

// listen now throws; restricted environments without socket access should
// still skip these tests quietly instead of failing them.
fn tryListen(port: i64, backlog: i64) -> NetListener? {
    try {
        return net.listen(port, backlog)
    } catch (e) {
        return null
    }
}

fn readText(conn: NetConn, maxBytes: i64) -> string {
    var bytes = net.readBytes(conn, maxBytes)
    if (bytes == null) { return "" }
    return string.fromUtf8(bytes![:]) ?? ""
}

fn writeText(conn: NetConn, data: string) {
    net.writeBytes(conn, data.copyBytes())
}

fn capture_request_line(lst: NetListener, lines: Channel<string>) {
    var conn = net.accept(lst)
    if (conn == null) {
        lines.send("")
        net.close(lst)
        return
    }

    var raw = readText(conn!, 4096)
    var end = raw.indexOf("\r\n")
    var line = raw
    if (end >= 0) { line = raw.slice(0, end) }
    lines.send(line)

    writeText(conn!, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    net.close(conn!)
    net.close(lst)
}

fn capture_request_raw(lst: NetListener, requests: Channel<string>) {
    var conn = net.accept(lst)
    if (conn == null) {
        requests.send("")
        net.close(lst)
        return
    }

    var raw = readText(conn!, 4096)
    requests.send(raw)

    writeText(conn!, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    net.close(conn!)
    net.close(lst)
}

fn serve_raw_response(lst: NetListener, response: string) {
    var conn = net.accept(lst)
    if (conn == null) {
        net.close(lst)
        return
    }

    readText(conn!, 4096)
    writeText(conn!, response)
    net.close(conn!)
    net.close(lst)
}

fn serve_binary_response(lst: NetListener, framing: string) {
    var conn = net.accept(lst)
    if (conn == null) {
        net.close(lst)
        return
    }

    readText(conn!, 4096)
    if (framing == "chunked") {
        writeText(
            conn!,
            "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\n"
        )
        net.writeBytes(conn!, Array<u8>([0xff, 0x00, 0x7f]))
        writeText(conn!, "\r\n0\r\n\r\n")
    } else if (framing == "close") {
        writeText(conn!, "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n")
        net.writeBytes(conn!, Array<u8>([0xff, 0x00, 0x7f]))
    } else {
        writeText(
            conn!,
            "HTTP/1.1 200 OK\r\nContent-Length: 3\r\nConnection: close\r\n\r\n"
        )
        net.writeBytes(conn!, Array<u8>([0xff, 0x00, 0x7f]))
    }
    net.close(conn!)
    net.close(lst)
}

fn assert_binary_response(framing: string) {
    var maybeLst = tryListen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    go serve_binary_response(lst, framing)

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/binary",
        timeoutMs: 1000
    })

    assert(resp.isSuccess())
    assertEqual(len(resp.body), 3)
    assertEqual(resp.body[0], 0xff)
    assertEqual(resp.body[1], 0x00)
    assertEqual(resp.body[2], 0x7f)
}

@test
fn test_request_options_object() {
    var headers = Headers()
    headers.add("Content-Type", "application/json")
    headers.add("X-Custom-Header", "test-value")
    var options: HttpRequestOptions = {
        url: "http://127.0.0.1:19998/test",
        method: HttpMethod.post(),
        headers: headers,
        body: "{\"key\": \"value\"}".copyBytes(),
        timeoutMs: 5000
    }
    assertEqual(options.url, "http://127.0.0.1:19998/test")
    assertEqual(options.method!.token, "POST")
    assertEqual(options.headers!.get("Content-Type")!, "application/json")
    assertEqual(string.fromUtf8(options.body![:])!, "{\"key\": \"value\"}")
    assertEqual(options.timeoutMs!, 5000)
}

@test
fn test_request_api_exists() {
    assert(typeName(http.request) == "function")
}

fn rejects_url(url: string) -> bool {
    try {
        http.request({url: url})
    } catch (e: HttpError) {
        return true
    }
    return false
}

@test
fn test_request_rejects_unsupported_scheme() {
    assert(rejects_url("ftp://example.com/path"))
}

@test
fn test_request_rejects_invalid_explicit_port() {
    assert(rejects_url("http://example.com:0/path"))
    assert(rejects_url("http://example.com:99999/path"))
}

@test
fn test_request_rejects_url_userinfo() {
    assert(rejects_url("http://user:pass@example.com/path"))
}

@test
fn test_request_preserves_custom_method_token() {
    var maybeLst = tryListen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    const lines: Channel<string> = Channel(1)
    go capture_request_line(lst, lines)

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/custom",
        method: HttpMethod("propfind")
    })

    var line = recv_line(lines)
    assert(resp.isSuccess())
    assertEqual(line, "PROPFIND /custom HTTP/1.1")
}

@test
fn test_request_defaults_identity_accept_encoding() {
    var maybeLst = tryListen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    const requests: Channel<string> = Channel(1)
    go capture_request_raw(lst, requests)

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/encoding"
    })

    var raw = recv_line(requests)
    assert(resp.isSuccess())
    assert(raw.contains("\r\nAccept-Encoding: identity\r\n"))
    assert(!raw.contains("Accept-Encoding: gzip, deflate"))
}

@test
fn test_request_ignores_no_body_status_payload() {
    var maybeLst = tryListen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    go serve_raw_response(
        lst,
        "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\nignored"
    )

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/empty"
    })

    assert(resp.isSuccess())
    assertEqual(resp.status, 204)
    assertEqual(len(resp.body), 0)
}

@test
fn test_request_preserves_non_utf8_response_body() {
    assert_binary_response("content-length")
}

@test
fn test_request_preserves_non_utf8_chunked_body() {
    assert_binary_response("chunked")
}

@test
fn test_request_preserves_non_utf8_close_delimited_body() {
    assert_binary_response("close")
}

@test
fn test_request_body_is_written_as_bytes() {
    var maybeLst = tryListen(0, 1)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    const requests: Channel<string> = Channel(1)
    go capture_request_raw(lst, requests)

    var headers = Headers()
    headers.add("Content-Type", "application/octet-stream")

    var resp = http.request({
        url: "http://127.0.0.1:" + string(lst.port()) + "/bytes",
        method: HttpMethod.post(),
        headers: headers,
        body: Array<u8>([0x78, 0x72]),
        timeoutMs: 1000
    })

    var raw = recv_line(requests)
    assert(resp.isSuccess())
    assert(raw.contains("POST /bytes HTTP/1.1\r\n"))
    assert(raw.contains("\r\nContent-Length: 2\r\n"))
}

print("All http request options tests passed")
