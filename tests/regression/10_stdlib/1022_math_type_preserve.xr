// 1022_math_type_preserve.xr - Math module declared return types and edge cases
//
// math no longer preserves the integer shape of its arguments. Every operand is
// declared f64 and the declaration is the whole truth: floor/ceil/round/trunc
// answer i64 because that is what they declare, while abs/min/max/clamp answer
// f64 whether the argument was written 3 or 3.0. The cases below lock that
// declared typing, not the old int-in/int-out polymorphism.

import math

// ===== Declared return type: floor/ceil/round answer i64 =====

@test
fn test_floor_returns_int() {
    var r = math.floor(3.7)
    assertEqual(r, 3)
    assertEqual(typeName(r) == "i64", true)
}

@test
fn test_floor_int_passthrough() {
    var r = math.floor(5)
    assertEqual(r, 5)
    assertEqual(typeName(r) == "i64", true)
}

@test
fn test_ceil_returns_int() {
    var r = math.ceil(3.2)
    assertEqual(r, 4)
    assertEqual(typeName(r) == "i64", true)
}

@test
fn test_ceil_int_passthrough() {
    var r = math.ceil(7)
    assertEqual(r, 7)
    assertEqual(typeName(r) == "i64", true)
}

@test
fn test_round_returns_int() {
    var r = math.round(3.5)
    assertEqual(r, 4)
    assertEqual(typeName(r) == "i64", true)
}

@test
fn test_round_int_passthrough() {
    var r = math.round(10)
    assertEqual(r, 10)
    assertEqual(typeName(r) == "i64", true)
}

// ===== Declared return type: min/max always answer f64 =====

@test
fn test_min_int_literals_return_f64() {
    var r = math.min(3, 7)
    assertEqual(r, 3.0)
    assertEqual(typeName(r) == "f64", true)
}

@test
fn test_min_float_returns_float() {
    var r = math.min(3.5, 7.2)
    assert(r > 3.4 && r < 3.6)
    assertEqual(typeName(r) == "f64", true)
}

@test
fn test_max_int_literals_return_f64() {
    var r = math.max(3, 7)
    assertEqual(r, 7.0)
    assertEqual(typeName(r) == "f64", true)
}

@test
fn test_max_float_returns_float() {
    var r = math.max(3.5, 7.2)
    assert(r > 7.1 && r < 7.3)
    assertEqual(typeName(r) == "f64", true)
}

// ===== min/max variadic =====

@test
fn test_min_variadic() {
    assertEqual(math.min(5, 3, 8, 1, 9), 1.0)
    assertEqual(math.min(10, 20, 30), 10.0)
}

@test
fn test_max_variadic() {
    assertEqual(math.max(5, 3, 8, 1, 9), 9.0)
    assertEqual(math.max(10, 20, 30), 30.0)
}

// ===== clamp always answers f64 =====

@test
fn test_clamp_int_literals_return_f64() {
    var r = math.clamp(5, 0, 10)
    assertEqual(r, 5.0)
    assertEqual(typeName(r) == "f64", true)
}

@test
fn test_clamp_below_returns_f64() {
    var r = math.clamp(-5, 0, 10)
    assertEqual(r, 0.0)
    assertEqual(typeName(r) == "f64", true)
}

// ===== abs always answers f64 =====

@test
fn test_abs_int_literal_returns_f64() {
    var r = math.abs(-42)
    assertEqual(r, 42.0)
    assertEqual(typeName(r) == "f64", true)
}

@test
fn test_abs_float_returns_float() {
    var r = math.abs(-3.14)
    assert(r > 3.13 && r < 3.15)
    assertEqual(typeName(r) == "f64", true)
}

// ===== trunc answers i64 =====

@test
fn test_trunc_positive() {
    assertEqual(math.trunc(3.7), 3)
    assertEqual(typeName(math.trunc(3.7)) == "i64", true)
}

@test
fn test_trunc_negative() {
    assertEqual(math.trunc(-3.7), -3)
}

@test
fn test_trunc_int_passthrough() {
    var r = math.trunc(5)
    assertEqual(r, 5)
    assertEqual(typeName(r) == "i64", true)
}

// ===== Negative floor/ceil =====

@test
fn test_floor_negative() {
    assertEqual(math.floor(-3.2), -4)
    assertEqual(math.floor(-3.7), -4)
}

@test
fn test_ceil_negative() {
    assertEqual(math.ceil(-3.2), -3)
    assertEqual(math.ceil(-3.7), -3)
}

@test
fn test_round_negative() {
    assertEqual(math.round(-3.4), -3)
    assertEqual(math.round(-3.5), -4)
}
