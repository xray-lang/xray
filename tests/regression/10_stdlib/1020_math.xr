// 测试：数学运算
//
// math declares every operand as f64, and the declaration is the whole truth.
// abs/min/max answer f64 however the argument is spelled, so the expected
// values below are written as floats; floor/ceil/round answer i64.

import math

// ===== 基本数学 =====

@test
fn test_abs_positive() {
    assertEqual(math.abs(5), 5.0)
    assertEqual(math.abs(100), 100.0)
}

@test
fn test_abs_negative() {
    assertEqual(math.abs(-5), 5.0)
    assertEqual(math.abs(-100), 100.0)
}

@test
fn test_abs_zero() {
    assertEqual(math.abs(0), 0.0)
}

// ===== 最大最小值 =====

@test
fn test_max() {
    assertEqual(math.max(3, 7), 7.0)
    assertEqual(math.max(-5, -2), -2.0)
    assertEqual(math.max(10, 10), 10.0)
}

@test
fn test_min() {
    assertEqual(math.min(3, 7), 3.0)
    assertEqual(math.min(-5, -2), -5.0)
    assertEqual(math.min(10, 10), 10.0)
}

// ===== 取整函数 =====

@test
fn test_floor() {
    assertEqual(math.floor(3.7), 3)
    assertEqual(math.floor(3.2), 3)
    assertEqual(math.floor(-3.2), -4)
}

@test
fn test_ceil() {
    assertEqual(math.ceil(3.2), 4)
    assertEqual(math.ceil(3.7), 4)
    assertEqual(math.ceil(-3.7), -3)
}

@test
fn test_round() {
    assertEqual(math.round(3.4), 3)
    assertEqual(math.round(3.5), 4)
    assertEqual(math.round(3.6), 4)
}

// ===== 幂运算 =====

@test
fn test_pow() {
    assertEqual(math.pow(2, 3), 8.0)
    assertEqual(math.pow(3, 2), 9.0)
    assertEqual(math.pow(10, 0), 1.0)
}

@test
fn test_sqrt() {
    assertEqual(math.sqrt(4), 2.0)
    assertEqual(math.sqrt(9), 3.0)
    assertEqual(math.sqrt(1), 1.0)
}

// ===== 常量 =====

@test
fn test_pi() {
    var pi = math.PI
    assertEqual(pi > 3.14, true)
    assertEqual(pi < 3.15, true)
}

@test
fn test_e() {
    var e = math.E
    assertEqual(e > 2.71, true)
    assertEqual(e < 2.72, true)
}

// ===== 三角函数 =====

@test
fn test_sin_zero() {
    var s = math.sin(0)
    assertEqual(s > -0.01, true)
    assertEqual(s < 0.01, true)
}

@test
fn test_cos_zero() {
    var c = math.cos(0)
    assertEqual(c > 0.99, true)
    assertEqual(c < 1.01, true)
}

// ===== 随机数 =====

@test
fn test_random_range() {
    var r = math.random()
    assertEqual(r >= 0, true)
    assertEqual(r < 1, true)
}

