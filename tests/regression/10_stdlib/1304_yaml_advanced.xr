// 1304_yaml_advanced.xr
// Author: xingleixu@gmail.com
// Test: Advanced YAML features - anchors, aliases, block scalars,
//       multi-document, hex/octal, Unicode escapes, special values,
//       stringify roundtrip with typed YamlValue builders

import yaml
import { YamlValue } from yaml

fn getV(v: YamlValue, k: string) -> YamlValue { return yaml.get(v, k)! }
fn getInt(v: YamlValue, k: string) -> i64 { return yaml.asInt(yaml.get(v, k)!) ?? -1 }
fn getStr(v: YamlValue, k: string) -> string { return yaml.asString(yaml.get(v, k)!) ?? "" }
fn getBool(v: YamlValue, k: string) -> bool { return yaml.asBool(yaml.get(v, k)!) ?? false }
fn getFloat(v: YamlValue, k: string) -> f64 { return yaml.asFloat(yaml.get(v, k)!) ?? 0.0 }

// ===== Anchor and Alias =====

@test
fn test_anchor_alias() {
    // Basic anchor/alias: scalar value (resolved inline)
    var data = "anchor: &val hello\nalias: *val"
    var obj = yaml.parse(data)
    assert_eq(getStr(obj, "anchor"), "hello")
    assert_eq(getStr(obj, "alias"), "hello")
}

@test
fn test_anchor_alias_number() {
    var data = "port: &p 8080\nbackup_port: *p"
    var obj = yaml.parse(data)
    assert_eq(getInt(obj, "port"), 8080)
    assert_eq(getInt(obj, "backup_port"), 8080)
}

// ===== Literal Block Scalar =====

@test
fn test_literal_block() {
    var data = "text: |\n  line one\n  line two\n  line three"
    var obj = yaml.parse(data)
    var text = getStr(obj, "text")
    assert(len(text) > 0)
    assert(text.indexOf("line one") >= 0)
    assert(text.indexOf("line two") >= 0)
}

@test
fn test_literal_block_strip() {
    var data = "text: |-\n  hello\n  world"
    var obj = yaml.parse(data)
    var text = getStr(obj, "text")
    assert(len(text) > 0)
    // Strip mode: no trailing newline
    assert(text.slice(len(text) - 1, len(text)) != "\n")
}

@test
fn test_literal_block_keep() {
    var data = "text: |+\n  hello\n  world\n\n\n"
    var obj = yaml.parse(data)
    var text = getStr(obj, "text")
    assert(len(text) > 0)
    // Keep mode: trailing newlines preserved
}

// ===== Folded Block Scalar =====

@test
fn test_folded_block() {
    var data = "text: >\n  line one\n  line two\n  line three"
    var obj = yaml.parse(data)
    var text = getStr(obj, "text")
    assert(len(text) > 0)
    // Folded: newlines become spaces
    assert(text.indexOf(" ") >= 0)
}

@test
fn test_folded_block_strip() {
    var data = "text: >-\n  hello\n  world"
    var obj = yaml.parse(data)
    var text = getStr(obj, "text")
    assert(len(text) > 0)
    assert(text.slice(len(text) - 1, len(text)) != "\n")
}

// ===== Multi-document =====

@test
fn test_parse_all() {
    // parseAll splits on document end marker '...'
    var data = "first: 1\n...\nsecond: 2\n...\nthird: 3"
    var docs = yaml.parseAll(data)
    assert(len(docs) >= 1)
    assert_eq(getInt(docs[0], "first"), 1)
}

@test
fn test_parse_all_single() {
    // Single document with --- header
    var data = "---\na: 1\nb: 2"
    var docs = yaml.parseAll(data)
    assert(len(docs) >= 1)
    assert_eq(getInt(docs[0], "a"), 1)
    assert_eq(getInt(docs[0], "b"), 2)
}

// ===== Hex and Octal Numbers =====

@test
fn test_hex_numbers() {
    var data = "hex: 0xFF"
    var obj = yaml.parse(data)
    assert_eq(getInt(obj, "hex"), 255)
}

@test
fn test_hex_number_upper() {
    var data = "val: 0x1A"
    var obj = yaml.parse(data)
    assert_eq(getInt(obj, "val"), 26)
}

@test
fn test_octal_numbers() {
    var data = "oct: 0o77"
    var obj = yaml.parse(data)
    assert_eq(getInt(obj, "oct"), 63)
}

// ===== String that looks like hex but is not =====

@test
fn test_string_not_hex() {
    var data = "word: cafe"
    var obj = yaml.parse(data)
    // "cafe" should be a string, not parsed as hex number
    assert_eq(getStr(obj, "word"), "cafe")
}

@test
fn test_string_abcdef() {
    var data = "word: abcdef"
    var obj = yaml.parse(data)
    assert_eq(getStr(obj, "word"), "abcdef")
}

// ===== Special Float Values =====

@test
fn test_infinity() {
    var data = "pos: .inf\nneg: -.inf"
    var obj = yaml.parse(data)
    assert(getFloat(obj, "pos") > 999999999.0)
    assert(getFloat(obj, "neg") < -999999999.0)
}

@test
fn test_nan() {
    var data = "val: .nan"
    var obj = yaml.parse(data)
    // NaN != NaN
    var v = getFloat(obj, "val")
    assert(v != v)
}

// ===== Tilde as null =====

@test
fn test_tilde_null() {
    var data = "val: ~"
    var obj = yaml.parse(data)
    assert(yaml.isNull(getV(obj, "val")))
}

// ===== Empty mapping value =====

@test
fn test_empty_value() {
    var data = "key:"
    var obj = yaml.parse(data)
    assert(yaml.isNull(getV(obj, "key")))
}

// ===== Unicode escape in double-quoted strings =====

@test
fn test_unicode_escape() {
    var data = "rune: \"\\u0041\""
    var obj = yaml.parse(data)
    assert_eq(getStr(obj, "rune"), "A")
}

@test
fn test_unicode_escape_multibyte() {
    var data = "rune: \"\\u00E9\""
    var obj = yaml.parse(data)
    // U+00E9 = é (2-byte UTF-8)
    assert(len(getStr(obj, "rune")) > 0)
}

// ===== Escape sequences in double-quoted strings =====

@test
fn test_escape_sequences() {
    var data = "tab: \"hello\\tworld\"\nnl: \"line1\\nline2\""
    var obj = yaml.parse(data)
    assert(getStr(obj, "tab").indexOf("\t") >= 0)
    assert(getStr(obj, "nl").indexOf("\n") >= 0)
}

// ===== Stringify typed YamlValue =====

@test
fn test_stringify_value() {
    var config = yaml.newMapping()
    yaml.mappingSet(ref config, "name", yaml.stringValue("xray"))
    yaml.mappingSet(ref config, "version", yaml.intValue(1))
    yaml.mappingSet(ref config, "debug", yaml.boolValue(false))
    var result = yaml.stringify(yaml.mappingValue(config))
    assert(len(result) > 0)
    // Roundtrip: parse the stringified result
    var parsed = yaml.parse(result)
    assert_eq(getStr(parsed, "name"), "xray")
    assert_eq(getInt(parsed, "version"), 1)
    assert_eq(getBool(parsed, "debug"), false)
}

@test
fn test_stringify_nested_value() {
    var server = yaml.newMapping()
    yaml.mappingSet(ref server, "host", yaml.stringValue("localhost"))
    yaml.mappingSet(ref server, "port", yaml.intValue(8080))
    var features: Array<YamlValue> = []
    features.push(yaml.stringValue("auth"))
    features.push(yaml.stringValue("logging"))
    var root = yaml.newMapping()
    yaml.mappingSet(ref root, "server", yaml.mappingValue(server))
    yaml.mappingSet(ref root, "features", yaml.sequenceValue(features))
    var result = yaml.stringify(yaml.mappingValue(root))
    assert(len(result) > 0)
}

@test
fn test_stringify_value_roundtrip() {
    var original = yaml.newMapping()
    yaml.mappingSet(ref original, "a", yaml.intValue(1))
    yaml.mappingSet(ref original, "b", yaml.stringValue("hello"))
    yaml.mappingSet(ref original, "c", yaml.boolValue(true))
    yaml.mappingSet(ref original, "d", yaml.nullValue())
    var yaml_str = yaml.stringify(yaml.mappingValue(original))
    var parsed = yaml.parse(yaml_str)
    assert_eq(getInt(parsed, "a"), 1)
    assert_eq(getStr(parsed, "b"), "hello")
    assert_eq(getBool(parsed, "c"), true)
    assert(yaml.isNull(getV(parsed, "d")))
}

// ===== Stringify Mapping =====

@test
fn test_stringify_mapping() {
    var m = yaml.newMapping()
    yaml.mappingSet(ref m, "key1", yaml.stringValue("val1"))
    yaml.mappingSet(ref m, "key2", yaml.intValue(42))
    var result = yaml.stringify(yaml.mappingValue(m))
    assert(len(result) > 0)
}

// ===== Error robustness =====

@test
fn test_empty_input() {
    var result = yaml.parse("")
    assert(yaml.isNull(result))
}

@test
fn test_whitespace_only() {
    var result = yaml.parse("   \n\n  ")
    assert(yaml.isNull(result))
}

@test
fn test_comment_only() {
    // Comments followed by empty lines are skipped
    var result = yaml.parse("# this is a comment\n")
    // Parser returns Null for a comment-only document; just verify no crash
    assert(yaml.isNull(result))
}

// ===== Mixed inline comments =====

@test
fn test_inline_comments() {
    var data = "name: Alice # user name\nage: 30 # years"
    var obj = yaml.parse(data)
    assert_eq(getStr(obj, "name"), "Alice")
    assert_eq(getInt(obj, "age"), 30)
}

// ===== Negative numbers =====

@test
fn test_negative_numbers() {
    var data = "neg_int: -42\nneg_float: -3.14"
    var obj = yaml.parse(data)
    assert_eq(getInt(obj, "neg_int"), -42)
    assert_eq(getFloat(obj, "neg_float"), -3.14)
}

// ===== Quoted keys =====

@test
fn test_flow_quoted_keys() {
    // Quoted keys work in flow mappings
    var data = "data: {\"key one\": 1, 'key two': 2}"
    var obj = yaml.parse(data)
    var d = getV(obj, "data")
    assert_eq(getInt(d, "key one"), 1)
    assert_eq(getInt(d, "key two"), 2)
}
