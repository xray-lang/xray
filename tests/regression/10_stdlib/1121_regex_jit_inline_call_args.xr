import regex

fn regex_match_ok(pattern: string, text: string) throws(regex.RegexError) -> bool {
    var re = (try regex.compile(pattern))
    return regex.find(re, text) != null
}

@test
fn test_inlined_regex_find_uses_current_args() throws(regex.RegexError) {
    for (var i = 0; i < 260; i++) {
        assertEqual((try regex_match_ok("", "abc")), true)
    }
    assertEqual((try regex_match_ok("a", "")), false)
}
