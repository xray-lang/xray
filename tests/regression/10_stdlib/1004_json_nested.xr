// 作者：xingleixu@gmail.com
// 测试：JSON 深嵌套和复杂结构测试
// 借鉴：simdjson 的嵌套和大型文档测试

// ===== 数组嵌套测试 =====

@test
fn test_nested_array_2_levels() {
    var arr = JSON.parseValue("[[1, 2], [3, 4]]")
    assert_eq(len(JSON.asArray(arr)!), 2)
    assert_eq(JSON.require<i64>(arr, [0, 0]), 1)
    assert_eq(JSON.require<i64>(arr, [0, 1]), 2)
    assert_eq(JSON.require<i64>(arr, [1, 0]), 3)
    assert_eq(JSON.require<i64>(arr, [1, 1]), 4)
}

@test
fn test_nested_array_3_levels() {
    var arr = JSON.parseValue("[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]")
    assert_eq(JSON.require<i64>(arr, [0, 0, 0]), 1)
    assert_eq(JSON.require<i64>(arr, [0, 1, 1]), 4)
    assert_eq(JSON.require<i64>(arr, [1, 0, 0]), 5)
    assert_eq(JSON.require<i64>(arr, [1, 1, 1]), 8)
}

@test
fn test_nested_array_deep() {
    // 6 层嵌套
    var arr = JSON.parseValue("[[[[[[42]]]]]]")
    assert_eq(JSON.require<i64>(arr, [0, 0, 0, 0, 0, 0]), 42)
}

@test
fn test_nested_empty_arrays() {
    var arr = JSON.parseValue("[[], [[]], [[], []]]")
    assert_eq(len(JSON.asArray(arr)!), 3)
    assert_eq(len(JSON.require<Array<JSON.Value>>(arr, [0])), 0)
    assert_eq(len(JSON.require<Array<JSON.Value>>(arr, [1])), 1)
    assert_eq(len(JSON.require<Array<JSON.Value>>(arr, [1, 0])), 0)
    assert_eq(len(JSON.require<Array<JSON.Value>>(arr, [2])), 2)
}

// ===== 对象嵌套测试 =====

@test
fn test_nested_object_2_levels() {
    var obj = JSON.parseValue("{\"user\": {\"name\": \"Alice\", \"age\": 30}}")
    assert_eq(JSON.require<string>(obj, ["user", "name"]), "Alice")
    assert_eq(JSON.require<i64>(obj, ["user", "age"]), 30)
}

@test
fn test_nested_object_3_levels() {
    var obj = JSON.parseValue("{\"a\": {\"b\": {\"c\": 42}}}")
    assert_eq(JSON.require<i64>(obj, ["a", "b", "c"]), 42)
}

@test
fn test_nested_object_deep() {
    // 深层嵌套对象
    var obj = JSON.parseValue("{\"l1\": {\"l2\": {\"l3\": {\"l4\": {\"value\": 100}}}}}")
    assert_eq(JSON.require<i64>(obj, ["l1", "l2", "l3", "l4", "value"]), 100)
}

@test
fn test_nested_empty_objects() {
    var obj = JSON.parseValue("{\"a\": {}, \"b\": {\"c\": {}}}")
    assert(JSON.isObject(JSON.require<JSON.Value>(obj, ["a"])))
    assert(JSON.isObject(JSON.require<JSON.Value>(obj, ["b", "c"])))
}

// ===== 混合嵌套测试 =====

@test
fn test_object_with_arrays() {
    var obj = JSON.parseValue("{\"numbers\": [1, 2, 3], \"letters\": [\"a\", \"b\", \"c\"]}")
    assert_eq(len(JSON.require<Array<JSON.Value>>(obj, ["numbers"])), 3)
    assert_eq(JSON.require<i64>(obj, ["numbers", 0]), 1)
    assert_eq(JSON.require<string>(obj, ["letters", 0]), "a")
}

@test
fn test_array_with_objects() {
    var arr = JSON.parseValue("[{\"id\": 1}, {\"id\": 2}, {\"id\": 3}]")
    assert_eq(len(JSON.asArray(arr)!), 3)
    assert_eq(JSON.require<i64>(arr, [0, "id"]), 1)
    assert_eq(JSON.require<i64>(arr, [1, "id"]), 2)
    assert_eq(JSON.require<i64>(arr, [2, "id"]), 3)
}

@test
fn test_complex_mixed() {
    var data = JSON.parseValue("{\"users\": [{\"name\": \"Alice\", \"scores\": [90, 85]}, {\"name\": \"Bob\", \"scores\": [78, 92]}]}")
    assert_eq(len(JSON.require<Array<JSON.Value>>(data, ["users"])), 2)
    assert_eq(JSON.require<string>(data, ["users", 0, "name"]), "Alice")
    assert_eq(JSON.require<i64>(data, ["users", 0, "scores", 0]), 90)
    assert_eq(JSON.require<string>(data, ["users", 1, "name"]), "Bob")
    assert_eq(JSON.require<i64>(data, ["users", 1, "scores", 1]), 92)
}

// ===== 多键对象测试 =====

@test
fn test_object_many_keys() {
    var obj = JSON.parseValue("{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10}")
    assert_eq(JSON.require<i64>(obj, ["a"]), 1)
    assert_eq(JSON.require<i64>(obj, ["e"]), 5)
    assert_eq(JSON.require<i64>(obj, ["j"]), 10)
}

@test
fn test_object_long_keys() {
    var obj = JSON.parseValue("{\"very_long_key_name_here\": 42, \"another_very_long_key\": 100}")
    assert_eq(JSON.require<i64>(obj, ["very_long_key_name_here"]), 42)
    assert_eq(JSON.require<i64>(obj, ["another_very_long_key"]), 100)
}

// ===== 大型数组测试 =====

@test
fn test_large_array() {
    // 构建大数组
    var jsonStr = "["
    var i = 0
    while (i < 100) {
        if (i > 0) {
            jsonStr = jsonStr + ","
        }
        jsonStr = jsonStr + i.toString()
        i++
    }
    jsonStr = jsonStr + "]"
    
    var arr = JSON.parseValue(jsonStr)
    assert_eq(len(JSON.asArray(arr)!), 100)
    assert_eq(JSON.require<i64>(arr, [0]), 0)
    assert_eq(JSON.require<i64>(arr, [50]), 50)
    assert_eq(JSON.require<i64>(arr, [99]), 99)
}

// ===== 真实数据结构模拟 =====

@test
fn test_user_profile() {
    var jsonStr = "{\"id\": 12345, \"username\": \"johndoe\", \"email\": \"john@example.com\", \"profile\": {\"firstName\": \"John\", \"lastName\": \"Doe\", \"age\": 28}, \"settings\": {\"theme\": \"dark\", \"notifications\": true}}"
    var user = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<i64>(user, ["id"]), 12345)
    assert_eq(JSON.require<string>(user, ["username"]), "johndoe")
    assert_eq(JSON.require<string>(user, ["profile", "firstName"]), "John")
    assert_eq(JSON.require<i64>(user, ["profile", "age"]), 28)
    assert_eq(JSON.require<string>(user, ["settings", "theme"]), "dark")
    assert_eq(JSON.require<bool>(user, ["settings", "notifications"]), true)
}

@test
fn test_api_response() {
    var jsonStr = "{\"status\": \"success\", \"code\": 200, \"data\": {\"items\": [{\"id\": 1, \"name\": \"Item 1\"}, {\"id\": 2, \"name\": \"Item 2\"}], \"total\": 2}, \"meta\": {\"page\": 1, \"limit\": 10}}"
    var response = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<string>(response, ["status"]), "success")
    assert_eq(JSON.require<i64>(response, ["code"]), 200)
    assert_eq(len(JSON.require<Array<JSON.Value>>(response, ["data", "items"])), 2)
    assert_eq(JSON.require<string>(response, ["data", "items", 0, "name"]), "Item 1")
    assert_eq(JSON.require<i64>(response, ["data", "total"]), 2)
    assert_eq(JSON.require<i64>(response, ["meta", "page"]), 1)
}

@test
fn test_geojson_like() {
    var jsonStr = "{\"geoType\": \"Point\", \"coordinates\": [125.6, 10.1]}"
    var geo = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<string>(geo, ["geoType"]), "Point")
    assert_eq(len(JSON.require<Array<JSON.Value>>(geo, ["coordinates"])), 2)
    assert_eq(JSON.require<f64>(geo, ["coordinates", 0]), 125.6)
    assert_eq(JSON.require<f64>(geo, ["coordinates", 1]), 10.1)
}

@test
fn test_config_file() {
    var jsonStr = "{\"version\": \"1.0.0\", \"debug\": false, \"database\": {\"host\": \"localhost\", \"port\": 5432, \"name\": \"mydb\"}, \"features\": [\"feature1\", \"feature2\", \"feature3\"]}"
    var config = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<string>(config, ["version"]), "1.0.0")
    assert_eq(JSON.require<bool>(config, ["debug"]), false)
    assert_eq(JSON.require<string>(config, ["database", "host"]), "localhost")
    assert_eq(JSON.require<i64>(config, ["database", "port"]), 5432)
    assert_eq(len(JSON.require<Array<JSON.Value>>(config, ["features"])), 3)
}

// ===== 边界情况 =====

@test
fn test_single_element_array() {
    var arr = JSON.parseValue("[42]")
    assert_eq(len(JSON.asArray(arr)!), 1)
    assert_eq(JSON.require<i64>(arr, [0]), 42)
}

@test
fn test_single_key_object() {
    var obj = JSON.parseValue("{\"key\": \"value\"}")
    assert_eq(JSON.require<string>(obj, ["key"]), "value")
}

@test
fn test_mixed_types_array() {
    var arr = JSON.parseValue("[1, \"two\", true, null, 3.14, {\"key\": \"value\"}, [1, 2]]")
    assert_eq(len(JSON.asArray(arr)!), 7)
    assert_eq(JSON.require<i64>(arr, [0]), 1)
    assert_eq(JSON.require<string>(arr, [1]), "two")
    assert_eq(JSON.require<bool>(arr, [2]), true)
    assert(JSON.isNull(JSON.require<JSON.Value>(arr, [3])))
    assert_eq(JSON.require<f64>(arr, [4]), 3.14)
    assert_eq(JSON.require<string>(arr, [5, "key"]), "value")
    assert_eq(JSON.require<i64>(arr, [6, 0]), 1)
}

@test
fn test_null_values_in_object() {
    var obj = JSON.parseValue("{\"a\": null, \"b\": null, \"c\": 1}")
    assert(JSON.isNull(JSON.require<JSON.Value>(obj, ["a"])))
    assert(JSON.isNull(JSON.require<JSON.Value>(obj, ["b"])))
    assert_eq(JSON.require<i64>(obj, ["c"]), 1)
}

@test
fn test_boolean_values_in_object() {
    var obj = JSON.parseValue("{\"yes\": true, \"no\": false}")
    assert_eq(JSON.require<bool>(obj, ["yes"]), true)
    assert_eq(JSON.require<bool>(obj, ["no"]), false)
}

// ===== stringify 嵌套测试 =====

@test
fn test_stringify_nested_array() {
    var arr = [[1, 2], [3, 4]]
    var jsonStr = JSON.stringify(arr)
    var parsed = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<i64>(parsed, [0, 0]), 1)
    assert_eq(JSON.require<i64>(parsed, [1, 1]), 4)
}

@test
fn test_stringify_nested_object() {
    var obj = { user: { name: "Alice" } }
    var jsonStr = JSON.stringify(obj)
    var parsed = JSON.parseValue(jsonStr)
    assert_eq(JSON.require<string>(parsed, ["user", "name"]), "Alice")
}

@test
fn test_stringify_complex() {
    var data = {
        users: [
            { name: "Alice", age: 30 },
            { name: "Bob", age: 25 }
        ]
    }
    var jsonStr = JSON.stringify(data)
    var parsed = JSON.parseValue(jsonStr)
    assert_eq(len(JSON.require<Array<JSON.Value>>(parsed, ["users"])), 2)
    assert_eq(JSON.require<string>(parsed, ["users", 0, "name"]), "Alice")
}
