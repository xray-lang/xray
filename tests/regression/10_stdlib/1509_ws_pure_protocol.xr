// Pure-Xray WebSocket protocol helpers.

import ws
import net

fn headerValue(headers: string, name: string) -> string? {
    var prefix = name + ": "
    var start = headers.indexOf(prefix)
    if (start < 0) { return null }
    start = start + prefix.length
    var end = headers.indexOf("\r\n", start)
    if (end < 0) { return null }
    return headers.slice(start, end)
}

fn serveMissingUpgradeResponse(lst: NetListener) {
    var maybeConn = net.accept(lst)
    if (maybeConn == null) {
        net.close(lst)
        return
    }
    var conn = maybeConn!
    var req = net.read(conn)
    if (req != null) {
        var key = headerValue(req!, "Sec-WebSocket-Key")
        if (key != null) {
            var response = "HTTP/1.1 101 Switching Protocols\r\n" +
                "Connection: Upgrade\r\n" +
                "Sec-WebSocket-Accept: " + ws.acceptKey(key!) + "\r\n\r\n"
            net.write(conn, response)
        }
    }
    net.close(conn)
    net.close(lst)
}

@test
fn test_accept_key_and_upgrade_response() {
    var key = "dGhlIHNhbXBsZSBub25jZQ=="
    assert_eq(ws.acceptKey(key), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")

    var response = ws.upgradeResponse(key)
    assert(response.includes("HTTP/1.1 101 Switching Protocols\r\n"))
    assert(response.includes("Upgrade: websocket\r\n"))
    assert(response.includes("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"))
    assert(response.endsWith("\r\n\r\n"))
}

@test
fn test_upgrade_request_and_protocol_pick() {
    var headers = "GET /chat HTTP/1.1\r\n" +
        "Host: example.com\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: keep-alive, Upgrade\r\n" +
        "Sec-WebSocket-Key: key\r\n" +
        "Sec-WebSocket-Version: 13\r\n" +
        "Sec-WebSocket-Protocol: superchat, chat\r\n\r\n"

    assert(ws.isUpgradeRequest(headers))
    assert_eq(ws.pickSubprotocol(headers, ["chat", "superchat"])!, "chat")
    assert_eq(ws.pickSubprotocol(headers, ["missing", "superchat"])!, "superchat")
}

@test
fn test_connect_rejects_invalid_urls_before_network() {
    var zeroPort = ws.connect("ws://example.com:0/", null)
    assert(zeroPort != null)
    assert_eq(zeroPort!.error, "URL parse error")

    var badPort = ws.connect("ws://example.com:abc/", null)
    assert(badPort != null)
    assert_eq(badPort!.error, "URL parse error")

    var tooLargePort = ws.connect("ws://example.com:99999/", null)
    assert(tooLargePort != null)
    assert_eq(tooLargePort!.error, "URL parse error")

    var emptyHost = ws.connect("ws://:80/", null)
    assert(emptyHost != null)
    assert_eq(emptyHost!.error, "URL parse error")

    var fragment = ws.connect("ws://example.com/#frag", null)
    assert(fragment != null)
    assert_eq(fragment!.error, "URL parse error")

    var badIpv6 = ws.connect("ws://[::1]x/", null)
    assert(badIpv6 != null)
    assert_eq(badIpv6!.error, "URL parse error")
}

@test
fn test_connect_rejects_missing_upgrade_response_header() {
    var maybeLst = net.listen(0, 8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = lst.port()

    go serveMissingUpgradeResponse(lst)

    var conn = ws.connect("ws://127.0.0.1:" + port.toString() + "/", null)
    assert(conn != null)
    assert_eq(conn!.error, "Handshake failed")
}

@test
fn test_mask_payload_and_unmasked_frame() {
    var masked = ws.maskPayload(Bytes([1, 2, 3, 4, 5]), Bytes([1, 1, 1, 1]))
    assert_eq(masked[0], 0)
    assert_eq(masked[1], 3)
    assert_eq(masked[2], 2)
    assert_eq(masked[3], 5)
    assert_eq(masked[4], 4)

    var f = ws.frame("Hi".toBytes(), 1, false)
    assert_eq(f.length, 4)
    assert_eq(f[0], 129)
    assert_eq(f[1], 2)
    assert_eq(f[2], 72)
    assert_eq(f[3], 105)

    var payload = Bytes(126)
    var ext = ws.frame(payload, 2, false)
    assert_eq(ext[0], 130)
    assert_eq(ext[1], 126)
    assert_eq(ext[2], 0)
    assert_eq(ext[3], 126)
}

print("All pure websocket protocol tests passed")
