// Test HTTP/2 client API existence

import http

@test
fn test_h2_apis_exist() {
    assert(typename(http.h2Get) == "function")
    assert(typename(http.h2Post) == "function")
    assert(typename(http.h2Request) == "function")
}

@test
fn test_h2_options_object() {
    var opts = {
        url: "https://example.com/api",
        method: "POST",
        headers: #{"Content-Type": "application/json"},
        body: "{\"key\": \"value\"}"
    }
    assert_eq(opts.method, "POST")
    assert_eq(opts.headers["Content-Type"], "application/json")
}

print("All http2 client tests passed")
