// Test HTTP/2 client API existence

import http

@test
fn test_h2_apis_exist() {
    assert(typename(http.h2Request) == "function")
}

@test
fn test_h2_options_object() {
    var opts = {
        url: "https://example.com/api",
        method: "POST",
        headers: #{"Content-Type": "application/json"},
        body: "{\"key\": \"value\"}"
    }
    assert_eq(opts.method, "POST")
    assert_eq(opts.headers["Content-Type"], "application/json")
}

@test
fn test_h2_request_rejects_http1_connection_headers() {
    assert(http.h2Request({
        url: "https://example.com/api",
        headers: Json.encode(#{"Connection": "keep-alive"})
    }) == null)

    assert(http.h2Request({
        url: "https://example.com/api",
        headers: Json.encode(#{"Host": "other.example"})
    }) == null)

    assert(http.h2Request({
        url: "https://example.com/api",
        headers: Json.encode(#{"TE": "gzip"})
    }) == null)
}

@test
fn test_h2_request_rejects_invalid_method_and_headers() {
    assert(http.h2Request({
        url: "https://example.com/api",
        method: "BAD METHOD"
    }) == null)

    assert(http.h2Request({
        url: "https://example.com/api",
        headers: Json.encode(#{"X-Bad": "a\r\nInjected: y"})
    }) == null)

    assert(http.h2Request({
        url: "https://example.com/api",
        headers: Json.encode(#{":path": "/override"})
    }) == null)
}

print("All http2 client tests passed")
