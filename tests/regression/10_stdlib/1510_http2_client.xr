// Test the typed HTTP/2 request control plane without performing network I/O.

import http
import { Headers, HttpError, HttpMethod, HttpRequestOptions, HttpVersion } from http

@test
fn test_h2_uses_unified_request_api() {
    assert(typeName(http.request) == "function")
}

@test
fn test_h2_options_object() {
    var headers = Headers()
    headers.add("Content-Type", "application/json")
    var body: Array<u8> = [123, 125]
    var opts: HttpRequestOptions = {
        url: "https://example.com/api",
        method: HttpMethod.post(),
        headers: headers,
        body: body,
        version: HttpVersion.Http2,
        timeoutMs: 2500
    }
    assertEqual(opts.method!.token, "POST")
    assertEqual(opts.headers!.get("Content-Type"), "application/json")
    assertEqual(opts.body![0], 123)
    assert(opts.version == HttpVersion.Http2)
    assertEqual(opts.timeoutMs, 2500)
}

fn h2_rejects_headers(headers: Headers) -> bool {
    try {
        http.request({
            url: "https://example.com/api",
            headers: headers,
            version: HttpVersion.Http2
        })
    } catch (e: HttpError) {
        return true
    }
    return false
}

@test
fn test_h2_request_rejects_invalid_method_and_headers() {
    assert(HttpMethod.fromToken("BAD METHOD") == null)

    var invalidValue = false
    try {
        var headers = Headers()
        headers.add("X-Bad", "a\r\nInjected: y")
    } catch HttpError.InvalidHeaderValue { value: _ } {
        invalidValue = true
    }
    assert(invalidValue)

    var pseudoHeader = false
    try {
        var headers = Headers()
        headers.add(":path", "/override")
    } catch HttpError.InvalidHeaderName { name: _ } {
        pseudoHeader = true
    }
    assert(pseudoHeader)
}

@test
fn test_h2_request_rejects_http1_connection_headers() {
    var connection = Headers()
    connection.add("Connection", "keep-alive")
    assert(h2_rejects_headers(connection))

    var host = Headers()
    host.add("Host", "other.example")
    assert(h2_rejects_headers(host))

    var te = Headers()
    te.add("TE", "gzip")
    assert(h2_rejects_headers(te))
}

print("All http2 client tests passed")
