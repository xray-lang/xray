// 作者：xingleixu@gmail.com
// 测试：JSON 字符串和转义测试
// 借鉴：simdjson 的 stringparsingcheck 测试

// ===== 基本字符串测试 =====

@test
fn test_empty_string() {
    var s = JSON.parseValue("\"\"")
    assert_eq(s, "")
    assert_eq(len(s), 0)
}

@test
fn test_simple_string() {
    assert_eq(JSON.parseValue("\"hello\""), "hello")
    assert_eq(JSON.parseValue("\"world\""), "world")
    assert_eq(JSON.parseValue("\"Hello, World!\""), "Hello, World!")
}

@test
fn test_string_with_spaces() {
    assert_eq(JSON.parseValue("\"hello world\""), "hello world")
    assert_eq(JSON.parseValue("\"  leading spaces\""), "  leading spaces")
    assert_eq(JSON.parseValue("\"trailing spaces  \""), "trailing spaces  ")
    assert_eq(JSON.parseValue("\"  both  \""), "  both  ")
}

@test
fn test_single_character_string() {
    assert_eq(JSON.parseValue("\"a\""), "a")
    assert_eq(JSON.parseValue("\"Z\""), "Z")
    assert_eq(JSON.parseValue("\"0\""), "0")
    assert_eq(JSON.parseValue("\" \""), " ")
}

// ===== 转义字符测试 =====

@test
fn test_escape_quote() {
    // 转义引号
    var s = JSON.parseValue("\"hello\\\"world\"")
    assert_eq(s, "hello\"world")
}

@test
fn test_escape_backslash() {
    // 转义反斜杠
    var s = JSON.parseValue("\"hello\\\\world\"")
    assert_eq(s, "hello\\world")
}

@test
fn test_escape_slash() {
    // 转义正斜杠（可选但应支持）
    var s = JSON.parseValue("\"hello\\/world\"")
    assert_eq(s, "hello/world")
}

@test
fn test_escape_newline() {
    // 换行符
    var s = JSON.parseValue("\"hello\\nworld\"")
    assert_eq(s.contains("\n"), true)
}

@test
fn test_escape_tab() {
    // 制表符
    var s = JSON.parseValue("\"hello\\tworld\"")
    assert_eq(s.contains("\t"), true)
}

@test
fn test_escape_carriage_return() {
    // 回车符
    var s = JSON.parseValue("\"hello\\rworld\"")
    assert_eq(s.contains("\r"), true)
}

@test
fn test_escape_backspace() {
    // 退格符
    var s = JSON.parseValue("\"hello\\bworld\"")
    assert_eq(len(s), 11)  // hello + \b + world
}

@test
fn test_escape_formfeed() {
    // 换页符
    var s = JSON.parseValue("\"hello\\fworld\"")
    assert_eq(len(s), 11)  // hello + \f + world
}

@test
fn test_multiple_escapes() {
    // 多个转义字符
    var s = JSON.parseValue("\"line1\\nline2\\ttabbed\"")
    assert_eq(s.contains("\n"), true)
    assert_eq(s.contains("\t"), true)
}

@test
fn test_consecutive_escapes() {
    // 连续转义
    var s = JSON.parseValue("\"\\n\\n\\n\"")
    assert_eq(s, "\n\n\n")
    assert_eq(len(s), 3)
}

// ===== Unicode 转义测试 =====

@test
fn test_unicode_escape_basic() {
    // 基本 Unicode 转义
    var s = JSON.parseValue("\"\\u0041\"")  // 'A'
    assert_eq(s, "A")
}

@test
fn test_unicode_escape_space() {
    // Unicode 空格
    var s = JSON.parseValue("\"\\u0020\"")  // 空格
    assert_eq(s, " ")
}

@test
fn test_unicode_escape_chinese() {
    // 中文字符
    var s = JSON.parseValue("\"\\u4e2d\\u6587\"")  // "中文"
    assert_eq(s, "中文")
}

@test
fn test_unicode_escape_emoji_bmp() {
    // BMP 范围内的字符
    var s = JSON.parseValue("\"\\u2603\"")  // 雪人 ☃
    assert_eq(len(s), 1)
}

@test
fn test_unicode_escape_mixed() {
    // 混合 Unicode 和普通文本
    var s = JSON.parseValue("\"Hello \\u4e16\\u754c\"")  // "Hello 世界"
    assert_eq(s, "Hello 世界")
}

@test
fn test_unicode_lowercase() {
    // 小写十六进制
    var s = JSON.parseValue("\"\\u0041\\u0042\\u0043\"")  // ABC
    assert_eq(s, "ABC")
}

@test
fn test_unicode_uppercase() {
    // 大写十六进制
    var s = JSON.parseValue("\"\\u0061\\u0062\\u0063\"")  // abc
    assert_eq(s, "abc")
}

// ===== Unicode 代理对测试（用于 emoji 等）=====

@test
fn test_surrogate_pair_emoji() {
    // 笑脸 😀 = U+1F600 = \uD83D\uDE00
    var s = JSON.parseValue("\"\\uD83D\\uDE00\"")
    assert_eq(len(s), 1)  // 应该是 1 个字符
}

@test
fn test_surrogate_pair_another_emoji() {
    // 心形 ❤️ 或其他 emoji
    var s = JSON.parseValue("\"\\uD83D\\uDC96\"")  // 💖
    assert_eq(len(s), 1)
}

// ===== 直接 Unicode 字符测试 =====

@test
fn test_direct_chinese() {
    var s = JSON.parseValue("\"你好世界\"")
    assert_eq(s, "你好世界")
    assert_eq(len(s), 4)
}

@test
fn test_direct_japanese() {
    var s = JSON.parseValue("\"こんにちは\"")
    assert_eq(s, "こんにちは")
}

@test
fn test_direct_korean() {
    var s = JSON.parseValue("\"안녕하세요\"")
    assert_eq(s, "안녕하세요")
}

@test
fn test_direct_emoji() {
    var s = JSON.parseValue("\"🎉🎊🎈\"")
    assert_eq(len(s), 3)
}

@test
fn test_mixed_unicode_ascii() {
    var s = JSON.parseValue("\"Hello 世界 123 🌍\"")
    assert_eq(s.contains("Hello"), true)
    assert_eq(s.contains("世界"), true)
    assert_eq(s.contains("123"), true)
}

// ===== 特殊情况测试 =====

@test
fn test_string_with_numbers() {
    assert_eq(JSON.parseValue("\"12345\""), "12345")
    assert_eq(JSON.parseValue("\"3.14\""), "3.14")
    assert_eq(JSON.parseValue("\"-100\""), "-100")
}

@test
fn test_string_with_keywords() {
    // 看起来像关键字的字符串
    assert_eq(JSON.parseValue("\"true\""), "true")
    assert_eq(JSON.parseValue("\"false\""), "false")
    assert_eq(JSON.parseValue("\"null\""), "null")
}

@test
fn test_string_with_json_chars() {
    // 包含 JSON 特殊字符
    assert_eq(JSON.parseValue("\"{}\""), "{}")
    assert_eq(JSON.parseValue("\"[]\""), "[]")
    assert_eq(JSON.parseValue("\"[1,2,3]\""), "[1,2,3]")
}

// ===== 字符串数组测试 =====

@test
fn test_string_array() {
    var arr = JSON.parseValue("[\"a\", \"b\", \"c\"]")
    assert_eq(len(arr), 3)
    assert_eq(arr[0], "a")
    assert_eq(arr[1], "b")
    assert_eq(arr[2], "c")
}

@test
fn test_mixed_string_array() {
    var arr = JSON.parseValue("[\"hello\", \"世界\", \"🎉\"]")
    assert_eq(len(arr), 3)
    assert_eq(arr[0], "hello")
    assert_eq(arr[1], "世界")
}

// ===== 对象中的字符串测试 =====

@test
fn test_string_object_keys() {
    var obj = JSON.parseValue("{\"name\": \"Alice\", \"city\": \"北京\"}")
    assert_eq(obj.name, "Alice")
    assert_eq(obj.city, "北京")
}

@test
fn test_unicode_object_keys() {
    // Unicode 键名
    var obj = JSON.parseValue("{\"名字\": \"张三\", \"城市\": \"上海\"}")
    // 通过 stringify 再 parse 验证
    var jsonStr = JSON.stringify(obj)
    assert_eq(jsonStr.contains("张三"), true)
    assert_eq(jsonStr.contains("上海"), true)
}

// ===== stringify 字符串测试 =====

@test
fn test_stringify_escape_quote() {
    var s = JSON.parseValue("\"hello\\\"world\"")
    var jsonStr = JSON.stringify(s)
    assert_eq(jsonStr.contains("hello"), true)
}

@test
fn test_stringify_escape_backslash() {
    var s = JSON.parseValue("\"hello\\\\world\"")
    var jsonStr = JSON.stringify(s)
    assert_eq(jsonStr.contains("hello"), true)
}

@test
fn test_stringify_escape_newline() {
    var s = JSON.parseValue("\"hello\\nworld\"")
    var jsonStr = JSON.stringify(s)
    assert_eq(jsonStr.contains("n"), true)
}

@test
fn test_stringify_unicode() {
    var s = "你好"
    var jsonStr = JSON.stringify(s)
    // 可能是直接输出或 \uXXXX 格式
    var parsed = JSON.parseValue(jsonStr)
    assert_eq(parsed, s)
}

