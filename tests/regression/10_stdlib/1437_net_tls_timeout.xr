// 1437_net_tls_timeout.xr
// 测试：TLS handshake timeout 必须尊重 dialTLS / upgradeTLS 的 timeout 参数

import net
import { NetError } from net
import time

fn acceptHold(lst: NetListener) {
    var conn = net.accept(lst)
    if (conn != null) {
        time.sleep(200)
        net.close(conn!)
    }
}

@test
fn test_dial_tls_handshake_timeout() {
    if (!net.hasTLS()) {
        return
    }

    var maybeLst = net.listen(0, 8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = lst.port()
    go acceptHold(lst)

    var start = time.monotonic()
    var conn = net.dialTLS("localhost", port, 30)
    var elapsed = time.monotonic() - start

    assert_true(conn == null)
    assert_true(elapsed < 1000)

    net.close(lst)
}

@test
fn test_upgrade_tls_handshake_timeout() {
    if (!net.hasTLS()) {
        return
    }

    var maybeLst = net.listen(0, 8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = lst.port()
    go acceptHold(lst)

    var conn = net.dial("127.0.0.1", port)!
    var tls = net.upgradeTLS(conn, "localhost", 30)

    assert_true(tls == null)
    assert_eq(net.lastError(conn), NetError.Timeout)

    net.close(conn)
    net.close(lst)
}
