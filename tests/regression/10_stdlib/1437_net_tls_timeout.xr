// 1437_net_tls_timeout.xr
// TLS handshake timeout: dial with DialOptions(tls) and upgradeTLS must
// honour timeoutMs as one absolute budget for the whole handshake, not a
// per-yield re-arm that lets the wait stretch far past the request.

import net
import { DialOptions, NetError, NetListener } from net
import time

fn tryListen(backlog: i64) -> NetListener? {
    try {
        return net.listen(0, backlog)
    } catch (e: NetError) {
        return null
    }
}

fn acceptHold(lst: NetListener) {
    var conn = net.accept(lst)
    if (conn != null) {
        time.sleep(200)
        net.close(conn!)
    }
}

@test
fn test_dial_tls_handshake_timeout() {
    if (!net.hasTLS()) {
        return
    }

    var maybeLst = tryListen(8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = net.port(lst)
    go acceptHold(lst)

    // The peer accepts but never speaks TLS, so the handshake can only end
    // by the deadline; the throw must land within the absolute budget.
    var start = time.monotonic()
    var caught: NetError? = null
    try {
        var conn = net.dial("localhost", port, DialOptions(30, true))
        net.close(conn)
    } catch (e: NetError) {
        caught = e
    }
    var elapsed = time.monotonic() - start

    assertEqual(caught, NetError.Timeout)
    assert(elapsed < 1000)

    net.close(lst)
}

@test
fn test_upgrade_tls_handshake_timeout() {
    if (!net.hasTLS()) {
        return
    }

    var maybeLst = tryListen(8)
    if (maybeLst == null) { return }
    var lst = maybeLst!
    var port = net.port(lst)
    go acceptHold(lst)

    var conn = net.dial("127.0.0.1", port)

    var start = time.monotonic()
    var caught: NetError? = null
    try {
        net.upgradeTLS(conn, "localhost", 30)
    } catch (e: NetError) {
        caught = e
    }
    var elapsed = time.monotonic() - start

    assertEqual(caught, NetError.Timeout)
    assert(elapsed < 1000)

    // upgradeTLS leaves the connection closed on failure.
    assertEqual(net.fd(conn), -1)

    net.close(conn)
    net.close(lst)
}
