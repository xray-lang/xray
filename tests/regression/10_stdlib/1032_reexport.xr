// 测试：re-export 语法
// export { xxx } from "./file"
// export { xxx as yyy } from "./file"
// export * from "./file"

import "./reexport_test" as lib

@test
fn test_reexport_named() {
    // 测试选择性 re-export
    var user = lib.getUser()
    assertEqual(user, "Alice")
}

@test
fn test_reexport_alias() {
    // 测试带别名的 re-export
    var age = lib.getAge()
    assertEqual(age, 25)
}

@test
fn test_reexport_all() {
    // 测试全量 re-export
    var product = lib.getProduct()
    assertEqual(product, "iPhone")
    
    var price = lib.getPrice()
    assertEqual(price, 999)
}
