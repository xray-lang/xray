// 1404_crypto_aes.xr
// Test: crypto AES-256-CBC encrypt/decrypt
//
// Coverage:
//   - encrypt/decrypt roundtrip
//   - Different key/plaintext combinations
//   - Empty string encryption
//   - Output format validation

import crypto

// ============================================================
// Encrypt/Decrypt roundtrip tests
// ============================================================

@test
fn test_encrypt_decrypt_basic() {
    var key = "my-secret-key"
    var plaintext = "Hello World"
    var encrypted = crypto.encrypt(key, plaintext)
    var decrypted = crypto.decrypt(key, encrypted)
    assertEqual(decrypted, plaintext)
}

@test
fn test_encrypt_decrypt_empty() {
    var key = "key"
    var plaintext = ""
    var encrypted = crypto.encrypt(key, plaintext)
    var decrypted = crypto.decrypt(key, encrypted)
    assertEqual(decrypted, plaintext)
}

@test
fn test_encrypt_decrypt_long_text() {
    var key = "secret-key-123"
    var plaintext = "The quick brown fox jumps over the lazy dog. This is a longer text to test multi-block encryption."
    var encrypted = crypto.encrypt(key, plaintext)
    var decrypted = crypto.decrypt(key, encrypted)
    assertEqual(decrypted, plaintext)
}

@test
fn test_encrypt_output_is_hex() {
    var encrypted = crypto.encrypt("key", "test")
    // Output should be hex string (IV 32 chars + at least 32 chars ciphertext)
    assert(len(encrypted) >= 64)
    // Length should be even
    assertEqual(len(encrypted) % 2, 0)
}

@test
fn test_encrypt_different_each_time() {
    // Due to random IV, same input should produce different output
    var e1 = crypto.encrypt("key", "test")
    var e2 = crypto.encrypt("key", "test")
    assert(e1 != e2)
}

@test
fn test_decrypt_wrong_key() {
    var encrypted = crypto.encrypt("correct-key", "secret data")
    // Decrypt with wrong key should return null (padding validation fails)
    var result = crypto.decrypt("wrong-key", encrypted)
    assertEqual(result, null)
}

@test
fn test_encrypt_decrypt_exactly_16_bytes() {
    // Exactly one block - PKCS7 adds full block of padding
    var key = "key"
    var plaintext = "1234567890123456"
    var encrypted = crypto.encrypt(key, plaintext)
    var decrypted = crypto.decrypt(key, encrypted)
    assertEqual(decrypted, plaintext)
}

@test
fn test_encrypt_decrypt_unicode() {
    var key = "unicode-key"
    var plaintext = "Hello World!"
    var encrypted = crypto.encrypt(key, plaintext)
    var decrypted = crypto.decrypt(key, encrypted)
    assertEqual(decrypted, plaintext)
}
