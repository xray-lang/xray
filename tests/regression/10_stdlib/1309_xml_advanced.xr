// 1309_xml_advanced.xr - Advanced XML module tests (typed XmlNode ADT)

import xml
import { XmlNode, XmlName, XmlAttribute, XmlError, XmlErrorKind, XmlDiagnostic } from xml

fn nodeKind(node: XmlNode) -> string {
    return match (node) {
        XmlNode.Document { children: kids }              -> "document",
        XmlNode.Element { name, attributes: attrs, children: kids }  -> "element",
        XmlNode.Text { content: s }                     -> "text",
        XmlNode.Comment { content: s }                  -> "comment",
        XmlNode.CData { content: s }                    -> "cdata",
        XmlNode.ProcessingInstruction { target: t, data: d } -> "pi"
    }
}

// ===== Entity decoding =====

@test
fn test_entity_decode_named() {
    var doc = xml.parse("<root>&lt;hello&gt; &amp; &quot;world&quot; &apos;!</root>")
    assertEqual(xml.textContent(doc), "<hello> & \"world\" '!")
}

@test
fn test_entity_decode_numeric_decimal() {
    var doc = xml.parse("<root>&#65;&#66;&#67;</root>")
    assertEqual(xml.textContent(doc), "ABC")
}

@test
fn test_entity_decode_numeric_hex() {
    var doc = xml.parse("<root>&#x41;&#x42;&#x43;</root>")
    assertEqual(xml.textContent(doc), "ABC")
}

@test
fn test_entity_decode_unicode() {
    // &#x4e2d; = 中, &#x6587; = 文
    var doc = xml.parse("<root>&#x4e2d;&#x6587;</root>")
    assertEqual(xml.textContent(doc), "中文")
}

// ===== Attribute entity decoding =====

@test
fn test_attr_entity_decode() {
    var doc = xml.parse("<a href=\"a&amp;b\"/>")
    assertEqual(xml.attr(doc, "href") ?? "", "a&b")
}

// ===== CDATA =====

@test
fn test_cdata_preserve() {
    var doc = xml.parse("<root><![CDATA[<not-xml>&]]></root>")
    var child = xml.children(doc)[0]
    assertEqual(nodeKind(child), "cdata")
    assertEqual(xml.nodeText(child) ?? "", "<not-xml>&")
}

@test
fn test_cdata_as_text() {
    var doc = xml.parse("<root><![CDATA[content]]></root>",
        { preserveWhitespace: false, preserveComments: false, preserveCData: false, validateEntities: true })
    var child = xml.children(doc)[0]
    assertEqual(nodeKind(child), "text")
    assertEqual(xml.nodeText(child) ?? "", "content")
}

// ===== Self-closing with attributes =====

@test
fn test_self_closing_with_attrs() {
    var doc = xml.parse("<root><img src=\"a.png\" alt=\"pic\"/></root>")
    var img = xml.children(doc)[0]
    assertEqual(xml.tag(img) ?? "", "img")
    assertEqual(xml.attr(img, "src") ?? "", "a.png")
    assertEqual(xml.attr(img, "alt") ?? "", "pic")
    assertEqual(len(xml.children(img)), 0)
}

// ===== Processing instruction =====

@test
fn test_skip_processing_instruction() {
    var doc = xml.parse("<?xml version=\"1.0\"?><root>OK</root>")
    assertEqual(xml.tag(doc) ?? "", "root")
}

// ===== Create element with attrs =====

@test
fn test_create_element_with_attrs() {
    var attrs: Array<XmlAttribute> = [
        XmlAttribute(XmlName("", "class"), "container"),
        XmlAttribute(XmlName("", "id"), "main")
    ]
    var elem = xml.element("div", attrs)
    assertEqual(xml.tag(elem) ?? "", "div")
    assertEqual(xml.attr(elem, "class") ?? "", "container")
    assertEqual(xml.attr(elem, "id") ?? "", "main")
    assertEqual(len(xml.children(elem)), 0)
}

// ===== Create text/comment/cdata nodes =====

@test
fn test_create_text_node() {
    var node = xml.text("hello")
    assertEqual(nodeKind(node), "text")
    assertEqual(xml.nodeText(node) ?? "", "hello")
}

@test
fn test_create_comment_node() {
    var node = xml.comment(" a comment ")
    assertEqual(nodeKind(node), "comment")
    assertEqual(xml.nodeText(node) ?? "", " a comment ")
}

@test
fn test_create_cdata_node() {
    var node = xml.cdata("<raw>&data")
    assertEqual(nodeKind(node), "cdata")
    assertEqual(xml.nodeText(node) ?? "", "<raw>&data")
}

// ===== Create document =====

@test
fn test_create_document() {
    var doc = xml.document()
    assertEqual(nodeKind(doc), "document")
}

// ===== Stringify roundtrip =====

@test
fn test_stringify_roundtrip() {
    var doc = xml.parse("<root><item id=\"1\">Hello</item><item id=\"2\">World</item></root>")
    var str = xml.stringify(doc, { indent: 0, declaration: false, encoding: "UTF-8" })
    var doc2 = xml.parse(str)
    assertEqual(xml.tag(doc2) ?? "", "root")
    var kids = xml.children(doc2)
    assertEqual(len(kids), 2)
    assertEqual(xml.attr(kids[0], "id") ?? "", "1")
    assertEqual(xml.textContent(kids[1]), "World")
}

// ===== ParseReport with diagnostics =====

@test
fn test_parse_report_valid() {
    var report = xml.parseReport("<ok/>")
    assert(report.doc != null)
    assertEqual(xml.tag(report.doc!) ?? "", "ok")
    assertEqual(len(report.diagnostics), 0)
}

@test
fn test_parse_report_unknown_entity() {
    var report = xml.parseReport("<root>&nope;</root>")
    assert(report.doc != null)
    assertEqual(len(report.diagnostics), 1)
    assertEqual(report.diagnostics[0].kind == XmlErrorKind.InvalidEntity, true)
}

// ===== parse throws on malformed input =====

@test
fn test_parse_throws_on_no_root() {
    var threw = false
    try {
        xml.parse("just text, no element")
    } catch (e: XmlError) {
        threw = true
    }
    assertEqual(threw, true)
}

// ===== Whitespace handling =====

@test
fn test_whitespace_stripped_by_default() {
    var doc = xml.parse("<root>  \n  <item/>\n  </root>")
    assertEqual(len(xml.children(doc)), 1)
    assertEqual(xml.tag(xml.children(doc)[0]) ?? "", "item")
}

@test
fn test_whitespace_preserved() {
    var doc = xml.parse("<root> text </root>",
        { preserveWhitespace: true, preserveComments: false, preserveCData: true, validateEntities: true })
    // Should preserve whitespace-only text nodes
    assertEqual(len(xml.children(doc)), 1)
}

// ===== DOCTYPE handling =====

@test
fn test_skip_doctype() {
    var doc = xml.parse("<!DOCTYPE html><root>OK</root>")
    assertEqual(xml.tag(doc) ?? "", "root")
}

@test
fn test_skip_doctype_with_internal_subset() {
    var doc = xml.parse("<!DOCTYPE root [ <!ELEMENT root (#PCDATA)> ]><root>OK</root>")
    assertEqual(xml.tag(doc) ?? "", "root")
    assertEqual(xml.textContent(doc), "OK")
}

// ===== Escape in stringify =====

@test
fn test_stringify_escapes_text() {
    var doc = xml.parse("<p>&lt;script&gt;</p>")
    var str = xml.stringify(doc, { indent: 0, declaration: false, encoding: "UTF-8" })
    assertEqual(str, "<p>&lt;script&gt;</p>")
}

// ===== Mixed content =====

@test
fn test_mixed_content() {
    var doc = xml.parse("<root>Hello<b>World</b>!</root>")
    var kids = xml.children(doc)
    assertEqual(len(kids), 3)
    assertEqual(nodeKind(kids[0]), "text")
    assertEqual(xml.nodeText(kids[0]) ?? "", "Hello")
    assertEqual(xml.tag(kids[1]) ?? "", "b")
    assertEqual(nodeKind(kids[2]), "text")
    assertEqual(xml.nodeText(kids[2]) ?? "", "!")
}
