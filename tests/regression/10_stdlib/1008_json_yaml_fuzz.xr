// Bounded parser stress for JSON and the typed YAML ADT.

import yaml
import { YamlValue } from yaml

fn get_int(value: YamlValue, key: string) -> i64 {
    return yaml.asInt(yaml.get(value, key)!) ?? -1
}

@test
fn test_json_nested_paths() {
    for (depth in 1..8) {
        var text = ""
        var path: JSON.Path = []
        for (i in 0..depth) {
            text += "{\"k" + string(i) + "\":"
            path.push("k" + string(i))
        }
        text += "42"
        for (_ in 0..depth) { text += "}" }
        assertEqual(JSON.require<i64>(JSON.parseValue(text), path), 42)
    }
}

@test
fn test_json_wide_objects() {
    var object: JSON.Object = JSON.parseObject("{}")
    for (i in 0..100) { object.set("f" + string(i), i) }
    var round = JSON.parseValue(JSON.stringify(object))
    assertEqual(JSON.require<i64>(round, ["f0"]), 0)
    assertEqual(JSON.require<i64>(round, ["f99"]), 99)
}

@test
fn test_yaml_typed_roundtrip() {
    var source = "name: xray\nversion: 2\nitems: [one, two]"
    var parsed = yaml.parse(source)
    assertEqual(yaml.asString(yaml.get(parsed, "name")!), "xray")
    assertEqual(get_int(parsed, "version"), 2)
    var emitted = yaml.stringify(parsed)
    var reparsed = yaml.parse(emitted)
    assertEqual(get_int(reparsed, "version"), 2)
}
