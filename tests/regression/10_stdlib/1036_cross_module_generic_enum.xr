// 1036_cross_module_generic_enum.xr
// 回归：跨模块导出的泛型 ADT enum 需要保留 payload 类型元数据。

import { Result, makeBytes } from "./modules/generic_result_lib"

fn byteScore(payload: Bytes) -> int {
    return payload.length + payload[0]
}

@test
fn test_cross_module_generic_enum_payload_type() {
    match (makeBytes()) {
        Result.Ok(payload) -> {
            assert_eq(byteScore(payload), 67)
        }
        Result.Err(_) -> {
            assert(false)
        }
    }
}
