// 1036_cross_module_generic_enum.xr
// 回归：跨模块导出的泛型 ADT enum 需要保留 payload 类型元数据。
import { Result, Traffic, makeByteArray } from "./modules/generic_result_lib"

fn byteScore(payload: Array<u8>) -> i64 {
    return len(payload) + (payload[0] as i64)
}

@test
fn test_cross_module_generic_enum_payload_type() {
    match (makeByteArray()) {
        Result.Ok { value: payload } -> {
            assertEqual(byteScore(payload), 67)
        }
        Result.Err { error: _ }      -> {
            assert(false)
        }
    }
}

@test
fn test_cross_module_enum_static_domains() {
    var count = 0
    for (signal in Traffic) {
        assertEqual(signal.ordinal, count)
        count += 1
    }
    assertEqual(count, 3)
    assertEqual(Traffic.variants[1].name, "Ready")
    assertEqual(Result<i64>.variants[0].payloads[0].type, Type.i64)
}
