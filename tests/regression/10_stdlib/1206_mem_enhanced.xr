// Test enhanced mem module - RC-native API and edge cases
//
// REGRESSION: Bugs #8 / #10 / #11 - GC chain corruption under
//             --jit-force (commits 5f7a535 + 2e1dacc).
// FAIL_AT:    pre-5f7a535 / pre-2e1dacc on x64 with --jit-force,
//             >50% rate on the 1205+1206+1207 mem-stress combo
//             -> Bug #8 (5f7a535): sweep_block rebuilt
//                block->alloc_marks without first flushing the
//                deferred JIT-inline-allocator marks; lines actually
//                holding live objects were treated as free, the hole
//                scanner allocated new objects on top of still-live
//                ones, and the next sweep walked a corrupted
//                local_allgc list and crashed on a garbage curr ptr
//                (e.g. 0x0000_0004_0000_0005).
//             -> Bug #10 (2e1dacc): mark_coro_roots scanned the JIT
//                runtime stack map using ARM64 frame layout constants on
//                x64; the "pointers" so obtained were garbage that
//                reallymarkobject dereferenced and stamped 0x04 over
//                neighbouring live chain links.
//             -> Bug #11 (2e1dacc): conservative stack scan of
//                xr_coro_vm_ctx(coro)->stack tagged JIT-frame XrValue slots as
//                live PTRs, but the JIT never writes vm_ctx.stack, so
//                those triplets were stale leftovers from earlier
//                interpreter activations and the ptr no longer aimed
//                at a valid object start.
// PASS_AT:    5f7a535+ (xr_immix_flush_marks at sweep_block entry,
//             idempotent so steady-state cost is negligible) AND
//             2e1dacc+ (ARM64-only guard around the stack-map scan,
//             plus four-shape object header validate at markobject entry).
//             1206 under --jit-force: 30/30 burn-in green on
//             Windows x64.
// REQUIRES_JIT_FORCE  (for Bugs #10 / #11; Bug #8 also surfaces
//                     under --no-jit when JIT inline allocator runs
//                     in the same process, but the 1206 case is the
//                     historical reproducer under JIT-force).
//
// Triggering combination: 1206 alone gives partial coverage;
// `scripts/run_mem_stress.sh 10` exercises 1205/1206/1207 in
// rotation, which is the exact sequence that surfaced all three
// bugs during the May 2026 burn-in.

import mem

// @test mem.disableCycleCollection/enableCycleCollection pairing toggles the automatic cycle collector
@test
fn test_mem_disable_enable() {
    assert_eq(mem.isCycleCollectionEnabled(), true)
    mem.disableCycleCollection()
    assert_eq(mem.isCycleCollectionEnabled(), false)
    mem.enableCycleCollection()
    assert_eq(mem.isCycleCollectionEnabled(), true)
}

// @test mem.disableCycleCollection pauses the automatic cycle collector
@test
fn test_mem_disable_prevents_gc() {
    mem.disableCycleCollection()
    let before_count = mem.info()["cycleCollections"]
    // Allocate a bunch of objects
    let arr: Array<Json> = []
    for (let i = 0; i < 500; i++) {
        arr.push(#{"idx": i, "data": "item_" + string(i)})
    }
    // Automatic cycle collection must not have run while disabled
    let after_count = mem.info()["cycleCollections"]
    assert_eq(before_count, after_count)
    assert(arr.length == 500)
    mem.enableCycleCollection()
}

// @test mem.info contains the RC-native keys
@test
fn test_mem_info_keys() {
    let info = mem.info()
    // Live memory + object stats
    assert(info["liveBytes"] >= 0)
    assert(info["liveKB"] >= 0.0)
    assert(info["liveObjects"] >= 0)
    // Automatic cycle collector state
    assert(info["cycleCollections"] >= 0)
    assert_eq(typeof(info["cycleCollectionEnabled"]), "bool")
    assert(info["finalizerCount"] >= 0)
    // Region block stats
    assert(info["blocks"] >= 0)
    assert(info["freeBlocks"] >= 0)
    assert(info["fullBlocks"] >= 0)
}

// @test mem.collectCycles returns a monotonic cycle count
@test
fn test_mem_collect_returns_count() {
    // Under RC the cycle counter never decreases. A cycle-free program may
    // report the same count across collects — assert monotonicity, not growth.
    let count1 = mem.collectCycles()
    let count2 = mem.collectCycles()
    assert(count2 >= count1)
}

// @test mem.liveBytes decreases after collect with dead objects
@test
fn test_mem_live_bytes_decreases_after_collect() {
    mem.collectCycles()
    let baseline = mem.liveBytes()
    // Create objects in a scope that makes them collectable
    fn make_garbage() {
        let temp: Array<Json> = []
        for (let i = 0; i < 200; i++) {
            temp.push(#{"garbage": i})
        }
    }
    make_garbage()
    let after_alloc = mem.liveBytes()
    assert(after_alloc >= baseline)
    mem.collectCycles()
    let after_collect = mem.liveBytes()
    // Memory should not grow after collecting the garbage
    assert(after_collect <= after_alloc)
}

// @test mem.liveObjects tracks allocations
@test
fn test_mem_live_objects_tracks_alloc() {
    let before = mem.liveObjects()
    let arr: Array<Json> = []
    for (let i = 0; i < 10; i++) {
        arr.push(#{"k": i})
    }
    // Xray reclaims by reference counting: a value is freed at its LAST use, not
    // at the end of the enclosing scope. `arr` must therefore be used again
    // AFTER `after` is sampled, otherwise ARC would have already released `arr`
    // (and its 10 elements) by this line and the live-object count would read
    // back as `before`. The touch below extends arr's lifetime across the
    // measurement so the just-allocated objects are still counted.
    let after = mem.liveObjects()
    assert(arr.length == 10)
    assert(after > before)
}

print("All enhanced mem tests passed")
