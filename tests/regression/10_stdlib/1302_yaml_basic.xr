// 1302_yaml_basic.xr - YAML module tests

import yaml

// ===== Basic key-value =====

@test
fn test_parse_basic() {
    var data = "name: Alice\nage: 30\nactive: true"
    var obj = yaml.parse(data)
    assert_eq(obj["name"], "Alice")
    assert_eq(obj["age"], 30)
    assert_eq(obj["active"], true)
}

// ===== Nested mapping =====

@test
fn test_parse_nested() {
    var data = "server:\n  host: localhost\n  port: 8080"
    var obj = yaml.parse(data)
    var server = obj["server"]
    assert_eq(server["host"], "localhost")
    assert_eq(server["port"], 8080)
}

// ===== Flow sequence =====

@test
fn test_parse_flow_sequence() {
    var data = "list: [1, 2, 3]"
    var obj = yaml.parse(data)
    var list = obj["list"]
    assert_eq(list[0], 1)
    assert_eq(list[2], 3)
}

// ===== Flow mapping =====

@test
fn test_parse_flow_mapping() {
    var data = "map: {a: 1, b: 2}"
    var obj = yaml.parse(data)
    var map = obj["map"]
    assert_eq(map["a"], 1)
    assert_eq(map["b"], 2)
}

// ===== Quoted strings =====

@test
fn test_parse_quoted_strings() {
    var data = "single: 'hello'\ndouble: \"world\""
    var obj = yaml.parse(data)
    assert_eq(obj["single"], "hello")
    assert_eq(obj["double"], "world")
}

// ===== Stringify =====

@test
fn test_stringify() {
    var config: Json = {"name": "xray", "version": 1}
    var result = yaml.stringify(config)
    assert(len(result) > 0)
}
