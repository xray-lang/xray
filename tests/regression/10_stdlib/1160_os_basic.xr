// 1160_os_basic.xr - OS module basic tests

import os
import io
import path

// ===== Constants =====

@test
fn test_platform() {
    var p = os.platform()
    assert(p == "darwin" || p == "linux" || p == "windows")
}

@test
fn test_arch() {
    var a = os.arch()
    assert(a == "arm64" || a == "x64" || a == "x86")
}

@test
fn test_sep() {
    var s = os.sep()
    assert(s == "/" || s == "\\")
}

@test
fn test_eol() {
    var e = os.eol()
    assert(e == "\n" || e == "\r\n")
}

// ===== Environment Variables =====

@test
fn test_getenv_path() {
    var path = os.getenv("PATH")
    assert(path != null)
    assert(len(path!) > 0)
}

@test
fn test_getenv_nonexistent() {
    var val = os.getenv("XRAY_TEST_NONEXISTENT_VAR_12345")
    assertEqual(val, null)
}

@test
fn test_setenv_getenv() {
    os.setenv("XRAY_TEST_VAR", "hello_xray")
    var val = os.getenv("XRAY_TEST_VAR")
    assertEqual(val, "hello_xray")

    // cleanup
    os.unsetenv("XRAY_TEST_VAR")
    var val2 = os.getenv("XRAY_TEST_VAR")
    assertEqual(val2, null)
}

@test
fn test_setenv_overwrite() {
    os.setenv("XRAY_TEST_OW", "first")
    assertEqual(os.getenv("XRAY_TEST_OW"), "first")

    os.setenv("XRAY_TEST_OW", "second")
    assertEqual(os.getenv("XRAY_TEST_OW"), "second")

    os.unsetenv("XRAY_TEST_OW")
}

@test
fn test_environ() {
    os.setenv("XRAY_TEST_ENV_EMPTY", "")
    var env = os.environ()
    // PATH should exist; Windows may store it as "Path"
    var path = env.get("PATH")
    if (path == null) {
        path = env.get("Path")
    }
    assert(path != null)
    assertEqual(env.get("XRAY_TEST_ENV_EMPTY"), "")
    os.unsetenv("XRAY_TEST_ENV_EMPTY")
}

// ===== Process Info =====

@test
fn test_getpid() {
    var pid = os.getpid()
    assert(pid > 0)
}

@test
fn test_getcwd() {
    var cwd = os.getcwd()
    assert(len(cwd) > 0)
}

@test
fn test_hostname() {
    var h = os.hostname()
    assert(len(h) > 0)
}

@test
fn test_tmpdir() {
    var tmp = os.tmpdir()
    assert(len(tmp) > 0)
}

@test
fn test_tmpdir_skips_empty_env_candidate() {
    var oldTmpdir = os.getenv("TMPDIR")
    var oldTmp = os.getenv("TMP")
    var oldTemp = os.getenv("TEMP")

    os.setenv("TMPDIR", "")
    os.setenv("TMP", "/tmp/xray_tmpdir_fallback")
    os.setenv("TEMP", "/tmp/xray_tmpdir_wrong")

    assertEqual(os.tmpdir(), "/tmp/xray_tmpdir_fallback")

    if (oldTmpdir != null) {
        os.setenv("TMPDIR", oldTmpdir ?? "")
    } else {
        os.unsetenv("TMPDIR")
    }
    if (oldTmp != null) {
        os.setenv("TMP", oldTmp ?? "")
    } else {
        os.unsetenv("TMP")
    }
    if (oldTemp != null) {
        os.setenv("TEMP", oldTemp ?? "")
    } else {
        os.unsetenv("TEMP")
    }
}

// ===== chdir =====

@test
fn test_chdir() {
    var original = os.getcwd()
    var tmp = os.tmpdir()

    io.chdir(path.from(tmp))
    var newCwd = os.getcwd()
    // Should have changed (may differ due to symlink resolution)
    assert(len(newCwd) > 0)

    // Restore
    io.chdir(path.from(original))
    assertEqual(os.getcwd(), original)
}
