// 1405_crypto_utils.xr
// Test: crypto utility functions
//
// Coverage:
//   - timingSafeEqual
//   - Hash length validation for all algorithms

import crypto

// ============================================================
// timingSafeEqual tests
// ============================================================

@test
fn test_timing_safe_equal_same() {
    assert(crypto.timingSafeEqual("hello", "hello"))
}

@test
fn test_timing_safe_equal_different() {
    assert(!crypto.timingSafeEqual("hello", "world"))
}

@test
fn test_timing_safe_equal_different_length() {
    assert(!crypto.timingSafeEqual("short", "longer string"))
}

@test
fn test_timing_safe_equal_empty() {
    assert(crypto.timingSafeEqual("", ""))
}

@test
fn test_timing_safe_equal_hmac_verify() {
    // Typical usage: verify HMAC
    var expected = crypto.hmac("sha256", "secret", "data")!
    var actual = crypto.hmac("sha256", "secret", "data")!
    assert(crypto.timingSafeEqual(expected, actual))
}

@test
fn test_timing_safe_equal_hmac_mismatch() {
    var expected = crypto.hmac("sha256", "secret", "data")!
    var tampered = crypto.hmac("sha256", "secret", "tampered")!
    assert(!crypto.timingSafeEqual(expected, tampered))
}

// ============================================================
// All hash lengths
// ============================================================

@test
fn test_all_hash_lengths() {
    assertEqual(len(crypto.md5("x")), 32)
    assertEqual(len(crypto.sha1("x")), 40)
    assertEqual(len(crypto.sha256("x")), 64)
    assertEqual(len(crypto.sha512("x")), 128)
}

@test
fn test_all_hmac_lengths() {
    assertEqual(len(crypto.hmac("md5", "k", "d")!), 32)
    assertEqual(len(crypto.hmac("sha1", "k", "d")!), 40)
    assertEqual(len(crypto.hmac("sha256", "k", "d")!), 64)
    assertEqual(len(crypto.hmac("sha512", "k", "d")!), 128)
}
