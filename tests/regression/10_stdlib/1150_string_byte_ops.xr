// 1150_string_byte_ops.xr - String byte-level operations

// ===== byteAt =====

@test
fn test_byte_at() {
    var s = "ACGT"
    assert_eq(s.byteAt(0), "A")
    assert_eq(s.byteAt(1), "C")
    assert_eq(s.byteAt(2), "G")
    assert_eq(s.byteAt(3), "T")
    assert_eq(s.byteAt(-1), "T")
    assert_eq(s.byteAt(-4), "A")
}

@test
fn test_byte_at_out_of_bounds() {
    var s = "ACGT"
    assert_eq(s.byteAt(4), null)
    assert_eq(s.byteAt(100), null)
    assert_eq(s.byteAt(-5), null)
}

// ===== byteAt + ord on raw octets (binary I/O) =====
// Single-byte strings from byteAt() on binary buffers are raw octets, not
// UTF-8 code units. ord() must return the unsigned byte 0..255 directly,
// never the UTF-8 replacement rune (0xFFFD). codePointAt() must NOT be used
// to recover high bytes — it UTF-8-decodes and corrupts octets >= 0x80.

@test
fn test_byte_at_ord_high_bytes() {
    // "é" = 0xC3 0xA9, "€" = 0xE2 0x82 0xAC in UTF-8
    var s = "é€"
    assert_eq(s.byteLength, 5)
    assert_eq(s.byteAt(0)!.ord(), 195)  // 0xC3
    assert_eq(s.byteAt(1)!.ord(), 169)  // 0xA9
    assert_eq(s.byteAt(2)!.ord(), 226)  // 0xE2
    assert_eq(s.byteAt(3)!.ord(), 130)  // 0x82
    assert_eq(s.byteAt(4)!.ord(), 172)  // 0xAC
}

@test
fn test_byte_at_ord_ascii_matches_octet() {
    var s = "ACGT"
    assert_eq(s.byteAt(0)!.ord(), 65)
    assert_eq(s.byteAt(3)!.ord(), 84)
}

// ===== reverse (ASCII data only — Unicode reverse is rune-aware) =====

@test
fn test_reverse_ascii() {
    assert_eq("ACGT".reverse(), "TGCA")
    assert_eq("Hello".reverse(), "olleH")
    assert_eq("".reverse(), "")
    assert_eq("A".reverse(), "A")
}

// ===== byteAt vs charAt consistency =====

@test
fn test_byte_at_equals_char_at_ascii() {
    var dna = "ACGTACGTACGT"
    var i = 0
    while (i < dna.byteLength) {
        assert_eq(dna.charAt(i), dna.byteAt(i))
        i = i + 1
    }
}


// ===== DNA reverse complement =====

var COMP = #{"A": "T", "T": "A", "C": "G", "G": "C"}

fn reverseComplement(seq: string) -> string {
    var reversed = seq.reverse()
    var sb = StringBuilder()
    var j = 0
    var byteCount = len(seq.bytes())
    while (j < byteCount) {
        // byteAt is declared string? (null out of bounds); j < len keeps
        // this access in bounds, so unwrap directly.
        var c = reversed.byteAt(j)!
        var comp = COMP.get(c)
        if (comp != null) {
            sb.append(comp)
        } else {
            sb.append(c)
        }
        j = j + 1
    }
    return sb.toString()
}

@test
fn test_reverse_complement() {
    assert_eq(reverseComplement("ACGT"), "ACGT")
    assert_eq(reverseComplement("AAAA"), "TTTT")
    assert_eq(reverseComplement("CCCC"), "GGGG")
    assert_eq(reverseComplement("AACG"), "CGTT")
}
