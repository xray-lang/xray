// HTTP multipart/form-data pure-Xray builder.

import http
import { formData } from http
import io
import path

@test
fn test_formdata_text_build() {
    var form = formData()
    assert(form.append("name", "Xray"))

    var built = form.build()
    assert(built.contentType.startsWith("multipart/form-data; boundary=----XrayFormBoundary"))
    assert(built.body.contains("Content-Disposition: form-data; name=\"name\"\r\n\r\n"))
    assert(built.body.contains("\r\n\r\nXray\r\n"))
    assert(built.body.endsWith("--\r\n"))
}

@test
fn test_formdata_file_build() {
    var dir = io.tempDir()!
    var uploadPath = path.join(dir, path.from("upload.txt"))
    assert(io.writeFile(uploadPath, "file-data"))

    var form = http.formData()
    assert(form.appendFile("upload", uploadPath))

    var built = form.build()
    assert(built.body.contains("name=\"upload\"; filename=\"upload.txt\""))
    assert(built.body.contains("Content-Type: text/plain\r\n\r\n"))
    assert(built.body.contains("\r\n\r\nfile-data\r\n"))
}

@test
fn test_formdata_limits() {
    var limited = formData(3, 3)
    assert(!limited.append("field", "abcd"))
    assertEqual(limited.totalSize, 0)

    var unlimited = formData(0, 0)
    assert(unlimited.append("field", "abcd"))
    assertEqual(unlimited.totalSize, 4)
}

@test
fn test_formdata_file_limit() {
    var dir = io.tempDir()!
    var bigPath = path.join(dir, path.from("big.bin"))
    assert(io.writeFile(bigPath, "abcd"))

    var limited = formData(0, 3)
    assert(!limited.appendFile("file", bigPath))
    assertEqual(limited.totalSize, 0)
}

print("All http formdata pure tests passed")
