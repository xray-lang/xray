// 1432_net_typed_handle.xr
// Typed native handle (XrNetConn / XrNetListener) methods.
//
// Covers:
//   - listener.fd() / listener.port() / listener.close() / listener.isClosed()
//   - module-level net.close / net.fd interoperate with typed handles
//
// net.listen throws NetError on setup failure, so the environment-dependent
// skip folds the throw back into null here.

import net
import { NetError } from net

fn tryListen(backlog: i64) -> NetListener? {
    try {
        return net.listen(0, backlog)
    } catch (e: NetError) {
        return null
    }
}

@test
fn test_listener_methods() {
    // listen on an ephemeral port (0 -> kernel picks)
    var listener = tryListen(16)
    if (listener == null) { return }

    // method-style accessors
    const fd = listener!.fd()
    assert(fd >= 0)
    assert(listener!.port() > 0)
    assert(!listener!.isClosed())

    // close() is idempotent
    listener!.close()
    assert(listener!.isClosed())
    assert(listener!.fd() == -1)

    // Calling close again is a no-op
    listener!.close()
    assert(listener!.isClosed())
}

@test
fn test_module_and_method_interop() {
    // The module-level function (net.fd) and the typed method must agree
    // both before and after close.
    var listener = tryListen(1)
    if (listener == null) { return }

    assert(net.fd(listener!) == listener!.fd())

    net.close(listener!)
    assert(listener!.isClosed())
    assert(listener!.fd() == -1)
    assert(net.fd(listener!) == -1)
}

// ============================================================
// Method dispatch via type inference
// ============================================================

@test
fn test_method_dispatch_via_inference() {
    var listener = tryListen(1)
    if (listener == null) { return }

    var l = listener!
    assert(l.fd() >= 0)
    assert(l.port() > 0)

    l.close()
    assert(l.isClosed())
}

// ============================================================
// Method dispatch via explicit typed annotations
//
// NetConn / NetListener are registered as prelude entries with the
// XrClasses pre-installed by xr_prelude_register_all_native_types, so a
// user-side NetListener? / NetListener annotation type-checks and
// dispatches methods through the same path that inference uses.
// ============================================================

@test
fn test_explicit_typed_listener() {
    var listener: NetListener? = tryListen(1)
    if (listener == null) { return }

    var l: NetListener = listener!
    assert(l.fd() >= 0)
    assert(l.port() > 0)
    assert(!l.isClosed())

    l.close()
    assert(l.isClosed())
}
