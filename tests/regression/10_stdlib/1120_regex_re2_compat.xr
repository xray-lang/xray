/**
 * @file 1120_regex_re2_compat.xr
 * @brief RE2 正则引擎兼容性回归测试
 * @author xingleixu@gmail.com
 * 
 * 基于 re2/testing 测试用例，确保 xray 正则库与 RE2 兼容
 */

import regex

// ============================================================================
// 辅助函数
// ============================================================================

fn match_ok(pattern: string, text: string) throws(regex.RegexError) -> bool {
    var re = (try regex.compile(pattern))
    return regex.find(re, text) != null
}

fn match_eq(pattern: string, text: string, expected: string) throws(regex.RegexError) -> bool {
    var re = (try regex.compile(pattern))
    var result = regex.find(re, text)
    if (result == null) {
        return false
    }
    return result.text == expected
}

// ============================================================================
// 1. 基本字面量匹配
// ============================================================================

@test
fn test_literal_single_char() throws(regex.RegexError) {
    assertEqual((try match_ok("a", "a")), true)
    assertEqual((try match_ok("a", "b")), false)
    assertEqual((try match_ok("a", "")), false)
}

@test
fn test_literal_in_string() throws(regex.RegexError) {
    assertEqual((try match_ok("a", "zyzzyva")), true)
    assertEqual((try match_ok("a", "cab")), true)
    assertEqual((try match_ok("hello", "hello world")), true)
}

@test
fn test_literal_multi_char() throws(regex.RegexError) {
    assertEqual((try match_ok("abc", "abc")), true)
    assertEqual((try match_ok("abc", "xabcy")), true)
    assertEqual((try match_ok("abc", "ab")), false)
}

// ============================================================================
// 2. 量词测试
// ============================================================================

@test
fn test_star_quantifier() throws(regex.RegexError) {
    assertEqual((try match_ok("a*", "")), true)
    assertEqual((try match_ok("a*", "a")), true)
    assertEqual((try match_ok("a*", "aaa")), true)
    assertEqual((try match_ok("a*", "b")), true)  // 空匹配
}

@test
fn test_plus_quantifier() throws(regex.RegexError) {
    assertEqual((try match_ok("a+", "")), false)
    assertEqual((try match_ok("a+", "a")), true)
    assertEqual((try match_ok("a+", "aaa")), true)
    assertEqual((try match_ok("a+", "b")), false)
}

@test
fn test_question_quantifier() throws(regex.RegexError) {
    assertEqual((try match_ok("a?", "")), true)
    assertEqual((try match_ok("a?", "a")), true)
    assertEqual((try match_ok("a?", "aa")), true)
    assertEqual((try match_ok("a?", "b")), true)  // 空匹配
}

@test
fn test_repeat_exact() throws(regex.RegexError) {
    assertEqual((try match_ok("a{2}", "a")), false)
    assertEqual((try match_ok("a{2}", "aa")), true)
    assertEqual((try match_ok("a{2}", "aaa")), true)
}

@test
fn test_repeat_range() throws(regex.RegexError) {
    assertEqual((try match_ok("a{2,3}", "a")), false)
    assertEqual((try match_ok("a{2,3}", "aa")), true)
    assertEqual((try match_ok("a{2,3}", "aaa")), true)
    assertEqual((try match_ok("a{2,3}", "aaaa")), true)
}

@test
fn test_repeat_min() throws(regex.RegexError) {
    assertEqual((try match_ok("a{2,}", "a")), false)
    assertEqual((try match_ok("a{2,}", "aa")), true)
    assertEqual((try match_ok("a{2,}", "aaaa")), true)
}

// ============================================================================
// 3. 锚点测试
// ============================================================================

@test
fn test_anchor_begin() throws(regex.RegexError) {
    assertEqual((try match_ok("^a", "a")), true)
    assertEqual((try match_ok("^a", "ba")), false)
    assertEqual((try match_ok("^", "x")), true)
    assertEqual((try match_ok("^", "")), true)
}

@test
fn test_anchor_end() throws(regex.RegexError) {
    assertEqual((try match_ok("a$", "a")), true)
    assertEqual((try match_ok("a$", "ab")), false)
    assertEqual((try match_ok("$", "x")), true)
    assertEqual((try match_ok("$", "")), true)
}

@test
fn test_anchor_both() throws(regex.RegexError) {
    assertEqual((try match_ok("^a$", "a")), true)
    assertEqual((try match_ok("^a$", "ab")), false)
    assertEqual((try match_ok("^a$", "ba")), false)
    assertEqual((try match_ok("^$", "")), true)
    assertEqual((try match_ok("^$", "a")), false)
}

@test
fn test_anchor_with_alt() throws(regex.RegexError) {
    assertEqual((try match_ok("^(foo|bar)$", "foo")), true)
    assertEqual((try match_ok("^(foo|bar)$", "bar")), true)
    assertEqual((try match_ok("^(foo|bar)$", "baz")), false)
}

// ============================================================================
// 4. 字符类测试
// ============================================================================

@test
fn test_char_class_simple() throws(regex.RegexError) {
    assertEqual((try match_ok("[abc]", "a")), true)
    assertEqual((try match_ok("[abc]", "b")), true)
    assertEqual((try match_ok("[abc]", "c")), true)
    assertEqual((try match_ok("[abc]", "d")), false)
}

@test
fn test_char_class_range() throws(regex.RegexError) {
    assertEqual((try match_ok("[a-z]", "a")), true)
    assertEqual((try match_ok("[a-z]", "m")), true)
    assertEqual((try match_ok("[a-z]", "z")), true)
    assertEqual((try match_ok("[a-z]", "A")), false)
    assertEqual((try match_ok("[a-z]", "0")), false)
}

@test
fn test_char_class_negated() throws(regex.RegexError) {
    assertEqual((try match_ok("[^a]", "b")), true)
    assertEqual((try match_ok("[^a]", "a")), false)
    assertEqual((try match_ok("[^a-z]", "A")), true)
    assertEqual((try match_ok("[^a-z]", "0")), true)
    assertEqual((try match_ok("[^a-z]", "a")), false)
    assertEqual((try match_ok("[^0-9]", "a")), true)
    assertEqual((try match_ok("[^0-9]", "5")), false)
}

@test
fn test_char_class_combined() throws(regex.RegexError) {
    assertEqual((try match_ok("[a-zA-Z]", "a")), true)
    assertEqual((try match_ok("[a-zA-Z]", "Z")), true)
    assertEqual((try match_ok("[a-zA-Z0-9]", "5")), true)
}

// ============================================================================
// 5. 预定义字符类测试
// ============================================================================

@test
fn test_digit_class() throws(regex.RegexError) {
    assertEqual((try match_ok("\\d", "0")), true)
    assertEqual((try match_ok("\\d", "9")), true)
    assertEqual((try match_ok("\\d", "a")), false)
    assertEqual((try match_ok("\\d+", "123")), true)
}

@test
fn test_word_class() throws(regex.RegexError) {
    assertEqual((try match_ok("\\w", "a")), true)
    assertEqual((try match_ok("\\w", "Z")), true)
    assertEqual((try match_ok("\\w", "0")), true)
    assertEqual((try match_ok("\\w", "_")), true)
    assertEqual((try match_ok("\\w", "-")), false)
}

@test
fn test_space_class() throws(regex.RegexError) {
    assertEqual((try match_ok("\\s", " ")), true)
    assertEqual((try match_ok("\\s", "\t")), true)
    assertEqual((try match_ok("\\s", "\n")), true)
    assertEqual((try match_ok("\\s", "a")), false)
}

@test
fn test_negated_classes() throws(regex.RegexError) {
    assertEqual((try match_ok("\\D", "a")), true)
    assertEqual((try match_ok("\\D", "0")), false)
    assertEqual((try match_ok("\\W", "-")), true)
    assertEqual((try match_ok("\\W", "a")), false)
    assertEqual((try match_ok("\\S", "a")), true)
    assertEqual((try match_ok("\\S", " ")), false)
}

// ============================================================================
// 6. 交替测试
// ============================================================================

@test
fn test_alternation_simple() throws(regex.RegexError) {
    assertEqual((try match_ok("a|b", "a")), true)
    assertEqual((try match_ok("a|b", "b")), true)
    assertEqual((try match_ok("a|b", "c")), false)
}

@test
fn test_alternation_words() throws(regex.RegexError) {
    assertEqual((try match_ok("foo|bar", "foo")), true)
    assertEqual((try match_ok("foo|bar", "bar")), true)
    assertEqual((try match_ok("foo|bar", "baz")), false)
}

@test
fn test_alternation_in_group() throws(regex.RegexError) {
    assertEqual((try match_ok("(a|b)c", "ac")), true)
    assertEqual((try match_ok("(a|b)c", "bc")), true)
    assertEqual((try match_ok("(a|b)c", "cc")), false)
}

// ============================================================================
// 7. 分组测试
// ============================================================================

@test
fn test_capture_group() throws(regex.RegexError) {
    assertEqual((try match_ok("(a)", "a")), true)
    assertEqual((try match_ok("(ab)", "ab")), true)
    assertEqual((try match_ok("(a)(b)", "ab")), true)
}

@test
fn test_noncapture_group() throws(regex.RegexError) {
    assertEqual((try match_ok("(?:a)", "a")), true)
    assertEqual((try match_ok("(?:ab)+", "abab")), true)
}

@test
fn test_nested_groups() throws(regex.RegexError) {
    assertEqual((try match_ok("((a))", "a")), true)
    assertEqual((try match_ok("(a(b)c)", "abc")), true)
    assertEqual((try match_ok("((a)(b))", "ab")), true)
}

@test
fn test_deeply_nested() throws(regex.RegexError) {
    assertEqual((try match_ok("((((((((((x))))))))))", "x")), true)
}

// ============================================================================
// 8. 词边界测试
// ============================================================================

@test
fn test_word_boundary() throws(regex.RegexError) {
    assertEqual((try match_ok("\\bfoo\\b", "foo")), true)
    assertEqual((try match_ok("\\bfoo\\b", "foo bar")), true)
    assertEqual((try match_ok("\\bfoo\\b", "foobar")), false)
    assertEqual((try match_ok("\\bfoo\\b", "barfoo")), false)
}

@test
fn test_word_boundary_single() throws(regex.RegexError) {
    assertEqual((try match_ok("\\bx\\b", "x")), true)
    assertEqual((try match_ok("\\bx\\b", "<x>")), true)
    assertEqual((try match_ok("\\bx\\b", "ax")), false)
}

@test
fn test_not_word_boundary() throws(regex.RegexError) {
    assertEqual((try match_ok("\\Bfoo", "xfoo")), true)
    assertEqual((try match_ok("foo\\B", "foobar")), true)
}

// ============================================================================
// 9. 点号测试
// ============================================================================

@test
fn test_dot() throws(regex.RegexError) {
    assertEqual((try match_ok(".", "a")), true)
    assertEqual((try match_ok(".", "1")), true)
    assertEqual((try match_ok(".", " ")), true)
    assertEqual((try match_ok(".", "\n")), false)  // 默认不匹配换行
}

@test
fn test_dot_star() throws(regex.RegexError) {
    assertEqual((try match_ok("a.*b", "ab")), true)
    assertEqual((try match_ok("a.*b", "axxb")), true)
    assertEqual((try match_ok("a.*b", "a\nb")), false)  // 不跨行
}

// ============================================================================
// 10. 转义字符测试
// ============================================================================

@test
fn test_escape_metachar() throws(regex.RegexError) {
    assertEqual((try match_ok("\\.", "a.b")), true)
    assertEqual((try match_ok("\\.", "ab")), false)
    assertEqual((try match_ok("\\^", "^")), true)
    assertEqual((try match_ok("\\$", "$")), true)
    assertEqual((try match_ok("\\\\", "\\")), true)
}

@test
fn test_escape_special() throws(regex.RegexError) {
    assertEqual((try match_ok("\\|", "|")), true)
    assertEqual((try match_ok("\\(", "(")), true)
    assertEqual((try match_ok("\\)", ")")), true)
    assertEqual((try match_ok("\\[", "[")), true)
    assertEqual((try match_ok("\\]", "]")), true)
    assertEqual((try match_ok("\\*", "*")), true)
    assertEqual((try match_ok("\\+", "+")), true)
    assertEqual((try match_ok("\\?", "?")), true)
}

@test
fn test_escape_sequences() throws(regex.RegexError) {
    assertEqual((try match_ok("\\t", "\t")), true)
    assertEqual((try match_ok("\\n", "\n")), true)
    assertEqual((try match_ok("\\r", "\r")), true)
}

// ============================================================================
// 11. Unicode 属性测试
// ============================================================================

@test
fn test_unicode_han() throws(regex.RegexError) {
    assertEqual((try match_ok("\\p{Han}", "你")), true)
    assertEqual((try match_ok("\\p{Han}", "a")), false)
    assertEqual((try match_ok("\\p{Han}+", "你好世界")), true)
}

@test
fn test_unicode_latin() throws(regex.RegexError) {
    assertEqual((try match_ok("\\p{Latin}", "a")), true)
    assertEqual((try match_ok("\\p{Latin}", "Z")), true)
    assertEqual((try match_ok("\\p{Latin}", "你")), false)
}

@test
fn test_unicode_number() throws(regex.RegexError) {
    assertEqual((try match_ok("\\p{N}", "0")), true)
    assertEqual((try match_ok("\\p{N}", "9")), true)
    assertEqual((try match_ok("\\p{N}+", "123")), true)
}

@test
fn test_unicode_negated() throws(regex.RegexError) {
    assertEqual((try match_ok("\\P{Han}", "a")), true)
    assertEqual((try match_ok("\\P{Han}", "你")), false)
    assertEqual((try match_eq("\\P{Han}+", "你好World", "World")), true)
}

@test
fn test_unicode_mixed() throws(regex.RegexError) {
    assertEqual((try match_eq("\\p{Han}+", "Hello你好World", "你好")), true)
    assertEqual((try match_eq("\\p{Latin}+", "你好Hello世界", "Hello")), true)
}

// ============================================================================
// 12. UTF-8 测试
// ============================================================================

@test
fn test_utf8_literal() throws(regex.RegexError) {
    assertEqual((try match_ok("本", "本")), true)
    assertEqual((try match_ok("日本語", "日本語")), true)
}

@test
fn test_utf8_dot() throws(regex.RegexError) {
    assertEqual((try match_ok("...", "日本語")), true)
    assertEqual((try match_ok("..", "你好")), true)
}

@test
fn test_utf8_greek() throws(regex.RegexError) {
    assertEqual((try match_ok("α", "α")), true)
    assertEqual((try match_ok("α+", "αβγ")), true)
}

// ============================================================================
// 13. 非贪婪量词测试
// ============================================================================

@test
fn test_lazy_star() throws(regex.RegexError) {
    assertEqual((try match_eq("a*?", "aaa", "")), true)
}

@test
fn test_lazy_plus() throws(regex.RegexError) {
    assertEqual((try match_eq("a+?", "aaa", "a")), true)
}

@test
fn test_lazy_question() throws(regex.RegexError) {
    assertEqual((try match_eq("a??", "a", "")), true)
}

@test
fn test_lazy_repeat() throws(regex.RegexError) {
    assertEqual((try match_eq("a{2,}?", "aaaa", "aa")), true)
}

// ============================================================================
// 14. 忽略大小写测试
// ============================================================================

@test
fn test_ignorecase_inline() throws(regex.RegexError) {
    var re = (try regex.compile("(?i)hello"))
    var result = regex.find(re, "HELLO")
    assertEqual(result != null, true)
    assertEqual(result!.text, "HELLO")
}

@test
fn test_ignorecase_flag() throws(regex.RegexError) {
    var re = (try regex.compile("hello", "i"))
    var result = regex.find(re, "HeLLo")
    assertEqual(result != null, true)
    assertEqual(result!.text, "HeLLo")
}

@test
fn test_case_sensitive() throws(regex.RegexError) {
    assertEqual((try match_ok("hello", "HELLO")), false)
}

// ============================================================================
// 15. 多行模式测试
// ============================================================================

@test
fn test_multiline_begin() throws(regex.RegexError) {
    var re = (try regex.compile("(?m)^world"))
    var result = regex.find(re, "hello\nworld")
    assertEqual(result != null, true)
}

@test
fn test_multiline_end() throws(regex.RegexError) {
    var re = (try regex.compile("(?m)hello$"))
    var result = regex.find(re, "hello\nworld")
    assertEqual(result != null, true)
}

// ============================================================================
// 16. DOTALL 模式测试
// ============================================================================

@test
fn test_dotall() throws(regex.RegexError) {
    var re = (try regex.compile("(?s)a.b"))
    var result = regex.find(re, "a\nb")
    assertEqual(result != null, true)
}

@test
fn test_dot_no_newline() throws(regex.RegexError) {
    assertEqual((try match_ok("a.b", "a\nb")), false)
}

// ============================================================================
// 17. 替换和分割测试
// ============================================================================

@test
fn test_replace() throws(regex.RegexError) {
    var re = (try regex.compile("\\d+"))
    var result = regex.replace(re, "abc123def", "XXX")
    assertEqual(result, "abcXXXdef")
}

@test
fn test_replace_all() throws(regex.RegexError) {
    var re = (try regex.compile("\\d+"))
    var result = regex.replaceAll(re, "a1b2c3", "X")
    assertEqual(result, "aXbXcX")
}

@test
fn test_split() throws(regex.RegexError) {
    var re = (try regex.compile(",\\s*"))
    var parts = regex.split(re, "a, b, c")
    assertEqual(len(parts), 3)
    assertEqual(parts[0], "a")
    assertEqual(parts[1], "b")
    assertEqual(parts[2], "c")
}

// ============================================================================
// 18. 边界情况测试
// ============================================================================

@test
fn test_empty_pattern() throws(regex.RegexError) {
    assertEqual((try match_ok("", "abc")), true)  // 空模式匹配空字符串
}

@test
fn test_empty_text() throws(regex.RegexError) {
    assertEqual((try match_ok("a", "")), false)
    assertEqual((try match_ok("a*", "")), true)
    assertEqual((try match_ok("a?", "")), true)
}

@test
fn test_complex_pattern() throws(regex.RegexError) {
    assertEqual((try match_ok("(a+|b)+", "ab")), true)
    assertEqual((try match_ok("((a|b)+)", "abab")), true)
    assertEqual((try match_ok("a(b|c)*d", "abbbcd")), true)
}

print("=== RE2 兼容性回归测试完成 ===")
