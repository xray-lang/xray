// 1010_json_serialize_types.xr
// Test: JSON.stringify for enum values and explicit DateTime projection.

import datetime

enum Color { Red, Green, Blue }

@test
fn test_stringify_enum() {
    var obj = { color: Color.Red }
    var s = JSON.stringify(obj)
    assertEqual(s, "{\"color\":\"Red\"}")
}

@test
fn test_stringify_enum_value_direct() {
    var s = JSON.stringify(Color.Blue)
    assertEqual(s, "\"Blue\"")
}

@test
fn test_stringify_datetime_projection() {
    var dt = datetime.createUTC(2026, 4, 30, 9, 0, 0)
    var s = JSON.stringify(dt.toISOString())
    assert(s.contains("2026"))
    assert(s.contains("04"))
    assert(s.contains("30"))
}

@test
fn test_stringify_datetime_projection_in_object() {
    var dt = datetime.createUTC(2026, 1, 15, 12, 30, 0)
    var obj = { created: dt.toISOString(), name: "test" }
    var s = JSON.stringify(obj)
    assert(s.contains("\"created\""))
    assert(s.contains("2026"))
    assert(s.contains("\"name\":\"test\""))
}
