// HTTP pure-Xray helper surface.

import http
import { urlEncode, urlDecode, responseText } from http

@test
fn test_url_encode_namespace() {
    assert_eq(http.urlEncode("a b+张"), "a%20b%2B%E5%BC%A0")
}

@test
fn test_url_decode_named_import() {
    assert_eq(urlDecode("a+b%2Bc%ZZ%"), "a b+c%ZZ%")
}

@test
fn test_response_text() {
    var resp = responseText(200, "hello")!
    assert(resp.includes("HTTP/1.1 200 OK\r\n"))
    assert(resp.includes("Content-Type: text/plain; charset=utf-8\r\n"))
    assert(resp.includes("Content-Length: 5\r\n"))
    assert(resp.endsWith("\r\n\r\nhello"))
}

@test
fn test_response_json() {
    var resp = responseText(404, Json.stringify({error: "no"}), "application/json; charset=utf-8")!
    assert(resp.includes("HTTP/1.1 404 Not Found\r\n"))
    assert(resp.includes("Content-Type: application/json; charset=utf-8\r\n"))
    assert(resp.includes("Content-Length: 14\r\n"))
    assert(resp.endsWith("{\"error\":\"no\"}"))
}

@test
fn test_response_unicode_byte_length() {
    var resp = responseText(200, "é")!
    assert(resp.includes("Content-Length: 2\r\n"))
    assert(resp.endsWith("\r\n\r\né"))
}

@test
fn test_response_empty_body() {
    var resp = responseText(204)!
    assert(resp.includes("HTTP/1.1 204 No Content\r\n"))
    assert(resp.includes("Content-Length: 0\r\n"))
    assert(resp.endsWith("\r\n\r\n"))
}

@test
fn test_response_text_custom_headers() {
    var resp = responseText(201, "created", "text/custom", {"X-Trace": "abc"}, false)!
    assert(resp.includes("HTTP/1.1 201 Created\r\n"))
    assert(resp.includes("Content-Type: text/custom\r\n"))
    assert(resp.includes("X-Trace: abc\r\n"))
    assert(resp.includes("Connection: close\r\n"))
    assert(resp.endsWith("\r\n\r\ncreated"))
}

@test
fn test_response_text_rejects_framing_headers() {
    assert(responseText(200, "bad", "text/plain", {"Content-Length": "999"}) == null)
    assert(responseText(200, "bad", "text/plain", {"Transfer-Encoding": "chunked"}) == null)
    assert(responseText(200, "bad", "text/plain", {"Trailer": "X-T"}) == null)
}

@test
fn test_response_text_rejects_injection() {
    assert(responseText(200, "bad", "text/plain", {"X-Bad": "a\r\nInjected: y"}) == null)
    assert(http.responseText(200, "bad", "text\r\nbad") == null)
}

print("All http pure helper tests passed")
