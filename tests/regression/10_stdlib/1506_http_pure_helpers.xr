// HTTP pure-Xray helper surface.

import http
import { Headers, HttpError, urlEncode, urlDecode, responseText } from http

fn withHeader(name: string, value: string) -> Headers {
    var headers = Headers()
    headers.add(name, value)
    return headers
}

@test
fn test_url_encode_namespace() {
    assert_eq(http.urlEncode("a b+张"), "a%20b%2B%E5%BC%A0")
}

@test
fn test_url_decode_named_import() {
    assert_eq(urlDecode("a+b%2Bc%ZZ%"), "a b+c%ZZ%")
}

@test
fn test_response_text() {
    var resp = responseText(200, "hello")!
    assert(resp.contains("HTTP/1.1 200 OK\r\n"))
    assert(resp.contains("Content-Type: text/plain; charset=utf-8\r\n"))
    assert(resp.contains("Content-Length: 5\r\n"))
    assert(resp.endsWith("\r\n\r\nhello"))
}

@test
fn test_response_json() {
    var resp = responseText(404, JSON.stringify({error: "no"}), "application/json; charset=utf-8")!
    assert(resp.contains("HTTP/1.1 404 Not Found\r\n"))
    assert(resp.contains("Content-Type: application/json; charset=utf-8\r\n"))
    assert(resp.contains("Content-Length: 14\r\n"))
    assert(resp.endsWith("{\"error\":\"no\"}"))

    var large = responseText(413, "too large")!
    assert(large.contains("HTTP/1.1 413 Payload Too Large\r\n"))
}

@test
fn test_response_unicode_byte_length() {
    var resp = responseText(200, "é")!
    assert(resp.contains("Content-Length: 2\r\n"))
    assert(resp.endsWith("\r\n\r\né"))
}

@test
fn test_response_empty_body() {
    var resp = responseText(204)!
    assert(resp.contains("HTTP/1.1 204 No Content\r\n"))
    assert(resp.contains("Content-Length: 0\r\n"))
    assert(resp.endsWith("\r\n\r\n"))
}

@test
fn test_response_text_custom_headers() {
    var resp = responseText(201, "created", "text/custom", withHeader("X-Trace", "abc"), false)!
    assert(resp.contains("HTTP/1.1 201 Created\r\n"))
    assert(resp.contains("Content-Type: text/custom\r\n"))
    assert(resp.contains("X-Trace: abc\r\n"))
    assert(resp.contains("Connection: close\r\n"))
    assert(resp.endsWith("\r\n\r\ncreated"))
}

@test
fn test_response_text_rejects_framing_headers() {
    assert(responseText(200, "bad", "text/plain", withHeader("Content-Length", "999")) == null)
    assert(responseText(200, "bad", "text/plain", withHeader("Transfer-Encoding", "chunked")) == null)
    assert(responseText(200, "bad", "text/plain", withHeader("Trailer", "X-T")) == null)
}

@test
fn test_response_text_rejects_injection() {
    var rejected = false
    try {
        var headers = Headers()
        headers.add("X-Bad", "a\r\nInjected: y")
    } catch (e: HttpError) {
        rejected = true
    }
    assert(rejected)
    assert(http.responseText(200, "bad", "text\r\nbad") == null)
}

print("All http pure helper tests passed")
