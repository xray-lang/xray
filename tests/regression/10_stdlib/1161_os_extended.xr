// 1161_os_extended.xr - OS module extended tests (user info, sysinfo, exec)

import os

// ===== User Information =====

@test
fn test_username() {
    var name = os.username()
    assert(name != null)
    assert(name!.length > 0)
}

@test
fn test_homedir() {
    var home = os.homedir()
    assert(home != null)
    assert(home!.length > 0)
}

@test
fn test_homedir_skips_empty_home_env() {
    var oldHome = os.getenv("HOME")
    os.setenv("HOME", "")

    var home = os.homedir()
    assert(home != null)
    assert(home!.length > 0)

    if (oldHome != null) {
        os.setenv("HOME", oldHome ?? "")
    } else {
        os.unsetenv("HOME")
    }
}

@test
fn test_uid() {
    var id = os.uid()
    assert(id >= 0)
}

@test
fn test_gid() {
    var id = os.gid()
    assert(id >= 0)
}

// ===== System Information =====

@test
fn test_cpuCount() {
    var n = os.cpuCount()
    assert(n >= 1)
}

@test
fn test_totalMemory() {
    var mem = os.totalMemory()
    // At least 64MB
    assert(mem > 64 * 1024 * 1024)
}

@test
fn test_freeMemory() {
    var mem = os.freeMemory()
    assert(mem > 0)
}

@test
fn test_uptime() {
    var up = os.uptime()
    // System must have been running for at least 1 second
    assert(up > 1.0)
}

@test
fn test_loadavg() {
    var avg = os.loadavg()
    assert_eq(avg.length, 3)
    // Load averages should be non-negative
    assert(avg[0] >= 0.0)
    assert(avg[1] >= 0.0)
    assert(avg[2] >= 0.0)
}

// ===== Process & Signal =====

@test
fn test_ppid() {
    var ppid = os.ppid()
    assert(ppid > 0)
}

@test
fn test_clock() {
    var t = os.clock()
    assert(t >= 0.0)
}

// ===== Process Execution =====

@test
fn test_exec_echo() {
    var result = os.exec("echo hello")
    assert(result != null)
    assert_eq(result!.stdout, "hello\n")
    assert_eq(result!.exitCode, 0)
}

@test
fn test_exec_stderr() {
    // Windows _popen cannot capture stderr separately
    if (os.platform == "windows") {
        return
    }
    var result = os.exec("echo error_msg >&2")
    assert(result != null)
    assert_eq(result!.stderr, "error_msg\n")
    assert_eq(result!.exitCode, 0)
}

@test
fn test_exec_exit_code() {
    var result = os.exec("exit 42")
    assert(result != null)
    assert_eq(result!.exitCode, 42)
}

@test
fn test_exec_command_output() {
    if (os.platform == "windows") {
        // Windows echo adds \r\n; printf not available
        var result = os.exec("echo abc")
        assert(result != null)
        assert(result!.stdout.length > 0)
    } else {
        var result = os.exec("printf 'abc'")
        assert(result != null)
        assert_eq(result!.stdout, "abc")
    }
}

// ===== Edge Cases =====

@test
fn test_setenv_return_value() {
    var ok = os.setenv("XRAY_TEST_RET", "val")
    assert_eq(ok, true)
    os.unsetenv("XRAY_TEST_RET")
}

@test
fn test_unsetenv_return_value() {
    os.setenv("XRAY_TEST_UNSET", "val")
    var ok = os.unsetenv("XRAY_TEST_UNSET")
    assert_eq(ok, true)
}

@test
fn test_chdir_invalid_path() {
    var ok = os.chdir("/nonexistent_xray_test_path_12345")
    assert_eq(ok, false)
}
