// 1301_toml_basic.xr - TOML module tests

import toml
import { TomlValue } from toml

fn field(value: TomlValue, key: string) -> TomlValue {
    return toml.get(value, key)!
}

fn item(value: TomlValue, index: int) -> TomlValue {
    return toml.at(value, index)!
}

fn asString(value: TomlValue) -> string {
    return toml.asString(value)!
}

fn asInt(value: TomlValue) -> int {
    return toml.asInt(value)!
}

fn asBool(value: TomlValue) -> bool {
    return toml.asBool(value)!
}

// ===== Basic key-value =====

@test
fn test_parse_basic() {
    var data = "name = \"Alice\"\nage = 30\nactive = true"
    var obj = toml.parse(data)
    assert_eq(asString(field(obj, "name")), "Alice")
    assert_eq(asInt(field(obj, "age")), 30)
    assert_eq(asBool(field(obj, "active")), true)
}

// ===== Table (section) =====

@test
fn test_parse_table() {
    var data = "[server]\nhost = \"localhost\"\nport = 8080"
    var obj = toml.parse(data)
    var server = field(obj, "server")
    assert_eq(asString(field(server, "host")), "localhost")
    assert_eq(asInt(field(server, "port")), 8080)
}

// ===== Array =====

@test
fn test_parse_array() {
    var data = "ports = [80, 443, 8080]"
    var obj = toml.parse(data)
    var ports = field(obj, "ports")
    assert_eq(asInt(item(ports, 0)), 80)
    assert_eq(asInt(item(ports, 2)), 8080)
}

// ===== Inline table =====

@test
fn test_parse_inline_table() {
    var data = "point = { x = 10, y = 20 }"
    var obj = toml.parse(data)
    assert_eq(asInt(field(field(obj, "point"), "x")), 10)
}

// ===== Number formats =====

@test
fn test_parse_number_formats() {
    var data = "hex = 0xDEADBEEF\noct = 0o755\nbin = 0b11010110"
    var obj = toml.parse(data)
    assert_eq(asInt(field(obj, "hex")), 3735928559)
    assert_eq(asInt(field(obj, "oct")), 493)
    assert_eq(asInt(field(obj, "bin")), 214)
}

// ===== Stringify =====

@test
fn test_stringify() {
    var config = toml.newTable()
    toml.tableSet(ref config, "name", toml.stringValue("xray"))
    toml.tableSet(ref config, "version", toml.intValue(1))
    var result = toml.stringify(toml.tableValue(config))
    assert(len(result) > 0)
}

// ===== Nested tables =====

@test
fn test_parse_nested_table() {
    var data = "[database]\n[database.primary]\nhost = \"db1\"\n[database.replica]\nhost = \"db2\""
    var obj = toml.parse(data)
    var database = field(obj, "database")
    assert_eq(asString(field(field(database, "primary"), "host")), "db1")
    assert_eq(asString(field(field(database, "replica"), "host")), "db2")
}
