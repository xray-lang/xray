// Test http client API existence and error handling

import http

@test
fn test_http_client_apis_exist() {
    assert(typeName(http.request) == "function")
}

@test
fn test_http_server_apis_exist() {
    assert(typeName(http.route) == "function")
    assert(typeName(http.listen) == "function")
    assert(typeName(http.urlEncode) == "function")
    assert(typeName(http.urlDecode) == "function")
}

print("All http client basic tests passed")
