// Test http client API existence and error handling

import http

@test
fn test_http_client_apis_exist() {
    assert(typeof(http.get) == "function")
    assert(typeof(http.post) == "function")
    assert(typeof(http.put) == "function")
    assert(typeof(http.delete) == "function")
    assert(typeof(http.request) == "function")
}

@test
fn test_http_server_apis_exist() {
    assert(typeof(http.route) == "function")
    assert(typeof(http.listen) == "function")
    assert(typeof(http.urlEncode) == "function")
    assert(typeof(http.urlDecode) == "function")
}

print("All http client basic tests passed")
