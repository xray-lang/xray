// Escaping, Unicode, and JSON.Object collection views.

@test
fn test_string_escaping() {
    assertEqual(JSON.stringify("a\nb\tc\"d\\e"), "\"a\\nb\\tc\\\"d\\\\e\"")
    assertEqual(JSON.require<string>(JSON.parseValue("\"\\u4F60\\u597D\""), []), "你好")
}

@test
fn test_object_keys_and_values() {
    var obj = JSON.parseObject("{\"a\":1,\"b\":2,\"c\":3}")
    var keys = obj.keys()
    var values = obj.values()
    assertEqual(len(keys), 3)
    assertEqual(len(values), 3)
    assert(obj.containsKey("a"))
    assertEqual(JSON.require<i64>(obj, ["c"]), 3)
}

@test
fn test_empty_collections() {
    assertEqual(JSON.stringify(JSON.parseValue("[]")), "[]")
    assertEqual(JSON.stringify(JSON.parseObject("{}")), "{}")
}
