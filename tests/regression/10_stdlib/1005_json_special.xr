// Escaping, Unicode, and JSON.Object collection views.

@test
fn test_string_escaping() {
    assert_eq(JSON.stringify("a\nb\tc\"d\\e"), "\"a\\nb\\tc\\\"d\\\\e\"")
    assert_eq(JSON.parseValue("\"\\u4F60\\u597D\""), "你好")
}

@test
fn test_object_keys_and_values() {
    var obj = JSON.parseObject("{\"a\":1,\"b\":2,\"c\":3}")
    var keys = obj.keys()
    var values = obj.values()
    assert_eq(len(keys), 3)
    assert_eq(len(values), 3)
    assert(obj.containsKey("a"))
    assert_eq(JSON.require<int>(obj, ["c"]), 3)
}

@test
fn test_empty_collections() {
    assert_eq(JSON.stringify(JSON.parseValue("[]")), "[]")
    assert_eq(JSON.stringify(JSON.parseObject("{}")), "{}")
}
