// 1301_compress.xr - Compress module tests

import compress

// ===== CRC32 =====

@test
fn test_crc32() {
    var crc = compress.crc32("Hello")
    assert(crc != 0)
}

@test
fn test_crc32_deterministic() {
    var crc1 = compress.crc32("Hello")
    var crc2 = compress.crc32("Hello")
    assert_eq(crc1, crc2)
}

// ===== Adler32 =====

@test
fn test_adler32() {
    var adler = compress.adler32("Hello")
    assert(adler != 0)
}

// ===== Gzip =====

@test
fn test_gzip_roundtrip() {
    var data = "Hello, World! This is a test string for compression."
    var compressed = compress.gzip(data) ?? ""
    var decompressed = compress.gunzip(compressed) ?? ""
    assert_eq(decompressed, data)
}

@test
fn test_is_gzip() {
    var data = "test data"
    var compressed = compress.gzip(data) ?? ""
    assert_eq(compress.isGzip(compressed ?? ""), true)
    assert_eq(compress.isGzip(data ?? ""), false)
}

// ===== Deflate/Inflate =====

@test
fn test_deflate_inflate() {
    var data = "Hello, World! This is a test string for compression."
    var deflated = compress.deflate(data) ?? ""
    var inflated = compress.inflate(deflated) ?? ""
    assert_eq(inflated, data)
}

// ===== Zlib =====

@test
fn test_zlib_roundtrip() {
    var data = "Hello, World! This is a test string for compression."
    var compressed = compress.zlibCompress(data) ?? ""
    assert_eq(compress.isZlib(compressed ?? ""), true)
    var decompressed = compress.zlibDecompress(compressed) ?? ""
    assert_eq(decompressed, data)
}

// ===== CRC32 known values =====

@test
fn test_crc32_known_value() {
    // CRC32("123456789") = 0xCBF43926
    var crc = compress.crc32("123456789")
    assert_eq(crc, 3421780262)  // 0xCBF43926 as unsigned
}

@test
fn test_crc32_empty() {
    var crc = compress.crc32("")
    assert_eq(crc, 0)
}

// ===== Adler32 known values =====

@test
fn test_adler32_known_value() {
    // Adler32("Wikipedia") = 0x11E60398
    var adler = compress.adler32("Wikipedia")
    assert_eq(adler, 300286872)  // 0x11E60398
}

@test
fn test_adler32_empty() {
    var adler = compress.adler32("")
    assert_eq(adler, 1)  // Initial value
}

// ===== Empty data roundtrip =====

@test
fn test_gzip_empty() {
    var data = ""
    var compressed = compress.gzip(data) ?? ""
    var decompressed = compress.gunzip(compressed) ?? ""
    assert_eq(decompressed, data)
}

@test
fn test_deflate_empty() {
    var data = ""
    var deflated = compress.deflate(data) ?? ""
    var inflated = compress.inflate(deflated) ?? ""
    assert_eq(inflated, data)
}

@test
fn test_zlib_empty() {
    var data = ""
    var compressed = compress.zlibCompress(data) ?? ""
    var decompressed = compress.zlibDecompress(compressed) ?? ""
    assert_eq(decompressed, data)
}

// ===== Large data roundtrip =====

@test
fn test_gzip_large_data() {
    // Build a string > 64KB to trigger multi-pass LZ77
    var big = ""
    for (var i = 0; i < 500; i++) {
        big = big + "The quick brown fox jumps over the lazy dog. "
    }
    var compressed = compress.gzip(big) ?? ""
    var decompressed = compress.gunzip(compressed) ?? ""
    assert_eq(decompressed, big)
}

@test
fn test_deflate_large_data() {
    var big = ""
    for (var i = 0; i < 500; i++) {
        big = big + "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 "
    }
    var deflated = compress.deflate(big) ?? ""
    var inflated = compress.inflate(deflated) ?? ""
    assert_eq(inflated, big)
}

// ===== Compression levels =====

@test
fn test_gzip_level_zero() {
    var data = "Hello, World! This is a test string for compression."
    var level0 = compress.gzip(data, 0) ?? ""
    var restored = compress.gunzip(level0) ?? ""
    assert_eq(restored, data)
}

@test
fn test_gzip_all_levels() {
    var data = "Compress this text with different levels for testing."
    for (var level = 0; level < 10; level++) {
        var compressed = compress.gzip(data, level) ?? ""
        var decompressed = compress.gunzip(compressed) ?? ""
        assert_eq(decompressed, data)
    }
}

@test
fn test_deflate_all_levels() {
    var data = "Deflate this text with different levels for testing."
    for (var level = 0; level < 10; level++) {
        var deflated = compress.deflate(data, level) ?? ""
        var inflated = compress.inflate(deflated) ?? ""
        assert_eq(inflated, data)
    }
}

@test
fn test_zlib_all_levels() {
    var data = "Zlib compress this text with different levels for testing."
    for (var level = 0; level < 10; level++) {
        var compressed = compress.zlibCompress(data, level) ?? ""
        assert_eq(compress.isZlib(compressed ?? ""), true)
        var decompressed = compress.zlibDecompress(compressed) ?? ""
        assert_eq(decompressed, data)
    }
}

// ===== Detection on invalid data =====

@test
fn test_is_gzip_invalid() {
    assert_eq(compress.isGzip(""), false)
    assert_eq(compress.isGzip("x"), false)
    assert_eq(compress.isGzip("hello world"), false)
}

@test
fn test_is_zlib_invalid() {
    assert_eq(compress.isZlib(""), false)
    assert_eq(compress.isZlib("x"), false)
    assert_eq(compress.isZlib("hello world"), false)
}

// ===== Binary data with repeated patterns =====

@test
fn test_gzip_repeated_pattern() {
    var data = ""
    for (var i = 0; i < 1000; i++) {
        data = data + "AAAA"
    }
    var compressed = compress.gzip(data) ?? ""
    // Repeated data should compress well
    assert(len((compressed ?? "")) < len(data))
    var decompressed = compress.gunzip(compressed) ?? ""
    assert_eq(decompressed, data)
}
