// 1540_http_url_edge.xr - HTTP URL encode/decode edge cases

import http

// ===== Basic roundtrip =====

@test
fn test_url_encode_decode_roundtrip() {
    var original = "hello world"
    var encoded = http.urlEncode(original)
    var decoded = http.urlDecode(encoded)
    assert_eq(decoded, original)
}

// ===== Special characters =====

@test
fn test_url_encode_special() {
    var encoded = http.urlEncode("a+b=c&d")
    assert(encoded.contains("%"))
    var decoded = http.urlDecode(encoded)
    assert_eq(decoded, "a+b=c&d")
}

@test
fn test_url_encode_symbols() {
    var original = "!@#$%^&*()_+-=[]{}|;':\",./<>?"
    var encoded = http.urlEncode(original)
    var decoded = http.urlDecode(encoded)
    assert_eq(decoded, original)
}

// ===== Chinese characters =====

@test
fn test_url_encode_chinese() {
    var original = "你好世界"
    var encoded = http.urlEncode(original)
    assert(encoded.contains("%"))
    var decoded = http.urlDecode(encoded)
    assert_eq(decoded, original)
}

// ===== Pure ASCII (no encoding needed) =====

@test
fn test_url_encode_ascii_passthrough() {
    var ascii = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    var encoded = http.urlEncode(ascii)
    assert_eq(encoded, ascii)
}

// ===== Empty string =====

@test
fn test_url_encode_empty() {
    var encoded = http.urlEncode("")
    assert_eq(encoded, "")
}

@test
fn test_url_decode_empty() {
    var decoded = http.urlDecode("")
    assert_eq(decoded, "")
}

// ===== Space encoding =====

@test
fn test_url_encode_space() {
    var encoded = http.urlEncode("hello world")
    assert_eq(encoded, "hello%20world")
}

// ===== Double encoding prevention =====

@test
fn test_url_decode_percent() {
    var decoded = http.urlDecode("hello%20world")
    assert_eq(decoded, "hello world")
}

// ===== Long string =====

@test
fn test_url_encode_long() {
    var original = ""
    for (var i = 0; i < 50; i++) {
        original = original + "param" + string(i) + "=value" + string(i) + "&"
    }
    var encoded = http.urlEncode(original)
    var decoded = http.urlDecode(encoded)
    assert_eq(decoded, original)
}
