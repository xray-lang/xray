// Test RC/cycle-collection block reclamation under allocation pressure.
// Verifies that explicit cycle collection and whole-block reclaim preserve
// live objects and their children.

import runtime

// --- Test 1: Nested objects survive collection and block reclaim ---
// Parent objects keep their children live throughout the reclaim pass.
@test
fn test_nested_object_survival() {
    runtime.disableCycleCollection()
    var containers: Array<Json> = []
    for (var i = 0; i < 200; i++) {
        var inner_map: Json = {"key": "value_" + string(i), "idx": i}
        var inner_arr: Json = [i, i * 2, i * 3]
        containers.push({"map": inner_map,
            "arr": inner_arr,
            "name": "container_" + string(i)})
    }

    // Force cycle collection and whole-block reclaim to run.
    runtime.collectCycles()

    // Verify all nested data is intact
    for (var i = 0; i < 200; i++) {
        var c = containers[i]
        assert_eq(c["map"]["idx"], i)
        assert_eq(c["arr"][1], i * 2)
        assert_eq(c["name"], "container_" + string(i))
    }
}

// --- Test 2: Allocate during cycle-collection round ---
// Create objects, run collection/reclaim, then create more objects.
// The new objects must not overwrite old live objects.
@test
fn test_alloc_interleaved_with_gc() {
    runtime.disableCycleCollection()
    var phase1: Array<Json> = []
    for (var i = 0; i < 100; i++) {
        phase1.push({"id": i, "data": "phase1_" + string(i)})
    }

    runtime.collectCycles()

    var phase2: Array<Json> = []
    for (var i = 0; i < 100; i++) {
        phase2.push({"id": i + 100, "data": "phase2_" + string(i)})
    }

    runtime.collectCycles()

    // Verify both phases intact
    for (var i = 0; i < 100; i++) {
        assert_eq(phase1[i]["id"], i)
        assert_eq(phase2[i]["id"], i + 100)
    }
}

// --- Test 3: Deep reference chains ---
// Build a linked-list-like structure. Collection/reclaim must preserve the
// entire live chain.
@test
fn test_deep_reference_chain() {
    runtime.disableCycleCollection()
    var head: Json = {"value": 0, "next": null}
    var current: Json = head
    for (var i = 1; i < 50; i++) {
        var node: Json = {"value": i, "next": null}
        current["next"] = node
        current = node
    }

    runtime.collectCycles()

    // Walk the chain and verify
    current = head
    var count = 0
    while (current != null) {
        assert_eq(current["value"], count)
        current = current["next"]
        count++
    }
    assert_eq(count, 50)
}

// --- Test 4: High churn with live roots ---
// Rapidly create and discard temp objects while keeping a live set.
// Exercises hole scanning after GC reclaims dead temp objects.
@test
fn test_high_churn_with_live_roots() {
    runtime.disableCycleCollection()
    var live: Array<string> = []
    for (var i = 0; i < 50; i++) {
        live.push("persistent_" + string(i))
    }

    for (var round = 0; round < 20; round++) {
        var temp: Array<Array<int>> = []
        for (var j = 0; j < 200; j++) {
            temp.push([j, j + 1, j + 2])
        }
        // temp goes out of scope
    }

    runtime.collectCycles()

    // Live roots must survive all the churn
    for (var i = 0; i < 50; i++) {
        assert_eq(live[i], "persistent_" + string(i))
    }
}

// --- Test 5: Multiple cycle-collection rounds ---
// Run several full cycle-collection rounds with allocation in between.
@test
fn test_multiple_gc_cycles() {
    runtime.disableCycleCollection()
    for (var cycle = 0; cycle < 10; cycle++) {
        var data: Array<Json> = []
        for (var i = 0; i < 100; i++) {
            data.push({"cycle": cycle, "idx": i})
        }
        runtime.collectCycles()
        // Verify last batch
        assert_eq(data[99]["cycle"], cycle)
        assert_eq(data[99]["idx"], 99)
    }
}

print("All incremental memory pressure tests passed")
