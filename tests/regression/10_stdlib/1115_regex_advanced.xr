/**
 * @file 1115_regex_advanced.xr
 * @brief 正则高级功能测试
 * @author xingleixu@gmail.com
 * 
 * 测试非贪婪量词、忽略大小写、多行模式等高级功能
 */

import regex

// ========================================
// 非贪婪量词测试
// ========================================

@test
fn test_lazy_plus() throws(regex.RegexError) {
    var re = (try regex.compile("a+?"))
    var result = regex.find(re, "aaa")
    assertEqual(result != null, true)
    assertEqual(result!.text, "a")
}

@test
fn test_lazy_star() throws(regex.RegexError) {
    var re = (try regex.compile("a*?"))
    var result = regex.find(re, "aaa")
    assertEqual(result != null, true)
    assertEqual(result!.text, "")
}

@test
fn test_lazy_question() throws(regex.RegexError) {
    var re = (try regex.compile("a??"))
    var result = regex.find(re, "a")
    assertEqual(result != null, true)
    assertEqual(result!.text, "")
}

@test
fn test_lazy_repeat() throws(regex.RegexError) {
    var re = (try regex.compile("a{2,}?"))
    var result = regex.find(re, "aaaa")
    assertEqual(result != null, true)
    assertEqual(result!.text, "aa")
}

@test
fn test_greedy_plus() throws(regex.RegexError) {
    var re = (try regex.compile("a+"))
    var result = regex.find(re, "aaa")
    assertEqual(result != null, true)
    assertEqual(result!.text, "aaa")
}

@test
fn test_greedy_star() throws(regex.RegexError) {
    var re = (try regex.compile("a*"))
    var result = regex.find(re, "aaa")
    assertEqual(result != null, true)
    assertEqual(result!.text, "aaa")
}

// ========================================
// 忽略大小写测试
// ========================================

@test
fn test_ignorecase_inline() throws(regex.RegexError) {
    var re = (try regex.compile("(?i)hello"))
    var result = regex.find(re, "HELLO World")
    assertEqual(result != null, true)
    assertEqual(result!.text, "HELLO")
}

@test
fn test_ignorecase_flag() throws(regex.RegexError) {
    var re = (try regex.compile("hello", "i"))
    var result = regex.find(re, "HeLLo")
    assertEqual(result != null, true)
    assertEqual(result!.text, "HeLLo")
}

@test
fn test_case_sensitive() throws(regex.RegexError) {
    var re = (try regex.compile("hello"))
    var result = regex.find(re, "HELLO")
    assertEqual(result, null)
}

// ========================================
// 多行模式测试
// ========================================

@test
fn test_multiline_caret() throws(regex.RegexError) {
    var re = (try regex.compile("(?m)^world"))
    var result = regex.find(re, "hello\nworld")
    assertEqual(result != null, true)
    assertEqual(result!.text, "world")
}

@test
fn test_multiline_dollar() throws(regex.RegexError) {
    var re = (try regex.compile("(?m)hello$"))
    var result = regex.find(re, "hello\nworld")
    assertEqual(result != null, true)
    assertEqual(result!.text, "hello")
}

// ========================================
// DOTALL 模式测试
// ========================================

@test
fn test_dotall() throws(regex.RegexError) {
    var re = (try regex.compile("(?s)a.b"))
    var result = regex.find(re, "a\nb")
    assertEqual(result != null, true)
    assertEqual(result!.text, "a\nb")
}

@test
fn test_dot_no_newline() throws(regex.RegexError) {
    var re = (try regex.compile("a.b"))
    var result = regex.find(re, "a\nb")
    assertEqual(result, null)
}

// ========================================
// 组合标志测试
// ========================================

@test
fn test_combined_flags() throws(regex.RegexError) {
    // (?im) 忽略大小写 + 多行
    var re = (try regex.compile("(?im)^hello"))
    var result = regex.find(re, "world\nHELLO")
    assertEqual(result != null, true)
    assertEqual(result!.text, "HELLO")
}
