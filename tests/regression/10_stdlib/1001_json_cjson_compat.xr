// Strict JSON grammar and cJSON-compatible value coverage.

@test
fn test_strict_grammar_matrix() {
    var valid = [
        "null", "true", "false", "0", "-42", "3.14", "1e10",
        "\"text\"", "[]", "{}", "[1,true,null]", "{\"a\":1}"
    ]
    for (text in valid) { assert(JSON.isValid(text), text) }

    var invalid = [
        "", "undefined", "NaN", "+1", "01", "[1,]", "{\"a\":1,}",
        "{'a':1}", "{a:1}", "1 2", "[}", "{]"
    ]
    for (text in invalid) { assert(!JSON.isValid(text), text) }
}

@test
fn test_nested_document() {
    var doc = JSON.parseValue(
        "{\"glossary\":{\"title\":\"example\",\"entries\":[{\"id\":1},{\"id\":2}]}}"
    )
    assert_eq(JSON.require<string>(doc, ["glossary", "title"]), "example")
    assert_eq(JSON.require<int>(doc, ["glossary", "entries", 1, "id"]), 2)
}

@test
fn test_unicode_and_number_roundtrip() {
    var value = JSON.parseValue("{\"text\":\"你好 🎉\",\"n\":-1.25e2}")
    assert_eq(JSON.require<string>(value, ["text"]), "你好 🎉")
    assert_eq(JSON.require<float>(value, ["n"]), -125.0)
    assert(JSON.isValid(JSON.stringify(value)))
}
