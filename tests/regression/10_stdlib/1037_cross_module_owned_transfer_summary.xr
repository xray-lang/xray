import { forwardImportedArray, recvImportedArray } from "../../fixtures/owned_transfer_lib"
import "../../fixtures/owned_transfer_lib" as transfer

@test
fn test_selective_import_consumes_owned_param_summary() {
    const ch: Channel<Array<int>> = Channel(1)
    var xs = Array<int>(2, 0)
    xs[0] = 21
    xs[1] = 22

    forwardImportedArray(ch, move xs)

    var got = recvImportedArray(ch)
    assert_eq(len(got), 2)
    assert_eq(got[0], 21)
    assert_eq(got[1], 22)
    ch.close()
}

@test
fn test_namespace_import_consumes_owned_param_summary() {
    const ch: Channel<Array<int>> = Channel(1)
    var xs = Array<int>(2, 0)
    xs[0] = 31
    xs[1] = 32

    transfer.forwardImportedArray(ch, move xs)

    var got = transfer.recvImportedArray(ch)
    assert_eq(len(got), 2)
    assert_eq(got[0], 31)
    assert_eq(got[1], 32)
    ch.close()
}
