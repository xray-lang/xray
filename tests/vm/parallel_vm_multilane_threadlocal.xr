import parallel
import sys

const initCount = Atomic<i64>(0)
const tls = sys.ThreadLocal<i64>(() -> initCount.fetchAdd(1, Ordering.AcquireRelease))
const touched = Atomic<i64>(0)

parallel.forEach(0..20000, (i) -> {
    var token = tls.get()
    if (token >= 0) {
        touched.add(1, Ordering.Relaxed)
    }
}, parallel.Options(4))

var initializedThreads = initCount.load(Ordering.Acquire)
print(touched.load(Ordering.Relaxed) == 20000)
print(initializedThreads >= 2)
print(initializedThreads <= 4)
