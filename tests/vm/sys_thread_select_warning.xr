import sys

shared ch = Channel<int>(1)

fn closeOnlyInOneSelectCase() {
    var t = sys.Thread.spawn(fn() -> int {
        return 42
    })
    select {
        msg from ch -> {
            print(t.join())
        }
        _ -> {
            print("select-open")
        }
    }
    print("after-select")
}

closeOnlyInOneSelectCase()
ch.close()
