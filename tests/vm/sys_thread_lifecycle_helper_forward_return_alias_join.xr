import sys

fn wrapThread(t: move Thread<i64>) -> Thread<i64> {
    return passThread(move t)
}

fn passThread(t: move Thread<i64>) -> Thread<i64> {
    return t
}

fn run() {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    var joined = wrapThread(move t)
    print(joined.join())
}

run()
