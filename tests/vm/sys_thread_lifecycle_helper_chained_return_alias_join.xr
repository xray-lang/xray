import sys

fn passThread(t: move Thread<int>) -> Thread<int> {
    return t
}

fn wrapThread(t: move Thread<int>) -> Thread<int> {
    return passThread(move t)
}

fn run() {
    var t = sys.Thread.spawn(fn() -> int {
        return 42
    })
    var joined = wrapThread(move t)
    print(joined.join())
}

run()
