import sys
import { Process } from sys

fn run() {
    const waitProcess = fn(p: Process) -> int {
        var code = p.wait()
        print("fn-value waited " + string(code))
        return code
    }

    var p0 = sys.Process.spawn("sh", ["-c", "exit 0"])
    if (p0 == null) {
        print("spawn-failed")
        return
    }
    print(waitProcess(p0!))
}

run()
