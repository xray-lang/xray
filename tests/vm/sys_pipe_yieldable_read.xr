import sys
import { ProcessOptions } from sys

shared pipe = sys.Pipe.open()!
shared proc = sys.Process.spawn("sh", ["-c", "sleep 0.05; printf ok"],
    ProcessOptions(null, null, null, pipe.writeEnd()))!
pipe.closeWrite()

fn readPipe() -> int {
    var chunk = pipe.read(16)
    var n = chunk == null ? -1 : len(chunk!)
    print("read " + string(n))
    return n
}

fn tick() -> int {
    print("tick")
    return 1
}

var reader = go readPipe()
Coro.yield()

var ticker = go tick()
print(await ticker)

print(await reader)
print(proc.wait())
print(pipe.close())
