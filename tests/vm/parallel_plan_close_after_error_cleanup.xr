import { Options, ParallelError, Plan } from parallel

var plan = Plan<int>(Options(2), lane -> lane + 1)

fn closePlan() {
    plan.close()
}

try {
    var total = plan.reduce(0..20000, 0, (state, i) -> {
        if (i == 10000) {
            closePlan()
            var zero = i - 10000
            return 10 / zero
        }
        return state + i
    }, (a, b) -> a + b)
    print(total)
    print("miss")
} catch panic (p) {
    print(p.code == 420)
    print(p.message.contains("division by zero"))
}

try {
    plan.forEach(0..1, (state, i) -> {
        print(state + i)
    })
    print("reopen-miss")
} catch (e) {
    match (e) {
        ParallelError.ClosedPlan -> print("closed")
        ParallelError.ConcurrentDispatch -> print("active-leak")
        _ -> print("other")
    }
}

var fresh = Plan<int>(Options(2), lane -> lane)
const touched = Atomic<int>(0)
fresh.forEach(0..4, (state, i) -> {
    touched.add(1, Ordering.Relaxed)
})
print(touched.load(Ordering.Relaxed) == 4)
