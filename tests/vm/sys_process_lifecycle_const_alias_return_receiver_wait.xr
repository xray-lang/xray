import sys
import { Process } from sys

fn passProcess(p: Process) -> Process {
    return p
}

fn run() {
    const aliasProcess = passProcess
    var spawned = sys.Process.spawn("sh", ["-c", "exit 0"])
    if (spawned == null) {
        print("spawn-failed")
        return
    }
    print(aliasProcess(spawned!).wait())
}

run()
