import sys

fn passThread(t: move Thread<int>) -> Thread<int> {
    return t
}

fn joinThread(t: move Thread<int>) -> int {
    return t.join()
}

fn run() {
    var t = sys.Thread.spawn(fn() -> int {
        return 42
    })
    var forwarded = passThread(move t)
    print(joinThread(move forwarded))
}

run()
