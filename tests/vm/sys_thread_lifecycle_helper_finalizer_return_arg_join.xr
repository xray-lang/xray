import sys

fn passThread(t: move Thread<i64>) -> Thread<i64> {
    return t
}

fn joinThread(t: move Thread<i64>) -> i64 {
    return t.join()
}

fn run() {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    var forwarded = passThread(move t)
    print(joinThread(move forwarded))
}

run()
