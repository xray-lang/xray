import sys
import { Pipe } from sys

enum ProcessAliasMergeErr {
    Msg { s: string }
}

const processAliasMergeCh = Channel<i64>(1)
processAliasMergeCh.trySend(1)

var tryTarget = sys.Process.spawn("sh", ["-c", "exit 0"])
var oldTry = sys.Process.spawn("sh", ["-c", "exit 0"])
var processHandle = oldTry!
try {
    processHandle = tryTarget!
} catch (e) {
    processHandle = tryTarget!
}
print(processHandle.wait())

var matchTarget = sys.Process.spawn("sh", ["-c", "exit 0"])
var oldMatch = sys.Process.spawn("sh", ["-c", "exit 0"])
processHandle = oldMatch!
match (1) {
    0 -> {
        processHandle = matchTarget!
    }
    _ -> {
        processHandle = matchTarget!
    }
}
print(processHandle.wait())

var selectTarget = sys.Process.spawn("sh", ["-c", "exit 0"])
var oldSelect = sys.Process.spawn("sh", ["-c", "exit 0"])
processHandle = oldSelect!
select {
    msg from processAliasMergeCh -> {
        processHandle = selectTarget!
    }
    _ -> {
        processHandle = selectTarget!
    }
}
print(processHandle.wait())

var pipeTarget = Pipe.open()
var oldPipe = Pipe.open()
var pipeHandle = oldPipe!
match (1) {
    0 -> {
        pipeHandle = pipeTarget!
    }
    _ -> {
        pipeHandle = pipeTarget!
    }
}
print(pipeHandle.close())
processAliasMergeCh.close()
