import sys
import { Process } from sys

fn passProcess(p: Process) -> Process {
    return p
}

fn run() {
    var spawned = sys.Process.spawn("sh", ["-c", "exit 0"])
    if (spawned == null) {
        print("spawn-failed")
        return
    }
    while (true) {
        if (passProcess(spawned!).tryWait() != null) {
            break
        }
        sys.sleepMs(1)
    }
    print(true)
}

run()
