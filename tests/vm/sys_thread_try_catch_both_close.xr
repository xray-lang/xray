import sys

enum ThreadLintErr {
    Msg { s: string }
}

fn closeInTryOrCatch(throwNow: bool) {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    try {
        if (throwNow) {
            throw ThreadLintErr.Msg { s: "boom" }
        }
        print(t.join())
    } catch (e) {
        t.detach()
        print("catch-close")
    }
}

closeInTryOrCatch(false)
