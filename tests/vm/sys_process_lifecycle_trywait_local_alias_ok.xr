import sys
import time

fn run() {
    var p = sys.Process.spawn("sh", ["-c", "exit 7"])
    if (p == null) {
        print("spawn-failed")
        return
    }
    while (true) {
        var code = p!.tryWait()
        if (code != null) {
            print(code!)
            break
        }
        code = null
        time.sleep(1)
    }
}

var task = go run()
await task
