import sys

fn run() {
    var p = sys.Process.spawn("sh", ["-c", "exit 7"])
    if (p == null) {
        print("spawn-failed")
        return
    }
    while (true) {
        var code = p!.tryWait()
        if (code != null) {
            break
        }
        code = null
        sys.sleepMs(1)
    }
    print(true)
}

run()
