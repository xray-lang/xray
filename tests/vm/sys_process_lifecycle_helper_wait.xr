import sys
import { Process } from sys

fn waitProcess(p: Process) -> int {
    var code = p.wait()
    print("helper waited " + string(code))
    return code
}

fn run() {
    var p0 = sys.Process.spawn("sh", ["-c", "exit 0"])
    if (p0 == null) {
        print("spawn-failed")
        return
    }
    print(waitProcess(p0!))
}

run()
