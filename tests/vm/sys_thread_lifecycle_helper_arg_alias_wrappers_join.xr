import sys

fn passThread(t: move Thread<i64>) -> Thread<i64> {
    return t
}

fn joinCastAlias() {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    var joined = passThread(move t) as Thread<i64>
    print(joined.join())
}

fn joinMovedArgAlias() {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    var joined = passThread(move t)
    print(joined.join())
}

joinCastAlias()
joinMovedArgAlias()
