import cluster
import math
import { Packet, packetScore } from "./modules/bytecode_build_multimodule_lib"
import { reexportedBonus } from "./modules/bytecode_build_multimodule_facade"
import { starBonus } from "./modules/bytecode_build_multimodule_star_facade"

fn score(done: Channel<int>) {
    var packet = Packet{value: 20, offset: 1}
    done.send(packetScore(packet))
}

var done = Channel<int>(1)
var result = 0
assert(cluster.start({ name: "bundle-preload", port: 0, secret: null, tls: null }))
scope {
    go score(done)
    match (done.recv()) {
        Recv.Value(value) -> { result = value }
        _ -> {}
    }
}
done.close()
cluster.stop()
print(result + math.max(1, 3, 2) + reexportedBonus() + starBonus())
