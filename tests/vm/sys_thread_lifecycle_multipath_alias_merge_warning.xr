import sys

enum ThreadAliasMergeErr {
    Msg(s: string)
}

const aliasMergeCh = Channel<i64>(1)
aliasMergeCh.trySend(1)

fn mergeInTry() {
    var target = sys.Thread.spawn(fn() -> i64 {
        return 1
    })
    var oldTry = sys.Thread.spawn(fn() -> i64 {
        return 2
    })
    var handle = oldTry
    try {
        handle = target
    } catch (e) {
        handle = target
    }
    print(handle.join())
}

fn mergeInMatch() {
    var target = sys.Thread.spawn(fn() -> i64 {
        return 3
    })
    var oldMatch = sys.Thread.spawn(fn() -> i64 {
        return 4
    })
    var handle = oldMatch
    match (1) {
        0 -> {
            handle = target
        }
        _ -> {
            handle = target
        }
    }
    print(handle.join())
}

fn mergeInSelect() {
    var target = sys.Thread.spawn(fn() -> i64 {
        return 5
    })
    var oldSelect = sys.Thread.spawn(fn() -> i64 {
        return 6
    })
    var handle = oldSelect
    select {
        msg from aliasMergeCh -> {
            handle = target
        }
        _ -> {
            handle = target
        }
    }
    print(handle.join())
}

mergeInTry()
mergeInMatch()
mergeInSelect()
aliasMergeCh.close()
