import sys

const ch = Channel<i64>(1)
ch.trySend(1)

fn closeInSelect() {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    select {
        msg from ch -> {
            print(t.join())
        }
        _ -> {
            t.detach()
        }
    }
}

closeInSelect()
ch.close()
