import {
    ByteEnvelope,
    encodePayload,
    payloadView
} from "./modules/bytecode_build_multimodule_payload"

fn encodeOne(payload: Array<u8>) -> Buffer {
    var envelope = ByteEnvelope(77, 1, 2, 9, 3, 1000000, 1, 11, payload)
    return encodePayload(envelope)
}

fn inspect(payload: Array<u8>) -> i64 {
    var encoded = encodeOne(payload)
    var bytes: Slice<u8> = encoded.asBytes()
    return len(bytes) + (bytes[0] as i64) + (bytes[len(bytes) - 1] as i64)
}

fn consumeEncoded(encoded: move Buffer) -> i64 {
    return len(encoded.asBytes())
}

fn encodeAsync(payload: Array<u8>) -> Task<i64> {
    var envelope = ByteEnvelope(77, 1, 2, 9, 3, 1000000, 1, 11, payload)
    var encoded = encodePayload(envelope)
    return go consumeEncoded(move encoded)
}

var payload = Array<u8>(64, 7)
var checksum = 0
for (var index = 0; index < 20; index++) {
    checksum = checksum + inspect(payload)
}
var envelope = ByteEnvelope(77, 1, 2, 9, 3, 1000000, 1, 11, payload)
var view = payloadView(envelope)
var asyncLength = await encodeAsync(payload)
print(checksum.toString() + "/" + view.length.toString() + "/" + len(payload).toString() + "/" + asyncLength.toString())
