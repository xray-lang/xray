import http
import { HttpRequest, HttpResponse } from http
import net
import time

fn serveStaticRoutes(port: int, running: Atomic<bool>) -> bool {
    var server = http.Server()
    server.route("GET", "/plain", "hello static")
    server.route("GET", "/empty", "")
    server.routeHandler("POST", "/dynamic", fn(req: HttpRequest) -> HttpResponse {
        return http.textResponse(req.query.get("streaming") != null ? "handler:true" : "handler:false")
    })
    return server.listen(port, running)
}

fn tryDial(port: int) -> NetConn? {
    try {
        return net.dial("127.0.0.1", port)
    } catch (e) {
        return null
    }
}

fn waitForServer(port: int) -> bool {
    for (var i = 0; i < 50; i = i + 1) {
        var conn = tryDial(port)
        if (conn != null) {
            net.close(conn!)
            return true
        }
        time.sleep(20)
    }
    return false
}

fn sendRaw(port: int, request: string) -> string {
    var conn = tryDial(port)
    if (conn == null) {
        return ""
    }
    var payload = request.copyBytes()
    var n = net.writeBytes(conn!, payload)
    if (n < len(payload)) {
        net.close(conn!)
        return ""
    }
    var response = Array<byte>()
    var chunk = Array<byte>(4096)
    while (true) {
        var got = net.readInto(conn!, ref chunk, 4096)
        if (got <= 0) { break }
        for (var i = 0; i < got; i++) { response.push(chunk[i]) }
    }
    net.close(conn!)
    return string.fromUtf8(response[:]) ?? ""
}

export fn runHttpStaticRouteFullParse() {
    var probe = net.listen(0, 1)
    const port = probe.port()
    net.close(probe)

    const running = Atomic(true)
    var server = go serveStaticRoutes(port, running)
    assert(waitForServer(port))

    var plain = sendRaw(
        port,
        "GET /plain HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Connection: close\r\n\r\n"
    )
    assert(plain.contains("HTTP/1.1 200 OK\r\n"))
    assert(plain.endsWith("\r\n\r\nhello static"))

    var empty = sendRaw(
        port,
        "GET /empty HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Connection: close\r\n\r\n"
    )
    assert(empty.contains("HTTP/1.1 200 OK\r\n"))
    assert(empty.contains("Content-Length: 0\r\n"))
    assert(empty.endsWith("\r\n\r\n"))

    var dynamic = sendRaw(
        port,
        "POST /dynamic HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Content-Length: 5\r\n" +
        "Connection: close\r\n\r\n" +
        "hello"
    )
    assert(dynamic.contains("HTTP/1.1 200 OK\r\n"))
    assert(dynamic.contains("handler:false"))

    var oversized = sendRaw(
        port,
        "POST /dynamic HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Content-Length: 1048577\r\n" +
        "Connection: close\r\n\r\n" +
        "x"
    )
    assert(oversized.contains("HTTP/1.1 413 Payload Too Large\r\n"))
    assert(!oversized.contains("handler:"))

    running.store(false)
    assert(await server)
}
