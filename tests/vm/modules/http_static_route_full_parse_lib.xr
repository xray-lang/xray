import http
import { HttpRequest, HttpResponse } from http
import net
import time

const PORT = 9196

fn serveStaticRoutes(port: int, running: Atomic<bool>) {
    http.route("GET", "/plain", "hello static")
    http.route("GET", "/empty", "")
    http.routeHandler("POST", "/dynamic", fn(req: HttpRequest) -> HttpResponse {
        return http.textResponse(req.query.get("streaming") != null ? "handler:true" : "handler:false")
    })
    http.listen(port, running)
}

fn waitForServer(port: int) -> bool {
    for (var i = 0; i < 50; i = i + 1) {
        var conn = net.dial("127.0.0.1", port)
        if (conn != null) {
            net.close(conn!)
            return true
        }
        time.sleep(20)
    }
    return false
}

fn sendRaw(port: int, request: string) -> string {
    var conn = net.dial("127.0.0.1", port)
    if (conn == null) {
        return ""
    }
    var written = 0
    while (written < len(request)) {
        var n = net.write(conn!, request.slice(written, len(request)))
        if (n <= 0) {
            net.close(conn!)
            return ""
        }
        written = written + n
    }
    var response = ""
    while (true) {
        var chunk = net.read(conn!, 4096)
        if (chunk == null) { break }
        response = response + chunk!
    }
    net.close(conn!)
    return response
}

export fn runHttpStaticRouteFullParse() {
    var probe = net.listen(PORT, 1)
    if (probe == null) {
        return
    }
    net.close(probe!)

    const running = Atomic(true)
    go serveStaticRoutes(PORT, running)
    assert(waitForServer(PORT))

    var plain = sendRaw(
        PORT,
        "GET /plain HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Connection: close\r\n\r\n"
    )
    assert(plain.contains("HTTP/1.1 200 OK\r\n"))
    assert(plain.endsWith("\r\n\r\nhello static"))

    var empty = sendRaw(
        PORT,
        "GET /empty HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Connection: close\r\n\r\n"
    )
    assert(empty.contains("HTTP/1.1 200 OK\r\n"))
    assert(empty.contains("Content-Length: 0\r\n"))
    assert(empty.endsWith("\r\n\r\n"))

    var dynamic = sendRaw(
        PORT,
        "POST /dynamic HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Content-Length: 5\r\n" +
        "Connection: close\r\n\r\n" +
        "hello"
    )
    assert(dynamic.contains("HTTP/1.1 200 OK\r\n"))
    assert(dynamic.contains("handler:false"))

    var oversized = sendRaw(
        PORT,
        "POST /dynamic HTTP/1.1\r\n" +
        "Host: 127.0.0.1\r\n" +
        "Content-Length: 1048577\r\n" +
        "Connection: close\r\n\r\n" +
        "x"
    )
    assert(oversized.contains("HTTP/1.1 413 Payload Too Large\r\n"))
    assert(!oversized.contains("handler:"))

    running.store(false)
}
