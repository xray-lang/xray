import mem

export final class ByteEnvelope {
    contractId: i64
    methodId: i64
    requestId: i64
    serviceId: i64
    generation: i64
    deadline: i64
    flags: i64
    traceId: i64
    payload: Array<u8>

    constructor(
        contractId: i64,
        methodId: i64,
        requestId: i64,
        serviceId: i64,
        generation: i64,
        deadline: i64,
        flags: i64,
        traceId: i64,
        payload: Array<u8>
    ) {
        this.contractId = contractId
        this.methodId = methodId
        this.requestId = requestId
        this.serviceId = serviceId
        this.generation = generation
        this.deadline = deadline
        this.flags = flags
        this.traceId = traceId
        this.payload = payload
    }
}

export struct PayloadView {
    length: i64
    first: i64
    last: i64
}

export fn payloadView(envelope: ByteEnvelope) -> PayloadView {
    return PayloadView{
        length: len(envelope.payload),
        first: envelope.payload[0] as i64,
        last: envelope.payload[len(envelope.payload) - 1] as i64,
    }
}

export fn encodePayload(envelope: ByteEnvelope) -> Buffer {
    var out = mem.allocZeroed(len(envelope.payload))
    if (len(envelope.payload) > 0) {
        var target: Slice<u8> = out.asMutBytes()
        var source: Slice<u8> = envelope.payload[:]
        target.copyFrom(source)
    }
    return out
}
