import parallel
import sys

const initCount = Atomic<i64>(0)
const tls = sys.ThreadLocal<i64>(() -> initCount.fetchAdd(1, Ordering.AcquireRelease))
const touched = Atomic<i64>(0)
const lane0 = Atomic<i64>(0)
const lane1 = Atomic<i64>(0)
const lane2 = Atomic<i64>(0)
const lane3 = Atomic<i64>(0)

var plan = parallel.Plan<i64>(parallel.Options(4), (lane) -> lane)

var mapped = plan.map(0..20000, (state, i) -> {
    var token = tls.get()
    if (token >= 0) {
        touched.add(1, Ordering.Relaxed)
    }
    if (state == 0) {
        lane0.store(1, Ordering.Relaxed)
    } else if (state == 1) {
        lane1.store(1, Ordering.Relaxed)
    } else if (state == 2) {
        lane2.store(1, Ordering.Relaxed)
    } else if (state == 3) {
        lane3.store(1, Ordering.Relaxed)
    }
    return i * 2
})

var out: Array<i64> = []
plan.mapInto(0..20000, ref out, (state, i) -> {
    var token = tls.get()
    if (token >= 0) {
        touched.add(1, Ordering.Relaxed)
    }
    if (state == 0) {
        lane0.store(1, Ordering.Relaxed)
    } else if (state == 1) {
        lane1.store(1, Ordering.Relaxed)
    } else if (state == 2) {
        lane2.store(1, Ordering.Relaxed)
    } else if (state == 3) {
        lane3.store(1, Ordering.Relaxed)
    }
    return i + 1
})

var initializedThreads = initCount.load(Ordering.Acquire)
var lanesSeen = lane0.load(Ordering.Relaxed) + lane1.load(Ordering.Relaxed) +
    lane2.load(Ordering.Relaxed) + lane3.load(Ordering.Relaxed)

print(len(mapped) == 20000)
print(mapped[0] == 0)
print(mapped[19999] == 39998)
print(len(out) == 20000)
print(out[19999] == 20000)
print(touched.load(Ordering.Relaxed) == 40000)
print(lanesSeen == 4)
print(initializedThreads >= 2)
print(initializedThreads <= 4)
