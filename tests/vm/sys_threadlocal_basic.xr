import sys

const local = sys.ThreadLocal<i64, Never>(fn() -> i64 {
    return 10
})

print(try! local.get())
local.set(20)
print(try! local.get())

var t = sys.Thread.spawn(fn() -> i64 {
    var first = try! local.get()
    local.set(first + 5)
    return try! local.get()
})

print(t.join())
print(try! local.get())
