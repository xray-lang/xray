import sys

fn assignmentRebind() {
    var original = sys.Thread.spawn(fn() -> i64 {
        return 1
    })
    var replacement = sys.Thread.spawn(fn() -> i64 {
        return 2
    })
    var handle = original
    handle = replacement
    print(handle.join())
}

fn destructureRebind() {
    var first = sys.Thread.spawn(fn() -> i64 {
        return 3
    })
    var second = sys.Thread.spawn(fn() -> i64 {
        return 4
    })
    var handle = first
    (handle,) = (second,)
    print(handle.join())
}

assignmentRebind()
destructureRebind()
