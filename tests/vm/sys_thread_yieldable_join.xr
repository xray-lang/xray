import sys

fn waitThread(t: Thread<i64>) -> i64 {
    var v = t.join()
    print("joined " + string(v))
    return v
}

fn tick() -> i64 {
    print("tick")
    return 1
}

const release = Atomic<bool>(false)

const thread = sys.Thread.spawn(fn() -> i64 {
    while (!release.load(Ordering.Acquire)) {
        sys.threadYield()
    }
    return 7
})

var waiter = go waitThread(thread)
Coro.yield()

var ticker = go tick()
print(await ticker)
release.store(true, Ordering.Release)
print(await waiter)
