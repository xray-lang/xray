import sys
import { Pipe, Process } from sys

fn makeProcess() -> Process? {
    return sys.Process.spawn("sh", ["-c", "exit 0"])
}

fn makePipe() -> Pipe? {
    return sys.Pipe.open()
}

var (p,) = (makeProcess(),)
if (p != null) {
    print("destructure-factory-process")
}

var (pipe,) = (makePipe(),)
if (pipe != null) {
    print("destructure-factory-pipe")
}
