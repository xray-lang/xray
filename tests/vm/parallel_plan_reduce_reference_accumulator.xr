import { Plan, Options } from parallel

class Box {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

class GBox<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }
}

var plan = Plan<i64>(Options(2), lane -> lane + 1)
var total = plan.reduce(0..8, Box(0), (state, i) -> Box(state + i), (a, b) -> Box(a.value + b.value))
var genericTotal = plan.reduce(0..8, GBox<i64>(0), (state, i) -> GBox<i64>(state + i), (a, b) -> GBox<i64>(a.value + b.value))
print(total.value)
print(genericTotal.value)
