import { Plan, Options } from parallel

class Box {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

class GBox<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }
}

var plan = Plan<int>(Options(2), lane -> lane + 1)
var total = plan.reduce(0..8, Box(0), (state, i) -> Box(state + i), (a, b) -> Box(a.value + b.value))
var genericTotal = plan.reduce(0..8, GBox<int>(0), (state, i) -> GBox<int>(state + i), (a, b) -> GBox<int>(a.value + b.value))
print(total.value)
print(genericTotal.value)
