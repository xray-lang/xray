// Regression fixture: BigInt literals must survive every execution form.
//
// The embedded-bytecode `xray build` once serialized BigInt constants as null,
// so the built binary printed null where `xray run` printed the value. This
// fixture prints BigInt values (never comparisons or int64-overflowing
// arithmetic, which exercise unrelated backend paths) so that the source run,
// embedded-bytecode build, and native build must all agree.
var a = 123n
print(a)

var b = -456n
print(b)

print(0n)
print(255n)

var c = a
print(c)
