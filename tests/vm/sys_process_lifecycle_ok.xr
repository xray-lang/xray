import sys
import time

var p = sys.Process.spawn("sh", ["-c", "exit 0"])
if (p != null) {
    print(p!.wait())
} else {
    print(-1)
}

var pipe = sys.Pipe.open()
if (pipe != null) {
    print(pipe!.close())
} else {
    print(false)
}

var split = sys.Pipe.open()
if (split != null) {
    print(split!.closeRead())
    print(split!.closeWrite())
} else {
    print(false)
    print(false)
}

var polled = sys.Process.spawn("sh", ["-c", "exit 0"])
if (polled != null) {
    while (true) {
        if (polled!.tryWait() != null) {
            break
        }
        time.sleep(1)
    }
    print(true)
} else {
    print(false)
}
