import sys

enum ProcessLintErr {
    Msg(s: string)
}

const processLintCh = Channel<i64>(1)
processLintCh.trySend(1)

fn closeProcessInTryOrCatch(throwNow: bool) {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    try {
        if (throwNow) {
            throw ProcessLintErr.Msg("boom")
        }
        print(p!.wait())
    } catch (e) {
        print(p!.wait())
    }
}

fn closeProcessInMatch(tag: i64) {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    match (tag) {
        0 -> {
            print(p!.wait())
        }
        _ -> {
            print(p!.wait())
        }
    }
}

fn closeProcessInSelect() {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    select {
        msg from processLintCh -> {
            print(p!.wait())
        }
        _ -> {
            print(p!.wait())
        }
    }
}

fn closeProcessInTernary(flag: bool) {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    print(flag ? p!.wait() : p!.wait())
}

fn closePipeInMatch(tag: i64) {
    var pipe = sys.Pipe.open()
    match (tag) {
        0 -> {
            print(pipe!.close())
        }
        _ -> {
            print(pipe!.close())
        }
    }
}

fn closePipeInTernary(flag: bool) {
    var pipe = sys.Pipe.open()
    print(flag ? pipe!.close() : pipe!.close())
}

fn waitProcessInLinearLoop() {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    while (true) {
        print(p!.wait())
        break
    }
}

fn closePipeInLinearLoop() {
    var pipe = sys.Pipe.open()
    while (true) {
        print(pipe!.close())
        break
    }
}

fn waitProcessInLinearForLoop() {
    var p = sys.Process.spawn("sh", ["-c", "exit 0"])
    for (;;) {
        print(p!.wait())
        break
    }
}

fn closePipeInLinearForLoop() {
    var pipe = sys.Pipe.open()
    for (; true; ) {
        print(pipe!.close())
        break
    }
}

closeProcessInTryOrCatch(false)
closeProcessInMatch(1)
closeProcessInSelect()
closeProcessInTernary(true)
closePipeInMatch(1)
closePipeInTernary(false)
waitProcessInLinearLoop()
closePipeInLinearLoop()
waitProcessInLinearForLoop()
closePipeInLinearForLoop()
processLintCh.close()
