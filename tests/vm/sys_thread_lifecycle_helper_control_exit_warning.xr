import sys

fn skipJoinTry(t: Thread<i64>) {
    try {
        return
    } catch (e) {
        print("catch")
    }
    print(t.join())
}

fn skipJoinMatch(t: Thread<i64>) {
    match (0) {
        0 -> {
            return
        }
        _ -> {}
    }
    print(t.join())
}

var t0 = sys.Thread.spawn(fn() -> i64 {
    return 42
})
skipJoinTry(t0)
print("try-after")

var t1 = sys.Thread.spawn(fn() -> i64 {
    return 42
})
skipJoinMatch(t1)
print("match-after")
