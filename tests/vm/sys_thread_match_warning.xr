import sys

fn closeOnlyInOneMatchArm(tag: i64) {
    var t = sys.Thread.spawn(fn() -> i64 {
        return 42
    })
    match (tag) {
        0 -> {
            print(t.join())
        }
        _ -> {
            print("match-open")
        }
    }
    print("after-match")
}

closeOnlyInOneMatchArm(1)
