import { Options, ParallelError, Plan } from parallel

var mapPlan = Plan<int>(Options(2), lane -> lane + 1)

fn closeMapPlan() {
    mapPlan.close()
}

var mapped = mapPlan.map(0..20000, (state, i) -> {
    if (i == 10000) {
        closeMapPlan()
    }
    return state + i
})

print(len(mapped) == 20000)

try {
    mapPlan.forEach(0..1, (state, i) -> {
        print(state + i)
    })
    print("map-miss")
} catch (e) {
    match (e) {
        ParallelError.ClosedPlan -> print("map-closed")
        ParallelError.ConcurrentDispatch -> print("map-active-leak")
        _ -> print("map-other")
    }
}

var intoPlan = Plan<int>(Options(2), lane -> lane + 3)

fn closeIntoPlan() {
    intoPlan.close()
}

var out: Array<int> = []
intoPlan.mapInto(0..20000, ref out, (state, i) -> {
    if (i == 10000) {
        closeIntoPlan()
    }
    return state + i
})

print(len(out) == 20000)

try {
    intoPlan.reduce(0..1, 0, (state, i) -> state + i, (a, b) -> a + b)
    print("mapinto-miss")
} catch (e) {
    match (e) {
        ParallelError.ClosedPlan -> print("mapinto-closed")
        ParallelError.ConcurrentDispatch -> print("mapinto-active-leak")
        _ -> print("mapinto-other")
    }
}

intoPlan.close()
print("done")
