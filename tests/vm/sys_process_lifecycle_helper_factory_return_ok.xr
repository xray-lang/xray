import sys
import { Pipe, Process } from sys

fn makeProcess() -> Process? {
    return sys.Process.spawn("sh", ["-c", "exit 0"])
}

fn wrapProcess() -> Process? {
    return makeProcess()
}

fn makePipe() -> Pipe? {
    return sys.Pipe.open()
}

fn wrapPipe() -> Pipe? {
    return makePipe()
}

var p = wrapProcess()
print(p!.wait())

var pipe = wrapPipe()
print(pipe!.close())
