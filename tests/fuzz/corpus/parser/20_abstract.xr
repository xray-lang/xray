// Abstract classes and methods

abstract class Shape {
    x: f64
    y: f64

    constructor(x: f64, y: f64) {
        this.x = x
        this.y = y
    }

    // Abstract methods - must be implemented by subclasses
    abstract area(): f64
    abstract perimeter(): f64

    // Concrete method
    move(dx: f64, dy: f64) {
        this.x += dx
        this.y += dy
    }

    describe(): string {
        return "Shape at (${this.x}, ${this.y})"
    }
}

class Circle extends Shape {
    radius: f64

    constructor(x: f64, y: f64, radius: f64) {
        super(x, y)
        this.radius = radius
    }

    // Implement abstract methods
    area(): f64 {
        return 3.14159 * this.radius * this.radius
    }

    perimeter(): f64 {
        return 2 * 3.14159 * this.radius
    }

    // Override concrete method
    describe(): string {
        return "Circle(r=${this.radius}) at (${this.x}, ${this.y})"
    }
}

class Rectangle extends Shape {
    width: f64
    height: f64

    constructor(x: f64, y: f64, width: f64, height: f64) {
        super(x, y)
        this.width = width
        this.height = height
    }

    area(): f64 {
        return this.width * this.height
    }

    perimeter(): f64 {
        return 2 * (this.width + this.height)
    }

    describe(): string {
        return "Rectangle(${this.width}x${this.height}) at (${this.x}, ${this.y})"
    }
}

class Triangle extends Shape {
    a: f64
    b: f64
    c: f64

    constructor(x: f64, y: f64, a: f64, b: f64, c: f64) {
        super(x, y)
        this.a = a
        this.b = b
        this.c = c
    }

    area(): f64 {
        // Heron's formula
        let s = (this.a + this.b + this.c) / 2
        return math.sqrt(s * (s - this.a) * (s - this.b) * (s - this.c))
    }

    perimeter(): f64 {
        return this.a + this.b + this.c
    }
}

// Usage with polymorphism
fn printShapeInfo(shape: Shape) {
    print(shape.describe())
    print("Area: " + shape.area())
    print("Perimeter: " + shape.perimeter())
}

let shapes: Array<Shape> = [
    new Circle(0, 0, 5),
    new Rectangle(1, 1, 4, 3),
    new Triangle(2, 2, 3, 4, 5)
]

for (shape in shapes) {
    printShapeInfo(shape)
    shape.move(1, 1)
}
