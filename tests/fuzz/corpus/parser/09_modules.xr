// Export function
export fn add(a, b) {
    return a + b
}
export fn subtract(a, b) {
    return a - b
}
// Export constant
export const VERSION = "1.0.0"
export const MAX_SIZE = 1024
// Export class
export class Calculator {
    value: int

    constructor(initial) {
        this.value = initial
    }

    add(x) {
        this.value += x
        return this
    }

    result() {
        return this.value
    }
}
// Export existing variable
let internalValue = 42
export internalValue
