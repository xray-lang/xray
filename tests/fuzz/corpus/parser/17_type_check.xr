// is expression - runtime type checking
fn checkType(x) {
    if (x is int) {
        print("It's an integer")
        return x * 2
    } else if (x is float) {
        print("It's a float")
        return x + 0.5
    } else if (x is string) {
        print("It's a string")
        return x.toUpperCase()
    } else if (x is Array<any>) {
        print("It's an array")
        return len(x)
    } else if (x is Map<any, any>) {
        print("It's a map")
        return len(x)
    } else if (x is null) {
        print("It's null")
        return null
    } else {
        print("Unknown type")
        return x
    }
}

// Type checking in match
fn processValue(val) {
    return match (val) {
        v if v is int => v * 2
        v if v is string => len(v)
        v if v is Array<any> => v.reduce(fn(a, b) {
            return a + b
        }, 0)
        _ => null
    }
}

// Class type checking
class Animal {
    name: string

    constructor(name) {
        this.name = name
    }
}

class Dog extends Animal {
    breed: string

    constructor(name, breed) {
        super(name)
        this.breed = breed
    }
}

class Cat extends Animal {
    color: string

    constructor(name, color) {
        super(name)
        this.color = color
    }
}

fn greetAnimal(animal) {
    if (animal is Dog) {
        print("Woof! I'm " + animal.name + ", a " + animal.breed)
    } else if (animal is Cat) {
        print("Meow! I'm " + animal.name + ", color: " + animal.color)
    } else if (animal is Animal) {
        print("I'm just an animal named " + animal.name)
    }
}

let dog = new Dog("Buddy", "Labrador")
let cat = new Cat("Whiskers", "Orange")
greetAnimal(dog)
greetAnimal(cat)
