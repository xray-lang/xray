// Dependency for the imported enum-payload type regression.
export enum SharedError {
    Invalid(string)
}

export type SharedValue = JSON.Value

export enum SharedResult {
    Ok(SharedValue),
    Err(SharedError)
}

export enum MirroredResult {
    Ok(SharedValue),
    Err(SharedError)
}

export fn produce(ok: bool) -> SharedResult {
    return ok ? SharedResult.Ok(JSON.value({ answer: 42 })) : SharedResult.Err(SharedError.Invalid("bad"))
}

export fn mirror(result: SharedResult) -> MirroredResult {
    return match (result) {
        SharedResult.Ok(value)  -> MirroredResult.Ok(value)
        SharedResult.Err(error) -> MirroredResult.Err(error)
    }
}
