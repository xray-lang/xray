// Dependency for the imported enum-payload type regression.
export enum SharedError {
    Invalid { message: string }
}

export type SharedValue = JSON.Value

export enum SharedResult {
    Ok { value: SharedValue },
    Err { error: SharedError }
}

export enum MirroredResult {
    Ok { value: SharedValue },
    Err { error: SharedError }
}

export fn produce(ok: bool) -> SharedResult {
    return ok ? SharedResult.Ok { value: JSON.value({ answer: 42 }) } : SharedResult.Err { error: SharedError.Invalid { message: "bad" } }
}

export fn mirror(result: SharedResult) -> MirroredResult {
    return match (result) {
        SharedResult.Ok { value }  -> MirroredResult.Ok { value: value }
        SharedResult.Err { error } -> MirroredResult.Err { error: error }
    }
}
