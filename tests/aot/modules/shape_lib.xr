// AOT module: shape library with exported class and functions
export class Rect {
    w: i64
    h: i64

    constructor(w: i64, h: i64) {
        this.w = w
        this.h = h
    }

    area() -> i64 {
        return this.w * this.h
    }

    perimeter() -> i64 {
        return 2 * (this.w + this.h)
    }
}

export fn add(a: i64, b: i64) -> i64 {
    return a + b
}

export fn mul(a: i64, b: i64) -> i64 {
    return a * b
}
