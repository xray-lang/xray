export struct WideValueState align(64) {
    lanes: [uint64; 8]
    bytes: [byte; 192]
    total: uint64

    static init() -> WideValueState {
        return WideValueState{
            lanes: [1, 2, 3, 4, 5, 6, 7, 8],
            bytes: [0; 192],
            total: 0,
        }
    }

    reset(marker: byte) {
        this.lanes = [1, 2, 3, 4, 5, 6, 7, 8]
        this.bytes = [0; 192]
        this.bytes[191] = marker
        this.total = marker as uint64
    }

    update(delta: uint64) {
        this.total += delta
        this.lanes[0] = this.lanes[0] + delta
        this.bytes[0] = this.total as byte
    }

    digest() -> uint64 {
        return this.lanes[0] + this.total + (this.bytes[0] as uint64) +
               (this.bytes[191] as uint64)
    }
}
