export struct WideValueState align(64) {
    lanes: [u64; 8]
    bytes: [u8; 192]
    total: u64

    static init() -> WideValueState {
        return WideValueState{
            lanes: [1, 2, 3, 4, 5, 6, 7, 8],
            bytes: [0; 192],
            total: 0,
        }
    }

    ref reset(marker: u8) {
        this.lanes = [1, 2, 3, 4, 5, 6, 7, 8]
        this.bytes = [0; 192]
        this.bytes[191] = marker
        this.total = marker as u64
    }

    ref update(delta: u64) {
        this.total += delta
        this.lanes[0] = this.lanes[0] + delta
        this.bytes[0] = this.total as u8
    }

    digest() -> u64 {
        return this.lanes[0] + this.total + (this.bytes[0] as u64) +
               (this.bytes[191] as u64)
    }
}
