// AOT multi-module test: import a function returning a generic enum aggregate.

import { FastResult, pick } from "./enum_result_lib"

fn score(ok: bool) -> i64 {
    var result = pick(ok)
    match (result) {
        FastResult.Ok { value } -> {
            return value + 1
        }
        FastResult.Err { code } -> {
            return 0 - code
        }
    }
}

print(score(true))
print(score(false))
