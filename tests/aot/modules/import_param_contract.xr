// AOT ParamContract: imported ref/out functions must write back caller slots.
import {
    bumpRef,
    bumpRefValue,
    fillOut,
    fillOutValue,
} from "./param_contract_lib"
import "./param_contract_lib" as param_contract

var selective = 1
print(bumpRef(ref selective))
print(selective)

var selective_out = 0
print(fillOut(out selective_out))
print(selective_out)

var namespaced = 3
print(param_contract.bumpRef(ref namespaced))
print(namespaced)

var namespaced_out = 0
print(param_contract.fillOut(out namespaced_out))
print(namespaced_out)

var valued = 5
print(bumpRefValue(ref valued))
print(valued)

var valued_out = 0
print(param_contract.fillOutValue(out valued_out))
print(valued_out)

const bump = bumpRefValue
print(bump(ref valued))
print(valued)

const fill = fillOutValue
print(fill(out valued_out))
print(valued_out)
