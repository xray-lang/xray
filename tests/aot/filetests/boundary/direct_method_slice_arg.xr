class Collector {
    total: int

    constructor() {
        this.total = 0
    }

    add(data: Slice<byte>) -> int {
        var i = 0
        while (i < len(data)) {
            this.total += data[i]
            i += 1
        }
        return this.total
    }
}

var collector = Collector()
var bytes: Array<byte> = [7, 11, 13]
print(collector.add(bytes[:]))
