class Collector {
    total: i64

    constructor() {
        this.total = 0
    }

    ref add(data: Slice<u8>) -> i64 {
        var i = 0
        while (i < len(data)) {
            this.total += data[i]
            i += 1
        }
        return this.total
    }
}

var collector = Collector()
var bytes: Array<u8> = [7, 11, 13]
print(collector.add(bytes[:]))
