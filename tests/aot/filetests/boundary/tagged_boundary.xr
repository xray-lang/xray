class Counter {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    ref bump() -> i64 {
        this.value = this.value + 1
        return this.value
    }
}

fn make_counter(value: i64) -> Counter {
    return Counter(value)
}

fn read_counter(c: ref Counter) -> i64 {
    return c.bump()
}

var c = make_counter(41)
print(read_counter(ref c))
