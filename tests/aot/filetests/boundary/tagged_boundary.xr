class Counter {
    value: int

    constructor(value: int) {
        this.value = value
    }

    bump() -> int {
        this.value = this.value + 1
        return this.value
    }
}

fn make_counter(value: int) -> Counter {
    return Counter(value)
}

fn read_counter(c: ref Counter) -> int {
    return c.bump()
}

var c = make_counter(41)
print(read_counter(ref c))
