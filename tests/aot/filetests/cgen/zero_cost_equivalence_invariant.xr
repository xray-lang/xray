// Residue verification never changes generated code. plain_kernel and
// gated_kernel have identical bodies, so their generated C must be
// structurally identical (the shared body shape appears twice).
fn plain_kernel(x: i64, y: i64) -> i64 {
    return x * y + 1
}

fn gated_kernel(x: i64, y: i64) -> i64 {
    return x * y + 1
}

fn call_plain(a: i64) -> i64 {
    return plain_kernel(a, a)
}

fn call_gated(a: i64) -> i64 {
    return gated_kernel(a, a)
}
