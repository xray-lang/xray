fn run(n: int) -> int {
    var scores: Map<int, int> = #{}
    var seen: Set<int> = #[]
    var seed = 0
    while (seed < 64) {
        scores.set(seed, (seed % 17) + 1)
        seen.add(seed)
        seed = seed + 1
    }

    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + lookup<int, int>(scores, i % 64, 0)
        if (has<int>(seen, i % 64)) {
            sum = sum + 1
        }
        i = i + 1
    }
    return sum
}

print(run(30000))
