contains=xaot-plan v0
regex=json-shape-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ type=[0-9]+ kind=shaped action=hidden_class fields=[0-9]+\+2 hash=[0-9a-f]+ evidence=0x3 reason=none
regex=json-dynamic-access-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ shape=[0-9]+ kind=field_get action=direct_index key=[0-9]+ result_type=0 field=1 evidence=0xf reason=none
# A value assigned in more than one branch gets a hoisted declaration, so the
# assignment line carries no type prefix.  What this case guards is the direct
# field access by index -- not a dynamic name lookup -- so match the call and
# let the receiver be a value or a phi.
c_regex=[A-Za-z_][A-Za-z0-9_]* = xrt_json_get_field\([A-Za-z_][A-Za-z0-9_]*, 1\);
c_not_contains=xrt_json_get_name_owned
