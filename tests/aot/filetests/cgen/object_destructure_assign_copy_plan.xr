struct User {
    name: string
    age: i64
}

fn describeAssigned(user: User) -> string {
    var localName = ""
    var years = 0
    localName = user.name
    years = user.age
    return localName + ":" + string(years)
}

var user: User = User{ name: "Ada", age: 7 }
print(describeAssigned(user))
