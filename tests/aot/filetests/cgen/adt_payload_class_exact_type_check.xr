class Box {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

enum Payload<T> {
    Item { value: T },
    Empty
}

fn make() -> Payload<Box> {
    return Payload.Item { value: Box(7) }
}

fn score() -> i64 {
    var payload = make()
    match (payload) {
        Payload.Item { value: box } -> {
            return box.value
        }
        Payload.Empty -> {
            return 0
        }
    }
}

print(score())
