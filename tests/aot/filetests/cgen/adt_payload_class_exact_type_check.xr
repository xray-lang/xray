class Box {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

enum Payload<T> {
    Item(T),
    Empty
}

fn make() -> Payload<Box> {
    return Payload.Item(Box(7))
}

fn score() -> i64 {
    var payload = make()
    match (payload) {
        Payload.Item(box) -> {
            return box.value
        }
        Payload.Empty -> {
            return 0
        }
    }
}

print(score())
