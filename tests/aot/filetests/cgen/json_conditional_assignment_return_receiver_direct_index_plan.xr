fn makeJsonConditionalAssignedReturnPlan(flag: bool) -> Json {
    var user: Json = { name: "ada", age: 1 }
    if (flag) {
        user = { name: "bob", age: 2 }
    }
    return user
}

fn jsonConditionalAssignedReturnReceiverPlan(flag: bool) -> int {
    return makeJsonConditionalAssignedReturnPlan(flag).age
}

print(jsonConditionalAssignedReturnReceiverPlan(true))
