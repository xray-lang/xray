contains=xaot-plan v0
regex=generic-instantiation [0-9]+ id=[1-9][0-9]* module=[1-9][0-9]* kind=function .*action=specialized_body
regex=method-dispatch [0-9]+ callsite=[0-9]+ span=[0-9]+ kind=direct .*recv_class=[1-9][0-9]* recv_iface=0 .*targets=[0-9]+\+1
not_contains=interface-abi
not_regex=interface-use .*flags=iface_object
c_regex=static XRT_FN_PURE int64_t generic_constraint_direct_call_[0-9a-f]{16}_score_Circle_[0-9]+\(xrt_closure_t \*_cl, xrt_native_generic_constraint_direct_call_[0-9a-f]{16}_Circle \*p0\)
c_regex=int64_t v[0-9]+ = generic_constraint_direct_call_[0-9a-f]{16}_area_[0-9]+\(NULL, \(\(xrt_native_generic_constraint_direct_call_[0-9a-f]{16}_Circle\*\)v[0-9]+\)\);
c_not_contains=xrt_method_
c_not_contains=xrt_interface_call
c_not_contains=xrt_itable_method
c_not_contains=xrt_instanceof
