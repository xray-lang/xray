fn makeJsonBranchLocalReturnPlan(flag: bool) -> Json {
    if (flag) {
        var user: Json = { name: "ada", age: 1 }
        return user
    } else {
        var other: Json = { name: "bob", age: 2 }
        return other
    }
}

fn jsonBranchLocalReturnReceiverPlan(flag: bool) -> int {
    return makeJsonBranchLocalReturnPlan(flag).age
}

print(jsonBranchLocalReturnReceiverPlan(true))
