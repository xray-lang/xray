regex=capacity-plan [0-9]+ .*kind=string_builder op=append action=reserve_once .*evidence=row\+receiver_type\+elem_type\+exact_count\+may_grow reason=none
regex=capacity-plan [0-9]+ .*kind=string_builder op=to_string action=builder_finish .*reason=none
regex=encoding-plan [0-9]+ .*op=bytes_to_string action=validate_once .*evidence=row\+validated_once\+scalar_boundary\+input_type\+output_type reason=none
c_regex=xrt_strbuf_reserve_extra_exact\([^,]+, INT64_C\(15\)\);
c_contains=xrt_strbuf_append_string_no_grow(
c_regex=xrt_strbuf_append_scalar_no_grow\([^,]+, XR_FROM_BOOL\(1\)\)
c_regex=xrt_strbuf_append_scalar_no_grow\([^,]+, XR_FROM_RUNE\(\(uint32_t\)0x4E2D\)\)
c_regex=xrt_strbuf_append_scalar_no_grow\([^,]+, XR_NULL_VAL\)
c_contains=xrt_strbuf_finish(
c_not_contains=xrt_strbuf_append(
c_not_regex=xrt_strbuf_reserve_extra_exact\([^,]+, INT64_C\(4\)\);
