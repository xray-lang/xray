contains=xaot-plan v0
regex=method-dispatch [0-9]+ callsite=[0-9]+ span=[0-9]+ kind=direct .*method=[1-9][0-9]* .*recv_class=[1-9][0-9]* .*targets=[0-9]+\+1 evidence=0x7 reason=none
regex=fn-attr [0-9]+ func=idText body=[0-9]+ attr=const effect=0x0 escape=0x1 evidence=0x3
regex=fn-attr [0-9]+ func=wrap body=[0-9]+ attr=pure effect=0x60 escape=0x1 evidence=0x7
c_regex=static XRT_FN_PURE void \* direct_method_func_attr_callee_effect_[0-9a-f]+_wrap_[0-9]+\(xrt_closure_t \*_cl, xrt_native_direct_method_func_attr_callee_effect_[0-9a-f]+_Echo \*p0, void \* p1\)
# The string argument is passed unboxed with an explicit pointer cast.
c_regex=void \* v[0-9]+ = direct_method_func_attr_callee_effect_[0-9a-f]+_idText_[0-9]+\(NULL, \(\(xrt_native_direct_method_func_attr_callee_effect_[0-9a-f]+_Echo\*\)v[0-9]+\), \(void \*\)\(v[0-9]+\)\);
c_not_contains=xrt_method_call
