fn worker(n: i64) -> i64 {
    Coro.yield()
    return n + 1
}

fn sumFour() -> i64 {
    var t1 = go worker(1)
    var t2 = go worker(2)
    var t3 = go worker(3)
    var t4 = go worker(4)
    var results = await all [t1, t2, t3, t4]
    return results[0] + results[1] + results[2] + results[3]
}

print(sumFour())
