fn worker(n: int) -> int {
    Coro.yield()
    return n + 1
}

fn sumFour() -> int {
    let t1 = go worker(1)
    let t2 = go worker(2)
    let t3 = go worker(3)
    let t4 = go worker(4)
    let results = await all [t1, t2, t3, t4]
    return results[0] + results[1] + results[2] + results[3]
}

print(sumFour())
