args=--dump-global-evidence
regex=object-shape [0-9]+ id=[1-9][0-9]* .*kind=static .*domain=0
regex=json-codec [0-9]+ .*kind=decode .*output_shape=[1-9][0-9]*
regex=json-codec [0-9]+ .*kind=encode .*input_shape=[1-9][0-9]*
contains=xaot-plan v0
regex=object-shape-plan [0-9]+ .*kind=static .*domain=0 .*reason=none
c_contains=xrt_json_decode_struct_object
c_contains=xrt_json_encode
c_contains=(const XrJsonDecodeFieldSpec[]){{"name", 5, NULL, 0, NULL}, {"age", 3, NULL, 0, NULL}}
