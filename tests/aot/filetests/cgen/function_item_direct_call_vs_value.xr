fn inc_item(x: int) -> int {
    return x + 1
}

const inc_value = fn(x: int) -> int {
    return x + 2
}

fn use_value(f: (int) -> int, x: int) -> int {
    return f(x)
}

fn xray_item_call(x: int) -> int {
    return inc_item(x)
}

fn xray_value_call(x: int) -> int {
    return use_value(inc_value, x)
}
