contains=xaot-plan v0
regex=method-dispatch [0-9]+ callsite=[0-9]+ span=[0-9]+ kind=type_switch .*recv_class=0 recv_iface=[1-9][0-9]* slot=0 targets=[0-9]+\+2 evidence=0x51 reason=none
regex=dispatch-target [0-9]+ callsite=[0-9]+ recv_class=[1-9][0-9]* method=[1-9][0-9]* evidence=0x51
regex=interface-use [0-9]+ interface=[1-9][0-9]* implementor=[1-9][0-9]* use_site=[1-9][0-9]* reason=value flags=iface_object\+type_switchable
c_contains=xrt_instanceof(
c_regex=if \(xrt_instanceof\(_xr_ts_recv_[0-9]+, \(uint16_t\).+\)\)
c_regex=else if \(xrt_instanceof\(_xr_ts_recv_[0-9]+, \(uint16_t\).+\)\)
c_regex=_xr_ts_result_[0-9]+ = XR_TO_INT\(interface_type_switch_direct_area_[0-9]+_boxed\(NULL, v[0-9]+\)\);
c_contains=xray AOT: verified interface type-switch dispatch missed
c_not_contains=xrt_method_
not_contains=verified AOT dispatch plan kind
