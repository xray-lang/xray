fn hash32(seq: u32) -> u32 {
    var prime: u32 = 2654435761
    return seq * prime
}

fn compound32(acc: u32, input: u32) -> u32 {
    var hash = acc
    var prime: u32 = 2246822519
    hash += input * prime
    hash ^= hash >> 13
    return hash
}

fn mix64(seq: u64) -> u64 {
    var prime: u64 = 889523592379
    return (seq + prime) * prime
}

print(hash32(123456))
print(compound32(123456, 789))
print(mix64(123456))
