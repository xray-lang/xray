fn denseLookup() -> int {
    var scores = #{0: 10, 1: 11, 2: 12, 3: 13, 4: 14}
    var seen: Set<int> = #[0, 1, 2, 3, 4]
    var fromIndex = scores[2]
    var viaGet = scores.get(4)
    var total = fromIndex + viaGet!
    if (scores.containsKey(3)) {
        if (seen.contains(1)) {
            return total
        }
    }
    return 0
}

print(denseLookup())
