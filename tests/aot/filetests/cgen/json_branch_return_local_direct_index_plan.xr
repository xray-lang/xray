fn makeJsonBranchReturnLocalPlan(flag: bool) -> Json {
    if (flag) {
        return { name: "ada", age: 1 }
    } else {
        return { name: "bob", age: 2 }
    }
}

fn jsonBranchReturnLocalPlan(flag: bool) -> string {
    var j: Json = makeJsonBranchReturnLocalPlan(flag)
    return j.age
}

print(jsonBranchReturnLocalPlan(true))
