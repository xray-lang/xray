import mem

enum Failure {
    Closed,
    Failed
}

enum Outcome {
    Unit(i64, i64),
    Echo(i64, i64, Buffer?),
    State(i64, i64, i64),
    Failed(Failure)
}

fn pause() {
    Coro.yield()
}

fn step() {
    pause()
}

fn worker(n: i64) -> Outcome {
    var owned = Outcome.Echo(1, 2, mem.allocZeroed(n))
    step()
    return owned
}

fn run() -> i64 {
    var result = worker(41)
    return match (result) {
        Outcome.Echo(_id, _generation, payload) -> len(payload!.asBytes()),
        _ -> 0
    }
}

print(run())
