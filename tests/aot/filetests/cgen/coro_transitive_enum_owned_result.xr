import mem

enum Failure {
    Closed,
    Failed
}

enum Outcome {
    Unit(int, int),
    Echo(int, int, Buffer?),
    State(int, int, int),
    Failed(Failure)
}

fn pause() {
    Coro.yield()
}

fn step() {
    pause()
}

fn worker(n: int) -> Outcome {
    var owned = Outcome.Echo(1, 2, mem.allocZeroed(n))
    step()
    return owned
}

fn run() -> int {
    var result = worker(41)
    return match (result) {
        Outcome.Echo(_id, _generation, payload) -> len(payload!.asBytes()),
        _ -> 0
    }
}

print(run())
