class Box {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

fn fillBoxes(boxes: Array<Box>, replacement: Box) -> int {
    boxes.fill(replacement, 1, 3)
    return boxes[0].value + boxes[1].value + boxes[2].value
}

var boxes: Array<Box> = [Box(1), Box(2), Box(3), Box(4)]
print(fillBoxes(boxes, Box(9)))
