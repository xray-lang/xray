class Box {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

fn fillBoxes(boxes: ref Array<Box>, replacement: Box) -> i64 {
    boxes.fill(replacement, 1, 3)
    return boxes[0].value + boxes[1].value + boxes[2].value
}

var boxes: Array<Box> = [Box(1), Box(2), Box(3), Box(4)]
print(fillBoxes(ref boxes, Box(9)))
