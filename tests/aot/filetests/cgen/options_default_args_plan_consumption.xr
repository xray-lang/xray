fn endpoint(host: string, port: i64 = 80, tls: bool = false) -> i64 {
    if (tls) {
        return port + len(host)
    }
    return port
}

fn allSupplied() -> i64 {
    return endpoint("api", 443, true)
}

fn needsDefaults() -> i64 {
    return endpoint("local")
}

print(allSupplied() + needsDefaults())
