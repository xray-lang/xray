class JsonArrayMethodReturnLocalFactory {
    makeUsers() -> Array<Json> {
        return [{ name: "ada", age: 7 }, { name: "bob", age: 8 }]
    }
}

fn jsonArrayMethodReturnLocalContainerPlan() -> int {
    var f = JsonArrayMethodReturnLocalFactory()
    var users = f.makeUsers()
    return users[0].age
}

fn jsonArrayMethodAssignedReturnLocalContainerPlan() -> string {
    var f = JsonArrayMethodReturnLocalFactory()
    var users: Array<Json> = []
    users = f.makeUsers()
    return users[0].name
}

print(jsonArrayMethodReturnLocalContainerPlan())
print(jsonArrayMethodAssignedReturnLocalContainerPlan())
