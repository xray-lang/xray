class Shape {
    kind: i64

    constructor(kind: i64) {
        this.kind = kind
    }

    area() -> i64 {
        return this.kind
    }
}

class Rect extends Shape {
    w: i64
    h: i64

    constructor(w: i64, h: i64) {
        super(1)
        this.w = w
        this.h = h
    }

    area() -> i64 {
        return this.w * this.h
    }
}

fn score(shape: Shape) -> i64 {
    return shape.area()
}

print(score(Shape(5)) + score(Rect(3, 4)))
