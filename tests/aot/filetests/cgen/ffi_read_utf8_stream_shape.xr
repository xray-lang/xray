extern "C" {
    fn memchr(bytes: Ptr<byte>, value: i32, count: usize) -> Ptr<byte>
}

fn readUtf8Like(bytes: Ptr<byte>, length: usize) -> usize {
    var cursor: usize = 0
    var checksum: usize = 0
    while (cursor < length) {
        checksum += unsafe { bytes[cursor] }
        cursor += 1
    }
    unsafe { memchr(bytes, 109, length) }
    return checksum
}

const utf8 = b"wasm3"
print(readUtf8Like(unsafe { utf8.ptr() }, len(utf8) as usize))
