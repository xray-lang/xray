fn bump(value: ref int) -> int {
    for (var i = 0; i < 1; i++) {
        value = value + 1
    }
    return value
}

fn fill(value: ref int) -> int {
    value = 9
    for (var i = 0; i < 1; i++) {
        value = value + i
    }
    return value
}

fn run() -> int {
    var value = 1
    var slot = 0
    var score = bump(ref value) + value
    score = score + fill(ref slot) + slot
    return score
}

print(run())
