@derive(Clone)
class Child {
    value: i64

    init(value: i64) {
        this.value = value
    }
}

@derive(Clone)
class Snapshot {
    values: Array<i64>
    child: Child

    init(values: Array<i64>, child: Child) {
        this.values = values
        this.child = child
    }
}

var original = Snapshot([1, 2], Child(3))
var cloned = copy(original)
cloned.values[0] = 9
cloned.child.value = 8
print(original.values[0])
print(original.child.value)
print(cloned.values[0])
print(cloned.child.value)
