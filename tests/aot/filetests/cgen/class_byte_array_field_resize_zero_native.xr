class ScratchByteArray {
    out: Array<u8>

    constructor() {
        this.out = Array.withCapacity(4)
    }

    resetThenWrite() -> i64 {
        this.out.resize(0, 0)
        this.out.push(7)
        this.out.push(9)
        return len(this.out) + (this.out[0] as i64) + (this.out[1] as i64)
    }
}

var scratch = ScratchByteArray()
print(scratch.resetThenWrite())
