contains=xaot-plan v0
regex=generic-body-plan [0-9]+ id=[1-9][0-9]* inst=[1-9][0-9]* module=[1-9][0-9]* owner=[1-9][0-9]* origin_body=[1-9][0-9]* specialized_body=[1-9][0-9]* root_callsite=[1-9][0-9]* type=[1-9][0-9]* type_args=[1-9][0-9]*\+1 size=[6-9][0-9]+ action=share_canonical_body evidence=row\+inst\+types\+origin_body\+specialized_body\+root reason=code_size_threshold
regex=generic-code-size-plan [0-9]+ id=[1-9][0-9]* inst=[1-9][0-9]* module=[1-9][0-9]* body_use=[1-9][0-9]* origin=[6-9][0-9]+ specialized=[6-9][0-9]+ count=1 threshold=64 action=share_canonical_body evidence=row\+inst\+body_use\+threshold reason=code_size_threshold
not_regex=generic-body-plan .*profile
not_regex=generic-body-plan .*hot(ness)?
not_regex=generic-body-plan .*pgo
not_regex=generic-code-size-plan .*profile
not_regex=generic-code-size-plan .*hot(ness)?
not_regex=generic-code-size-plan .*pgo
c_regex=static (XRT_FN_PURE )?XrValue generic_codesize_share_plan_[0-9a-f]+_large_[0-9]+\(xrt_closure_t \*_cl, XrValue p0\)
