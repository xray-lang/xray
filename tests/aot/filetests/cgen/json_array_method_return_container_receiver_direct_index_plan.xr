class JsonArrayMethodReturnFactory {
    makeUsers() -> Array<Json> {
        return [{ name: "ada", age: 7 }, { name: "bob", age: 8 }]
    }
}

fn jsonArrayMethodReturnContainerReceiverPlan() -> int {
