@derive(JSON)
class Point {
    x: i64
    y: i64

    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }
}

fn make_point() -> Point {
    return Point(3, 4)
}

var point = make_point()
var encoded = JSON.value(point)
print(JSON.require<i64>(encoded, ["x"]))
print(JSON.stringify(point))
