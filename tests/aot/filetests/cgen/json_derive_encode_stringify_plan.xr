@derive(JSON)
class Point {
    x: int
    y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

fn make_point() -> Point {
    return Point(3, 4)
}

var point = make_point()
var encoded = JSON.value(point)
print(JSON.require<int>(encoded, ["x"]))
print(JSON.stringify(point))
