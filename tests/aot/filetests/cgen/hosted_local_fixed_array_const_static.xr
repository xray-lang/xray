const SECRET: [u8; 8] = comptime [11, 22, 33, 44, 55, 66, 77, 88]

fn readSecret(index: i64) -> i64 {
    // Keep a separate codegen boundary so this tests the module-owned
    // GET_SHARED path rather than caller-side constant propagation.
    var bytes: const Slice<u8> = SECRET[:]
    return bytes[index] as i64
}

print(readSecret(5))
