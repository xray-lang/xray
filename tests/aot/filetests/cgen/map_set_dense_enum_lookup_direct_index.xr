enum Color {
    Red,
    Green,
    Blue,
    Yellow,
    Purple
}

fn denseEnumLookup() -> i64 {
    var scores = #{
        Color.Red: 10,
        Color.Green: 11,
        Color.Blue: 12,
        Color.Yellow: 13,
        Color.Purple: 14
    }
    var seen: Set<Color> = #[Color.Red, Color.Green, Color.Blue, Color.Yellow, Color.Purple]
    var fromIndex = scores[Color.Blue]
    var viaGet = scores.get(Color.Purple)
    var total = fromIndex + viaGet!
    if (scores.containsKey(Color.Green)) {
        if (seen.contains(Color.Yellow)) {
            return total
        }
    }
    return 0
}

print(denseEnumLookup())
