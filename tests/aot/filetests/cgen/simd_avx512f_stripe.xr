import { U8x64, U32x16, U64x8 } from simd

fn stripe(acc: ref Slice<u64>, input: Slice<byte>, secret: Slice<byte>) {
    var data = U8x64.load(input)
    var words = data.bitXor(U8x64.load(secret)).reinterpretU32()
    var product = words.widenMulEven(words.swapAdjacent())
    var next = U64x8.load(acc).add(data.reinterpretU64().swapAdjacent()).add(product)
    var mixed = next.bitXor(next.shiftRight(47)).bitXor(U8x64.load(secret).reinterpretU64())
    var mixedWords = mixed.reinterpretU32()
    var prime = U32x16.splat(2654435761)
    var scrambled = mixedWords.widenMulEven(prime).add(mixedWords.widenMulOdd(prime).shiftLeft(32))
    scrambled.store(ref acc)
}

fn main() {
    var acc: [u64; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var input: [byte; 64] = [1; 64]
    var secret: [byte; 64] = [2; 64]
    var accView: Slice<u64> = acc[:]
    stripe(ref accView, input[:], secret[:])
    print(acc[0])
}

main()
