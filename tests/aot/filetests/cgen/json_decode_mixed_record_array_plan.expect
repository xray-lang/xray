args=--dump-global-evidence
regex=json-codec [0-9]+ .*kind=decode .*fields=4 .*record_shape=[1-9][0-9]*
contains=xaot-plan v0
regex=json-codec-plan [0-9]+ .*kind=decode action=decode_validate_copy .*fields=4 .*reason=none
c_contains=xrt_json_decode_struct_object
c_contains=(const XrJsonDecodeFieldSpec[]){{"name", 5, NULL, 0}, {"tags", 8, NULL, 0}, {"address", 7, (const XrJsonDecodeFieldSpec[]){{"city", 5, NULL, 0}, {"zip", 3, NULL, 0}}, 2}, {"active", 2, NULL, 0}}
