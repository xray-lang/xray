type Geo = { lat: float, verified: bool }
type Address = { city: string, geo: Geo }
type Profile = { name: string, address: Address }

fn jsonDecodeDeepNestedRecordPlan() -> Json {
    var data: Json = Json.parse("{\"name\":\"Dana\",\"address\":{\"city\":\"Hangzhou\",\"geo\":{\"lat\":30.25,\"verified\":true}}}")
    var profile = Json.decode<Profile>(data)
    return Json.encode(profile!)
}

print(jsonDecodeDeepNestedRecordPlan())
