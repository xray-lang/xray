c_not_contains=_ThreadLocalSlot
c_not_regex=xrt_getprop_name\([^,]+, "value"\)
c_regex=xrt_map_set_class_name\([^,]+, "ThreadLocal\$i64"\)
c_regex=int64_t sys_[0-9a-f]+_ThreadLocal_i64_get_m\(xrt_closure_t \*_cl, XrValue p0\)
c_regex=void sys_[0-9a-f]+_ThreadLocal_i64_set_m\(xrt_closure_t \*_cl, XrValue p0, int64_t p1\)
c_contains=xrt_map_has_i64_typed
c_contains=xrt_map_set_i64_i64_typed
