fn worker(x: int) -> int {
    return x + 1
}

fn sum(xs: Array<int>) -> int {
    return len(xs)
}

shared ch: Channel<Array<int>> = Channel(1)

var a = go worker(41)
var xs = [1, 2, 3]
var b = go sum(copy(xs))

fn send_owned(ch: Channel<Array<int>>) {
    owned ys = Array<int>(2, 0)
    ys[0] = 4
    ys[1] = 5
    ch.send(move ys)
}

send_owned(ch)

print(await a)
print(await b)
