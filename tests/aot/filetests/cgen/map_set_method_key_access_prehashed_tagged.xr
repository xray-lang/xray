fn methodTagged() -> i64 {
    var scores: Map<string, i64> = #{}
    scores.set("ada", 8)
    var hasAda = scores.containsKey("ada")
    var one = scores.get("ada")
    scores.delete("ada")
    scores.clear()

    var seen: Set<string> = #[]
    seen.add("ada")
    var sawAda = seen.contains("ada")
    seen.delete("ada")
    seen.clear()

    if (hasAda) {
        if (sawAda) {
            return one!
        }
    }
    return 0
}

print(methodTagged())
