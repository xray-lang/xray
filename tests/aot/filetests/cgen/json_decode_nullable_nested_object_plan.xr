type Address = { city: string, zip: int }
type Profile = { name: string, address: Address? }

fn jsonDecodeNullableNestedObjectPlan() -> JSON.Value {
    var data: JSON.Value = JSON.parseValue("{\"name\":\"Dana\",\"address\":null}")
    var profile = JSON.decode<Profile>(data)
    return JSON.value(profile!)
}

print(jsonDecodeNullableNestedObjectPlan())
