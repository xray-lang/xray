fn sumAfterGrowth(n: i64) -> f64 {
    var values: Array<f64> = []
    var i = 0
    while (i < n) {
        values.push((i as f64) + 0.5)
        i = i + 1
    }
    var sum = 0.0
    i = 0
    while (i < len(values)) {
        sum = sum + values[i]
        i = i + 1
    }
    return sum
}

print(sumAfterGrowth(12))
