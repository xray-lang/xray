fn unsafeBytes(dst: ref Slice<u8>, src: Slice<u8>) {
    unsafe {
        dst.copyFrom(src)
    }
}

fn safeBytes(dst: ref Slice<u8>, src: Slice<u8>) {
    dst.copyFrom(src)
}

fn unsafeWords(dst: ref Slice<u64>, src: Slice<u64>) {
    unsafe {
        dst.copyFrom(src)
    }
}

fn safeWords(dst: ref Slice<u64>, src: Slice<u64>) {
    dst.copyFrom(src)
}

fn run() {
    var bytes: [u8; 2] = [0, 0]
    var words: [u64; 2] = [0, 0]
    var byteView: Slice<u8> = bytes[:]
    var wordView: Slice<u64> = words[:]
    unsafeBytes(ref byteView, bytes[:])
    safeBytes(ref byteView, bytes[:])
    unsafeWords(ref wordView, words[:])
    safeWords(ref wordView, words[:])
}

run()
