contains=xaot-plan v0
regex=closure [0-9]+ func=objectClosureCapturePlan value=v[0-9]+ target=<anonymous> captures=1 repr=stack
regex=object-shape-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ type=[0-9]+ stable_type=[0-9a-f]+ kind=literal domain=1 action=exact fields=[0-9]+\+2 key=[0-9a-f]+ evidence=0x27 reason=none
regex=object-access-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ shape=[0-9]+ kind=field_get domain=1 syntax=1 action=direct_ordinal shape_count=1 shape_set=1 epoch=0 field_name=[0-9]+ result_type=0 field=1 evidence=0x1d reason=none
c_regex=static const XrAotCallableDesc _xr_callable_[0-9]+ = \{.*\.sync_entry=\(void\*\)object_closure_capture_direct_field_plan_[0-9a-f]+___anonymous__[0-9]+
c_regex=xrt_closure_stack_new\(&_xr_callable_[0-9]+, 1\)
c_regex=XrValue v[0-9]+ = xrt_json_get_field\(v[0-9]+, 1\);
c_not_contains=xrt_method_
