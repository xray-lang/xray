fn fillUsers(users: ref Array<JSON.Value>, replacement: JSON.Value) -> i64 {
    users.fill(replacement, 1, 3)
    return copy(JSON.require<i64>(users[1], ["age"]))
}

var users: Array<JSON.Value> = [
    JSON.value({ name: "ada", age: 1 }),
    JSON.value({ name: "bob", age: 2 }),
    JSON.value({ name: "cy", age: 3 }),
]
var replacement: JSON.Value = JSON.value({ name: "zoe", age: 9 })
print(fillUsers(ref users, replacement))
