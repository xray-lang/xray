fn fillUsers(users: ref Array<Json>, replacement: Json) -> int {
    users.fill(replacement, 1, 3)
    return copy(users[1].age)
}

var users: Array<Json> = [{ name: "ada", age: 1 }, { name: "bob", age: 2 }, { name: "cy", age: 3 }]
var replacement: Json = { name: "zoe", age: 9 }
print(fillUsers(ref users, replacement))
