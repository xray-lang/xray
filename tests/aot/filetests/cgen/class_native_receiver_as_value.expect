# The generated C must compile: the receiver-as-value bug emitted an undeclared
# `v0`, which -fsyntax-only rejects.
c_syntax=pass
# `return this` keeps the receiver in its native pointer representation.
c_regex=void \* v[0-9]+ = p0;
c_regex=return v[0-9]+;
# Static cleanup reads the receiver place directly and constructs no capture.
c_regex=\(p0\)->f0;
c_not_contains=_c->upvals[
c_not_contains=xrt_box_obj(
c_not_contains=xrt_defer_
# The constructor's implicit receiver return stays a direct `return p0`.
c_contains=return p0;
# Native dispatch must not fall back to the runtime method helper.
c_not_contains=xrt_method_
