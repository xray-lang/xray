args=--dump-global-evidence
regex=json-codec [0-9]+ .*kind=parse .*target_type=[1-9][0-9]* .*output_shape=[1-9][0-9]* .*fields=3
c_contains=xrt_json_parse_typed_object_or_throw_consume(
c_contains=static const XrtObjectShape _xobj_shape_
c_contains=(const XrJsonDecodeFieldSpec[])
c_contains={"inner", 7,
c_contains={"values", 8, (const XrJsonDecodeFieldSpec[]){{NULL, 6, NULL, 0, NULL}}, 1
c_not_contains=xrt_json_parse_consume(
c_not_contains=xrt_json_decode_struct_object_consume(
