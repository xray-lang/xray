contains=xaot-plan v0
regex=method-dispatch [0-9]+ callsite=[0-9]+ span=[0-9]+ kind=direct .*recv_class=0 recv_iface=[1-9][0-9]* slot=0 targets=[0-9]+\+1 evidence=0x31 reason=none
regex=dispatch-target [0-9]+ callsite=[0-9]+ recv_class=[1-9][0-9]* method=[1-9][0-9]* owner_class=[1-9][0-9]* body=[1-9][0-9]* name=[1-9][0-9]* sig=[1-9][0-9]* root=[1-9][0-9]* depth=[0-9]+ evidence=0x31
regex=interface-use [0-9]+ interface=[1-9][0-9]* implementor=[1-9][0-9]* use_site=[1-9][0-9]* reason=value flags=iface_object
regex=interface-abi [0-9]+ interface=[1-9][0-9]* callsites=1 implementors=1 slots=1 flags=iface_object\+itable\+boxed_receiver data=boxed_value type=native_type_id itable=dispatch_slot tag=none evidence=callsite\+methods\+implementors\+dispatch\+object_use reason=none
regex=fn-attr [0-9]+ func=idText body=[0-9]+ attr=const effect=0x0 escape=0x1 evidence=0x3
regex=fn-attr [0-9]+ func=wrap body=[0-9]+ attr=pure effect=0x60 escape=0x1 evidence=0x7
c_regex=static XRT_FN_PURE void \* interface_direct_func_attr_callee_effect_[0-9a-f]{16}_wrap_[0-9]+\(xrt_closure_t \*_cl, XrValue p0, void \* p1\)
c_regex=void \* v[0-9]+ = \(interface_direct_func_attr_callee_effect_[0-9a-f]{16}_idText_[0-9]+_boxed\(NULL, v[0-9]+, xr_str_value_from_ptr\(v[0-9]+\)\)\).ptr;
c_not_contains=xrt_method_call
