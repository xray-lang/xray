class Shape {
    kind: i64

    constructor(kind: i64) {
        this.kind = kind
    }

    kind_plus() -> i64 {
        return this.kind + 7
    }
}

class Rect extends Shape {
    w: i64
    h: i64

    constructor(w: i64, h: i64) {
        super(1)
        this.w = w
        this.h = h
    }

    area() -> i64 {
        return this.w * this.h
    }

    kind_plus() -> i64 {
        return this.kind + this.w
    }
}

fn run(n: i64) -> i64 {
    var total = 0
    var i = 0
    while (i < n) {
        var r = Rect(i, i + 1)
        total = total + r.area() + r.kind_plus()
        i = i + 1
    }
    return total
}

print(run(10))
