import { U8x16 } from simd

fn roundtrip() -> byte {
    var input: [byte; 16] = [7; 16]
    var output: [byte; 16] = [0; 16]
    var inputView: Slice<byte> = input[:]
    var outputView: Slice<byte> = output[:]
    var lanes = unsafe { U8x16.load(inputView, 0) }
    unsafe { lanes.store(ref outputView, 0) }
    return lanes.extract(0)
}

print(roundtrip())
