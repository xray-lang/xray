fn makeJsonFallthroughReturnPlan(flag: bool) -> Json {
    if (flag) {
        return { name: "ada", age: 1 }
    }
    return { name: "bob", age: 2 }
}

fn jsonFallthroughReturnReceiverPlan(flag: bool) -> int {
    return makeJsonFallthroughReturnPlan(flag).age
}

print(jsonFallthroughReturnReceiverPlan(true))
