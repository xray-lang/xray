fn guardedWindowLength(values: Slice<u8>, start: i64, count: i64) -> i64 {
    if (start < 0) {
        return -1
    }
    if (count < 0) {
        return -1
    }
    if (start > len(values) - count) {
        return -1
    }
    var window: Slice<u8> = values.window(start, count)
    return len(window)
}

var values: [u8; 4] = [11, 13, 17, 19]
print(guardedWindowLength(values[:], 1, 2))
