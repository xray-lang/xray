const ROUND_PRIME: u32 = 2246822519

@noinline
fn localRound(value: u32) -> u32 {
    var acc = value
    acc += ROUND_PRIME
    acc = acc.rotateLeft(13)
    acc++
    acc--
    return acc
}

@noinline
fn sliceRead(data: Slice<byte>) -> u32 {
    return data.load<u32>(0, Endian.LE)
}

export fn xray_local_round(value: u32) -> u32 {
    return localRound(value)
}

export fn xray_slice_read(data: Slice<byte>) -> u32 {
    return sliceRead(data)
}

var storage: [byte; 4] = [1, 2, 3, 4]
print(xray_local_round(1))
print(xray_slice_read(storage[:]))
