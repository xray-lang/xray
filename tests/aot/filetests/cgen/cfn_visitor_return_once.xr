type Visitor = CFn<fn(i64, i64) -> i64>

var visits = 0

fn visit(left: i64, right: i64) -> i64 {
    visits += 1
    return left + right
}

fn forEach(left: i64, visitor: Visitor, right: i64) -> i64 {
    var result = visitor(left, right)
    print(result)
    return result
}

print(forEach(20, visit, 22))
print(visits)
