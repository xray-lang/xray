type Address = { city: string, zip: int }
type Profile = { name: string, tags: Array<Json>, address: Address, active: bool }

fn jsonDecodeMixedRecordArrayPlan() -> Json {
    var data: Json = Json.parse("{\"name\":\"Dana\",\"tags\":[\"ops\",3,null],\"address\":{\"city\":\"Hangzhou\",\"zip\":310000},\"active\":true}")
    var profile = Json.decode<Profile>(data)
    return Json.encode(profile!)
}

print(jsonDecodeMixedRecordArrayPlan())
