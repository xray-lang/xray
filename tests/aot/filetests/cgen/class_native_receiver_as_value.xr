// A native class method that returns `this` must materialize a `v0 = p0`
// receiver alias instead of eliding it, otherwise the generated C references
// an undeclared `v0`. A cleanup reads `this` directly from its stable receiver
// place; the constructor's implicit `return this` remains `return p0`.

class Box {
    n: int

    constructor(n: int) {
        this.n = n
    }

    self() -> Box {
        return this
    }

    tap() -> int {
        defer { this.n = this.n + 1 }
        return this.n
    }
}

fn run() -> int {
    var b = Box(4)
    var c = b.self()
    return c.n + b.tap()
}

print(run())
