fn run(n: i64) -> i64 {
    var values: Array<i64> = []
    var seed = 0
    while (seed < 64) {
        values.push((seed % 17) + 1)
        seed = seed + 1
    }

    var i = 0
    var sum = 0
    while (i < n) {
        sum = sum + pick<i64>(values, i % 64)
        i = i + 1
    }
    return sum
}

print(run(30000))
