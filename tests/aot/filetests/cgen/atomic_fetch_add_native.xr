const counter: Atomic<i64> = Atomic<i64>(0)

fn next() -> i64 {
    return counter.fetchAdd(1, Ordering.Relaxed)
}

fn nextSlot(width: i64) -> i64 {
    var index = counter.fetchAdd(1, Ordering.Relaxed)
    if (index >= 64) {
        return index
    }
    var slot = index % width
    return slot * width
}

print(next())
print(nextSlot(8))
