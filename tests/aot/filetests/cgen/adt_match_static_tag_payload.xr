enum FastResult<T> {
    Ok { value: T },
    Err { code: i64 }
}

fn pick(ok: bool) -> FastResult<i64> {
    if (ok) {
        return FastResult.Ok { value: 41 }
    }
    return FastResult.Err { code: 9 }
}

fn score(ok: bool) -> i64 {
    var result = pick(ok)
    match (result) {
        FastResult.Ok { value } -> {
            return value + 1
        }
        FastResult.Err { code } -> {
            return 0 - code
        }
    }
}

print(score(true))
print(score(false))
