import mem

struct Task208Function {
    code: Ptr<byte>
    codeSize: uintsize
    locals: [uint32; 4]
    constants: [uint64; 4]
    next: Ptr<Task208Function>
}

extern "C" {
    fn malloc(n: uintsize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>) -> ()
}

fn functionReleaseLike(count: uintsize) -> uintsize {
    var released: uintsize = 0
    var index: uintsize = 0
    while (index < count) {
        var block = unsafe { malloc(mem.sizeOf<Task208Function>()) }
        unsafe {
            free(block)
        }
        released += index
        index += 1
    }
    return released
}

print(mem.sizeOf<Task208Function>())
print(functionReleaseLike(5))
