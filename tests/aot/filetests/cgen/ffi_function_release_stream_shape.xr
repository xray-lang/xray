import mem

struct Task208Function {
    code: Ptr<byte>
    codeSize: usize
    locals: [u32; 4]
    constants: [u64; 4]
    next: Ptr<Task208Function>
}

extern "C" {
    fn malloc(n: usize) -> MutPtr<byte>
    fn free(p: MutPtr<byte>) -> ()
}

fn functionReleaseLike(count: usize) -> usize {
    var released: usize = 0
    var index: usize = 0
    while (index < count) {
        var block = unsafe { malloc(mem.sizeOf<Task208Function>()) }
        unsafe {
            free(block)
        }
        released += index
        index += 1
    }
    return released
}

print(mem.sizeOf<Task208Function>())
print(functionReleaseLike(5))
