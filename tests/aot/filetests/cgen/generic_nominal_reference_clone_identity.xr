interface Shape {
    area() -> i64
}

class Circle implements Shape {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    area() -> i64 {
        return this.value * this.value
    }
}

class Square implements Shape {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    area() -> i64 {
        return this.value + this.value
    }
}

fn score<T: Shape>(value: T) -> i64 {
    return value.area()
}

print(score<Circle>(Circle(7)))
print(score<Square>(Square(8)))
