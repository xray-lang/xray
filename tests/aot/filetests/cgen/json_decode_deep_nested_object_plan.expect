args=--dump-global-evidence
regex=json-codec [0-9]+ .*kind=decode .*output_shape=[1-9][0-9]* .*fields=2
contains=xaot-plan v0
regex=json-codec-plan [0-9]+ .*kind=decode action=decode_validate_copy .*fields=2 .*reason=none
c_contains=xrt_json_decode_struct_object
c_contains={"address", 7, (const XrJsonDecodeFieldSpec[])
c_contains={"geo", 7, (const XrJsonDecodeFieldSpec[])
c_contains={"lat", 4, NULL, 0, NULL}
c_contains={"verified", 2, NULL, 0, NULL}
