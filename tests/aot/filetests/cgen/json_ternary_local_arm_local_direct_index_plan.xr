fn jsonTernaryLocalArmInitializedLocalPlan(flag: bool) -> int {
    var left: Json = { name: "ada", age: 1 }
    var right: Json = { name: "bob", age: 2 }
    var user: Json = flag ? left : right
    return user.age
}

fn jsonTernaryLocalArmAssignedLocalPlan(flag: bool) -> int {
    var left: Json = { name: "ada", age: 1 }
    var right: Json = { name: "bob", age: 2 }
    var user: Json = { name: "seed", age: 0 }
    user = flag ? left : right
    return user.age
}

print(jsonTernaryLocalArmInitializedLocalPlan(true))
print(jsonTernaryLocalArmAssignedLocalPlan(false))
