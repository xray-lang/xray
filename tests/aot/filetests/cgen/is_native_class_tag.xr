// Prelude native classes have no shared class slot, so an `is` test against
// them must compile to a value-tag compare, never to the unresolved-class
// pointer fallback.
fn isConn(x: NetConn | int) -> bool { return x is NetConn }
fn isListener(x: NetListener | int) -> bool { return x is NetListener }
fn isBig(x: BigInt | int) -> bool { return x is BigInt }
fn isSb(x: StringBuilder | int) -> bool { return x is StringBuilder }

print(isConn(1))
print(isListener(2))
print(isBig(3))
print(isSb(4))
