fn build(flag: bool, n: i64) -> i64 {
    if (flag) {
        var xs: Array<i64> = []
        for (i in 0..n) {
            xs.push(i)
        }
        return len(xs)
    } else {
        var ys: Array<i64> = []
        for (i in 0..n) {
            ys.push(n)
        }
        return len(ys)
    }
}

print(build(true, 8) + build(false, 5))
