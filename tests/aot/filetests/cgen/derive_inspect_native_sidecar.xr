@derive(JSON, Inspect)
class Point {
    x: int
    y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

fn make_point() -> Point {
    return Point(3, 4)
}

var p = make_point()
print(p)
var encoded = JSON.value(p)
print(JSON.require<int>(encoded, ["x"]))
print(JSON.require<int>(encoded, ["y"]))
