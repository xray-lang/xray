@derive(JSON, Inspect)
class Point {
    x: i64
    y: i64

    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }
}

fn make_point() -> Point {
    return Point(3, 4)
}

var p = make_point()
print(p)
var encoded = JSON.value(p)
print(JSON.require<i64>(encoded, ["x"]))
print(JSON.require<i64>(encoded, ["y"]))
