class Registry {
    scores: Map<i64, i64>
    seen: Set<i64>

    constructor(scores: Map<i64, i64>, seen: Set<i64>) {
        this.scores = scores
        this.seen = seen
    }

    mark(value: i64) -> i64 {
        this.scores.set(1, value)
        this.scores[2] = value
        this.seen.add(1)
        var hasOne = this.scores.containsKey(1)
        var sawOne = this.seen.contains(1)
        var one = this.scores.get(1) ?? 0
        var two = this.scores[2]
        this.scores.delete(1)
        this.seen.delete(1)
        this.scores.clear()
        this.seen.clear()
        if (hasOne) {
            if (sawOne) {
                return one + two
            }
        }
        return 0
    }
}

var scores: Map<i64, i64> = #{}
var seen: Set<i64> = #[]
print(Registry(scores, seen).mark(7))
