struct Meta {
    label: string
    payload: JSON.Value
}
struct Envelope {
    id: i64
    meta: Meta
    note: string
}

var base: Envelope = Envelope{
    id: 7,
    meta: Meta{ label: "base", payload: JSON.parseValue("{\"ok\":true}") },
    note: "old",
}

var merged = Envelope{ ...base, note: "new" }

print(merged.id)
print(merged.meta.label)
print(JSON.require<bool>(merged.meta.payload, ["ok"]))
print(merged.note)
