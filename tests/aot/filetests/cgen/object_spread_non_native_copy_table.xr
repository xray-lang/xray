type Meta = { label: string, payload: JSON.Value }
type Envelope = { id: i64, meta: Meta, note: string }

var base: Envelope = {
    id: 7,
    meta: { label: "base", payload: JSON.parseValue("{\"ok\":true}") },
    note: "old",
}

var merged = { ...base, note: "new" }

print(merged.id)
print(merged.meta.label)
print(JSON.require<bool>(merged.meta.payload, ["ok"]))
print(merged.note)
