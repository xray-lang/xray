// A tail-position CFn indirect call (`return OPS[pc+1](...)`) — the wasm3 threaded
// operation topology — lowers to a musttail tail jump: constant-stack, native ABI.
// The op table is a const Array<CFn<...>> of module-level ops.
extern "C" { fn malloc(n: usize) -> MutPtr<i32> }

type Op = CFn<fn(i64, MutPtr<i32>, i64) -> i64>

var IMM: Array<i32> = [10, 20, 0, 0]

fn opConst(pc: i64, stack: MutPtr<i32>, sp: i64) -> i64 {
    var target = stack
    unsafe { target[sp] = IMM[pc] }
    return OPS[pc + 1](pc + 1, target, sp + 1)
}

fn opReturn(pc: i64, stack: MutPtr<i32>, sp: i64) -> i64 {
    return unsafe { stack[sp - 1] }
}

const OPS: Array<Op> = [opConst, opReturn]

fn run_thread() -> i32 {
    var stack = unsafe { malloc(64) }
    return OPS[0](0, stack, 0) as i32
}
