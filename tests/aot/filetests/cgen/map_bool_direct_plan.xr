fn boolLookup(flag: bool) -> int {
    var scores: Map<bool, int> = #{true: 7, false: 3}
    var seen: Set<bool> = #[true, false]
    var total = scores[flag]
    if (scores.containsKey(true)) {
        if (seen.contains(false)) {
            return total
        }
    }
    return 0
}

print(boolLookup(true))
