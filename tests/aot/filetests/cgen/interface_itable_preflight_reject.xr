    constructor() {
    }

    area() -> int {
        return 2
    }
}

class C implements Shape {
    constructor() {
    }

    area() -> int {
        return 3
    }
}

class D implements Shape {
    constructor() {
    }

    area() -> int {
        return 4
    }
}

class E implements Shape {
