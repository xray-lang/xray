fn makeJsonArrayReturnLocalUsers() -> Array<Json> {
    return [{ name: "ada", age: 7 }, { name: "bob", age: 8 }]
}

fn jsonArrayReturnLocalContainerPlan() -> int {
    var users = makeJsonArrayReturnLocalUsers()
    return users[0].age
}

fn jsonArrayAssignedReturnLocalContainerPlan() -> string {
    var users: Array<Json> = []
    users = makeJsonArrayReturnLocalUsers()
    return users[0].name
}

print(jsonArrayReturnLocalContainerPlan())
print(jsonArrayAssignedReturnLocalContainerPlan())
