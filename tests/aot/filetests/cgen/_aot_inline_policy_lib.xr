fn small(x: int) -> int {
    return x + 1
}

fn looping(n: int) -> int {
    var acc = 0
    var i = 0
    while (i < n) {
        acc = acc + small(i)
        i = i + 1
    }
    return acc
}

fn stackAggregate(index: int) -> int {
    var lanes: [int; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var acc = lanes[index & 7]
    var i = 0
    while (i < 8) {
        acc = acc + lanes[i]
        i = i + 1
    }
    return acc
}

export fn runPolicy(n: int) -> int {
    return looping(n) + small(n) + stackAggregate(n)
}
