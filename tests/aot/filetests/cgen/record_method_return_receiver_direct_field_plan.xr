type User = { name: string, age: int }

class RecordMethodReturnFactory {
    makeUser() -> User {
        return { name: "ada", age: 7 }
    }
}

fn recordMethodReturnReceiverPlan() -> int {
    var f = RecordMethodReturnFactory()
    return f.makeUser().age
}

print(recordMethodReturnReceiverPlan())
