fn readSlot(outputs: Array<Array<u8>>, index: i64) -> i64 {
    var sharedOutputs = copy(outputs)
    unsafe {
        var block = sharedOutputs.get(index)
        return len(block)
    }
}

var block: Array<u8> = Array.withCapacity(1)
unsafe {
    block.push(7)
}
var outputs: Array<Array<u8>> = []
outputs.push(block)
print(readSlot(outputs, 0))
