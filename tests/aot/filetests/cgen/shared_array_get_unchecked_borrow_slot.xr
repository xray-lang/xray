fn readSlot(outputs: Array<Array<byte>>, index: int) -> int {
    shared sharedOutputs = outputs
    unsafe {
        var block = sharedOutputs.get(index)
        return len(block)
    }
}

var block = Array<byte>.withCapacity(1)
unsafe {
    block.push(7)
}
var outputs: Array<Array<byte>> = []
outputs.push(block)
print(readSlot(outputs, 0))
