fn readSlot(outputs: Array<Bytes>, index: int) -> int {
    shared sharedOutputs = outputs
    unsafe {
        var block = sharedOutputs.getUnchecked(index)
        return block.length
    }
}

var block = Bytes.withCapacity(1)
unsafe {
    block.push(7)
}
var outputs: Array<Bytes> = []
outputs.push(block)
print(readSlot(outputs, 0))
