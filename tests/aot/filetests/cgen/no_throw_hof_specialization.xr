enum HofError { Negative }

fn apply<T>(callback: fn(T) -> T, value: T) -> T {
    return callback(value)
}

fn increment(value: i64) -> i64 {
    return value + 1
}

fn checked(value: i64) -> i64 {
    if (value < 0) {
        throw HofError.Negative
    }
    return value + 1
}

fn xray_apply_pure(value: i64) -> i64 {
    return apply<i64>(increment, value)
}

fn xray_apply_checked(value: i64) -> i64 {
    return apply<i64>(checked, value)
}
