fn makeJsonTernaryAssignedReturnPlan(flag: bool) -> Json {
    var user: Json = { name: "seed", age: 0 }
    user = flag ? { name: "ada", age: 1 } : { name: "bob", age: 2 }
    return user
}

fn jsonTernaryAssignedReturnReceiverPlan(flag: bool) -> int {
    return makeJsonTernaryAssignedReturnPlan(flag).age
}

print(jsonTernaryAssignedReturnReceiverPlan(true))
