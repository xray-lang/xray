struct Secret {
    bytes: [u8; 4]
}

fn copyInto(destination: ref [u8; 4], secret: Secret) {
    destination = secret.bytes
}

fn run() -> i64 {
    var destination: [u8; 4] = [0; 4]
    var secret = Secret{bytes: [11, 22, 33, 44]}
    copyInto(ref destination, secret)
    return (destination[0] as i64) + (destination[1] as i64) +
        (destination[2] as i64) + (destination[3] as i64)
}

print(run())
