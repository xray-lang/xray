fn unsafeWindow(bytes: Slice<u8>, start: i64, count: i64) -> i64 {
    var window = unsafe {
        bytes.window(start, count)
    }
    return len(window)
}

fn safeWindow(bytes: Slice<u8>, start: i64, count: i64) -> i64 {
    return len(bytes.window(start, count))
}

var bytes: [u8; 4] = [1, 2, 3, 4]
print(unsafeWindow(bytes[:], 1, 2) + safeWindow(bytes[:], 1, 2))
