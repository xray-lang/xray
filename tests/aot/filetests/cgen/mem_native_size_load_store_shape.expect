contains=xaot-plan v0
regex=value v[0-9]+ op=PTR_STORE kind=void rep=void c_type=void
regex=value v[0-9]+ op=CONST kind=scalar rep=isize c_type=ptrdiff_t
regex=value v[0-9]+ op=AGG_SET kind=void rep=void c_type=void
regex=value v[0-9]+ op=PTR_LOAD kind=scalar rep=usize c_type=size_t
