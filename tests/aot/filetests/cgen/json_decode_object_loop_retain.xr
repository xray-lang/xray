type Profile = { id: i64, active: bool }

fn run(n: i64) -> i64 {
    var object = JSON.parseObject("{\"id\":7,\"active\":true}")
    var i = 0
    var total = 0
    while (i < n) {
        var profile = JSON.decodeObject<Profile>(object)!
        total += profile.id
        i += 1
    }
    return total
}

print(run(3))
