type Profile = { id: int, active: bool }

fn run(n: int) -> int {
    var object = JSON.parseObject("{\"id\":7,\"active\":true}")
    var i = 0
    var total = 0
    while (i < n) {
        var profile = JSON.decodeObject<Profile>(object)!
        total += profile.id
        i += 1
    }
    return total
}

print(run(3))
