class Bag {
    value: i64

    constructor(value: i64) {
        this.value = value
    }

    scores() -> Map<i64, i64> {
        var scores: Map<i64, i64> = #{}
        scores.set(1, this.value)
        scores[2] = this.value
        return scores
    }

    seen() -> Set<i64> {
        var seen: Set<i64> = #[]
        seen.add(this.value)
        return seen
    }
}

fn mapSetMethodChainReceiverPlan(value: i64) -> i64 {
    var bag = Bag(value)
    var one = bag.scores().get(1) ?? 0
    var two = bag.scores()[2]
    var hasOne = bag.scores().containsKey(1)
    var sawOne = bag.seen().contains(1)
    if (hasOne) {
        if (sawOne) {
            return one + two
        }
    }
    return 0
}

print(mapSetMethodChainReceiverPlan(7))
