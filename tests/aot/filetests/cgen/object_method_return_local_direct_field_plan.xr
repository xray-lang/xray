type User = { name: string, age: i64 }

class ObjectMethodReturnLocalFactory {
    makeUser() -> User {
        return { name: "ada", age: 7 }
    }
}

fn objectMethodReturnLocalPlan() -> i64 {
    var f = ObjectMethodReturnLocalFactory()
    var user = f.makeUser()
    return user.age
}

fn objectMethodAssignedReturnLocalPlan() -> string {
    var f = ObjectMethodReturnLocalFactory()
    var user: User = { name: "zero", age: 0 }
    user = f.makeUser()
    return user.name
}

print(objectMethodReturnLocalPlan())
print(objectMethodAssignedReturnLocalPlan())
