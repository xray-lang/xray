export struct NarrowState {
    data: [u8; 4]
    total: u32

    static init(seed: u32) -> NarrowState {
        return NarrowState{data: [0; 4], total: seed}
    }

    digest() -> u64 {
        return this.total
    }
}

export struct WideState {
    data: [u8; 32]
    total: u64

    static init(seed: u64) -> WideState {
        return WideState{data: [0; 32], total: seed}
    }

    digest() -> u64 {
        return this.total
    }
}
