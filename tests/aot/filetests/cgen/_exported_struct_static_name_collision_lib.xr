export struct NarrowState {
    data: [byte; 4]
    total: uint32

    static init(seed: uint32) -> NarrowState {
        return NarrowState{data: [0; 4], total: seed}
    }

    digest() -> uint64 {
        return this.total
    }
}

export struct WideState {
    data: [byte; 32]
    total: uint64

    static init(seed: uint64) -> WideState {
        return WideState{data: [0; 32], total: seed}
    }

    digest() -> uint64 {
        return this.total
    }
}
