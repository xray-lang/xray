import mem

extern "C" {
    struct NativeSizePair {
        length: uintsize
        delta: intsize
    }
}

@c_export("xray_native_size_fields")
fn xray_native_size_fields(p: MutPtr<uint8>) -> intsize {
    var guard = p
    return unsafe {
        mem.withSliceMut<NativeSizePair>(p, 1, ref guard,
            fn(pairs: ref Slice<NativeSizePair>) -> intsize {
                pairs[0].length = 37
                pairs[0].delta = -37
                return pairs[0].delta
            })
    }
}

@c_export("xray_native_size_unaligned")
fn xray_native_size_unaligned(p: MutPtr<uint8>) -> uintsize {
    unsafe {
        mem.store<uintsize>(p, 1, 91, Endian.LE)
        return mem.load<uintsize>(p, 1, Endian.LE)
    }
}
