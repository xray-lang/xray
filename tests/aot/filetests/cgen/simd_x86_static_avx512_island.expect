args=--target x86_64-linux-musl --simd avx512 --dump-xaot-plan
c_contains=#define XR_AOT_COMPILE_SIMD_AVX512 1
c_not_regex=XRT_TARGET_AVX512 void simd_x86_static_avx512_island_[0-9a-f]+_ultraIsland_[0-9]+
c_regex=XRT_TARGET_AVX512 void simd_x86_static_avx512_island_[0-9a-f]+_ultra_[0-9]+
c_not_regex=XRT_TARGET_AVX512 uint64_t simd_x86_static_avx512_island_[0-9a-f]+_scalarHash_exp
c_contains=_mm512_add_epi64(
c_contains=_mm512_shuffle_epi32(
c_contains=_mm512_storeu_si512(
