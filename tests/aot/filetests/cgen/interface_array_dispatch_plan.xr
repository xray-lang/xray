interface Drawable {
    draw() -> i64
}

class Sprite implements Drawable {
    constructor() {
    }

    draw() -> i64 { return 1 }
}

class Icon implements Drawable {
    constructor() {
    }

    draw() -> i64 { return 2 }
}

fn drawAll(items: Array<Drawable>) -> i64 {
    var i = 0
    var sum = 0
    while (i < len(items)) {
        sum = sum + items[i].draw()
        i = i + 1
    }
    return sum
}

print(drawAll([Sprite(), Icon()]))
