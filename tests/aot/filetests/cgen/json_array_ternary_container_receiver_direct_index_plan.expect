contains=xaot-plan v0
regex=object-shape-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ type=[0-9]+ stable_type=[0-9a-f]+ kind=literal domain=0 action=exact fields=[0-9]+\+2 key=[0-9a-f]+ evidence=0x7 reason=none
regex=object-access-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ shape=[0-9]+ kind=field_get domain=0 syntax=1 action=direct_ordinal shape_count=1 shape_set=1 epoch=0 field_name=[0-9]+ result_type=0 field=1 evidence=0x1d reason=none
# A value assigned in more than one branch gets a hoisted declaration, so the
# assignment line carries no type prefix.  What this case guards is the direct
# field access by index -- not a dynamic name lookup -- so match the call and
# let the receiver be a value or a phi.
c_regex=[A-Za-z_][A-Za-z0-9_]* = xrt_json_get_field\([A-Za-z_][A-Za-z0-9_]*, 1\);
c_not_contains=xrt_json_get_name_owned
