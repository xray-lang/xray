type Address = { city: string, zip: i64 }
type Profile = { name: string, address: Address }

fn main() -> JSON.Value {
    var data: JSON.Value = JSON.parseValue("{\"name\":\"Dana\",\"address\":{\"city\":\"Hangzhou\",\"zip\":310000}}")
    var profile = JSON.decode<Profile>(data)
    return JSON.value(profile!)
}

print(main())
