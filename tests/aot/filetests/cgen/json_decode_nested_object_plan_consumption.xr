type Address = { city: string, zip: int }
type Profile = { name: string, address: Address }

fn main() -> Json {
    var data: Json = Json.parse("{\"name\":\"Dana\",\"address\":{\"city\":\"Hangzhou\",\"zip\":310000}}")
    var profile = Json.decode<Profile>(data)
    return Json.encode(profile!)
}

print(main())
