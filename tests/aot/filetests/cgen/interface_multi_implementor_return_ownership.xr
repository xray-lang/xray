interface EchoLike {
    idText(text: string) -> string
}

class EchoA implements EchoLike {
    init() {
    }

    idText(text: string) -> string {
        return text
    }
}

class EchoB implements EchoLike {
    init() {
    }

    idText(text: string) -> string {
        return text
    }
}

fn wrap(e: EchoLike, text: string) -> string {
    return e.idText(text)
}

print(wrap(EchoA(), "a"))
print(wrap(EchoB(), "b"))
