fn mapSetParamReceiverPlan(scores: ref Map<i64, i64>, seen: ref Set<i64>, value: i64) -> i64 {
    scores.set(1, value)
    scores[2] = value
    seen.add(1)
    var hasOne = scores.containsKey(1)
    var sawOne = seen.contains(1)
    var one = scores.get(1) ?? 0
    var two = scores[2]
    scores.delete(1)
    seen.delete(1)
    scores.clear()
    seen.clear()
    if (hasOne) {
        if (sawOne) {
            return one + two
        }
    }
    return 0
}

var scores: Map<i64, i64> = #{}
var seen: Set<i64> = #[]
print(mapSetParamReceiverPlan(ref scores, ref seen, 7))
