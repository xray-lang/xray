contains=xaot-plan v0
regex=json-access-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ shape=[0-9]+ kind=index_set action=direct_index key=[0-9]+ result_type=0 field=1 evidence=0xf reason=none
regex=json-access-plan [0-9]+ id=[0-9]+ module=[0-9]+ func=[0-9]+ shape=[0-9]+ kind=index_get action=direct_index key=[0-9]+ result_type=0 field=1 evidence=0xf reason=none
c_regex=xrt_json_set_field\(v[0-9]+, 1, v[0-9]+\)
c_regex=XrValue v[0-9]+ = xrt_json_get_field\(v[0-9]+, 1\);
