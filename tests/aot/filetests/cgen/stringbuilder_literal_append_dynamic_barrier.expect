regex=capacity-plan [0-9]+ .*kind=string_builder op=append action=reserve_once .*reason=none
regex=capacity-plan [0-9]+ .*kind=string_builder op=append action=checked_grow .*reason=count_unknown
c_contains=xrt_strbuf_reserve_extra_exact(v3, INT64_C(4));
c_contains=xrt_strbuf_reserve_extra_exact(v3, INT64_C(7));
c_contains=xrt_strbuf_append_string_no_grow(v3,
c_contains=xrt_strbuf_append(v3,
c_contains=xrt_strbuf_finish(v3)
c_not_contains=xrt_strbuf_reserve_extra_exact(v3, INT64_C(11));
