// A build contract may explicitly allow a named residue category. This body
// intentionally keeps a bounds branch so the verifier can exercise that path.
fn zeroCostAllowBounds(data: Slice<i64>, i: i64) -> i64 {
    if (i <= 0) {
        return 0
    }
    return data[i] + zeroCostAllowBounds(data, i - 1)
}

fn zc_allow_sum(a: i64) -> i64 {
    var d = [1, 2, 3, 4]
    return zeroCostAllowBounds(d[:], 3)
}
