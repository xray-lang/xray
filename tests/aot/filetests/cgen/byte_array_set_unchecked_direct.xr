fn patchHeader(out: ref Array<byte>) {
    unsafe {
        out.set(0, 0x04)
        out.set(1, 0x22)
        out.set(2, 0x4D)
        out.set(3, 0x18)
    }
}

var out: Array<byte> = Array.withCapacity(4)
unsafe {
    out.push(0)
    out.push(0)
    out.push(0)
    out.push(0)
}
patchHeader(ref out)
print(out[0] + out[1] + out[2] + out[3])
