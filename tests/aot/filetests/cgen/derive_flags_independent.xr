@derive(Inspect)
class InspectOnly {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

@derive(JSON)
class JsonOnly {
    value: i64

    constructor(value: i64) {
        this.value = value
    }
}

var inspect_only = InspectOnly(7)
print(inspect_only)

var json_only = JsonOnly(9)
var encoded = JSON.value(json_only)
print(JSON.require<i64>(encoded, ["value"]))
print(json_only)
