// First-class CFn op table lowers to a zero-alloc typed function-pointer table:
// module-level noncapturing functions stored as bare `_cfn` stub addresses in a
// raw-pointer array (XR_ELEM_RAWPTR), loaded as raw pointers, and indirect-called
// as a typed native C function pointer — no closure allocation, no XrValue boxing.
// This is the wasm3-style zero-cost dispatch primitive.
extern "C" { fn malloc(n: usize) -> MutPtr<i32> }

type Op = CFn<fn(int, MutPtr<i32>, int) -> int>

fn opConst(pc: int, stack: MutPtr<i32>, sp: int) -> int {
    var target = stack
    unsafe { target[sp] = 42 }
    return sp + 1
}

fn opAdd(pc: int, stack: MutPtr<i32>, sp: int) -> int {
    var target = stack
    var b = unsafe { target[sp - 1] }
    var a = unsafe { target[sp - 2] }
    unsafe { target[sp - 2] = a + b }
    return sp - 1
}

fn run_optable() -> i32 {
    var ops: Array<Op> = [opConst, opConst, opAdd]
    var stack = unsafe { malloc(64) }
    var sp = 0
    for (var pc = 0; pc < 3; pc++) {
        sp = ops[pc](pc, stack, sp)
    }
    return unsafe { stack[sp - 1] }
}
