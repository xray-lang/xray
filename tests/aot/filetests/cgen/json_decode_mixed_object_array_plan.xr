type Address = { city: string, zip: i64 }
type Profile = { name: string, tags: Array<JSON.Value>, address: Address, active: bool }

fn jsonDecodeMixedObjectArrayPlan() -> JSON.Value {
    var data: JSON.Value = JSON.parseValue("{\"name\":\"Dana\",\"tags\":[\"ops\",3,null],\"address\":{\"city\":\"Hangzhou\",\"zip\":310000},\"active\":true}")
    var profile = JSON.decode<Profile>(data)
    return JSON.value(profile!)
}

print(jsonDecodeMixedObjectArrayPlan())
