export fn facadeValue() -> i64 {
    return 42
}

export fn aliasedSource() -> i64 {
    return 7
}

export fn starValue() -> i64 {
    return 9
}

export fn groupTwoA() -> i64 {
    return 11
}

export fn groupTwoB() -> i64 {
    return 13
}

export fn groupTwoC() -> i64 {
    return 17
}

export struct ReexportPair {
    low: i64
    high: i64

    static init(low: i64, high: i64) -> ReexportPair {
        return ReexportPair{low: low, high: high}
    }
}

export fn makeReexportPair(low: i64, high: i64) -> ReexportPair {
    return ReexportPair.init(low, high)
}
