import { Plan, Options } from parallel

class Box<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }
}

var plan = Plan<i64>(Options(2), lane -> lane + 1)
var total = plan.reduce(0..8, Box<i64>(0), (state, i) -> Box<i64>(state + i), (a, b) -> Box<i64>(a.value + b.value))
print(total.value)
