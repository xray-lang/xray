import { Plan, Options } from parallel

class Box<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }
}

var plan = Plan<int>(Options(2), lane -> lane + 1)
var total = plan.reduce(0..8, Box<int>(0), (state, i) -> Box<int>(state + i), (a, b) -> Box<int>(a.value + b.value))
print(total.value)
