fn add_i64(a: int, b: int) -> int {
    return a + b
}

fn choose(flag: bool, value: int) -> int {
    if (flag) {
        return value
    }
    return 0
}

fn echo_text(text: string) -> string {
    return text
}

fn same_items(items: Array<int>) -> Array<int> {
    return items
}

print(choose(true, add_i64(21, 21)))
print(echo_text("ptr"))
let items: Array<int> = [1, 2, 3]
print(same_items(items).length())
