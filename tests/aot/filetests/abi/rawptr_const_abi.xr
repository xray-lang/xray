fn raw_const(p: RawPtr<byte>) -> RawPtr<byte> {
    return p
}

fn raw_mut(p: RawMut<byte>) -> RawMut<byte> {
    return p
}

fn raw_const_from_mut(p: RawMut<byte>) -> RawPtr<byte> {
    return p
}

var rp = RawPtr<byte>.null()
var mp = RawMut<byte>.null()

print(raw_const(rp).isNull())
print(raw_mut(mp).isNull())
print(raw_const_from_mut(mp).isNull())
