fn raw_const(p: Ptr<byte>) -> Ptr<byte> {
    return p
}

fn raw_mut(p: MutPtr<byte>) -> MutPtr<byte> {
    return p
}

fn raw_const_from_mut(p: MutPtr<byte>) -> Ptr<byte> {
    return p
}

var rp = Ptr<byte>.null()
var mp = MutPtr<byte>.null()

print(raw_const(rp).isNull())
print(raw_mut(mp).isNull())
print(raw_const_from_mut(mp).isNull())
