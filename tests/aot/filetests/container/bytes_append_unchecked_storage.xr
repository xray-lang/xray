fn buildBytes(src: Bytes) -> Bytes {
    let out = Bytes.withCapacity(12)
    unsafe {
        out.appendFromUnchecked(src, 1, 3)
        out.repeatFromUnchecked(2, 4)
    }
    return out
}

let src = Bytes(6)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40
src[4] = 50
src[5] = 60

let out = buildBytes(src)
print(out.length)
print(out[0])
print(out[6])
