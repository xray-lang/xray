fn bulk(dst: ref Slice<byte>, src: ref Slice<byte>) -> int {
    dst.fill(1)
    src.fill(7)
    var window: Slice<byte> = dst[2:6]
    window.copyFrom(src)
    dst.repeatFrom(6, 4, 2)
    var check: Slice<byte> = dst[2:6]
    return check.compare(src) + check.commonPrefix(src)
}

fn runBulk() -> int {
    var dst = Array<byte>(8, 0)
    var src = Array<byte>(4, 0)
    var dstView: Slice<byte> = dst[:]
    var srcView: Slice<byte> = src[:]
    return bulk(ref dstView, ref srcView)
}

print(runBulk())
