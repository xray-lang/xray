var bytes: Array<u8> = []
bytes.push(7)
bytes.push(9)

var values: Map<u8, i32> = #{}
values.set(1, 11)
values.set(2, 22)

var seen: Set<u16> = #[]
seen.add(1)
seen.add(2)

var chars: Array<rune> = []
chars.push('A')
chars.push('中')

class ArrayBag {
    values: Array<i64>

    constructor(items: Array<i64>) {
        this.values = items
    }

    scan() -> i64 {
        var arr = this.values
        var total = 0
        var i = 0
        while (i < len(arr)) {
            total = total + arr[i]
            i = i + 1
        }
        return total
    }

    refill(n: i64) -> i64 {
        var next_values: Array<i64> = []
        this.values = next_values

        var i = 0
        while (i < n) {
            this.values.push(i + 1)
            i = i + 1
        }

        var arr = this.values
        var total = 0
        i = 0
        while (i < len(arr)) {
            total = total + arr[i]
            i = i + 1
        }
        return total
    }
}

fn local_arrays() -> i64 {
    var values: Array<i64> = []
    values.push(1)
    values.push(2)
    values.push(3)

    var bag = ArrayBag(values)

    var mid: Slice<i64> = values[0:2]
    var mapped = values.map(fn(x: i64) -> i64 { return x + 10 })
    var kept = values.filter(fn(x: i64) -> bool { return x > 1 })

    var bytes = Array<u8>(3)
    bytes[0] = 4
    bytes[1] = 5
    bytes[2] = 6

    return mid[0] + mapped[0] + kept[0] + (bytes[2] as i64) + bag.scan() + bag.refill(4)
}

fn loop_sum(n: i64) -> i64 {
    var values: Array<i64> = []
    var i = 0
    while (i < n) {
        values.push(i)
        i = i + 1
    }

    var total = 0
    i = 0
    while (i < len(values)) {
        total = total + values[i]
        i = i + 1
    }
    return total
}

fn bytes_index(n: i64) -> i64 {
    var bytes = Array<u8>(n)
    var i = 0
    while (i < len(bytes)) {
        bytes[i] = (i * 3 + 1) as u8
        i = i + 1
    }

    var total = 0
    i = 0
    while (i < len(bytes)) {
        total = total + (bytes[i] as i64)
        i = i + 1
    }
    return total
}

fn char_ord_sum() -> i64 {
    var chars: Array<rune> = []
    chars.push('A')
    chars.push('中')
    chars[0] = 'B'
    return (chars[0] as i64) + (chars[1] as i64)
}

class Bag {
    values: Map<u8, i32>
    seen: Set<u16>

    constructor() {
        this.values = #{}
        this.seen = #[]
    }

    fill() -> i64 {
        this.values.set(1, 11)
        this.seen.add(1)
        if (this.values.containsKey(1)) {
            return len(this.seen)
        }
        return 0
    }
}

var bag = Bag()
print((bytes[0] as i64) + values.get(1)! + len(seen) + len(chars) + bag.fill() +
    local_arrays() + loop_sum(4) + bytes_index(4) + char_ord_sum())
