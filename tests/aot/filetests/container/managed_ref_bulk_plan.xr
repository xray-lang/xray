fn fill_refs(values: ref Array<string>, value: string) -> i64 {
    values.fill(value)
    return len(values[0]) + len(values[2])
}

fn make_text(seed: string) -> string {
    return seed + "-managed"
}

var values = [make_text("old-a"), make_text("old-b"), make_text("old-c")]
var value = make_text("new")
print(fill_refs(ref values, value))
print(values[1])
