fn read16(src: Slice<byte>, pos: int) -> int {
    var value: u16 = src.load<u16>(pos, Endian.LE)
    return int(value)
}

fn read32(src: Slice<byte>, pos: int) -> int {
    var value: u32 = src.load<u32>(pos, Endian.LE)
    return int(value)
}

fn read64(src: Slice<byte>, pos: int) -> int {
    var value: u64 = src.load<u64>(pos, Endian.LE)
    return int(value)
}

fn readI16(src: Slice<byte>, pos: int) -> int {
    var value: i16 = src.load<i16>(pos, Endian.LE)
    return int(value)
}

fn readI32(src: Slice<byte>, pos: int) -> int {
    var value: i32 = src.load<i32>(pos, Endian.LE)
    return int(value)
}

fn readF32(src: Slice<byte>, pos: int) -> f32 {
    var value: f32 = src.load<f32>(pos, Endian.LE)
    return value
}

fn readF64(src: Slice<byte>, pos: int) -> f64 {
    var value: f64 = src.load<f64>(pos, Endian.LE)
    return value
}

fn read32BE(src: Slice<byte>, pos: int) -> int {
    var value: u32 = src.load<u32>(pos, Endian.BE)
    return int(value)
}

fn write16(src: ref Slice<byte>, pos: int, value: u16) {
    src.store<u16>(pos, value, Endian.LE)
}

fn writeI16(src: ref Slice<byte>, pos: int, value: i16) {
    src.store<i16>(pos, value, Endian.LE)
}

fn writeF32(src: ref Slice<byte>, pos: int, value: f32) {
    src.store<f32>(pos, value, Endian.LE)
}

fn runLoads() {
    var bytes = Array<byte>(16, 0)
    bytes[0] = 1
    bytes[1] = 2
    bytes[2] = 3
    bytes[3] = 4
    bytes[4] = 5
    bytes[5] = 6
    bytes[6] = 7
    bytes[7] = 8
    print(read16(bytes[:], 0))
    print(read32(bytes[:], 0))
    print(read64(bytes[:], 0))
    print(readI16(bytes[:], 0))
    print(readI32(bytes[:], 0))
    print(readF32(bytes[:], 0))
    print(readF64(bytes[:], 0))
    print(read32BE(bytes[:], 0))
    var bytesView: Slice<byte> = bytes[:]
    write16(ref bytesView, 0, 0x1234)
    writeI16(ref bytesView, 2, -3)
    writeF32(ref bytesView, 4, 1.25)
}

runLoads()
