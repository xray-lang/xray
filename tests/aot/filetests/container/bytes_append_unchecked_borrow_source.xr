fn appendThenRead(src: Bytes) -> int {
    let out = Bytes.withCapacity(8)
    unsafe {
        out.appendFromUnchecked(src, 0, 2)
    }

    let tail: uint8 = 0
    unsafe {
        tail = src.getUnchecked(2)
    }
    return int(tail) + out.length
}

let src = Bytes(3)
src[0] = 11
src[1] = 22
src[2] = 33
print(appendThenRead(src))
