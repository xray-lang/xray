fn buildBytes(src: Array<byte>) -> Array<byte> {
    var out: Array<byte> = Array.withCapacity(12)
    out.appendFrom(src[1:4])
    out.repeatFrom(2, 4)
    return out
}

var src = Array<byte>(6)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40
src[4] = 50
src[5] = 60

var out = buildBytes(src)
print(len(out))
print(out[0])
print(out[6])
