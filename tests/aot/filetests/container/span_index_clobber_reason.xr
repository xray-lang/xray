fn clobbered_sum(src: Slice<byte>) -> int {
    var total = 0
    var i = 0
    while (i < len(src)) {
        print(i)
        total = total + int(src[i])
        i = i + 1
    }
    return total
}

var bytes = Array<byte>(2)
bytes[0] = 1
bytes[1] = 2
var view: Slice<byte> = bytes[:]
print(clobbered_sum(view))
