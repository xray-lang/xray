fn appendThenRead(src: Array<u8>) -> i64 {
    var out: Array<u8> = Array.withCapacity(8)
    out.appendFrom(src[0:2])

    var tail: u8 = 0
    unsafe {
        var readable = src
        tail = readable.get(2)
    }
    return (tail as i64) + len(out)
}

var src = Array<u8>(3)
src[0] = 11
src[1] = 22
src[2] = 33
print(appendThenRead(src))
