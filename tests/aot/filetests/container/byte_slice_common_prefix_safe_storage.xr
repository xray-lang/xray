fn common(src: Slice<u8>, left: i64, right: i64, maxCount: i64) -> i64 {
    var a: Slice<u8> = src[left:left + maxCount]
    var b: Slice<u8> = src[right:right + maxCount]
    return a.commonPrefix(b)
}

var bytes = Array<u8>(8, 0)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 1
bytes[4] = 2
bytes[5] = 9
print(common(bytes[:], 0, 3, 3))
