fn common(src: Slice<byte>, left: int, right: int, maxCount: int) -> int {
    var a: Slice<byte> = src[left:left + maxCount]
    var b: Slice<byte> = src[right:right + maxCount]
    return a.commonPrefix(b)
}

var bytes = Array<byte>(8, 0)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 1
bytes[4] = 2
bytes[5] = 9
print(common(bytes[:], 0, 3, 3))
