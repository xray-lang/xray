fn byte_slice_counted_guard_bounds_reject(bytes: Slice<u8>) -> u32 {
    var offset = 0
    var total: u32 = 0
    while (offset <= len(bytes) - 16) {
        // offset+13 plus a four-byte load extends one byte beyond the guard.
        total += bytes.load<u32>(offset + 13, Endian.LE)
        offset += 16
    }
    return total
}

var rejectedBytes = Array<u8>(32, 0)
print(byte_slice_counted_guard_bounds_reject(rejectedBytes[:]))
