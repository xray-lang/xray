fn read16(src: Slice<byte>, pos: int) -> int {
    var value: uint16 = src.load<uint16>(pos, Endian.LE)
    return int(value)
}

fn read32(src: Slice<byte>, pos: int) -> int {
    var value: uint32 = src.load<uint32>(pos, Endian.LE)
    return int(value)
}

fn read64(src: Slice<byte>, pos: int) -> int {
    var value: uint64 = src.load<uint64>(pos, Endian.LE)
    return int(value)
}

fn readI16(src: Slice<byte>, pos: int) -> int {
    var value: int16 = src.load<int16>(pos, Endian.LE)
    return int(value)
}

fn readI32(src: Slice<byte>, pos: int) -> int {
    var value: int32 = src.load<int32>(pos, Endian.LE)
    return int(value)
}

fn readF32(src: Slice<byte>, pos: int) -> float32 {
    var value: float32 = src.load<float32>(pos, Endian.LE)
    return value
}

fn readF64(src: Slice<byte>, pos: int) -> float64 {
    var value: float64 = src.load<float64>(pos, Endian.LE)
    return value
}

fn read32BE(src: Slice<byte>, pos: int) -> int {
    var value: uint32 = src.load<uint32>(pos, Endian.BE)
    return int(value)
}

fn write16(src: Slice<byte>, pos: int, value: uint16) {
    src.store<uint16>(pos, value, Endian.LE)
}

fn writeI16(src: Slice<byte>, pos: int, value: int16) {
    src.store<int16>(pos, value, Endian.LE)
}

fn writeF32(src: Slice<byte>, pos: int, value: float32) {
    src.store<float32>(pos, value, Endian.LE)
}

var bytes = Array<byte>(16, 0)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4
bytes[4] = 5
bytes[5] = 6
bytes[6] = 7
bytes[7] = 8
print(read16(bytes[:], 0))
print(read32(bytes[:], 0))
print(read64(bytes[:], 0))
print(readI16(bytes[:], 0))
print(readI32(bytes[:], 0))
print(readF32(bytes[:], 0))
print(readF64(bytes[:], 0))
print(read32BE(bytes[:], 0))
write16(bytes[:], 0, 0x1234)
writeI16(bytes[:], 2, -3)
writeF32(bytes[:], 4, 1.25)
