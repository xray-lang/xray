fn sum_bytes(src: ByteSpan) -> int {
    var total = 0
    var i = 0
    while (i < src.length) {
        total = total + int(src[i])
        i = i + 1
    }
    return total
}

var bytes = Bytes(4)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4

var view: ByteSpan = bytes[1:4]
print(sum_bytes(view))
