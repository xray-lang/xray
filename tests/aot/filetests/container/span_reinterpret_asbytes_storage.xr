fn views(words: Slice<u32>, raw: Slice<u8>) -> i64 {
    var bytes: Slice<u8> = words.asBytes()
    var pairs: Slice<u16> = raw.reinterpret<u16>()
    return len(bytes) + len(pairs)
}

fn roundtrip(words: Slice<u32>) -> i64 {
    var bytes: Slice<u8> = words.asBytes()
    var words_again: Slice<u32> = bytes.reinterpret<u32>()
    return len(words_again)
}

var words = Array<u32>(4, 0)
var raw = Array<u8>(8, 0)
print(views(words[:], raw[:]))
print(roundtrip(words[:]))
