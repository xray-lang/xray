fn byte_slice_counted_guard_bounds(bytes: Slice<u8>) -> u32 {
    var offset = 0
    var total: u32 = 0
    while (offset <= len(bytes) - 16) {
        total += bytes.load<u32>(offset, Endian.LE)
        total += bytes.load<u32>(offset + 12, Endian.LE)
        offset += 16
    }
    return total
}

fn byte_slice_chained_tail_bounds(bytes: Slice<u8>) -> u64 {
    var offset = 0
    var total: u64 = 0
    while (offset <= len(bytes) - 8) {
        total += bytes.load<u64>(offset, Endian.LE)
        offset += 8
    }
    while (offset <= len(bytes) - 4) {
        var lane: u64 = bytes.load<u32>(offset, Endian.LE)
        total += lane
        offset += 4
    }
    while (offset < len(bytes)) {
        var lane: u64 = bytes[offset]
        total += lane
        offset += 1
    }
    return total
}

var countedBytes = Array<u8>(32, 0)
print(byte_slice_counted_guard_bounds(countedBytes[:]))
print(byte_slice_chained_tail_bounds(countedBytes[:]))
