fn roundtrip(words: Slice<uint32>) -> int {
    var bytes: Slice<byte> = words.asBytes()
    var words_again: Slice<uint32> = bytes.reinterpret<uint32>()
    return len(words_again)
}

fn rawBytes(raw: Slice<byte>) -> int {
    var bytes_again: Slice<byte> = raw.reinterpret<byte>()
    return len(bytes_again)
}
