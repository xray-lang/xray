fn roundtrip(words: Span<uint32>) -> int {
    var bytes: ByteSpan = words.asBytes()
    var words_again: Span<uint32> = bytes.reinterpret<uint32>()
    return words_again.length
}

fn rawBytes(raw: ByteSpan) -> int {
    var bytes_again: Span<uint8> = raw.reinterpret<uint8>()
    return bytes_again.length
}
