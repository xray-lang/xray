fn buildBytes(src: Bytes) -> Bytes {
    var out = Bytes.withCapacity(12)
    out.appendFrom(src[1:4])
    out.repeatFrom(2, 4)
    return out
}

var src = Bytes(6)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40
src[4] = 50
src[5] = 60

var out = buildBytes(src)
print(out.length)
print(out[0])
print(out[6])
