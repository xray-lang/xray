struct CounterState {
    value: i64
    limit: i64
}

union FlagBits {
    i: i32
    u: u32
}

struct DeviceState {
    bits: FlagBits
    count: i64
}

var STATE = CounterState{value: 1, limit: 10}
var DEVICE = DeviceState{bits: FlagBits{u: 7}, count: 3}

fn xray_top_var_aggregate_static() -> i64 {
    STATE.value = STATE.value + 2
    DEVICE.count = DEVICE.count + (unsafe { DEVICE.bits.u } as i64)
    return STATE.value + STATE.limit + DEVICE.count
}
