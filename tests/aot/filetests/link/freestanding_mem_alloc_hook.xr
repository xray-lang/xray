import mem

fn xray_alloc_hook_score(n: i64) -> i64 {
    var a = mem.alloc(16)
    var s: Slice<u8> = a.asMutBytes()
    s[0] = 7

    var z = mem.allocZeroed(8)
    var zs: Slice<u8> = z.asBytes()

    var aligned = mem.allocAligned(32, 16)
    if (!aligned.resize(64)) {
        return -1
    }
    var p = unsafe { aligned.borrowPtr() }
    mem.set(p, 3, 64)

    return n + len(a) + len(z) + len(aligned) + (s[0] as i64) + (zs[0] as i64)
}
