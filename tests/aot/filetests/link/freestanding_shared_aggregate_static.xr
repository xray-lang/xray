struct Pair {
    left: i64
    right: i64
}

union I32Bits {
    i: i32
    u: u32
}

struct Holder {
    bits: I32Bits
    base: i64
}

const PAIR = Pair{left: 1, right: 2}
const HOLDER = Holder{bits: I32Bits{u: 33}, base: 4}

fn xray_shared_aggregate_static() -> i64 {
    return PAIR.left + PAIR.right + (unsafe { HOLDER.bits.u } as i64) + HOLDER.base
}
