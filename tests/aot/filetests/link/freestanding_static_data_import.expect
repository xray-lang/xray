args=--profile freestanding
contains=xaot-plan v0
contains="runtime_caps": []
c_contains=#include "xrt_core_freestanding.h"

# Link-mode expectations normalize the stable module hash and then verify the namespace.
c_contains=xray_const__freestanding_static_data_lib_MAGIC
c_contains=xray_const__freestanding_static_data_lib_HEADER
c_contains=extern const int64_t xray_const__freestanding_static_data_lib_MAGIC
c_contains=extern const struct { int64_t magic; int64_t flags; } xray_const__freestanding_static_data_lib_HEADER

# Scalar, fixed-array, matrix, cube and string-bearing globals stay native.
c_contains=const int64_t xray_const__freestanding_static_data_lib_TABLE[4]
c_regex=const uint8_t xray_const__freestanding_static_data_lib_MATRIX\[2\]\[4\].*XRT_ATTR_SECTION\("__DATA,.xr_imatrix"\).*XRT_ATTR_WEAK.*XRT_ATTR_USED
c_regex=const int64_t xray_const__freestanding_static_data_lib_CUBE\[2\]\[2\]\[2\].*XRT_ATTR_SECTION\("__DATA,.xr_icube"\).*XRT_ATTR_WEAK.*XRT_ATTR_USED
c_contains=const XrValue xray_const__freestanding_static_data_lib_LABEL_MATRIX[2][2]
c_contains=const XrValue xray_const__freestanding_static_data_lib_LABEL_CUBE[2][2][2]
c_contains=const xrt_str_t xray_const__freestanding_static_data_lib_LABEL

# Struct/union fields use source names; tuple elements intentionally stay positional.
c_contains=const struct { int64_t magic; int64_t flags; }
c_contains=const struct { uint8_t bytes[4]; int64_t base; }
c_contains=const struct { struct { int64_t code; } inner; int64_t base; }
c_contains=const struct __attribute__((packed)) { uint8_t tag; uint32_t value; }
c_contains=const struct __attribute__((aligned(16))) { int32_t value; }
c_contains=const struct __attribute__((packed, aligned(16))) { uint8_t tag; uint32_t value; }
c_contains=const union { int32_t i; uint32_t u; }
c_contains=const union { uint32_t u; uint8_t b[4]; }
c_contains=const struct { union { int32_t i; uint32_t u; } bits; int64_t base; }
c_contains=const struct { union { uint32_t u; uint8_t b[4]; } word; int64_t base; }
c_contains=const struct { int64_t code; uint8_t flag; }
c_contains=const struct { uint8_t samples[4]; int64_t weight; }
c_contains=const struct { XrValue labels[2]; int64_t code; }
c_contains=const struct { struct { XrValue label; int64_t code; } inner; int64_t base; }
c_contains=const struct { int64_t f0; int64_t f1; }
c_contains=const struct { XrValue f0; int64_t f1; }

# Imported reads are direct native C accesses, including nested fields and unions.
c_contains=xray_const__freestanding_static_data_lib_TABLE[_idx]
c_contains=xray_const__freestanding_static_data_lib_MATRIX[_outer_idx][_idx]
c_contains=xray_const__freestanding_static_data_lib_CUBE[_outer_idx][_middle_idx][_idx]
c_contains=xray_const__freestanding_static_data_lib_HEADER.magic
c_contains=xray_const__freestanding_static_data_lib_HEADER.flags
c_contains=xray_const__freestanding_static_data_lib_PACKET.bytes[_idx]
c_contains=xray_const__freestanding_static_data_lib_OUTER.inner.code
c_contains=xray_const__freestanding_static_data_lib_BIT_ROWS[_idx].u
c_contains=xray_const__freestanding_static_data_lib_WORD_ROWS[_outer_idx].b[_idx]
c_contains=xray_const__freestanding_static_data_lib_BIT_HOLDER.bits.u
c_contains=xray_const__freestanding_static_data_lib_WORD_HOLDER.word.b[_idx]
c_contains=xray_const__freestanding_static_data_lib_ENTRIES[_idx].flag
c_contains=xray_const__freestanding_static_data_lib_ROWS[_outer_idx].samples[_idx]
c_contains=xray_const__freestanding_static_data_lib_LABEL_ROWS[_outer_idx].labels[_idx]
c_contains=xray_const__freestanding_static_data_lib_LABEL_GROUPS[_idx].inner.label
c_contains=xr_str_lit(&xray_const__freestanding_static_data_lib_LABEL)

c_contains=xray_imported_static_sum
c_contains=xray_imported_static_strings
c_contains=xrt_println
c_not_contains=xrt_getprop_name
c_not_contains=xrt_mem_addr
c_not_contains=xr_array_ref
c_not_contains=xr_aggregate_ref
c_not_contains=xrt_map_get_owned
c_not_contains=xrt_tuple_get
c_not_contains=xrt_tuple_make
c_not_contains=xrt_tuple_new
c_not_contains=xrt_index_get
c_not_contains=_xctarr__freestanding_static_data_lib_
not_contains=xray_core
