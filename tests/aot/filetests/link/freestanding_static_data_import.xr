import { MAGIC, OFFSET, TABLE, BYTES, MATRIX, CUBE, HEADER, PACKET, OUTER, GROUPS, PACKED, ALIGNED, PACKED_ALIGNED, PAIR, PAIR_ROWS, NESTED, NESTED_LABEL, BITS, WORD_BYTES, BIT_ROWS, WORD_ROWS, BIT_HOLDER, BIT_GROUPS, WORD_HOLDER, WORD_GROUPS, LABEL, ADDR_ONLY_BYTES, MAYBE_NONE, LABEL_MATRIX, LABEL_CUBE, LABELS, NAMED, LABELED, LABELED_ROWS, ENTRIES, ROWS, LABEL_ROWS, LABEL_GROUPS, PLAIN_HEADER, PLAIN_PAIR, PLAIN_BYTES, PLAIN_MATRIX, PLAIN_CUBE, PLAIN_BITS, PLAIN_WORD, PLAIN_LABEL, PLAIN_LABELED, PLAIN_NAMED, PLAIN_NAMED_ROWS, PLAIN_LABELS, PLAIN_LABEL_MATRIX, PLAIN_LABEL_CUBE } from "./_freestanding_static_data_lib"

fn imported_static_sum(i: i64) -> i64 {
    return MAGIC + OFFSET + TABLE[i] + (BYTES[i] as i64) + HEADER.magic + HEADER.flags +
        (PACKET.bytes[i] as i64) + PACKET.base + OUTER.inner.code + OUTER.base +
        (PACKED.tag as i64) + (PACKED.value as i64) + (ALIGNED.value as i64) +
        (PACKED_ALIGNED.tag as i64) + (PACKED_ALIGNED.value as i64) +
        PAIR.0 + PAIR.1 + PAIR_ROWS[i].0 + PAIR_ROWS[i].1 +
        NESTED.0.0 + NESTED.0.1 + NESTED.1.0 + NESTED.1.1 +
        (unsafe { BITS.u } as i64) + (unsafe { WORD_BYTES.b }[i] as i64) +
        (unsafe { BIT_ROWS[i].u } as i64) + (unsafe { WORD_ROWS[i].b }[i] as i64) +
        (unsafe { BIT_HOLDER.bits.u } as i64) + (unsafe { BIT_GROUPS[i].bits.u } as i64) +
        (unsafe { WORD_HOLDER.word.b }[i] as i64) +
        (unsafe { WORD_GROUPS[i].word.b }[i] as i64) +
        BIT_HOLDER.base + BIT_GROUPS[i].base + WORD_HOLDER.base + WORD_GROUPS[i].base +
        (MATRIX[i][i] as i64) + CUBE[i][i][i] + ENTRIES[i].code +
        (ENTRIES[i].flag ? 1 : 0) +
        (ROWS[i].samples[i] as i64) + ROWS[i].weight + GROUPS[i].inner.code +
        GROUPS[i].base + PLAIN_HEADER.magic + PLAIN_HEADER.flags +
        PLAIN_PAIR.0 + PLAIN_PAIR.1 + (PLAIN_BYTES[i] as i64) +
        (PLAIN_MATRIX[i][i] as i64) + PLAIN_CUBE[i][i][i] +
        (unsafe { PLAIN_BITS.u } as i64) + (unsafe { PLAIN_WORD.b }[i] as i64)
}

fn imported_static_strings(i: i64) -> i64 {
    print(LABEL)
    print(LABEL_MATRIX[i][i])
    print(LABEL_CUBE[i][i][i])
    print(LABELS[i])
    print(NAMED.label)
    print(LABELED.0)
    print(NESTED_LABEL.0.1)
    print(NESTED_LABEL.1.0)
    print(LABELED_ROWS[i].0)
    print(LABEL_ROWS[i].labels[i])
    print(LABEL_GROUPS[i].inner.label)
    print(PLAIN_LABEL)
    print(PLAIN_LABELED.0)
    print(PLAIN_NAMED.label)
    print(PLAIN_NAMED_ROWS[i].label)
    print(PLAIN_LABELS[i])
    print(PLAIN_LABEL_MATRIX[i][i])
    print(PLAIN_LABEL_CUBE[i][i][i])
    return NAMED.code + LABELED.1 + NESTED_LABEL.0.0 + NESTED_LABEL.1.1 +
        LABELED_ROWS[i].1 + LABEL_ROWS[i].code + LABEL_GROUPS[i].inner.code +
        LABEL_GROUPS[i].base + PLAIN_LABELED.1 + PLAIN_NAMED.code + PLAIN_NAMED_ROWS[i].code
}
