import mem
import { MAGIC, OFFSET, TABLE, BYTES, MATRIX, CUBE, HEADER, PACKET, OUTER, GROUPS, PACKED, ALIGNED, PACKED_ALIGNED, PAIR, PAIR_ROWS, NESTED, NESTED_LABEL, BITS, WORD_BYTES, BIT_ROWS, WORD_ROWS, BIT_HOLDER, BIT_GROUPS, WORD_HOLDER, WORD_GROUPS, LABEL, ADDR_ONLY_BYTES, LABEL_MATRIX, LABEL_CUBE, LABELS, NAMED, LABELED, LABELED_ROWS, ENTRIES, ROWS, LABEL_ROWS, LABEL_GROUPS } from "./_freestanding_static_data_lib"

@c_export("xray_imported_static_sum")
fn imported_static_sum(i: int) -> int {
    return MAGIC + OFFSET + TABLE[i] + (BYTES[i] as int) + HEADER.magic + HEADER.flags +
        (PACKET.bytes[i] as int) + PACKET.base + OUTER.inner.code + OUTER.base +
        (PACKED.tag as int) + (PACKED.value as int) + (ALIGNED.value as int) +
        (PACKED_ALIGNED.tag as int) + (PACKED_ALIGNED.value as int) +
        PAIR.0 + PAIR.1 + PAIR_ROWS[i].0 + PAIR_ROWS[i].1 +
        NESTED.0.0 + NESTED.0.1 + NESTED.1.0 + NESTED.1.1 +
        (unsafe { BITS.u } as int) + (unsafe { WORD_BYTES.b }[i] as int) +
        (unsafe { BIT_ROWS[i].u } as int) + (unsafe { WORD_ROWS[i].b }[i] as int) +
        (unsafe { BIT_HOLDER.bits.u } as int) + (unsafe { BIT_GROUPS[i].bits.u } as int) +
        (unsafe { WORD_HOLDER.word.b }[i] as int) +
        (unsafe { WORD_GROUPS[i].word.b }[i] as int) +
        BIT_HOLDER.base + BIT_GROUPS[i].base + WORD_HOLDER.base + WORD_GROUPS[i].base +
        (MATRIX[i][i] as int) + CUBE[i][i][i] + ENTRIES[i].code + (ENTRIES[i].flag as int) +
        (ROWS[i].samples[i] as int) + ROWS[i].weight + GROUPS[i].inner.code +
        GROUPS[i].base
}

@c_export("xray_imported_static_strings")
fn imported_static_strings(i: int) -> int {
    print(LABEL)
    print(LABEL_MATRIX[i][i])
    print(LABEL_CUBE[i][i][i])
    print(LABELS[i])
    print(NAMED.label)
    print(LABELED.0)
    print(NESTED_LABEL.0.1)
    print(NESTED_LABEL.1.0)
    print(LABELED_ROWS[i].0)
    print(LABEL_ROWS[i].labels[i])
    print(LABEL_GROUPS[i].inner.label)
    return NAMED.code + LABELED.1 + NESTED_LABEL.0.0 + NESTED_LABEL.1.1 +
        LABELED_ROWS[i].1 + LABEL_ROWS[i].code + LABEL_GROUPS[i].inner.code +
        LABEL_GROUPS[i].base
}

@c_export("xray_imported_static_addr")
fn imported_static_addr() -> int {
    return mem.addressOf(RawPtr<int>.of(MAGIC)) +
        mem.addressOf(RawPtr<[int; 4]>.of(TABLE)) +
        mem.addressOf(RawPtr<[uint8; 4]>.of(BYTES)) +
        mem.addressOf(RawPtr<string>.of(LABEL)) +
        mem.addressOf(RawPtr<Header>.of(HEADER)) +
        mem.addressOf(RawPtr<I32Bits>.of(BITS)) +
        mem.addressOf(RawPtr<[uint8; 2]>.of(ADDR_ONLY_BYTES))
}
