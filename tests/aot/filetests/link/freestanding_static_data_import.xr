import { MAGIC, OFFSET, TABLE, BYTES, MATRIX, CUBE, HEADER, PACKET, OUTER, GROUPS, PACKED, ALIGNED, PACKED_ALIGNED, PAIR, NESTED, BITS, WORD_BYTES, LABEL, LABEL_MATRIX, LABELS, NAMED, LABELED, ENTRIES, ROWS, LABEL_ROWS } from "./_freestanding_static_data_lib"

@c_export("xray_imported_static_sum")
fn imported_static_sum(i: int) -> int {
    return MAGIC + OFFSET + TABLE[i] + (BYTES[i] as int) + HEADER.magic + HEADER.flags +
        (PACKET.bytes[i] as int) + PACKET.base + OUTER.inner.code + OUTER.base +
        (PACKED.tag as int) + (PACKED.value as int) + (ALIGNED.value as int) +
        (PACKED_ALIGNED.tag as int) + (PACKED_ALIGNED.value as int) +
        PAIR.0 + PAIR.1 + NESTED.0.0 + NESTED.0.1 + NESTED.1.0 + NESTED.1.1 +
        (unsafe { BITS.u } as int) + (unsafe { WORD_BYTES.b }[i] as int) +
        (MATRIX[i][i] as int) + CUBE[i][i][i] + ENTRIES[i].code + (ENTRIES[i].flag as int) +
        (ROWS[i].samples[i] as int) + ROWS[i].weight + GROUPS[i].inner.code +
        GROUPS[i].base
}

@c_export("xray_imported_static_strings")
fn imported_static_strings(i: int) -> int {
    print(LABEL)
    print(LABEL_MATRIX[i][i])
    print(LABELS[i])
    print(NAMED.label)
    print(LABELED.0)
    print(LABEL_ROWS[i].labels[i])
    return NAMED.code + LABELED.1 + LABEL_ROWS[i].code
}
