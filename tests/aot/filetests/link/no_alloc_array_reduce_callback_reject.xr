fn xray_no_alloc_array_reduce_allocating_callback(acc: i64, value: i64) -> i64 {
    var scratch: Array<i64> = []
    scratch.push(value)
    return acc + value + len(scratch)
}

fn xray_no_alloc_array_reduce_callback_reject(values: Array<i64>) -> i64 {
    return values.reduce(xray_no_alloc_array_reduce_allocating_callback, 0)
}

var xray_no_alloc_array_reduce_values: Array<i64> = [1, 2, 3]
print(xray_no_alloc_array_reduce_callback_reject(xray_no_alloc_array_reduce_values))
