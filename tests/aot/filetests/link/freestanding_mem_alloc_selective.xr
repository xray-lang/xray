import mem
import { allocZeroed } from mem

fn xray_alloc_selective_score(n: i64) -> i64 {
    var b = allocZeroed(n)
    unsafe {
        mem.withSliceMut<u8>(b.borrowPtr(), len(b), ref b,
            fn(view: ref Slice<u8>) {
                if (len(view) > 0) {
                    view[0] = 5
                }
            })
    }
    return len(b)
}
