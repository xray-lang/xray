@no_alloc
fn xray_no_alloc_bytes_constructor_reject() -> Bytes {
    return Bytes(4)
}

@no_alloc
fn xray_no_alloc_map_literal_reject() -> Map<string, int> {
    return #{"a": 1}
}

@no_alloc
fn xray_no_alloc_set_literal_reject() -> Set<int> {
    return #[1, 2]
}

@no_alloc
fn xray_no_alloc_json_literal_reject() -> Json {
    return { answer: 42 }
}

@no_alloc
fn xray_no_alloc_copy_builtin_reject(values: Array<int>) -> Array<int> {
    return copy(values)
}

@no_alloc
fn xray_no_alloc_atomic_constructor_reject() -> Atomic<int> {
    return Atomic(1)
}

var xray_no_alloc_copy_source: Array<int> = [1, 2, 3]

print(xray_no_alloc_bytes_constructor_reject().length)
print(xray_no_alloc_map_literal_reject().length)
print(xray_no_alloc_set_literal_reject().length)
print(Json.size(xray_no_alloc_json_literal_reject()))
print(xray_no_alloc_copy_builtin_reject(xray_no_alloc_copy_source).length)
print(xray_no_alloc_atomic_constructor_reject().load(Ordering.Relaxed))
