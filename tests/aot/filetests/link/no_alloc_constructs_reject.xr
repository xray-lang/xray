fn xray_no_alloc_byte_array_constructor_reject() -> Array<byte> {
    return Array<byte>(4)
}

fn xray_no_alloc_map_literal_reject() -> Map<string, int> {
    return #{"a": 1}
}

fn xray_no_alloc_set_literal_reject() -> Set<int> {
    return #[1, 2]
}

fn xray_no_alloc_json_literal_reject() -> Json {
    return { answer: 42 }
}

fn xray_no_alloc_copy_builtin_reject(values: Array<int>) -> Array<int> {
    return copy(values)
}

fn xray_no_alloc_atomic_constructor_reject() -> Atomic<int> {
    return Atomic(1)
}

var xray_no_alloc_copy_source: Array<int> = [1, 2, 3]

print(len(xray_no_alloc_byte_array_constructor_reject()))
print(len(xray_no_alloc_map_literal_reject()))
print(len(xray_no_alloc_set_literal_reject()))
print(len(xray_no_alloc_json_literal_reject()))
print(len(xray_no_alloc_copy_builtin_reject(xray_no_alloc_copy_source)))
print(xray_no_alloc_atomic_constructor_reject().load(Ordering.Relaxed))
