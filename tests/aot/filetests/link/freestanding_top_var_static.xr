var COUNTER: int = 1
var ENABLED: bool = true
var SCALE: float = 0.5
var LETTER: char = 'A'
var NOTHING = null
var LABEL: string = "boot"
var OFFSET: int = -3
var DRIFT: float = -0.25
var WORD: intsize = -5
var COUNT: uintsize = 8

@c_export("xray_top_var_static")
fn xray_top_var_static() -> int {
    COUNTER = COUNTER + 2
    if (ENABLED && OFFSET == -3 && DRIFT == -0.25 && WORD == -5 && COUNT == 8) {
        return COUNTER
    }
    return 0
}
