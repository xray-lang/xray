import math
import { min, max, clamp } from "math"

@c_export("xray_math_allowlist_constants")
fn xray_math_allowlist_constants(x: float) -> float {
    return math.PI + math.E + math.TAU + math.SQRT2 + x
}

@c_export("xray_math_allowlist_max_int")
fn xray_math_allowlist_max_int() -> int {
    return math.MAX_INT
}

@c_export("xray_math_allowlist_int_core")
fn xray_math_allowlist_int_core(a: int, b: int) -> int {
    var lo = min(a, b, 5)
    var hi = max(a, b, 10)
    var c1 = clamp(a, 0, b)
    var c2 = math.clamp(b, a, 10)
    return lo + hi + c1 + c2
}
