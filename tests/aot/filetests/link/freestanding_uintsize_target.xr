import mem

fn xray_uintsize_roundtrip(addr: usize) -> usize {
    var local: usize = addr
    return local + 1
}

fn xray_intsize_roundtrip(delta: isize) -> isize {
    var local: isize = delta
    return local - 1
}

fn xray_uintsize_layout() -> int {
    return mem.sizeOf<usize>() + mem.alignOf<usize>() +
        mem.sizeOf<isize>() + mem.alignOf<isize>()
}
