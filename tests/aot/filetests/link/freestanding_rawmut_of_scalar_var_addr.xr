import mem

var COUNTER = 1
var SCALE = 0.5
var ENABLED = true
var LETTER = 'A'
var ZERO: int

@c_export("xray_rawmut_of_scalar_var_addr")
fn rawmutOfScalarVarAddr() -> int {
    COUNTER = COUNTER + 1
    SCALE = SCALE + 1.0
    ENABLED = !ENABLED
    LETTER = 'B'
    ZERO = ZERO + 9
    return mem.addr(MutPtr<int>.of(COUNTER)) +
        mem.addr(MutPtr<float>.of(SCALE)) +
        mem.addr(MutPtr<bool>.of(ENABLED)) +
        mem.addr(MutPtr<rune>.of(LETTER)) +
        mem.addr(MutPtr<int>.of(ZERO)) + COUNTER + (ENABLED ? 1 : 0) +
        int(LETTER) + ZERO
}
