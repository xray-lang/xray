import os
import io
import path
import time

print(len(os.platform()) > 0)
print(len(os.arch()) > 0)
print(len(os.sep()) > 0)
print(len(os.eol()) >= 1)
print(os.getpid() > 0)
var uid = os.uid()
print(os.platform() == "windows" ? uid == null : uid != null && uid! >= 0)
var gid = os.gid()
print(os.platform() == "windows" ? gid == null : gid != null && gid! >= 0)
print(os.cpuCount() >= 1)
print(os.ppid() > 0)
print(os.kill(os.getpid(), 0))
print(os.totalMemory() > 0)
print(os.freeMemory() > 0)
print(os.uptime() >= 0.0)
var load = os.loadavg()
var hasLoad = os.platform() == "linux" || os.platform() == "darwin"
print(hasLoad ? load != null && len(load!) == 3 : load == null)
print(hasLoad ? load != null && load![0] >= 0.0 : load == null)
print(hasLoad ? load != null && load![1] >= 0.0 : load == null)
print(hasLoad ? load != null && load![2] >= 0.0 : load == null)
print(time.clock() >= 0)
print(os.getenv("XRAY_TEST_NONEXISTENT_VAR_12345") == null)
print(os.setenv("XRAY_AOT_OS_QUERY_TMP", "hello-aot"))
print(os.getenv("XRAY_AOT_OS_QUERY_TMP") == "hello-aot")
print(os.unsetenv("XRAY_AOT_OS_QUERY_TMP"))
print(os.getenv("XRAY_AOT_OS_QUERY_TMP") == null)
print(os.setenv("XRAY_AOT_OS_QUERY_ENV", "map-aot"))
var env = os.environ()
print(env["XRAY_AOT_OS_QUERY_ENV"] == "map-aot")
print(os.unsetenv("XRAY_AOT_OS_QUERY_ENV"))
var cwd = os.getcwd()
print(len(cwd) > 0)
print(io.chdir(path.from(cwd)))
print(os.getcwd() == cwd)
print(len(os.hostname()) > 0)
print(len(os.tmpdir()) > 0)
print(os.username() != null)
print(os.homedir() != null)
