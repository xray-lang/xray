struct CounterState {
    value: int
    limit: int
}

var STATE = CounterState{value: 1, limit: 10}

var TICKS = 3

fn xrayTopVarWeakStatic(flag: int) -> int {
    if (flag != 0) {
        STATE.value = STATE.value + 2
        TICKS = TICKS + flag
    }
    return STATE.value + STATE.limit + TICKS
}
