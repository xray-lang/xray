struct CPoint {
    x: i32
    y: i32
}

struct CBox {
    p: CPoint
    tag: byte
}

fn makePoint() -> CPoint {
    return CPoint{x: 10, y: 20}
}

var p = makePoint()
p.x = p.x + 2
var q = CPoint{x: 12, y: 20}
print(p.x)
print(p.y)
print(p == q)

var b = CBox{p: CPoint{x: 1, y: 2}, tag: 3}
b.p.x = b.p.x + b.tag
print(b.p.x)
print(b.p.y)
print(b.tag)
