fn xray_map_reject() -> int {
    var m = #{"a": 1}
    return 0
}

fn xray_set_reject() -> int {
    var s = #[1, 2]
    return 0
}

fn xray_object_reject() -> int {
    var obj = { answer: 42 }
    return 0
}

fn xray_regex_reject() -> int {
    var re = /abc/
    return 0
}

fn xray_bigint_reject() -> int {
    var b = 123n
    return 0
}

fn xray_closure_reject() -> int {
    var f = fn() -> int { return 1 }
    return f()
}

fn xray_string_concat_reject() -> int {
    var s = "a" + "b"
    print(s)
    return 0
}

class HeapBacked {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

fn xray_class_reject() -> int {
    var c = HeapBacked(1)
    return c.value
}
