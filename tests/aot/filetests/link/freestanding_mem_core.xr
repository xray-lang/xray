import mem
import codegen

struct XrayMemHeader {
    tag: u8
    value: u32
}

fn xray_mem_addr_roundtrip(addr: i64) -> i64 {
    var p = mem.mutPtr<u8>(addr)
    return mem.addr(p)
}

fn xray_mem_layout_constants() -> i64 {
    var size = mem.sizeOf<XrayMemHeader>()
    var align = mem.alignOf<XrayMemHeader>()
    var off = mem.offsetOf<XrayMemHeader>("value")
    return size + align + off
}

fn xray_mem_typed_from_address(addr: i64) -> i64 {
    var p = mem.mutPtr<u32>(addr)
    return mem.addr(p)
}

fn xray_mem_typed_addr_null() -> i64 {
    var p = Ptr<u32>.null()
    var q = MutPtr<u64>.null()
    return mem.addr(p) + mem.addr(q)
}

fn xray_mem_bits(x: i64, n: i64) -> i64 {
    // Bit/wrapping intrinsics are int methods (task 153); the freestanding
    // cgen lowers them straight to the shared cores already inlined in
    // xrt_core_freestanding.h, so no new undefined symbols appear.
    return x.popcount() + x.leadingZeros() + x.trailingZeros() +
        x.rotateLeft(n) + x.rotateRight(n) + x.wrappingAdd(n) +
        x.wrappingSub(n) + x.wrappingMul(n)
}

fn xray_codegen_fenced_opaque(value: u64) -> u64 {
    var hidden = codegen.opaque(value)
    codegen.compilerFence()
    return hidden
}

fn xray_codegen_opaque(value: u64) -> u64 {
    return codegen.opaque(value)
}

fn xray_mem_bulk(dst: i64, src: i64, n: i64) -> i64 {
    var d = mem.mutPtr<u8>(dst)
    var s = mem.mutPtr<u8>(src)
    mem.copy(d, s, n)
    mem.move(d, s, n)
    mem.set(d, 0, n)
    return mem.compare(d, s, n)
}

fn xray_mem_mmio_shape(addr: i64) -> i64 {
    var p = mem.mutPtr<u8>(addr)
    mem.prefetch(p, 1)
    mem.cacheFlush(p, 64)
    mem.cacheInvalidate(p, 64)
    mem.nontemporalStore(p, 0x55aa55aa, 4)
    mem.volatileStore(p, 305419896, 4)
    mem.fence(4)
    return mem.volatileLoad(p, 4) + mem.cacheLineSize()
}
