fn xray_no_alloc_json_scalar_methods_ok(value: JSON.Object) -> int {
    var score = len(value)
    if (value.containsKey("answer")) {
        score = score + 10
    }
    if (value.containsKey("label")) {
        score = score + 20
    }
    if (len(value) != 0) {
        score = score + 30
    }
    if (value.get("answer") == 42) {
        score = score + 40
    }
    return score
}

var xray_no_alloc_json_scalar_methods_value: JSON.Object =
    JSON.parseObject("{\"answer\":42,\"label\":\"edge\"}")
print(xray_no_alloc_json_scalar_methods_ok(xray_no_alloc_json_scalar_methods_value))
