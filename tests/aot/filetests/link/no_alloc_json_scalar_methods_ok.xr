fn xray_no_alloc_json_scalar_methods_ok(value: Json) -> int {
    var score = len(value)
    if (Json.containsKey(value, "answer")) {
        score = score + 10
    }
    if (Json.containsKey(value, "label")) {
        score = score + 20
    }
    if (len(value) != 0) {
        score = score + 30
    }
    if (Json.get(value, "answer", 0) == 42) {
        score = score + 40
    }
    return score
}

var xray_no_alloc_json_scalar_methods_value: Json = { answer: 42, label: "edge" }
print(xray_no_alloc_json_scalar_methods_ok(xray_no_alloc_json_scalar_methods_value))
