import encoding
import { LE as directLE, BE as directBE } from "encoding"

print(encoding.hexEncode("Hello"))
let decoded = encoding.hexDecode("48656c6c6f")
if (decoded != null) {
    print(decoded.length)
    print(decoded[0])
    print(decoded[4])
}
print(encoding.hexDecodeString("48656C6C6F"))
print(encoding.hexDecode("gg") == null)
print(encoding.hexDecode("abc") == null)
let empty = encoding.hexDecode("")
if (empty != null) {
    print(empty.length)
}
print(encoding.hexValid("48656c6c6f"))
print(encoding.hexValid("abc"))
print(encoding.utf8Valid("hello"))
print(encoding.utf8Count("你好"))
print(encoding.utf8ByteLength("你好"))
print(encoding.LE)
print(encoding.BE)
print(directLE)
print(directBE)

let u16le = encoding.utf16Encode("AB")
print(u16le.length)
print(u16le[0])
print(u16le[1])
print(u16le[2])
print(u16le[3])
print(encoding.utf16Decode(u16le))

let u16be = encoding.utf16Encode("AB", encoding.BE)
print(u16be[0])
print(u16be[1])
print(encoding.utf16Decode(u16be, encoding.BE))
print(encoding.utf16Decode(u16be, encoding.BE, false))

let bom = Bytes(4)
bom[0] = 254
bom[1] = 255
bom[2] = 0
bom[3] = 65
print(encoding.utf16Decode(bom))
print(encoding.utf16Decode(bom, encoding.BE, false) == "A")
print(encoding.utf16Decode(Bytes(1)) == null)
