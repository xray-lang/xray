import encoding
import { HexError } from encoding
import { LE as directLE, BE as directBE } from "encoding"

fn hexEncodeText(data: string) -> string {
    var view: Slice<byte> = data.bytes()
    return encoding.hexEncode(view)
}

fn hexDecodeText(hex: string) -> string {
    var bytes = encoding.hexDecode(hex)
    return string.fromUtf8(bytes[:])!
}

fn hexDecodeFails(hex: string) -> bool {
    try {
        var bytes = encoding.hexDecode(hex)
        return len(bytes) < 0
    } catch (e: HexError) {
        return true
    }
}

print(hexEncodeText("Hello"))
var decoded = encoding.hexDecode("48656c6c6f")
print(len(decoded))
print(decoded[0])
print(decoded[4])
print(hexDecodeText("48656C6C6F"))
print(hexDecodeFails("gg"))
print(hexDecodeFails("abc"))
var empty = encoding.hexDecode("")
print(len(empty))
print(encoding.hexValid("48656c6c6f"))
print(encoding.hexValid("abc"))
print(encoding.utf8Valid("hello"))
print(encoding.utf8Count("你好"))
print(encoding.utf8ByteLength("你好"))
print(encoding.LE)
print(encoding.BE)
print(directLE)
print(directBE)

var u16le = encoding.utf16Encode("AB")
print(len(u16le))
print(u16le[0])
print(u16le[1])
print(u16le[2])
print(u16le[3])
print(encoding.utf16Decode(u16le))

var u16be = encoding.utf16Encode("AB", encoding.BE)
print(u16be[0])
print(u16be[1])
print(encoding.utf16Decode(u16be, encoding.BE))
print(encoding.utf16Decode(u16be, encoding.BE, false))

var bom = Array<byte>(4)
bom[0] = 254
bom[1] = 255
bom[2] = 0
bom[3] = 65
print(encoding.utf16Decode(bom))
print(encoding.utf16Decode(bom, encoding.BE, false) == "A")
print(encoding.utf16Decode(Array<byte>(1)) == null)
