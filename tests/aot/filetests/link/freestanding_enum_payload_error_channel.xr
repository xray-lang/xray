enum FsErr {
    Bad(int)
}

struct Pair {
    left: int
    right: int
}

fn mayFail(n: int) -> Pair {
    if (n == 0) {
        throw FsErr.Bad(7)
    }
    return Pair{left: n, right: n + 1}
}

fn xray_enum_payload_error(n: int) -> int {
    var out = 0
    try {
        var pair = mayFail(n)
        out = pair.left + pair.right
    } catch (e: FsErr) {
        match (e) {
            FsErr.Bad(code) -> {
                out = 0 - code
            }
        }
    }
    return out
}
