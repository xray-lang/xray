enum FsErr {
    Bad { code: i64 }
}

struct Pair {
    left: i64
    right: i64
}

fn mayFail(n: i64) -> Pair {
    if (n == 0) {
        throw FsErr.Bad { code: 7 }
    }
    return Pair{left: n, right: n + 1}
}

fn xray_enum_payload_error(n: i64) -> i64 {
    var out = 0
    try {
        var pair = mayFail(n)
        out = pair.left + pair.right
    } catch (e: FsErr) {
        match (e) {
            FsErr.Bad { code } -> {
                out = 0 - code
            }
        }
    }
    return out
}
