import os

fn xray_no_alloc_os_loadavg_reject() -> i64 {
    var samples = os.loadavg()
    if (samples == null) { return 0 }
    return len(samples!)
}

fn xray_no_alloc_os_environ_reject() -> i64 {
    return len(os.environ())
}

print(xray_no_alloc_os_loadavg_reject())
print(xray_no_alloc_os_environ_reject())
