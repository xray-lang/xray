fn publish_len() -> int {
    var bytes = Array<byte>(3, 0)
    bytes[0] = 1
    bytes[1] = 2
    bytes[2] = 3

    const frozen = move bytes
    return len(frozen)
}

fn publish_grouped_len() -> int {
    var bytes = Array<byte>(2, 0)
    bytes[0] = 4
    bytes[1] = 5

    const frozen = (move bytes)
    return len(frozen)
}

fn publish_cast_len() -> int {
    var bytes = Array<byte>(2, 0)
    bytes[0] = 6
    bytes[1] = 7

    const frozen = move bytes as Array<byte>
    return len(frozen)
}

print(publish_len() + publish_grouped_len() + publish_cast_len())
