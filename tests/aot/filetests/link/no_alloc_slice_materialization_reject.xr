fn xray_no_alloc_view_slice_reject(values: Array<i64>) -> const Slice<i64> {
    var view: Slice<i64> = values[0:2]
    return view
}

fn xray_no_alloc_span_slice_ok(values: Array<i64>) -> i64 {
    var view: Slice<i64> = values[0:3]
    var tail: Slice<i64> = view[1:3]
    return tail[0]
}

var xray_no_alloc_slice_values: Array<i64> = [1, 2, 3, 4]

print(len(xray_no_alloc_view_slice_reject(xray_no_alloc_slice_values)))
print(xray_no_alloc_span_slice_ok(xray_no_alloc_slice_values))
