@no_alloc
fn xray_no_alloc_string_slice_syntax_reject(value: string) -> string {
    return value[0:1]
}

@no_alloc
fn xray_no_alloc_view_slice_reject(values: Array<int>) -> Slice<int> {
    var view: Slice<int> = values[0:2]
    return view
}

@no_alloc
fn xray_no_alloc_span_slice_ok(values: Array<int>) -> int {
    var view: Slice<int> = values[0:3]
    var tail: Slice<int> = view[1:3]
    return tail[0]
}

var xray_no_alloc_slice_values: Array<int> = [1, 2, 3, 4]

print(xray_no_alloc_string_slice_syntax_reject("alpha"))
print(len(xray_no_alloc_view_slice_reject(xray_no_alloc_slice_values)))
print(xray_no_alloc_span_slice_ok(xray_no_alloc_slice_values))
