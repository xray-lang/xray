class Registry {
    scores: Map<i64, i64>
    seen: Set<i64>

    constructor(scores: Map<i64, i64>, seen: Set<i64>) {
        this.scores = scores
        this.seen = seen
    }

    mark(key: i64, value: i64) -> i64 {
        this.scores.set(key, value)
        this.seen.add(key)
        if (this.seen.contains(key)) {
            return this.scores.get(key) ?? 0
        }
        return 0
    }

    replace(scores: Map<i64, i64>, seen: Set<i64>) {
        this.scores = scores
        this.seen = seen
    }
}

var firstScores: Map<i64, i64> = #{}
var firstSeen: Set<i64> = #[]
var registry = Registry(firstScores, firstSeen)
print(registry.mark(7, 11))

var secondScores: Map<i64, i64> = #{}
var secondSeen: Set<i64> = #[]
registry.replace(secondScores, secondSeen)
print(registry.mark(3, 21))
