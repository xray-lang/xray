fn xray_no_alloc_array_find_allocating_callback(value: int) -> bool {
    var scratch: Array<int> = []
    scratch.push(value)
    return len(scratch) > 0
}

@no_alloc
fn xray_no_alloc_array_find_callback_reject(values: Array<int>) -> int? {
    return values.find(xray_no_alloc_array_find_allocating_callback)
}

var xray_no_alloc_array_find_values: Array<int> = [1, 2, 3]
print(xray_no_alloc_array_find_callback_reject(xray_no_alloc_array_find_values))
