import regex

print(regex.escape("a.b*c?"))
print(regex.escape("plain"))
print(regex.escape("x+y"))
print(regex.escape("[abc]"))
print(regex.isValid("\\d+"))
print(regex.isValid("["))
let digits = regex.compile("\\d+")
print(regex.test(digits, "abc123"))
print(regex.test(digits, "abc"))
print(regex.count(digits, "a1 b22 c333"))
let hello = regex.compile("hello", "i")
print(regex.test(hello, "HELLO"))
print(regex.count(hello, "hello HELLO nope"))
