fn touch(xs: ref Array<int>, b: ref Array<byte>, s: string, span: Slice<byte>,
         sb: ref StringBuilder) -> int {
    xs.push(1)
    var first = xs[0]
    var part: Slice<int> = xs[0:1]
    var n = len(xs)
    b.appendFrom(span)
    b.fill(0)
    var text = b.toString()
    var decoded = string.fromUtf8(b[:])
    var bytes = s.copyBytes()
    sb.append(text)
    sb.append(decoded)
    var built = sb.toString()
    return n + first + len(built)
}
