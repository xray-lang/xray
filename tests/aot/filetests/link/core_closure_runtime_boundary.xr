fn direct_score(delta: i64) -> i64 {
    fn add(x: i64) -> i64 {
        var acc = x
        var i = 0
        while (i < 4) {
            acc = acc + delta + i
            i = i + 1
        }
        return acc
    }

    return add(5)
}

fn cell_score() -> i64 {
    var n = 0

    fn inc(step: i64) -> i64 {
        n = n + step
        return n
    }

    var a = inc(2)
    var b = inc(3)
    return a * 10 + b
}

print(direct_score(7))
print(cell_score())
