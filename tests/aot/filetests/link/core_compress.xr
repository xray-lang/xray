import compress

fn compressionInvalidData(body: () -> ()) -> bool {
    try {
        body()
        return false
    } catch (e: CompressionError) {
        return match (e) {
            CompressionError.InvalidData -> true
        }
    }
}

print(compress.crc32("123456789"))
print(compress.crc32(""))
print(compress.crc32("Hello"))
print(compress.adler32("Wikipedia"))
print(compress.adler32(""))
print(compress.adler32("Hello"))

var sample = "Hello, World! This is a test string for compression."
var gz = compress.gzip(sample) ?? ""
print(compress.isGzip(gz))
print(compress.gunzip(gz) == sample)
var gz0 = compress.gzip(sample, 0) ?? ""
print(compress.gunzip(gz0) == sample)

var deflated = compress.deflate(sample) ?? ""
print(compress.inflate(deflated) == sample)
var deflated9 = compress.deflate(sample, 9) ?? ""
print(compress.inflate(deflated9) == sample)

var zlibbed = compress.zlibCompress(sample) ?? ""
print(compress.isZlib(zlibbed))
print(compress.zlibDecompress(zlibbed) == sample)
var zlib0 = compress.zlibCompress(sample, 0) ?? ""
print(compress.zlibDecompress(zlib0) == sample)

print(compress.isGzip("not gzip"))
print(compress.isZlib("not zlib"))
print(compressionInvalidData(fn() { compress.gunzip("not gzip") }))
print(compressionInvalidData(fn() { compress.inflate("not deflate") }))
print(compressionInvalidData(fn() { compress.zlibDecompress("not zlib") }))
