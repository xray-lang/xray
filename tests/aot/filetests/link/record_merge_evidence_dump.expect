args=--dump-global-evidence
contains=xglobal-evidence v1 profile=native_release
contains=object-shape
contains=kind=spread
contains=kind=patch
contains=object-field
contains=object-merge
regex=object-merge [0-9]+ .*source=[1-9][0-9]*
contains=base_shape=
contains=patch_shape=
contains=result_shape=
contains=overwrites=1
contains=object-merge-plan
regex=object-merge-plan [0-9]+ .*source=[1-9][0-9]*
contains=action=copy_with_overwrite
not_contains=json-dynamic-access
