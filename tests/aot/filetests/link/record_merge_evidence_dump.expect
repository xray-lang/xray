args=--dump-global-evidence
contains=xglobal-evidence v1 profile=native_release
contains=record-shape
contains=kind=spread
contains=kind=patch
contains=record-field
contains=record-merge
regex=record-merge [0-9]+ .*source=[1-9][0-9]*
contains=base_shape=
contains=patch_shape=
contains=result_shape=
contains=overwrites=1
contains=record-merge-plan
regex=record-merge-plan [0-9]+ .*source=[1-9][0-9]*
contains=action=copy_with_overwrite
not_contains=json-access
