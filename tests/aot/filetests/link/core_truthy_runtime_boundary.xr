fn show(label: string, value: bool) {
    print(label + "=" + value.toString())
}

let emptyArray: Array<int> = []
let fullArray: Array<int> = [1]
show("empty-array-if", bool(emptyArray))
show("full-array-if", bool(fullArray))

let emptyMap: Map<string, int> = #{}
let fullMap: Map<string, int> = #{"x": 1}
show("empty-map-if", bool(emptyMap))
show("full-map-if", bool(fullMap))

let emptySet: Set<string> = #[]
let fullSet: Set<string> = #["x"]
show("empty-set-if", bool(emptySet))
show("full-set-if", bool(fullSet))

show("empty-string-bool", bool(""))
show("nonempty-string-bool", bool("x"))
show("empty-array-bool", bool(emptyArray))
show("full-array-bool", bool(fullArray))
show("empty-map-bool", bool(emptyMap))
show("full-map-bool", bool(fullMap))
show("empty-set-bool", bool(emptySet))
show("full-set-bool", bool(fullSet))
