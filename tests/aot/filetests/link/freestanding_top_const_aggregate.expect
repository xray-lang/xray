args=--profile freestanding
contains=xaot-plan v0
contains="runtime_objects": []
contains="stdlib_objects": []
contains="system_libs": []
contains="defines": ["XRT_IMPL", "XRAY_PROFILE_FREESTANDING=1"]
c_contains=#include "xrt_core_freestanding.h"

# Link-mode expectations normalize the stable module hash; data attributes remain exact.
c_contains=xray_const_freestanding_top_const_aggregate_TABLE
c_regex=const int64_t xray_const_freestanding_top_const_aggregate_TABLE\[4\].*XRT_ATTR_SECTION\("__DATA,.xray_table"\).*XRT_ATTR_WEAK.*XRT_ATTR_USED
c_regex=const uint8_t xray_const_freestanding_top_const_aggregate_MATRIX\[2\]\[4\].*XRT_ATTR_SECTION\("__DATA,.xray_matrix"\)
c_regex=const int64_t xray_const_freestanding_top_const_aggregate_CUBE\[2\]\[2\]\[2\].*XRT_ATTR_SECTION\("__DATA,.xray_cube"\)
c_contains=const XrValue xray_const_freestanding_top_const_aggregate_LABEL_MATRIX[2][2]
c_contains=const XrValue xray_const_freestanding_top_const_aggregate_LABEL_CUBE[2][2][2]

# Named aggregates use source fields; tuples remain positional.
c_contains=const struct { int64_t magic; int64_t flags; }
c_contains=const struct { uint8_t bytes[4]; int64_t base; }
c_contains=const struct { struct { int64_t code; uint8_t flag; } inner; int64_t base; }
c_contains=const struct { int64_t code; uint8_t flag; }
c_contains=const struct { uint8_t samples[4]; int64_t weight; }
c_contains=const struct { XrValue labels[2]; int64_t code; }
c_contains=const struct { struct { XrValue label; int64_t code; } inner; int64_t base; }
c_contains=const struct __attribute__((packed)) { uint8_t tag; uint32_t value; }
c_contains=const struct __attribute__((aligned(16))) { int32_t value; }
c_contains=const struct __attribute__((packed, aligned(16))) { uint8_t tag; uint32_t value; }
c_contains=const union { int32_t i; uint32_t u; }
c_contains=const union { uint32_t u; uint8_t b[4]; }
c_contains=const struct { union { int32_t i; uint32_t u; } bits; int64_t base; }
c_contains=const struct { union { uint32_t u; uint8_t b[4]; } word; int64_t base; }
c_contains=const struct { int64_t f0; int64_t f1; }
c_contains=const struct { XrValue f0; int64_t f1; }

# Runtime reads stay direct and retain nested/union/fixed-array layout.
c_contains=xray_const_freestanding_top_const_aggregate_MATRIX[_outer_idx][_idx]
c_contains=xray_const_freestanding_top_const_aggregate_CUBE[_outer_idx][_middle_idx][_idx]
c_contains=xray_const_freestanding_top_const_aggregate_HEADER.magic
c_contains=xray_const_freestanding_top_const_aggregate_PAIR_ROWS[_idx].f0
c_contains=xray_const_freestanding_top_const_aggregate_LABELED_ROWS[_idx].f0
c_contains=xray_const_freestanding_top_const_aggregate_ENTRIES[_idx].flag
c_contains=xray_const_freestanding_top_const_aggregate_ROWS[_outer_idx].samples[_idx]
c_contains=xray_const_freestanding_top_const_aggregate_LABEL_ROWS[_outer_idx].labels[_idx]
c_contains=xray_const_freestanding_top_const_aggregate_LABEL_GROUPS[_idx].inner.label
c_contains=xray_const_freestanding_top_const_aggregate_BIT_ROWS[_idx].u
c_contains=xray_const_freestanding_top_const_aggregate_WORD_ROWS[_outer_idx].b[_idx]
c_contains=xray_const_freestanding_top_const_aggregate_BIT_HOLDER.bits.u
c_contains=xray_const_freestanding_top_const_aggregate_WORD_HOLDER.word.b[_idx]

c_contains=static const uint8_t _xctarr_
c_contains=static const double _xctarr_
c_contains=static const struct
c_contains=_xctstruct_
c_contains=static const union
c_contains=_xcttuple_
c_contains=static const xrt_str_t _xstr_
c_contains=xr_str_lit(&_xstr_
c_contains=xray_top_const_plain_struct_runtime
c_not_contains=xrt_shared[
c_not_contains=xrt_mem_addr
c_not_contains=xrt_arc_alloc
c_not_contains=xr_array_ref
c_not_contains=xr_aggregate_ref
c_not_contains=xrt_map_get_owned
c_not_contains=xrt_tuple_get
c_not_contains=xrt_tuple_make
c_not_contains=xrt_tuple_new
not_contains=xray_rt_coro
not_contains=xray_core
