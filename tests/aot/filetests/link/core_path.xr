import path
import { sep as directSep, delimiter as directDelimiter } from path

print(path.sep == "/")
print(len(path.delimiter) == 1)
print(directSep == path.sep)
print(len(directDelimiter) == len(path.delimiter))
print(path.isAbsolute(path.from("/usr/local/bin")))
print(path.basename(path.from("/usr/local/bin/xray")))
print(path.dirname(path.from("/usr/local/bin/xray")).toString())
print(path.extname(path.from("archive.tar.gz")))
print(path.normalize(path.from("/usr/local/../bin/./xray")).toString())
print(path.normalize(path.from("foo/bar/../../baz")).toString())
print(path.normalize(path.from("/../foo")).toString())
print(path.normalize(path.from("")).toString())
print(path.relative(path.from("/usr/local/bin"), path.from("/usr/local/lib")).toString())
print(path.relative(path.from("/foo"), path.from("/foobar")).toString())
print(path.relative(path.from("/usr/local"), path.from("/usr/local/bin")).toString())
print(path.relative(path.from("/usr/local/bin"), path.from("/usr/local")).toString())
print(path.join(path.from("foo"), path.from("bar")).toString())
print(path.join(path.from("foo"), path.from("bar"), path.from("baz")).toString())
print(path.join(path.from("/usr"), path.from("local"), path.from("bin")).toString())
print(path.join(path.from("foo/"), path.from("bar")).toString())
print(path.join(path.from("foo"), path.from("/bar"), path.from("baz")).toString())
print(path.join(path.from("very/long/prefix/that/resets"), path.from("/x")).toString())
print(path.join().toString() == "")
print(path.join(path.from(""), path.from("x")).toString())
print(path.resolve(path.from("/foo"), path.from("bar")).toString())
print(path.resolve(path.from("/foo"), path.from("/bar"), path.from("baz")).toString())
print(path.resolve(path.from("/tmp"), path.from("../var")).toString())
print(path.resolve(path.from("/foo"), path.from("..")).toString())

var parsed = path.parse(path.from("/home/user/file.txt"))
print(parsed.root)
print(parsed.dir.toString())
print(parsed.base)
print(parsed.name)
print(parsed.ext)

var trailing = path.parse(path.from("foo.txt/"))
print(trailing.base)
print(trailing.name)
print(trailing.ext)

print(path.format(parsed).toString())
var formatted = path.parse(path.from("/home/user/file.txt"))
print(path.format(formatted).toString())
var derived = path.parse(path.from("archive.tar"))
print(path.format(derived).toString())
