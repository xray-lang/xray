import path

print(path.isAbsolute("/usr/local/bin"))
print(path.basename("/usr/local/bin/xray"))
print(path.dirname("/usr/local/bin/xray"))
print(path.extname("archive.tar.gz"))
print(path.normalize("/usr/local/../bin/./xray"))
print(path.normalize("foo/bar/../../baz"))
print(path.normalize("/../foo"))
print(path.normalize(""))
print(path.relative("/usr/local/bin", "/usr/local/lib"))
print(path.relative("/foo", "/foobar"))
print(path.relative("/usr/local", "/usr/local/bin"))
print(path.relative("/usr/local/bin", "/usr/local"))
print(path.join("foo", "bar"))
print(path.join("foo", "bar", "baz"))
print(path.join("/usr", "local", "bin"))
print(path.join("foo/", "bar"))
print(path.join("foo", "/bar", "baz"))
print(path.join("very/long/prefix/that/resets", "/x"))
print(path.join() == "")
print(path.join("", "x"))
print(path.resolve("/foo", "bar"))
print(path.resolve("/foo", "/bar", "baz"))
print(path.resolve("/tmp", "../var"))
print(path.resolve("/foo", ".."))

let parsed = path.parse("/home/user/file.txt")
print(parsed.root)
print(parsed.dir)
print(parsed.base)
print(parsed.name)
print(parsed.ext)

let trailing = path.parse("foo.txt/")
print(trailing.base)
print(trailing.name)
print(trailing.ext)

print(path.format(parsed))
let formatted = { dir: "/home/user", base: "file.txt", root: "", name: "", ext: "" }
print(path.format(formatted))
let derived = { dir: "", base: "", root: "", name: "archive", ext: ".tar" }
print(path.format(derived))
