fn xray_no_alloc_array_inplace_methods_ok(values: ref Array<i64>) -> i64 {
    values.reverse()
    values.fill(4, 1, 3)
    var first = values.shift() ?? 0
    var last = values.pop() ?? 0
    var has = values.contains(4)
    var idx = values.indexOf(4)
    values.clear()
    return first + last + idx + (has ? len(values) : 0)
}

var xray_no_alloc_array_inplace_values: Array<i64> = [3, 1, 2, 1]
print(xray_no_alloc_array_inplace_methods_ok(ref xray_no_alloc_array_inplace_values))
