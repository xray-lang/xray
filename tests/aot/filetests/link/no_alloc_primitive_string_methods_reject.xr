@no_alloc
fn xray_no_alloc_int_tostring_reject(value: int) -> string {
    return value.toString()
}

@no_alloc
fn xray_no_alloc_int_tohex_reject(value: int) -> string {
    return value.toHex()
}

@no_alloc
fn xray_no_alloc_float_tostring_reject(value: float) -> string {
    return value.toString()
}

@no_alloc
fn xray_no_alloc_bool_tostring_reject(value: bool) -> string {
    return value.toString()
}

@no_alloc
fn xray_no_alloc_char_tostring_reject(value: rune) -> string {
    return value.toString()
}

print(xray_no_alloc_int_tostring_reject(42))
print(xray_no_alloc_int_tohex_reject(255))
print(xray_no_alloc_float_tostring_reject(3.5))
print(xray_no_alloc_bool_tostring_reject(true))
print(xray_no_alloc_char_tostring_reject('x'))
