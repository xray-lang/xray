@section("__DATA,.xray_table")
@weak
@used
const TABLE: [int; 4] = comptime [2, 4, 6, 8]
const BYTES: [uint8; 4] = comptime [1, 3, 5, 7]
const WEIGHTS: [float; 3] = comptime [1.5, 2.5, 3.5]

@section("__DATA,.xray_matrix")
@weak
@used
const MATRIX: [[uint8; 4]; 2] = comptime [
    [1, 2, 3, 4],
    [5, 6, 7, 8],
]

@section("__DATA,.xray_cube")
@weak
@used
const CUBE: [[[int; 2]; 2]; 2] = comptime [
    [[1, 2], [3, 4]],
    [[5, 6], [7, 8]],
]

struct Header {
    magic: int
    flags: int
}

@section("__DATA,.xray_header")
@weak
const HEADER = comptime Header{magic: TABLE[1], flags: TABLE[3]}

struct Packet {
    bytes: [uint8; 4]
    base: int
}

const PACKET = comptime Packet{bytes: [1, 2, 3, 4], base: HEADER.flags}

struct Inner {
    code: int
    flag: bool
}

struct Outer {
    inner: Inner
    base: int
}

const OUTER = comptime Outer{inner: Inner{code: TABLE[2], flag: true}, base: PACKET.base}

@section("__DATA,.xray_groups")
@weak
@used
const GROUPS: [Outer; 2] = comptime [
    Outer{inner: Inner{code: TABLE[0], flag: true}, base: TABLE[1]},
    Outer{inner: Inner{code: TABLE[2], flag: false}, base: TABLE[3]},
]

@section("__DATA,.xray_pair")
@weak
@used
const PAIR = comptime (HEADER.magic, TABLE[2], WEIGHTS[1])
const LABEL = comptime "score"
@section("__DATA,.xray_lmat")
@weak
@used
const LABEL_MATRIX: [[string; 2]; 2] = comptime [
    ["level", LABEL],
    ["bonus", "done"],
]
const LABELED = comptime (LABEL, TABLE[0])
const NESTED = comptime ((TABLE[0], LABEL), (WEIGHTS[2], TABLE[3]))
const LABELS: [string; 2] = comptime ["level", LABEL]

struct Named {
    label: string
    code: int
}

const NAMED = comptime Named{label: LABEL, code: TABLE[1]}

struct LabelBox {
    labels: [string; 2]
    code: int
}

const LABEL_BOX = comptime LabelBox{labels: [LABEL, "bonus"], code: TABLE[2]}

struct Entry {
    code: int
    flag: bool
}

@section("__DATA,.xray_entries")
@weak
@used
const ENTRIES: [Entry; 2] = comptime [
    Entry{code: TABLE[0], flag: true},
    Entry{code: TABLE[2], flag: false},
]

struct Row {
    samples: [uint8; 4]
    weight: int
}

@section("__DATA,.xray_rows")
@weak
@used
const ROWS: [Row; 2] = comptime [
    Row{samples: [1, 2, 3, 4], weight: TABLE[0]},
    Row{samples: [5, 6, 7, 8], weight: TABLE[1]},
]

struct LabelRow {
    labels: [string; 2]
    code: int
}

@section("__DATA,.xray_label_rows")
@weak
@used
const LABEL_ROWS: [LabelRow; 2] = comptime [
    LabelRow{labels: ["hot", LABEL], code: TABLE[0]},
    LabelRow{labels: ["cold", "done"], code: TABLE[1]},
]

packed struct PackedPair {
    tag: uint8
    value: uint32
}

struct AlignedWord align(16) {
    value: int32
}

packed struct PackedAligned align(16) {
    tag: uint8
    value: uint32
}

const PACKED = comptime PackedPair{tag: 5, value: 37}
const ALIGNED = comptime AlignedWord{value: 42}
const PACKED_ALIGNED = comptime PackedAligned{tag: 6, value: 36}

union I32Bits {
    i: int32
    u: uint32
}

union U32Bytes {
    u: uint32
    b: [uint8; 4]
}

const BITS = comptime I32Bits{i: -1}
const WORD_BYTES = comptime U32Bytes{u: 0x01020304}

@c_export("xray_top_const_aggregate")
fn xray_top_const_aggregate() -> int {
    const first = comptime TABLE[0]
    const magic = comptime HEADER.magic
    const flags = comptime HEADER.flags
    return first + magic + flags
}

@c_export("xray_top_const_array_runtime")
fn xray_top_const_array_runtime(i: int) -> int {
    return TABLE[i]
}

@c_export("xray_top_const_byte_runtime")
fn xray_top_const_byte_runtime(i: int) -> int {
    return BYTES[i] as int
}

@c_export("xray_top_const_float_runtime")
fn xray_top_const_float_runtime(i: int) -> float {
    return WEIGHTS[i]
}

@c_export("xray_top_const_matrix_runtime")
fn xray_top_const_matrix_runtime(row: int, col: int) -> int {
    return MATRIX[row][col] as int
}

@c_export("xray_top_const_cube_runtime")
fn xray_top_const_cube_runtime(i: int, j: int, k: int) -> int {
    return CUBE[i][j][k]
}

@c_export("xray_top_const_struct_runtime")
fn xray_top_const_struct_runtime() -> int {
    return HEADER.magic + HEADER.flags
}

@c_export("xray_top_const_struct_array_runtime")
fn xray_top_const_struct_array_runtime(i: int) -> int {
    return PACKET.bytes[i] as int + PACKET.base
}

@c_export("xray_top_const_nested_struct_runtime")
fn xray_top_const_nested_struct_runtime() -> int {
    return OUTER.inner.code + OUTER.base
}

@c_export("xray_top_const_tuple_runtime")
fn xray_top_const_tuple_runtime() -> int {
    return PAIR.0 + PAIR.1
}

@c_export("xray_top_const_tuple_float_runtime")
fn xray_top_const_tuple_float_runtime() -> float {
    return PAIR.2
}

@c_export("xray_top_const_nested_tuple_runtime")
fn xray_top_const_nested_tuple_runtime() -> int {
    return NESTED.0.0 + NESTED.1.1
}

@c_export("xray_top_const_nested_tuple_float_runtime")
fn xray_top_const_nested_tuple_float_runtime() -> float {
    return NESTED.1.0
}

@c_export("xray_top_const_string_print")
fn xray_top_const_string_print() -> int {
    print(LABEL)
    return 1
}

@c_export("xray_top_const_tuple_string_print")
fn xray_top_const_tuple_string_print() -> int {
    print(LABELED.0)
    return LABELED.1
}

@c_export("xray_top_const_nested_tuple_string_print")
fn xray_top_const_nested_tuple_string_print() -> int {
    print(NESTED.0.1)
    return NESTED.0.0
}

@c_export("xray_top_const_struct_string_print")
fn xray_top_const_struct_string_print() -> int {
    print(NAMED.label)
    return NAMED.code
}

@c_export("xray_top_const_string_array_print")
fn xray_top_const_string_array_print(i: int) -> int {
    print(LABELS[i])
    return i
}

@c_export("xray_top_const_string_matrix_print")
fn xray_top_const_string_matrix_print(row: int, col: int) -> int {
    print(LABEL_MATRIX[row][col])
    return row + col
}

@c_export("xray_top_const_struct_string_array_print")
fn xray_top_const_struct_string_array_print(i: int) -> int {
    print(LABEL_BOX.labels[i])
    return LABEL_BOX.code
}

@c_export("xray_top_const_struct_array_field_runtime")
fn xray_top_const_struct_array_field_runtime(i: int) -> int {
    return ENTRIES[i].code + (ENTRIES[i].flag as int)
}

@c_export("xray_top_const_struct_array_fixed_field_runtime")
fn xray_top_const_struct_array_fixed_field_runtime(row: int, col: int) -> int {
    return ROWS[row].samples[col] as int + ROWS[row].weight
}

@c_export("xray_top_const_struct_array_string_fixed_field_print")
fn xray_top_const_struct_array_string_fixed_field_print(row: int, col: int) -> int {
    print(LABEL_ROWS[row].labels[col])
    return LABEL_ROWS[row].code
}

@c_export("xray_top_const_struct_array_nested_field_runtime")
fn xray_top_const_struct_array_nested_field_runtime(i: int) -> int {
    return GROUPS[i].inner.code + GROUPS[i].base
}

@c_export("xray_top_const_packed_struct_runtime")
fn xray_top_const_packed_struct_runtime() -> int {
    return PACKED.tag as int + PACKED.value as int
}

@c_export("xray_top_const_aligned_struct_runtime")
fn xray_top_const_aligned_struct_runtime() -> int {
    return ALIGNED.value as int
}

@c_export("xray_top_const_packed_aligned_struct_runtime")
fn xray_top_const_packed_aligned_struct_runtime() -> int {
    return PACKED_ALIGNED.tag as int + PACKED_ALIGNED.value as int
}

@c_export("xray_top_const_union_u32_runtime")
fn xray_top_const_union_u32_runtime() -> int {
    return unsafe { BITS.u } as int
}

@c_export("xray_top_const_union_byte_runtime")
fn xray_top_const_union_byte_runtime(i: int) -> int {
    return unsafe { WORD_BYTES.b }[i] as int
}
