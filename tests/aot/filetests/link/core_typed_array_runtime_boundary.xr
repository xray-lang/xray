let ints = new Array<int>(3, 1)
print(ints.length)
print(ints[0])
ints.reserve(6)
print(ints.capacity >= 6)
ints.resize(5, 9)
print(ints.length)
print(ints[3])
ints[4] = 11
print(ints[4])
ints.fill(7, 1, 4)
print(ints[0])
print(ints[1])
print(ints[3])
print(ints[4])
ints.unshift(5)
print(ints.length)
print(ints[0])
print(ints.shift())
print(ints.length)
ints.reverse()
print(ints[0])

let flags = new Array<bool>(4, false)
flags.fill(true, 1, 3)
print(flags[0])
print(flags[1])
print(flags[2])
flags.resize(6, true)
print(flags.length)
print(flags[4])
flags.reverse()
print(flags[0])
