enum FsStatus {
    Ready,
    Done
}

@c_export("xray_enum_tostring_static")
fn xrayEnumToStringStatic(flag: int) -> int {
    var s = FsStatus.Ready
    if (flag != 0) {
        s = FsStatus.Done
    }
    print(s.toString())
    return s.ordinal
}

@c_export("xray_prelude_enum_tostring_static")
fn xrayPreludeEnumToStringStatic(flag: int) -> int {
    var e = Endian.LE
    if (flag != 0) {
        e = Endian.BE
    }
    print(e.toString())
    return e.ordinal
}
