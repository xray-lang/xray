enum FsStatus {
    Ready,
    Done
}

fn xrayEnumToStringStatic(flag: i64) -> i64 {
    var s = FsStatus.Ready
    if (flag != 0) {
        s = FsStatus.Done
    }
    print(s.toString())
    return s.ordinal
}

fn xrayPreludeEnumToStringStatic(flag: i64) -> i64 {
    var e = Endian.LE
    if (flag != 0) {
        e = Endian.BE
    }
    print(e.toString())
    return e.ordinal
}
