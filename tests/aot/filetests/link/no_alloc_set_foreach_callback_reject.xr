fn xray_no_alloc_set_foreach_allocating_callback(value: i64) {
    var scratch: Array<i64> = []
    scratch.push(value)
    print(len(scratch))
}

fn xray_no_alloc_set_foreach_callback_reject(values: Set<i64>) {
    values.forEach(xray_no_alloc_set_foreach_allocating_callback)
}

var xray_no_alloc_set_foreach_values: Set<i64> = #[]
xray_no_alloc_set_foreach_values.add(1)
xray_no_alloc_set_foreach_callback_reject(xray_no_alloc_set_foreach_values)
