enum FsErr {
    Bad
}

fn mayFail(n: i64) -> i64 {
    if (n == 0) {
        throw FsErr.Bad
    }
    return n + 10
}

fn xray_enum_error_channel(n: i64) -> i64 {
    var out = 0
    try {
        out = mayFail(n)
    } catch (e: FsErr) {
        if (e == FsErr.Bad) {
            out = -1
        } else {
            out = -2
        }
    }
    return out
}
