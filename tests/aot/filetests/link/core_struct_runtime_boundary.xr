struct Sample {
    x: int
    y: float
    ok: bool
    byte: byte
}

struct CPoint {
    x: int32
    y: int32
}

struct CBox {
    p: CPoint
    tag: byte
}

fn sample_score() -> int {
    var s = Sample{x: 41, y: 2.5, ok: true, byte: 200}
    s.x = s.x + 1
    s.byte = s.byte + 1
    if (s.ok) {
        return s.x + s.byte
    }
    return 0
}

fn fixed_layout_score() -> int {
    var p = CPoint{x: 10, y: 20}
    p.x = p.x + 2

    var b = CBox{p: CPoint{x: 1, y: 2}, tag: 3}
    b.p.x = b.p.x + b.tag

    return p.x + p.y + b.p.x + b.p.y + b.tag
}

print(sample_score())
print(fixed_layout_score())
