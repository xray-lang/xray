struct Sample {
    x: int
    y: float
    ok: bool
    b: byte
}

struct CPoint {
    x: i32
    y: i32
}

struct CBox {
    p: CPoint
    tag: byte
}

fn sample_score() -> int {
    var s = Sample{x: 41, y: 2.5, ok: true, b: 200}
    s.x = s.x + 1
    s.b = s.b + 1
    if (s.ok) {
        return s.x + (s.b as int)
    }
    return 0
}

fn fixed_layout_score() -> int {
    var p = CPoint{x: 10, y: 20}
    p.x = p.x + 2

    var b = CBox{p: CPoint{x: 1, y: 2}, tag: 3}
    b.p.x = b.p.x + (b.tag as i32)

    return p.x + p.y + b.p.x + b.p.y + (b.tag as i32)
}

print(sample_score())
print(fixed_layout_score())
