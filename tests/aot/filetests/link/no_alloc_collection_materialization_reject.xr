@no_alloc
fn xray_no_alloc_array_unshift_reject(values: Array<int>) -> int {
    values.unshift(0)
    return values.length
}

@no_alloc
fn xray_no_alloc_array_tostring_reject(values: Array<int>) -> string {
    return values.toString()
}

@no_alloc
fn xray_no_alloc_array_entries_reject(values: Array<int>) -> int {
    return values.entries().length
}

@no_alloc
fn xray_no_alloc_array_entries_iterator_reject(values: Array<int>) -> bool {
    return values.entriesIterator().hasNext()
}

@no_alloc
fn xray_no_alloc_map_keys_reject(values: Map<int, int>) -> int {
    return values.keys().length
}

@no_alloc
fn xray_no_alloc_map_values_reject(values: Map<int, int>) -> int {
    return values.values().length
}

@no_alloc
fn xray_no_alloc_map_iterator_reject(values: Map<int, int>) -> bool {
    return values.iterator().hasNext()
}

@no_alloc
fn xray_no_alloc_map_entries_iterator_reject(values: Map<int, int>) -> bool {
    return values.entriesIterator().hasNext()
}

@no_alloc
fn xray_no_alloc_set_iterator_reject(values: Set<int>) -> bool {
    return values.iterator().hasNext()
}

var xray_no_alloc_collection_array: Array<int> = [1, 2, 3]
var xray_no_alloc_collection_map: Map<int, int> = #{}
xray_no_alloc_collection_map.set(1, 2)
var xray_no_alloc_collection_set: Set<int> = #[]
xray_no_alloc_collection_set.add(1)

print(xray_no_alloc_array_unshift_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_array_tostring_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_array_entries_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_array_entries_iterator_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_map_keys_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_values_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_iterator_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_entries_iterator_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_set_iterator_reject(xray_no_alloc_collection_set))
