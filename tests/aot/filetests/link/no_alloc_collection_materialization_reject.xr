fn xray_no_alloc_array_unshift_reject(values: ref Array<i64>) -> i64 {
    values.unshift(0)
    return len(values)
}

fn xray_no_alloc_array_tostring_reject(values: Array<i64>) -> string {
    return values.toString()
}

fn xray_no_alloc_array_entries_reject(values: Array<i64>) -> i64 {
    return len(values.entries())
}

fn xray_no_alloc_array_entries_iterator_reject(values: Array<i64>) -> bool {
    return values.entriesIterator().hasNext()
}

fn xray_no_alloc_map_keys_reject(values: Map<i64, i64>) -> i64 {
    return len(values.keys())
}

fn xray_no_alloc_map_values_reject(values: Map<i64, i64>) -> i64 {
    return len(values.values())
}

fn xray_no_alloc_map_entries_reject(values: Map<i64, i64>) -> i64 {
    return len(values.entries())
}

fn xray_no_alloc_map_iterator_reject(values: Map<i64, i64>) -> bool {
    return values.iterator().hasNext()
}

fn xray_no_alloc_map_entries_iterator_reject(values: Map<i64, i64>) -> bool {
    return values.entriesIterator().hasNext()
}

fn xray_no_alloc_map_tostring_reject(values: Map<i64, i64>) -> string {
    return values.toString()
}

fn xray_no_alloc_set_toarray_reject(values: Set<i64>) -> i64 {
    return len(values.toArray())
}

fn xray_no_alloc_set_values_reject(values: Set<i64>) -> i64 {
    return len(values.values())
}

fn xray_no_alloc_set_union_reject(values: Set<i64>, other: Set<i64>) -> i64 {
    return len(values.union(other))
}

fn xray_no_alloc_set_intersection_reject(values: Set<i64>, other: Set<i64>) -> i64 {
    return len(values.intersection(other))
}

fn xray_no_alloc_set_difference_reject(values: Set<i64>, other: Set<i64>) -> i64 {
    return len(values.difference(other))
}

fn xray_no_alloc_set_symmetric_difference_reject(values: Set<i64>, other: Set<i64>) -> i64 {
    return len(values.symmetricDifference(other))
}

fn xray_no_alloc_set_iterator_reject(values: Set<i64>) -> bool {
    return values.iterator().hasNext()
}

fn xray_no_alloc_set_tostring_reject(values: Set<i64>) -> string {
    return values.toString()
}

var xray_no_alloc_collection_array: Array<i64> = [1, 2, 3]
var xray_no_alloc_collection_map: Map<i64, i64> = #{}
xray_no_alloc_collection_map.set(1, 2)
var xray_no_alloc_collection_set: Set<i64> = #[]
xray_no_alloc_collection_set.add(1)
var xray_no_alloc_collection_set_other: Set<i64> = #[]
xray_no_alloc_collection_set_other.add(2)

print(xray_no_alloc_array_unshift_reject(ref xray_no_alloc_collection_array))
print(xray_no_alloc_array_tostring_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_array_entries_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_array_entries_iterator_reject(xray_no_alloc_collection_array))
print(xray_no_alloc_map_keys_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_values_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_entries_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_iterator_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_entries_iterator_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_map_tostring_reject(xray_no_alloc_collection_map))
print(xray_no_alloc_set_toarray_reject(xray_no_alloc_collection_set))
print(xray_no_alloc_set_values_reject(xray_no_alloc_collection_set))
print(xray_no_alloc_set_union_reject(xray_no_alloc_collection_set,
                                     xray_no_alloc_collection_set_other))
print(xray_no_alloc_set_intersection_reject(xray_no_alloc_collection_set,
                                            xray_no_alloc_collection_set_other))
print(xray_no_alloc_set_difference_reject(xray_no_alloc_collection_set,
                                          xray_no_alloc_collection_set_other))
print(xray_no_alloc_set_symmetric_difference_reject(xray_no_alloc_collection_set,
                                                    xray_no_alloc_collection_set_other))
print(xray_no_alloc_set_iterator_reject(xray_no_alloc_collection_set))
print(xray_no_alloc_set_tostring_reject(xray_no_alloc_collection_set))
