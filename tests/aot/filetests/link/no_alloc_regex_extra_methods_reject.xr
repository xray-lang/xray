import regex

var xray_no_alloc_regex_extra_digits = regex.compile("(\\d+)")

@no_alloc
fn xray_no_alloc_regex_find_reject(text: string) -> bool {
    return xray_no_alloc_regex_extra_digits.find(text) != null
}

@no_alloc
fn xray_no_alloc_regex_find_group_reject(text: string) -> bool {
    return xray_no_alloc_regex_extra_digits.findGroup(text, 1) != null
}

@no_alloc
fn xray_no_alloc_regex_find_all_reject(text: string) -> int {
    return xray_no_alloc_regex_extra_digits.findAll(text).length
}

@no_alloc
fn xray_no_alloc_regex_replace_reject(text: string) -> string {
    return xray_no_alloc_regex_extra_digits.replace(text, "n")
}

@no_alloc
fn xray_no_alloc_regex_replace_all_reject(text: string) -> string {
    return xray_no_alloc_regex_extra_digits.replaceAll(text, "n")
}

@no_alloc
fn xray_no_alloc_regex_split_reject(text: string) -> int {
    return xray_no_alloc_regex_extra_digits.split(text).length
}

@no_alloc
fn xray_no_alloc_regex_pattern_reject() -> string {
    return xray_no_alloc_regex_extra_digits.pattern()
}

@no_alloc
fn xray_no_alloc_regex_tostring_reject() -> string {
    return xray_no_alloc_regex_extra_digits.toString()
}

print(xray_no_alloc_regex_find_reject("abc123"))
print(xray_no_alloc_regex_find_group_reject("abc123"))
print(xray_no_alloc_regex_find_all_reject("a1b2"))
print(xray_no_alloc_regex_replace_reject("abc123"))
print(xray_no_alloc_regex_replace_all_reject("a1b2"))
print(xray_no_alloc_regex_split_reject("a1b2"))
print(xray_no_alloc_regex_pattern_reject())
print(xray_no_alloc_regex_tostring_reject())
