import base64

print(base64.encode("Hello"))
print(base64.decode("SGVsbG8="))
print(base64.encodeUrl("AB"))
print(base64.decodeUrl("QUI"))
print(base64.decode("A"))
print(base64.isValid("SGVsbG8="))

var bytes = Array<byte>(3)
bytes[0] = 72
bytes[1] = 101
bytes[2] = 108
print(base64.encodeBytes(bytes))

var decoded = base64.decodeToBytes("SGVs")
if (decoded != null) {
    print(len(decoded))
    print(decoded[0])
    print(decoded[1])
    print(decoded[2])
}
print(base64.decodeToBytes("!!!") == null)
