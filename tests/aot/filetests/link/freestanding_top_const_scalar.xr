const MAGIC: i64 = 40 + 1

const ENABLED: bool = true

const CODE: rune = 'A'

const SCALE: f64 = 0.5

const NOTHING = null

const LABEL = comptime "scalar"

const LOCAL_LABEL = comptime "local"

fn xray_magic() -> i64 {
    if (ENABLED && CODE == 'A' && SCALE < 1.0) {
        return MAGIC + 1
    }
    return 0
}

fn xray_scalar_string_print() -> i64 {
    print(LABEL)
    if (NOTHING == null) {
        return MAGIC
    }
    return 0
}
