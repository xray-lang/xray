fn xray_no_alloc_array_map_bump(value: i64) -> i64 {
    return value + 1
}

fn xray_no_alloc_array_filter_keep(value: i64) -> bool {
    return value > 0
}

fn xray_no_alloc_array_map_reject(values: Array<i64>) -> i64 {
    return len(values.map(xray_no_alloc_array_map_bump))
}

fn xray_no_alloc_array_filter_reject(values: Array<i64>) -> i64 {
    return len(values.filter(xray_no_alloc_array_filter_keep))
}

var xray_no_alloc_array_map_filter_values: Array<i64> = [1, 2, 3]
print(xray_no_alloc_array_map_reject(xray_no_alloc_array_map_filter_values))
print(xray_no_alloc_array_filter_reject(xray_no_alloc_array_map_filter_values))
