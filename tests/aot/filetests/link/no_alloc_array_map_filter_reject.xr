fn xray_no_alloc_array_map_bump(value: int) -> int {
    return value + 1
}

fn xray_no_alloc_array_filter_keep(value: int) -> bool {
    return value > 0
}

@no_alloc
fn xray_no_alloc_array_map_reject(values: Array<int>) -> int {
    return values.map(xray_no_alloc_array_map_bump).length
}

@no_alloc
fn xray_no_alloc_array_filter_reject(values: Array<int>) -> int {
    return values.filter(xray_no_alloc_array_filter_keep).length
}

var xray_no_alloc_array_map_filter_values: Array<int> = [1, 2, 3]
print(xray_no_alloc_array_map_reject(xray_no_alloc_array_map_filter_values))
print(xray_no_alloc_array_filter_reject(xray_no_alloc_array_map_filter_values))
