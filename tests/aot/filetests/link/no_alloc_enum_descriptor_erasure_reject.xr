enum NoAllocHue {
    Red,
    Blue,
}

enum NoAllocState {
    Idle,
    Busy(i64),
}

type NoAllocVariant = EnumVariant<NoAllocHue> | EnumVariant<NoAllocState>

fn xray_no_alloc_enum_descriptor_erasure_reject(useState: bool) -> NoAllocVariant {
    if (useState) {
        return NoAllocState.variants[0]
    }
    return NoAllocHue.variants[0]
}

print(xray_no_alloc_enum_descriptor_erasure_reject(false) is EnumVariant<NoAllocHue>)
