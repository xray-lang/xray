var COUNTER: i64
var SCALE: f64
var ENABLED: bool
var MAYBE: i64?
var MAYBE_LABEL: string?
var MAYBE_CHAR: rune?

fn xray_top_var_default() -> i64 {
    COUNTER = COUNTER + 7
    if (SCALE == 0.0 && ENABLED == false && MAYBE == null && MAYBE_LABEL == null &&
        MAYBE_CHAR == null) {
        return COUNTER
    }
    return 0
}
