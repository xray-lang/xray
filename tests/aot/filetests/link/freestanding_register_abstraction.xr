import mem

struct MmioReg32 {
    base: i64
    offset: i64
}

fn regAddress(base: i64, offset: i64) -> i64 {
    return base + offset
}

fn regRead(base: i64, offset: i64) -> i64 {
    return mem.volatileLoad(mem.mutPtr<u8>(regAddress(base, offset)), 4)
}

fn regWrite(base: i64, offset: i64, value: i64) {
    mem.volatileStore(mem.mutPtr<u8>(regAddress(base, offset)), value, 4)
}

fn regSetBits(base: i64, offset: i64, mask: i64) -> i64 {
    var next = regRead(base, offset) | mask
    regWrite(base, offset, next)
    return next
}

fn xray_register_sample(base: i64, value: i64) -> i64 {
    var ctrl = MmioReg32{base: base, offset: 0}
    var status = MmioReg32{base: base, offset: 4}
    regWrite(ctrl.base, ctrl.offset, value)
    regSetBits(ctrl.base, ctrl.offset, 0x10)
    return regRead(status.base, status.offset)
}
