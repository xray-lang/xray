const ENABLED: bool = true
const SCALE: float = 0.5
const LETTER: rune = 'A'
const NOTHING = null

fn xray_shared_literals() -> int {
    var score = 0
    if (ENABLED) {
        score = score + 1
    }
    if (SCALE < 1.0) {
        score = score + 2
    }
    if (LETTER == 'A') {
        score = score + 4
    }
    if (NOTHING == null) {
        score = score + 8
    }
    return score
}
