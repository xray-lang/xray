// Reassigning a managed field emits the retain-new / release-old write
// barrier. The no_runtime_heap requirement itself rejects that live R7
// residue; users do not need a second hand-written rc_traffic prohibition.
class Holder {
    data: Array<int>
    n: int
    constructor() {
        this.data = [0]
        this.n = 0
    }
}

fn rcTrafficReject(n: int) -> int {
    var h = Holder()
    h.data = [n, n]
    h.data = [n]
    return len(h.data) + h.n
}

print(rcTrafficReject(3))
