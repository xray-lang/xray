var scores: Map<int, int> = #{}
scores.set(1, 10)
scores.set(2, 20)
scores.set(1, 30)
print(len(scores))
print(scores.get(1))
print(scores.containsKey(2))
print(scores.delete(2))
print(scores.containsKey(2))
print(scores.get(2) == null)

var flags: Map<bool, int> = #{}
flags.set(true, 7)
flags.set(false, 11)
flags.set(true, 13)
print(len(flags))
print(flags.get(true))
print(flags.get(false))
print(flags.containsKey(false))
print(flags.delete(false))
print(flags.containsKey(false))

var weights: Map<float, int> = #{}
weights.set(1.25, 4)
weights.set(2.5, 8)
weights.set(1.25, 16)
print(len(weights))
print(weights.get(1.25))
print(weights.delete(2.5))
print(weights.containsKey(2.5))

var ints: Set<int> = #[]
ints.add(3)
ints.add(5)
ints.add(3)
print(len(ints))
print(ints.contains(5))
print(ints.delete(5))
print(ints.contains(5))

var bytes: Set<byte> = #[]
bytes.add(255)
bytes.add(0)
print(len(bytes))
print(bytes.contains(0))
print(bytes.delete(255))
print(bytes.contains(255))

var floats: Set<float> = #[]
floats.add(1.5)
floats.add(2.5)
floats.add(1.5)
print(len(floats))
print(floats.contains(2.5))
print(floats.delete(2.5))
print(floats.contains(2.5))
