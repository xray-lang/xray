let scores: Map<int, int> = #{}
scores.set(1, 10)
scores.set(2, 20)
scores.set(1, 30)
print(scores.length)
print(scores.get(1))
print(scores.has(2))
print(scores.delete(2))
print(scores.has(2))
print(scores.get(2) == null)

let flags: Map<bool, int> = #{}
flags.set(true, 7)
flags.set(false, 11)
flags.set(true, 13)
print(flags.length)
print(flags.get(true))
print(flags.get(false))
print(flags.has(false))
print(flags.delete(false))
print(flags.has(false))

let weights: Map<float, int> = #{}
weights.set(1.25, 4)
weights.set(2.5, 8)
weights.set(1.25, 16)
print(weights.length)
print(weights.get(1.25))
print(weights.delete(2.5))
print(weights.has(2.5))

let ints: Set<int> = #[]
ints.add(3)
ints.add(5)
ints.add(3)
print(ints.length)
print(ints.has(5))
print(ints.delete(5))
print(ints.has(5))

let bytes: Set<uint8> = #[]
bytes.add(255)
bytes.add(256)
print(bytes.length)
print(bytes.has(0))
print(bytes.delete(255))
print(bytes.has(255))

let floats: Set<float> = #[]
