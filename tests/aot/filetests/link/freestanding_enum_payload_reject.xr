enum FsErr {
    Bad(int)
}

fn mayFail(n: int) -> int {
    if (n == 0) {
        throw FsErr.Bad(7)
    }
    return n
}

@c_export("xray_enum_payload_reject")
fn xray_enum_payload_reject(n: int) -> int {
    var out = 0
    try {
        out = mayFail(n)
    } catch (e) {
        out = -1
    }
    return out
}
