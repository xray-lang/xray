enum FsState {
    Ready,
    Done
}

fn xrayEnumNameStatic(flag: i64) -> i64 {
    var s = FsState.Ready
    if (flag != 0) {
        s = FsState.Done
    }
    print(s.name)
    return s.ordinal
}

fn xrayPreludeEnumNameStatic(flag: i64) -> i64 {
    var e = Endian.LE
    if (flag != 0) {
        e = Endian.BE
    }
    print(e.name)
    return e.ordinal
}
