]

packed struct PackedPair {
    tag: uint8
    value: uint32
}

struct AlignedWord align(16) {
    value: int32
}

packed struct PackedAligned align(16) {
    tag: uint8
    value: uint32
}

@weak
const PACKED = comptime PackedPair{tag: 5, value: 37}

@weak
const ALIGNED = comptime AlignedWord{value: 42}

@weak
const PACKED_ALIGNED = comptime PackedAligned{tag: 6, value: 36}

@weak
const PAIR = comptime (HEADER.magic, PACKET.base)

