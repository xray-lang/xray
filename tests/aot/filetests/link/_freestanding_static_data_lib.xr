@section("__DATA,.xr_imag")
@weak
@used
const MAGIC: int = 40

export const OFFSET: int = 2

@weak
const TABLE: [int; 4] = comptime [3, 5, 7, 11]

@weak
const BYTES: [uint8; 4] = comptime [1, 2, 4, 8]

struct Header {
    magic: int
    flags: int
}

@section("__DATA,.xr_ihead")
@weak
@used
const HEADER = comptime Header{magic: TABLE[1], flags: TABLE[2]}

struct Packet {
    bytes: [uint8; 4]
    base: int
}

@weak
const PACKET = comptime Packet{bytes: [9, 10, 11, 12], base: HEADER.flags}

struct Inner {
    code: int
}

struct Outer {
    inner: Inner
    base: int
}

@weak
const OUTER = comptime Outer{inner: Inner{code: TABLE[3]}, base: PACKET.base}

@section("__DATA,.xr_igroup")
@weak
@used
const GROUPS: [Outer; 2] = comptime [
    Outer{inner: Inner{code: TABLE[0]}, base: TABLE[1]},
    Outer{inner: Inner{code: TABLE[2]}, base: TABLE[3]},
]

packed struct PackedPair {
    tag: uint8
    value: uint32
}

struct AlignedWord align(16) {
    value: int32
}

packed struct PackedAligned align(16) {
    tag: uint8
    value: uint32
}

@weak
const PACKED = comptime PackedPair{tag: 5, value: 37}

@weak
const ALIGNED = comptime AlignedWord{value: 42}

@weak
const PACKED_ALIGNED = comptime PackedAligned{tag: 6, value: 36}

@weak
const PAIR = comptime (HEADER.magic, PACKET.base)

@weak
const NESTED = comptime ((TABLE[0], HEADER.flags), (PACKET.base, TABLE[3]))

union I32Bits {
    i: int32
    u: uint32
}

union U32Bytes {
    u: uint32
    b: [uint8; 4]
}

@weak
const BITS = comptime I32Bits{i: -1}

@weak
const WORD_BYTES = comptime U32Bytes{u: 0x01020304}

@weak
const LABEL = comptime "score"

@weak
const LABELS: [string; 2] = comptime ["level", LABEL]

struct Named {
    label: string
    code: int
}

@weak
const NAMED = comptime Named{label: LABEL, code: TABLE[1]}

@weak
const LABELED = comptime (LABEL, TABLE[0])

struct Entry {
    code: int
    flag: bool
}

@section("__DATA,.xr_ient")
@weak
@used
const ENTRIES: [Entry; 2] = comptime [
    Entry{code: TABLE[0], flag: true},
    Entry{code: TABLE[2], flag: false},
]

struct Row {
    samples: [uint8; 4]
    weight: int
}

@section("__DATA,.xr_irow")
@weak
@used
const ROWS: [Row; 2] = comptime [
    Row{samples: [2, 4, 6, 8], weight: TABLE[0]},
    Row{samples: [1, 3, 5, 7], weight: TABLE[1]},
]

export { MAGIC, TABLE, BYTES, HEADER, PACKET, OUTER, GROUPS, PACKED, ALIGNED, PACKED_ALIGNED, PAIR, NESTED, BITS, WORD_BYTES, LABEL, LABELS, NAMED, LABELED, ENTRIES, ROWS }
