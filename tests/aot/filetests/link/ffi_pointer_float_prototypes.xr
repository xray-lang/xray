extern "C" {
    fn memchr(s: Ptr<byte>, c: i32, n: usize) -> Ptr<byte>
    fn sinf(x: f32) -> f32
}

extern "C" {
    fn xrayffi_unused_float(x: f64) -> f64
}

const bytes = b"ABC"
var found = unsafe { memchr(bytes.ptr(), 66, 3) }
print(found.isNull())
print(unsafe { found.deref() })
print(unsafe { sinf(0.0) == 0.0 })
