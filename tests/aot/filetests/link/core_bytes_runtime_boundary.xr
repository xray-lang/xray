fn run_bytes_boundary() {
    var bytes = Bytes(8, 1)
    bytes[0] = 1
    bytes[1] = 2
    bytes[2] = 3
    bytes[3] = 4
    bytes[4] = 5
    bytes[5] = 6
    bytes[6] = 7
    bytes[7] = 8
    print(bytes.length)
    var view: ByteSpan = bytes[:]
    var u16: uint16 = view.load<uint16>(0, Endian.LE)
    var u32: uint32 = view.load<uint32>(0, Endian.LE)
    var u64: uint64 = view.load<uint64>(0, Endian.LE)
    view.store<uint16>(6, 0x0a09, Endian.LE)
    print(int(u16))
    print(int(u32))
    print(int(u64))
    print(bytes[6])

    var dst = Bytes.withCapacity(6)
    print(dst.length)
    print(dst.capacity)
    dst.appendFrom(view[1:4])
    print(dst.length)
    print(dst[0])
    print(dst[2])

    var repeated = Bytes.withCapacity(9)
    var seed = Bytes(3)
    seed[0] = 65
    seed[1] = 66
    seed[2] = 67
    var seedView: ByteSpan = seed[:]
    repeated.appendFrom(seedView)
    repeated.repeatFrom(3, 6)
    print(repeated[3])
    print(repeated[8])

    var filled = Bytes(5, 0)
    filled.fill(7, 1, 4)
    print(filled[0])
    print(filled[1])
    print(filled[3])
    print(filled[4])

    var filledView: ByteSpan = filled[1:4]
    print(filledView.length)
    print(filledView[0])
}

run_bytes_boundary()
