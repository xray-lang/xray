let bytes = new Bytes(8, 1)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4
bytes[4] = 5
bytes[5] = 6
bytes[6] = 7
bytes[7] = 8
print(bytes.length)
print(bytes.loadU32LE(0))
print(bytes.loadU64LE(0))

let dst = Bytes.withCapacity(6)
print(dst.length)
print(dst.capacity)
dst.resize(6, 0)
dst.copyFrom(bytes, 1, 2, 3)
print(dst[2])
print(dst[4])

let move = new Bytes(6)
move[0] = 10
move[1] = 20
move[2] = 30
move[3] = 40
move.copyWithin(2, 0, 4)
print(move[2])
print(move[5])

let repeated = new Bytes(9)
repeated[0] = 65
repeated[1] = 66
repeated[2] = 67
repeated.repeatFrom(3, 3, 6)
print(repeated[3])
print(repeated[8])

let filled = new Bytes(5, 0)
filled.fill(7, 1, 4)
print(filled[0])
print(filled[1])
print(filled[3])
print(filled[4])

let view = filled[1:4]
print(view.length)
print(view[0])
