let bytes = Bytes(8, 1)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4
bytes[4] = 5
bytes[5] = 6
bytes[6] = 7
bytes[7] = 8
print(bytes.length)
let view: ByteSpan = bytes
let u16: uint16 = view.loadLE<uint16>(0)
let u32: uint32 = view.loadLE<uint32>(0)
let u64: uint64 = view.loadLE<uint64>(0)
print(int(u16))
print(int(u32))
print(int(u64))

let dst = Bytes.withCapacity(6)
print(dst.length)
print(dst.capacity)
unsafe {
    dst.appendFromUnchecked(view, 1, 3)
}
print(dst.length)
print(dst[0])
print(dst[2])

let repeated = Bytes.withCapacity(9)
let seed = Bytes(3)
seed[0] = 65
seed[1] = 66
seed[2] = 67
unsafe {
    repeated.appendFromUnchecked(seed, 0, 3)
    repeated.repeatFromUnchecked(3, 6)
}
print(repeated[3])
print(repeated[8])

let filled = Bytes(5, 0)
filled.fill(7, 1, 4)
print(filled[0])
print(filled[1])
print(filled[3])
print(filled[4])

let filledView = filled[1:4]
print(filledView.length)
print(filledView[0])
