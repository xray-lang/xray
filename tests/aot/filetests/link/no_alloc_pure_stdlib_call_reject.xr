import base64
import { isValid as isValidBase64 } from "base64"

@no_alloc
fn xray_no_alloc_pure_stdlib_call_reject(data: string) -> string {
    return base64.encode(data)
}

@no_alloc
fn xray_no_alloc_pure_stdlib_scalar_call_reject(data: string) -> bool {
    return base64.isValid(data)
}

@no_alloc
fn xray_no_alloc_pure_stdlib_selective_call_reject(data: string) -> bool {
    return isValidBase64(data)
}

print(xray_no_alloc_pure_stdlib_call_reject("edge"))
print(xray_no_alloc_pure_stdlib_scalar_call_reject("ZWRnZQ=="))
print(xray_no_alloc_pure_stdlib_selective_call_reject("ZWRnZQ=="))
