args=--profile freestanding
contains=xaot-plan v0
contains="runtime_objects": []
contains="stdlib_objects": []
contains="system_libs": []
contains="defines": ["XRT_IMPL", "XRAY_PROFILE_FREESTANDING=1"]
c_contains=#include "xrt_core_freestanding.h"
c_contains=static XrValue xrt_shared[
c_contains=[0] = XR_FROM_INT(INT64_C(0)),
c_contains=[1] = XR_FROM_FLOAT(0x0p+0),
c_contains=[2] = XR_FALSE_VAL,
c_contains=[3] = XR_NULL_VAL,
c_contains=xray_top_var_default
c_contains=xrt_shared[0] =
c_not_contains=xrt_shared[0] = XR_FROM_INT(INT64_C(0))
c_not_contains=xrt_shared[1] = XR_FROM_FLOAT(0x0p+0)
c_not_contains=xrt_shared[2] = XR_FALSE_VAL
c_not_contains=xrt_shared[3] = XR_NULL_VAL
c_not_contains=#include "xrt.h"
not_contains=xray_rt_coro
not_contains=xray_core
