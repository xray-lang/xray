import io

var root = io.tempDir() ?? ""
print(root.length > 0)

var dir = root + "/a/b"
print(io.mkdirp(dir))
print(io.isDir(dir))

var file = dir + "/sample.txt"
print(io.writeFile(file, "hello"))
print(io.exists(file))
print(io.isFile(file))
print(!io.isDir(file))
print(io.fileSize(file))
print(io.readFile(file) == "hello")
print(io.appendFile(file, "\nworld"))

var lines = io.readLines(file)
print(lines.length)
print(lines[0])
print(lines[1])

var bytesFile = dir + "/bytes.bin"
var bytes = Bytes(3)
bytes[0] = 65
bytes[1] = 0
bytes[2] = 255
print(io.writeFileBytes(bytesFile, bytes))
var readBytes = io.readFileBytes(bytesFile)
if (readBytes != null) {
    print(readBytes.length)
    print(readBytes[0])
    print(readBytes[1])
    print(readBytes[2])
} else {
    print(0)
    print(0)
    print(0)
    print(0)
}

var copied = root + "/copy.txt"
print(io.copyFile(file, copied))
print(io.readFile(copied) == "hello\nworld")
var moved = root + "/moved.txt"
print(io.rename(copied, moved))
print(!io.exists(copied))
print(io.exists(moved))

var stat = io.stat(file)
print(stat != null)
print(stat!.size == 11)
print(stat!.mode >= 0)
print(stat!.mtime >= 0)
print(stat!.atime >= 0)
print(stat!.ctime >= 0)
print(stat!.uid >= 0)
print(stat!.gid >= 0)
print(stat!.isFile)
print(!stat!.isDir)
print(!stat!.isSymlink)

var touched = root + "/touched.txt"
print(io.touch(touched))
print(io.chmod(file, 420))

var entries = io.readDir(dir)
print(entries.length >= 2)
var recursive = io.readDirRecursive(root)
print(recursive.length >= 4)

var resolvedDir = io.realpath(dir) ?? ""
var oldCwd = io.cwd()
print(oldCwd.length > 0)
print(resolvedDir.length > 0)
print(io.chdir(dir))
print(io.cwd() == resolvedDir)
print(io.chdir(oldCwd))

var link = root + "/sample-link.txt"
var linkOk = io.symlink(file, link)
if (linkOk) {
    print(io.isSymlink(link))
    print(io.readlink(link) != null)
} else {
    print(true)
    print(true)
}

var tmpFile = io.tempFile() ?? ""
print(tmpFile.length > 0)
print(io.exists(tmpFile))
print(io.remove(tmpFile))

print(io.removeAll(root))
print(!io.exists(root))
