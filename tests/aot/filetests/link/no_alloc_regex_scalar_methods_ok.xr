import regex

var xray_no_alloc_regex_scalar_digits = regex.compile("(\\d+)")

fn xray_no_alloc_regex_scalar_methods_ok(text: string) -> int {
    var score = regex.test(xray_no_alloc_regex_scalar_digits, text) ? 10 : 0
    score = score + regex.count(xray_no_alloc_regex_scalar_digits, text)
    score = score + (xray_no_alloc_regex_scalar_digits.test(text) ? 100 : 0)
    return score
}

print(xray_no_alloc_regex_scalar_methods_ok("a1 b22"))
