args=--dump-global-evidence
contains=seq-access
contains=generic-storage
regex=generic-storage-plan [0-9]+ id=[1-9][0-9]* inst=[1-9][0-9]* module=[1-9][0-9]* kind=array action=typed_inline
contains=kind=array access=index_get
contains=kind=array access=slice
contains=kind=array access=length
contains=capacity-op
contains=kind=array op=push
contains=kind=bytes op=append
contains=kind=bytes op=to_string
contains=kind=string_builder op=to_string
contains=bulk-op
contains=op=copy
contains=op=fill
contains=encoding-op
contains=op=string_to_bytes
contains=op=bytes_to_string
contains=sequence-access-plan
contains=capacity-plan
regex=capacity-plan [0-9]+ .*action=reserve_once
contains=bulk-plan
contains=encoding-plan
regex=encoding-plan [0-9]+ .*action=runtime_validate
regex=encoding-plan [0-9]+ .*action=validate_once
