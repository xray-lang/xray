contains=xaot-plan v0
contains=  "target": {
regex=    "name": "(aarch64|x86_64)-(apple-darwin|linux-gnu|windows-msvc)"
regex=    "arch": "(aarch64|x86_64)"
regex=    "os": "(darwin|linux|windows)"
regex=    "abi": "(darwin|gnu|msvc)"
regex=    "object_format": "(macho|elf|coff)"
regex=    "triple": "(aarch64|x86_64)-(apple-darwin|linux-gnu|windows-msvc)"
contains="generated_c_files": ["<aot-generated-c>"]
contains="runtime_caps": ["coro", "timer"]
contains="runtime_objects": ["xray_rt_coro"]
contains="stdlib_objects": []
contains="stdlib_symbols": ["time.sleep"]
regex="system_libs": \[[^]]*"m"
regex="system_libs": \[[^]]*"pthread"
contains="defines": ["XRT_IMPL"]
not_contains=xray_core
not_contains="stdlib_objects": ["time"]
not_contains="z"
not_contains="ffi"
not_contains="ssl"
not_contains="crypto"
