args=--profile freestanding
status=fail
contains=freestanding profile rejects Map literal
contains=dynamic containers require hosted allocation
contains=freestanding profile rejects Set literal
contains=freestanding profile rejects object literal
contains=use a declared struct literal for fixed layout data
contains=freestanding profile rejects regex literal
contains=freestanding profile rejects BigInt literal
contains=freestanding profile rejects anonymous function/closure
contains=use a top-level function symbol
contains=freestanding profile rejects string concatenation
contains=use static string literals or write into an explicit user buffer
contains=freestanding profile rejects class construction
contains=use structs or explicit raw-memory APIs in this profile
not_contains=xrt_obj_alloc
not_contains=xrt_type_register_hot
not_contains=unsupported AOT
not_contains=CRASH
