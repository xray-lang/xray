import mem

struct CounterState {
    value: int
    limit: int
}

var STATE = CounterState{value: 1, limit: 10}

@c_export("xray_rawmut_top_var_aggregate_addr")
fn rawmutTopVarAggregateAddr() -> int {
    STATE.value = STATE.value + 1
    return mem.addressOf(RawMut<CounterState>.of(STATE)) + STATE.value
}
