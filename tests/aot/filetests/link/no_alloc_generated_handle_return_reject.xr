import io
import os

@no_alloc
fn xray_no_alloc_io_stat_handle_reject(path: string) -> bool {
    return io.stat(path) != null
}

@no_alloc
fn xray_no_alloc_os_exec_handle_reject(cmd: string) -> bool {
    return os.exec(cmd) != null
}

print(xray_no_alloc_io_stat_handle_reject("."))
print(xray_no_alloc_os_exec_handle_reject("true"))
