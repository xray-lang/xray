args=--profile freestanding
contains=xaot-plan v0
contains="runtime_objects": []
contains="stdlib_objects": []
contains="system_libs": []
contains="defines": ["XRT_IMPL", "XRAY_PROFILE_FREESTANDING=1"]
c_contains=#include "xrt_core_freestanding.h"
c_not_contains=freestanding prelude enum namespace
# Locals are hoisted to declarations at the top of the function and assigned
# separately, and folded ordinals no longer take their own SSA value, so pin
# the scalar shape rather than a declaration form or a value number.  The
# c_not_contains assertions below are what actually guard the enum lowering:
# no boxing, no tag, no map, no xrt_eq.
c_regex=v[0-9]+ = INT64_C\(1\);
c_regex=v[0-9]+ = INT64_C\(2\);
c_not_contains=_ev_Endian
c_not_contains=XR_TAG_ENUM
c_not_contains=xrt_enum_box_ordinal(
c_not_contains=xrt_map_new
c_not_contains=xrt_map_set
c_not_contains=xrt_getprop_name
c_not_contains=xr_box_str
c_not_contains=#include "xrt.h"
not_contains=xray_rt_coro
not_contains=xray_core
