enum FsErr {
    Bad { code: i64 }
}

fn mayFail(n: i64) -> i64 {
    if (n == 0) {
        throw FsErr.Bad { code: 7 }
    }
    return n
}

fn xray_enum_payload_untyped_catch_reject(n: i64) -> i64 {
    var out = 0
    try {
        out = mayFail(n)
    } catch (e) {
        out = -1
    }
    return out
}
