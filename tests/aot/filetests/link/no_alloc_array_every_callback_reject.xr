fn xray_no_alloc_array_every_allocating_callback(value: int) -> bool {
    var scratch: Array<int> = []
    scratch.push(value)
    return scratch.length > 0
}

@no_alloc
fn xray_no_alloc_array_every_callback_reject(values: Array<int>) -> bool {
    return values.every(xray_no_alloc_array_every_allocating_callback)
}

var xray_no_alloc_array_every_values: Array<int> = [1, 2, 3]
print(xray_no_alloc_array_every_callback_reject(xray_no_alloc_array_every_values))
