fn xray_no_alloc_stringbuilder_append_reject(sb: ref StringBuilder, value: i64) -> i64 {
    sb.append(value)
    return len(sb)
}

fn xray_no_alloc_stringbuilder_tostring_reject(sb: StringBuilder) -> string {
    return sb.toString()
}

var sb = StringBuilder()
print(xray_no_alloc_stringbuilder_append_reject(ref sb, 42))
print(xray_no_alloc_stringbuilder_tostring_reject(sb))
