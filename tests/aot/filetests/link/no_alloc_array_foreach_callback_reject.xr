fn xray_no_alloc_array_foreach_allocating_callback(value: i64) {
    var scratch: Array<i64> = []
    scratch.push(value)
    print(len(scratch))
}

fn xray_no_alloc_array_foreach_callback_reject(values: Array<i64>) {
    values.forEach(xray_no_alloc_array_foreach_allocating_callback)
}

var xray_no_alloc_array_foreach_values: Array<i64> = [1, 2, 3]
xray_no_alloc_array_foreach_callback_reject(xray_no_alloc_array_foreach_values)
