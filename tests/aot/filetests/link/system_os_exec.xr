import os

let r = os.exec("printf 'abc'")
print(r != null)
print(r.stdout)
print(r.stderr == "")
print(r.exitCode)

let e = os.exec("sh -c 'printf err >&2; exit 7'")
print(e != null)
print(e.stdout == "")
print(e.stderr)
print(e.exitCode)

let big = os.exec("awk 'BEGIN { for (i = 0; i < 200000; i++) printf \"x\" > \"/dev/stderr\" }'")
print(big != null)
print(big.exitCode)
print(big.stderr.length)
