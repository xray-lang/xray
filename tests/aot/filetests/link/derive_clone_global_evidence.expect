args=--dump-global-evidence
contains=xglobal-evidence v1 profile=native_release
contains=xg-cache-key v1 schema=32 phase=4 module=1
regex=decl [0-9]+ id=[0-9]+ module=1 node=[1-9][0-9]* kind=class flags=0x20 .* derive=0x10
regex=derive [0-9]+ id=[0-9]+ module=1 decl=[0-9]+ type=[0-9]+ kind=clone .* fields=[0-9]+\+1 .* flags=0x1
regex=derived-field [0-9]+ id=[0-9]+ derive=[0-9]+ ord=0 name=[0-9]+ type=[0-9]+ source_field=[0-9]+ flags=0x1
regex=derived-clone-plan [0-9]+ decl=[0-9]+ type=[0-9]+ clone=[0-9]+ action=fieldwise_copy fields=[0-9]+\+1 body=0 transfer=0 evidence=0x3 reason=none
regex=metadata [0-9]+ name=derive bodies=0 decls=1 action=link evidence=0x2 reason=none
