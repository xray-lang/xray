extern "C" {
    fn xrayffi_bool_flip(x: bool) -> bool
    fn xrayffi_i8_add(x: i8, y: i8) -> i8
    fn xrayffi_u8_add(x: u8, y: u8) -> u8
    fn xrayffi_i16_add(x: i16, y: i16) -> i16
    fn xrayffi_u16_add(x: u16, y: u16) -> u16
    fn xrayffi_i32_add(x: i32, y: i32) -> i32
    fn xrayffi_u32_add(x: u32, y: u32) -> u32
    fn xrayffi_i64_add(x: i64, y: i64) -> i64
    fn xrayffi_u64_add(x: u64, y: u64) -> u64
    fn xrayffi_size_roundtrip(x: usize) -> usize
    fn xrayffi_ssize_roundtrip(x: isize) -> isize
    fn xrayffi_f32_add(x: f32, y: f32) -> f32
    fn xrayffi_f64_add(x: f64, y: f64) -> f64
    fn xrayffi_ptr_identity(p: Ptr<u8>) -> Ptr<u8>
    fn xrayffi_void_sink(x: i32) -> ()
}

var i8a: i8 = -2
var i8b: i8 = 5
var u8a: u8 = 2
var u8b: u8 = 5
var i16a: i16 = -20
var i16b: i16 = 7
var u16a: u16 = 20
var u16b: u16 = 7
var u32a: u32 = 20
var u32b: u32 = 7
var u64a: u64 = 20
var u64b: u64 = 7
var usizeValue: usize = 9
var ssizeValue: isize = -9
const bytes = b"X"

unsafe { xrayffi_void_sink(1) }
print(unsafe { xrayffi_bool_flip(false) })
print(unsafe { xrayffi_i8_add(i8a, i8b) })
print(unsafe { xrayffi_u8_add(u8a, u8b) })
print(unsafe { xrayffi_i16_add(i16a, i16b) })
print(unsafe { xrayffi_u16_add(u16a, u16b) })
print(unsafe { xrayffi_i32_add(-20, 7) })
print(unsafe { xrayffi_u32_add(u32a, u32b) })
print(unsafe { xrayffi_i64_add(-20, 7) })
print(unsafe { xrayffi_u64_add(u64a, u64b) })
print(unsafe { xrayffi_size_roundtrip(usizeValue) })
print(unsafe { xrayffi_ssize_roundtrip(ssizeValue) })
print(unsafe { xrayffi_f32_add(1.0, 2.0) })
print(unsafe { xrayffi_f64_add(1.0, 2.0) })
print(unsafe { xrayffi_ptr_identity(bytes.ptr()).isNull() })
