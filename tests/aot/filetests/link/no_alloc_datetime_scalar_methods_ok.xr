import datetime

var xray_no_alloc_datetime_scalar_start = datetime.fromTimestamp(0)
var xray_no_alloc_datetime_scalar_end = datetime.fromTimestamp(86400)

@no_alloc
fn xray_no_alloc_datetime_scalar_methods_ok(start: DateTime, end: DateTime) -> int {
    var score = end.diff(start)
    score = score + end.diff(start, "milliseconds")
    if (start.isBefore(end)) { score = score + 1 }
    if (end.isAfter(start)) { score = score + 2 }
    if (!start.equals(end)) { score = score + 3 }
    if (start.isLeapYear()) { score = score + 4 }
    score = score + start.daysInMonth()
    return score
}

print(xray_no_alloc_datetime_scalar_methods_ok(xray_no_alloc_datetime_scalar_start,
                                               xray_no_alloc_datetime_scalar_end))
