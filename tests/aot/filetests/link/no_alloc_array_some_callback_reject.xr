fn xray_no_alloc_array_some_allocating_callback(value: int) -> bool {
    var scratch: Array<int> = []
    scratch.push(value)
    return len(scratch) > 0
}

fn xray_no_alloc_array_some_callback_reject(values: Array<int>) -> bool {
    return values.some(xray_no_alloc_array_some_allocating_callback)
}

var xray_no_alloc_array_some_values: Array<int> = [1, 2, 3]
print(xray_no_alloc_array_some_callback_reject(xray_no_alloc_array_some_values))
