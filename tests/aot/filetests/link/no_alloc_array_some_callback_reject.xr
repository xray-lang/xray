fn xray_no_alloc_array_some_allocating_callback(value: i64) -> bool {
    var scratch: Array<i64> = []
    scratch.push(value)
    return len(scratch) > 0
}

fn xray_no_alloc_array_some_callback_reject(values: Array<i64>) -> bool {
    return values.some(xray_no_alloc_array_some_allocating_callback)
}

var xray_no_alloc_array_some_values: Array<i64> = [1, 2, 3]
print(xray_no_alloc_array_some_callback_reject(xray_no_alloc_array_some_values))
