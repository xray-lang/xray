fn read16(src: Slice<byte>, pos: int) -> int {
    var value: uint16 = src.load<uint16>(pos, Endian.LE)
    return int(value)
}

fn read32(src: Slice<byte>, pos: int) -> int {
    var value: uint32 = src.load<uint32>(pos, Endian.LE)
    return int(value)
}

fn read64(src: Slice<byte>, pos: int) -> int {
    var value: uint64 = src.load<uint64>(pos, Endian.LE)
    return int(value)
}

fn read32BE(src: Slice<byte>, pos: int) -> int {
    var value: uint32 = src.load<uint32>(pos, Endian.BE)
    return int(value)
}

fn write16LE(dst: Slice<byte>, pos: int, value: uint16) {
    dst.store<uint16>(pos, value, Endian.LE)
}

var bytes = Array<byte>.withCapacity(8)
unsafe {
    bytes.push(1)
    bytes.push(2)
    bytes.push(3)
    bytes.push(4)
    bytes.push(5)
    bytes.push(6)
    bytes.push(7)
    bytes.push(8)
}

var view: Slice<byte> = bytes[:]
print(read16(view, 0))
print(read16(view, 3))
print(read32(view, 0))
print(read32(view, 1))
print(read64(view, 0))
print(read32BE(view, 2))
write16LE(view, 6, 0x0a09)
print(read16(view, 6))
