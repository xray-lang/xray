fn read16(src: ByteSpan, pos: int) -> int {
    let value: uint16 = src.load<uint16>(pos, Endian.LE)
    return int(value)
}

fn read32(src: ByteSpan, pos: int) -> int {
    let value: uint32 = src.load<uint32>(pos, Endian.LE)
    return int(value)
}

fn read64(src: ByteSpan, pos: int) -> int {
    let value: uint64 = src.load<uint64>(pos, Endian.LE)
    return int(value)
}

fn read32BE(src: ByteSpan, pos: int) -> int {
    let value: uint32 = src.load<uint32>(pos, Endian.BE)
    return int(value)
}

fn write16LE(dst: ByteSpan, pos: int, value: uint16) {
    dst.store<uint16>(pos, value, Endian.LE)
}

let bytes = Bytes.withCapacity(8)
unsafe {
    bytes.pushUnchecked(1)
    bytes.pushUnchecked(2)
    bytes.pushUnchecked(3)
    bytes.pushUnchecked(4)
    bytes.pushUnchecked(5)
    bytes.pushUnchecked(6)
    bytes.pushUnchecked(7)
    bytes.pushUnchecked(8)
}

let view: ByteSpan = bytes
print(read16(view, 0))
print(read16(view, 3))
print(read32(view, 0))
print(read32(view, 1))
print(read64(view, 0))
print(read32BE(view, 2))
write16LE(view, 6, 0x0a09)
print(read16(view, 6))
