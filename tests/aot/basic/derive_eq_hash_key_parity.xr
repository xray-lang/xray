@derive(Eq, Hash)
class Key {
    id: i64
    name: string

    constructor(id: i64, name: string) {
        this.id = id
        this.name = name
    }
}

fn main() {
    var values: Map<Key, i64> = #{}
    var keys: Set<Key> = #[]
    var inserted = Key(7, "alpha")
    values.set(inserted, 41)
    keys.add(inserted)

    var equal = Key(7, "alpha")
    var different = Key(8, "alpha")
    print(values.containsKey(equal))
    print(values.get(equal))
    print(keys.contains(equal))
    print(values.containsKey(different))
    print(keys.contains(different))
}

main()
