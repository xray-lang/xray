var by_int: Map<i64, f32> = #{}
by_int.set(1, 1.25)
by_int.set(2, 2.5)
by_int.set(1, 3.75)
print(len(by_int))
print(by_int.get(1))
print(by_int.containsKey(2))

var int_values = by_int.values()
print(len(int_values))
print(int_values[0] + int_values[1])

var by_float: Map<f32, i64> = #{}
by_float.set(1.25, 10)
by_float.set(2.5, 20)
print(len(by_float))
print(by_float.get(1.25))
print(by_float.delete(2.5))
print(by_float.containsKey(2.5))

var by_double: Map<f64, i64> = #{}
by_double.set(1.125, 11)
by_double.set(2.25, 22)
by_double.set(1.125, 33)
print(len(by_double))
print(by_double.get(1.125))
print(by_double.delete(2.25))
print(by_double.containsKey(2.25))

var by_bool: Map<bool, f32> = #{}
by_bool.set(true, 1.5)
by_bool.set(false, 2.25)
print(len(by_bool))
print(by_bool.get(true)! + by_bool.get(false)!)

class BoolFloatMapBag {
    values: Map<bool, f32>

    constructor() {
        var values: Map<bool, f32> = #{}
        this.values = values
    }

    ref fill() -> i64 {
        this.values.set(true, 1.5)
        this.values.set(false, 2.25)
        return len(this.values)
    }

    scan(rounds: i64) -> f64 {
        var r = 0
        var sum = 0.0
        while (r < rounds) {
            if (this.values.containsKey(true)) {
                sum = sum + this.values.get(true)!
            }
            if (this.values.containsKey(false)) {
                sum = sum + this.values.get(false)!
            }
            r = r + 1
        }
        return sum
    }

    ref prune() -> i64 {
        var removed = 0
        if (this.values.delete(false)) {
            removed = removed + 1
        }
        return removed + len(this.values)
    }
}

var bool_bag = BoolFloatMapBag()
print(bool_bag.fill())
print(bool_bag.scan(3))
print(bool_bag.prune())
print(bool_bag.scan(3))

class FloatMapBag {
    values: Map<f32, f32>

    constructor() {
        var values: Map<f32, f32> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set((i as f32) + 0.5, (i as f32) * 0.25 + 1.0)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64) -> f64 {
        var i = 0
        var sum = 0.0
        while (i < n) {
            var key = (i as f32) + 0.5
            if (this.values.containsKey(key)) {
                sum = sum + this.values.get(key)!
            }
            i = i + 1
        }
        return sum
    }

    ref prune(n: i64) -> i64 {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete((i as f32) + 0.5)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }
}

var bag = FloatMapBag()
print(bag.fill(5))
print(bag.scan(5))
print(bag.prune(5))
print(bag.scan(5))
