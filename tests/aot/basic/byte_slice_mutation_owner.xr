fn main() {
    var bytes = Array<byte>(10)
    var view: Slice<byte> = bytes[:]
    view[0] = 1
    view[1] = 2
    view[2] = 3
    view[3] = 4
    view[4] = 5
    var dst: Slice<byte> = view[1:6]
    var src: Slice<byte> = view[0:5]
    dst.copyFrom(src)
    view.repeatFrom(6, 2, 4)
    print(bytes[0])
    print(bytes[1])
    print(bytes[5])
    print(bytes[6])
    print(bytes[7])
    print(bytes[8])
    print(bytes[9])
    var empty: Slice<byte> = view[0:0]
    empty.copyFrom(empty)
    print(len(empty))
}

main()
