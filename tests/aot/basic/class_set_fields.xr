class SeenSet {
    values: Set<i64>

    constructor() {
        var values: Set<i64> = #[]
        this.values = values
    }

    ref add(value: i64) -> i64 {
        this.values.add(value)
        return len(this.values)
    }

    contains(value: i64) -> bool {
        return this.values.contains(value)
    }

    ref remove(value: i64) -> bool {
        return this.values.delete(value)
    }

    count() -> i64 {
        return len(this.values)
    }
}

var seen = SeenSet()
print(seen.add(3))
print(seen.add(5))
print(seen.add(3))
print(seen.contains(5))
print(seen.remove(5))
print(seen.contains(5))
print(seen.count())
