class Shape {
    kind: i64
    constructor(kind: i64) {
        this.kind = kind
    }
    area() -> i64 {
        return 0
    }
}

class Rect extends Shape {
    w: i64
    h: i64
    constructor(w: i64, h: i64) {
        super(1)
        this.w = w
        this.h = h
    }
    area() -> i64 {
        return this.w * this.h
    }
}

var s = Shape(0)
print(s.kind)
print(s.area())

var r = Rect(3, 4)
print(r.kind)
print(r.area())
print(r.w)
print(r.h)
