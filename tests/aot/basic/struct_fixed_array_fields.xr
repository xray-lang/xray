struct Buf {
    data: [u8; 4]
    bias: i64
}

var buf = Buf{data: [1, 2, 3, 4], bias: 5}
buf.data[1] = 30
print((buf.data[0] as i64) + (buf.data[1] as i64) + (buf.data[2] as i64) +
    (buf.data[3] as i64) + buf.bias)

fn copy_last(n: i64) -> i64 {
    var local = Buf{data: [10, 20, 30, 40], bias: 7}
    var i = 0
    while (i < n) {
        local.data[0] = i as u8
        local.data[1] = local.data[0]
        i = i + 1
    }
    return (local.data[1] as i64) + local.bias
}

print(copy_last(260))
