struct Buf {
    data: [byte; 4]
    bias: int
}

var buf = Buf{data: [1, 2, 3, 4], bias: 5}
buf.data[1] = 30
print((buf.data[0] as int) + (buf.data[1] as int) + (buf.data[2] as int) +
    (buf.data[3] as int) + buf.bias)

fn copy_last(n: int) -> int {
    var local = Buf{data: [10, 20, 30, 40], bias: 7}
    var i = 0
    while (i < n) {
        local.data[0] = i as byte
        local.data[1] = local.data[0]
        i = i + 1
    }
    return (local.data[1] as int) + local.bias
}

print(copy_last(260))
