let values: Array<int> = []
values.push(1)
values.push(2)
print(values.length)
print(values.size)
print(values.length + values.size)

let seen: Set<int> = #[]
seen.add(1)
seen.add(2)
seen.add(1)
print(seen.length)
print(seen.size)
print(seen.length + seen.size)

let scores: Map<string, int> = #{}
scores.set("a", 10)
scores.set("b", 20)
print(scores.length)
print(scores.size)
print(scores.length + scores.size)
