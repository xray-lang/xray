interface Mutator {
    bump(value: ref i64) -> i64
    fill(value: ref i64) -> i64
}

class Stepper implements Mutator {
    step: i64

    constructor(step: i64) {
        this.step = step
    }

    bump(value: ref i64) -> i64 {
        value = value + this.step
        return value
    }

    fill(value: ref i64) -> i64 {
        value = this.step * 10
        return value
    }
}

class Doubler implements Mutator {
    constructor() {}

    bump(value: ref i64) -> i64 {
        value = value * 2
        return value
    }

    fill(value: ref i64) -> i64 {
        value = 40
        return value
    }
}

fn applyBump(mutator: ref Mutator, value: ref i64) -> i64 {
    return mutator.bump(ref value)
}

fn applyFill(mutator: ref Mutator, value: ref i64) -> i64 {
    return mutator.fill(ref value)
}

var selected: Mutator = Stepper(3)
var value = 4
print(applyBump(ref selected, ref value))
print(value)

selected = Doubler()
print(applyBump(ref selected, ref value))
print(value)

var output: i64
print(applyFill(ref selected, ref output))
print(output)
