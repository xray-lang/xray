fn fill(out: Bytes, src: Bytes) -> int {
    out.resize(4)
    unsafe {
        var p = out.dataMutPtrUnchecked()
        var sp = src.dataPtrUnchecked()
        p.copyFromNonOverlappingUnchecked(sp, 4)
    }
    return out[2]
}

var src = Bytes(4)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40

var bytes = Bytes.withCapacity(4)
print(fill(bytes, src))

var view: ByteSpan = bytes[:]
unsafe {
    var p = view.dataPtrUnchecked()
    print(p[1])
}
