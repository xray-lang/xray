fn fill(out: Array<byte>, src: Array<byte>) -> int {
    out.resize(4, 0)
    unsafe {
        var p = out.mutPtr()
        var sp = src.ptr()
        p.copyFromNonOverlapping(sp, 4)
    }
    return out[2]
}

var src = Array<byte>(4)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40

var bytes: Array<byte> = Array.withCapacity(4)
print(fill(bytes, src))

fn second(out: Array<byte>) -> int {
    var view: Slice<byte> = out[:]
    unsafe {
        var p = view.ptr()
        return int(p[1])
    }
}

print(second(bytes))
