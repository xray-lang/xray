print(keys[0] + keys[1])
print(values[0] + values[1])
print(m.delete(2))
print(m.containsKey(2))
print(m.get(2) == null)

class IntMapBag {
    values: Map<i64, i64>

    constructor() {
        var values: Map<i64, i64> = #{}
        this.values = values
    }

    fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set(i, i * 2 + 1)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64) -> i64 {
        var i = 0
        var sum = 0
        while (i < n) {
            if (this.values.containsKey(i)) {
                sum = sum + this.values.get(i)!
            }
            i = i + 1
        }
        return sum
    }

    prune(n: i64) -> i64 {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }
}

var bag = IntMapBag()
print(bag.fill(5))
print(bag.scan(5))
print(bag.prune(5))
print(bag.scan(5))
