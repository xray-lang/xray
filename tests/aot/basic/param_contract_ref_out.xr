// AOT ParamContract: local direct ref/out calls must write back caller slots.
fn bump(value: ref int) -> int {
    value = value + 1
    return value
}

fn fill(value: ref int) -> int {
    value = 9
    return value
}

fn initialize(value: ref int) {
    value = 42
}

fn runLocal() {
    var value = 1
    print(bump(ref value))
    print(value)

    var slot = 0
    print(fill(ref slot))
    print(slot)

    var initialized = 0
    initialize(ref initialized)
    print(initialized)
}

runLocal()
