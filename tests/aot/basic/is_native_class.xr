// `is` / `as` must answer identically under VM and AOT for source-defined net
// classes and prelude native classes. Source classes use runtime type identity;
// BigInt/StringBuilder use their dedicated native value tags.

import net
import { NetConn, NetListener } from net

fn isConn(x: NetConn | i64) -> bool { return x is NetConn }
fn isListener(x: NetListener | i64) -> bool { return x is NetListener }
fn isBig(x: BigInt | i64) -> bool { return x is BigInt }
fn isSb(x: StringBuilder | i64) -> bool { return x is StringBuilder }

fn describeBig(x: BigInt | i64) -> string {
    match (x) {
        is BigInt -> { return "big" }
        is i64 -> { return "int" }
    }
}

fn main() {
    print(isConn(1))
    print(isListener(2))
    print(isBig(3))
    print(isSb(4))

    print(isBig(123n))
    print(describeBig(45n))
    print(describeBig(6))
    var sb = StringBuilder()
    print(isSb(sb))

    var u: NetConn | i64 = 42
    var c = u as NetConn?
    print(c == null)

    var wide: i64 = 70000
    var small: i64 = 42
    print(small is i16)
    print(wide is i16)
    print(small is u64)
    print((-1) is u16)
    var clipped = wide as i16?
    print(clipped == null)
    var kept = small as i16?
    print(kept == null)

    var lst = net.listen(0, 8)
    print(isListener(lst))
    net.close(lst)
}

main()
