var flags: Map<i64, bool> = #{}
flags.set(1, true)
flags.set(2, false)
flags.set(3, true)
print(len(flags))
print(flags.get(1))
print(flags.get(2))
print(flags.containsKey(4))

var values = flags.values()
print(len(values))
print(values[0])

class BoolValueMapBag {
    values: Map<i64, bool>

    constructor() {
        var values: Map<i64, bool> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set(i, i % 3 == 0)
            i = i + 1
        }
        return len(this.values)
    }

    count(n: i64) -> i64 {
        var i = 0
        var total = 0
        while (i < n) {
            if (this.values.containsKey(i)) {
                if (this.values.get(i) == true) {
                    total = total + 1
                }
            }
            i = i + 1
        }
        return total
    }
}

var bag = BoolValueMapBag()
print(bag.fill(8))
print(bag.count(8))
