fn makeWildBytes() -> Bytes {
    var out = Bytes(4)
    out[0] = 65
    out[1] = 66
    out[2] = 67
    out[3] = 68
    out.repeatFrom(4, 8)
    out.appendFrom(out[4:12])

    return out
}

var out = makeWildBytes()
print(out.length)
print(string(out[4]) + "," + string(out[7]) + "," + string(out[12]) + "," + string(out[19]))
