fn caughtUtf8Invalid(bytes: Array<u8>) -> bool {
    try {
        string.fromUtf8(bytes[:])
    } catch (e: Utf8Error) {
        return e.toString() == "Utf8Error.InvalidUtf8"
    }
    return false
}

fn decodeStrict(bytes: Array<u8>) -> string {
    return string.fromUtf8(bytes[:])
}

fn caughtUtf8InvalidViaCall(bytes: Array<u8>) -> bool {
    try {
        decodeStrict(bytes)
    } catch (e: Utf8Error) {
        return e.toString() == "Utf8Error.InvalidUtf8"
    }
    return false
}

fn caughtInvalidByteRange(s: string, start: int, end: int) -> bool {
    try {
        s.sliceBytes(start, end)
    } catch (e: StringSliceError) {
        return e.toString() == "StringSliceError.InvalidByteRange"
    }
    return false
}

var ascii: Array<u8> = [104, 105]
var unicode: Array<u8> = [104, 195, 169]
var invalid: Array<u8> = [65, 255, 66]
print(string.fromUtf8(ascii[:]))
print(string.fromUtf8(unicode[:]))
var caught_invalid_utf8 = false
var invalid_utf8_error = ""
try {
    string.fromUtf8(invalid[:])
} catch (e: Utf8Error) {
    caught_invalid_utf8 = true
    invalid_utf8_error = e.toString()
}
print(caught_invalid_utf8)
print(invalid_utf8_error)
var overlongNul: Array<u8> = [192, 128]
var surrogateScalar: Array<u8> = [237, 160, 128]
var outOfRangeScalar: Array<u8> = [244, 144, 128, 128]
var invalidContinuation: Array<u8> = [226, 40, 161]
print(caughtUtf8Invalid(overlongNul))
print(caughtUtf8Invalid(surrogateScalar))
print(caughtUtf8Invalid(outOfRangeScalar))
print(caughtUtf8Invalid(invalidContinuation))
print(caughtUtf8InvalidViaCall(invalid))
print(string.fromUtf8Lossy(invalid[:]))
print(string.fromUtf8Lossy(invalidContinuation[:]))
var truncatedFour: Array<u8> = [240, 144, 128]
print(string.fromUtf8Lossy(truncatedFour[:]))
var validThenOutOfRange: Array<u8> = [65, 226, 130, 172, 244, 144, 128, 128, 66]
print(string.fromUtf8Lossy(validThenOutOfRange[:]))
var nonShortest: Array<u8> = [192, 175, 224, 128, 191, 240, 129, 130, 65]
print(string.fromUtf8Lossy(nonShortest[:]))
var surrogate: Array<u8> = [237, 160, 128, 65]
print(string.fromUtf8Lossy(surrogate[:]))
var truncated: Array<u8> = [225, 128, 226, 240, 145, 146, 241, 191, 65]
print(string.fromUtf8Lossy(truncated[:]))
print(ascii.toString())
print(string.fromRune('é'))
print(string.fromRune('🙂'))
print(string.join(["a", "β", "中"], "|"))
print(string.join(["a", "β", "中"]))
var s = "Aé中"
print(s.sliceBytes(0, 1))
print(s.sliceBytes(1, 3))
print(s.sliceBytes(3, 6))
print(caughtInvalidByteRange(s, -1, 1))
print(caughtInvalidByteRange(s, 3, 2))
var caught_mid_scalar = false
var mid_scalar_error = ""
try {
    s.sliceBytes(2, 3)
} catch (e: StringSliceError) {
    caught_mid_scalar = true
    mid_scalar_error = e.toString()
}
print(caught_mid_scalar)
print(mid_scalar_error)
var caught_oob = false
var oob_error = ""
try {
    s.sliceBytes(0, 7)
} catch (e: StringSliceError) {
    caught_oob = true
    oob_error = e.toString()
}
print(caught_oob)
print(oob_error)
