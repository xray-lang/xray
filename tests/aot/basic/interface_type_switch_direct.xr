interface Shape {
    area() -> int
}

class Circle implements Shape {
    r: int

    constructor(r: int) {
        this.r = r
    }

    area() -> int {
        return this.r * this.r
    }
}

class Square implements Shape {
    side: int

    constructor(side: int) {
        this.side = side
    }

    area() -> int {
        return this.side * this.side
    }
}

fn score(shape: Shape) -> int {
    return shape.area()
}

print(score(Circle(3)) + score(Square(4)))
