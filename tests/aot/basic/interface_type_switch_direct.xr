interface Shape {
    area() -> i64
}

class Circle implements Shape {
    r: i64

    constructor(r: i64) {
        this.r = r
    }

    area() -> i64 {
        return this.r * this.r
    }
}

class Square implements Shape {
    side: i64

    constructor(side: i64) {
        this.side = side
    }

    area() -> i64 {
        return this.side * this.side
    }
}

fn score(shape: Shape) -> i64 {
    return shape.area()
}

print(score(Circle(3)) + score(Square(4)))
