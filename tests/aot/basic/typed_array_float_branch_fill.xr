fn sum_float(n: int) -> float {
    var values: Array<float> = []
    var i = 0
    var x = 1.0
    while (i < n) {
        values.push(x)
        x = x + 0.25
        if (x > 2.0) {
            x = 1.0
        }
        i = i + 1
    }

    var sum = 0.0
    i = 0
    while (i < len(values)) {
        sum = sum + values[i]
        i = i + 1
    }
    return sum
}

fn sum_float32(n: int) -> float {
    var values: Array<f32> = []
    var i = 0
    var x = 1.0
    while (i < n) {
        values.push(x)
        x = x + 0.25
        if (x > 2.0) {
            x = 1.0
        }
        i = i + 1
    }

    var sum = 0.0
    i = 0
    while (i < len(values)) {
        sum = sum + values[i]
        i = i + 1
    }
    return sum
}

print(sum_float(12))
print(sum_float32(12))
