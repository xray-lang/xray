// AOT test: `ClassName(...)` construction must match the VM. Regression guard
// for class constructor lowering to XI_CALL_METHOD that previously fell through
// to AOT runtime method dispatch.
class Point {
    x: int
    y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }

    sum() -> int {
        return this.x + this.y
    }

    shift(dx: int) {
        this.x = this.x + dx
    }
}

let p = Point(3, 4)
print(p.sum())        // 7
p.shift(10)
print(p.sum())        // 17
print(p.x)            // 13

let q = Point(1, 1)
print(q.sum())        // 2
