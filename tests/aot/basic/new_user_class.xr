// AOT test: `ClassName(...)` construction must match the VM. Regression guard
// for class constructor lowering to XI_CALL_METHOD that previously fell through
// to AOT runtime method dispatch.
class Point {
    x: i64
    y: i64

    constructor(x: i64, y: i64) {
        this.x = x
        this.y = y
    }

    sum() -> i64 {
        return this.x + this.y
    }

    shift(dx: i64) {
        this.x = this.x + dx
    }
}

var p = Point(3, 4)
print(p.sum())        // 7
p.shift(10)
print(p.sum())        // 17
print(p.x)            // 13

var q = Point(1, 1)
print(q.sum())        // 2
