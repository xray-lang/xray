// AOT regression: loop PHI copies must use parallel assignment semantics.

fn distance_to_pivot(limit: int, pivot: int) -> int {
    let ip = 0
    let anchor = 0
    while (ip < limit) {
        if (ip == pivot) {
            return ip - anchor
        }
        if (ip == pivot + limit) {
            anchor = ip
        }
        ip = ip + 1
    }
    return -1
}

print(distance_to_pivot(8, 4))
