// AOT regression: loop PHI copies must use parallel assignment semantics.

fn distance_to_pivot(limit: i64, pivot: i64) -> i64 {
    var ip = 0
    var anchor = 0
    while (ip < limit) {
        if (ip == pivot) {
            return ip - anchor
        }
        if (ip == pivot + limit) {
            anchor = ip
        }
        ip = ip + 1
    }
    return -1
}

print(distance_to_pivot(8, 4))
