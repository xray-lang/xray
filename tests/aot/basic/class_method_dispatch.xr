// AOT test: method dispatch on typed class parameters.
// Verifies that INVOKE_DIRECT resolves methods correctly when
// the receiver is a function parameter with a class type annotation.

class Counter {
    value: i64
    constructor(init: i64) {
        this.value = init
    }
    get() -> i64 {
        return this.value
    }
    increment() -> i64 {
        this.value = this.value + 1
        return this.value
    }
}

fn use_counter(c: Counter) -> i64 {
    return c.get()
}

fn bump_counter(c: ref Counter) -> i64 {
    return c.increment()
}

// Direct method call (receiver created in same scope)
var c = Counter(10)
print(c.get())
print(c.increment())

// Method call through typed parameter
print(use_counter(c))
print(bump_counter(ref c))
print(c.get())
