class FillBag {
    values: Array<i64>

    constructor() {
        var values: Array<i64> = []
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var values: Array<i64> = []
        this.values = values

        var i = 0
        while (i < n) {
            this.values.push(i * 2 + 1)
            i = i + 1
        }

        var j = 0
        var total = 0
        while (j < len(this.values)) {
            total = total + this.values[j]
            j = j + 1
        }
        return total
    }

    at(i: i64) -> i64 {
        return this.values[i]
    }

    len() -> i64 {
        return len(this.values)
    }
}

var bag = FillBag()
print(bag.fill(6))
print(bag.len())
print(bag.at(5))
