fn read16(src: Slice<byte>, pos: int) -> int {
    var value: u16 = src.load<u16>(pos, Endian.LE)
    return int(value)
}

fn read32(src: Slice<byte>, pos: int) -> int {
    var value: u32 = src.load<u32>(pos, Endian.LE)
    return int(value)
}

fn read64(src: Slice<byte>, pos: int) -> int {
    var value: u64 = src.load<u64>(pos, Endian.LE)
    return int(value)
}

fn read32BE(src: Slice<byte>, pos: int) -> int {
    var value: u32 = src.load<u32>(pos, Endian.BE)
    return int(value)
}

fn write16LE(dst: ref Slice<byte>, pos: int, value: u16) {
    dst.store<u16>(pos, value, Endian.LE)
}

fn main() {
    var bytes: Array<byte> = Array.withCapacity(8)
    unsafe {
        bytes.push(1)
        bytes.push(2)
        bytes.push(3)
        bytes.push(4)
        bytes.push(5)
        bytes.push(6)
        bytes.push(7)
        bytes.push(8)
    }

    var view: Slice<byte> = bytes[:]
    print(read16(view, 0))
    print(read16(view, 3))
    print(read32(view, 0))
    print(read32(view, 1))
    print(read64(view, 0))
    print(read32BE(view, 2))
    write16LE(ref view, 6, 0x0a09)
    print(read16(view, 6))
}

main()
