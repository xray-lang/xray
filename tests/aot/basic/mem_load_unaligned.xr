import mem

fn readRaw(src: Slice<u8>) -> i64 {
    var value16: u16 = 0
    var value32: u32 = 0
    var value64: u64 = 0
    unsafe {
        var p = src.ptr()
        value16 = mem.load<u16>(p, 1, Endian.LE)
        value32 = mem.load<u32>(p, 0, Endian.LE)
        value64 = mem.load<u64>(p, 0, Endian.LE)
    }
    return (value16 as i64) + (value32 as i64) + (value64 as i64)
}

var bytes: Array<u8> = Array.withCapacity(8)
unsafe {
    bytes.push(1)
    bytes.push(2)
    bytes.push(3)
    bytes.push(4)
    bytes.push(5)
    bytes.push(6)
    bytes.push(7)
    bytes.push(8)
}

print(readRaw(bytes[:]))
