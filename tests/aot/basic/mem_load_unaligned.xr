import mem

fn readRaw(src: Slice<byte>) -> int {
    var value16: uint16 = 0
    var value32: uint32 = 0
    var value64: uint64 = 0
    unsafe {
        var p = src.ptr()
        value16 = mem.load<uint16>(p, 1, Endian.LE)
        value32 = mem.load<uint32>(p, 0, Endian.LE)
        value64 = mem.load<uint64>(p, 0, Endian.LE)
    }
    return int(value16) + int(value32) + int(value64)
}

var bytes: Array<byte> = Array.withCapacity(8)
unsafe {
    bytes.push(1)
    bytes.push(2)
    bytes.push(3)
    bytes.push(4)
    bytes.push(5)
    bytes.push(6)
    bytes.push(7)
    bytes.push(8)
}

print(readRaw(bytes[:]))
