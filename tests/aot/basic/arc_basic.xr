// AOT test: ARC lifecycle with class objects and control flow
class Pair {
    a: i64
    b: i64
    constructor(a: i64, b: i64) {
        this.a = a
        this.b = b
    }
}

fn make_pair(x: i64) -> Pair {
    return Pair(x, x * 2)
}

fn sum_pair(p: Pair) -> i64 {
    return p.a + p.b
}

// Create and pass class objects
var p1 = make_pair(5)
print(sum_pair(p1))      // 15

var p2 = make_pair(10)
print(sum_pair(p2))      // 30

// Multiple objects in expressions
print(sum_pair(p1) + sum_pair(p2))  // 45

// Conditional object creation
var x = 7
var p3 = make_pair(x)
print(p3.a)              // 7
print(p3.b)              // 14
