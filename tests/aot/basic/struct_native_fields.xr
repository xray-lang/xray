struct Sample {
    x: i64
    y: f64
    ok: bool
    b: u8
}

fn score() -> i64 {
    var p = Sample{x: 41, y: 2.5, ok: true, b: 30}
    p.x = p.x + 1
    p.b = p.b + 1
    if (p.ok) {
        return p.x + (p.b as i64)
    }
    return 0
}

fn measure() -> f64 {
    var p = Sample{x: 0, y: 2.5, ok: false, b: 0}
    return p.y
}

print(score())
print(measure())
