struct LargeState {
    lanes: [u64; 8]

    bump(index: int, delta: u64) {
        this.lanes[index] = this.lanes[index] + delta
    }

    read(index: int) -> u64 {
        return this.lanes[index]
    }
}

fn mutate(value: ref LargeState) {
    value.bump(7, 100)
}

fn exercise() -> u64 {
    var state = LargeState{lanes: [1, 2, 3, 4, 5, 6, 7, 8]}
    var snapshot = state

    state.bump(0, 10)
    mutate(ref state)

    var beforeReset = state.read(0) + state.read(7) + snapshot.read(0) + snapshot.read(7)

    state = LargeState{lanes: [10, 20, 30, 40, 50, 60, 70, 80]}
    state.bump(1, 5)
    return beforeReset + state.read(1) + snapshot.read(1)
}

print(exercise())
