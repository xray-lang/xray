type Pair = { x: i64, y: i64 }

var order = 0

fn mark(step: i64) -> i64 {
    order = order * 10 + step
    return step
}

fn source(step: i64, x: i64, y: i64) -> Pair {
    mark(step)
    return { x: x, y: y }
}

var merged = {
    ...source(1, 10, 11),
    y: mark(2),
    ...source(3, 30, 31),
    z: mark(4),
}

print(order)
print(merged.x)
print(merged.y)
print(merged.z)
