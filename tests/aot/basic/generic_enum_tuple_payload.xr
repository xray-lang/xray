// AOT test: generic enum payload keeps tuple type after match binding.

enum DecodeResult<T> {
    Ok(T),
    Err(string)
}

fn readPair() -> DecodeResult<(i64, i64)> {
    return DecodeResult.Ok((12, 34))
}

var r = readPair()
match (r) {
    DecodeResult.Ok(p) -> {
        print(p.0)
        print(p.1)
    }
    DecodeResult.Err(e) -> {
        print(e)
    }
}

match (readPair()) {
    DecodeResult.Ok((a, b)) -> {
        print(a + b)
    }
    DecodeResult.Err(e) -> {
        print(e)
    }
}

