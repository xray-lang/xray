// AOT test: generic enum payload keeps tuple type after match binding.

enum DecodeResult<T> {
    Ok { value: T },
    Err { error: string }
}

fn readPair() -> DecodeResult<(i64, i64)> {
    return DecodeResult.Ok { value: (12, 34) }
}

var r = readPair()
match (r) {
    DecodeResult.Ok { value: p } -> {
        print(p.0)
        print(p.1)
    }
    DecodeResult.Err { error: e } -> {
        print(e)
    }
}

match (readPair()) {
    DecodeResult.Ok { value: (a, b) } -> {
        print(a + b)
    }
    DecodeResult.Err { error: e } -> {
        print(e)
    }
}

