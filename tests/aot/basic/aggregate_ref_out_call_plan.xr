struct Pair {
    left: int
    right: int
}

class Box {
    value: int

    constructor(value: int) {
        this.value = value
    }
}

fn replaceArray(values: ref Array<int>) {
    values = [7, 8, 9]
}

fn fillArray(values: out Array<int>) {
    values = [4, 5]
}

fn replacePair(pair: ref Pair) {
    pair = Pair{left: pair.left + 10, right: pair.right + 20}
}

fn fillPair(pair: out Pair) {
    pair = Pair{left: 30, right: 40}
}

fn replaceBox(box: ref Box) {
    box = Box(box.value + 5)
}

fn fillBox(box: out Box) {
    box = Box(50)
}

var values = [1, 2]
replaceArray(ref values)
print(values[0])
print(len(values))

var outputValues: Array<int> = []
fillArray(out outputValues)
print(outputValues[1])
print(len(outputValues))

var pair = Pair{left: 1, right: 2}
replacePair(ref pair)
print(pair.left)
print(pair.right)

var outputPair: Pair
fillPair(out outputPair)
print(outputPair.left)
print(outputPair.right)

var box = Box(5)
replaceBox(ref box)
print(box.value)

var outputBox = Box(0)
fillBox(out outputBox)
print(outputBox.value)

const arrayAction = replaceArray
var indirectValues = [2]
arrayAction(ref indirectValues)
print(indirectValues[2])

const pairAction = fillPair
var indirectPair = Pair{left: 0, right: 0}
pairAction(out indirectPair)
print(indirectPair.right)

const boxAction = replaceBox
var indirectBox = Box(10)
boxAction(ref indirectBox)
print(indirectBox.value)
