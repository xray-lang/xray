class RefCtorBase {
    value: int = 0

    constructor(value: ref int) {
        value = value + 1
        this.value = value
    }
}

class RefCtorChild extends RefCtorBase {
    constructor(value: ref int) {
        super(ref value)
    }
}

class OutMethodBase {
    fill(value: ref int) {
        value = 42
    }
}

class OutMethodChild extends OutMethodBase {
    forward(value: ref int) {
        super.fill(ref value)
    }
}

class OutCtorBase {
    constructor(value: ref int) {
        value = 7
    }
}

class OutCtorChild extends OutCtorBase {
    constructor(value: ref int) {
        super(ref value)
    }
}

var direct = 1
var base = RefCtorBase(ref direct)
print(direct)
print(base.value)

var forwarded = 10
var child = RefCtorChild(ref forwarded)
print(forwarded)
print(child.value)

var methodOut = 0
OutMethodChild().forward(ref methodOut)
print(methodOut)

var ctorOut = 0
OutCtorChild(ref ctorOut)
print(ctorOut)
