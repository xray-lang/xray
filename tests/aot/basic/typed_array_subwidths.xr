fn run() -> i64 {
    var i8s: Array<i8> = []
    var i16s: Array<i16> = []
    var u16s: Array<u16> = []
    var u32s: Array<u32> = []

    i8s.push(127)
    i8s.push(127 + 1)
    i16s.push(32767)
    i16s.push(32767 + 1)
    u16s.push(65535)
    u16s.push(65535 + 1)
    u32s.push(4294967295)
    u32s.push(4294967295 + 1)

    return (i8s[0] as i64) + (i8s[1] as i64) + (i16s[0] as i64) +
        (i16s[1] as i64) + (u16s[0] as i64) + (u16s[1] as i64) +
        (u32s[0] as i64) + (u32s[1] as i64)
}

print(run())
