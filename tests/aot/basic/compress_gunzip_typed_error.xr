import compress

fn textOf(data: Array<u8>) -> string {
    return string.fromUtf8(data[:])!
}

fn invalidGunzipError() -> string {
    var payload = "not gzip"
    try {
        compress.gunzip(payload.bytes())
        return "no-error"
    } catch (e: CompressionError) {
        return e.toString()
    }
}

fn invalidInflateError() -> string {
    var payload = "not deflate"
    try {
        compress.inflate(payload.bytes())
        return "no-error"
    } catch (e: CompressionError) {
        return e.toString()
    }
}

fn invalidZlibDecompressError() -> string {
    var payload = "not zlib"
    try {
        compress.zlibDecompress(payload.bytes())
        return "no-error"
    } catch (e: CompressionError) {
        return e.toString()
    }
}

var text = "typed native gzip error"
var gz = compress.gzip(text.bytes())
print(textOf(compress.gunzip(gz[:])) == text)
print(invalidGunzipError())

var raw = "typed native inflate error"
var deflated = compress.deflate(raw.bytes())
print(textOf(compress.inflate(deflated[:])) == raw)
print(invalidInflateError())

var wrapped = "typed native zlib error"
var zlibbed = compress.zlibCompress(wrapped.bytes())
print(textOf(compress.zlibDecompress(zlibbed[:])) == wrapped)
print(invalidZlibDecompressError())
