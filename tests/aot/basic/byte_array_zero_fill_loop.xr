fn makeByteArray(n: i64) -> Array<u8> {
    var out = Array<u8>(0)
    var i = 0
    while (i < n) {
        out.push((i & 0xFF) as u8)
        i = i + 1
    }
    return out
}

fn appendToSized(n: i64) -> Array<u8> {
    var out = Array<u8>(3)
    out[0] = 100
    out[1] = 101
    out[2] = 102
    var i = 0
    while (i < n) {
        out.push((i & 0xFF) as u8)
        i = i + 1
    }
    return out
}

var a = makeByteArray(16)
print(len(a))
print(a[7])

var b = appendToSized(5)
print(len(b))
print(b[0])
print(b[3])
print(b[7])
