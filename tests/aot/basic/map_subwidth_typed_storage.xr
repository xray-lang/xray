var m: Map<uint8, int32> = #{}
m.set(255, 2147483647)
m.set(255 + 1, 2147483647 + 1)
m.set(1, -2147483648 - 1)
print(m.length)
print(m.size)
print(m.has(0))
print(m.get(0))
print(m.get(1))

var keys = m.keys()
var values = m.values()
print(keys.length)
print(keys[0] + keys[1] + keys[2])
print(values[0] + values[1] + values[2])
print(m.delete(255))
print(m.has(255))
print(m.get(255) == null)

class ByteMapBag {
    values: Map<uint8, int32>

    constructor() {
        var values: Map<uint8, int32> = #{}
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.set(i, i * 2 + 1)
            i = i + 1
        }
        return this.values.size
    }

    scan(n: int) -> int {
        var i = 0
        var sum = 0
        while (i < n) {
            if (this.values.has(i)) {
                sum = sum + this.values.get(i)
            }
            i = i + 1
        }
        return sum
    }

    prune(n: int) -> int {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + this.values.length
    }
}

var bag = ByteMapBag()
print(bag.fill(5))
print(bag.scan(5))
print(bag.prune(5))
print(bag.scan(5))
