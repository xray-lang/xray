var m: Map<u8, i32> = #{}
m.set(255, 2147483647)
m.set(255 + 1, 2147483647 + 1)
m.set(1, -2147483648 - 1)
print(len(m))
print(len(m))
print(m.containsKey(0))
print(m.get(0))
print(m.get(1))

var keys = m.keys()
var values = m.values()
print(len(keys))
print(keys[0] + keys[1] + keys[2])
print(values[0] + values[1] + values[2])
print(m.delete(255))
print(m.containsKey(255))
print(m.get(255) == null)

class ByteMapBag {
    values: Map<u8, i32>

    constructor() {
        var values: Map<u8, i32> = #{}
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.set(i as u8, (i * 2 + 1) as i32)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64) -> i64 {
        var i = 0
        var sum = 0
        while (i < n) {
            if (this.values.containsKey(i as u8)) {
                sum = sum + this.values.get(i as u8)!
            }
            i = i + 1
        }
        return sum
    }

    ref prune(n: i64) -> i64 {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i as u8)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }
}

var bag = ByteMapBag()
print(bag.fill(5))
print(bag.scan(5))
print(bag.prune(5))
print(bag.scan(5))
