let b = Bytes(16)
b[0] = 1
b[1] = 2
b[2] = 3
b[3] = 4
b[4] = 5
b[5] = 6
b[6] = 7
b[7] = 8

let view: ByteSpan = b
let u32: uint32 = view.loadLE<uint32>(0)
let u64: uint64 = view.loadLE<uint64>(0)
print(int(u32))
print(int(u64))

let dst = Bytes.withCapacity(6)
print(dst.length)
print(dst.capacity)
unsafe {
    dst.appendFromUnchecked(view, 1, 3)
}
print(dst[0])
print(dst[1])
print(dst[2])

let rep = Bytes.withCapacity(9)
let seed = Bytes(3)
seed[0] = 65
seed[1] = 66
seed[2] = 67
unsafe {
    rep.appendFromUnchecked(seed, 0, 3)
    rep.repeatFromUnchecked(3, 6)
}
print(rep[3])
print(rep[4])
print(rep[5])
print(rep[6])
print(rep[7])
print(rep[8])

let xs = Array<int>(4, 9)
print(xs.length)
print(xs[0])
print(xs[3])

let u: uint32 = 4294967295
let wrapped = u + 1
print(wrapped)

let assigned: uint32 = 4294967295 + 1
print(assigned)

let byte: uint8 = 255
let byte_wrapped = byte + 1
print(byte_wrapped)
