// AOT basic test: control flow
fn abs_val(x: i64) -> i64 {
    if (x < 0) {
        return -x
    }
    return x
}

fn max_of(a: i64, b: i64) -> i64 {
    if (a > b) {
        return a
    }
    return b
}

fn sum_to(n: i64) -> i64 {
    var total = 0
    var i = 1
    while (i <= n) {
        total = total + i
        i = i + 1
    }
    return total
}

print(abs_val(-42))
print(max_of(10, 20))
print(sum_to(100))
