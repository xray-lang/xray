import strconv

import text

// AOT test: comprehensive builtin methods (string, array, map, number)

// --- String new methods ---
var s = "  hello  "
print(text.trimStart(s))        // hello
print(text.trimEnd(s))          //   hello

print("hello".runes().nth(1))    // e
print("hello" + " world") // hello world
print("hello".lastIndexOf("l")) // 3
print("hello".bytes()[0])    // 104

print("aabaa".replaceAll("a", "x"))  // xxbxx
print("hello".slice(1, 4))       // ell
print(text.padStart("42", 5, "0"))         // 00042
print(text.padEnd("hi", 5, "!"))           // hi!!!

print(strconv.parseInt("123"))         // 123
print(strconv.parseFloat("3.14"))      // 3.14
print("A".bytes()[0])             // 65
print(text.reverseRunes("hello"))     // olleh

// --- Array new methods ---
var arr = [3, 1, 2]
arr.unshift(0)
print(arr[0])               // 0
print(len(arr))           // 4

var first = arr.shift()
print(first)                // 0
print(len(arr))           // 3

var arr2 = [0, 0, 0]
arr2.fill(7)
print(arr2[0])              // 7
print(arr2[1])              // 7
print(arr2[2])              // 7

// --- Number new methods ---
var x = 3.14159
print(x.toFixed(2))         // 3.14

var a = 5
var b = 10
print(a.max(b))             // 10
print(a.min(b))             // 5

var hex = 255
print(hex.toHex())          // ff
