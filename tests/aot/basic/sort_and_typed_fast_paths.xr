// AOT test: sort correctness (typed/boxed/comparator) and the typed
// fill/indexOf fast paths. Run as a VM/AOT diff: outputs must match.

// --- int array sort: duplicates, reverse, already sorted ---
let ints: Array<int> = [5, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
ints.sort()
print(ints.join(","))           // 1,1,2,3,4,5,5,5,5,6,9

let rev: Array<int> = []
let i = 100
while (i > 0) {
    rev.push(i)
    i = i - 1
}
rev.sort()
print(rev[0])                   // 1
print(rev[99])                  // 100

// Large array exercises the deep recursion / ninther pivot path.
let big: Array<int> = []
let seed = 42
i = 0
while (i < 5000) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    big.push(seed % 1000)
    i = i + 1
}
big.sort()
let sorted = true
i = 1
while (i < 5000) {
    if (big[i - 1] > big[i]) {
        sorted = false
    }
    i = i + 1
}
print(sorted)                   // true
print(big[0] <= big[2500])      // true

// --- float array sort ---
let floats: Array<float> = [3.5, -1.25, 0.0, 2.5, -1.25, 10.125]
floats.sort()
print(floats[0])                // -1.25
print(floats[5])                // 10.125

// --- string array sort (content ordering, dynamic strings) ---
let strs: Array<string> = []
strs.push("banana")
strs.push("apple" + "")
strs.push("cherry")
strs.push("apple")
strs.sort()
print(strs.join("|"))           // apple|apple|banana|cherry

// --- comparator: descending ints, and by string length ---
let desc: Array<int> = [3, 1, 4, 1, 5, 9, 2, 6]
desc.sort(fn(a: int, b: int) -> int { return b - a })
print(desc.join(","))           // 9,6,5,4,3,2,1,1

// --- typed fill fast path ---
let filled: Array<int> = [1, 2, 3, 4, 5]
filled.fill(7)
print(filled.join(","))         // 7,7,7,7,7

// --- typed indexOf / includes fast paths ---
let nums: Array<int> = [10, 20, 30, 40, 50]
print(nums.indexOf(30))         // 2
print(nums.indexOf(99))         // -1
print(nums.includes(40))        // true
print(nums.includes(41))        // false

let fnums: Array<float> = [1.5, 2.5, 3.5]
print(fnums.indexOf(2.5))       // 1
print(fnums.indexOf(9.5))       // -1
