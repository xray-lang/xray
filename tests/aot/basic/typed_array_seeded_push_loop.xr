fn copyRepeated(matchLen: int) -> Array<uint8> {
    var out: Array<uint8> = []
    out.push(65)
    var matchPos = 0
    var i = 0
    while (i < matchLen) {
        out.push(out[matchPos + i])
        i = i + 1
    }
    return out
}

var copied = copyRepeated(63)
print(copied.length)
print(copied[0])
print(copied[63])
