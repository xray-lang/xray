// AOT test: collection methods (B.5)

// --- String methods ---
var s = "  Hello World  "
print(s.trim())           // Hello World
print("hello".toUpperCase())  // HELLO
print("HELLO".toLowerCase())  // hello

// split
var parts = "a,b,c".split(",")
print(len(parts))       // 3
print(parts[0])           // a
print(parts[1])           // b
print(parts[2])           // c

// replace
print("hello world".replace("world", "xray"))  // hello xray

// repeat
print("ab".repeat(3))    // ababab

// indexOf
print("hello".indexOf("ll"))  // 2
print("hello".indexOf("zz"))  // -1

// includes, startsWith, endsWith
print("hello".contains("ell"))     // true
print("hello".startsWith("he"))    // true
print("hello".endsWith("lo"))      // true

// slice
print("hello".slice(1, 3))  // el
print("hello".slice(2))     // llo

// --- Array methods ---
var arr = [10, 20, 30, 40, 50]

// indexOf
print(arr.indexOf(30))    // 2
print(arr.indexOf(99))    // -1

// includes
print(arr.contains(20))   // true
print(arr.contains(99))   // false

// slice expression
var sub: Slice<int> = arr[1:3]
print(len(sub))         // 2
print(sub[0])             // 20
print(sub[1])             // 30

// join
print([1, 2, 3].join(", "))  // 1, 2, 3

// reverse
var rev = [1, 2, 3]
rev.reverse()
print(rev[0])             // 3
print(rev[1])             // 2
print(rev[2])             // 1

// --- Map methods ---
var m = #{"a": 1, "b": 2, "c": 3}
var keys = m.keys()
print(len(keys))        // 3

var vals = m.values()
print(len(vals))        // 3

// has / get / delete
print(m.containsKey("b"))         // true
print(m.get("a"))         // 1
m.delete("b")
print(m.containsKey("b"))         // false

// --- Set methods ---
var st: Set<int> = #[]
st.add(1)
st.add(2)
st.add(1)
print(len(st))          // 2
print(st.contains(2))          // true
print(st.delete(2))       // true
print(st.contains(2))          // false
var stVals = st.values()
print(len(stVals))      // 1
print(stVals[0])          // 1
