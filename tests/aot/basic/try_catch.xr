// AOT test: try-catch over the value-return error channel + defer cleanup.
// Output is validated by diffing the VM and AOT runs.

enum AppErr {
    Bad(code: i64)
}

fn test_normal() -> i64 {
    var result = 0
    try {
        result = 10
    } catch (e) {
        result = -1
    }
    return result
}

fn test_caught() -> i64 {
    var result = 0
    try {
        throw AppErr.Bad(7)
        result = 10
    } catch (e) {
        match (e) { AppErr.Bad(c) -> { result = c } }
    }
    return result
}

fn test_defer_cleanup() -> i64 {
    var log: Array<i64> = []
    fn body() {
        defer { log.push(100) }
        throw AppErr.Bad(1)
    }
    try { body() } catch (e) { log.push(1) }
    return log[0] + log[1]
}

print(test_normal())         // 10
print(test_caught())         // 7
print(test_defer_cleanup())  // 101
