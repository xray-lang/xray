// AOT test: defer statement support
// Tests basic defer, multiple defers (LIFO), and late-bound local reads.

fn test_basic() -> int {
    var result = 0
    defer { result = 99 }
    result = 42
    return result
}

fn test_multi_defer() -> int {
    var order = 0
    defer { order = order + 1 }
    defer { order = order + 10 }
    defer { order = order + 100 }
    return order
}

fn test_defer_late_binding() -> int {
    var x = 0
    defer { x = 1 }
    return x
}

print(test_basic())
print(test_multi_defer())
print(test_defer_late_binding())
