fn makeCursorByteArray() -> Array<u8> {
    var src = Array<u8>(4)
    src[0] = 65
    src[1] = 66
    src[2] = 67
    src[3] = 68

    var out: Array<u8> = Array.withCapacity(8)
    out.resize(8, 0)
    var prefix: Slice<u8> = out[0:4]
    prefix.copyFrom(src[:])
    var full: Slice<u8> = out[0:8]
    full.repeatFrom(4, 4, 4)

    return out
}

var out = makeCursorByteArray()
print(len(out))
print(string(out[0]) + "," + string(out[3]) + "," + string(out[4]) + "," + string(out[7]))
