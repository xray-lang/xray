fn readWhileOwnerGrows(view: ByteSpan, owner: Bytes) -> int {
    let before = int(view[0])
    let i = 0
    while (i < 4096) {
        owner.push(i & 0xFF)
        i = i + 1
    }
    return before + int(view[0]) + view.length
}

let bytes = Bytes(4)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4

print(readWhileOwnerGrows(bytes[1:3], bytes))
