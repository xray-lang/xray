fn readWhileOwnerGrows(view: Slice<u8>, owner: ref Array<u8>) -> i64 {
    var before = (view[0] as i64)
    var i = 0
    while (i < 4096) {
        owner.push((i & 0xFF) as u8)
        i = i + 1
    }
    return before + (view[0] as i64) + len(view)
}

var bytes = Array<u8>(4)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4

var scratch = Array<u8>(4)
print(readWhileOwnerGrows(bytes[1:3], ref scratch))
