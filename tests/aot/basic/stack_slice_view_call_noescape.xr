fn readWhileOwnerGrows(view: Slice<byte>, owner: ref Array<byte>) -> int {
    var before = int(view[0])
    var i = 0
    while (i < 4096) {
        owner.push(i & 0xFF)
        i = i + 1
    }
    return before + int(view[0]) + len(view)
}

var bytes = Array<byte>(4)
bytes[0] = 1
bytes[1] = 2
bytes[2] = 3
bytes[3] = 4

var scratch = Array<byte>(4)
print(readWhileOwnerGrows(bytes[1:3], ref scratch))
