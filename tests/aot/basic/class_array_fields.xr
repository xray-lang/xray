class IntBag {
    values: Array<i64>

    constructor(values: Array<i64>) {
        this.values = values
    }

    sum() -> i64 {
        var i = 0
        var total = 0
        while (i < len(this.values)) {
            total = total + this.values[i]
            i = i + 1
        }
        return total
    }

    append(x: i64) -> i64 {
        this.values.push(x)
        return len(this.values)
    }
}

fn make_values(n: i64) -> Array<i64> {
    var values: Array<i64> = []
    var i = 0
    while (i < n) {
        values.push(i + 1)
        i = i + 1
    }
    return values
}

var bag = IntBag(make_values(5))
print(bag.sum())
print(bag.append(6))
print(bag.sum())
