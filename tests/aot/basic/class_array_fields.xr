class IntBag {
    values: Array<int>

    constructor(values: Array<int>) {
        this.values = values
    }

    sum() -> int {
        let i = 0
        let total = 0
        while (i < this.values.length) {
            total = total + this.values[i]
            i = i + 1
        }
        return total
    }

    append(x: int) -> int {
        this.values.push(x)
        return this.values.length
    }
}

fn make_values(n: int) -> Array<int> {
    let values: Array<int> = []
    let i = 0
    while (i < n) {
        values.push(i + 1)
        i = i + 1
    }
    return values
}

let bag = IntBag(make_values(5))
print(bag.sum())
print(bag.append(6))
print(bag.sum())
