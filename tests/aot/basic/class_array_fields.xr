class IntBag {
    values: Array<int>

    constructor(values: Array<int>) {
        this.values = values
    }

    sum() -> int {
        var i = 0
        var total = 0
        while (i < len(this.values)) {
            total = total + this.values[i]
            i = i + 1
        }
        return total
    }

    append(x: int) -> int {
        this.values.push(x)
        return len(this.values)
    }
}

fn make_values(n: int) -> Array<int> {
    var values: Array<int> = []
    var i = 0
    while (i < n) {
        values.push(i + 1)
        i = i + 1
    }
    return values
}

var bag = IntBag(make_values(5))
print(bag.sum())
print(bag.append(6))
print(bag.sum())
