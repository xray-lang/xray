// AOT test: string operations
var a = "hello"
var b = " world"
var c = a + b
print(c)                // hello world

// Multi-concat
print("x" + "y" + "z") // xyz

// String interpolation
var n = 42
print("num=${n}")       // num=42

// String length
print(len(a))         // 5
print(len(c))         // 11

// Repeated concat
var s = "ab"
var t = s + s + s
print(t)                // ababab
print(len(t))         // 6

fn lowByteAt(text: string, index: i64) -> i64 {
    return (text.runes().nth(index).toUInt32() & 0xFF) as i64
}

print(lowByteAt("abc", 0)) // 97
