// AOT test: string operations
var a = "hello"
var b = " world"
var c = a + b
print(c)                // hello world

// Multi-concat
print("x" + "y" + "z") // xyz

// String interpolation
var n = 42
print("num=${n}")       // num=42

// String length
print(a.length)         // 5
print(c.length)         // 11

// Repeated concat
var s = "ab"
var t = s + s + s
print(t)                // ababab
print(t.length)         // 6

fn lowByteAt(text: string, index: int) -> int {
    return text.codePointAt(index) & 0xFF
}

print(lowByteAt("abc", 0)) // 97
