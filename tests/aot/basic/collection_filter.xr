// AOT test: collection operations (map, filter, typed arrays)
var nums = [10, 20, 30, 40, 50, 60]

// Length
print(len(nums))

// Typed array access
print(nums[0])
print(nums[2])
print(nums[4])

// Push
nums.push(70)
print(len(nums))

// Map: double each element
var doubled = nums.map(fn(x: i64) -> i64 { return x * 2 })
print(len(doubled))
print(doubled[0])
print(doubled[3])

// Filter: keep elements > 30
var big = nums.filter(fn(x: i64) -> bool { return x > 30 })
print(len(big))
print(big[0])
print(big[2])
