class ScoreBag {
    scores: Map<string, i64>

    constructor() {
        var scores: Map<string, i64> = #{}
        this.scores = scores
    }

    ref put(name: string, score: i64) -> i64 {
        this.scores.set(name, score)
        return score
    }

    score(name: string) -> i64 {
        return this.scores.get(name) ?? -1
    }

    contains(name: string) -> bool {
        return this.scores.containsKey(name)
    }

    ref remove(name: string) -> bool {
        return this.scores.delete(name)
    }
}

var bag = ScoreBag()
print(bag.put("alice", 9))
print(bag.put("bob", 7))
print(bag.score("alice"))
print(bag.contains("bob"))
print(bag.remove("bob"))
print(bag.contains("bob"))
