var src = Array<byte>(6)
src[0] = 10
src[1] = 20
src[2] = 30
src[3] = 40
src[4] = 50
src[5] = 60

var out = Array<byte>.withCapacity(12)
out.appendFrom(src[1:4])
out.repeatFrom(2, 4)

print(len(out))
print(out.capacity)
print(out[0])
print(out[1])
print(out[2])
print(out[3])
print(out[4])
print(out[5])
print(out[6])
