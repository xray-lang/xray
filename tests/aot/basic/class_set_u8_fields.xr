class ByteSetBag implements Lengthable {
    values: Set<byte>

    constructor() {
        var values: Set<byte> = #[]
        this.values = values
    }

    fill(n: int) -> int {
        var i = 0
        while (i < n) {
            this.values.add(i as byte)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: int) -> int {
        var i = 0
        var hits = 0
        while (i < n) {
            if (this.values.contains(i as byte)) {
                hits = hits + i
            }
            i = i + 1
        }
        return hits
    }

    prune(n: int) -> int {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i as byte)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }

    operator len() -> int {
        return len(this.values)
    }
}

var bag = ByteSetBag()
print(bag.fill(64))
print(bag.scan(64))
print(bag.prune(64))
print(bag.scan(64))
print(len(bag))
