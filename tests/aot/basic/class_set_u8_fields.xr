class ByteSetBag implements Lengthable {
    values: Set<u8>

    constructor() {
        var values: Set<u8> = #[]
        this.values = values
    }

    ref fill(n: i64) -> i64 {
        var i = 0
        while (i < n) {
            this.values.add(i as u8)
            i = i + 1
        }
        return len(this.values)
    }

    scan(n: i64) -> i64 {
        var i = 0
        var hits = 0
        while (i < n) {
            if (this.values.contains(i as u8)) {
                hits = hits + i
            }
            i = i + 1
        }
        return hits
    }

    ref prune(n: i64) -> i64 {
        var i = 0
        var removed = 0
        while (i < n) {
            if (this.values.delete(i as u8)) {
                removed = removed + 1
            }
            i = i + 2
        }
        return removed + len(this.values)
    }

    operator len() -> i64 {
        return len(this.values)
    }
}

var bag = ByteSetBag()
print(bag.fill(64))
print(bag.scan(64))
print(bag.prune(64))
print(bag.scan(64))
print(len(bag))
