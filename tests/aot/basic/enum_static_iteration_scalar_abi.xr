enum ScalarColor {
    Red,
    Green,
    Blue
}

type ScalarBoundary = ScalarColor | i64

fn identityColor(value: ScalarColor) -> ScalarColor {
    return value
}

fn eraseColor(value: ScalarColor) -> ScalarColor | i64 {
    return value
}

fn restoreColor(value: ScalarColor | i64) -> ScalarColor {
    if (value is ScalarColor) {
        return value as ScalarColor
    }
    return ScalarColor.Red
}

var score = 0
for (color in ScalarColor) {
    score += identityColor(color).ordinal
}
print(score)
var erased = eraseColor(ScalarColor.Blue)
print(erased is ScalarColor)
var restored = restoreColor(erased)
print(restored.name)
print(restored.ordinal)
print(restored == ScalarColor.Blue)
var boundaries: Array<ScalarColor | i64> = [eraseColor(ScalarColor.Green), 41, eraseColor(ScalarColor.Red)]
print(restoreColor(boundaries[0]).name)
print(restoreColor(boundaries[1]).name)
print(restoreColor(boundaries[2]).ordinal)
