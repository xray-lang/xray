var counts: Map<bool, i64> = #{}
counts.set(true, 7)
counts.set(false, 11)
counts.set(true, 13)
print(len(counts))
print(len(counts))
print(counts.get(true))
print(counts.get(false))
print(counts.containsKey(false))

var keys = counts.keys()
var values = counts.values()
print(len(keys))
print(len(values))
print(values[0] + values[1])
print(counts.delete(false))
print(counts.containsKey(false))
print(counts.get(false) == null)

class BoolKeyMapBag {
    values: Map<bool, i64>

    constructor() {
        var values: Map<bool, i64> = #{}
        this.values = values
    }

    fill() -> i64 {
        this.values.set(true, 21)
        this.values.set(false, 34)
        return len(this.values)
    }

    scan(rounds: i64) -> i64 {
        var r = 0
        var sum = 0
        while (r < rounds) {
            if (this.values.containsKey(true)) {
                sum = sum + this.values.get(true)!
            }
            if (this.values.containsKey(false)) {
                sum = sum + this.values.get(false)!
            }
            r = r + 1
        }
        return sum
    }

    prune() -> i64 {
        if (this.values.delete(false)) {
            return len(this.values)
        }
        return 0
    }
}

var bag = BoolKeyMapBag()
print(bag.fill())
print(bag.scan(4))
print(bag.prune())
print(bag.scan(4))
