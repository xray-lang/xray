let a = Array<int>(4, 0)
a[0] = 10
a[1] = 20
a[2] = 30
a[3] = 40
let s: Span<int> = a[1:4]
assert_eq(s.length, 3)
assert_eq(s.size, 3)
assert_eq(s[0], 20)
s[1] = 99
assert_eq(s[1], 99)
let nested: Span<int> = s[1:3]
assert_eq(nested.length, 2)
assert_eq(nested[0], 99)
let src = Bytes(4)
src[0] = 1
src[1] = 2
src[2] = 3
src[3] = 4
let bs: ByteSpan = src[1:3]
assert_eq(bs.length, 2)
assert_eq(bs[0], 2)
let sum = 0
for (x in s) {
    sum = sum + x
}
assert_eq(sum, 159)
print("span aot surface passed")
