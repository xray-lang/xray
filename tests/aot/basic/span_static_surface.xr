fn run() {
    var a = Array<i64>(4, 0)
    a[0] = 10
    a[1] = 20
    a[2] = 30
    a[3] = 40
    var s: Slice<i64> = a[1:4]
    assertEqual(len(s), 3)
    assertEqual(len(s), 3)
    assertEqual(s[0], 20)
    s[1] = 99
    assertEqual(s[1], 99)
    var nested: Slice<i64> = s[1:3]
    assertEqual(len(nested), 2)
    assertEqual(nested[0], 99)
    var src = Array<u8>(4)
    src[0] = 1
    src[1] = 2
    src[2] = 3
    src[3] = 4
    var bs: Slice<u8> = src[1:3]
    assertEqual(len(bs), 2)
    assertEqual(bs[0], 2)
    var sum = 0
    for (x in s) {
        sum = sum + x
    }
    assertEqual(sum, 159)
    print("span aot surface passed")
}

run()
