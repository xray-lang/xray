// Closing a hosted AOT listener must retire its scheduler PollDesc before the
// operating system reuses the descriptor for a new connection.
import net
import os
var triggerPort = i64.tryParse(os.getenv("XRAY_TRIGGER_PORT")!)!
var statusPort = i64.tryParse(os.getenv("XRAY_STATUS_PORT")!)!
var trigger = net.listen(triggerPort, 1)!
var retiredFd = net.fd(trigger)
var control = net.accept(trigger)!
var tokenBytes = net.readBytes(control, 1)!
var token = string.fromUtf8(tokenBytes[:])!
assert(token == "x")
net.close(control)
net.close(trigger)
var status = net.dial("127.0.0.1", statusPort, net.DialOptions(5000))
assert(net.fd(status) == retiredFd)
var reportBytes = net.readBytes(status, 128)!
var report = string.fromUtf8(reportBytes[:])!
net.close(status)
assert(report == "fd-reuse-ok\n")
print(report)
