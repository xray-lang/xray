struct Totals {
    count: int
    sum: int
}

fn reduceTotals(n: int) -> int {
    let zero = Totals{count: 0, sum: 0}
    let total = parallel range reduce begin, end in 0..n workers 3 worker wid
        init zero
        combine (a: Totals, b: Totals) -> Totals{count: a.count + b.count, sum: a.sum + b.sum} {
        let count = 0
        let sum = 0
        let i = begin
        while (i < end) {
            count = count + 1
            sum = sum + i
            i = i + 1
        }
        Totals{count: count + (wid * 0), sum: sum}
    }

    return total.count + total.sum
}

let scalar = parallel range reduce begin, end in 0..10 workers 3
    init 0
    combine (a: int, b: int) -> a + b {
    end - begin
}

print(reduceTotals(10))
print(scalar)
