fn check() -> i64 {
    Coro.yield()
    if (!__file__.endsWith("script_info_runtime.xr")) {
        return 1
    }
    if (len(__dir__) <= 0) {
        return 2
    }
    if (!process.file.endsWith("script_info_runtime.xr")) {
        return 3
    }
    if (len(process.dir) <= 0) {
        return 4
    }
    if (len(process.args) != 0) {
        return 5
    }
    return 0
}

var task = go check()
print(await task)
