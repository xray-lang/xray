import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
var WORKERS = len(process.args) > 0 ? (i64.tryParse(process.args[0]) ?? 8) : 8
var TASKS = len(process.args) > 1 ? (i64.tryParse(process.args[1]) ?? 320) : 320
var ITERS = len(process.args) > 2 ? (i64.tryParse(process.args[2]) ?? 10) : 10

if (WORKERS < 1) {
    WORKERS = 1
}
if (TASKS < 0) {
    TASKS = 0
}
if (ITERS < 0) {
    ITERS = 0
}

const queue: WorkQueue<i64> = WorkQueue<i64>(WORKERS, 64)

fn worker(id: i64) -> i64 {
    var sum = 0
    while (true) {
        var item = queue.pop(id)
        if (item == null) {
            return sum
        }
        var value = item
        sum = sum + value
    }
    return sum
}

var workers: Array<Task<i64>> = []
var w = 0
while (w < WORKERS) {
    workers.push(go worker(w))
    w = w + 1
}

var expected = 0
var i = 0
while (i < ITERS) {
    var task = 0
    while (task < TASKS) {
        var value = i * TASKS + task
        expected = expected + value
        assert_true(queue.push(value, task % WORKERS))
        task = task + 1
    }
    i = i + 1
}
queue.close()

var actual = 0
w = 0
while (w < len(workers)) {
    var subtotal: i64 = await workers[w]
    actual = actual + subtotal
    w = w + 1
}

print(actual)
print(expected)
print(actual == expected)
