import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
var WORKERS = process.args.length > 0 ? (int(process.args[0]) ?? 8) : 8
var SIZE = process.args.length > 1 ? (int(process.args[1]) ?? 1048576) : 1048576
var ITERS = process.args.length > 2 ? (int(process.args[2]) ?? 10) : 10
var BLOCK = process.args.length > 3 ? (int(process.args[3]) ?? 32768) : 32768

if (WORKERS < 1) {
    WORKERS = 1
}
if (SIZE < 0) {
    SIZE = 0
}
if (ITERS < 0) {
    ITERS = 0
}
if (BLOCK < 1) {
    BLOCK = 1
}

fn makeBytes(n: int) -> Bytes {
    var out = Bytes(0)
    var i = 0
    while (i < n) {
        out.push((i * 31 + (i >> 3) + 17) & 0xFF)
        i = i + 1
    }
    return out
}

fn blockCountFor(size: int, blockSize: int) -> int {
    if (size <= 0) {
        return 0
    }
    return (size + blockSize - 1) / blockSize
}

fn blockLenAt(size: int, blockSize: int, index: int) -> int {
    var start = index * blockSize
    var len = size - start
    if (len > blockSize) {
        return blockSize
    }
    return len
}

fn checksum(span: ByteSpan) -> int {
    var h = 2166136261
    var i = 0
    while (i < span.length) {
        var b = 0
        unsafe {
            b = int(span.getUnchecked(i))
        }
        h = ((h ^ b) * 16777619) & 0xFFFFFFFF
        i = i + 1
    }
    return h
}

fn pack(sum: int, count: int) -> int {
    return (sum << 32) | (count & 0xFFFFFFFF)
}

fn unpackSum(packed: int) -> int {
    return packed >> 32
}

fn unpackCount(packed: int) -> int {
    return packed & 0xFFFFFFFF
}

fn worker(src: Bytes, queue: WorkQueue<int>, id: int, blockSize: int) -> int {
    var sum = 0
    var count = 0
    while (true) {
        var item = queue.pop(id)
        if (item == null) {
            return pack(sum, count)
        }
        var index = item
        var start = index * blockSize
        var len = blockLenAt(src.length, blockSize, index)
        var chunk: ByteSpan = src[start:start + len]
        sum = (sum + checksum(chunk)) & 0xFFFFFFFF
        count = count + 1
    }
    return pack(sum, count)
}

var src = makeBytes(SIZE)
var blocks = blockCountFor(src.length, BLOCK)
shared sharedSrc = copy(src)
shared queue: WorkQueue<int> = WorkQueue<int>(WORKERS, 1024)

var tasks: Array<Task> = []
var w = 0
while (w < WORKERS) {
    tasks.push(go worker(sharedSrc, queue, w, BLOCK))
    w = w + 1
}

var expectedCount = 0
var i = 0
while (i < ITERS) {
    var b = 0
    while (b < blocks) {
        assert_true(queue.push(b, b % WORKERS))
        expectedCount = expectedCount + 1
        b = b + 1
    }
    i = i + 1
}
queue.close()

var actualCount = 0
var actualSum = 0
w = 0
while (w < tasks.length) {
    var packed: int = await tasks[w]
    actualCount = actualCount + unpackCount(packed)
    actualSum = (actualSum + unpackSum(packed)) & 0xFFFFFFFF
    w = w + 1
}

print(actualCount)
print(expectedCount)
print(actualCount == expectedCount)
print(actualSum != 0 || expectedCount == 0)
