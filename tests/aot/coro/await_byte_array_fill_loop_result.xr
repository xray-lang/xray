fn makeSample(n: i64) -> Array<u8> {
    var out = Array<u8>(0)
    var i = 0
    while (i < n) {
        out.push(((i * 3) & 0xFF) as u8)
        i = i + 1
    }
    return out
}

fn worker(n: i64) -> Array<u8> {
    return makeSample(n)
}

var t = go worker(1024)
var data = await t
print(len(data))
print(data[7])
