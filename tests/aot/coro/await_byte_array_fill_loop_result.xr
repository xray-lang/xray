fn makeSample(n: int) -> Array<byte> {
    var out = Array<byte>(0)
    var i = 0
    while (i < n) {
        out.push(((i * 3) & 0xFF) as byte)
        i = i + 1
    }
    return out
}

fn worker(n: int) -> Array<byte> {
    return makeSample(n)
}

var t = go worker(1024)
var data = await t
print(len(data))
print(data[7])
