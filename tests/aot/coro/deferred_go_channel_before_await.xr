fn recvInt(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn worker(ch: Channel<i64>, value: i64) -> i64 {
    ch.send(value)
    return value + 1
}

fn run() -> i64 {
    const ch: Channel<i64> = Channel(1)
    var tasks: Array<Task<i64>> = []
    tasks.push(go worker(ch, 41))
    var received = recvInt(ch)
    var results = await all tasks
    ch.close()
    return received + results[0]
}

print(run())
