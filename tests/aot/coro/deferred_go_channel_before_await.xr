fn recvInt(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> -1
    }
}

fn worker(ch: Channel<int>, value: int) -> int {
    ch.send(value)
    return value + 1
}

fn run() -> int {
    shared ch: Channel<int> = Channel(1)
    var tasks: Array<Task<int>> = []
    tasks.push(go worker(ch, 41))
    var received = recvInt(ch)
    var results = await all tasks
    ch.close()
    return received + results[0]
}

print(run())
