let ch = Channel<int>(2)

select {
    100 to ch -> { print("sent 100") }
    _ -> { print("send failed") }
}

select {
    200 to ch -> { print("sent 200") }
    _ -> { print("send failed") }
}

select {
    300 to ch -> { print("sent 300") }
    _ -> { print("buffer full") }
}

let r1 = ch.tryRecv()
let r2 = ch.tryRecv()
print(match (r1) {
    Recv.Value(v) -> v
    _ -> -1
})
print(match (r2) {
    Recv.Value(v) -> v
    _ -> -1
})
print(match (r1) {
    Recv.Value(_) -> true
    _ -> false
} && match (r2) {
    Recv.Value(_) -> true
    _ -> false
})
ch.close()
print("done")
