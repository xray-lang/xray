fn makeSample(n: int) -> Array<byte> {
    var out = Array<byte>(0)
    var i = 0
    while (i < n) {
        out.push(i & 0xFF)
        i = i + 1
    }
    return out
}

shared data = makeSample(1024)

fn worker(offset: int) -> int {
    return int(data[offset])
}

var t1 = go worker(7)
var t2 = go worker(255)
print(await t1)
print(await t2)
