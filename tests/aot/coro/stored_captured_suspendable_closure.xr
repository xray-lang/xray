class WorkerBox {
    worker: fn() -> i64

    constructor(worker: fn() -> i64) {
        this.worker = worker
    }

    run() -> i64 {
        var current = this.worker
        return current()
    }
}

fn make_worker(base: i64) -> fn() -> i64 {
    return fn() -> i64 {
        return yield_then_add(base)
    }
}

fn yield_then_add(base: i64) -> i64 {
    Coro.yield()
    return base + 1
}

var box = WorkerBox(make_worker(40))
print(box.run())
