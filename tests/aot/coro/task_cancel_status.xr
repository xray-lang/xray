fn wait_for_value(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> -1
    }
}

fn quick_value(n: i64) -> i64 {
    Coro.yield()
    return n * 2
}

fn task_done(task: Task<i64>) -> bool {
    return task.done
}

fn task_status(task: Task<i64>) -> TaskStatus {
    return task.status
}

fn task_poll(task: ref Task<i64>) -> TaskResult<i64> {
    return task.poll()
}

const ch = Channel<i64>(0)
var blocked = go wait_for_value(ch)
blocked.cancel()
var cancelled_result = blocked.awaitResult()
print(blocked.done)
print(blocked.status)
print(cancelled_result)
ch.close()

var quick = go quick_value(21)
var quick_result = await quick
quick.cancel()
print(quick.done)
print(quick.status)
print(quick.poll())
print(quick.awaitResult())
print(quick_result)
print(task_done(quick))
print(task_status(quick))
print(task_poll(ref quick))
