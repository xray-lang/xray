fn square_after_yield(n: int) -> int {
    Coro.yield()
    return n * n
}

fn recv_then_return(ch: Channel<int>, n: int) -> int {
    ch.recv()
    return n
}

var t1 = go square_after_yield(2)
var t2 = go square_after_yield(3)
var t3 = go square_after_yield(4)
var results = await all [t1, t2, t3]
print(results[0] + results[1] + results[2])

shared ch1 = Channel<int>(0)
shared ch2 = Channel<int>(1)
var a = go recv_then_return(ch1, 10)
var b = go recv_then_return(ch2, 20)
ch2.send(1)
var first = await any [a, b]
print(first)
ch1.send(1)
var last = await a
print(last)
ch1.close()
ch2.close()
