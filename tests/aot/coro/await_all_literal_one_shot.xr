fn worker(n: int) -> int {
    Coro.yield()
    return n + 1
}

var total = 0
for (var i = 0; i < 2000; i++) {
    var t1 = go worker(1)
    var t2 = go worker(2)
    var t3 = go worker(3)
    var t4 = go worker(4)
    var results = await all [t1, t2, t3, t4]
    total = total + results[0] + results[1] + results[2] + results[3]
}

print(total)
