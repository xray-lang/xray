let ch = Channel<int>(1)

print(ch.trySend(7))
print(ch.trySend(8))

let r1 = ch.tryRecv()
print(match (r1) {
    Recv.Value(v) -> v
    _ -> -1
})
print(match (r1) {
    Recv.Value(_) -> true
    _ -> false
})

let r2 = ch.tryRecv()
print(match (r2) {
    Recv.Value(_) -> true
    _ -> false
})

ch.close()
print(ch.isClosed)
