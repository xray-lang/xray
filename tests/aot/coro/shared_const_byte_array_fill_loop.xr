fn makeSample(n: i64) -> Array<u8> {
    var out = Array<u8>(0)
    var i = 0
    while (i < n) {
        out.push((i & 0xFF) as u8)
        i = i + 1
    }
    return out
}

const data = makeSample(1024)

fn worker(offset: i64) -> i64 {
    return (data[offset] as i64)
}

var t1 = go worker(7)
var t2 = go worker(255)
print(await t1)
print(await t2)
