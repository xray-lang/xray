fn read_zero(ch: Channel<int>) -> int {
    match (ch.recv()) {
        Recv.Value(value) -> {
            return value
        }
        _ -> {
            return -1
        }
    }
}

fn read_closed(ch: Channel<int>) -> int {
    match (ch.recv()) {
        Recv.Closed -> {
            return 1
        }
        _ -> {
            return 0
        }
    }
}

shared zero_ch = Channel<int>(1)
zero_ch.send(0)
var zero_task = go read_zero(zero_ch)
print(await zero_task)

shared closed_ch = Channel<int>(0)
closed_ch.close()
var closed_task = go read_closed(closed_ch)
print(await closed_task)
