fn send_timeout_worker(ch: Channel<int>, timeout_ms: int, value: int) -> bool {
    return match (ch.sendTimeout(value, timeout_ms)) {
        SendResult.Timeout -> true
        _ -> false
    }
}

fn run_once(count: int, timeout_ms: int) -> int {
    const ch = Channel(1)
    ch.send(1)

    var tasks: Array<Task> = []
    for (var i = 0; i < count; i++) {
        tasks.push(go send_timeout_worker(ch, timeout_ms, i + 2))
    }

    var timeouts = 0
    for (task in tasks) {
        if (await task) {
            timeouts++
        }
    }

    var _drain = ch.recv()
    ch.close()
    return timeouts
}

var count = 10000
var ok = true
for (var round = 0; round < 3; round++) {
    if (run_once(count, 10) != count) {
        ok = false
    }
}

print(ok)
