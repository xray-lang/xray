fn worker(ch: Channel<Array<i64>>) -> i64 {
    var xs: Array<i64> = match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> Array<i64>(0)
    }
    xs.push(99)
    Coro.yield()
    return len(xs)
}

const ch = Channel<Array<i64>>(1)
var xs = [1, 2]
ch.send(copy(xs))
var task = go worker(ch)
var child_len = await task
print(child_len)
print(len(xs))
ch.close()
