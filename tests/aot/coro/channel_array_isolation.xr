fn worker(ch: Channel<Array<int>>) -> int {
    let xs = match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> []
    }
    xs.push(99)
    yield
    return xs.length
}

let ch = Channel<Array<int>>(1)
let xs = [1, 2]
ch.send(copy(xs))
let task = go worker(ch)
let child_len = await task
print(child_len)
print(xs.length)
ch.close()
