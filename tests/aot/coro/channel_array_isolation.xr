fn worker(ch: Channel<Array<int>>) -> int {
    var xs = match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> []
    }
    xs.push(99)
    Coro.yield()
    return len(xs)
}

const ch = Channel<Array<int>>(1)
var xs = [1, 2]
ch.send(copy(xs))
var task = go worker(ch)
var child_len = await task
print(child_len)
print(len(xs))
ch.close()
