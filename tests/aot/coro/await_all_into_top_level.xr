fn worker(n: i64) -> i64 {
    Coro.yield()
    return n * n
}

var tasks: Array<Task<i64>> = []
var results: Array<i64> = []
tasks.reserve(4)
results.reserve(4)

var i = 0
while (i < 4) {
    tasks.push(go worker(i))
    i = i + 1
}

await all tasks into results

var sum = 0
i = 0
while (i < len(results)) {
    sum = sum + results[i]
    i = i + 1
}

print(sum)
