fn worker(src: Array<u8>) -> i64 {
    return (src[0] as i64)
}

fn child(src: Array<u8>) {
    const alias = copy(src)
    var task = go worker(alias)
    print(await task)
}

fn runMode(mode: string, src: Array<u8>) {
    if (mode == "parallel") {
        child(src)
    } else {
        print(0)
    }
}

var data = Array<u8>(0)
data.push(42)
var mode = len(process.args) > 0 ? process.args[0] : "parallel"
runMode(mode, data)
