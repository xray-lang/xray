fn worker(src: Array<byte>) -> int {
    return int(src[0])
}

fn child(src: Array<byte>) {
    const alias = copy(src)
    var task = go worker(alias)
    print(await task)
}

fn runMode(mode: string, src: Array<byte>) {
    if (mode == "parallel") {
        child(src)
    } else {
        print(0)
    }
}

var data = Array<byte>(0)
data.push(42)
var mode = len(process.args) > 0 ? process.args[0] : "parallel"
runMode(mode, data)
