fn send_int(ch: Channel<int>) {
    ch.send(41)
}

shared buffered = Channel<int>(1)
buffered.send(9)
var buffered_value = buffered.recv()
print(match (buffered_value) {
    Recv.Value(value) -> value + 1
    _ -> -1
})
buffered.close()

shared rendezvous = Channel<int>(0)
var task = go send_int(rendezvous)
var direct_value = rendezvous.recv()
await task
print(match (direct_value) {
    Recv.Value(value) -> value + 1
    _ -> -1
})
rendezvous.close()
