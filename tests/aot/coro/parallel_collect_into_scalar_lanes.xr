const bias = 2

let floats: Array<float> = []
floats.reserve(8)
parallel for i in 0..4 workers 2 collect into floats {
    float(i + bias) + 0.5
}
print(floats.length)
print(floats[0])
print(floats[3])

let flags: Array<bool> = []
flags.reserve(8)
parallel for i in 0..4 workers 2 collect into flags {
    ((i + bias) % 2) == 0
}
print(flags.length)
print(flags[0])
print(flags[1])

let bytes: Array<uint8> = []
bytes.reserve(8)
fn byteValue() -> uint8 {
    return 2
}
parallel for i in 0..4 workers 2 collect into bytes {
    byteValue()
}
print(bytes.length)
print(bytes[0])
print(bytes[3])
