fn captured_sync_go(x: i64) -> i64 {
    fn inner() -> i64 {
        return x * 7
    }

    var task = go inner()
    var result = await task
    return result ?? -1
}

fn captured_suspend_go(x: i64) -> i64 {
    fn inner() -> i64 {
        Coro.yield()
        return x + 1
    }

    var task = go inner()
    var result = await task
    return result ?? -1
}

fn nested_captured_suspend_go(x: i64) -> i64 {
    fn mid() -> i64 {
        fn inner() -> i64 {
            Coro.yield()
            return x + 2
        }

        var task = go inner()
        var result = await task
        return result ?? -1
    }

    var task = go mid()
    var result = await task
    return result ?? -1
}

var sync_task = go captured_sync_go(6)
print(await sync_task)

var suspend_task = go captured_suspend_go(41)
print(await suspend_task)

var nested_task = go nested_captured_suspend_go(40)
print(await nested_task)
