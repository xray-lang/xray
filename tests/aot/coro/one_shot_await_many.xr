fn worker(n: int) -> int {
    return n + 1
}

var total = 0
for (var i = 0; i < 20000; i++) {
    var t1 = go worker(1)
    var t2 = go worker(2)
    var t3 = go worker(3)
    var t4 = go worker(4)
    total = total + await t1
    total = total + await t2
    total = total + await t3
    total = total + await t4
}

print(total)
