fn sent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

fn recv_array(ch: Channel<Array<int>>) -> Array<int> {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> []
    }
}

const send_ch: Channel<Array<int>> = Channel(1)
var xs = [1, 2]
send_ch.send(copy(xs))
xs.push(3)
var got_send = recv_array(send_ch)
got_send.push(99)
print(len(xs))
print(len(got_send))
send_ch.close()

const try_ch: Channel<Array<int>> = Channel(1)
var ys = [4, 5]
print(sent(try_ch.trySend(copy(ys))))
ys.push(6)
var got_try = recv_array(try_ch)
print(len(ys))
print(len(got_try))
try_ch.close()

const timeout_ch: Channel<Array<int>> = Channel(1)
var zs = [7, 8]
print(sent(timeout_ch.sendTimeout(copy(zs), 0)))
zs.push(9)
var got_timeout = recv_array(timeout_ch)
print(len(zs))
print(len(got_timeout))
timeout_ch.close()

const move_ch: Channel<Array<int>> = Channel(1)
var moved = [10, 11]
move_ch.send(copy(moved))
var got_move = recv_array(move_ch)
print(len(got_move))
print(got_move[0])
move_ch.close()
