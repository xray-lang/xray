fn worker(n: int) -> int {
    Coro.yield()
    return n * n
}

fn evenWorker(n: int) -> bool {
    Coro.yield()
    return (n & 1) == 0
}

fn run() {
    var tasks: Array<Task<int>> = []
    var results: Array<int> = []
    tasks.reserve(4)
    results.reserve(4)

    var i = 0
    while (i < 4) {
        tasks.push(go worker(i))
        i = i + 1
    }

    await all tasks into results
    var sum = 0
    i = 0
    while (i < len(results)) {
        sum = sum + results[i]
        i = i + 1
    }
    print(sum)

    tasks.clear()
    results.push(999)
    i = 0
    while (i < 2) {
        tasks.push(go worker(i + 4))
        i = i + 1
    }

    await all tasks into results
    sum = 0
    i = 0
    while (i < len(results)) {
        sum = sum + results[i]
        i = i + 1
    }
    print(len(results))
    print(sum)

    var boolTasks: Array<Task<bool>> = []
    var boolResults: Array<bool> = []
    boolTasks.reserve(4)
    boolResults.reserve(4)

    i = 0
    while (i < 4) {
        boolTasks.push(go evenWorker(i))
        i = i + 1
    }

    await all boolTasks into boolResults
    var trueCount = 0
    i = 0
    while (i < len(boolResults)) {
        if (boolResults[i]) {
            trueCount = trueCount + 1
        }
        i = i + 1
    }
    print(trueCount)
}

run()
