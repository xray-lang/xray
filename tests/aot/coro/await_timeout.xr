fn wait_for_value(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> -1
    }
}

fn quick_value(n: i64) -> i64 {
    Coro.yield()
    return n * 2
}

const ch = Channel<i64>(0)
var blocked = go wait_for_value(ch)
var timed_out = blocked.awaitTimeout(1)
print(match (timed_out) {
    TaskResult.Timeout -> true
    _ -> false
})
ch.close()

var quick = go quick_value(21)
var value = quick.awaitTimeout(1000)
print(match (value) {
    TaskResult.Success(v) -> v
    _ -> -1
})
