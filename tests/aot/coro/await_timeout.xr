fn wait_for_value(ch: Channel<int>) -> int {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> -1
    }
}

fn quick_value(n: int) -> int {
    yield
    return n * 2
}

let ch = Channel<int>(0)
let blocked = go wait_for_value(ch)
let timed_out = blocked.awaitTimeout(1)
print(match (timed_out) {
    TaskResult.Timeout -> true
    _ -> false
})
ch.close()

let quick = go quick_value(21)
let value = quick.awaitTimeout(1000)
print(match (value) {
    TaskResult.Success(v) -> v
    _ -> -1
})
