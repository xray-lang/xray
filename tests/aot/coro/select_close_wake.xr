fn wait_select_close(ch: Channel<i64>, ready: Channel<i64>, done: Channel<i64>) -> i64 {
    ready.send(1)
    select {
        value from ch -> {
        }
    }
    done.send(1)
    return 1
}

const ch = Channel<i64>(0)
const ready = Channel<i64>(0)
const done = Channel<i64>(1)

go wait_select_close(ch, ready, done)
print(match (ready.recv()) {
    Recv.Value(value) -> value
    _ -> -1
})

for (var i = 0; i < 16; i++) {
    Coro.yield()
}

ch.close()
var result = done.recvTimeout(2000)
print(match (result) {
    Recv.Value(value) -> value
    _ -> -1
})
print(match (result) {
    Recv.Value(_) -> true
    _ -> false
})
ready.close()
done.close()
