fn wait_select_close(ch: Channel<int>, ready: Channel<int>, done: Channel<int>) -> int {
    ready.send(1)
    select {
        value from ch -> {
        }
    }
    done.send(1)
    return 1
}

let ch = Channel<int>(0)
let ready = Channel<int>(0)
let done = Channel<int>(1)

go wait_select_close(ch, ready, done)
print(match (ready.recv()) {
    Recv.Value(value) -> value
    _ -> -1
})

for (let i = 0; i < 16; i++) {
    Coro.yield()
}

ch.close()
let result = done.recvTimeout(2000)
print(match (result) {
    Recv.Value(value) -> value
    _ -> -1
})
print(match (result) {
    Recv.Value(_) -> true
    _ -> false
})
ready.close()
done.close()
