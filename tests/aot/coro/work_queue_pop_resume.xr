import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
shared queue: WorkQueue<int> = WorkQueue<int>(1, 4)

fn consumer() -> int {
    var first = queue.pop(0)
    var second = queue.pop(0)
    var third = queue.pop(0)
    return (first ?? 0) + (second ?? 0) + (third ?? 0)
}

var task = go consumer()
assert_true(queue.push(10, 0))
assert_true(queue.push(20, 0))
queue.close()

print(await task)
