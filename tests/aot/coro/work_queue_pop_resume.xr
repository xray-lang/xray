shared const queue: WorkQueue<int> = WorkQueue<int>(1, 4)

fn consumer() -> int {
    let first = queue.pop(0)
    let second = queue.pop(0)
    let third = queue.pop(0)
    return (first ?? 0) + (second ?? 0) + (third ?? 0)
}

let task = go consumer()
assert_true(queue.push(10, 0))
assert_true(queue.push(20, 0))
queue.close()

print(await task)
