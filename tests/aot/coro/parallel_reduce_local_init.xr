fn main() {
    var total = parallel reduce i in 0..8 workers 4 worker wid
        local acc = wid
        init 0
        combine (a: int, b: int) -> a + b {
        acc = acc + i
        acc
    }

    print(total)

    var captured = 10
    var total2 = parallel reduce i in 0..4 workers 2 worker wid
        local acc = captured + wid
        init 0
        combine (a: int, b: int) -> a + b {
        acc = acc + i
        acc
    }

    print(total2)

    var empty = parallel reduce i in 5..5 workers 4
        local acc = 99
        init 123
        combine (a: int, b: int) -> a + b {
        acc = acc + i
        acc
    }

    print(empty)
}

main()
