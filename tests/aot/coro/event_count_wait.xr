shared const event = EventCount(0)

print(event.epoch)
print(event.advance())
print(event.wait(0))

shared const ready = CountdownLatch(1)
let t = go fn() -> int {
    ready.done()
    return event.wait(1, 0)
}()

print(ready.wait())
print(event.advance())
print(await t)

shared const closed = EventCount(3)
shared const closeReady = CountdownLatch(1)
let closeTask = go fn() -> int {
    closeReady.done()
    return closed.wait(3)
}()

print(closeReady.wait())
closed.close()
print(closed.isClosed)
print(await closeTask)
print(closed.advance())
