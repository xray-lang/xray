fn compute(n: int) -> int {
    return n * n
}

fn report(label: string, ch: Channel<string>) -> string {
    yield
    ch.send(label)
    return label
}

let t1 = go compute(3)
Coro.setPriority(t1, 0)
print(await t1)

let ch = new Channel<string>(1)
let t2 = go(priority: Coro.LOW) report("L", ch)
Coro.setPriority(t2, 2)
print(await t2)
ch.close()
