fn recv_once(ch: Channel<i64>) -> i64 {
    return match (ch.recv()) {
        Recv.Value(value) -> value
        _ -> -1
    }
}

fn caller(ch: Channel<i64>) -> i64 {
    var value = recv_once(ch)
    return value + 1
}

const ch = Channel(1)
ch.send(41)
var task = go caller(ch)
print(await task)
ch.close()
