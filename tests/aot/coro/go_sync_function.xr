fn compute(n: i64) -> i64 {
    return n * n
}

fn mutate_copy(xs: move Array<i64>) -> i64 {
    xs.push(99)
    return len(xs)
}

fn identity_copy(xs: move Array<i64>) -> Array<i64> {
    return xs
}

var high = go(name: "compute") compute(5)
print(await high)

var xs = [1, 2]
var copied = go mutate_copy(copy(xs))
print(await copied)
print(len(xs))

var roundtrip = go identity_copy(copy(xs))
var ys = await roundtrip
ys.push(7)
print(len(ys))
print(len(xs))
