fn compute(n: int) -> int {
    return n * n
}

fn mutate_copy(xs: Array<int>) -> int {
    xs.push(99)
    return xs.length
}

fn identity_copy(xs: Array<int>) -> Array<int> {
    return xs
}

var high = go(name: "compute") compute(5)
print(await high)

var xs = [1, 2]
var copied = go mutate_copy(copy(xs))
print(await copied)
print(xs.length)

var roundtrip = go identity_copy(copy(xs))
var ys = await roundtrip
ys.push(7)
print(ys.length)
print(xs.length)
