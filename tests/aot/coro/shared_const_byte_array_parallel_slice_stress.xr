import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
var WORKERS = len(process.args) > 0 ? (i64.tryParse(process.args[0]) ?? 8) : 8
var SIZE = len(process.args) > 1 ? (i64.tryParse(process.args[1]) ?? 1048576) : 1048576
var ITERS = len(process.args) > 2 ? (i64.tryParse(process.args[2]) ?? 10) : 10
var BLOCK = len(process.args) > 3 ? (i64.tryParse(process.args[3]) ?? 32768) : 32768

if (WORKERS < 1) {
    WORKERS = 1
}
if (SIZE < 0) {
    SIZE = 0
}
if (ITERS < 0) {
    ITERS = 0
}
if (BLOCK < 1) {
    BLOCK = 1
}

fn makeByteArray(n: i64) -> Array<u8> {
    var out = Array<u8>(0)
    var i = 0
    while (i < n) {
        out.push(((i * 31 + (i >> 3) + 17) & 0xFF) as u8)
        i = i + 1
    }
    return out
}

fn blockCountFor(size: i64, blockSize: i64) -> i64 {
    if (size <= 0) {
        return 0
    }
    return (size + blockSize - 1) / blockSize
}

fn blockLenAt(size: i64, blockSize: i64, index: i64) -> i64 {
    var start = index * blockSize
    var count = size - start
    if (count > blockSize) {
        return blockSize
    }
    return count
}

fn checksum(span: Slice<u8>) -> i64 {
    var h = 2166136261
    var i = 0
    while (i < len(span)) {
        var b = 0
        unsafe {
            b = (span.get(i) as i64)
        }
        h = ((h ^ b) * 16777619) & 0xFFFFFFFF
        i = i + 1
    }
    return h
}

fn pack(sum: i64, count: i64) -> i64 {
    return (sum << 32) | (count & 0xFFFFFFFF)
}

fn unpackSum(bits: i64) -> i64 {
    return bits >> 32
}

fn unpackCount(bits: i64) -> i64 {
    return bits & 0xFFFFFFFF
}

fn worker(src: Array<u8>, queue: WorkQueue<i64>, id: i64, blockSize: i64) -> i64 {
    var sum = 0
    var count = 0
    while (true) {
        var item = queue.pop(id)
        if (item == null) {
            return pack(sum, count)
        }
        var index = item
        var start = index * blockSize
        var chunkLen = blockLenAt(len(src), blockSize, index)
        var chunk: Slice<u8> = src[start:start + chunkLen]
        sum = (sum + checksum(chunk)) & 0xFFFFFFFF
        count = count + 1
    }
    return pack(sum, count)
}

var src = makeByteArray(SIZE)
var blocks = blockCountFor(len(src), BLOCK)
const sharedSrc = copy(src)
const queue: WorkQueue<i64> = WorkQueue<i64>(WORKERS, 1024)

var tasks: Array<Task<i64>> = []
var w = 0
while (w < WORKERS) {
    tasks.push(go worker(sharedSrc, queue, w, BLOCK))
    w = w + 1
}

var expectedCount = 0
var i = 0
while (i < ITERS) {
    var b = 0
    while (b < blocks) {
        assert(queue.push(b, b % WORKERS))
        expectedCount = expectedCount + 1
        b = b + 1
    }
    i = i + 1
}
queue.close()

var actualCount = 0
var actualSum = 0
w = 0
while (w < len(tasks)) {
    var packedBits: i64 = await tasks[w]
    actualCount = actualCount + unpackCount(packedBits)
    actualSum = (actualSum + unpackSum(packedBits)) & 0xFFFFFFFF
    w = w + 1
}

print(actualCount)
print(expectedCount)
print(actualCount == expectedCount)
print(actualSum != 0 || expectedCount == 0)
