shared const sem = Semaphore(0)
shared const ready = CountdownLatch(2)
shared const counter = Atomic(0)

fn worker(id: int) -> int {
    ready.done()
    if (!sem.acquire()) {
        return -id
    }
    counter.add(id)
    return id
}

let t1 = go worker(7)
let t2 = go worker(11)

print(ready.wait())
sem.release(2)
let r1: int = await t1
let r2: int = await t2
print(r1 + r2)
print(counter.load())
print(sem.available)

sem.release()
print(sem.available)
print(sem.tryAcquire())
print(sem.available)

shared const closedSem = Semaphore(0)
shared const closeReady = CountdownLatch(1)
let closedTask = go fn() -> int {
    closeReady.done()
    return closedSem.acquire() ? 1 : -1
}()

print(closeReady.wait())
closedSem.close()
print(closedSem.isClosed)
print(await closedTask)
print(closedSem.acquire())
