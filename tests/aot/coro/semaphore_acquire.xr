import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
const sem = Semaphore(0)
const ready = CountdownLatch(2)
const counter = Atomic(0)

fn worker(id: i64) -> i64 {
    ready.done()
    if (!sem.acquire()) {
        return -id
    }
    counter.add(id)
    return id
}

var t1 = go worker(7)
var t2 = go worker(11)

print(ready.wait())
sem.release(2)
var r1: i64 = await t1
var r2: i64 = await t2
print(r1 + r2)
print(counter.load())
print(sem.available)

sem.release()
print(sem.available)
print(sem.tryAcquire())
print(sem.available)

const closedSem = Semaphore(0)
const closeReady = CountdownLatch(1)
var closedTask = go fn() -> i64 {
    closeReady.done()
    return closedSem.acquire() ? 1 : -1
}()

print(closeReady.wait())
closedSem.close()
print(closedSem.isClosed)
print(await closedTask)
print(closedSem.acquire())
