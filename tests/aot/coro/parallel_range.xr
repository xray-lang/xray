shared starts: Array<int> = []
shared ends: Array<int> = []
shared counts: Array<int> = []

var w = 0
while (w < 3) {
    starts.push(0)
    ends.push(0)
    counts.push(0)
    w = w + 1
}

parallel range begin, end in 0..10 workers 3 worker wid {
    unsafe {
        starts.set(wid, begin)
        ends.set(wid, end)
        counts.set(wid, counts.get(wid) + 1)
    }
}

unsafe {
    print(starts.get(0))
    print(ends.get(0))
    print(starts.get(1))
    print(ends.get(1))
    print(starts.get(2))
    print(ends.get(2))
    print(counts.get(0) + counts.get(1) + counts.get(2))
}
