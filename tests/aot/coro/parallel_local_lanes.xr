fn makeLane() -> Array<int> {
    return []
}

var lanes: Array<Array<int>> = []
var w = 0
while (w < 2) {
    var lane = makeLane()
    lane.resize(8, 0)
    lanes.push(lane)
    w = w + 1
}

parallel range begin, end in 0..8 workers 2 worker wid local lane in lanes {
    var i = begin
    unsafe {
        while (i < end) {
            lane.set(i, i + wid * 100)
            i = i + 1
        }
    }
}

var laneTotal = 0
w = 0
while (w < 2) {
    var lane = lanes[w]
    var i = 0
    while (i < lane.length) {
        laneTotal = laneTotal + lane[i]
        i = i + 1
    }
    w = w + 1
}

var sums: Array<Array<int>> = []
w = 0
while (w < 2) {
    var lane = makeLane()
    lane.resize(8, 0)
    sums.push(lane)
    w = w + 1
}

var reduced = parallel range reduce begin, end in 0..8 workers 2 worker wid local lane in sums
    init 0
    combine (a: int, b: int) -> a + b {
    var local = 0
    var i = begin
    unsafe {
        while (i < end) {
            lane.set(i, i)
            local = local + i
            i = i + 1
        }
    }
    local
}

var reduceLaneTotal = 0
w = 0
while (w < 2) {
    var lane = sums[w]
    var i = 0
    while (i < lane.length) {
        reduceLaneTotal = reduceLaneTotal + lane[i]
        i = i + 1
    }
    w = w + 1
}

print(laneTotal)
print(reduced)
print(reduceLaneTotal)
