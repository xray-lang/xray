fn send_after_yield(ch: Channel<int>, n: int) {
    Coro.yield()
    ch.send(n)
}

fn linked_value() -> int {
    Coro.yield()
    return 41
}

enum ScopeAotErr { Msg(string) }

fn sibling_ok(ch: Channel<int>) -> int {
    ch.send(1)
    return 5
}

fn sibling_fail(ch: Channel<int>) -> int {
    ch.send(10)
    throw ScopeAotErr.Msg("aot_fail")
    return 0
}

fn recv_sum(ch: Channel<int>, count: int) -> int {
    var sum = 0
    for (var i = 0; i < count; i++) {
        match (ch.recv()) {
            Recv.Value(v) -> {
                sum = sum + v
            }
            _ -> {}
        }
    }
    return sum
}

const ch = Channel<int>(2)
scope {
    go send_after_yield(ch, 1)
    go send_after_yield(ch, 2)
}

var a = ch.recv()
var b = ch.recv()
print(match (a) {
    Recv.Value(av) -> match (b) {
        Recv.Value(bv) -> av + bv
        _ -> -1
    }
    _ -> -1
})
ch.close()

linked scope {
    var task = go linked_value()
    var value = await task
    print(value + 1)
}

// A plain `scope` waits for both children; the failing one leaves its sibling
// alone and its error does not escape the block.
const isolated_ch = Channel<int>(2)
scope {
    go sibling_ok(isolated_ch)
    go sibling_fail(isolated_ch)
}
print(recv_sum(isolated_ch, 2))
isolated_ch.close()
