import { Semaphore, CountdownLatch, EventCount, WorkQueue, ResultGroup } from sync
const queue: WorkQueue<i64> = WorkQueue<i64>(2, 1)

fn worker() -> i64 {
    var item = queue.pop(0)
    if (item == null) {
        return -1
    }
    var value = item!
    return value * 2
}

var task = go worker()
assert_true(queue.push(21, 0))

print(await task)
