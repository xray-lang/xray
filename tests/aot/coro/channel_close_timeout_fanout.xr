fn recv_timeout_until_close(ch: Channel<int>, ready: Channel<int>, done: Channel<bool>,
                            timeout_ms: int) -> int {
    ready.send(1)
    let result = ch.recvTimeout(timeout_ms)
    done.send(match (result) {
        Recv.Closed -> true
        _ -> false
    })
    return 1
}

const waiter_count = 16
let ch = Channel<int>(0)
let ready = Channel<int>(0)
let done = Channel<bool>(waiter_count)

for (let i = 0; i < waiter_count; i++) {
    go recv_timeout_until_close(ch, ready, done, 2000)
}

for (let i = 0; i < waiter_count; i++) {
    ready.recv()
}

for (let i = 0; i < 16; i++) {
    Coro.yield()
}

ch.close()

let closed_waiters = 0
for (let i = 0; i < waiter_count; i++) {
    if (match (done.recv()) {
        Recv.Value(v) -> v
        _ -> false
    }) {
        closed_waiters++
    }
}

print(closed_waiters)
ready.close()
done.close()
