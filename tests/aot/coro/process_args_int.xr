var parsed = 77
var fallback = 88

if (len(process.args) > 0) {
    parsed = int(process.args[0]) ?? parsed
}

if (len(process.args) > 1) {
    fallback = int(process.args[1]) ?? fallback
}

fn echo_arg(value: int) -> int {
    Coro.yield()
    return value
}

var parsed_task = go echo_arg(parsed)
var fallback_task = go echo_arg(fallback)

print(await parsed_task)
print(await fallback_task)
