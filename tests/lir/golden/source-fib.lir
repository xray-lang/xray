module {
  extern @xrt_print_i64(i64) -> unit
  func @"f0_$init"() -> unit {
    entry ^b0
  ^b0:
    %0 = const i64 10
    %1 = call @f1_fib(%0)
    call @xrt_print_i64(%1)
    ret
  }
  func @f1_fib(%0: i64) -> i64 {
    entry ^b0
  ^b0:
    %1 = const i64 2
    %2 = icmp lt i64 %0, %1
    condbr %2, ^b1(), ^b2()
  ^b1:
    ret %0
  ^b2:
    br ^b3()
  ^b3:
    %3 = const i64 1
    %4 = sub i64 %0, %3
    %5 = call @f1_fib(%4)
    %6 = const i64 2
    %7 = sub i64 %0, %6
    %8 = call @f1_fib(%7)
    %9 = add i64 %5, %8
    ret %9
  }
  func @"f2_$entry"() -> i64 {
    entry ^b0
  ^b0:
    %0 = const i64 0
    ret %0
  }
  func @main() -> i64 {
    entry ^b0
  ^b0:
    call @"f0_$init"()
    %0 = call @"f2_$entry"()
    ret %0
  }
}
