fn measure(text: string) -> i64 {
    return len(text)
}

fn build(count: i64) -> string {
    const bang = "!"
    var text = ""
    var i = 0
    while (i < count) {
        text += "é\0"
        if (i == 1) {
            const saved = text
            text += bang
            text += bang
            print(measure(text))
            print(len(saved))
        }
        i += 1
    }
    return text
}

print(len(build(0)))
print(len(build(4)))
print(len(build(400)))
