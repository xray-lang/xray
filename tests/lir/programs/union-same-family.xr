// Two members of one numeric family are legal: the synthesized enum's tag
// distinguishes them, so the old numeric-family exclusivity cap is gone.
// These unions are built from exact member values; a bare literal cannot pick
// one of two same-family members (see tests/compile_errors/type).
fn intKind(v: i16 | i32) -> string {
    return match (v) {
        is i16 => "i16",
        is i32 => "i32",
    }
}

fn floatKind(v: f32 | f64) -> string {
    return match (v) {
        is f32 => "f32",
        is f64 => "f64",
    }
}

// A union variant payload is the same tagged-sum carrier a named enum uses.
// There is no union payload read yet, so the payload VALUE is observed through
// an enum with an f32 field: it shares CONST F32 emission, SUM_NEW/SUM_GET and
// the transport carrier with the `f32 | f64` variants above.
enum Reading {
    Missing,
    Value { v: f32 },
}

fn readingValue(r: Reading) -> f32 {
    return match (r) {
        Reading.Missing => 0.0,
        Reading.Value { v } => v,
    }
}

fn main() {
    var small: i16 = 5
    var large: i32 = 70000
    var narrow: f32 = 1.5
    var wide: f64 = 2.5
    print(intKind(small))
    print(intKind(large))
    print(floatKind(narrow))
    print(floatKind(wide))
    // f32 constants and payload values must survive the carrier exactly.
    print(narrow)
    print(readingValue(Reading.Value { v: 1.5 }))
    print(readingValue(Reading.Value { v: 2.5 }))
    var empty: Reading = Reading.Missing
    print(readingValue(empty))
}
main()
