// 测试6：生产者-消费者模式
// 作者：xingleixu@gmail.com
// 
// 验证：经典并发模式正确工作
print("========== 测试6：生产者-消费者模式 ==========")

fn recvValue(ch) {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn test_single_producer_consumer() {
    var ch = Channel(5)
    fn producer() {
        for (var i = 0; i < 20; i++) {
            ch.send(i)
        }
    }
    fn consumer() {
        var sum = 0
        for (var i = 0; i < 20; i++) {
            var val = recvValue(ch)
            sum = sum + val
        }
        return sum
    }
    var prod = go producer()
    var cons = go consumer()
    await prod
    var result = await cons
    print("消费总和:", result)
    // 0+1+2+...+19 = 190
    assert_eq(result, 190)
    print("✓ 单生产者-消费者测试通过")
}

fn test_multi_producer() {
    var ch = Channel(10)
    var results = Channel(1)
    fn producer(id, count) {
        for (var i = 0; i < count; i++) {
            ch.send(id * 100 + i)
        }
    }
    fn consumer(expected) {
        var received = 0
        while (received < expected) {
            var val = recvValue(ch)
            received = received + 1
        }
        return received
    }
    // 3 个生产者，每个发送 10 条
    var p1 = go producer(1, 10)
    var p2 = go producer(2, 10)
    var p3 = go producer(3, 10)
    // 1 个消费者，接收 30 条
    var cons = go consumer(30)
    await p1
    await p2
    await p3
    var result = await cons
    print("多生产者接收数:", result)
    assert_eq(result, 30)
    print("✓ 多生产者测试通过")
}

fn test_multi_consumer() {
    var ch = Channel(20)
    var results = Channel(3)
    fn producer(count) {
        for (var i = 0; i < count; i++) {
            ch.send(i)
        }
    }
    fn consumer(id) {
        var count = 0
        for (var i = 0; i < 10; i++) {
            var val = recvValue(ch)
            count = count + 1
        }
        results.send(count)
        return count
    }
    // 1 个生产者发送 30 条
    var prod = go producer(30)
    // 3 个消费者，每个接收 10 条
    var c1 = go consumer(1)
    var c2 = go consumer(2)
    var c3 = go consumer(3)
    await prod
    var r1 = await c1
    var r2 = await c2
    var r3 = await c3
    var total = r1 + r2 + r3
    print("多消费者总接收:", total)
    assert_eq(total, 30)
    print("✓ 多消费者测试通过")
}

// 运行所有测试
test_single_producer_consumer()
test_multi_producer()
test_multi_consumer()
print("
🎉 测试6全部通过：生产者-消费者模式正确！")
