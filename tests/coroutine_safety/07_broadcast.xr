// 测试7：广播模式（零拷贝）
// 作者：xingleixu@gmail.com
// 
// 验证：const 数据广播到多个协程，零拷贝高效共享
print("========== 测试7：广播模式 ==========")

fn recvValue(ch) {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn test_simple_broadcast() {
    // 广播同一消息给多个 worker
    const ch1 = Channel(1)
    const ch2 = Channel(1)
    const ch3 = Channel(1)
    var channels = [ch1, ch2, ch3]
    var count = 3
    // const 消息（零拷贝）
    const message = { "type" => "broadcast", "data" => [1, 2, 3, 4, 5] }
    fn worker(ch) {
        var msg = recvValue(ch)
        return len(msg.get("data"))
    }
    // 启动 workers
    var t1 = go worker(ch1)
    var t2 = go worker(ch2)
    var t3 = go worker(ch3)
    // 广播消息
    ch1.send(message)
    ch2.send(message)
    ch3.send(message)
    var r1 = await t1
    var r2 = await t2
    var r3 = await t3
    // 验证所有 worker 收到正确消息
    var success = 0
    if (r1 == 5) {
        success = success + 1
    }
    if (r2 == 5) {
        success = success + 1
    }
    if (r3 == 5) {
        success = success + 1
    }
    print("成功接收广播:", success, "/", count)
    assertEqual(success, count)
    print("✓ 简单广播测试通过")
}

fn test_config_broadcast() {
    // 广播配置给所有 worker
    const config = { "server" => "localhost", "port" => 8080, "timeout" => 5000, "retries" => 3 }
    const results = Channel(4)
    fn worker(cfg) {
        var port = cfg.get("port")
        results.send(port)
        return port
    }
    var t1 = go worker(config)
    var t2 = go worker(config)
    var t3 = go worker(config)
    var t4 = go worker(config)
    await t1
    await t2
    await t3
    await t4
    // 验证所有 worker 使用相同配置
    for (var i = 0; i < 4; i++) {
        var port = recvValue(results)
        assertEqual(port, 8080)
    }
    print("✓ 配置广播测试通过")
}

fn test_large_data_broadcast() {
    // 广播大数据（零拷贝避免 N 次复制）
    var data_arr = []
    for (var i = 0; i < 100; i++) {
        data_arr.push(i)
    }
    const large_data = data_arr
    const results = Channel(4)
    fn worker(data) {
        var sum = 0
        for (item in data) {
            sum = sum + item
        }
        results.send(sum)
        return sum
    }
    var t1 = go worker(large_data)
    var t2 = go worker(large_data)
    var t3 = go worker(large_data)
    var t4 = go worker(large_data)
    await t1
    await t2
    await t3
    await t4
    // 0+1+2+...+99 = 4950
    var expected_sum = 4950
    var correct = 0
    for (var i = 0; i < 4; i++) {
        var sum = recvValue(results)
        if (sum == expected_sum) {
            correct = correct + 1
        }
    }
    print("大数据广播正确数:", correct, "/ 4")
    assertEqual(correct, 4)
    print("✓ 大数据广播测试通过")
}

// 运行所有测试
test_simple_broadcast()
test_config_broadcast()
test_large_data_broadcast()
print("\n🎉 测试7全部通过：广播模式正确！")
