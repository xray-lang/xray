// 测试10：死锁场景与检测
// 作者：xingleixu@gmail.com
// 
// 验证：各种死锁场景的处理
// - 循环等待：A等B，B等A
// - Channel 死锁：无缓冲 Channel 无人接收
// - 资源饥饿：多协程竞争有限资源
// - 死锁预防：超时机制
print("========== 测试10：死锁场景与检测 ==========")

fn recvValue(ch) {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn tryRecvValue(ch) {
    return match (ch.tryRecv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn recvTimeoutValue(ch, timeout_ms) {
    return match (ch.recvTimeout(timeout_ms)) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn isSent(r: SendResult) -> bool {
    return match (r) {
        SendResult.Sent -> true
        _ -> false
    }
}

// 测试1：使用超时接收避免永久阻塞
fn test_channel_timeout_prevention() {
    const ch = Channel()
    // 无缓冲 Channel
    // 测试超时接收（无发送者）
    var received = recvTimeoutValue(ch, 100)
    // 100ms 超时
    // 接收应该返回 null（超时，因为没有发送者）
    print("接收结果（应为 null）:", received)
    assertEqual(received, null)
    print("✓ Channel 超时预防死锁测试通过")
}

// 测试2：使用 tryRecv/trySend 避免阻塞
fn test_non_blocking_operations() {
    const ch = Channel(1)
    // 非阻塞发送
    var sent1 = ch.trySend(1)
    var sent2 = ch.trySend(2)
    // 应该失败，缓冲区满
    print("第一次发送:", sent1)
    print("第二次发送:", sent2)
    assertEqual(isSent(sent1), true)
    assertEqual(isSent(sent2), false)
    // 非阻塞接收
    var val1 = tryRecvValue(ch)
    var val2 = tryRecvValue(ch)
    // 应该返回 null
    print("第一次接收:", val1)
    print("第二次接收:", val2)
    assertEqual(val1, 1)
    assertEqual(val2, null)
    print("✓ 非阻塞操作测试通过")
}

// 测试3：多生产者竞争有限缓冲区
fn test_producer_competition() {
    const ch = Channel(5)
    // 只有 5 个槽位
    const results = Channel(10)
    fn producer(id) {
        var sent_count = 0
        for (var i = 0; i < 10; i++) {
            // 使用超时发送，避免死锁
            var sent = ch.sendTimeout(copy({ "id" => id, "seq" => i }), 50)
            if (isSent(sent)) {
                sent_count = sent_count + 1
            }
        }
        results.send(copy({ "producer" => id, "sent" => sent_count }))
        return sent_count
    }
    // 启动多个生产者，但不启动消费者
    var p1 = go producer(1)
    var p2 = go producer(2)
    var p3 = go producer(3)
    var r1 = await p1
    var r2 = await p2
    var r3 = await p3
    // 统计发送成功的消息
    var total_sent = r1 + r2 + r3
    print("总发送成功数:", total_sent)
    // 应该最多发送 5 条（缓冲区大小）
    assert(total_sent >= 5)
    assert(total_sent <= 15)
    // 不可能超过总发送数
    print("✓ 多生产者竞争测试通过")
}

// 测试4：消费者-生产者平衡
fn test_balanced_producer_consumer() {
    const ch = Channel(3)
    const done = Channel(1)
    fn producer() {
        for (var i = 0; i < 20; i++) {
            ch.send(i)
        }
        return "producer done"
    }
    fn consumer() {
        var count = 0
        for (var i = 0; i < 20; i++) {
            var val = recvValue(ch)
            count = count + 1
        }
        done.send(count)
        return count
    }
    var p = go producer()
    var c = go consumer()
    await [p, c]
    var consumed = recvValue(done)
    print("消费数量:", consumed)
    assertEqual(consumed, 20)
    print("✓ 生产者-消费者平衡测试通过")
}

// 测试5：模拟资源锁（使用 Channel 作为信号量）
fn test_semaphore_pattern() {
    // 用 Channel 实现信号量（最多 2 个并发）
    const sem = Channel(2)
    sem.send(1)
    sem.send(1)
    // 初始化 2 个令牌
    const results = Channel(10)
    const active_count = Channel(1)
    active_count.send(0)
    // 当前活跃数
    fn worker(id) {
        // 获取令牌
        var token = recvValue(sem)
        // 模拟工作
        var sum = 0
        for (var i = 0; i < 1000; i++) {
            sum = sum + i
        }
        results.send(copy({ "id" => id, "result" => sum }))
        // 释放令牌
        sem.send(token)
        return sum
    }
    // 启动 5 个 worker，但只有 2 个能同时运行
    var w1 = go worker(1)
    var w2 = go worker(2)
    var w3 = go worker(3)
    var w4 = go worker(4)
    var w5 = go worker(5)
    await [w1, w2, w3, w4, w5]
    // 所有 worker 应该都完成
    var completed = 0
    for (var i = 0; i < 5; i++) {
        var r = tryRecvValue(results)
        if (r != null) {
            completed = completed + 1
        }
    }
    print("完成的 worker 数:", completed)
    assertEqual(completed, 5)
    print("✓ 信号量模式测试通过")
}

// 测试6：检测潜在死锁模式（通过超时）
fn test_deadlock_pattern_detection() {
    const ch1 = Channel()
    const ch2 = Channel()
    // 可能导致死锁的模式：两个协程互相等待
    fn task_a() {
        // 先发 ch1，再收 ch2（但使用超时）
        var sent = ch1.sendTimeout(1, 100)
        if (!isSent(sent)) {
            return "a_timeout_send"
        }
        var val = recvTimeoutValue(ch2, 100)
        if (val == null) {
            return "a_timeout_recv"
        }
        return "a_ok"
    }
    fn task_b() {
        // 先发 ch2，再收 ch1（但使用超时）
        var sent = ch2.sendTimeout(2, 100)
        if (!isSent(sent)) {
            return "b_timeout_send"
        }
        var val = recvTimeoutValue(ch1, 100)
        if (val == null) {
            return "b_timeout_recv"
        }
        return "b_ok"
    }
    var a = go task_a()
    var b = go task_b()
    var ra = await a
    var rb = await b
    print("Task A 结果:", ra)
    print("Task B 结果:", rb)
    // 由于超时机制，不会真正死锁
    // 结果可能是各种超时组合
    assert(ra != null)
    assert(rb != null)
    print("✓ 死锁模式检测测试通过")
}

// 测试7：正确的双向通信模式
fn test_bidirectional_communication() {
    const request = Channel(1)
    const response = Channel(1)
    fn server() {
        var req = recvValue(request)
        var resp = req * 2
        response.send(resp)
        return "server done"
    }
    fn client() {
        request.send(21)
        var resp = recvValue(response)
        return resp
    }
    var s = go server()
    var c = go client()
    await s
    var result = await c
    print("客户端收到响应:", result)
    assertEqual(result, 42)
    print("✓ 双向通信测试通过")
}

// 运行所有测试
test_channel_timeout_prevention()
test_non_blocking_operations()
test_producer_competition()
test_balanced_producer_consumer()
test_semaphore_pattern()
test_deadlock_pattern_detection()
test_bidirectional_communication()
print("\n🎉 测试10全部通过：死锁场景处理正确！")
