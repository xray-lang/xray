// 测试11：协程监控与调试
// 作者：xingleixu@gmail.com
// 
// 验证：协程监控和调试能力
// - 协程状态查询：done, cancelled, result, error
// - 协程命名：便于调试识别
// - 协程统计：数量、完成率等
// - 错误传播：协程中的异常处理
print("========== 测试11：协程监控与调试 ==========")

enum MonDebugErr { Msg(string) }

fn tryRecvValue(ch) {
    return match (ch.tryRecv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

// 测试1：协程状态查询
fn test_coro_status_query() {
    shared ch = Channel(1)
    fn task() {
        ch.recv()
        // 等待信号
        return 42
    }
    var t = go task()
    // 启动后，未完成
    print("启动后 done:", t.done)
    assert_eq(t.done, false)
    assert_eq(t.status == TaskStatus.Pending || t.status == TaskStatus.Running, true)
    // 发送信号让任务完成
    ch.send(1)
    await t
    // 完成后
    print("完成后 done:", t.done)
    assert_eq(t.done, true)
    print("✓ 协程状态查询测试通过")
}

// 测试2：协程取消状态
fn test_coro_cancel_status() {
    fn long_task() {
        var count = 0
        while (count < 1000000) {
            count = count + 1
            if (cancelled()) {
                return "was cancelled"
            }
        }
        return "completed"
    }
    var t = go long_task()
    // 立即取消
    t.cancel()
    var result = t.awaitResult()
    var cancelled = match (result) {
        TaskResult.Cancelled -> true
        TaskResult.Success(value) -> value == "was cancelled"
        _ -> false
    }
    print("取消状态:", cancelled)
    assert_eq(cancelled, true)
    print("✓ 协程取消状态测试通过")
}

// 测试3：协程命名（便于调试）
fn test_coro_naming() {
    fn worker(name) {
        return "Hello from " + name
    }
    // 使用命名协程
    var t1 = go(name: "worker-1") worker("Alice")
    var t2 = go(name: "worker-2") worker("Bob")
    var t3 = go(name: "data-processor") worker("Charlie")
    var r1 = await t1
    var r2 = await t2
    var r3 = await t3
    print("Worker 1 结果:", r1)
    print("Worker 2 结果:", r2)
    print("Data Processor 结果:", r3)
    assert_eq(r1, "Hello from Alice")
    assert_eq(r2, "Hello from Bob")
    assert_eq(r3, "Hello from Charlie")
    print("✓ 协程命名测试通过")
}

// 测试4：多协程状态批量查询
fn test_batch_status_query() {
    fn quick_task(id) {
        return id * 10
    }
    // 创建多个协程
    var t0 = go quick_task(0)
    var t1 = go quick_task(1)
    var t2 = go quick_task(2)
    var t3 = go quick_task(3)
    var t4 = go quick_task(4)
    // 等待全部完成
    var r0 = await t0
    var r1 = await t1
    var r2 = await t2
    var r3 = await t3
    var r4 = await t4
    // 批量检查状态
    var all_done = t0.done && t1.done && t2.done && t3.done && t4.done
    print("所有协程完成:", all_done)
    print("结果:", r0, r1, r2, r3, r4)
    assert_eq(all_done, true)
    assert_eq(r0, 0)
    assert_eq(r1, 10)
    assert_eq(r2, 20)
    assert_eq(r3, 30)
    assert_eq(r4, 40)
    print("✓ 批量状态查询测试通过")
}

// 测试5：协程错误捕获
fn test_coro_error_capture() {
    fn failing_task() {
        throw MonDebugErr.Msg("Something went wrong!")
    }
    fn safe_task() {
        return "success"
    }
    var fail = go failing_task()
    var safe = go safe_task()
    // 等待完成（错误不会传播到 await）
    await fail
    var safe_result = await safe
    print("失败任务 done:", fail.done)
    print("安全任务 result:", safe_result)
    // 失败任务应该标记为完成
    assert_eq(fail.done, true)
    assert_eq(safe_result, "success")
    print("✓ 协程错误捕获测试通过")
}

// 测试6：命名协程批量完成
fn test_coro_named_batch() {
    shared results = Channel(10)
    fn task(id, label) {
        // 模拟工作
        var sum = 0
        for (var i = 0; i < 1000; i++) {
            sum = sum + i
        }
        results.send(id)
        return sum
    }
    // 启动多个带调试名称的任务
    var first = go(name: "worker-first") task(1, "first")
    var second = go(name: "worker-second") task(2, "second")
    var third = go(name: "worker-third") task(3, "third")
    await all [first, second, third]
    // 收集完成顺序
    var order = []
    for (var i = 0; i < 3; i++) {
        var id = tryRecvValue(results)
        if (id != null) {
            order.push(id)
        }
    }
    print("完成顺序:", order)
    assert_eq(order.length, 3)
    print("✓ 命名协程批量完成测试通过")
}

// 测试7：协程链式调用
fn test_coro_chain() {
    fn step1(x) {
        return x + 1
    }
    fn step2(x) {
        return x * 2
    }
    fn step3(x) {
        return x - 3
    }
    // 链式执行
    var t1 = go step1(10)
    var r1 = await t1
    var t2 = go step2(r1)
    var r2 = await t2
    var t3 = go step3(r2)
    var r3 = await t3
    // (10 + 1) * 2 - 3 = 19
    print("链式结果:", r3)
    assert_eq(r3, 19)
    print("✓ 协程链式调用测试通过")
}

// 测试8：并发调试模式 - 追踪执行顺序
fn test_execution_trace() {
    shared trace = Channel(20)
    fn traced_task(id) {
        trace.send(copy({ "event" => "start", "id" => id }))
        // 模拟工作
        var sum = 0
        for (var i = 0; i < 100; i++) {
            sum = sum + i
        }
        trace.send(copy({ "event" => "end", "id" => id }))
        return sum
    }
    var t1 = go traced_task(1)
    var t2 = go traced_task(2)
    var t3 = go traced_task(3)
    await all [t1, t2, t3]
    // 收集追踪事件
    var events = []
    for (var i = 0; i < 6; i++) {
        var evt = tryRecvValue(trace)
        if (evt != null) {
            events.push(evt)
        }
    }
    print("追踪事件数:", events.length)
    // 验证每个任务有 start 和 end 事件
    var starts = 0
    var ends = 0
    for (var i = 0; i < events.length; i++) {
        var evt = events[i]
        if (evt.get("event") == "start") {
            starts = starts + 1
        } else if (evt.get("event") == "end") {
            ends = ends + 1
        }
    }
    print("开始事件:", starts)
    print("结束事件:", ends)
    assert_eq(starts, 3)
    assert_eq(ends, 3)
    print("✓ 执行追踪测试通过")
}

// 运行所有测试
test_coro_status_query()
test_coro_cancel_status()
test_coro_naming()
test_batch_status_query()
test_coro_error_capture()
test_coro_named_batch()
test_coro_chain()
test_execution_trace()
print("
🎉 测试11全部通过：协程监控与调试正确！")
