// 测试1：Channel 深拷贝隔离
// 作者：xingleixu@gmail.com
// 
// 验证：可变类型通过 Channel 传递时深拷贝，修改原值不影响接收方
print("========== 测试1：Channel 深拷贝隔离 ==========")

fn recvValue(ch) {
    return match (ch.recv()) {
        Recv.Value(v) -> v
        _ -> null
    }
}

fn test_array_isolation() {
    const ch = Channel(1)
    // 发送可变数组
    var original = [1, 2, 3]
    ch.send(copy(original))
    // 修改原数组
    original.push(4)
    original.push(5)
    // 接收
    var received = recvValue(ch)
    // 验证隔离：接收到的应该是 [1,2,3]，不是 [1,2,3,4,5]
    print("原数组长度:", len(original))
    // 应该是 5
    print("接收数组长度:", len(received))
    // 应该是 3
    assert_eq(len(original), 5)
    assert_eq(len(received), 3)
    print("✓ 数组隔离测试通过")
}

fn test_map_isolation() {
    const ch = Channel(1)
    // 发送可变 Map
    var original = { "a" => 1, "b" => 2 }
    ch.send(copy(original))
    // 修改原 Map
    original.set("c", 3)
    original.set("d", 4)
    // 接收
    var received = recvValue(ch)
    // 验证隔离
    print("原 Map 大小:", len(original))
    // 应该是 4
    print("接收 Map 大小:", len(received))
    // 应该是 2
    assert_eq(len(original), 4)
    assert_eq(len(received), 2)
    print("✓ Map 隔离测试通过")
}

fn test_nested_isolation() {
    const ch = Channel(1)
    // 发送嵌套结构
    var original = { "items" => [1, 2, 3], "count" => 3 }
    ch.send(copy(original))
    // 修改嵌套数组
    original.get("items").push(4)
    // 接收
    var received = recvValue(ch)
    // 验证深层隔离
    var orig_items = original.get("items")
    var recv_items = received.get("items")
    print("原嵌套数组长度:", len(orig_items))
    // 应该是 4
    print("接收嵌套数组长度:", len(recv_items))
    // 应该是 3
    assert_eq(len(orig_items), 4)
    assert_eq(len(recv_items), 3)
    print("✓ 嵌套结构隔离测试通过")
}

// 运行所有测试
test_array_isolation()
test_map_isolation()
test_nested_isolation()
print("\n🎉 测试1全部通过：Channel 深拷贝隔离正确！")
