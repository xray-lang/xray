// 测试5：并发 memory 压力测试
// 作者：xingleixu@gmail.com
//
// 验证：多协程并发执行时内存管理正确工作，无段错误
print("========== 测试5：并发 memory 压力测试 ==========")

fn test_many_short_lived_coros() {
    // 创建大量短期协程，触发内存分配/释放压力
    var count = 50
    fn worker(id: i64) -> i64 {
        // 分配一些内存
        var arr: Array<string> = []
        for (var i = 0; i < 10; i++) {
            arr.push("item_" + string(id) + "_" + string(i))
        }
        return len(arr)
    }
    var tasks: Array<Task> = []
    for (var i = 0; i < count; i++) {
        tasks.push(go worker(i))
    }
    // 等待所有协程完成并收集结果
    var success = 0
    for (task in tasks) {
        var r = await task
        if (r == 10) {
            success = success + 1
        }
    }
    print("成功协程数:", success, "/", count)
    assert_eq(success, count)
    print("✓ 短期协程压力测试通过")
}

fn test_nested_allocations() {
    fn worker() -> i64 {
        // 创建嵌套数据结构
        var data: Array<JSON.Value> = []
        for (var i = 0; i < 50; i++) {
            var item = #{"id": i, "values": [i * 1, i * 2, i * 3], "name": "item_" + string(i)}
            data.push(item)
        }
        return len(data)
    }
    // 启动 10 个协程
    var t1 = go worker()
    var t2 = go worker()
    var t3 = go worker()
    var t4 = go worker()
    var t5 = go worker()
    var t6 = go worker()
    var t7 = go worker()
    var t8 = go worker()
    var t9 = go worker()
    var t10 = go worker()
    var r1 = await t1
    var r2 = await t2
    var r3 = await t3
    var r4 = await t4
    var r5 = await t5
    var r6 = await t6
    var r7 = await t7
    var r8 = await t8
    var r9 = await t9
    var r10 = await t10
    var total = r1 + r2 + r3 + r4 + r5
    total = total + r6 + r7 + r8 + r9 + r10
    print("嵌套分配总数:", total)
    assert_eq(total, 10 * 50)
    // 500
    print("✓ 嵌套分配测试通过")
}

// 运行所有测试
test_many_short_lived_coros()
test_nested_allocations()
// 注意：并行 Channel 压力测试暂时禁用
// 原因：多线程 Channel 调度需要进一步优化
print("测试5全部通过：并发 memory 正确！")
