enum Choice { Empty, Selected { values:Array<i64> } }
fn leaf()->i64 { Coro.yield(); return 42 }
fn worker_array()->Array<i64> { Coro.yield(); return [10,20] }
export fn await_array()->Array<i64> { const task:Task<Array<i64>> = go worker_array(); var first=await task; first[0]=99; if (first[0]!=99) { return [0,0] }; return await task }
export fn handle_array()->Task<Array<i64>> { return go worker_array() }
fn worker_nested()->Array<Array<string>> { Coro.yield(); return [["owned","array"],["typed"]] }
export fn await_nested()->Array<Array<string>> { const task:Task<Array<Array<string>>> = go worker_nested(); var first=await task; first[0][0]="changed"; if (first[0][0]!="changed") { return [["bad"]] }; return await task }
export fn handle_nested()->Task<Array<Array<string>>> { return go worker_nested() }
fn worker_nullable()->i64? { Coro.yield(); return 42 }
export fn await_nullable()->i64? { const task:Task<i64?> = go worker_nullable(); const first=await task; return await task }
export fn handle_nullable()->Task<i64?> { return go worker_nullable() }
fn worker_nullable_array()->Array<i64>? { Coro.yield(); return [10,20] }
export fn await_nullable_array()->Array<i64>? { const task:Task<Array<i64>?> = go worker_nullable_array(); const first=await task; return await task }
export fn handle_nullable_array()->Task<Array<i64>?> { return go worker_nullable_array() }
fn worker_tuple()->(i64,string) { Coro.yield(); return (42,"owned") }
export fn await_tuple()->(i64,string) { const task:Task<(i64,string)> = go worker_tuple(); const first=await task; return await task }
export fn handle_tuple()->Task<(i64,string)> { return go worker_tuple() }
fn worker_enum()->Choice { Coro.yield(); return Choice.Selected{values:[10,20]} }
export fn await_enum()->Choice { const task:Task<Choice> = go worker_enum(); const first=await task; return await task }
export fn handle_enum()->Task<Choice> { return go worker_enum() }
fn worker_atomic()->Atomic<i64> { Coro.yield(); return Atomic<i64>(42) }
export fn await_atomic()->Atomic<i64> { const task:Task<Atomic<i64>> = go worker_atomic(); const first=await task; return await task }
export fn handle_atomic()->Task<Atomic<i64>> { return go worker_atomic() }
fn worker_task()->Task<i64> { Coro.yield(); return go leaf() }
export fn await_task()->Task<i64> { const task:Task<Task<i64>> = go worker_task(); const first=await task; return await task }
export fn handle_task()->Task<Task<i64>> { return go worker_task() }
export fn main()->i64{return 7}
