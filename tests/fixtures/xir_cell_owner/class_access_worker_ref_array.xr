fn bump(values: ref Array<i64>) -> i64 {
    const before = values;
    const size = len(values);
    const capacity = values.capacity;
    values[0] = values[0] + 2;
    values.push(7);
    return values[0] * 1000 + values[2] * 100 + len(values) * 10 +
        (capacity >= size ? 1 : 0) + before[0];
}
final class Holder {
    values: Array<i64>
    constructor() { this.values = [40, 90]; }
    adjust() -> i64 {
        const snapshot = this.values;
        const result = bump(ref this.values);
        return result + this.values[0] + snapshot[0];
    }
}
fn worker() -> i64 { const holder = Holder(); return holder.adjust(); }
export fn run() -> i64 { return await go worker(); }
fn main() -> i64 { return run(); }
