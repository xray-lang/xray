fn bump(value: ref i64) -> i64 { value += 1; return value; }
final class Holder {
    value: i64
    init(value: i64) { this.value = value; }
    adjust() -> i64 { return bump(ref this.value); }
}
fn create() -> Holder { return Holder(40); }
fn forward(value: Holder) -> i64 { return value.adjust(); }
fn worker() -> i64 { return forward(create()); }
export fn run() -> i64 { return await go worker(); }
fn main() -> i64 { return run(); }
