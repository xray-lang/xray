fn escape(value: ref i64) -> fn() -> i64 { return fn() -> i64 { return value; }; }
final class Holder {
    value: i64
    constructor() { this.value = 0; }
}
export fn run() -> i64 { const storage = Holder(); const action = escape(ref storage.value); return action(); }
fn main() -> i64 { return run(); }
