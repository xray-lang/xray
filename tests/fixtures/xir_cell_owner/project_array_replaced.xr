var root: Array<i64> = [40, 70]
var picks: i64 = 0
fn choose() -> i64 { picks += 1; return 0; }
fn replace() -> i64 { root = [90, 91]; return 0; }
fn bump(value: ref i64, ignored: i64) -> i64 { value += 2; return value + ignored; }
export fn run() -> i64 {
    const snapshot = root;
    bump(ref root[choose()], replace());
    return root[0] * 1000 + snapshot[0] * 10 + picks;
}
fn main() -> i64 { return run(); }
