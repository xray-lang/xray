fn bump(value:ref i64)->i64 { value += 2; return value }
fn apply(callback:fn(ref i64)->i64,value:ref i64)->i64 { return callback(ref value) }
fn worker()->i64 { var value:i64=40; const callback=bump; return apply(callback,ref value) }
export fn run()->i64 { const task=go worker(); return await task }
fn main()->i64 { return 0 }
