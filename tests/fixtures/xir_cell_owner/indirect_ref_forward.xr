var counter: i64 = 0
fn bump(value: ref i64) -> i64 { value += 1; return value; }
fn forward(action: fn(ref i64) -> i64, value: ref i64) -> i64 {
    return action(ref value);
}
export fn run() -> i64 { return forward(bump, ref counter); }
export fn cellCounter() -> i64 { return counter; }
fn main() -> i64 { return 0; }
