fn bump(value: ref i64) -> i64 { value += 2; return value; }
final class Holder {
    values: Array<i64>
    init() { this.values = [40, 90]; }
    adjust() -> i64 {
        const snapshot = this.values;
        bump(ref this.values[0]);
        return this.values[0] * 100 + snapshot[0];
    }
}
fn worker() -> i64 { const holder = Holder(); return holder.adjust(); }
export fn run() -> i64 { return await go worker(); }
fn main() -> i64 { return run(); }
