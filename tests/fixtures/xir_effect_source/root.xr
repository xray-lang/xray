enum Fault { Bad, Other }
export fn pure()->i64 { return 7 }
export fn sleeper() { Coro.yield() }
export fn relay<T>(value:T)->T { sleeper(); return value }
export fn instantiated()->i64 { return relay<i64>(7) }
export fn fail()->i64 { throw Fault.Bad }
export fn forward()->i64 { return fail() }
export fn handled()->i64 { try { return fail() } catch(e) { return 11 } }
export fn rethrow()->i64 { try { return fail() } catch(e) { throw e } }
export fn dynamic(f:fn()->i64)->i64 { return f() }
export fn dynamicHandled(f:fn()->i64)->i64 { try { return f() } catch(e) { return 11 } }
export fn panicOnly()->i64 { try { return 1/0 } catch panic { return 13 } }
export fn typedHandled()->i64 { try { return fail() } catch(e:Fault) { return 17 } }
export fn variantHandled()->i64 { try { return fail() } catch(Fault.Bad) { return 19 } }
export fn variantUnmatched()->i64 { try { return fail() } catch(Fault.Other) { return 23 } }
export fn typedRethrow()->i64 { try { return fail() } catch(e:Fault) { throw e } }
export fn dynamicRethrow(f:fn()->i64)->i64 { try { return f() } catch(e) { throw e } }
export fn dynamicTyped(f:fn()->i64)->i64 { try { return f() } catch(e:Fault) { return 29 } }
enum Foreign { Bad }
export fn wrongTyped()->i64 { try { return fail() } catch(e:Foreign) { return 31 } }
export fn parameterThrow(e:Fault)->i64 { throw e }
export fn unknownParameter(e:Error)->i64 { throw e }
export fn localOverwrite()->i64 { var e = Fault.Bad; e = Fault.Other; throw e }
export fn phiThrow(flag:bool)->i64 { throw (flag ? Fault.Bad : Fault.Other) }
export fn loopThrow(flag:bool)->i64 { var e = Fault.Bad; while (flag) { e = Fault.Other; break }; throw e }
export fn recursiveError(flag:bool)->i64 { if (flag) { throw Fault.Other }; return recursivePeer(flag) }
fn recursivePeer(flag:bool)->i64 { return recursiveError(flag) }
export fn cellAfterCall()->i64 { var e = Fault.Bad; pure(); throw e }
export fn cellSnapshot()->i64 { var e = Fault.Bad; const old = e; e = Fault.Other; throw old }
export fn cellAfterCleanup()->i64 { var e=Fault.Bad; {defer{e=Fault.Other}}; throw e }
export fn cellCleanupSnapshot()->i64 { var e=Fault.Bad; const old=e; {defer{e=Fault.Other}}; throw old }
export fn cellPanicCleanup()->i64 {
    var e=Fault.Bad
    try {defer{e=Fault.Other};const n=1/0} catch panic {throw e}
    return 0
}
export fn cellPanicSnapshot()->i64 {
    var e=Fault.Bad; const old=e
    try {defer{e=Fault.Other};const n=1/0} catch panic {throw old}
    return 0
}
export fn cellErrorCleanup()->i64 {
    var e=Fault.Bad
    try {defer{e=Fault.Other};throw Fault.Bad} catch(Fault.Bad){throw e}
}
export fn cellErrorSnapshot()->i64 {
    var e=Fault.Bad
    try {defer{e=Fault.Other};throw e} catch(error){throw error}
}
export fn panicThrows()->i64 { try { return 1/0 } catch panic { throw Fault.Other } }
enum GenericFault<T> { Bad { item:T } }
fn genericFail<T>(item:T)->i64 { throw GenericFault<T>.Bad { item:item } }
export fn genericUse()->i64 { return genericFail<i64>(7) }
export fn cellAfterYield()->i64 { var e = Fault.Bad; Coro.yield(); throw e }
export fn cellAfterOutput()->i64 { var e = Fault.Bad; print(1); throw e }
export fn genericCaught()->i64 { try { return genericFail<i64>(7) } catch(e:GenericFault<i64>) { return 37 } }
fn genericHandled<T>(item:T)->i64 { try { return genericFail<T>(item) } catch(e:GenericFault<T>) { return 41 } }
export fn genericHandledUse()->i64 { return genericHandled<i64>(7) }
enum MissingFault<T> { Bad { item:T } }
fn missingFail<T>(item:T)->i64 { throw MissingFault<T>.Bad { item:item } }
export fn missingUse()->i64 { return missingFail<i64>(7) }
fn throwParam<E:Error>(error:E)->i64 { throw error }
export fn paramForward()->i64 { return throwParam<Fault>(Fault.Bad) }
export fn paramCaught()->i64 { try { return throwParam<Fault>(Fault.Bad) } catch(e:Fault) { return 43 } }
export fn dynamicKnownMix(f:fn()->i64, flag:bool)->i64 { if (flag) { throw Fault.Bad }; return f() }

enum ClosureFault<T> { Bad { item:T } }
fn closureFail<T>(x:T)->i64 { throw ClosureFault<T>.Bad { item:x } }
fn closureBridge<T>(x:T)->i64 { return closureFail<Array<T>>([x]) }
fn closureDeep<T>(x:T)->i64 { return closureBridge<Array<T>>([x]) }
export fn closureCaught()->i64 { try { return closureBridge<i64>(7) } catch(e:ClosureFault<Array<i64>>) { return 59 } }
export fn closureDeepCaught()->i64 { try { return closureDeep<i64>(7) } catch(e:ClosureFault<Array<Array<i64>>>) { return 61 } }
export fn closureWrong()->i64 { try { return closureBridge<string>("x") } catch(e:ClosureFault<Array<i64>>) { return 0 } }
export fn closureUnion(flag:bool)->i64 {
    try { if (flag) { return closureBridge<i64>(7) }; return closureBridge<string>("x") }
    catch(e:ClosureFault<Array<i64>>) { return 67 }
    catch(e:ClosureFault<Array<string>>) { return 71 }
}

fn closureHandledCycle<T>(x:T)->i64 {
    try { return closureHandledCycle<Array<T>>([x]) } catch(e) { return 0 }
}
fn closureCallback<T>(f:fn(T)->T)->i64 { return closureFail<fn(T)->T>(f) }
fn closureIdentity(x:i64)->i64 { return x }
export fn closureCallbackCaught()->i64 {
    try { return closureCallback<i64>(closureIdentity) }
    catch(e:ClosureFault<fn(i64)->i64>) { return 73 }
}
