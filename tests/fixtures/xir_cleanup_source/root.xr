enum Problem { Failed }
export fn scopes()->string {
    var n = 1
    defer { print(n) }
    {
        const saved = n
        defer { print(saved) }
        defer { print("nested"); defer { print("inner") } }
        n = 2
    }
    print("after")
    return "kept"
}
export fn loops()->i64 {
    var n = 0
    while (n < 3) {
        n++
        defer { print(n) }
        if (n == 1) { continue }
        if (n == 2) { break }
    }
    return n
}
export fn errors()->i64 {
    try { defer { print("error cleanup") }; throw Problem.Failed }
    catch(e:Problem) { print("caught"); return 7 }
}
export fn panic()->i64 {
    try { defer { print("panic cleanup") }; return 10/0 }
    catch panic { print("handled"); return 9 }
}
export fn cancelled()->string {
    defer { print("cancelled") }
    Coro.yield()
    return "resumed"
}
fn identity<T>(value:T)->T { defer { print("generic") }; return value }
export fn generics()->string { return identity<string>("g") }
export fn snapshot()->Array<i64> {
    var a = [1]
    defer { a[0] = 7; print(a[0]) }
    return a
}

export fn fatalReturn()->i64 {
    try {defer{const n=1/0};return 1} catch panic{return 99}
}
export fn fatalError()->i64 {
    try {defer{const n=1/0};throw Problem.Failed} catch(e:Problem){return 99}
}
export fn fatalPanic()->i64 {
    try {defer{const n=1/0};return 2/0} catch panic{return 99}
}
export fn fatalCancel()->i64 {
    defer{const n=1/0}
    Coro.yield()
    return 99
}

struct ConstructedCleanup {
    private value:i64 = 1
    constructor() {defer{print(this.value)};this.value=2}
    get()->i64{return this.value}
}
export fn constructorLate()->i64{return ConstructedCleanup().get()}

struct NestedConstructedCleanup<T> {
    private value:T
    private const label:string = "ctor"
    constructor(flag:bool,value:T,replacement:T) {
        if(flag){this.value=value}else{this.value=replacement}
        defer{this.value=replacement;defer{print(this.label)}}
        this.value=value
    }
    get()->T{return this.value}
}
export fn constructorNested()->string {
    const first=NestedConstructedCleanup<string>(true,"before","after")
    const second=NestedConstructedCleanup<string>(false,"before","after")
    return first.get()+second.get()
}

struct BareConstructedCleanup {
    private value:i64 = 1
    constructor(){defer{this.value=9};return}
    get()->i64{return this.value}
}
export fn constructorBare()->i64{return BareConstructedCleanup().get()}

struct PlainConstructor {
    private value:i64 = 1
    constructor(){this.value=3}
    get()->i64{return this.value}
}
struct UncapturedConstructor {
    private value:i64 = 1
    constructor(){
        const read=fn()->i64{defer{print(this.value)};return this.value}
        this.value=3
        print(read())
        defer{print("plain")}
    }
    get()->i64{return this.value}
}
export fn constructorUncaptured()->i64{return PlainConstructor().get()+UncapturedConstructor().get()}

struct CompoundConstructed {
    private value:i64 = 1
    constructor(){defer{this.value+=2};this.value*=3}
    get()->i64{return this.value}
}
struct CompoundFields {value:i64;other:i64}
var compoundState=CompoundFields{value:1,other:2}
fn compoundRhs()->i64{compoundState=CompoundFields{value:100,other:9};print("rhs");return 4}
export fn memberCompound()->i64{
    const result=(compoundState.value+=compoundRhs())
    print(result)
    print(compoundState.other)
    var local=CompoundFields{value:3,other:4}
    const before=local
    defer{local.value+=1;defer{local.value*=2;print(local.value)};print(local.value)}
    local.value+=2
    print(before.value)
    return CompoundConstructed().get()+compoundState.value
}

struct CompoundOperators {number:i64;small:i8;real:f32;text:string}
struct ConcreteGenericField<T>{number:i64;payload:T}
fn concreteGenericUpdate<T>(v:T)->T{var b=ConcreteGenericField<T>{number:1,payload:v};b.number+=2;return b.payload}
export fn memberOperators()->string{
    var b=CompoundOperators{number:7,small:127,real:1.5,text:"a"}
    b.number+=3;b.number-=2;b.number*=3;b.number/=4;b.number%=4
    b.number|=8;b.number&=11;b.number^=3;b.number<<=2;b.number>>=1
    b.small+=1;b.small<<=256
    b.real+=0.5;b.real*=3.0;b.real/=2.0;b.real-=1.0
    const saved=(b.text+="b")
    b.text+="c"
    print(b.number);print(b.small as i64);print(b.real==(2.0 as f32));print(b.text)
    return concreteGenericUpdate<string>(saved)
}
fn yieldingMemberRhs()->i64{compoundState=CompoundFields{value:100,other:9};Coro.yield();return 4}
export fn memberResume()->i64{defer{print(compoundState.value)};const result=(compoundState.value+=yieldingMemberRhs());return result+compoundState.other}
export fn memberCancel()->i64{defer{print(compoundState.value)};compoundState.value+=yieldingMemberRhs();return 0}
fn throwingMemberRhs()->i64{compoundState=CompoundFields{value:100,other:9};throw Problem.Failed}
fn zeroMemberRhs()->i64{compoundState=CompoundFields{value:100,other:9};return 0}
export fn memberFailure()->i64{
    var answer=0
    try{compoundState.value+=throwingMemberRhs()}catch(e:Problem){print(compoundState.value);answer=compoundState.other}
    compoundState=CompoundFields{value:3,other:4}
    try{compoundState.value/=zeroMemberRhs()}catch panic{print(compoundState.value);return answer+compoundState.other}
    return -1
}
