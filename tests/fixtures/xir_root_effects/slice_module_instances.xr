var counts = [0]
fn identity<T>(part:Slice<i64>, marker:T)->Slice<i64> {
    counts[0] = counts[0] + 1
    return part
}
fn main() {
    var integers:Array<i64> = [11,22]
    print(len(identity<i64>(integers[0:2], 0)))
    print(len(identity<u8>(integers[0:2], 0 as u8)))
    print(counts[0])
}
main()
