enum ProbeErr { Empty, Bad { code: i64 } }

fn value(ok: bool) throws(ProbeErr) -> i64 {
    print("value")
    if (!ok) { throw ProbeErr.Bad { code: 23 } }
    return 12
}

fn right() -> i64 {
    print("right")
    return 5
}

fn asserting() -> i64 {
    return try! (value(false) + right())
}

fn caller() -> i64 {
    return asserting()
}

print("entered")
print(caller())
print("after")
