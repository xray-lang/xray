class Holder {
    marker: i64
    items: Array<i64>

    init(items: Array<i64>) {
        this.marker = 37
        this.items = items
    }
}

class Stack<T> {
    private items: Array<T>

    init() {
        this.items = []
    }

    size() -> i64 {
        return len(this.items)
    }
}

fn readItems(holder: Holder) -> Array<i64> {
    return holder.items
}

fn replaceBeforePush(holder: Holder) -> i64 {
    holder.items = [5]
    return 23
}

var input = [3, 7]
const holder = Holder(input)
input[0] = 30
var snapshot = readItems(holder)
snapshot.push(11)
const stack = Stack<i64>()
print(input[0])
print(holder.items[0])
print(len(holder.items))
print(len(snapshot))
print(snapshot[2])
print(stack.size())

const alias = holder
alias.items.push(13)
print(len(holder.items))
print(holder.items[2])
print(snapshot[2])
holder.items = [19]
print(len(alias.items))
print(alias.items[0])
print(snapshot[0])
alias.items.push(replaceBeforePush(holder))
print(len(holder.items))
print(holder.items[0])
print(holder.items[1])
print(holder.marker)
