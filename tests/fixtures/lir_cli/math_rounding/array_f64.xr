var shared: Array<f64> = [-0.0, 2.25]

fn buildSamples() -> Array<f64> {
    var values = Array<f64>.withCapacity(2)
    values.push(-0.0)
    values.push(1.25)
    const saved = values
    values[1] = -3.5
    print(saved[1])
    print(values.capacity >= 2)
    return values.reserve(4)
}

const original = shared
shared[0] = 0.5
print(original[0])
print(shared[0])
const samples = buildSamples()
print(samples[0])
print(samples[1])
print(samples.capacity >= 4)
print(samples)

fn getFirst(values: Array<f64>) -> f64 { return values[0] }
fn returnArray(values: Array<f64>) -> Array<f64> { return values }
fn take(callback: fn(Array<f64>) -> f64, values: Array<f64>) -> f64 { return callback(values) }
fn give(callback: fn(Array<f64>) -> Array<f64>, values: Array<f64>) -> Array<f64> { return callback(values) }
print(take(getFirst, [-0.0]))
print(give(returnArray, [1.25]))

fn applyOptional(callback: fn(Array<f64>?) -> Array<f64>?, value: Array<f64>?) -> Array<f64>? {
    return callback(value)
}
fn optionalSamples() {
    const identity = fn(value: Array<f64>?) -> Array<f64>? { return value }
    var source = [2.25]
    const kept = applyOptional(identity, source)
    source[0] = -1.0
    print(kept![0])
    print(source[0])
    print(len(applyOptional(identity, Array<f64>())!))
    print(applyOptional(identity, null) == null)
}
optionalSamples()
