var values = [11, 22, 33]

fn apply(callback: fn() -> i64, marker: i64, part: Slice<i64>) -> i64 {
    return callback() + marker + part[0] + len(part)
}

fn sample() -> i64 {
    const callback = fn() -> i64 { return values[0] }
    const part: Slice<i64> = values[1:3]
    return apply(callback, 0, part)
}

print(sample())
