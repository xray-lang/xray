fn materialize(part:Slice<i64>)->Array<i64> { return copy part }
fn preserve(part:Slice<i64>)->i64 {
    const saved:Array<i64> = (copy part)
    return part[0] + saved[1]
}
fn sample()->i64 {
    var values = [11,22,33]
    const part:Slice<i64> = values[1:3]
    const saved:Array<i64> = materialize(part)
    const before = preserve(part) + part[0]
    values[1] = 77
    return saved[0] + before + values[1]
}
print(sample())
