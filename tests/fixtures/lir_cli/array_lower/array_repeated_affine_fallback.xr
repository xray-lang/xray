fn cross_element() {
    var values: Array<i64> = [1, 2, 3]
    var round = 0
    while (round < 3) {
        var index = 0
        while (index < len(values)) {
            values[index] = values[index] + values[0]
            index += 1
        }
        round += 1
    }
    print(values[0])
    print(values[2])
}

fn observe_round() {
    var values: Array<i64> = [5, 7]
    var round = 0
    while (round < 2) {
        var index = 0
        while (index < len(values)) {
            values[index] = values[index] * 3 + 1
            index += 1
        }
        print(values[0])
        round += 1
    }
}

fn stride() {
    var values: Array<i64> = [1, 3, 5, 7]
    var round = 0
    while (round < 3) {
        var index = 0
        while (index < len(values)) {
            values[index] = values[index] * 3 + 1
            index += 2
        }
        round += 1
    }
    print(values[1])
    print(values[2])
}

fn snapshot() {
    var values: Array<i64> = [2, 3]
    const old = values
    var round = 0
    while (round < 4) {
        var index = 0
        while (index < len(values)) {
            values[index] = values[index] * 3 + 1
            index += 1
        }
        round += 1
    }
    print(old[0])
    print(values[0])
}

cross_element()
observe_round()
stride()
snapshot()
