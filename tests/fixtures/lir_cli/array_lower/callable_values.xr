fn apply(callback: fn(i64) -> i64, value: i64) -> i64 { return callback(value) }
fn choose(flag: bool, left: fn(i64) -> i64, right: fn(i64) -> i64, value: i64) -> i64 {
    const selected = flag ? left : right
    return selected(value)
}
fn predicate(callback: fn() -> bool) -> bool { return callback() }
fn byteValue(callback: fn(u8) -> u8, value: u8) -> u8 { return callback(value) }
fn compare(callback: fn(i64) -> bool, value: i64) -> bool { return callback(value) }
print(apply(fn(value: i64) -> i64 { return value + 2 }, 40))
print(choose(false, fn(value: i64) -> i64 { return value + 1 },
    fn(value: i64) -> i64 { return value + 2 }, 40))
print(predicate(fn() -> bool { return true }))
print(byteValue(fn(value: u8) -> u8 { return value }, 255))
print(compare(fn(value: i64) -> bool { return value > 0 }, 1))
print(compare(fn(value: i64) -> bool { return value > 0 }, -1))
