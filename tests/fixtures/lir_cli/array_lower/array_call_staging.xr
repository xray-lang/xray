fn bump(input: Array<i64>) -> Array<i64> {
    var values = input
    var i = 0
    while (i < len(values)) {
        values[i] = values[i] + 1
        i += 1
    }
    return values
}

fn main() {
    var values = [3, 4]
    const snapshot = values
    var i = 0
    while (i < 3) {
        values = bump(values)
        i += 1
    }
    print(values[0])
    print(values[1])
    print(snapshot[0])
    print(snapshot[1])
}
main()
