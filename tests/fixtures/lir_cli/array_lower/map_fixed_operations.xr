var state=#{"same":1,"other":7,"same":42}
fn snapshot(items:Map<string,i64>)->Map<string,i64>{return items}
fn add(items:ref Map<string,i64>,key:string,value:i64){items.set(key,value)}
fn local()->Map<string,i64>{var items=#{"x":2}
const saved=items
add(ref items,"x",99)
print(saved["x"])
return snapshot(items)}
const old=snapshot(state)
add(ref state,"same",50)
print(old["same"])
print(state.get("same")!)
print(state.get("missing") ?? -1)
print(len(state))
print(state.containsKey("other") ? 1 : 0)
print(state.delete("other") ? 1 : 0)
print(state.delete("absent") ? 1 : 0)
const changed=local()
print(changed["x"])
state.clear()
print(len(state))
print(len(old))
fn replace_key()->string{state=#{"fresh":17}
return "after"}
state.set(replace_key(),42)
print(state["fresh"])
print(state["after"])
