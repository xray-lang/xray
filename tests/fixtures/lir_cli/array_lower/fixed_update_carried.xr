fn bump(input: Array<i64>, start: i64) -> Array<i64> {
    var values = input
    var i = start
    var step = 2
    while (!(i >= len(values))) {
        const element = values[i]
        values[i] = element * 3 + step
        step += 2
        i += 1
    }
    return values
}

const empty: Array<i64> = []
const values: Array<i64> = [1, 2, 3, 4]
print(bump(empty, 0))
print(bump(values, 3))
print(bump(values, 0))
print(bump(values, 1))
print(values)

const long = Array<i64>(68, 1)
const beforeBoundary = bump(long, 4)
const atBoundary = bump(long, 3)
const afterBoundary = bump(long, 2)
print(beforeBoundary[3])
print(beforeBoundary[4])
print(beforeBoundary[67])
print(atBoundary[2])
print(atBoundary[3])
print(atBoundary[67])
print(afterBoundary[1])
print(afterBoundary[2])
print(afterBoundary[67])
print(long[1])
print(long[67])
