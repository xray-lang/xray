fn apply(callback: fn(i64) -> i64, value: i64) -> i64 {
    return callback(value)
}

fn sample() -> i64 {
    var values = [11, 22, 33]
    const part: Slice<i64> = values[1:3]
    var extra = 1
    const callback = fn(value: i64) -> i64 {
        extra = extra + 1
        return value + extra
    }
    extra = extra + 1
    const result = apply(callback, part[0])
    return result + extra + len(part)
}

print(sample())
