fn replace(text: ref string) -> string {
    text = "rebound"
    return "!"
}

fn append(piece: string) {
    var text = ""
    var i = 0
    while (i < 3) {
        text = text + piece
        i += 1
    }
    const before = text
    text = text + "y"
    text = text + "${i}"
    print(before)
    print(text)

    var repeated = "ab"
    repeated = repeated + repeated
    print(repeated)
}

fn preserve_left() -> string {
    var text = "before"
    text = text + replace(ref text)
    return text
}

append("x")
print(preserve_left())
