fn apply(callback: fn() -> i64, marker: i64) -> i64 {
    return callback() + marker
}

fn sample() -> i64 {
    var values = [11, 22, 33]
    const badCallback = fn() -> i64 {
        values.push(44)
        return len(values)
    }
    const part: Slice<i64> = values[1:3]
    const dispatch = apply
    return dispatch(badCallback, 0) + part[0] + len(part)
}

print(sample())
