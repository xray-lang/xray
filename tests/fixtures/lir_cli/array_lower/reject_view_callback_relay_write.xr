var values = [1, 2, 3]
var other = [4, 5, 6]

fn invoke(part: Slice<i64>, callback: fn() -> i64) -> i64 {
    return callback() + part[0]
}
fn relay(callback: fn() -> i64, part: Slice<i64>) -> i64 {
    return invoke(part, callback)
}
fn change() -> i64 {
    values[0] = 9
    return 0
}
print(relay(change, values[0:2]))
