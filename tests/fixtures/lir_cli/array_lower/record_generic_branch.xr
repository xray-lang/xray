struct Row {
    score: i64
}
fn snapshot<T>(value:T)->T { return value }
fn some<T>(value:T)->T? { return value }
fn choose_optional<T>(value:T,keep:bool)->T? {
    if(keep) { return value }
    return null
}
fn local(seed:i64)->i64 {
    const value=some(Row{score:seed})
    const nested=some(snapshot(value))
    return nested!!.score
}
var current=some(Row{score:17})
const saved=snapshot(current)
current=some(Row{score:42})
print(current!.score)
print(saved!.score)
current=null
print(current==null ? 1 : 0)
const empty_inner=some(snapshot(current))
print(empty_inner==null ? 0 : 1)
print(empty_inner! == null ? 1 : 0)
const nested=some(snapshot(saved))
print(nested!!.score)
const empty_outer=choose_optional(snapshot(saved),false)
print(empty_outer==null ? 1 : 0)
print(choose_optional(Row{score:23},false)==null ? 1 : 0)
print(choose_optional(Row{score:29},true)!.score)
current=some(Row{score:63})
print(snapshot(current)!.score)
print(local(9))
