fn apply(callback: fn() -> i64) -> i64 {
    return callback()
}

fn sample() -> i64 {
    var pair = (11, 22)
    const unknown = fn() -> i64 {
        return pair.0
    }
    var values = [11, 22, 33]
    const callback = fn() -> i64 {
        values.push(44)
        return len(values)
    }
    const dispatch = apply
    const first = dispatch(unknown)
    return first + dispatch(callback)
}

print(sample())
