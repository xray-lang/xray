fn choose(flag: bool) -> i64 {
    var values = [11, 22, 33]
    const part: Slice<i64> = values[1:3]
    if (flag) {
        var first = 10
        var second = 20
        const read = fn() -> i64 { return first + second }
        first = first + 1
        second = second + 2
        return read() + part[0] + len(part)
    }
    var later = 40
    const read = fn() -> i64 { return later }
    later = later + 1
    return read() + part[0] + len(part)
}

print(choose(true))
print(choose(false))
