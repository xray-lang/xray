enum Refusal { Failed { code: i64 } }

fn leaf(divisor: i64) throws(Refusal) -> i64 {
    print(1)
    const quotient = 24 / divisor
    defer { print(201) }
    if (divisor < 0) { throw Refusal.Failed { code: divisor } }
    return quotient
}

fn relay(divisor: i64) throws(Refusal) -> i64 {
    defer { print(202) }
    const quotient = try leaf(divisor)
    print(99)
    return quotient
}

print(try relay(0))
