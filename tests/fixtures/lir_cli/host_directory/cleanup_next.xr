import io
import path

const one = io.directoryProbeOpen(path.Path("one"))
const empty = io.directoryProbeOpen(path.Path("empty"))
assert(one > 0 && empty > 0 && one != empty)
const name = io.directoryProbeNextLate(one, empty, one, true)
assert(name != null)
print(name!)

const first = io.directoryProbeOpen(path.Path("one"))
const second = io.directoryProbeOpen(path.Path("empty"))
assert(first > 0 && second > 0 && first != second)
print(io.directoryProbeNextLate(first, second, second, false) == null)
assert(io.directoryProbeClose(second))
