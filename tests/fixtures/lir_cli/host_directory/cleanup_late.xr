import io
import path

const first = io.directoryProbeOpen(path.Path("one"))
const second = io.directoryProbeOpen(path.Path("empty"))
assert(first > 0 && second > 0 && first != second)
const retained = io.directoryProbeCleanupLate(first, second)
const item = io.directoryProbeNext(retained)
assert(item != null)
assert(io.directoryProbeClose(retained))
print(item!)
