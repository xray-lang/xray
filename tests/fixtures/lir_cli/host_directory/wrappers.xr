export fn directoryProbeOpen(directory: Path) -> i64 { return __dirOpen(directory) }
export fn directoryProbeNext(token: i64) -> string? { return __dirNext(token) }
export fn directoryProbeClose(token: i64) -> bool { return __dirClose(token) }

export fn directoryProbeCleanupLate(first: i64, second: i64) -> i64 {
    var token = first
    defer {
        __dirClose(token)
    }
    token = second
    return first
}

export fn directoryProbeCleanupPair(first: i64, second: i64) -> i64 {
    defer {
        __dirClose(first)
    }
    defer {
        __dirClose(second) // innermost close
    }
    return 17
}

export fn directoryProbeCleanupPartial(first: i64, second: i64) -> i64 {
    defer { __dirClose(first) }
    {
        defer { __dirClose(second) }
    }
    return 19
}

export fn directoryProbeCleanupManaged(token: i64, input: string) -> i64 {
    var count = 0
    {
        defer { __dirClose(token) }
        count = 1
    }
    return count + len(input)
}

enum DirectoryProbeError { Invalid }

fn _directoryProbeFallibleCleanup(token: i64) throws(DirectoryProbeError) -> i64 {
    if (token < 0) { throw DirectoryProbeError.Invalid }
    defer { __dirClose(token) }
    return 23
}

export fn directoryProbeCleanupCaller(token: i64) -> i64 {
    defer { print(71) }
    return try! _directoryProbeFallibleCleanup(token) // cross-frame cleanup call
}

export fn directoryProbeNextLate(first: i64, second: i64, read: i64, late: bool) -> string? {
    var token = first
    defer { __dirClose(first) }
    if (late) {
        defer { __dirClose(token) }
        token = second
        return __dirNext(read)
    }
    return __dirNext(read)
}

export fn directoryProbeNextPair(first: i64, second: i64, read: i64) -> string? {
    defer { __dirClose(first) }
    defer {
        __dirClose(second) // checked innermost close
    }
    return __dirNext(read) // checked read
}

export fn directoryProbeNextNonTail(token: i64, read: i64) -> string? {
    defer { __dirClose(token) }
    var result = __dirNext(read) // checked bound read
    return result
}

export fn directoryProbeNextReassigned(token: i64) -> string? {
    defer { __dirClose(token) }
    var result = __dirNext(token)
    result = null
    return result
}

export fn directoryProbeNextAcross(token: i64) -> string? {
    defer { __dirClose(token) }
    return directoryProbeNextPair(token, token, token)
}

export fn directoryProbeLoopLate(first: i64, second: i64) -> i64 {
    var token = first
    defer { __dirClose(first) }
    defer { __dirClose(token) }
    token = second
    var count = 0
    while (true) {
        var name = __dirNext(token)
        if (name == null) { return count }
        count = count + 1
    }
    return -1
}

export fn directoryProbeLoopConst(token: i64) -> i64 {
    defer { __dirClose(token) }
    var count = 0
    while (true) {
        const name = __dirNext(token)
        if (name != null) {
            count = count + 1
        } else {
            return count
        }
    }
    return -1
}

export fn directoryProbeLoopRetiredArray(token: i64, includeSeed: bool) -> i64 {
    var seed = 0
    if (includeSeed) {
        var names: Array<string> = ["marker"]
        seed = len(names)
    }
    defer { __dirClose(token) }
    var count = seed
    while (true) {
        const name = __dirNext(token)
        if (name == null) { return count }
        count = count + 1
    }
    return -1
}

export fn directoryProbeLoopLiveArray(token: i64) -> i64 {
    var names: Array<string> = ["marker"]
    defer { __dirClose(token) }
    var count = 0
    while (true) {
        const name = __dirNext(token)
        if (name == null) { return count + len(names) }
        count = count + 1
    }
    return -1
}

export fn directoryProbeLoopWrite(token: i64) -> i64 {
    defer { __dirClose(token) }
    var count = 0
    while (true) {
        var name = __dirNext(token)
        if (name == null) { return count }
        name = null
        count = count + 1
    }
    return -1
}

export fn directoryProbeLoopEscape(token: i64) -> i64 {
    defer { __dirClose(token) }
    var count = 0
    while (true) {
        const name = __dirNext(token)
        if (name == null) { return count }
        print(name!)
        count = count + 1
    }
    return -1
}
