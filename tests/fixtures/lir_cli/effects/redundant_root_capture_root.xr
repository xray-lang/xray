var state:i64=9
fn apply(callback:fn()->i64)->i64{try{return callback()}catch(error){return 0}}
fn capture(callback:fn()->i64)->i64{const thunk=fn()->i64{try{return callback()}catch(error){return 0}};return apply(thunk)}
fn rooted()->i64{return state}
export fn run()->i64{return capture(rooted)}
print(run())
