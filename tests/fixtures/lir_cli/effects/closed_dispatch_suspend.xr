fn worker() -> i64 { return 1 }

class Base {
    init() {}
    value() -> i64 { return 1 }
}

class Derived extends Base {
    init() { super() }
    override value() -> i64 { return await go worker() }
}

fn accept(value: Base) {
    const limited: nosuspend fn() -> i64 = fn() -> i64 {
        return value.value()
    }
}
