var counter:i64=0
class Options{value:i64;init(){this.value=7}}
fn hidden()->Options{defer{counter=counter+1};return Options()}
fn use(v:Slice<u8>,options:Options=hidden())->i64{return len(v)+options.value}
export fn storage_receiver()->i64{var text="abc";var view:Slice<u8>=text.bytes();return use(view)-9}
