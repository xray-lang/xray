fn forward(action: fn(), n: i64) {
    if (n == 0) { action(); return }
    forward(action, n - 1)
}
fn leaf() -> i64 { return 7 }
fn retain(value: escaping fn()) -> fn() { return value }
fn probe(exec: fn(fn()), callback: fn() -> i64) {
    var slot = leaf
    const reset = fn() { slot = leaf }
    const saved = retain(reset)
    const setter = fn() { slot = callback }
    forward(setter, 2)
}
