fn pure() -> i64 { return 7 }
fn suspending() -> i64 { Coro.yield(); return 9 }
fn worker() -> i64 { return 1 }
fn tasking() -> i64 { const child = go worker(); return 9 }
fn invoke(callback: fn() -> i64) -> i64 { return callback() }
fn probe() {
    var callback = pure
    const saved = callback
    defer { print(invoke(saved)) }
    callback = tasking
}
probe()
