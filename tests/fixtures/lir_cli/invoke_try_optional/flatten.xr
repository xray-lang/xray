enum Refusal { Failed }

fn lookup(mode: i64) throws(Refusal) -> i64? {
    print(mode)
    if (mode == 0) { return null }
    if (mode == 1) { return 13 }
    throw Refusal.Failed
}

const empty: i64? = try? lookup(0)
const present: i64? = try? lookup(1)
const failed: i64? = try? lookup(2)
print(empty ?? -2)
print(present ?? -2)
print(failed ?? -2)
