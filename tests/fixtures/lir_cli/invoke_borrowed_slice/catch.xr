enum Refusal { Denied { code: i64 } }

fn read(view: Slice<u8>, fail: bool) throws(Refusal) -> i64 {
    if (view[0] != 67) { return 999 }
    var value = len(view) * 100 + 67
    if (fail) { throw Refusal.Denied { code: value } }
    return value
}

fn probe(fail: bool) {
    var bytes: Array<u8> = [255, 67, 0, 255]
    try {
        print(read(bytes[1:3], fail))
    } catch (e: Refusal) {
        match (e) {
            Refusal.Denied { code } => print(code + 1000),
        }
    }
    bytes[1] = 91
    print(bytes[1])
}

probe(false)
probe(true)
