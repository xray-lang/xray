enum Refusal { Denied { code: i64 } }

fn read(view: Slice<u8>, fail: bool) throws(Refusal) -> i64 {
    if (view[0] != 65) { return 999 }
    var value = len(view) * 100 + 65
    if (fail) { throw Refusal.Denied { code: value } }
    return value
}

fn probe(fail: bool) {
    var bytes: Array<u8> = [255, 65, 0, 255]
    print((try? read(bytes[1:3], fail)) ?? -1)
    bytes[1] = 90
    print(bytes[1])
}

probe(false)
probe(true)
