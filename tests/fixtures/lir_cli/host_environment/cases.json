    "stdout_utf8": "xray-tmpdir\n"
  },
  "temp_root_tmp": {
    "source": "temp_root.xr",
    "set_env": {"TMPDIR": "", "TMP": "xray-tmp", "TEMP": "xray-temp"},
    "unset_env": [],
    "stdout_utf8": "xray-tmp\n"
  },
  "temp_root_temp": {
    "source": "temp_root.xr",
    "set_env": {"TMP": "", "TEMP": "xray-temp"},
    "unset_env": ["TMPDIR"],
    "stdout_utf8": "xray-temp\n"
  },
  "temp_root_default": {
    "source": "temp_root.xr",
    "set_env": {},
    "unset_env": ["TMPDIR", "TMP", "TEMP"],
    "stdout_windows_utf8": "C:\\Windows\\Temp\n",
    "stdout_posix_utf8": "/tmp\n"
  }
