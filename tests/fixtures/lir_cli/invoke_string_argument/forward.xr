enum ReadError { Invalid { count: i64 } }
fn read(value: string, code: i64) throws(ReadError) -> i64 {
    if (len(value) == 0) { throw ReadError.Invalid { count: code } }
    return code + 9
}

fn required(input: string) -> i64 {
    return try! read(input, 40)
}

fn optional(input: string) -> i64 {
    return (try? read(input, 40)) ?? -1
}

print(required("猫\0"))
print(optional(""))
print(optional("猫\0"))
