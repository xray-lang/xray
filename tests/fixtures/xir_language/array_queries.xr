struct Holder {
    items: Array<i64>
}
fn main() {
    var a = [1, 2, 3]
    print(a.contains(2))
    print(a.contains(9))
    print(a.indexOf(3))
    print(a.indexOf(9))
    print(a.join(":"))
    print(a.join())
    var text = ["a\0b", "c"]
    print(len(text.join("-")))
    print([true, false].join(","))
    var empty: Array<i64> = []
    print(empty.contains(0))
    print(empty.indexOf(0))
    print(len(empty.join()))
    var copy = a
    a.clear()
    print(len(a))
    print(len(copy))
    var holder = Holder{items: [4, 5]}
    var held = holder.items
    holder.items.clear()
    print(len(holder.items))
    print(len(held))
    var nested = [[6, 7]]
    var nested_copy = nested
    nested[0].clear()
    print(len(nested[0]))
    print(len(nested_copy[0]))
}
main()
