fn double(x: i64) -> i64 { return x * 2 }
fn is_even(x: i64) -> bool { return x % 2 == 0 }
fn main() {
    var a = [1, 2, 3, 4, 5]
    var doubled = a.map(x -> x * 2)
    print(len(doubled))
    print(doubled[4])
    var labels = a.map(fn(x: i64, i: i64) -> string { return string(x) + ":" + string(i) })
    print(labels[2])
    var named = a.map(double)
    print(named[1])
    var evens = a.filter(x -> x % 2 == 0)
    print(len(evens))
    print(evens[1])
    print(len(a.filter(is_even)))
    var sum = a.reduce(fn(acc: i64, x: i64) -> i64 { return acc + x }, 0)
    print(sum)
    var joined = a.reduce(fn(acc: string, x: i64) -> string { return acc + string(x) }, "")
    print(joined)
    var total = 0
    a.forEach(x -> {
        total = total + x
    })
    print(total)
    var weighted = 0
    a.forEach(fn(x: i64, i: i64) { weighted = weighted + x * i })
    print(weighted)
    var found = a.find(x -> x > 3)
    print(found ?? -1)
    var missing = a.find(x -> x > 30)
    print(missing ?? -1)
    print(a.findIndex(x -> x == 4))
    print(a.findIndex(x -> x == 40))
    print(a.every(x -> x > 0))
    print(a.every(x -> x > 1))
    print(a.some(x -> x > 4))
    print(a.some(x -> x > 5))
    var none: Array<i64> = []
    print(len(none.map(x -> x + 1)))
    print(none.every(x -> x > 100))
    print(none.some(x -> x > 100))
    print(none.reduce(fn(acc: i64, x: i64) -> i64 { return acc + x }, 7))
    var chained = a.filter(x -> x > 2).map(x -> x * 10)
    print(chained[0])
    print(chained[2])
    var words = ["a", "bb", "ccc"]
    var lengths = words.map(w -> len(w))
    print(lengths[2])
    var snapshot = [1, 2, 3]
    var copy = snapshot.map(x -> x)
    snapshot.push(4)
    print(len(copy))
}
main()
