import "./producer" as producer
export fn main()->i64{return 0}
export fn short(count:i64,piece:string)->string{return producer.short(count,piece)}
export fn digits(count:i64,piece:string)->string{return producer.digits(count,piece)}
export fn chunks(count:i64,piece:string)->string{return producer.short(count,piece)}
export fn join(count:i64,piece:string)->string{return producer.join(count,piece)}
export fn snapshot(count:i64,piece:string)->(string,string){return producer.snapshot(count,piece)}
export fn scalars(count:i64,piece:string)->string{return producer.scalars(count,piece)}
