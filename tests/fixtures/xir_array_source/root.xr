import "./producer" as producer

var a = producer.words()
const original = a
print(a[0])
print(a[1])
print(len(a))
a[0] = "green"
print(a[0])
print(original[1])
a.push(a[0])
print(a[2])
print(len(a))

export fn result() -> Array<string> { return a }
export fn originalFirst() -> string { return original[0] }
export fn advance() -> i64 { a.push("tail"); return len(a) }
fn replace() -> string { a = ["new", "value", "rhs"]; return "changed" }
export fn rebound() -> string { a[2] = replace(); return a[2] }
fn index() -> i64 { a = ["after"]; return 0 }
export fn snapshot() -> string { a = ["before"]; return a[index()] }
export fn methodSnapshot() -> string { a = ["before"]; return a.get(index()) }
fn shorten() -> string { a = ["only"]; return "rhs" }
export fn reboundFault() { a = ["old", "two"]; a[1] = shorten() }
export fn current() -> string { return a[0] }
export fn assignResult() -> string {
    var b = ["x"]
    const rhs = (b[0] = "result")
    b[0] = "later"
    return rhs
}
export fn local() -> i64 {
    var values: Array<i64> = []
    values.push(5)
    const old = values
    values.set(0, 6)
    values.push(values.get(0))
    return values[0] + values[1] + old[0]
}
export fn captured() -> i64 {
    var values = [7]
    const append = fn() { values.push(values[0]) }
    append()
    return len(values)
}
fn first<T>(values: Array<T>) -> T { return values[0] }
export fn generic() -> string { return first<string>(["generic"]) }
export fn nested() -> string { const values = [["nested"]]; return values[0][0] }
export fn importedLength() -> string { return producer.len("shadow") }
export fn localLength() -> string {
    const len = fn(value: string) -> string { return value + "?" }
    return len("shadow")
}
export fn selfPush() -> Array<string> {
    var values = ["seed"]
    for (var i = 0; i < 1024; i++) { values.push(values[0]) }
    return values
}

var trace = 0
export fn orderTrace() -> i64 { return trace }
fn orderedIndex() -> i64 { trace = trace * 10 + 1; return 1 }
fn orderedValue() -> string { trace = trace * 10 + 2; return "ordered" }
export fn setOrder() -> string {
    trace = 0
    a = ["left", "right"]
    a[orderedIndex()] = orderedValue()
    return a[1]
}
fn getSuspendedIndex() -> i64 {
    trace = trace * 10 + 1
    Coro.yield()
    a = ["newGet"]
    trace = trace * 10 + 2
    return 0
}
export fn suspendedSnapshot() -> string {
    trace = 0
    a = ["oldGet"]
    return a[getSuspendedIndex()]
}
fn setSuspendedIndex() -> i64 {
    trace = trace * 10 + 1
    Coro.yield()
    trace = trace * 10 + 2
    return 1
}
fn setSuspendedValue() -> string {
    trace = trace * 10 + 3
    a = ["newSet", "untouched"]
    return "stored"
}
export fn suspendedSet() -> string {
    trace = 0
    a = ["oldSet"]
    a[setSuspendedIndex()] = setSuspendedValue()
    return a[1]
}

struct Item { text:string; values:Array<i64> }
var pathItems = [Item{text:"old", values:[11]}]
fn pathIndex() -> i64 { trace = trace * 10 + 1; return 0 }
fn pathInner() -> i64 { trace = trace * 10 + 2; return 0 }
fn pathValue() -> i64 {
    trace = trace * 10 + 3
    pathItems = [Item{text:"new", values:[73]}]
    return 99
}
export fn nestedPath() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    const original = pathItems
    pathItems[pathIndex()].values[pathInner()] = pathValue()
    return trace * 1000 + pathItems[0].values[0] + original[0].values[0]
}
export fn nestedMethodSet() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    const original = pathItems
    pathItems[pathIndex()].values.set(pathInner(), pathValue())
    return trace * 1000 + pathItems[0].values[0] + original[0].values[0]
}
fn pathAppend() -> i64 {
    trace = trace * 10 + 2
    pathItems = [Item{text:"new", values:[73]}]
    return 61
}
export fn nestedMethodPush() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    pathItems[pathIndex()].values.push(pathAppend())
    return trace * 10000 + len(pathItems[0].values) * 1000 + pathItems[0].values[0] * 10 + pathItems[0].values[1]
}
fn pathText() -> string {
    trace = trace * 10 + 2
    pathItems = [Item{text:"new", values:[73]}]
    return "x"
}
export fn nestedCompound() -> string {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    const original = pathItems
    pathItems[pathIndex()].text += pathText()
    return pathItems[0].text + ":" + original[0].text
}
fn pathSuspendedValue() -> i64 { Coro.yield(); return pathValue() }
fn pathBadIndex() -> i64 { trace = trace * 10 + 1; return 1 }
fn pathEmpty() -> i64 {
    trace = trace * 10 + 3
    pathItems = [Item{text:"empty", values:[]}]
    return 99
}
export fn nestedWriteFault() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    pathItems[pathIndex()].values[pathInner()] = pathEmpty()
    return -1
}
export fn nestedFieldFault() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    pathItems[pathBadIndex()].text = pathText()
    return -1
}
export fn nestedCompoundFault() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    pathItems[pathBadIndex()].text += pathText()
    return -1
}
export fn nestedState() -> i64 { return trace * 1000 + len(pathItems[0].values) }
export fn nestedCaughtFault() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    try {
        defer { trace = trace * 10 + 4 }
        pathItems[pathIndex()].values[pathInner()] = pathEmpty()
    } catch panic(p) { return p.code * 10000 + trace }
    return -1
}
export fn nestedSuspended() -> i64 {
    trace = 0
    pathItems = [Item{text:"old", values:[11]}]
    const original = pathItems
    pathItems[pathIndex()].values[pathInner()] = pathSuspendedValue()
    return trace * 1000 + pathItems[0].values[0] + original[0].values[0]
}
export fn aggregateResult() -> Array<Item> { return [Item{text:"escaped", values:[41]}] }
export fn aggregate() -> string {
    var items = [Item{text:"before", values:[3]}]
    const original = items
    items[0] = Item{text:"after", values:[7]}
    items.push(first<Item>(original))
    var read = items[1]
    read.text = "local"
    return original[0].text + ":" + items[0].text + ":" + items[1].text + ":" + read.text
}
export fn aggregateNested() -> i64 {
    var items = [Item{text:"x", values:[3]}]
    const original = items
    items.set(0, Item{text:"y", values:[7]})
    items.push(items.get(0))
    return original[0].values[0] + items[0].values[0] + items[1].values[0]
}
struct EmptyItem {}
export fn emptyAggregate() -> i64 {
    var items: Array<EmptyItem> = []
    for (var i = 0; i < 9; i++) { items.push(EmptyItem{}) }
    const snapshot = items
    items.set(0, snapshot[8])
    return len(items)
}
enum ItemChoice { Empty, Text { text:string } }
export fn enumAggregate() -> string {
    var items = [ItemChoice.Empty, ItemChoice.Text{text:"enum"}]
    const original = items
    items[0] = items[1]
    items.push(ItemChoice.Empty)
    return match(first<ItemChoice>(items)) {
        ItemChoice.Text{text} -> text,
        ItemChoice.Empty -> "wrong"
    }
}
