import mem

export struct OwnedValue {
    value: int
}

export fn makeOwnedArray(value: int) -> Array<int> {
    return [value]
}

export fn makeOwnedBuffer(size: int) -> Buffer {
    var buffer = mem.allocZeroed(size)
    return buffer
}

export fn makeOwnedValue(value: int) -> OwnedValue {
    return OwnedValue{value: value}
}

export fn borrowImportedArray(value: Array<int>) -> Array<int> {
    return value
}
