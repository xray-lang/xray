Coro.yield()
const counter = Atomic(10)
Coro.yield()
export fn next() -> i64 { return identity<Atomic<i64>>(counter).fetchAdd(1) }
export fn tag(value: string) -> string {
    var text = "a"
    text = text + value
    return identity<string>(text)
}
export fn pack(left: string, first: i64, last: i64, right: string) -> string {
    print(first, last, left, right)
    return tag(left + right)
}
export fn identity<T>(value: T) -> T {
    const copied = value
    return copied
}
fn requireSendable<T:Sendable>(value:T) -> T { return identity<T>(value) }
export fn forward<T:Sendable>(value:T) -> T { return requireSendable<T>(value) }
export fn first<T,U>(left:T,right:U)->T { return left }

export fn pause<T>(value:T)->T { Coro.yield(); return value }

export fn invoke<A,B>(callback:fn(A)->B,value:A)->B { return callback(value) }
export fn keep<A,B>(callback:fn(A)->B)->fn(A)->B {
    const retain = identity<fn(A)->B>
    return retain(callback)
}
export fn nested<A,B>(transform:fn(fn(A)->B)->fn(A)->B,callback:fn(A)->B)->fn(A)->B {
    const apply = invoke<fn(A)->B,fn(A)->B>
    return apply(transform, callback)
}
export fn frozen<T:Sendable>(value:T)->fn()->T {
    var stored = value
    const read = fn()->T { Coro.yield(); return requireSendable<T>(stored) }
    stored = value
    return read
}

const floatingSeed: f32 = 16777217 as f32
export fn floatSeed()->f32 { return floatingSeed }
const decimalState:f32 = 1.25
export fn decimalSeed()->f32 { return decimalState }

export struct Pair { value:i64
 label:string }
export fn pairValue(p:Pair)->i64{return p.value}

const defaultState=Atomic(0)
export fn defaultValue(n:i64)->i64 {
    const prior=defaultState.load()
    defaultState.fetchAdd(prior*9+n)
    return n
}
fn defaultLabel()->string { Coro.yield(); return "default" }
export struct Defaulted {
    a:i64=defaultValue(1)
    b:i64=defaultValue(2)
    label:string=defaultLabel()
}
export fn defaultTrace()->i64 { return defaultState.load() }

export struct Zero { integer:i64; decimal:f32; flag:bool }
export struct Complete {
    nested:Zero
    text:string="complete"
    values:Array<i64>=[17]
    callback:fn()->i64=fn()->i64{return 19}
    private hidden:i64=23
}
export struct GenericRecord<T> { value:T }

export struct GenericDefault<T> { value:T; identity:fn(T)->T=fn(x:T)->T{return x}; label:string="generic" }
export struct GenericEmpty<T>{identity:fn(T)->T=fn(x:T)->T{return x};count:i64}
export struct GenericNested<T>{inner:GenericEmpty<T>}

export struct ReadBox<T> {
    value:T
    get()->T{return this.value}
    take(other:T)->T{return other}
    snapshot()->fn()->T{return fn()->T{return this.value}}
}
export struct MethodSecret { private hidden:i64=97; get()->i64{return this.hidden} }
