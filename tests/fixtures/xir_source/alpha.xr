Coro.yield()
const counter = Atomic(10)
Coro.yield()
export fn next() -> i64 { return identity<Atomic<i64>>(counter).fetchAdd(1) }
export fn tag(value: string) -> string {
    var text = "a"
    text = text + value
    return identity<string>(text)
}
export fn pack(left: string, first: i64, last: i64, right: string) -> string {
    print(first, last, left, right)
    return tag(left + right)
}
export fn identity<T>(value: T) -> T {
    const copied = value
    return copied
}
fn requireSendable<T:Sendable>(value:T) -> T { return identity<T>(value) }
export fn forward<T:Sendable>(value:T) -> T { return requireSendable<T>(value) }
export fn first<T,U>(left:T,right:U)->T { return left }

export fn pause<T>(value:T)->T { Coro.yield(); return value }

export fn invoke<A,B>(callback:fn(A)->B,value:A)->B { return callback(value) }
export fn keep<A,B>(callback:fn(A)->B)->fn(A)->B {
    const retain = identity<fn(A)->B>
    return retain(callback)
}
export fn nested<A,B>(transform:fn(fn(A)->B)->fn(A)->B,callback:fn(A)->B)->fn(A)->B {
    const apply = invoke<fn(A)->B,fn(A)->B>
    return apply(transform, callback)
}
export fn frozen<T:Sendable>(value:T)->fn()->T {
    var stored = value
    const read = fn()->T { Coro.yield(); return requireSendable<T>(stored) }
    stored = value
    return read
}

const floatingSeed: f32 = 16777217 as f32
export fn floatSeed()->f32 { return floatingSeed }
const decimalState:f32 = 1.25
export fn decimalSeed()->f32 { return decimalState }

export struct Pair { value:i64
 label:string }
export fn pairValue(p:Pair)->i64{return p.value}

const defaultState=Atomic(0)
export fn defaultValue(n:i64)->i64 {
    const prior=defaultState.load()
    defaultState.fetchAdd(prior*9+n)
    return n
}
fn defaultLabel()->string { Coro.yield(); return "default" }
export struct Defaulted {
    a:i64=defaultValue(1)
    b:i64=defaultValue(2)
    label:string=defaultLabel()
}
export fn defaultTrace()->i64 { return defaultState.load() }

export struct Zero { integer:i64; decimal:f32; flag:bool }
export struct Complete {
    nested:Zero
    text:string="complete"
    values:Array<i64>=[17]
    callback:fn()->i64=fn()->i64{return 19}
    private hidden:i64=23
}
export struct GenericRecord<T> { value:T }

export struct GenericDefault<T> { value:T; identity:fn(T)->T=fn(x:T)->T{return x}; label:string="generic" }
export struct GenericEmpty<T>{identity:fn(T)->T=fn(x:T)->T{return x};count:i64}
export struct GenericNested<T>{inner:GenericEmpty<T>}

export struct ReadBox<T> {
    value:T
    private fetch()->T{return this.value}
    protected relay(other:ReadBox<T>)->T{return other.fetch()}
    get()->T{return this.relay(this)}
    take(other:T)->T{return other}
    snapshot()->fn()->T{return fn()->T{return this.fetch()}}
    bound()->fn()->T{return this.fetch}
}
export struct MethodSecret { private hidden:i64=97; private fetch()->i64{return this.hidden}; get()->i64{return this.fetch()} }

export struct Construct<T> {
    private const value:T
    copy:T
    const label:string
    const stamp:i64=5
    constructor(value, yes:bool) {
        this.value=value
        this.copy=value
        if(yes) { this.label="ctor" } else { this.label="fallback" }
        const capture=fn()->T { return this.value }
        this.copy=capture()
    }
    get()->T { return this.value }
}

export struct ConstructorControl {
    const value:string
    constructor(value, branch:i64) {
        if(branch<0) { this.value="early"; return }
        var i=0
        while(i<branch) { i=i+1 }
        this.value=value
    }
}
const constructorOrder=Atomic(0)
fn constructorStep(value:i64)->i64 {
    const prior=constructorOrder.load()
    constructorOrder.fetchAdd(prior*9+value)
    return value
}
export struct ConstructorOrder {
    private const first:i64=constructorStep(1)
    private const second:i64=constructorStep(2)
    const order:i64
    constructor() { constructorStep(3); this.order=constructorOrder.load() }
}
export struct ConstructorFault {
    private const held:string
    const value:i64
    constructor(left:i64,right:i64) {
        this.held="partial"+"owned"
        Coro.yield()
        this.value=left/right
    }
}

const argumentOrder=Atomic(0)
fn argumentStep(label:string,digit:i64)->string {
    const prior=argumentOrder.load()
    argumentOrder.fetchAdd(prior*9+digit)
    return label
}
export fn argumentExplicit()->string { return argumentStep("explicit",1) }
fn argumentDefault()->string { Coro.yield(); return argumentStep("default",2) }
export fn argumentCall(first:string,second:string=argumentDefault())->string { return first+second }
export fn argumentCount()->i64 { return argumentOrder.load() }
export fn argumentIdentity<T>(value:T,identity:fn(T)->T=fn(item:T)->T { return item })->T { return identity(value) }
export struct ArgumentBox<T> {
    const value:T
    const label:string
    constructor(value,label:string=argumentDefault()) { this.value=value; this.label=label }
    suffix(text:string=argumentDefault())->string { return "v"+text }
}

fn argumentFault()->i64 {
    const held="default"+"owned"
    argumentStep("fault",3)
    Coro.yield()
    var zero:i64=0
    return 18/zero
}
export fn argumentFailure(first:string,second:i64=argumentFault())->i64 {
    argumentOrder.fetchAdd(1000000)
    return second
}

export struct StaticFactory<T> {
    const value:T
    private constructor(value) { this.value=value }
    static failure(first:string, second:i64=argumentFault())->i64 {
        argumentOrder.fetchAdd(1000000)
        return second
    }
    static relay(value:StaticFactory<T>)->StaticFactory<T> { return value }
    static make(value:T)->StaticFactory<T> { return StaticFactory<T>(value) }
    static identity(value:T, transform:fn(T)->T=fn(item:T)->T { return item })->T { return transform(value) }
    private static label()->string { return "private"+"static" }
    static exported()->fn()->string { return StaticFactory<T>.label }
}

export struct MethodBox<T> {
    value:T
    private hidden<U>(value:U)->U { return value }
    bound<U>()->fn(U)->U { return this.hidden<U> }
    map<U>(value:U, transform:fn(T,U)->U=fn(outer:T,item:U)->U { return item })->U {
        return transform(this.value,value)
    }
    static choose<U>(outer:T,value:U)->U { return value }
}

export enum Event<T:Sendable> { Empty, Data { value:T, label:string } }
export fn failEvent<T:Sendable>(value:T)->i64 {
    const error=Event<T>.Data { value:value, label:"owned" }
    Coro.yield()
    throw error
}
export fn event<T:Sendable>(v:T)->Event<T> { return Event<T>.Data { label:"owned", value:v } }
export fn eventValue<T:Sendable>(v:Event<T>,fallback:T)->T {
    return match(v) { Event.Data { value } -> value, Event.Empty -> fallback }
}
