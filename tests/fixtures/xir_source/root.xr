fn choose<T>(flag: bool, left: T, right: T) -> T {
    return flag ? right : left
}
fn branch(flag: bool) -> i64 {
    if (flag) { return 7 } else { return 9 }
}
fn control() -> string {
    var acc = "s"
    const snapshot = acc
    var i = 0
    while (i < 5) {
        i = i + 1
        if (i == 2) { continue }
        var j = 0
        while (j < 3) {
            j = j + 1
            if (j == 2) { break }
            acc = acc + "x"
        }
        if (i == 4) { break }
    }
    if (i == 4) { acc = acc + "!" } else { acc = "bad" }
    acc = acc
    return snapshot + acc
}
print(choose<string>(true, "bad", control()), branch(true), branch(false), choose<bool>(false, true, false))

var hits = 0
fn probe(value: bool) -> bool { hits++; return value }
fn shortControl() -> i64 {
    const a = false && probe(true)
    const b = true || probe(false)
    const c = probe(false) || probe(true)
    const d = probe(true) && probe(false)
    if (!a && b && c && !d) { return hits }
    return 999
}
fn forControl() -> string {
    var text = "f"
    var i = 99
    for (var i = 0; i < 5 && !(i == 4); i++) {
        if (i == 1) { continue }
        var j = 0
        while (j < 2) {
            j++
            if (j == 1) { continue }
            text = text + "x"
        }
    }
    if (i == 99) { text = text + "!" }
    var down = 2
    for (; !(down == 0); down--) { text = text + "d" }
    for (var q = 0; q < 2;) { q++; continue }
    return text
}
fn deadStep() -> i64 {
    for (;; choose<bool>(true, probe(true), false)) { break }
    for (;; false || choose<bool>(false, false, probe(true))) { return 13 }
    return 99
}
print(shortControl(), forControl(), deadStep(), hits)

export fn update(value: i64, up: bool) -> i64 {
    var copy = value
    if (up) { copy++ } else { copy-- }
    return copy
}

export fn calculate(kind:i64, left:i64, right:i64)->i64 {
    if (kind == 32) { return alpha.failEvent<string>("error"+" payload") }
    if (kind == 33) {
        try { patternFail(left) }
        catch (PatternFailure.Wrapped { inner:PatternInner.Leaf { code } }) { return code+right }
        catch (PatternFailure.Wrapped {}) { return right }
        return -1
    }
    if (kind == 27) { return match(left) {1,2->71} }
    if (kind == 28) { return match(left==1) {true->72} }
    if (kind == 29) { return match(left as f64) {1.0->73} }
    if (kind == 30) {
        const text=left==1 ? "owned"+"match" : "owned"+"miss"
        return match(text) {"ownedmatch"->74}
    }
    if (kind == 31) { return match(left) {x if(matchPause(x))->75} }
    if (kind == 26) { return "A中😀B".indexOf("B",left) }
    var held = "arith" + "metic"
    if (kind == 20) {
        Coro.yield()
        const narrowed = (left as f64) as i8
        floatState = narrowed as f32
        return floatState as i64
    }
    if (kind == 21) { return floatState as i64 }
    if (kind == 23) { return alpha.argumentFailure("caller"+"owned") }
    if (kind == 24) { return alpha.argumentCount() }
    if (kind == 25) { return alpha.StaticFactory<string>.failure("static"+"owned") }
    if (kind == 22) { const value=alpha.ConstructorFault(left,right); return value.value }
    if (kind == 0) { return left + right }
    if (kind == 1) { return left - right }
    if (kind == 2) { return left * right }
    if (kind == 3) { return left / right }
    if (kind == 4) { return left % right }
    if (kind == 5) { return -left }
    if (kind == 6) { if (left == right) { return 1 } else { return 0 } }
    if (kind == 7) { if (left != right) { return 1 } else { return 0 } }
    if (kind == 8) { if (left < right) { return 1 } else { return 0 } }
    if (kind == 9) { if (left <= right) { return 1 } else { return 0 } }
    if (kind == 10) { if (left > right) { return 1 } else { return 0 } }
    if (kind == 11) { if (left >= right) { return 1 } else { return 0 } }
    if (kind == 12) { return left & right }
    if (kind == 13) { return left | right }
    if (kind == 14) { return left ^ right }
    if (kind == 15) { return left << right }
    if (kind == 16) { return left >> right }
    if (kind == 17) { return ~left }
    if (kind == 18) {
        hits = left
        hits /= (hits = right)
        return hits
    }
    return hits
}
fn operand()->i64 { hits++; return hits }
print(operand() - operand(), hits, calculate(3, -7, 3), calculate(4, -7, 3), -(-7))

fn bitControl()->i64 {
    var bits = 85
    bits &= 15
    bits |= 128
    bits ^= 3
    bits <<= 1
    bits >>= 2
    var order = 8
    const returned = (order <<= (order = 1))
    var arith = 40
    arith += 2
    arith -= 7
    arith *= 3
    arith /= 5
    arith %= 4
    return ~bits + order + returned + arith
}
fn compoundText()->string {
    var text = "a"
    const before = text
    text += (text = "b")
    text += text
    return before + text
}
print(operand() << operand(), hits, ~0, -7 >> 1, 1 << 64, bitControl(), compoundText())

fn conditionalText(flag:bool)->string {
    var text = "a"
    const selected = flag ? (text = "b") : (false ? "bad" : (text = "c"))
    return text + selected
}
fn conditionalBump() { hits++ }
fn conditionalControl() {
    hits = 0
    const n = probe(true) ? operand() : 1 / 0
    const m = probe(false) ? 1 / 0 : probe(true) ? operand() : 999
    const a = false ? operand() : 7
    var text = ""
    for (var i = 0; i < 3; i++) { text += i < 2 ? "x" : "y" }
    const atom = choose<Atomic<i64>>(true, Atomic(1), Atomic(9))
    true ? conditionalBump() : conditionalBump()
    print(n, m, a, hits, conditionalText(true), conditionalText(false), text, atom.load())
}
conditionalControl()

fn sourceYield() { var held = "u" + "v"; return Coro.yield() }
fn noYield() { return }
fn resumedNative(flag:bool)->string {
    true ? noYield() : sourceYield()
    var text = "r"
    const provider: fn(bool)->fn(bool)->string = chooseCallback
    var callback = (alpha.invoke<bool,fn(bool)->string>)(provider, flag)
    const kept = callback
    callback = rightCallback
    activeCallback = alpha.nested<bool,string>(passCallback, alpha.keep<bool,string>(kept))
    const invoke = alpha.invoke<bool,string>
    const selected = invoke(activeCallback, flipCallback(flag))
    const pause: fn() = sourceYield
    pause()
    text = selected + "!"
    return text
}

fn searchStartPause()->i64 { Coro.yield(); predicateText="after"; return 1 }
fn predicatePause(expected:string)->string { Coro.yield(); predicateText="after"; return expected }
export fn resumeText(flag:bool)->string {
    const expected=flag ? "ry!" : "rn!"
    if (expected != resumedNative(flag) || len(expected)!=3) { return "bad" }
    predicateText=expected
    if (!predicateText.contains(predicatePause(expected))) { return "bad" }
    predicateText=expected
    if (!predicateText.startsWith(predicatePause(expected))) { return "bad" }
    predicateText=expected
    if (!predicateText.endsWith(predicatePause(expected))) { return "bad" }
    predicateText=expected
    if (predicateText.indexOf(predicatePause(expected)) != 0) { return "bad" }
    predicateText=expected
    if (predicateText.lastIndexOf(predicatePause(expected)) != 0) { return "bad" }
    predicateText=expected
    if (predicateText.indexOf("!",searchStartPause()) != 2) { return "bad" }
    if (typedResumedText(expected) != expected) { return "bad" }
    return patternResumedText(expected)
}

export fn stackDepth(n:i64)->string {
    const held = "f" + "r"
    if (n == 0) { Coro.yield(); return held }
    return stackDepth(n - 1) + held
}

fn leftCallback(flag:bool)->string { const pause = alpha.pause<string>; return pause(flag ? "ry" : "wrong") }
fn rightCallback(flag:bool)->string { const pause = alpha.pause<string>; return pause(flag ? "wrong" : "rn") }
fn chooseCallback(flag:bool)->fn(bool)->string {
    var unused = "mutable but not captured"
    var prefix = "bad"
    const frozen = alpha.frozen<string>(flag ? "y" : "n")
    const make = fn()->fn(bool)->string {
        return (value:bool) -> prefix + frozen()
    }
    const ready = make()
    prefix = closureScope() == 9 && sharedControl() == 28 ? "r" : "bad"
    return ready
}
fn sharedControl()->i64 {
    var number = 1
    const first = fn() { number += 2; return number }
    const second = fn() { number *= 3; return number }
    const snapshot = number
    const a = first()
    number = 4
    const b = second()
    const empty:fn(bool)->string = rightCallback
    var callback:fn(bool)->string = empty
    callback = fn(value:bool)->string { return callback(value) }
    callback = empty
    return snapshot + a + b + number
}
fn closureScope()->i64 {
    const value = 3
    const evaluate = fn() {
        { const value = 99 }
        const value = value + 1
        const again = fn() { return value + value }
        var ignored = 0
        for (var value = 0; value < 2; value++) { ignored++ }
        return again() + ignored - 1
    }
    return evaluate()
}
fn passCallback(callback:fn(bool)->string)->fn(bool)->string { return callback }
var activeCallback:fn(bool)->string = rightCallback
fn flipCallback(flag:bool)->bool { activeCallback = rightCallback; return flag }


