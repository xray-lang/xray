enum NestedBits { Pair { left:bool, right:bool } }
fn nestedBits(v:NestedBits)->i64 {
    return match(v) {
        NestedBits.Pair { left:true, right:true } -> 1,
        NestedBits.Pair { left:true, right:false } -> 2,
        NestedBits.Pair { left:false, right:true } -> 3,
        NestedBits.Pair { left:false, right:false } -> 4
    }
}
enum NestedBox<T:Sendable> { None, Some { inner:alpha.Event<T>, enabled:bool } }
fn nestedPick<T:Sendable>(v:NestedBox<T>,fallback:T)->T {
    return match(v) {
        NestedBox.None -> fallback,
        NestedBox.Some { inner:alpha.Event.Empty } -> fallback,
        NestedBox.Some { inner:alpha.Event.Data { value }, enabled:true } -> value,
        NestedBox.Some { inner:alpha.Event.Data { value }, enabled:false } -> fallback
    }
}
var nestedRoot=NestedBox<string>.Some { inner:alpha.event<string>("snapshot"), enabled:true }
var nestedGuardCalls=0
fn nestedGuard()->bool {
    nestedRoot=NestedBox<string>.None
    nestedGuardCalls=nestedGuardCalls+1
    Coro.yield()
    return false
}
const nestedSnapshot=match(nestedRoot) {
    NestedBox.Some { inner:alpha.Event.Data { value }, enabled:true } if(nestedGuard()) -> fn()->string {return "wrong"},
    NestedBox.Some { inner:alpha.Event.Data { value } } -> fn()->string {return value},
    NestedBox.Some { inner:alpha.Event.Empty } -> fn()->string {return "empty"},
    NestedBox.None -> fn()->string {return "none"}
}
print(nestedBits(NestedBits.Pair{left:true,right:true}),nestedBits(NestedBits.Pair{left:true,right:false}),nestedBits(NestedBits.Pair{left:false,right:true}),nestedBits(NestedBits.Pair{left:false,right:false}),nestedPick<string>(NestedBox<string>.Some{inner:alpha.event<string>("nested"),enabled:true},"fallback"),nestedPick<string>(NestedBox<string>.Some{inner:alpha.event<string>("nested"),enabled:false},"fallback"),nestedSnapshot(),nestedGuardCalls)


enum ScalarPayload { Empty, Data { small:i8, wide:u64, decimal:f32, text:string } }
fn scalarPattern(v:ScalarPayload)->i64 {
    return match(v) {
        ScalarPayload.Data { small:-128 } -> 1,
        ScalarPayload.Data { wide:18446744073709551615 } -> 2,
        ScalarPayload.Data { decimal:-0.0 } -> 3,
        ScalarPayload.Data { decimal:1 } -> 4,
        ScalarPayload.Data { text:"literal" } -> 5,
        ScalarPayload.Data { text:"" } -> 6,
        ScalarPayload.Data {} -> 7,
        ScalarPayload.Empty -> 8
    }
}
print(scalarPattern(ScalarPayload.Data{small:-128,wide:0,decimal:2.0,text:"x"}),
    scalarPattern(ScalarPayload.Data{small:0,wide:18446744073709551615,decimal:2.0,text:"x"}),
    scalarPattern(ScalarPayload.Data{small:0,wide:0,decimal:0.0,text:"x"}),
    scalarPattern(ScalarPayload.Data{small:0,wide:0,decimal:1.0,text:"x"}),
    scalarPattern(ScalarPayload.Data{small:0,wide:0,decimal:2.0,text:"literal"}),
    scalarPattern(ScalarPayload.Data{small:0,wide:0,decimal:2.0,text:""}),
    scalarPattern(ScalarPayload.Data{small:0,wide:0,decimal:(0.0 as f32)/(0.0 as f32),text:"literal-extra"}),
    scalarPattern(ScalarPayload.Empty))


enum SignedRange { Data { value:i64 } }
fn signedRange(v:SignedRange)->i64 {
    return match(v) {
        SignedRange.Data { value:0..0 } -> 99,
        SignedRange.Data { value:1..=0 } -> 98,
        SignedRange.Data { value:-9223372036854775808..0 } -> 1,
        SignedRange.Data { value:0..=9223372036854775807 } -> 2
    }
}
enum UnsignedRange { Data { value:u64 } }
fn unsignedRange(v:UnsignedRange)->i64 {
    return match(v) {
        UnsignedRange.Data { value:0..18446744073709551615 } -> 3,
        UnsignedRange.Data { value:18446744073709551615 } -> 4
    }
}
print(signedRange(SignedRange.Data{value:-9223372036854775808}),signedRange(SignedRange.Data{value:-1}),
    signedRange(SignedRange.Data{value:0}),signedRange(SignedRange.Data{value:9223372036854775807}),
    unsignedRange(UnsignedRange.Data{value:0}),unsignedRange(UnsignedRange.Data{value:18446744073709551614}),
    unsignedRange(UnsignedRange.Data{value:18446744073709551615}))

enum Alternatives<T> { Left { first:T, second:T }, Right { value:T } }
fn alternativeClosure<T>(v:Alternatives<T>)->fn()->T {
    return match(v) {
        Alternatives.Left{first:item}, Alternatives.Right{value:item} -> fn()->T {return item}
    }
}
var alternativeGuards=0
fn alternativeGuard(text:string)->bool {
    alternativeGuards=alternativeGuards+1
    Coro.yield()
    return text=="second"
}
fn alternativeOrder(v:Alternatives<string>)->string {
    return match(v) {
        Alternatives.Left{first:item}, Alternatives.Left{second:item} if(alternativeGuard(item)) -> "wrong",
        Alternatives.Left{first:item}, Alternatives.Right{value:item} -> item
    }
}
const alternativeLeft=alternativeClosure<string>(Alternatives<string>.Left{first:"left",second:"unused"})
const alternativeRight=alternativeClosure<string>(Alternatives<string>.Right{value:"right"})
print(alternativeLeft(),alternativeRight(),alternativeOrder(Alternatives<string>.Left{first:"first",second:"second"}),alternativeGuards)

fn matchPause(value:i64)->bool { Coro.yield(); return value==1 }
print(match(true){true->"bool",false->"wrong"},match(-128 as i8){-128..0->1,0..=127->2},
    match(-0.0){0.0->"zero",_->"wrong"},match("text"){"prefix"->"wrong",x->x})


enum CatchFailure { Bad { text:string } }
fn catchEmpty()->i64 { try { } catch(e) { return 99 }; return 2 }
fn catchDirect()->i64 { try { throw CatchFailure.Bad{text:"direct"} } catch(e) { return 7 } }
fn catchMaybe(fail:bool)->i64 { if(fail){throw CatchFailure.Bad{text:"call"}}; return 11 }
fn catchCall(fail:bool)->i64 { try { return catchMaybe(fail) } catch(e) { return 17 } }
fn catchRethrow()->i64 {
    try { try { throw CatchFailure.Bad{text:"nested"} } catch(e) { throw e } }
    catch(outer) { return 19 }
}
fn catchClosure()->i64 {
    const fail=fn()->i64 {throw CatchFailure.Bad{text:"closure"}}
    try {return fail()} catch(e) {return 23}
}
fn catchUnitFail() {throw CatchFailure.Bad{text:"unit"}}
fn catchUnit()->i64 {try {catchUnitFail(); return 99} catch(e) {return 29}}
fn catchEdges(flag:bool)->i64 {
    try {if(flag){throw CatchFailure.Bad{text:"first"}}; throw CatchFailure.Bad{text:"second"}}
    catch(e) {return 31}
}
fn catchText()->string {try {catchUnitFail()} catch(e) {return "caught"}; return "wrong"}
print(catchEmpty(),catchDirect(),catchCall(false),catchCall(true),catchRethrow(),catchClosure(),catchUnit(),catchEdges(false),catchCopy(),catchParameterResult(),catchText(),CatchConstruct(true).value)

struct CatchConstruct {
    const value:string
    constructor(flag:bool) {
        try {} catch(e) { if(flag){this.value="unused"}else{this.value="also-unused"} }
        this.value="constructed"
    }
}

fn catchCopy()->i64 {
    try {
        try {throw CatchFailure.Bad{text:"owned"}}
        catch(e) {var saved=e; saved=e; throw saved}
    } catch(outer) {return 37}
}

fn catchParameter(error:Error)->Error {
    try {throw error} catch(e) {return e}
}
fn catchParameterResult()->i64 {
    try {throw catchParameter(CatchFailure.Bad{text:"parameter"})} catch(e) {return 41}
}


enum TypedOther { Bad }
enum TypedFailure<T> { Value { item:T } }
fn typedErrorValue<T>(value:T)->T {
    try {throw TypedFailure<T>.Value{item:value}}
    catch(wrong:TypedOther) {throw wrong}
    catch(e:TypedFailure<T>) {return match(e){TypedFailure.Value{item:x}->x}}
}
fn typedSecond()->i64 {
    try {throw TypedOther.Bad}
    catch(wrong:CatchFailure) {return 0}
    catch(e:TypedOther) {return 43}
}
fn typedOrder()->i64 {
    try {throw TypedOther.Bad}
    catch(first:TypedOther) {return 47}
    catch(second:TypedOther) {return 0}
}
fn typedUnmatched()->i64 {
    try {
        try {throw TypedOther.Bad} catch(wrong:CatchFailure) {return 0}
    } catch(e:TypedOther) {return 53}
}
fn typedFallthrough()->i64 {
    var value=0
    try {throw TypedOther.Bad} catch(e:TypedOther) {value=59}
    return value
}
print(typedErrorValue<string>("typed"),typedSecond(),typedOrder(),typedUnmatched(),typedFallthrough())


fn typedResumedText(text:string)->string {
    try {alpha.failEvent<string>(text)}
    catch(wrong:CatchFailure) {return "bad"}
    catch(e:alpha.Event<string>) {
        const read=fn()->string {return alpha.eventValue<string>(e,"bad")}
        Coro.yield()
        return read()
    }
    return "bad"
}


enum PatternInner { Leaf { code:i64 }, Empty }
enum PatternFailure { Plain, Coded { code:i64, text:string }, Wrapped { inner:PatternInner } }
enum PatternOther { Bad { code:i64 } }
enum PatternPair { Left { value:i64 }, Right { value:i64 }, Neither }
enum PatternBox<T> { Item { value:T }, None }
fn patternFail(kind:i64) {
    if (kind==3) { throw PatternFailure.Wrapped { inner:PatternInner.Leaf { code:83 } } }
    if (kind==4) { throw PatternFailure.Wrapped { inner:PatternInner.Empty } }
}
fn patternUnit()->i64 {
    try { throw PatternFailure.Plain }
    catch (PatternFailure.Coded {}) { return 0 }
    catch (PatternFailure.Plain) { return 61 }
}
fn patternRange(code:i64)->i64 {
    try { throw PatternFailure.Coded { code:code, text:"t" } }
    catch (PatternFailure.Coded { code:1..=9 }) { return 1 }
    catch (PatternFailure.Coded { code:10..=99, text:"t" }) { return 2 }
    catch (PatternFailure.Coded { code }) { return code }
}
fn patternAlternative(which:i64)->i64 {
    try {
        if (which==0) { throw PatternPair.Left { value:67 } }
        if (which==1) { throw PatternPair.Right { value:71 } }
        throw PatternPair.Neither
    }
    catch (PatternPair.Left { value }, PatternPair.Right { value }) { return value }
    catch (PatternPair.Neither) { return 73 }
}
fn patternNested(kind:i64)->i64 {
    try { patternFail(kind) }
    catch (PatternFailure.Wrapped { inner:PatternInner.Leaf { code } }) { return code }
    catch (PatternFailure.Wrapped { inner:PatternInner.Empty }) { return 79 }
    return 0
}
fn patternUnmatched()->i64 {
    try {
        try { throw PatternOther.Bad { code:89 } }
        catch (PatternFailure.Plain) { return 0 }
        catch (PatternOther.Bad { code:1..=9 }) { return 0 }
    } catch (outer:PatternOther) { return match(outer) { PatternOther.Bad { code } -> code } }
}
fn patternRethrow()->i64 {
    try {
        try { throw PatternFailure.Coded { code:97, text:"x" } }
        catch (PatternFailure.Coded { code }) { throw PatternOther.Bad { code:code+4 } }
    } catch (PatternOther.Bad { code }) { return code }
}
fn patternGeneric<T>(value:T, fallback:T)->T {
    try { throw PatternBox<T>.Item { value:value } }
    catch (PatternBox<T>.None) { return fallback }
    catch (PatternBox<T>.Item { value:item }) { return item }
}
fn patternGenericTag<T>(value:T)->i64 {
    try { throw PatternBox<T>.Item { value:value } }
    catch (PatternBox<T>.None, PatternBox.Item {}) { return 107 }
}
fn patternModule()->string {
    try { throw alpha.event<string>("module") }
    catch (alpha.Event<string>.Empty) { return "empty" }
    catch (alpha.Event<string>.Data { value, label:"owned" }) { return value }
}
fn patternCapture()->fn()->string {
    try { throw PatternFailure.Coded { code:109, text:"captured" } }
    catch (PatternFailure.Coded { text }) { return fn()->string { return text } }
}
fn patternDead()->i64 {
    try { } catch (PatternFailure.Coded { code }) { return code }
    return 113
}
fn patternFallthrough()->i64 {
    var value=0
    try { throw PatternFailure.Coded { code:127, text:"x" } } catch (PatternFailure.Coded { code }) { value=code }
    return value
}
const patternCaptured=patternCapture()
print(patternUnit(),patternRange(7),patternRange(42),patternRange(500),patternAlternative(0),patternAlternative(1),
    patternAlternative(2),patternNested(3),patternNested(4),patternUnmatched(),patternRethrow(),
    patternGeneric<string>("generic","bad"),patternGeneric<i64>(103,0),patternGenericTag<string>("tag"),
    patternModule(),patternCaptured(),patternDead(),patternFallthrough())

fn patternResumedText(text:string)->string {
    try { alpha.failEvent<string>(text) }
    catch (alpha.Event<string>.Empty) { return "bad" }
    catch (alpha.Event<string>.Data { value, label:"owned" }) {
        const read=fn()->string { return value }
        Coro.yield()
        return read()
    }
    return "bad"
}

fn conditionalForward<T:Sendable>(box:alpha.ConditionalBox<T>)->T {
    const read=box.checked
    return read()
}
fn conditionalError()->i64 {
    try { return alpha.ConditionalBox<PatternFailure>{value:PatternFailure.Coded { code:137,text:"condition" }}.raise() }
    catch (PatternFailure.Coded { code }) { return code }
}
const conditionalBox=alpha.ConditionalBox<string>{value:"conditional"}
const conditionalRead=conditionalBox.captured()
const conditionalStatic=alpha.ConditionalBox<i64>.forward<string>
print(conditionalForward<string>(conditionalBox),conditionalRead(),conditionalStatic("static",fn(item:string)->string{return "explicit"}),
    alpha.ConditionalBox<i64>.forward<string>("default"),conditionalError())

