export fn numericPause(flag: bool) -> i64 {
    const selected = flag ? alpha.pause<i8>(-128) : alpha.pause<i16>(32767)
    const floating = flag ? alpha.pause<f32>(-128.0) : alpha.pause<f64>(32767.0)
    if (floating != (selected as f64)) { return 0 }
    return floating as i64
}

