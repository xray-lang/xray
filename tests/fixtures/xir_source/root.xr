import { writeStdout, writeStderr } from "std/io/output"
import "./alpha" as alpha
import { next as betaNext } from "./beta"
print(alpha.tag("中"), betaNext())
print(alpha.next())
print(alpha.next(), alpha.next())
print(alpha.identity<bool>(true))
print(alpha.pack(alpha.tag("x"), alpha.next(), alpha.next(), "y"), true, alpha.first<i64,string>(alpha.identity<i64>(42), "discarded"), alpha.tag("z"))
print(writeStderr(alpha.tag("err")))
print(writeStdout(alpha.tag("out")))
var suffix = "!"
fn main() { print("main must not run implicitly") }
export fn result() -> string { return alpha.forward<string>(alpha.first<string,i64>(alpha.tag(suffix), 0)) }
export fn advance() -> i64 { return alpha.next() }
