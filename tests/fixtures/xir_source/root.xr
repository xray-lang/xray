import { writeStdout, writeStderr } from "std/io/output"
import "./alpha" as alpha
import { next as betaNext } from "./beta"
print(alpha.tag("中"), betaNext())
print(alpha.next())
print(alpha.next(), alpha.next())
print(alpha.identity<bool>(true))
print(alpha.pack(alpha.tag("x"), alpha.next(), alpha.next(), "y"), true, alpha.first<i64,string>(alpha.identity<i64>(42), "discarded"), alpha.tag("z"))
print(writeStderr(alpha.tag("err")))
print(writeStdout(alpha.tag("out")))
var suffix = "!"
fn main() { print("main must not run implicitly") }
export fn result() -> string { return alpha.forward<string>(alpha.first<string,i64>(alpha.tag(suffix), 0)) }
export fn advance() -> i64 { return alpha.next() }

fn choose<T>(flag: bool, left: T, right: T) -> T {
    return flag ? right : left
}
fn branch(flag: bool) -> i64 {
    if (flag) { return 7 } else { return 9 }
}
fn control() -> string {
    var acc = "s"
    const snapshot = acc
    var i = 0
    while (i < 5) {
        i = i + 1
        if (i == 2) { continue }
        var j = 0
        while (j < 3) {
            j = j + 1
            if (j == 2) { break }
            acc = acc + "x"
        }
        if (i == 4) { break }
    }
    if (i == 4) { acc = acc + "!" } else { acc = "bad" }
    acc = acc
    return snapshot + acc
}
print(choose<string>(true, "bad", control()), branch(true), branch(false), choose<bool>(false, true, false))

var hits = 0
fn probe(value: bool) -> bool { hits++; return value }
fn shortControl() -> i64 {
    const a = false && probe(true)
    const b = true || probe(false)
    const c = probe(false) || probe(true)
    const d = probe(true) && probe(false)
    if (!a && b && c && !d) { return hits }
    return 999
}
fn forControl() -> string {
    var text = "f"
    var i = 99
    for (var i = 0; i < 5 && !(i == 4); i++) {
        if (i == 1) { continue }
        var j = 0
        while (j < 2) {
            j++
            if (j == 1) { continue }
            text = text + "x"
        }
    }
    if (i == 99) { text = text + "!" }
    var down = 2
    for (; !(down == 0); down--) { text = text + "d" }
    for (var q = 0; q < 2;) { q++; continue }
    return text
}
fn deadStep() -> i64 {
    for (;; choose<bool>(true, probe(true), false)) { break }
    for (;; false || choose<bool>(false, false, probe(true))) { return 13 }
    return 99
}
print(shortControl(), forControl(), deadStep(), hits)

export fn update(value: i64, up: bool) -> i64 {
    var copy = value
    if (up) { copy++ } else { copy-- }
    return copy
}

export fn calculate(kind:i64, left:i64, right:i64)->i64 {
    var held = "arith" + "metic"
    if (kind == 20) {
        Coro.yield()
        const narrowed = (left as f64) as i8
        floatState = narrowed as f32
        return floatState as i64
    }
    if (kind == 21) { return floatState as i64 }
    if (kind == 0) { return left + right }
    if (kind == 1) { return left - right }
    if (kind == 2) { return left * right }
    if (kind == 3) { return left / right }
    if (kind == 4) { return left % right }
    if (kind == 5) { return -left }
    if (kind == 6) { if (left == right) { return 1 } else { return 0 } }
    if (kind == 7) { if (left != right) { return 1 } else { return 0 } }
    if (kind == 8) { if (left < right) { return 1 } else { return 0 } }
    if (kind == 9) { if (left <= right) { return 1 } else { return 0 } }
    if (kind == 10) { if (left > right) { return 1 } else { return 0 } }
    if (kind == 11) { if (left >= right) { return 1 } else { return 0 } }
    if (kind == 12) { return left & right }
    if (kind == 13) { return left | right }
    if (kind == 14) { return left ^ right }
    if (kind == 15) { return left << right }
    if (kind == 16) { return left >> right }
    if (kind == 17) { return ~left }
    if (kind == 18) {
        hits = left
        hits /= (hits = right)
        return hits
    }
    return hits
}
fn operand()->i64 { hits++; return hits }
print(operand() - operand(), hits, calculate(3, -7, 3), calculate(4, -7, 3), -(-7))

fn bitControl()->i64 {
    var bits = 85
    bits &= 15
    bits |= 128
    bits ^= 3
    bits <<= 1
    bits >>= 2
    var order = 8
    const returned = (order <<= (order = 1))
    var arith = 40
    arith += 2
    arith -= 7
    arith *= 3
    arith /= 5
    arith %= 4
    return ~bits + order + returned + arith
}
fn compoundText()->string {
    var text = "a"
    const before = text
    text += (text = "b")
    text += text
    return before + text
}
print(operand() << operand(), hits, ~0, -7 >> 1, 1 << 64, bitControl(), compoundText())

fn conditionalText(flag:bool)->string {
    var text = "a"
    const selected = flag ? (text = "b") : (false ? "bad" : (text = "c"))
    return text + selected
}
fn conditionalBump() { hits++ }
fn conditionalControl() {
    hits = 0
    const n = probe(true) ? operand() : 1 / 0
    const m = probe(false) ? 1 / 0 : probe(true) ? operand() : 999
    const a = false ? operand() : 7
    var text = ""
    for (var i = 0; i < 3; i++) { text += i < 2 ? "x" : "y" }
    const atom = choose<Atomic<i64>>(true, Atomic(1), Atomic(9))
    true ? conditionalBump() : conditionalBump()
    print(n, m, a, hits, conditionalText(true), conditionalText(false), text, atom.load())
}
conditionalControl()

fn sourceYield() { var held = "u" + "v"; return Coro.yield() }
fn noYield() { return }
fn resumedNative(flag:bool)->string {
    true ? noYield() : sourceYield()
    var text = "r"
    const provider: fn(bool)->fn(bool)->string = chooseCallback
    var callback = (alpha.invoke<bool,fn(bool)->string>)(provider, flag)
    const kept = callback
    callback = rightCallback
    activeCallback = alpha.nested<bool,string>(passCallback, alpha.keep<bool,string>(kept))
    const invoke = alpha.invoke<bool,string>
    const selected = invoke(activeCallback, flipCallback(flag))
    const pause: fn() = sourceYield
    pause()
    text = selected + "!"
    return text
}

export fn resumeText(flag:bool)->string { return resumedNative(flag) }

export fn stackDepth(n:i64)->string {
    const held = "f" + "r"
    if (n == 0) { Coro.yield(); return held }
    return stackDepth(n - 1) + held
}

fn leftCallback(flag:bool)->string { const pause = alpha.pause<string>; return pause(flag ? "ry" : "wrong") }
fn rightCallback(flag:bool)->string { const pause = alpha.pause<string>; return pause(flag ? "wrong" : "rn") }
fn chooseCallback(flag:bool)->fn(bool)->string {
    var unused = "mutable but not captured"
    var prefix = "bad"
    const frozen = alpha.frozen<string>(flag ? "y" : "n")
    const make = fn()->fn(bool)->string {
        return (value:bool) -> prefix + frozen()
    }
    const ready = make()
    prefix = closureScope() == 9 && sharedControl() == 28 ? "r" : "bad"
    return ready
}
fn sharedControl()->i64 {
    var number = 1
    const first = fn() { number += 2; return number }
    const second = fn() { number *= 3; return number }
    const snapshot = number
    const a = first()
    number = 4
    const b = second()
    const empty:fn(bool)->string = rightCallback
    var callback:fn(bool)->string = empty
    callback = fn(value:bool)->string { return callback(value) }
    callback = empty
    return snapshot + a + b + number
}
fn closureScope()->i64 {
    const value = 3
    const evaluate = fn() {
        { const value = 99 }
        const value = value + 1
        const again = fn() { return value + value }
        var ignored = 0
        for (var value = 0; value < 2; value++) { ignored++ }
        return again() + ignored - 1
    }
    return evaluate()
}
fn passCallback(callback:fn(bool)->string)->fn(bool)->string { return callback }
var activeCallback:fn(bool)->string = rightCallback
fn flipCallback(flag:bool)->bool { activeCallback = rightCallback; return flag }


var unsignedState: u64 = (-1) as u64
fn integerControl() -> u64 {
    var small: i8 = 127 as i8
    const bump = fn() -> i8 { small++; return small }
    const minimum = bump()
    small--
    small++
    unsignedState -= 1 as u64
    unsignedState += 1 as u64
    print(minimum, small, (minimum as i16) + (1 as i8), (255 as u8) + (1 as u8),
        (1 as u8) << 8, ~(0 as u32), unsignedState > (0 as u64))
    return alpha.identity<u64>(unsignedState)
}
print(integerControl(), (-32768) as i16, (-2147483648) as i32, 65535 as u16)

const contextMin8: i8 = -128
const contextMin16: i16 = -32768
const contextMin32: i32 = -2147483648
const contextMin64: i64 = -9223372036854775808
const contextMax8: u8 = 255
const contextMax16: u16 = 65535
const contextMax32: u32 = 4294967295
var contextMax64: u64 = 18446744073709551615
print(contextMin8, contextMin16, contextMin32, contextMin64,
    contextMax8, contextMax16, contextMax32, contextMax64)
fn contextReturn(value: i8) -> i64 { return value }
fn contextUnsigned() -> u64 { return 18446744073709551615 }
fn contextArithmetic() {
    var narrow: i8 = 100
    const typed: i16 = narrow + 100
    const literals: i16 = 100 + 100
    var unsigned: u8 = 255
    unsigned += 1
    unsigned = 1
    unsigned <<= 256
    const complement: u8 = ~0
    const lazy: i16 = true ? narrow : contextMin16 / 0
    const other: i64 = false ? contextMin64 / 0 : contextMin8
    var assigned: i64 = 0
    assigned = contextMin8
    contextMax64 = 18446744073709551615
    const direct = alpha.identity<u64>(18446744073709551615)
    const indirect = alpha.identity<u64>
    print(typed, literals, unsigned, complement, lazy, other, assigned, 200 as i8)
    print(contextReturn(-128), contextUnsigned(), direct, indirect(18446744073709551615))
}
contextArithmetic()
var numericOrder = 0
fn smallNext() -> i8 { numericOrder = numericOrder * 10 + 1; return 7 }
fn wideNext() -> i16 { numericOrder = numericOrder * 10 + 2; return 9 }
fn wideArgument(value: i64) -> i64 { return value }
fn contextOrder() {
    const sum = smallNext() + wideNext()
    const left = 1 + smallNext()
    const right = wideNext() + 2
    const indirect = wideArgument
    const call = indirect(smallNext())
    const nested = alpha.first<i64,u64>(wideNext(), alpha.identity<u64>(18446744073709551615))
    const callback = fn()->i16 { return contextMin8 }
    const negativeZero: u64 = -0
    print(sum, left, right, call, nested, callback(), negativeZero, numericOrder)
}
contextOrder()
print(18446744073709551615 as i8, (18446744073709551615) as i16,
    18446744073709551615 as i32, 18446744073709551615 as i64,
    18446744073709551615 as u8, 18446744073709551615 as u16,
