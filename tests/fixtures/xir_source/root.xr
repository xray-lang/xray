fn inferredIntegerJoin() {
    const first = true ? contextMin8 : contextMin16 / 0
    const second = false ? contextMin32 / 0 : contextMin16
    const nested = true ? (false ? (1 as u8) : (255 as u8)) : (65535 as u16)
    numericOrder = 0
    const yes = true ? smallNext() : wideNext()
    const no = false ? smallNext() : wideNext()
    print(first, second, nested, yes, no, numericOrder,
        (true ? (1 as i8) : 1000), (false ? (1 as u8) : (65535 as u16)))
}
inferredIntegerJoin()
export fn numericPause(flag: bool) -> i64 {
    const selected = flag ? alpha.pause<i8>(-128) : alpha.pause<i16>(32767)
    const floating = flag ? alpha.pause<f32>(-128.0) : alpha.pause<f64>(32767.0)
    if (floating != (selected as f64)) { return 0 }
    return floating as i64
}

var floatState: f32 = alpha.floatSeed()
fn floatingValues() {
    var cell: f32 = floatState
    const update = fn(value: f32)->f64 { cell = value; return cell }
    const read = fn()->f32 { return cell }
    const first: f64 = alpha.identity<f32>(cell)
    const second = update(-(7 as f32))
    const joined = true ? read() : (9 as f64)
    floatState = read()
    print(first as i64, second as i64, joined as i64, floatState as i64,
        first > second, second == joined, second != first, second <= joined)
    print((18446744073709551615 as f64) > (9223372036854775807 as f64),
        (16777217 as f64) > (16777217 as f32), (0 as f32) == -(0 as f64),
        (127 as f64) as i8, (255 as f32) as u8)
}
floatingValues()

fn decimalValues() {
    const direct: f32 = 1.00000005960464477539062500000000000000000000000000000000000000000000000001
    const cast = 1.00000005960464477539062500000000000000000000000000000000000000000000000001 as f32
    var captured: f32 = 0.0
    const set = fn(value:f32)->f64 { captured = value; return captured }
    const chosen:f32 = true ? 1.25 : 2.5
    const result = set(alpha.identity<f32>(chosen))
    const negative = fn()->f32 { return -2.5 }
    const exact32:f32 = 16777216
    const exact64:f64 = 9007199254740992
    print(direct > cast, cast == 1, result == 1.25, captured == 1.25,
        negative() < -2, exact32 == 16777216.0, exact64 == 9_007_199_254_740_992.0, alpha.decimalSeed() == 1.25)
}
decimalValues()

