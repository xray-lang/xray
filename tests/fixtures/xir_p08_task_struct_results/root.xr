struct Payload { values:Array<i64>; counter:Atomic<i64> }
fn worker_structure(value:Payload)->Payload { Coro.yield(); value.counter.fetchAdd(41); return value }
export fn await_structure()->Payload {
    var input=Payload{values:[10,20],counter:Atomic<i64>(1)}
    const task=go worker_structure(input)
    input.values[0]=99
    var first=await task
    first.values[0]=77
    if(input.values[0]!=99 || input.counter.load()!=42){return Payload{values:[0,0],counter:Atomic<i64>(0)}}
    return await task
}
export fn handle_structure()->Task<Payload> {
    var input=Payload{values:[10,20],counter:Atomic<i64>(1)}
    const task=go worker_structure(input)
    input.values[0]=99
    return task
}
export fn main()->i64 { return 7 }
