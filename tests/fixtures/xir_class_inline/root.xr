import {Record,Choice,Empty,Owner,Box,Container} from "./value"
import {advance,readBox,readItems} from "./reader"
export fn answer()->i64{const value=Record{n:40,text:"mapped",tail:42};const first=Owner(value,Choice.Full{value:value},Empty{});const alias=first;const other=Owner(value,Choice.None,Empty{});const before=first.get();const result=advance(alias);const box=Box<Record>(value);const choice=Box<Choice>(Choice.Full{value:value});const copied=readBox<Record>(box);const selected=readBox<Choice>(choice);const items=readItems<i64>(Container<i64>([41]));const texts=readItems<string>(Container<string>(["mapped"]));const extracted=match(selected){Choice.None->0,Choice.Full{value}->value.n};if(copied.n==40 && extracted==40 && items[0]==41 && texts[0]=="mapped" && result==41 && first.get().n==41 && other.get().n==40 && before.n==40){return 41}else{return 0}}
export fn retained()->Owner{const value=Record{n:40,text:"mapped",tail:42};return Owner(value,Choice.Full{value:value},Empty{})}
