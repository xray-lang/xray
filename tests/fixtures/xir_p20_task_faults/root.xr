import "./worker" as library

var observation = "cold"

export fn run()->Task<Array<string>> {
    defer { observation = observation + ":outer" }
    defer { observation = observation + ":inner" }
    const failed:Task<Array<string>> = go library.fails()
    try { const unused = await failed }
    catch(e:library.TaskFault) { observation = "thrown" }
    const task:Task<Array<string>> = go library.words()
    try { const unused = await task }
    catch panic(p:PanicInfo) { observation = observation + ":" + p.message }
    return task
}

export fn observed()->string { return observation }
export fn main()->i64 { return 0 }
