fn sent(result: SendResult) -> i64 {
    return match(result) { SendResult.Sent -> 1, SendResult.Full -> -1, SendResult.Timeout -> -2, SendResult.Closed -> -3, }
}
fn received(result: Recv<i64>) -> i64 {
    return match(result) { Recv.Value { value: item } -> item, Recv.Empty -> -1, Recv.Timeout -> -2, Recv.Closed -> -3, }
}
fn tick(counter: Atomic<i64>) { counter.add(1) }
fn genericRecv<T: Sendable>(channel: Channel<T>, timeout: i64) -> Recv<T> { return channel.recvTimeout(timeout) }
fn worker(channel: Channel<i64>) -> i64 { return received(channel.recvTimeout(5)) }
export fn main() -> i64 {
    const buffered = Channel<i64>(1)
    print(sent(buffered.sendTimeout(51, 0)), received(buffered.recvTimeout(0)), received(buffered.recvTimeout(0)))
    buffered.close()
    print(sent(buffered.sendTimeout(52, 0)), received(buffered.recvTimeout(0)))
    const rendezvous = Channel<i64>()
    print(sent(rendezvous.sendTimeout(53, 0)), received(rendezvous.recvTimeout(0)))
    print(sent(rendezvous.sendTimeout(54, 5)), received(rendezvous.recvTimeout(5)))
    const full = Channel<i64>(1)
    full.sendTimeout(15, 0)
    print(sent(full.sendTimeout(16, 5)), received(full.recvTimeout(5)), received(full.recvTimeout(5)))
    print(await go worker(Channel<i64>()))
    const counter = Atomic<i64>(0)
    const unit = Channel<()>()
    print(sent(unit.sendTimeout(tick(counter), 5)), counter.load())
    const unitBuffered = Channel<()>(1)
    const unitSent = sent(unitBuffered.sendTimeout(tick(counter), 0))
    const unitValue = match(unitBuffered.recvTimeout(0)) { Recv.Value { value: ignored } -> 7, Recv.Empty -> -1, Recv.Timeout -> -2, Recv.Closed -> -3, }
    print(unitSent, unitValue, counter.load())
    const strings = Channel<string>(1)
    strings.sendTimeout("payload", 0)
    const stringValue = match(genericRecv(strings, 5)) { Recv.Value { value: item } -> len(item), Recv.Empty -> -1, Recv.Timeout -> -2, Recv.Closed -> -3, }
    print(stringValue)
    return 99
}

export fn newTimedUnit(capacity: i64) -> Channel<()> { return Channel<()>(capacity) }
export fn timedUnitSend(channel: Channel<()>, milliseconds: i64) -> i64 {
    const counter = Atomic<i64>(0)
    const receiver = fn() -> Channel<()> { counter.store(counter.load() * 10 + 1); return channel }
    const message = fn() { counter.store(counter.load() * 10 + 2) }
    const duration = fn() -> i64 { counter.store(counter.load() * 10 + 3); return milliseconds }
    const result = sent(receiver().sendTimeout(message(), duration()))
    return result * 1000 + counter.load()
}
export fn timedUnitRecv(channel: Channel<()>, milliseconds: i64) -> i64 {
    return match(channel.recvTimeout(milliseconds)) {
        Recv.Value { value: ignored } -> 41, Recv.Empty -> -1, Recv.Timeout -> -2, Recv.Closed -> 44,
    }
}
export fn timedClose(channel: Channel<()>) -> i64 { channel.close(); return 7 }
