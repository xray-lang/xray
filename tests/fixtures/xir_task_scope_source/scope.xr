const total = Atomic(0)
const initTotal = Atomic(0)
scope { go fn() { initTotal.add(42) }() }
assert(initTotal.load() == 42)
fn worker(value: i64) { total.add(value) }
fn failed() { assert(false) }
enum WorkError { Failed }
fn businessError() throws(WorkError) { throw WorkError.Failed }
fn consume(values: move Array<i64>) {
    assert(values[0] == 41)
    values[0] = 42
    assert(values[0] == 42)
}
fn ownershipTransfers() {
    var independent = [41]
    const independentSnapshot = independent
    const task = go consume(move independent)
    try! await task
    assert(independentSnapshot[0] == 41)
    var scoped = [41]
    const scopedSnapshot = scoped
    scope { go consume(move scoped) }
    assert(scopedSnapshot[0] == 41)
    var referenced = [41]
    const referencedSnapshot = referenced
    const callback = consume
    scope { go callback(move referenced) }
    assert(referencedSnapshot[0] == 41)
}
fn borrowedAcross() -> i64 {
    var values = [42]
    const view: Slice<i64> = values[:]
    scope { go worker(0) }
    return view[0]
}
fn borrowedPanic() -> i64 {
    var values = [42]
    const view: Slice<i64> = values[:]
    try { scope { go worker(0); assert(false) } } catch panic {}
    return view[0]
}
fn borrowedBeforeJoin() {
    var values = [42]
    scope { go worker(0); const view: Slice<i64> = values[:]; assert(view[0] == 42) }
}
fn handledBody() {
    scope { go worker(0); try { try businessError() } catch (error: WorkError) {} }
}
fn assertedBody() {
    var caught = false
    try { scope { go worker(0); try! businessError() } } catch panic { caught = true }
    assert(caught)
}
fn returning() -> Array<i64> {
    var value = [42]
    scope { go worker(1); return move value }
}
fn leaving() {
    var i = 0
    while (i < 3) {
        i++
        scope { go worker(1); if (i == 1) { continue }; break }
    }
}
export fn main() -> i64 {
    ownershipTransfers()
    assert(borrowedAcross() == 42 && borrowedPanic() == 42)
    borrowedBeforeJoin()
    handledBody()
    assertedBody()
    scope { go worker(20); go fn() { total.add(22) }() }
    assert(total.load() == 42)
    scope(isolated) { go worker(1); go worker(2) }
    assert(total.load() == 45)
    scope { scope { go worker(1) }; go worker(2) }
    assert(total.load() == 48)
    const callback = fn() { total.add(2) }
    scope { go callback() }
    assert(total.load() == 50)
    scope { for (var i = 0; i < 3; i++) { go worker(1) } }
    assert(total.load() == 53)
    scope { try { assert(false) } catch panic {}; go worker(1) }
    assert(total.load() == 54)
    var caught = false
    try { scope { go failed() } } catch panic { caught = true }
    assert(caught)
    const result = returning()
    assert(len(result) == 1 && result[0] == 42)
    leaving()
    return 42
}
