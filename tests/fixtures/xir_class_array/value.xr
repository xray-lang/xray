export final class Bag { private items:Array<i64>; init(items:Array<i64>){this.items=items} read()->Array<i64>{return this.items} replace(items:Array<i64>){this.items=items} }
export final class TextBag { private items:Array<string>; init(items:Array<string>){this.items=items} read()->Array<string>{return this.items} replace(items:Array<string>){this.items=items} }
