// A split at different field names after an index is disjoint: different
// elements never overlap, and on one element the fields differ.
struct Pair {
    a: i64
    b: i64
}
fn bump(x: ref i64, y: ref i64) {
    x = x + 1
    y = y + 1
}
fn main() {
    var items = [Pair{a: 1, b: 2}, Pair{a: 3, b: 4}]
    bump(ref items[0].a, ref items[1].b)
    bump(ref items[0].a, ref items[0].b)
}
main()
