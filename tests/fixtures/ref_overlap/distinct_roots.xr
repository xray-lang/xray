// Different root bindings never overlap, whatever their paths.
struct Pair {
    a: Array<i64>
    b: Array<i64>
}
fn bump(x: ref i64, y: ref i64) {
    x = x + 1
    y = y + 1
}
fn appendAll(dst: ref Array<i64>, src: ref Array<i64>) {
    var i = 0
    while (i < len(src)) {
        dst.push(src[i])
        i = i + 1
    }
}
fn main() {
    var a = 1
    var b = 2
    bump(ref a, ref b)
    var xs = [1, 2]
    var ys = [3, 4]
    bump(ref xs[0], ref ys[0])
    var p = Pair{a: [1], b: [2]}
    var q = Pair{a: [3], b: [4]}
    appendAll(ref p.a, ref q.a)
}
main()
