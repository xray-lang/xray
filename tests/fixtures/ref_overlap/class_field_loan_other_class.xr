// A same-named field of an unrelated class cannot be the lent storage.
final class A {
    value: i64
    init() { this.value = 1 }
}
final class B {
    value: i64
    init() { this.value = 2 }
}
fn bump(x: ref i64, b: B) -> i64 {
    b.value = b.value + 10
    x += 1
    return x
}
fn main() {
    const a = A()
    const b = B()
    print(bump(ref a.value, b))
}
main()
