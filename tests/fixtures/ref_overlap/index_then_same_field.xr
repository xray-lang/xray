// The same field after two indexes overlaps: an index never proves two
// elements distinct, even for different constants.
struct Pair {
    a: i64
    b: i64
}
fn bump(x: ref i64, y: ref i64) {
    x = x + 1
    y = y + 1
}
fn main() {
    var items = [Pair{a: 1, b: 2}, Pair{a: 3, b: 4}]
    bump(ref items[0].a, ref items[1].a)
}
main()
