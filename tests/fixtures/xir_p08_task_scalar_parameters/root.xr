fn worker_i8(value:i8) -> i8 { Coro.yield(); return value }
export fn await_i8() -> i8 { const task: Task<i8> = go worker_i8(-128); const first = await task; return await task }
export fn handle_i8() -> Task<i8> { return go worker_i8(-128) }
fn worker_i16(value:i16) -> i16 { Coro.yield(); return value }
export fn await_i16() -> i16 { const task: Task<i16> = go worker_i16(-32768); const first = await task; return await task }
export fn handle_i16() -> Task<i16> { return go worker_i16(-32768) }
