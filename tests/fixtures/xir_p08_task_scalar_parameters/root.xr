export fn await_f64() -> f64 { const task: Task<f64> = go worker_f64(1.5); const first = await task; return await task }
export fn handle_f64() -> Task<f64> { return go worker_f64(1.5) }
fn worker_rune(value:rune) -> rune { Coro.yield(); return value }
export fn await_rune() -> rune { const task: Task<rune> = go worker_rune('x'); const first = await task; return await task }
export fn handle_rune() -> Task<rune> { return go worker_rune('x') }
fn worker_i64(value:i64) -> i64 { Coro.yield(); return value }
export fn await_i64() -> i64 { const task: Task<i64> = go worker_i64(-42); const first = await task; return await task }
export fn handle_i64() -> Task<i64> { return go worker_i64(-42) }
fn worker_bool(value:bool) -> bool { Coro.yield(); return value }
export fn await_bool() -> bool { const task: Task<bool> = go worker_bool(true); const first = await task; return await task }
export fn handle_bool() -> Task<bool> { return go worker_bool(true) }
fn worker_string(value:string) -> string { Coro.yield(); return value }
export fn await_string() -> string { const task: Task<string> = go worker_string("owned"); const first = await task; return await task }
export fn handle_string() -> Task<string> { return go worker_string("owned") }
fn worker_unit(value:bool) { Coro.yield(); if(value){return} }
export fn await_unit() { const task: Task<null> = go worker_unit(true); await task; await task }
export fn handle_unit() -> Task<null> { return go worker_unit(true) }
export fn main() -> i64 { return 7 }
