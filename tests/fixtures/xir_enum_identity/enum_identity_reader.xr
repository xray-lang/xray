import { Box,  } from "./enum_identity_decl"
import { identityTouch, identityCallback } from "./enum_identity_value"
fn identityText<T>(value:Box<T>)->string{return value.toString()}
export fn identityNumber()->i64{const name=identityTouch().name;if(name=="Full"){return 41}else{return 0}}
export fn identityTextResult()->string{return identityText<fn()->string>(Box<fn()->string>.Full{value:identityCallback})}
export fn identityLongResult()->string{return ..toString()}
export fn identityNameResult()->string{return ..name}
