fn make() -> fn(i64) -> i64 { return x => x * 2 }
const add = (a: i64, b: i64) => a + b
const twice = fn(x: i64) -> i64 { return x * 2 }
var action: fn(i64) -> i64 = x => x + 1
const curried = (x: i64) => (y: i64) => x + y
const literal = (key: string) => ({"a": 1})
const label = match (-2) {
    0 => "zero",
    n if (n < 0) => "negative",
    _ => "positive",
}
