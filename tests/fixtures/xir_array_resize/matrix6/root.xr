import "./producer" as producer
class Array<T>{value:T
    constructor(value:T){this.value=value}
    resize(length:i64,fill:T)->T{return this.value}
}
export fn case0()->i64{const value=Array<i64>(7);return value.resize(2,8)+value.resize(0,9)+producer.identity<i64>(2)}
export fn case1()->bool{const value=Array<bool>(true);return value.resize(2,false)&&value.resize(0,false)&&producer.identity<bool>(true)}
